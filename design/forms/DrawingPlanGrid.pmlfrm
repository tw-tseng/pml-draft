-----------------------------------------------------
-- Copyright ATOMTECH Ltd 2026                     --
--                                                 --
-- Function : Create Drawing Plan Boxes from grid  --
--            lines picked in the 3D view          --
-- Author   : Tseng                                --
-- Date     : 2026/09/15                           --
--                                                 --
-- The sister of the Pick tab on DrawingPlan.      --
-- There the frame is four free points, here its   --
-- edges are grid lines, picked in the 3D view in  --
-- two rounds:                                     --
--   plan lines   any number, in two directions.   --
--                each neighbouring pair in one    --
--                direction crossed with each      --
--                neighbouring pair in the other   --
--                is one box, so 3 x 2 lines give  --
--                two boxes side by side. the      --
--                boxes touch, which is what the   --
--                drawing side expects of          --
--                neighbours (DrawingPlan1Match-   --
--                Sorted looks 50mm outside the    --
--                edge for them)                   --
--   level lines  any number as well. sorted, each --
--                neighbouring pair is one storey, --
--                so the boxes come out bay by bay --
--                and storey by storey in one go.  --
--                the bottom offset goes on the    --
--                bottom of every box, the top     --
--                offset on the top of every box   --
-- Esc (or the Pick Level Lines button) is what    --
-- moves from the first round to the second, and   --
-- Esc again is what ends the second and makes the --
-- boxes. the round decides what a pick means, not --
-- the line                                        --
-- itself: in an E3D grid the same edge is drawn   --
-- twice, once as a child of the elevation plane   --
-- and once as a child of the column plane, and    --
-- which one the cursor lands on is chance. a      --
-- first cut that read the plane off the element   --
-- took two lines along the top of the grid for    --
-- levels (user, 2026-09-15)                       --
-- The boxes themselves are made by                --
-- !!DrawingPlan.MakeBox(), so they land in the    --
-- same site, unnamed, and are numbered and        --
-- labelled on that form's Info tab afterwards     --
-----------------------------------------------------

layout form !!DrawingPlanGrid dialog dock

	member .edgdesc  is STRING
	------------------------------------------------------------------
	-- which round the picks belong to: 'plan', 'level' or '' when   --
	-- nothing is being picked                                       --
	------------------------------------------------------------------
	member .phase    is STRING

	------------------------------------------------------------------
	-- the plan lines picked so far. one entry per line in each      --
	-- array: the refno (to spot the same line picked twice), the    --
	-- label for the list, the two ends in plan and the level the    --
	-- line sits on (only for drawing the aid on it)                 --
	------------------------------------------------------------------
	member .planrefs is ARRAY
	member .planlbls is ARRAY
	member .plane1   is ARRAY
	member .plann1   is ARRAY
	member .plane2   is ARRAY
	member .plann2   is ARRAY
	member .planu    is ARRAY

	------------------------------------------------------------------
	-- the level lines picked in this round                          --
	------------------------------------------------------------------
	member .levrefs  is ARRAY
	member .levlbls  is ARRAY
	member .levus    is ARRAY

	!this.formTitle = 'Drawing Plan Boxes from Grid Lines'

	frame .pickfr 'Pick' width 66
		button .planbt  'Pick Plan Lines'  width 16 call |!This.StartPlan()|
		button .levbt   'Pick Level Lines' at xmax.planbt+1 ymin.planbt width 16 call |!This.StartLevels()|
		button .stopbt  'Stop'  at xmax.levbt+1  ymin.planbt width 8 call |!This.StopPicking()|
		button .clearbt 'Clear' at xmax.stopbt+1 ymin.planbt width 8 call |!This.ClearAll()|

		para .status at xmin.planbt ymax.planbt+0.3 text '' width 62

		list .lines 'Picked grid lines' at xmin.planbt ymax.status+0.2 width 62 height 8
	exit

	----------------------------------------------------------------
	-- typed levels, for a grid that has no elevation planes: one  --
	-- storey, used only when fewer than two level lines have been --
	-- picked. the offsets go on every box whichever way the       --
	-- levels came, added as they are: + is up, - is down. they    --
	-- are kept from one batch to the next                         --
	----------------------------------------------------------------
	frame .levfr 'Levels' at xmin.pickfr ymax.pickfr+0.3 width 66
		para .levpa text 'typed levels are used only when no level lines are picked. offset: + up, - down' width 62

		text .ubot  'Bottom U' at xmin.levpa   ymax.levpa+0.3 tagwidth 10 width 12 is STRING
		text .uboto 'offset'   at xmax.ubot+1  ymin.ubot      tagwidth 7  width 10 is STRING

		text .utop  'Top U'    at xmin.ubot    ymax.ubot+0.2  tagwidth 10 width 12 is STRING
		text .utopo 'offset'   at xmax.utop+1  ymin.utop      tagwidth 7  width 10 is STRING
	exit

	button .create 'Create Boxes' at xmin.levfr ymax.levfr+0.3 width 14 call |!This.CreateBoxes()|
	para .result at xmax.create+1 ymin.create text '' width 46

	button .Cancel 'Close' at xmin.create ymax.create+0.4 width 10 call |!This.Close()|

exit

-------------------
-- form start up --
-------------------
define method .DrawingPlanGrid()
	!this.edgdesc = 'Drawing Plan Grid Picking'
	!this.phase = ''
	!this.uboto.val = '0'
	!this.utopo.val = '0'
	!this.ClearAll()
	!this.LoadDrawingPlan()
endmethod

------------------------------------------------------------------
-- the boxes are made through !!DrawingPlan's own methods, and a --
-- form is not loaded just by being named in a method call - it  --
-- has to be shown or loaded first, or '!!DRAWINGPLAN does not   --
-- exist' comes back from the pick (user, 2026-09-15). loading   --
-- runs its constructor, which only clears aids and fields       --
------------------------------------------------------------------
define method .LoadDrawingPlan()
	if (undefined(!!DrawingPlan)) then
		loadform !!DrawingPlan
	endif
endmethod

------------------------------------------------------------------
-- back to nothing picked. the offsets are left alone - they are --
-- a project convention, not part of any one batch              --
------------------------------------------------------------------
define method .ClearAll()
	!this.DropPicking()
	!this.phase = ''
	!this.planrefs = object ARRAY()
	!this.planlbls = object ARRAY()
	!this.plane1 = object ARRAY()
	!this.plann1 = object ARRAY()
	!this.plane2 = object ARRAY()
	!this.plann2 = object ARRAY()
	!this.planu = object ARRAY()
	!this.levrefs = object ARRAY()
	!this.levlbls = object ARRAY()
	!this.levus = object ARRAY()
	!this.lines.clear()
	!this.ubot.val = ''
	!this.utop.val = ''
	!this.status.val = ''
	!this.result.val = ''
	AID CLEAR ALL
endmethod

---------------------------------------------------------------------
-- picking. the same one-packet-at-a-time chain as DrawingPlan's    --
-- Pick tab, and for the same reason (see the comment above         --
-- .PickPoints() there): every packet carries the same description  --
-- and is taken out by it before the next one goes in.              --
-- the one difference is the pick packet itself: an element pick    --
-- rather than a position pick. a position pick answers a          --
-- position and, in some snap modes, nothing else - the grid line  --
-- it was on is gone. an element pick answers the element          --
-- (EDGPICKDATA.item), which is all that is wanted here             --
---------------------------------------------------------------------

------------------------------------------------------------------
-- first round. the plan lines already picked carry on - Clear   --
-- is the way to start over                                      --
------------------------------------------------------------------
define method .StartPlan()
	!this.phase = 'plan'
	!this.status.val = 'pick the plan lines. Esc (or Pick Level Lines) when they are all in'
	!this.PickNext()
endmethod

------------------------------------------------------------------
-- second round. a fresh set of levels every time - a half-done  --
-- set from an earlier round is worth less than the confusion   --
-- of adding to it                                               --
------------------------------------------------------------------
define method .StartLevels()
	!this.levrefs = object ARRAY()
	!this.levlbls = object ARRAY()
	!this.levus = object ARRAY()
	!this.RefreshList()
	!this.phase = 'level'
	!this.status.val = !this.planrefs.size().string() & ' plan lines. now the level lines, in any order. Esc (or Create Boxes) when they are all in'
	!this.PickNext()
endmethod

define method .PickNext()
	if (!this.phase.eq('plan')) then
		!next = !this.planrefs.size() + 1
		!prompt = 'Plan grid line ' & !next.string() & ' (Esc when they are all in)'
	else
		!next = !this.levus.size() + 1
		!prompt = 'Level line ' & !next.string() & ' (Esc when they are all in)'
	endif

	!this.DropPicking()

	!packet = object EDGPACKET()
	!packet.definePosition(!prompt)
	!packet.pickPacket.stdElement(!prompt)
	!packet.type = ''
	!packet.description = !this.edgdesc
	!packet.action = |!!DrawingPlanGrid.Picked(!this.return[1])|
	!packet.escape = |!!DrawingPlanGrid.PickEscaped()|
	!packet.remove = false
	if (!!edgCntrl.add(!packet)) then
	endif
endmethod

------------------------------------------------------------------
-- takes our own packet back out of the event system. safe to    --
-- call when there is nothing registered                         --
------------------------------------------------------------------
define method .DropPicking()
	!!edgCntrl.remove(!this.edgdesc)
	handle any
	endhandle
endmethod

define method .StopPicking()
	!this.DropPicking()
	!this.phase = ''
	!this.status.val = 'picking stopped - ' & !this.planrefs.size().string() & ' plan lines kept. Pick Plan Lines carries on, Clear starts over'
endmethod

------------------------------------------------------------------
-- Esc in the 3D view. in the first round it is the way to say   --
-- the plan lines are all in, and the second round starts; in    --
-- the second it says the levels are all in, and the boxes are   --
-- made. the framework has already taken the packet out by the   --
-- time this runs                                                --
------------------------------------------------------------------
define method .PickEscaped()
	if (!this.phase.eq('plan')) then
		!this.StartLevels()
	elseif (!this.phase.eq('level')) then
		!this.phase = ''
		!this.CreateBoxes()
	else
		!this.StopPicking()
	endif
endmethod

------------------------------------------------------------------
-- something that is not usable was picked. say why and ask for --
-- the next one                                                  --
------------------------------------------------------------------
define method .Reject(!why is STRING)
	!this.status.val = !why
	!this.PickNext()
endmethod

---------------------------------------------------------------------
-- one pick in. !data is the EDGPICKDATA of an element pick; its   --
-- .item is the element under the cursor. a grid line is a REFGLN  --
-- and its P1/P2 are the ends of the line, the same pair            --
-- DrawingPlan1GridAnnotation reads. the round says what to do     --
-- with it                                                          --
---------------------------------------------------------------------
define method .Picked(!data is ANY)
	!item = !data.item
	handle any
		!this.Reject('nothing was picked - skipped')
		return
	endhandle
	if (not(!item.set())) then
		!this.Reject('nothing was picked - skipped')
		return
	endif

	!type = '?'
	!type = !item.type
	handle any
	endhandle
	if (!type.neq('REFGLN')) then
		!this.Reject('that is a ' & !type & ', not a grid line - skipped')
		return
	endif
	!refstr = !item.string()

	var !p1str p1 pos of $!refstr wrt worl
	handle any
		!this.Reject('cannot read the ends of ' & !refstr & ' - skipped')
		return
	endhandle
	var !p2str p2 pos of $!refstr wrt worl
	handle any
		!this.Reject('cannot read the ends of ' & !refstr & ' - skipped')
		return
	endhandle
	!p1 = object POSITION(!p1str)
	!p2 = object POSITION(!p2str)

	if (!this.phase.eq('plan')) then
		!this.PlanLinePicked(!item, !refstr, !p1, !p2)
	else
		!this.LevelLinePicked(!item, !refstr, !p1, !p2)
	endif
endmethod

---------------------------------------------------------------------
-- the number the line's bubble prints. a REFGLN is the trace of   --
-- one grid plane (its GRDREF) on another (its owner), and the     --
-- IDPLANE of a plane is what the bubble prints                    --
-- (DrawingPlan1GridAnnotation, 2026-09-07). which of the two      --
-- planes is wanted depends on the round: the column plane for a   --
-- plan line, the elevation plane for a level - and which of owner --
-- and GRDREF that is depends on which one the cursor happened to  --
-- land on. the horizontal one of the two is the elevation plane.  --
-- this is only for the list, so anything unreadable falls back   --
-- to the refno                                                    --
---------------------------------------------------------------------
define method .LabelOf(!item is DBREF, !refstr is STRING, !wantlevel is BOOLEAN) is STRING
	!ownerhoriz = !this.OwnerIsHorizontal(!item)
	!plref = ''
	!plref = !item.owner.string()
	handle any
		!plref = ''
	endhandle

	!useowner = false
	if (!ownerhoriz.eq('yes') and !wantlevel) then
		!useowner = true
	elseif (!ownerhoriz.eq('no') and not(!wantlevel)) then
		!useowner = true
	endif

	!lbl = ''
	if (!useowner and !plref.neq('')) then
		var !lbl idplane of $!plref
		handle any
			!lbl = ''
		endhandle
	else
		var !lbl idplane of grdref of $!refstr
		handle any
			!lbl = ''
		endhandle
	endif
	if (!lbl.trim().eq('')) then
		!lbl = !refstr
	endif
	return !lbl
endmethod

------------------------------------------------------------------
-- 'yes' when the plane the line is drawn on is horizontal, 'no' --
-- when it is not, '?' when it cannot be read. Z up or down is   --
-- horizontal                                                    --
------------------------------------------------------------------
define method .OwnerIsHorizontal(!item is DBREF) is STRING
	!plref = !item.owner.string()
	handle any
		return '?'
	endhandle
	var !oristr ori of $!plref wrt worl
	handle any
		return '?'
	endhandle
	!zdir = !oristr.orientation().zdir()
	handle any
		return '?'
	endhandle
	!angu = !zdir.angle(object DIRECTION('U'))
	if (!angu lt 1 or !angu gt 179) then
		return 'yes'
	endif
	return 'no'
endmethod

------------------------------------------------------------------
-- first round. any grid line with a length in plan will do,     --
-- whichever plane it is drawn on - only its plan geometry is    --
-- used. a vertical line has no direction in plan and is skipped --
------------------------------------------------------------------
define method .PlanLinePicked(!item is DBREF, !refstr is STRING, !p1 is POSITION, !p2 is POSITION)
	!lbl = !this.LabelOf(!item, !refstr, false)
	do !i from 1 to !this.planrefs.size()
		if (!this.planrefs[!i].eq(!refstr)) then
			!this.Reject('plan line ' & !lbl & ' is already picked - skipped')
			return
		endif
	enddo

	!dx = !p2.east - !p1.east
	!dy = !p2.north - !p1.north
	!len2 = !dx * !dx + !dy * !dy
	if (!len2 lt 1) then
		!this.Reject(!lbl & ' is a vertical line - it has no direction in plan, skipped')
		return
	endif

	!this.planrefs.append(!refstr)
	!this.planlbls.append(!lbl)
	!this.plane1.append(!p1.east)
	!this.plann1.append(!p1.north)
	!this.plane2.append(!p2.east)
	!this.plann2.append(!p2.north)
	!this.planu.append(!p1.up)

	!this.MarkLine(!p1.east, !p1.north, !p2.east, !p2.north, !p1.up, !lbl)
	!this.RefreshList()
	!this.status.val = 'plan line ' & !lbl & ' - ' & !this.planrefs.size().string() & ' so far. Esc (or Pick Level Lines) when they are all in'
	!this.PickNext()
endmethod

------------------------------------------------------------------
-- second round. the level is the U of the line, so it has to be --
-- horizontal - a vertical one says nothing about height. the    --
-- same level twice (the same edge on two faces) is dropped when --
-- the storeys are worked out, not here                          --
------------------------------------------------------------------
define method .LevelLinePicked(!item is DBREF, !refstr is STRING, !p1 is POSITION, !p2 is POSITION)
	!lbl = !this.LabelOf(!item, !refstr, true)
	!du = !p2.up - !p1.up
	if (!du.abs() gt 1) then
		!this.Reject(!lbl & ' is a vertical line - a level line runs horizontally, skipped')
		return
	endif
	do !i from 1 to !this.levrefs.size()
		if (!this.levrefs[!i].eq(!refstr)) then
			!this.Reject('level ' & !lbl & ' is already picked - skipped')
			return
		endif
	enddo

	!this.levrefs.append(!refstr)
	!this.levlbls.append(!lbl)
	!this.levus.append(!p1.up)
	!this.MarkLine(!p1.east, !p1.north, !p2.east, !p2.north, !p1.up, 'EL ' & !lbl)
	!this.RefreshList()
	!this.status.val = 'level ' & !lbl & ' - ' & !this.levus.size().string() & ' so far. Esc (or Create Boxes) when they are all in'
	!this.PickNext()
endmethod

---------------------------------------------------------------------
-- the boxes. the plan lines are sorted into two directions, each  --
-- direction is ordered across itself, and every neighbouring pair --
-- in one crossed with every neighbouring pair in the other is one --
-- bay. the three corners MakeBox wants are the crossings of the   --
-- two pairs: P1 and P2 along the first line of the pair in A, P3  --
-- on the next line of A. the levels are sorted the same way and   --
-- every neighbouring pair is one storey; every bay is made once   --
-- per storey                                                      --
---------------------------------------------------------------------
define method .CreateBoxes()
	!this.result.val = ''
	!this.DropPicking()
	!this.phase = ''
	!this.LoadDrawingPlan()
	!n = !this.planrefs.size()
	if (!n lt 4) then
		!!alert.error('at least four plan lines are needed - two in each direction')
		return
	endif

	------------------------------------------------------------------
	-- the storeys: the picked levels when there are two or more,   --
	-- otherwise the one storey typed on the form                   --
	------------------------------------------------------------------
	!levels = !this.SortedLevels()
	if (!levels.size() lt 2) then
		if (!this.ubot.val.trim().eq('') or !this.utop.val.trim().eq('')) then
			!!alert.error('at least two level lines are needed, or Bottom U and Top U typed in')
			return
		endif
		!lo = !!DrawingPlan.NumOf(!this.ubot.val)
		!hi = !!DrawingPlan.NumOf(!this.utop.val)
		if (!hi lt !lo) then
			!lo = !!DrawingPlan.NumOf(!this.utop.val)
			!hi = !!DrawingPlan.NumOf(!this.ubot.val)
		endif
		!levels = object ARRAY()
		!levels.append(!lo)
		!levels.append(!hi)
	endif
	!boff = !this.OffOf(!this.uboto.val)
	!toff = !this.OffOf(!this.utopo.val)

	------------------------------------------------------------------
	-- unit direction of every line in plan, with the sign settled  --
	-- so that a line and the same line the other way round compare --
	-- equal                                                        --
	------------------------------------------------------------------
	!dxs = object ARRAY()
	!dys = object ARRAY()
	do !i from 1 to !n
		!dx = !this.plane2[!i] - !this.plane1[!i]
		!dy = !this.plann2[!i] - !this.plann1[!i]
		!len2 = !dx * !dx + !dy * !dy
		!len = !len2.sqrt()
		!dx = !dx / !len
		!dy = !dy / !len
		if (!dy lt 0 or (!dy eq 0 and !dx lt 0)) then
			!dx = 0 - !dx
			!dy = 0 - !dy
		endif
		!dxs.append(!dx)
		!dys.append(!dy)
	enddo

	------------------------------------------------------------------
	-- two groups: A is whatever the first line runs along, B the   --
	-- first direction that is not A. parallel means the cross      --
	-- product of the unit directions is under sin(0.5 degrees)    --
	------------------------------------------------------------------
	!ax = !dxs[1]
	!ay = !dys[1]
	!bx = 0
	!by = 0
	!bset = false
	!grp = object ARRAY()
	do !i from 1 to !n
		!cr = !ax * !dys[!i] - !ay * !dxs[!i]
		if (!cr.abs() lt 0.0087) then
			!grp.append('A')
		elseif (not(!bset)) then
			!bx = !dxs[!i]
			!by = !dys[!i]
			!bset = true
			!grp.append('B')
		else
			!crb = !bx * !dys[!i] - !by * !dxs[!i]
			if (!crb.abs() lt 0.0087) then
				!grp.append('B')
			else
				!!alert.error('the plan lines run in three directions - a box has only two')
				return
			endif
		endif
	enddo
	if (not(!bset)) then
		!!alert.error('all the plan lines are parallel - lines across them are needed too')
		return
	endif

	!ia = !this.SortedGroup(!grp, 'A', !ax, !ay)
	!ib = !this.SortedGroup(!grp, 'B', !bx, !by)
	if (!ia.size() lt 2 or !ib.size() lt 2) then
		!!alert.error('two different lines are needed in each direction')
		return
	endif

	!made = 0
	!firsterr = ''
	!na = !ia.size() - 1
	!nb = !ib.size() - 1
	!ns = !levels.size() - 1
	do !s from 1 to !ns
		!s2 = !s + 1
		!ubot = !levels[!s] + !boff
		!utop = !levels[!s2] + !toff
		!dz = !utop - !ubot
		if (!dz.abs() lt 1) then
			if (!firsterr.eq('')) then
				!firsterr = 'a storey comes out with no height once the offsets are on'
			endif
		else
			do !i from 1 to !na
				do !j from 1 to !nb
					!i2 = !i + 1
					!j2 = !j + 1
					!p1 = !this.Cross(!ia[!i], !ib[!j])
					!p2 = !this.Cross(!ia[!i], !ib[!j2])
					!p3 = !this.Cross(!ia[!i2], !ib[!j])
					!err = !!DrawingPlan.MakeBox(!p1, !p2, !p3, !ubot, !utop, '', '', '', '', '')
					if (!err.eq('')) then
						!made = !made + 1
					elseif (!firsterr.eq('')) then
						!firsterr = !err
					endif
				enddo
			enddo
		endif
	enddo

	!this.result.val = !made.string() & ' box(es) made - ' & !na.string() & ' x ' & !nb.string() & ' bays, ' & !ns.string() & ' storey(s)'
	if (!firsterr.neq('')) then
		!!alert.error(!made.string() & ' box(es) made, the rest failed: ' & !firsterr)
	endif

	------------------------------------------------------------------
	-- done with these lines. the typed levels and the offsets stay --
	-- for the next batch, the picked lines and their aids go       --
	------------------------------------------------------------------
	if (!made gt 0) then
		!this.planrefs = object ARRAY()
		!this.planlbls = object ARRAY()
		!this.plane1 = object ARRAY()
		!this.plann1 = object ARRAY()
		!this.plane2 = object ARRAY()
		!this.plann2 = object ARRAY()
		!this.planu = object ARRAY()
		!this.levrefs = object ARRAY()
		!this.levlbls = object ARRAY()
		!this.levus = object ARRAY()
		!this.RefreshList()
		AID CLEAR ALL
	endif
endmethod

---------------------------------------------------------------------
-- the picked levels from low to high, with the same level twice   --
-- (the same edge picked on two faces, or two grid systems) kept   --
-- once. anything under 1mm apart is the same level                --
---------------------------------------------------------------------
define method .SortedLevels() is ARRAY
	!res = object ARRAY()
	if (!this.levus.size() eq 0) then
		return !res
	endif
	!order = !this.levus.sortedIndices()
	!last = 0
	!first = true
	do !k from 1 to !order.size()
		!oi = !order[!k]
		!u = !this.levus[!oi]
		!keep = true
		if (not(!first)) then
			!d = !u - !last
			if (!d.abs() lt 1) then
				!keep = false
			endif
		endif
		if (!keep) then
			!res.append(!u)
			!last = !u
			!first = false
		endif
	enddo
	return !res
endmethod

---------------------------------------------------------------------
-- the lines of one group in order across the group, as indices    --
-- into the plan arrays. 'across' is along the normal of the       --
-- group's direction, and a line under 1mm from the one before it  --
-- is the same grid line again (picked on another plane, or from   --
-- another grid system) and is dropped                             --
---------------------------------------------------------------------
define method .SortedGroup(!grp is ARRAY, !which is STRING, !dx is REAL, !dy is REAL) is ARRAY
	!idx = object ARRAY()
	!off = object ARRAY()
	do !i from 1 to !grp.size()
		if (!grp[!i].eq(!which)) then
			!o = !this.plann1[!i] * !dx - !this.plane1[!i] * !dy
			!idx.append(!i)
			!off.append(!o)
		endif
	enddo

	!order = !off.sortedIndices()
	!res = object ARRAY()
	!last = 0
	!first = true
	do !k from 1 to !order.size()
		!oi = !order[!k]
		!o = !off[!oi]
		!keep = true
		if (not(!first)) then
			!d = !o - !last
			if (!d.abs() lt 1) then
				!keep = false
			endif
		endif
		if (!keep) then
			!res.append(!idx[!oi])
			!last = !o
			!first = false
		endif
	enddo
	return !res
endmethod

---------------------------------------------------------------------
-- where plan line !i crosses plan line !j, as a position on level --
-- 0 in the shape MakeBox takes. the two are never parallel here   --
-- - they come from different groups                               --
---------------------------------------------------------------------
define method .Cross(!i is REAL, !j is REAL) is POSITION
	!px = !this.plane1[!i]
	!py = !this.plann1[!i]
	!dx = !this.plane2[!i] - !px
	!dy = !this.plann2[!i] - !py
	!qx = !this.plane1[!j]
	!qy = !this.plann1[!j]
	!ex = !this.plane2[!j] - !qx
	!ey = !this.plann2[!j] - !qy
	!cr = !dx * !ey - !dy * !ex
	!t = ((!qx - !px) * !ey - (!qy - !py) * !ex) / !cr
	!x = !px + !dx * !t
	!y = !py + !dy * !t
	return !!DrawingPlan.PosOf(!x, !y, 0)
endmethod

------------------------------------------------------------------
-- an offset field: blank is 0, otherwise a number in mm         --
------------------------------------------------------------------
define method .OffOf(!str is STRING) is REAL
	if (!str.trim().eq('')) then
		return 0
	endif
	return !!DrawingPlan.NumOf(!str)
endmethod

define method .RefreshList()
	!rows = object ARRAY()
	do !i from 1 to !this.planlbls.size()
		!rows.append('plan   ' & !this.planlbls[!i])
	enddo
	do !i from 1 to !this.levlbls.size()
		!rows.append('level  ' & !this.levlbls[!i] & '   U ' & !this.levus[!i].string('D1').replace('mm', ''))
	enddo
	if (!rows.size() eq 0) then
		!this.lines.clear()
	else
		!this.lines.dtext = !rows
	endif
endmethod

------------------------------------------------------------------
-- an aid along the picked line with its label at the middle.    --
-- coordinates go out one by one, not as a POSITION - a POSITION --
-- expands with a WRT tail that AID will not take (the same trap --
-- noted on DrawingPlan.MarkOne()). the aids are only feedback,  --
-- so a failure here is swallowed                                --
------------------------------------------------------------------
define method .MarkLine(!e1 is REAL, !n1 is REAL, !e2 is REAL, !n2 is REAL, !u is REAL, !lbl is STRING)
	!s1 = 'E ' & !e1.string().replace('mm', '') & ' N ' & !n1.string().replace('mm', '') & ' U ' & !u.string().replace('mm', '')
	!s2 = 'E ' & !e2.string().replace('mm', '') & ' N ' & !n2.string().replace('mm', '') & ' U ' & !u.string().replace('mm', '')
	AID LINE $!s1 TO $!s2
	handle any
	endhandle
	!em = (!e1 + !e2) * 0.5
	!nm = (!n1 + !n2) * 0.5
	!emstr = !em.string().replace('mm', '')
	!nmstr = !nm.string().replace('mm', '')
	!ustr = !u.string().replace('mm', '')
	AID TEXT |$!lbl| AT E $!emstr N $!nmstr U $!ustr
	handle any
	endhandle
endmethod

define method .Close()
	!this.DropPicking()
	AID CLEAR ALL
	kill !!DrawingPlanGrid
endmethod

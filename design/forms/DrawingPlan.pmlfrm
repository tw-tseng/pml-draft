-----------------------------------------------------
-- Copyright ATOMTECH Ltd 2024                     --
--                                                 --
-- Function : Create Volumn for Drawings in Design --
-- Author   : Tseng                                --
-- Date     : 2024/06/24                           --
--                                                 --
-- A drawing frame is given by four picked points: --
--   P1 -> P2  first edge, gives one length and    --
--             the angle of the frame. the U of P1 --
--             is the first level of the box       --
--   P3        anything off that line, gives the   --
--             other length and which side the     --
--             frame runs to                       --
--   P4        only its U is read, the second      --
--             level of the box. E and N ignored   --
-- The Import tab has no picks, so it takes the    --
-- two levels off the file or off its own Bottom   --
-- U / Top U boxes instead.                        --
-- The Grid tab picks grid lines rather than       --
-- points - plan lines in one round, level lines   --
-- in the next - and makes a box for every bay on  --
-- every storey they enclose (it was a form of its --
-- own, DrawingPlanGrid, until 2026-09-19).        --
-- Every tab only has to end up with three plan    --
-- points and two levels and hand them to          --
-- .MakeBox(), so a new way of setting out         --
-- drawings is a new tab and nothing else.         --
-----------------------------------------------------

import 'PMLFileBrowser'
handle any
endhandle

layout form !!DrawingPlan dialog dock

	member .userevar is STRING
	member .edgdesc  is STRING

	------------------------------------------------------------------
	-- Grid tab - which round its picks belong to: 'plan', 'level'  --
	-- or '' when nothing is being picked                            --
	------------------------------------------------------------------
	member .gridphase is STRING

	------------------------------------------------------------------
	-- the plan lines picked so far. one entry per line in each      --
	-- array: the refno (to spot the same line picked twice), the    --
	-- label for the list, the two ends in plan and the level the    --
	-- line sits on (only for drawing the aid on it)                 --
	------------------------------------------------------------------
	member .planrefs is ARRAY
	member .planlbls is ARRAY
	member .plane1   is ARRAY
	member .plann1   is ARRAY
	member .plane2   is ARRAY
	member .plann2   is ARRAY
	member .planu    is ARRAY

	------------------------------------------------------------------
	-- the level lines picked in this round                          --
	------------------------------------------------------------------
	member .levrefs  is ARRAY
	member .levlbls  is ARRAY
	member .levus    is ARRAY

	------------------------------------------------------------------
	-- Split tab - the box being split is looked up and its geometry --
	-- cached once, at Show Box time, so the split itself works off  --
	-- these even if CE has moved on to something else by the time   --
	-- the split point is picked                                     --
	------------------------------------------------------------------
	member .splitequi     is STRING
	member .splitcen      is POSITION
	member .splitpickpos  is POSITION
	member .splitxdirstr  is STRING
	member .splitydirstr  is STRING
	member .splitxlen     is REAL
	member .splitylen     is REAL
	member .splitzlen     is REAL
	member .splitrev      is STRING
	member .splittitle1   is STRING
	member .splittitle2   is STRING
	member .splittitle3   is STRING
	member .facepickpos   is POSITION

	!this.formTitle = 'Create Drawing Plan Box'

	frame .tabset tabset

		----------------------------------------------------------------
		-- pick the four points in the 3D view. one button, then the   --
		-- four picks come one after the other and the box is made at  --
		-- the end of them                                             --
		----------------------------------------------------------------
		frame .pickfr 'Pick' width 66
			button .pickbt 'Pick 4 Points' width 16 call |!This.PickPoints()|

			para .pa1  at xmin.pickbt ymax.pickbt+0.3 text 'P1  E'
			text .p1e  at xmax.pa1+0.3  ymin.pa1 width 12 is STRING
			para .pa1n at xmax.p1e+0.5  ymin.pa1 text 'N'
			text .p1n  at xmax.pa1n+0.3 ymin.pa1 width 12 is STRING
			para .pa1u at xmax.p1n+0.5  ymin.pa1 text 'U'
			text .p1u  at xmax.pa1u+0.3 ymin.pa1 width 12 is STRING

			para .pa2  at xmin.pa1 ymax.pa1+0.2 text 'P2  E'
			text .p2e  at xmax.pa2+0.3  ymin.pa2 width 12 is STRING
			para .pa2n at xmax.p2e+0.5  ymin.pa2 text 'N'
			text .p2n  at xmax.pa2n+0.3 ymin.pa2 width 12 is STRING
			para .pa2u at xmax.p2n+0.5  ymin.pa2 text 'U'
			text .p2u  at xmax.pa2u+0.3 ymin.pa2 width 12 is STRING

			para .pa3  at xmin.pa2 ymax.pa2+0.2 text 'P3  E'
			text .p3e  at xmax.pa3+0.3  ymin.pa3 width 12 is STRING
			para .pa3n at xmax.p3e+0.5  ymin.pa3 text 'N'
			text .p3n  at xmax.pa3n+0.3 ymin.pa3 width 12 is STRING
			para .pa3u at xmax.p3n+0.5  ymin.pa3 text 'U'
			text .p3u  at xmax.pa3u+0.3 ymin.pa3 width 12 is STRING

			para .pa4  at xmin.pa3 ymax.pa3+0.2 text 'P4  E'
			text .p4e  at xmax.pa4+0.3  ymin.pa4 width 12 is STRING
			para .pa4n at xmax.p4e+0.5  ymin.pa4 text 'N'
			text .p4n  at xmax.pa4n+0.3 ymin.pa4 width 12 is STRING
			para .pa4u at xmax.p4n+0.5  ymin.pa4 text 'U'
			text .p4u  at xmax.pa4u+0.3 ymin.pa4 width 12 is STRING

			button .create 'Create Box'   at xmin.pa4     ymax.pa4+0.4 width 12 call |!This.CreateBox()|
			button .clearp 'Clear Points' at xmax.create+1 ymin.create  width 12 call |!This.ClearPoints()|
			button .delete 'Delete Box'   at xmax.clearp+1 ymin.create  width 12 call |!This.DeleteBox()|
		exit

		----------------------------------------------------------------
		-- the frame edges are grid lines picked in the 3D view, in   --
		-- two rounds: plan lines (any number, two directions) and    --
		-- level lines. each round is started by its own button and   --
		-- ended by Esc, and nothing follows on by itself - the       --
		-- levels can just as well be typed or picked as points, and  --
		-- the boxes are only made by Create Boxes. every neighbouring --
		-- pair of plan lines in one direction crossed with every      --
		-- neighbouring pair in the other is one bay, every            --
		-- neighbouring pair of levels one storey, and a box is made   --
		-- for every bay on every storey in one go                     --
		----------------------------------------------------------------
		frame .gridfr 'Grid' width 66
			button .gplanbt  'Pick Plan Lines'  width 16 call |!This.GridPickPlan()|
			button .glevbt   'Pick Level Lines' at xmax.gplanbt+1 ymin.gplanbt width 16 call |!This.GridPickLevels()|
			button .gstopbt  'Stop'  at xmax.glevbt+1  ymin.gplanbt width 8 call |!This.GridStop()|
			button .gclearbt 'Clear' at xmax.gstopbt+1 ymin.gplanbt width 8 call |!This.GridClear()|

			para .gstatus at xmin.gplanbt ymax.gplanbt+0.3 text '' width 62

			list .glines 'Picked grid lines' at xmin.gplanbt ymax.gstatus+0.2 width 62 height 8

			------------------------------------------------------------
			-- two more levels, typed or picked as points (Pick takes  --
			-- the U of a point in the 3D view). they go into the same --
			-- sorted set as the level lines, so on their own they are --
			-- one storey (a grid with no elevation planes) and with   --
			-- lines picked as well they add the storeys above and    --
			-- below (user, 2026-09-20). Top is on the upper row, the   --
			-- way the levels sit in the model. the offsets go on      --
			-- every box whichever way the levels came, added as they  --
			-- are: + is up, - is down. they are kept from one batch   --
			-- to the next                                             --
			------------------------------------------------------------
			frame .glevfr 'Levels' at xmin.gplanbt ymax.glines+0.3 width 62
				para .glevpa text 'Top / Bottom U count as levels too. offset: + up, - down' width 58

				text   .gutop   'Top U'    at xmin.glevpa    ymax.glevpa+0.3 tagwidth 10 width 12 is STRING
				button .gutoppk 'Pick'     at xmax.gutop+0.5  ymin.gutop      width 6 call |!This.GridPickLevel('top')|
				text   .gutopo  'offset'   at xmax.gutoppk+1 ymin.gutop      tagwidth 7  width 10 is STRING

				text   .gubot   'Bottom U' at xmin.gutop     ymax.gutop+0.2  tagwidth 10 width 12 is STRING
				button .gubotpk 'Pick'     at xmax.gubot+0.5  ymin.gubot      width 6 call |!This.GridPickLevel('bot')|
				text   .guboto  'offset'   at xmax.gubotpk+1 ymin.gubot      tagwidth 7  width 10 is STRING
			exit

			button .gcreate 'Create Boxes' at xmin.glevfr ymax.glevfr+0.3 width 14 call |!This.GridCreateBoxes()|
			para .gresult at xmax.gcreate+1 ymin.gcreate text '' width 46
		exit

		----------------------------------------------------------------
		-- drawing number and the sheet texts. these end up as TEXT    --
		-- elements under the EQUI in the 'tag:value' shape the        --
		-- drawing side reads back                                     --
		----------------------------------------------------------------
		frame .infofr 'Info' width 66
			text .dwgno 'Drawing No.' tagwidth 12 width 40 is STRING

			text .revtext    'Rev'     at xmin.dwgno    ymax.dwgno+0.3      tagwidth 12 width 40 is STRING
			text .title1text 'Title 1' at xmin.revtext  ymax.revtext+0.1    tagwidth 12 width 40 is STRING
			text .title2text 'Title 2' at xmin.revtext  ymax.title1text+0.1 tagwidth 12 width 40 is STRING
			text .title3text 'Title 3' at xmin.revtext  ymax.title2text+0.1 tagwidth 12 width 40 is STRING

			button .inforead  'Read CE' at xmin.revtext   ymax.title3text+0.3 width 12 call |!This.ReadInfo()|
			button .infoapply 'Apply'   at xmax.inforead+1 ymin.inforead      width 12 call |!This.ApplyInfo()|
		exit

		----------------------------------------------------------------
		-- name a multi-selection of boxes in one go: Prefix + a       --
		-- running sequence, ordered by two axes (2nd breaks ties on   --
		-- the 1st) rather than by selection/click order               --
		----------------------------------------------------------------
		frame .batchfr 'Batch' width 66
			text .batchprefix 'Prefix'   tagwidth 10 width 14 is STRING
			text .batchstart  'Start at' at xmax.batchprefix+1 ymin.batchprefix tagwidth 10 width 10 is STRING

			option .batchdir  'Order by (1st)' at xmin.batchprefix ymax.batchprefix+0.3 width 22
			option .batchdir2 'Order by (2nd)' at xmin.batchdir    ymax.batchdir+0.2   width 22
			toggle .batchskip at xmin.batchdir2 ymax.batchdir2+0.2 'Skip already-named'

			button .batchgo 'Assign Numbers' at xmin.batchskip ymax.batchskip+0.3 width 16 call |!This.AssignNumbers()|

			para .batchresult at xmin.batchgo ymax.batchgo+0.3 text '' width 62
		exit

		-------------------------------------------
		-- read the points out of a file from CAD --
		-------------------------------------------
		frame .importfr 'Import' width 66
			text .filetext 'File' tagwidth 6 width 44 is STRING
			button .filebt 'Browse' at xmax.filetext+0.4 ymin.filetext width 10 call |!This.BrowseFile()|

			text .ubot 'Bottom U' at xmin.filetext ymax.filetext+0.3 tagwidth 12 width 14 is REAL
			text .utop 'Top U' at xmax.ubot+2 ymin.ubot tagwidth 8 width 14 is REAL

			button .importbt 'Import' at xmin.ubot ymax.ubot+0.3 width 12 call |!This.ImportFile()|
			list .log 'Result' at xmin.importbt ymax.importbt+0.3 width 62 height 10
		exit

		----------------------------------------------------------------
		-- change boxes that already exist: Split cuts one into 2 (or --
		-- more) along its own X/Y/Z, Move Face pushes one face of a  --
		-- box out or in with the opposite face staying put, Merge    --
		-- replaces several with the one box that covers them.        --
		-- Show Box locks in which box and draws its axes; the split  --
		-- and the face move work off that cached geometry, not off   --
		-- CE, so looking around the model in between does not lose  --
		-- the target                                                  --
		----------------------------------------------------------------
		frame .splitfr 'Modify' width 66
			------------------------------------------------------------
			-- the three steps in one line at the top, then the box    --
			-- that is about to be changed, by name and size, so it is --
			-- never a guess which one an action will hit               --
			------------------------------------------------------------
			para .modhint text '1. select a box in the model   2. Show Box   3. one action below' width 62

			button .showbox 'Show Box' at xmin.modhint ymax.modhint+0.2 width 12 call |!This.ShowBox()|
			para .boxinfo at xmax.showbox+1 ymin.showbox text '(no box yet)' width 48

			------------------------------------------------------------
			-- Split: the box is cut at a picked point along the ticked --
			-- axes. Offset shifts the cut from the point actually     --
			-- picked (snap to a beam, cut 50 below it)                 --
			------------------------------------------------------------
			frame .splitsub 'Split' at xmin.modhint ymax.showbox+0.4 width 62
				para .splithint text 'cut at a picked point, along the ticked axes. offset (mm) shifts the cut' width 58

				toggle .splitx at xmin.splithint ymax.splithint+0.2 'X'
				text .splitxoff 'offset' at xmax.splitx+1 ymin.splitx tagwidth 7 width 9 is REAL
				para .splitxmm at xmax.splitxoff+0.2 ymin.splitx text 'mm'

				toggle .splity at xmin.splitx ymax.splitx+0.1 'Y'
				text .splityoff 'offset' at xmax.splity+1 ymin.splity tagwidth 7 width 9 is REAL
				para .splitymm at xmax.splityoff+0.2 ymin.splity text 'mm'

				toggle .splitz at xmin.splity ymax.splity+0.1 'Z'
				text .splitzoff 'offset' at xmax.splitz+1 ymin.splitz tagwidth 7 width 9 is REAL
				para .splitzmm at xmax.splitzoff+0.2 ymin.splitz text 'mm'

				button .splitpick 'Pick Split Point' at xmin.splitx ymax.splitz+0.3 width 16 call |!This.PickSplitPoint()|
			exit

			------------------------------------------------------------
			-- Move Face: one face, named along the box's own axes as  --
			-- Show Box draws them, and three ways to say where it     --
			-- goes, one per row with its button on the right: an      --
			-- offset (+ out, - in), a world coordinate (for a face    --
			-- square to E/N/U), or a picked point                     --
			------------------------------------------------------------
			frame .facesub 'Move Face' at xmin.splitsub ymax.splitsub+0.3 width 62
				para .facehint1 text 'one face goes out or in, the opposite face stays put' width 58
				para .facehint2 at xmin.facehint1 ymax.facehint1+0.05 text 'X / Y / Z are the axes Show Box draws in the 3D view' width 58

				option .faceopt 'Face' at xmin.facehint2 ymax.facehint2+0.3 tagwidth 15 width 12

				text .faceoff 'by offset' at xmin.faceopt ymax.faceopt+0.2 tagwidth 15 width 9 is REAL
				para .facemm at xmax.faceoff+0.2 ymin.faceoff text 'mm  (+ out, - in)'
				button .facebybt 'Move' at xmin.faceoff+44 ymin.faceoff width 8 call |!This.MoveFaceBy()|

				text .faceto 'to coordinate' at xmin.faceoff ymax.faceoff+0.1 tagwidth 15 width 9 is REAL
				para .facetomm at xmax.faceto+0.2 ymin.faceto text 'E / N / U (world)'
				button .facetobt 'Move' at xmin.faceoff+44 ymin.faceto width 8 call |!This.MoveFaceTo()|

				para .facepklbl at xmin.faceto ymax.faceto+0.25 text 'to a picked point' width 15
				button .facepkbt 'Pick' at xmin.faceoff+44 ymin.facepklbl width 8 call |!This.PickFacePoint()|
			exit

			------------------------------------------------------------
			-- Merge works on the model selection, not on Show Box's   --
			-- one box                                                  --
			------------------------------------------------------------
			frame .mergesub 'Merge' at xmin.facesub ymax.facesub+0.3 width 62
				para .mergehint text 'select several boxes in the model (ctrl-click), then' width 40
				button .mergebt 'Merge Selected' at xmax.mergehint+1 ymin.mergehint width 16 call |!This.MergeBoxes()|
			exit

			para .splitresult at xmin.mergesub ymax.mergesub+0.3 text '' width 62
		exit

	exit

	button .Cancel 'Close' at xmin.tabset ymax.tabset+0.3 width 10 call '!This.Close()'

exit

-------------------
-- form start up --
-------------------
define method .DrawingPlan()
	AID CLEAR ALL
	!this.edgdesc = 'Drawing Plan Box Picking'
	!this.ClearPoints()
	!this.ClearInfo()
	!this.log.clear()
	!this.splitresult.val = ''
	!this.splitequi = ''

	------------------------------------------------------------------
	-- Grid tab starts with nothing picked and no offset. the        --
	-- offsets are only defaulted here - GridClear leaves them alone --
	------------------------------------------------------------------
	!this.gridphase = ''
	!this.guboto.val = '0'
	!this.gutopo.val = '0'
	!this.GridClear()

	------------------------------------------------------------------
	-- most drawing plan boxes are cut into storeys, so Z is the     --
	-- axis split along most often - default it on, X/Y off          --
	------------------------------------------------------------------
	!this.splitz.val = true

	------------------------------------------------------------------
	-- Move Face's faces, in the box's own axes. Top is the default  --
	-- - a storey height changing is the usual reason to move a     --
	-- face at all                                                   --
	------------------------------------------------------------------
	!faces = ARRAY()
	!faces.append('+X')
	!faces.append('-X')
	!faces.append('+Y')
	!faces.append('-Y')
	!faces.append('Top (+Z)')
	!faces.append('Bottom (-Z)')
	!this.faceopt.dtext = !faces
	!this.faceopt.val = 5

	------------------------------------------------------------------
	-- Batch's Order By choices, 1st and 2nd share the same list.   --
	-- default is 'Bottom -> Top (U)' then 'West -> East (E)' -      --
	-- storey first, left to right within a storey second, which is  --
	-- the combination the user actually asked for. 'left to right'  --
	-- only has a fixed meaning on a plan that follows the north-up  --
	-- convention, where it reads as West -> East - the options are  --
	-- spelled out in compass terms instead of guessing that         --
	-- convention silently                                           --
	------------------------------------------------------------------
	!dirs = ARRAY()
	!dirs.append('Bottom -> Top (U)')
	!dirs.append('Top -> Bottom (U)')
	!dirs.append('West -> East (E)')
	!dirs.append('East -> West (E)')
	!dirs.append('South -> North (N)')
	!dirs.append('North -> South (N)')
	!this.batchdir.dtext = !dirs
	!this.batchdir.val = 1
	------------------------------------------------------------------
	-- 2nd also offers '(none)' - not every batch needs a tie        --
	-- breaker, and forcing one would sort ties by whichever axis    --
	-- happened to be picked rather than leaving them as found        --
	------------------------------------------------------------------
	!dirs2 = ARRAY()
	!dirs2.append('(none)')
	!dirs2.append('Bottom -> Top (U)')
	!dirs2.append('Top -> Bottom (U)')
	!dirs2.append('West -> East (E)')
	!dirs2.append('East -> West (E)')
	!dirs2.append('South -> North (N)')
	!dirs2.append('North -> South (N)')
	!this.batchdir2.dtext = !dirs2
	!this.batchdir2.val = 4
	!this.batchskip.val = true
	!this.batchresult.val = ''

	------------------------------------------------------------------
	-- Batch Number defaults. Start at is STRING, not REAL - typing  --
	-- '001' both sets the starting number and, by how many          --
	-- characters were typed, the zero padding, so one field does    --
	-- the job the separate Start at / Digits pair did before        --
	------------------------------------------------------------------
	!this.batchprefix.val = 'DWGNO-'
	!this.batchstart.val = '001'

	------------------------------------------------------------------
	-- default elevation range for the Import tab, so a first import --
	-- does not skip every line for want of a number nobody has      --
	-- typed in yet. only a starting point - change per project      --
	------------------------------------------------------------------
	!this.ubot.val = 0
	!this.utop.val = 50000

	------------------------------------------------------------------
	-- the coordinates can be typed as well as picked, so the marks  --
	-- in the 3D view have to follow the fields either way           --
	------------------------------------------------------------------
	!this.p1e.CALLBACK = |!this.RefreshMarks()|
	!this.p1n.CALLBACK = |!this.RefreshMarks()|
	!this.p1u.CALLBACK = |!this.RefreshMarks()|
	!this.p2e.CALLBACK = |!this.RefreshMarks()|
	!this.p2n.CALLBACK = |!this.RefreshMarks()|
	!this.p2u.CALLBACK = |!this.RefreshMarks()|
	!this.p3e.CALLBACK = |!this.RefreshMarks()|
	!this.p3n.CALLBACK = |!this.RefreshMarks()|
	!this.p3u.CALLBACK = |!this.RefreshMarks()|
	!this.p4e.CALLBACK = |!this.RefreshMarks()|
	!this.p4n.CALLBACK = |!this.RefreshMarks()|
	!this.p4u.CALLBACK = |!this.RefreshMarks()|
endmethod

--------------------------------------------------------------------
-- geometry and element creation, shared by every tab.             --
-- returns an empty string when the box was made, otherwise the    --
-- reason why it was not, so a caller working through a file can   --
-- log the bad line and carry on with the rest                     --
--------------------------------------------------------------------
define method .MakeBox(!p1 is POSITION, !p2 is POSITION, !p3 is POSITION, !ubot is REAL, !utop is REAL, !dwgno is STRING, !rev is STRING, !title1 is STRING, !title2 is STRING, !title3 is STRING) is STRING

	!ucen = (!ubot + !utop) * 0.5
	!zlen = abs(!utop - !ubot)
	if (!zlen lt 1) then
		return 'Bottom U and Top U are the same'
	endif

	!e1 = !p1.east
	!n1 = !p1.north
	!e2 = !p2.east
	!n2 = !p2.north
	!e3 = !p3.east
	!n3 = !p3.north

	-----------------------------------------------------------------
	-- work on plan only. all three points are put on the same level --
	-- so the direction taken further down comes out horizontal      --
	-----------------------------------------------------------------
	!pfrom = !this.PosOf(!e1, !n1, !ucen)
	!pto2 = !this.PosOf(!e2, !n2, !ucen)
	!pto3 = !this.PosOf(!e3, !n3, !ucen)

	!xlen = !pfrom.distance(!pto2)
	if (!xlen lt 1) then
		return 'P1 and P2 are the same point'
	endif
	!ux = (!e2 - !e1) / !xlen
	!uy = (!n2 - !n1) / !xlen

	-------------------------------------------------------------------
	-- foot of the perpendicular dropped from P3 onto the line P1P2.  --
	-- foot -> P3 is the second axis of the box with the side P3 is   --
	-- on already built into it, and their distance is the second     --
	-- length, so neither an angle nor a square root is needed here   --
	-------------------------------------------------------------------
	!t = (!e3 - !e1) * !ux + (!n3 - !n1) * !uy
	!footE = !e1 + !ux * !t
	!footN = !n1 + !uy * !t
	!pfoot = !this.PosOf(!footE, !footN, !ucen)

	!ylen = !pfoot.distance(!pto3)
	if (!ylen lt 1) then
		return 'P3 is only ' & !ylen.string() & ' away from the line P1 P2. its distance from that line is the other size of the frame, so it has to be picked well off it'
	endif

	---------------------------------------------------------------------
	-- the box is centred and symmetric about its own axes, so only Y   --
	-- has to be given. X then follows from Y and Z and lands along     --
	-- P1 -> P2, and whether it points forwards or backwards along that --
	-- edge describes the same box                                      --
	---------------------------------------------------------------------
	!ydir = !pfoot.direction(!pto3).string().before('WRT')

	!ecen = !e1 + !ux * !xlen * 0.5 + (!e3 - !footE) * 0.5
	!ncen = !n1 + !uy * !xlen * 0.5 + (!n3 - !footN) * 0.5
	!pcen = !this.PosOf(!ecen, !ncen, !ucen)

	return !this.MakeBoxAt(!pcen, !ydir, !xlen, !ylen, !zlen, !dwgno, !rev, !title1, !title2, !title3)
endmethod

---------------------------------------------------------------------
-- the element-creation half of box making, on its own so Split Box --
-- (below) can reuse it: a split piece already has a centre, a      --
-- length on each axis and the parent box's own Y direction - it    --
-- never needs the three-point geometry above                       --
---------------------------------------------------------------------
define method .MakeBoxAt(!pcen is POSITION, !ydirstr is STRING, !xlen is REAL, !ylen is REAL, !zlen is REAL, !dwgno is STRING, !rev is STRING, !title1 is STRING, !title2 is STRING, !title3 is STRING) is STRING
	!err = !this.GotoBoxSite()
	if (!err.neq('')) then
		return !err
	endif

	!ok = true
	if (!dwgno.neq('')) then
		----------------------------------------------------------------
		-- the user may or may not type the leading slash, and '//name' --
		-- is not a name PDMS will take                                 --
		----------------------------------------------------------------
		!fullname = !dwgno
		if (!fullname.substring(1,1).neq('/')) then
			!fullname = '/' & !fullname
		endif
		new equi $!fullname
		handle any
			!ok = false
		endhandle
		if (not(!ok)) then
			return 'cannot create EQUI ' & !fullname & ' - the name is probably in use already'
		endif
	else
		new equi
		handle any
			!ok = false
		endhandle
		if (not(!ok)) then
			return 'cannot create EQUI'
		endif
	endif

	var !equi namn of ce
	!equinav = !this.NavName(!equi)

	!ok = true
	new box
	handle any
		!ok = false
	endhandle
	if (not(!ok)) then
		return 'cannot create BOX under ' & !equi
	endif

	POS $!pcen
	------------------------------------------------------------------
	-- two axes on one ORI have to be joined with 'and' - writing    --
	-- 'ORI Y is S Z is U' is a syntax error                         --
	------------------------------------------------------------------
	ORI Y is $!ydirstr and Z is U WRT /*
	XLEN $!xlen
	YLEN $!ylen
	ZLEN $!zlen
	LEVEL 1 5

	!this.SetTagText(!equinav, 'rev', !rev)
	!this.SetTagText(!equinav, 'title1', !title1)
	!this.SetTagText(!equinav, 'title2', !title2)
	!this.SetTagText(!equinav, 'title3', !title3)

	$!equinav
	return ''
endmethod

---------------------------------------------------------------------
-- NAMN answers a name without its leading slash, and '=nnnn/nnnn'  --
-- when the element has no name at all. neither form can be handed  --
-- straight to $! to navigate with, so put the slash back on the    --
-- named ones. same rule DrawingPlan1.Apply() uses on its box list  --
---------------------------------------------------------------------
define method .NavName(!namn is STRING) is STRING
	if (!namn.substring(1,1).eq('=')) then
		return !namn
	endif
	return '/' & !namn
endmethod

---------------------------------------------------------------------
-- finds the TEXT under !equinav whose STEXT starts '!tag:', and    --
-- returns a navigable ref to it, or '' when there is none. shared  --
-- by .SetTagText() (which needs the element, to overwrite it) and  --
-- .TagValue() below (which needs what is after the colon)          --
---------------------------------------------------------------------
define method .FindTagText(!equinav is STRING, !tag is STRING) is STRING
	$!equinav
	!found = ''
	var !texts coll all text for ce
	if (not(!texts.unset())) then
		do !t values !texts
			!stext = ''
			var !stext stext of $!t
			handle any
				!stext = ''
			endhandle
			if (!stext.matchwild(!tag & ':*')) then
				!found = !t
			endif
		enddo
	endif
	return !found
endmethod

---------------------------------------------------------------------
-- rev / title1..3 travel as TEXT elements under the EQUI, in the   --
-- same 'tag:value' shape DrawingPlan1.Apply() already scans for.   --
--                                                                  --
-- set, not add: an existing tag of the same name is overwritten,   --
-- so pressing Apply twice on a box, or picking a new box while the --
-- Info tab still holds the last sheet's titles, cannot leave two   --
-- 'rev:' texts under one EQUI for the drawing side to choose       --
-- between. a blank value is left alone rather than clearing the    --
-- tag, so Apply can never take information off a box by accident   --
--                                                                  --
-- navigating back to the EQUI matters - NEW TEXT leaves CE on the  --
-- text it just made, so without this the four tags would be built  --
-- one inside the next instead of side by side.                     --
-- a failure here must not cost the box, so it is swallowed         --
---------------------------------------------------------------------
define method .SetTagText(!equinav is STRING, !tag is STRING, !value is STRING)
	if (!value.eq('')) then
		return
	endif
	!found = !this.FindTagText(!equinav, !tag)

	!ok = true
	if (!found.neq('')) then
		$!found
		handle any
			!ok = false
		endhandle
	else
		$!equinav
		new text
		handle any
			!ok = false
		endhandle
	endif

	if (!ok) then
		STEXT |$!tag:$!value|
		handle any
		endhandle
	endif
	$!equinav
endmethod

---------------------------------------------------------------------
-- the value after 'tag:' on the box's TEXT, or '' when there is    --
-- no such tag yet. used by Read CE to bring a box's existing       --
-- rev/titles into the Info tab                                     --
---------------------------------------------------------------------
define method .TagValue(!equinav is STRING, !tag is STRING) is STRING
	!found = !this.FindTagText(!equinav, !tag)
	if (!found.eq('')) then
		return ''
	endif
	$!found
	!stext = ''
	var !stext stext of ce
	handle any
		!stext = ''
	endhandle
	$!equinav
	return !stext.after(!tag & ':')
endmethod

---------------------------------------------------------------------
-- the EQUI of the box the user has navigated to, or an empty       --
-- string when the current element is not one of ours - in which    --
-- case the reason has already been put on screen.                  --
-- shared by Delete Box and by Apply on the Info tab                 --
---------------------------------------------------------------------
define method .CurrentBoxEqui() is STRING
	var !projid proj id
	!sitename = '/' & !projid & '_DrawingPlanBox'

	!ok = true
	var !site name of site of ce
	handle any
		!ok = false
	endhandle
	if (not(!ok)) then
		!!alert.error('Navigate to the box first')
		return ''
	endif
	if (not(!site.eq(!sitename))) then
		!!alert.error('The current element is not under ' & !sitename)
		return ''
	endif

	!ok = true
	var !equi namn of equi of ce
	handle any
		!ok = false
	endhandle
	if (not(!ok)) then
		!!alert.error('The current element is not part of a drawing plan box')
		return ''
	endif

	return !equi
endmethod

---------------------------------------------------------------------
-- Info tab - put the sheet information on the box the user has     --
-- navigated to. this is the way the boxes get labelled in          --
-- practice: pick all the frames first, then go round them one at   --
-- a time filling in the numbers                                    --
---------------------------------------------------------------------
define method .ApplyInfo()
	!equi = !this.CurrentBoxEqui()
	if (!equi.eq('')) then
		return
	endif
	!equinav = !this.NavName(!equi)

	!dwgno = !this.dwgno.val
	if (!dwgno.neq('')) then
		!fullname = !dwgno
		if (!fullname.substring(1,1).neq('/')) then
			!fullname = '/' & !fullname
		endif

		---------------------------------------------------------------
		-- E3D refuses a duplicate name, and it refuses it with its   --
		-- own error rather than anything this form can explain, so   --
		-- look the drawing number up first and say who has it.       --
		-- finding it on the very box being labelled is not a clash - --
		-- that is just Apply pressed a second time                   --
		---------------------------------------------------------------
		!taken = false
		!existing = ''
		$!fullname
		handle any
			!taken = false
		elsehandle none
			!taken = true
			var !existing namn of ce
		endhandle
		$!equinav

		if (!taken and !existing.neq(!equi)) then
			!!alert.error('Drawing No. ' & !dwgno & ' is already used by /' & !existing)
			return
		endif

		!ok = true
		NAME $!fullname
		handle any
			!ok = false
		endhandle
		if (not(!ok)) then
			!!alert.error('Cannot name the box ' & !fullname)
			return
		endif

		var !equi namn of ce
		!equinav = !this.NavName(!equi)
	endif

	!this.SetTagText(!equinav, 'rev', !this.revtext.val)
	!this.SetTagText(!equinav, 'title1', !this.title1text.val)
	!this.SetTagText(!equinav, 'title2', !this.title2text.val)
	!this.SetTagText(!equinav, 'title3', !this.title3text.val)
	$!equinav
endmethod

---------------------------------------------------------------------
-- Info tab - Read CE. loads the Info tab from the box the user has --
-- navigated to, so Apply is not working blind: without this, an    --
-- Apply with a blank Rev would look harmless but is only safe      --
-- because blanks are left alone (see .SetTagText()) - the user     --
-- still has to know what is already there before deciding what to  --
-- change. an unnamed box (ref name, '=nnnn/nnnn') leaves the       --
-- Drawing No. field blank rather than showing the ref               --
---------------------------------------------------------------------
define method .ReadInfo()
	!equi = !this.CurrentBoxEqui()
	if (!equi.eq('')) then
		return
	endif
	!equinav = !this.NavName(!equi)

	if (!equi.substring(1,1).eq('=')) then
		!this.dwgno.val = ''
	else
		!this.dwgno.val = !equi
	endif

	!this.revtext.val    = !this.TagValue(!equinav, 'rev')
	!this.title1text.val = !this.TagValue(!equinav, 'title1')
	!this.title2text.val = !this.TagValue(!equinav, 'title2')
	!this.title3text.val = !this.TagValue(!equinav, 'title3')
endmethod

---------------------------------------------------------------------
-- builds one candidate name from a sequence number: the number,   --
-- left padded with zeros to !digits wide (0 or blank = no          --
-- padding), with !prefix in front. !seq is only ever a plain count --
-- (from a form REAL gadget, not a length), but .string() is        --
-- stripped of 'mm' anyway for the same reason .PosOf() does it -   --
-- cheap, and there is no case where it should ever matter here     --
---------------------------------------------------------------------
define method .BatchName(!prefix is STRING, !seq is REAL, !digits is REAL) is STRING
	!num = !seq.string().replace('mm', '')
	if (!digits.gt(0)) then
		!need = !digits - !num.length()
		do !pad from 1 to !need
			!num = '0' & !num
		enddo
	endif
	return !prefix & !num
endmethod

---------------------------------------------------------------------
-- Info tab - Batch Number. numbers a multi-selection of boxes in   --
-- one go with Prefix + a running sequence, ordered by Order By     --
-- rather than by selection/click order - PML has no way to read    --
-- back the order the user clicked things in, only which things are --
-- selected, so the sequence has to come from somewhere else         --
--                                                                  --
-- gathering the selection is the same scan .MergeBoxes() uses      --
-- (SELECTION() -> BOX or step down from EQUI -> must be under      --
-- <projid>_DrawingPlanBox, anything else silently skipped), with   --
-- one addition: Skip already-named leaves boxes that already have  --
-- a real Drawing No. untouched, so a batch run cannot accidentally --
-- renumber something that was already named on purpose. unticked,  --
-- every box in the selection is renumbered regardless               --
--                                                                  --
-- the sequence never overwrites an existing name - a collision     --
-- just moves on to the next number, so the same prefix can be run  --
-- again later to pick up where it left off, or two prefixes can    --
-- share the site without stepping on each other                    --
---------------------------------------------------------------------
define method .AssignNumbers()
	!prefix = !this.batchprefix.val
	if (!prefix.eq('')) then
		!!alert.error('Type a prefix first')
		return
	endif

	------------------------------------------------------------------
	-- Start at doubles as the padding width: '001' both starts the --
	-- count at 1 and, by being 3 characters, sets 3 digit padding.  --
	-- typing '1' starts at 1 with no padding                        --
	------------------------------------------------------------------
	!startstr = !this.batchstart.val
	if (!startstr.eq('')) then
		!startstr = '1'
	endif
	!start = !startstr.real()
	!digits = !startstr.length()

	!dir1 = !this.batchdir.selection()
	!axis1 = 'U'
	!ascend1 = true
	if (!dir1.eq('Bottom -> Top (U)')) then
		!axis1 = 'U'
		!ascend1 = true
	elseif (!dir1.eq('Top -> Bottom (U)')) then
		!axis1 = 'U'
		!ascend1 = false
	elseif (!dir1.eq('West -> East (E)')) then
		!axis1 = 'E'
		!ascend1 = true
	elseif (!dir1.eq('East -> West (E)')) then
		!axis1 = 'E'
		!ascend1 = false
	elseif (!dir1.eq('South -> North (N)')) then
		!axis1 = 'N'
		!ascend1 = true
	else
		!axis1 = 'N'
		!ascend1 = false
	endif

	!dir2 = !this.batchdir2.selection()
	!use2 = true
	!axis2 = 'E'
	!ascend2 = true
	if (!dir2.eq('(none)')) then
		!use2 = false
	elseif (!dir2.eq('Bottom -> Top (U)')) then
		!axis2 = 'U'
		!ascend2 = true
	elseif (!dir2.eq('Top -> Bottom (U)')) then
		!axis2 = 'U'
		!ascend2 = false
	elseif (!dir2.eq('West -> East (E)')) then
		!axis2 = 'E'
		!ascend2 = true
	elseif (!dir2.eq('East -> West (E)')) then
		!axis2 = 'E'
		!ascend2 = false
	elseif (!dir2.eq('South -> North (N)')) then
		!axis2 = 'N'
		!ascend2 = true
	else
		!axis2 = 'N'
		!ascend2 = false
	endif

	var !projid proj id
	!sitename = '/' & !projid & '_DrawingPlanBox'

	!sele = object selection()
	!sele.getcurrent()
	!sels = !sele.getselection()

	!names = ARRAY()
	!keys1 = ARRAY()
	!keys2 = ARRAY()

	do !sel values !sels
		!ok = true
		$!sel
		handle any
			!ok = false
		endhandle

		if (!ok) then
			var !cetype type of ce
			if (!cetype.eqnocase('EQUI')) then
				!err = !this.BoxUnderEqui()
				if (!err.neq('')) then
					!ok = false
				endif
			elseif (not(!cetype.eqnocase('BOX'))) then
				!ok = false
			endif
		endif

		if (!ok) then
			var !site name of site of ce
			if (not(!site.eq(!sitename))) then
				!ok = false
			endif
		endif

		if (!ok) then
			var !equi namn of equi of ce
			!include = true
			if (!this.batchskip.val) then
				if (not(!equi.substring(1,1).eq('='))) then
					!include = false
				endif
			endif
			if (!include) then
				if !names.find(!equi).size().eq(0) then
					var !boxpos worpos
					!pos = !boxpos.position()
					!key1 = !pos.up
					if (!axis1.eq('E')) then
						!key1 = !pos.east
					elseif (!axis1.eq('N')) then
						!key1 = !pos.north
					endif
					!key2 = !pos.up
					if (!axis2.eq('E')) then
						!key2 = !pos.east
					elseif (!axis2.eq('N')) then
						!key2 = !pos.north
					endif
					!names.append(!equi)
					!keys1.append(!key1)
					!keys2.append(!key2)
				endif
			endif
		endif
	enddo

	if (!names.size().lt(1)) then
		!!alert.error('Nothing eligible in the current selection - check the model selection and Skip already-named')
		return
	endif

	------------------------------------------------------------------
	-- selection sort on the parallel !keys1/!keys2 arrays. these    --
	-- lists are at most a few dozen boxes at a time, so the O(n^2)  --
	-- cost does not matter and this avoids needing a sort-by-key    --
	-- builtin, which nothing else in this codebase uses.            --
	--                                                                --
	-- 2nd only breaks ties on 1st, and "tie" allows a small          --
	-- tolerance rather than exact equality - boxes on what is        --
	-- obviously the same storey can differ by floating point noise  --
	-- even though they came from the same split                      --
	------------------------------------------------------------------
	!tol = 1
	!n = !names.size()
	do !i from 1 to !n
		!best = !i
		!jstart = !i + 1
		do !j from !jstart to !n
			!d1 = !keys1[!j] - !keys1[!best]
			if (not(!ascend1)) then
				!d1 = 0 - !d1
			endif
			!swap = false
			if (!d1.lt(0 - !tol)) then
				!swap = true
			elseif (!d1.lt(!tol) and !use2) then
				!d2 = !keys2[!j] - !keys2[!best]
				if (not(!ascend2)) then
					!d2 = 0 - !d2
				endif
				if (!d2.lt(0)) then
					!swap = true
				endif
			endif
			if (!swap) then
				!best = !j
			endif
		enddo
		if (!best.neq(!i)) then
			!tmpname = !names[!i]
			!names[!i] = !names[!best]
			!names[!best] = !tmpname
			!tmpkey = !keys1[!i]
			!keys1[!i] = !keys1[!best]
			!keys1[!best] = !tmpkey
			!tmpkey = !keys2[!i]
			!keys2[!i] = !keys2[!best]
			!keys2[!best] = !tmpkey
		endif
	enddo

	!seq = !start
	!assigned = 0
	!failed = ARRAY()

	do !nm values !names
		!avail = false
		!fullname = ''
		do !try from 1 to 10000
			!candidate = !this.BatchName(!prefix, !seq, !digits)
			!fullname = '/' & !candidate
			!taken = false
			$!fullname
			handle any
				!taken = false
			elsehandle none
				!taken = true
			endhandle
			if (!taken) then
				!seq = !seq + 1
			else
				!avail = true
				break
			endif
		enddo

		if (not(!avail)) then
			!failed.append(!nm)
		else
			!equinav = !this.NavName(!nm)
			!ok = true
			$!equinav
			handle any
				!ok = false
			endhandle
			if (!ok) then
				NAME $!fullname
				handle any
					!ok = false
				endhandle
			endif
			if (!ok) then
				!assigned = !assigned + 1
				!seq = !seq + 1
			else
				!failed.append(!nm)
			endif
		endif
	enddo

	!this.batchresult.val = !assigned.string() & ' box(es) numbered'
	if (!failed.size().gt(0)) then
		!!alert.error(!failed.size().string() & ' box(es) could not be named - check the model for what changed underneath')
	endif
endmethod

---------------------------------------------------------------------
-- navigate to <projid>_DrawingPlanBox, creating the site and a     --
-- zone under it when they are not there yet. this replaces the     --
-- hard coded db address the form used to jump to, which dropped    --
-- the boxes wherever that address happened to point on the day     --
---------------------------------------------------------------------
define method .GotoBoxSite() is STRING
	var !projid proj id
	!sitename = '/' & !projid & '_DrawingPlanBox'

	!found = true
	$!sitename
	handle any
		!found = false
	endhandle

	if (not(!found)) then
		!ok = true
		WORLD
		handle any
			!ok = false
		endhandle
		if (not(!ok)) then
			return 'cannot get to WORLD to create ' & !sitename
		endif

		!ok = true
		new site $!sitename
		handle any
			!ok = false
		endhandle
		if (not(!ok)) then
			return 'cannot create site ' & !sitename & ' - check that a writable design DB is in your MDB'
		endif

		------------------------------------------------------------------
		-- a new SITE lands in whatever DB happens to be current, which --
		-- is exactly the thing the old hard coded db address got wrong, --
		-- so say so. the DB name is only nice to have - it cannot be    --
		-- asked for from the level of a SITE in every setup, so a       --
		-- failure here just drops that half of the message              --
		------------------------------------------------------------------
		!dbname = ''
		var !dbname dbname of ce
		handle any
			!dbname = ''
		endhandle
		if (!dbname.eq('')) then
			!!alert.message('Created site ' & !sitename & ' - please check it landed in the DB you want')
		else
			!!alert.message('Created site ' & !sitename & ' in DB ' & !dbname)
		endif
	endif

	var !type type of ce
	if (not(!type.eqnocase('SITE'))) then
		return !sitename & ' exists but is not a SITE'
	endif

	--------------------------------------------------------------
	-- an EQUI cannot hang straight off a SITE, there has to be  --
	-- a ZONE in between                                         --
	--------------------------------------------------------------
	!zonename = !sitename & '_Z1'
	var !zones coll all zone for ce
	!nozone = true
	if (not(!zones.unset())) then
		if (!zones.size().gt(0)) then
			!nozone = false
		endif
	endif

	if (!nozone) then
		!ok = true
		new zone $!zonename
		handle any
			!ok = false
		endhandle
		if (not(!ok)) then
			return 'cannot create a ZONE under ' & !sitename
		endif
	else
		!ok = true
		!zone = !zones[1]
		$!zone
		handle any
			!ok = false
		endhandle
		if (not(!ok)) then
			return 'cannot get to the ZONE under ' & !sitename
		endif
	endif

	return ''
endmethod

---------------------------------------------------------------------
-- Pick tab - four points from the 3D view off one button press.    --
--                                                                  --
-- the four picks are four EDGPACKETs in a chain, each one hooked   --
-- up by the action of the one before it.                           --
--                                                                  --
-- two things had to be got right here:                             --
--                                                                  --
-- putting four definePosition() calls on a single packet does NOT  --
-- give four prompts in a row - they overwrite each other, the      --
-- packet still collects one position, and the action fires with    --
-- only !this.return[1] filled in                                   --
--                                                                  --
-- and adding the next packet while the previous one is still       --
-- registered makes E3D put up 'OK to replace currently active      --
-- major application/utility "Basic Position"?' and the chain dies  --
-- there. so every packet carries the same description and is taken --
-- out by that description before the next one goes in. remove is   --
-- left FALSE so the framework never also removes one behind our    --
-- back - if it did that after the action returned it would take    --
-- out the packet we had just added and the chain would stop with   --
-- no message at all                                                --
---------------------------------------------------------------------
define method .PickPoints()
	AID CLEAR ALL
	!this.ClearPointFields()
	!this.PickOne(1)
endmethod

define method .PickOne(!idx is REAL)
	!prompt = 'P1 - one end of an edge of the frame'
	if (!idx eq 2) then
		!prompt = 'P2 - the other end of that edge'
	elseif (!idx eq 3) then
		!prompt = 'P3 - off to the far side'
	elseif (!idx eq 4) then
		!prompt = 'P4 - the second level'
	endif

	!this.DropPicking()

	!packet = object EDGPACKET()
	!packet.definePosition(!prompt)
	!packet.description = !this.edgdesc
	!packet.action = |!!DrawingPlan.PickDone(!this.return[1].position, $!idx)|
	!packet.remove = false
	if (!!edgCntrl.add(!packet)) then
	endif
endmethod

------------------------------------------------------------------
-- takes our own packet back out of the event system. safe to    --
-- call when there is nothing registered                         --
------------------------------------------------------------------
define method .DropPicking()
	!!edgCntrl.remove(!this.edgdesc)
	handle any
	endhandle
endmethod

define method .PickDone(!pos is POSITION, !idx is REAL)
	!!DrawingPlan.SetPoint(!idx, !pos)
	!!DrawingPlan.RefreshMarks()
	if (!idx lt 4) then
		!next = !idx + 1
		!!DrawingPlan.PickOne(!next)
	else
		!!DrawingPlan.DropPicking()
		!!DrawingPlan.CreateBox()
	endif
endmethod

define method .SetPoint(!idx is REAL, !pos is POSITION)
	!posw = !pos.wrt(WORL)
	!estr = !posw.east.string('D4')
	!nstr = !posw.north.string('D4')
	!ustr = !posw.up.string('D4')
	if (!idx eq 1) then
		!this.p1e.val = !estr
		!this.p1n.val = !nstr
		!this.p1u.val = !ustr
	elseif (!idx eq 2) then
		!this.p2e.val = !estr
		!this.p2n.val = !nstr
		!this.p2u.val = !ustr
	elseif (!idx eq 3) then
		!this.p3e.val = !estr
		!this.p3n.val = !nstr
		!this.p3u.val = !ustr
	else
		!this.p4e.val = !estr
		!this.p4n.val = !nstr
		!this.p4u.val = !ustr
	endif
endmethod

define method .RefreshMarks()
	AID CLEAR ALL
	!this.MarkOne(!this.p1e.val, !this.p1n.val, !this.p1u.val, 'P1')
	!this.MarkOne(!this.p2e.val, !this.p2n.val, !this.p2u.val, 'P2')
	!this.MarkOne(!this.p3e.val, !this.p3n.val, !this.p3u.val, 'P3')
	!this.MarkOne(!this.p4e.val, !this.p4n.val, !this.p4u.val, 'P4')
endmethod

define method .MarkOne(!estr is STRING, !nstr is STRING, !ustr is STRING, !tag is STRING)
	if (!estr.eq('') or !nstr.eq('')) then
		return
	endif
	!e = !this.NumOf(!estr)
	!n = !this.NumOf(!nstr)
	!u = 0
	if (!ustr.neq('')) then
		!u = !this.NumOf(!ustr)
	endif
	------------------------------------------------------------------
	-- the coordinates are written out one by one rather than as a   --
	-- POSITION. a POSITION expands with a 'WRT /*' tail on the end, --
	-- which AID will not take                                       --
	------------------------------------------------------------------
	AID TEXT |$!tag| AT E $!e N $!n U $!u
	AID SPHERE E $!e N $!n U $!u DIA 300
endmethod

---------------------------------------------------------------------
-- REAL.string() brings the unit out with it ('-245010.0000mm') and --
-- STRING.real() cannot parse that back, so the unit has to come    --
-- off first. same thing DrawingPlan1.Apply() does to WVOL          --
---------------------------------------------------------------------
define method .NumOf(!str is STRING) is REAL
	return !str.replace('mm', '').trim().real()
endmethod

---------------------------------------------------------------------
-- a POSITION made with object POSITION() and then filled in field  --
-- by field carries no coordinate system, and .distance() and       --
-- .direction() on it fail with 'Error in conversion to world       --
-- co-ordinates. Check for unset objects'. building it from a       --
-- string ending in WRT /* gives it one.                            --
-- the compass letter is flipped instead of writing a negative      --
-- number, so the string is always one PDMS will take               --
---------------------------------------------------------------------
define method .PosOf(!e is REAL, !n is REAL, !u is REAL) is POSITION
	------------------------------------------------------------------
	-- PML will not take a method call on a bracketed expression -    --
	-- (0 - !e).string() is a syntax error - so the flipped sign     --
	-- goes into a variable of its own first.                        --
	-- .string() on a value that came out of a POSITION or a REAL    --
	-- gadget carries the unit with it, so it is taken off again     --
	-- here and the number left to be read in project units          --
	------------------------------------------------------------------
	!ev = !e
	!eword = 'E '
	if (!e lt 0) then
		!ev = 0 - !e
		!eword = 'W '
	endif
	!nv = !n
	!nword = ' N '
	if (!n lt 0) then
		!nv = 0 - !n
		!nword = ' S '
	endif
	!uv = !u
	!uword = ' U '
	if (!u lt 0) then
		!uv = 0 - !u
		!uword = ' D '
	endif

	!str = !eword & !ev.string().replace('mm', '')
	!str = !str & !nword & !nv.string().replace('mm', '')
	!str = !str & !uword & !uv.string().replace('mm', '')
	return object POSITION(!str & ' WRT /*')
endmethod

---------------------------------------------------------------------
-- the reverse of .PosOf() - E/N/U of a POSITION as one string,     --
-- for AID commands that take coordinates directly (E .. N .. U ..) --
-- rather than through AT/DIRECTION. this is the pattern .MarkOne() --
-- already uses and has been tested in the field; a raw POSITION    --
-- handed to AID as $!pos carries a 'WRT /*' tail that AID will     --
-- not take, the same trap noted on .MakeBoxAt()'s POS line          --
---------------------------------------------------------------------
define method .EnuOf(!pos is POSITION) is STRING
	!estr = !pos.east.string().replace('mm', '')
	!nstr = !pos.north.string().replace('mm', '')
	!ustr = !pos.up.string().replace('mm', '')
	return 'E ' & !estr & ' N ' & !nstr & ' U ' & !ustr
endmethod

define method .ClearPoints()
	!this.ClearPointFields()
endmethod

------------------------------------------------------------------
-- blanks the Info tab. only called once, from .DrawingPlan() at  --
-- form start up - there is no Clear button any more. Read CE      --
-- already does a better job of resetting the tab for any box       --
-- that is actually selected, this is only for the state before     --
-- the user has picked or navigated to anything at all               --
------------------------------------------------------------------
define method .ClearInfo()
	!this.dwgno.val = ''
	!this.revtext.val = ''
	!this.title1text.val = ''
	!this.title2text.val = ''
	!this.title3text.val = ''
endmethod

------------------------------------------------------------------
-- the coordinates on their own. a fresh round of picking wipes   --
-- the old points but must not throw away a drawing number the    --
-- user has already typed in                                      --
------------------------------------------------------------------
define method .ClearPointFields()
	AID CLEAR ALL
	!this.p1e.val = ''
	!this.p1n.val = ''
	!this.p1u.val = ''
	!this.p2e.val = ''
	!this.p2n.val = ''
	!this.p2u.val = ''
	!this.p3e.val = ''
	!this.p3n.val = ''
	!this.p3u.val = ''
	!this.p4e.val = ''
	!this.p4n.val = ''
	!this.p4u.val = ''
endmethod

define method .CreateBox()
	if (!this.p1e.val.eq('') or !this.p1n.val.eq('') or !this.p2e.val.eq('') or !this.p2n.val.eq('') or !this.p3e.val.eq('') or !this.p3n.val.eq('')) then
		!!alert.error('P1, P2 and P3 are all needed')
		return
	endif
	------------------------------------------------------------------
	-- the two levels of the box come from the picks, not from the   --
	-- form - P1 carries the first one and P4 the second. only P4's  --
	-- U is used, its E and N are ignored                            --
	------------------------------------------------------------------
	if (!this.p1u.val.eq('') or !this.p4u.val.eq('')) then
		!!alert.error('the U of P1 and the U of P4 are the two levels of the box, both are needed')
		return
	endif

	!p1 = !this.PosOf(!this.NumOf(!this.p1e.val), !this.NumOf(!this.p1n.val), 0)
	!p2 = !this.PosOf(!this.NumOf(!this.p2e.val), !this.NumOf(!this.p2n.val), 0)
	!p3 = !this.PosOf(!this.NumOf(!this.p3e.val), !this.NumOf(!this.p3n.val), 0)
	!ubot = !this.NumOf(!this.p1u.val)
	!utop = !this.NumOf(!this.p4u.val)

	------------------------------------------------------------------
	-- Pick only ever makes a blank box - no name, no rev, no        --
	-- titles. naming and labelling is entirely the Info tab's job,  --
	-- done afterwards with Read CE / Apply once the box exists.     --
	-- keeping the two apart means a box in progress on the Info     --
	-- tab (read in, half edited, not yet Applied) can never leak    --
	-- into a new box picked in the meantime                         --
	------------------------------------------------------------------
	!err = !this.MakeBox(!p1, !p2, !p3, !ubot, !utop, '', '', '', '', '')
	if (!err.neq('')) then
		!!alert.error(!err)
		return
	endif

	------------------------------------------------------------------
	-- no dialog on success - picking is meant to run one frame      --
	-- after another without anything to click away                 --
	------------------------------------------------------------------
	AID CLEAR ALL
endmethod

---------------------------------------------------------------------
-- deletes the whole EQUI the current element sits in, but only     --
-- inside the DrawingPlanBox site, so a CE left somewhere else by   --
-- mistake cannot take a piece of the real model with it            --
---------------------------------------------------------------------
define method .DeleteBox()
	!equi = !this.CurrentBoxEqui()
	if (!equi.eq('')) then
		return
	endif

	!equinav = !this.NavName(!equi)
	$!equinav
	var !owner namn of owner of ce
	!ownernav = !this.NavName(!owner)

	!ok = true
	delete equi
	handle any
		!ok = false
	endhandle
	if (not(!ok)) then
		!!alert.error('Cannot delete ' & !equi)
		return
	endif

	$!ownernav
	AID CLEAR ALL
endmethod

--------------------------------------------------------------------
-- Grid tab - the frame edges are grid lines picked in the 3D view --
-- in two rounds: plan lines, then level lines. the round decides   --
-- what a pick means, not the line itself: in an E3D grid the same  --
-- edge is drawn twice, once as a child of the elevation plane and  --
-- once as a child of the column plane, and which one the cursor    --
-- lands on is chance. a first cut that read the plane off the      --
-- element took two lines along the top of the grid for levels      --
-- (user, 2026-09-15). the boxes go through .MakeBox() like every   --
-- other tab's, so they land in the same site, unnamed, and are     --
-- numbered and labelled on the Info tab afterwards                 --
--------------------------------------------------------------------

------------------------------------------------------------------
-- back to nothing picked. the offsets are left alone - they are --
-- a project convention, not part of any one batch              --
------------------------------------------------------------------
define method .GridClear()
	!this.DropPicking()
	!this.gridphase = ''
	!this.planrefs = object ARRAY()
	!this.planlbls = object ARRAY()
	!this.plane1 = object ARRAY()
	!this.plann1 = object ARRAY()
	!this.plane2 = object ARRAY()
	!this.plann2 = object ARRAY()
	!this.planu = object ARRAY()
	!this.levrefs = object ARRAY()
	!this.levlbls = object ARRAY()
	!this.levus = object ARRAY()
	!this.glines.clear()
	!this.gubot.val = ''
	!this.gutop.val = ''
	!this.gstatus.val = ''
	!this.gresult.val = ''
	AID CLEAR ALL
endmethod

---------------------------------------------------------------------
-- picking. the same one-packet-at-a-time chain as the Pick tab's   --
-- .PickPoints(), and for the same reason (see the comment there):  --
-- every packet carries the same description and is taken out by   --
-- it before the next one goes in. the description is the one the  --
-- Pick tab uses too, so starting a round here drops a four-point  --
-- pick left half done and the other way round.                    --
-- the one difference is the pick packet itself: an element pick    --
-- rather than a position pick. a position pick answers a          --
-- position and, in some snap modes, nothing else - the grid line  --
-- it was on is gone. an element pick answers the element          --
-- (EDGPICKDATA.item), which is all that is wanted here             --
---------------------------------------------------------------------

------------------------------------------------------------------
-- first round. the plan lines already picked carry on - Clear   --
-- is the way to start over                                      --
------------------------------------------------------------------
define method .GridPickPlan()
	!this.gridphase = 'plan'
	!this.gstatus.val = 'pick the plan lines. Esc when they are all in'
	!this.GridPickNext()
endmethod

------------------------------------------------------------------
-- second round. a fresh set of levels every time - a half-done  --
-- set from an earlier round is worth less than the confusion   --
-- of adding to it                                               --
------------------------------------------------------------------
define method .GridPickLevels()
	!this.levrefs = object ARRAY()
	!this.levlbls = object ARRAY()
	!this.levus = object ARRAY()
	!this.GridRefreshList()
	!this.gridphase = 'level'
	!this.gstatus.val = !this.planrefs.size().string() & ' plan lines. now the level lines, in any order. Esc when they are all in'
	!this.GridPickNext()
endmethod

define method .GridPickNext()
	if (!this.gridphase.eq('plan')) then
		!next = !this.planrefs.size() + 1
		!prompt = 'Plan grid line ' & !next.string() & ' (Esc when they are all in)'
	else
		!next = !this.levus.size() + 1
		!prompt = 'Level line ' & !next.string() & ' (Esc when they are all in)'
	endif

	!this.DropPicking()

	!packet = object EDGPACKET()
	!packet.definePosition(!prompt)
	!packet.pickPacket.stdElement(!prompt)
	!packet.type = ''
	!packet.description = !this.edgdesc
	!packet.action = |!!DrawingPlan.GridPicked(!this.return[1])|
	!packet.escape = |!!DrawingPlan.GridPickEscaped()|
	!packet.remove = false
	if (!!edgCntrl.add(!packet)) then
	endif
endmethod

define method .GridStop()
	!this.DropPicking()
	!this.gridphase = ''
	!this.gstatus.val = 'picking stopped - ' & !this.planrefs.size().string() & ' plan lines kept. Pick Plan Lines carries on, Clear starts over'
endmethod

------------------------------------------------------------------
-- Bottom U / Top U off a point in the 3D view. a position pick  --
-- like the Pick tab's, one packet, and only the U of the answer --
-- is kept. it ends any grid line round in progress - one pick   --
-- at a time is all the packet chain allows. !which is 'bot' or  --
-- 'top'                                                         --
------------------------------------------------------------------
define method .GridPickLevel(!which is STRING)
	!this.DropPicking()
	!this.gridphase = ''
	!prompt = 'Bottom U - any point on the lower level'
	if (!which.eq('top')) then
		!prompt = 'Top U - any point on the upper level'
	endif
	!this.gstatus.val = 'pick a point for ' & !which & ' U'

	!packet = object EDGPACKET()
	!packet.definePosition(!prompt)
	!packet.description = !this.edgdesc
	!packet.action = |!!DrawingPlan.GridLevelPicked(!this.return[1].position, '$!which')|
	!packet.remove = false
	if (!!edgCntrl.add(!packet)) then
	endif
endmethod

------------------------------------------------------------------
-- the point is in. its U goes into the field, and a mark at the --
-- point itself shows which level was taken. the mark is added   --
-- to the grid line aids, not put in their place.                --
-- the coordinates are read off !pos BEFORE the packet is        --
-- dropped: PML passes arguments by reference, so !pos is the    --
-- packet's own return[1].position, and edgCntrl.remove() ->     --
-- retrieve() replaces the whole EDGSTATE, after which !pos is   --
-- 'non-existent' and .wrt() aborts with (2,750) (user,           --
-- 2026-09-20). .SetPoint() reads first and drops later too, and --
-- .SplitPointPicked() copies into a member first - same rule    --
------------------------------------------------------------------
define method .GridLevelPicked(!pos is POSITION, !which is STRING)
	!posw = !pos.wrt(WORL)
	!estr = !posw.east.string('D1').replace('mm', '')
	!nstr = !posw.north.string('D1').replace('mm', '')
	!ustr = !posw.up.string('D1').replace('mm', '')
	!!DrawingPlan.DropPicking()

	!tag = 'TOP U'
	if (!which.eq('bot')) then
		!!DrawingPlan.gubot.val = !ustr
		!tag = 'BOT U'
	else
		!!DrawingPlan.gutop.val = !ustr
	endif
	!!DrawingPlan.MarkOne(!estr, !nstr, !ustr, !tag)
	!!DrawingPlan.gstatus.val = !which & ' U = ' & !ustr
endmethod

------------------------------------------------------------------
-- Esc in the 3D view: the lines of this round are all in. it    --
-- only ends the round - it used to start the level round after  --
-- the plan one and make the boxes after the level one, but the  --
-- levels are as often typed or picked as points, and the boxes  --
-- should not appear before the user has looked at the list and  --
-- pressed Create Boxes (user, 2026-09-19). the framework has     --
-- already taken the packet out by the time this runs            --
------------------------------------------------------------------
define method .GridPickEscaped()
	if (!this.gridphase.eq('plan')) then
		!this.gstatus.val = !this.planrefs.size().string() & ' plan lines in. now the levels - Pick Level Lines and/or Top U / Bottom U - then Create Boxes'
	elseif (!this.gridphase.eq('level')) then
		!this.gstatus.val = !this.levus.size().string() & ' level lines in. Create Boxes when ready'
	else
		!this.gstatus.val = 'picking stopped'
	endif
	!this.gridphase = ''
endmethod

------------------------------------------------------------------
-- something that is not usable was picked. say why and ask for --
-- the next one                                                  --
------------------------------------------------------------------
define method .GridReject(!why is STRING)
	!this.gstatus.val = !why
	!this.GridPickNext()
endmethod

---------------------------------------------------------------------
-- one pick in. !data is the EDGPICKDATA of an element pick; its   --
-- .item is the element under the cursor. a grid line is a REFGLN  --
-- and its P1/P2 are the ends of the line, the same pair            --
-- DrawingPlan1GridAnnotation reads. the round says what to do     --
-- with it                                                          --
---------------------------------------------------------------------
define method .GridPicked(!data is ANY)
	!item = !data.item
	handle any
		!this.GridReject('nothing was picked - skipped')
		return
	endhandle
	if (not(!item.set())) then
		!this.GridReject('nothing was picked - skipped')
		return
	endif

	!type = '?'
	!type = !item.type
	handle any
	endhandle
	if (!type.neq('REFGLN')) then
		!this.GridReject('that is a ' & !type & ', not a grid line - skipped')
		return
	endif
	!refstr = !item.string()

	var !p1str p1 pos of $!refstr wrt worl
	handle any
		!this.GridReject('cannot read the ends of ' & !refstr & ' - skipped')
		return
	endhandle
	var !p2str p2 pos of $!refstr wrt worl
	handle any
		!this.GridReject('cannot read the ends of ' & !refstr & ' - skipped')
		return
	endhandle
	!p1 = object POSITION(!p1str)
	!p2 = object POSITION(!p2str)

	if (!this.gridphase.eq('plan')) then
		!this.PlanLinePicked(!item, !refstr, !p1, !p2)
	else
		!this.LevelLinePicked(!item, !refstr, !p1, !p2)
	endif
endmethod

---------------------------------------------------------------------
-- the number the line's bubble prints. a REFGLN is the trace of   --
-- one grid plane (its GRDREF) on another (its owner), and the     --
-- IDPLANE of a plane is what the bubble prints                    --
-- (DrawingPlan1GridAnnotation, 2026-09-07). which of the two      --
-- planes is wanted depends on the round: the column plane for a   --
-- plan line, the elevation plane for a level - and which of owner --
-- and GRDREF that is depends on which one the cursor happened to  --
-- land on. the horizontal one of the two is the elevation plane.  --
-- this is only for the list, so anything unreadable falls back   --
-- to the refno                                                    --
---------------------------------------------------------------------
define method .LabelOf(!item is DBREF, !refstr is STRING, !wantlevel is BOOLEAN) is STRING
	!ownerhoriz = !this.OwnerIsHorizontal(!item)
	!plref = ''
	!plref = !item.owner.string()
	handle any
		!plref = ''
	endhandle

	!useowner = false
	if (!ownerhoriz.eq('yes') and !wantlevel) then
		!useowner = true
	elseif (!ownerhoriz.eq('no') and not(!wantlevel)) then
		!useowner = true
	endif

	!lbl = ''
	if (!useowner and !plref.neq('')) then
		var !lbl idplane of $!plref
		handle any
			!lbl = ''
		endhandle
	else
		var !lbl idplane of grdref of $!refstr
		handle any
			!lbl = ''
		endhandle
	endif
	if (!lbl.trim().eq('')) then
		!lbl = !refstr
	endif
	return !lbl
endmethod

------------------------------------------------------------------
-- 'yes' when the plane the line is drawn on is horizontal, 'no' --
-- when it is not, '?' when it cannot be read. Z up or down is   --
-- horizontal                                                    --
------------------------------------------------------------------
define method .OwnerIsHorizontal(!item is DBREF) is STRING
	!plref = !item.owner.string()
	handle any
		return '?'
	endhandle
	var !oristr ori of $!plref wrt worl
	handle any
		return '?'
	endhandle
	!zdir = !oristr.orientation().zdir()
	handle any
		return '?'
	endhandle
	!angu = !zdir.angle(object DIRECTION('U'))
	if (!angu lt 1 or !angu gt 179) then
		return 'yes'
	endif
	return 'no'
endmethod

------------------------------------------------------------------
-- first round. any grid line with a length in plan will do,     --
-- whichever plane it is drawn on - only its plan geometry is    --
-- used. a vertical line has no direction in plan and is skipped --
------------------------------------------------------------------
define method .PlanLinePicked(!item is DBREF, !refstr is STRING, !p1 is POSITION, !p2 is POSITION)
	!lbl = !this.LabelOf(!item, !refstr, false)
	do !i from 1 to !this.planrefs.size()
		if (!this.planrefs[!i].eq(!refstr)) then
			!this.GridReject('plan line ' & !lbl & ' is already picked - skipped')
			return
		endif
	enddo

	!dx = !p2.east - !p1.east
	!dy = !p2.north - !p1.north
	!len2 = !dx * !dx + !dy * !dy
	if (!len2 lt 1) then
		!this.GridReject(!lbl & ' is a vertical line - it has no direction in plan, skipped')
		return
	endif

	!this.planrefs.append(!refstr)
	!this.planlbls.append(!lbl)
	!this.plane1.append(!p1.east)
	!this.plann1.append(!p1.north)
	!this.plane2.append(!p2.east)
	!this.plann2.append(!p2.north)
	!this.planu.append(!p1.up)

	!this.MarkLine(!p1.east, !p1.north, !p2.east, !p2.north, !p1.up, !lbl)
	!this.GridRefreshList()
	!this.gstatus.val = 'plan line ' & !lbl & ' - ' & !this.planrefs.size().string() & ' so far. Esc when they are all in'
	!this.GridPickNext()
endmethod

------------------------------------------------------------------
-- second round. the level is the U of the line, so it has to be --
-- horizontal - a vertical one says nothing about height. the    --
-- same level twice (the same edge on two faces) is dropped when --
-- the storeys are worked out, not here                          --
------------------------------------------------------------------
define method .LevelLinePicked(!item is DBREF, !refstr is STRING, !p1 is POSITION, !p2 is POSITION)
	!lbl = !this.LabelOf(!item, !refstr, true)
	!du = !p2.up - !p1.up
	if (!du.abs() gt 1) then
		!this.GridReject(!lbl & ' is a vertical line - a level line runs horizontally, skipped')
		return
	endif
	do !i from 1 to !this.levrefs.size()
		if (!this.levrefs[!i].eq(!refstr)) then
			!this.GridReject('level ' & !lbl & ' is already picked - skipped')
			return
		endif
	enddo

	!this.levrefs.append(!refstr)
	!this.levlbls.append(!lbl)
	!this.levus.append(!p1.up)
	!this.MarkLine(!p1.east, !p1.north, !p2.east, !p2.north, !p1.up, 'EL ' & !lbl)
	!this.GridRefreshList()
	!this.gstatus.val = 'level ' & !lbl & ' - ' & !this.levus.size().string() & ' so far. Esc when they are all in'
	!this.GridPickNext()
endmethod

---------------------------------------------------------------------
-- the boxes. the plan lines are sorted into two directions, each  --
-- direction is ordered across itself, and every neighbouring pair --
-- in one crossed with every neighbouring pair in the other is one --
-- bay. the three corners MakeBox wants are the crossings of the   --
-- two pairs: P1 and P2 along the first line of the pair in A, P3  --
-- on the next line of A. the levels are sorted the same way and   --
-- every neighbouring pair is one storey; every bay is made once   --
-- per storey                                                      --
---------------------------------------------------------------------
define method .GridCreateBoxes()
	!this.gresult.val = ''
	!this.DropPicking()
	!this.gridphase = ''
	!n = !this.planrefs.size()
	if (!n lt 4) then
		!!alert.error('at least four plan lines are needed - two in each direction')
		return
	endif

	------------------------------------------------------------------
	-- the storeys: every level there is - the picked level lines   --
	-- and Top U / Bottom U - in one sorted set, neighbour to       --
	-- neighbour                                                     --
	------------------------------------------------------------------
	!levels = !this.SortedLevels()
	if (!levels.size() lt 2) then
		!!alert.error('at least two levels are needed - level lines, Top U / Bottom U, or both')
		return
	endif
	!boff = !this.OffOf(!this.guboto.val)
	!toff = !this.OffOf(!this.gutopo.val)

	------------------------------------------------------------------
	-- unit direction of every line in plan, with the sign settled  --
	-- so that a line and the same line the other way round compare --
	-- equal                                                        --
	------------------------------------------------------------------
	!dxs = object ARRAY()
	!dys = object ARRAY()
	do !i from 1 to !n
		!dx = !this.plane2[!i] - !this.plane1[!i]
		!dy = !this.plann2[!i] - !this.plann1[!i]
		!len2 = !dx * !dx + !dy * !dy
		!len = !len2.sqrt()
		!dx = !dx / !len
		!dy = !dy / !len
		if (!dy lt 0 or (!dy eq 0 and !dx lt 0)) then
			!dx = 0 - !dx
			!dy = 0 - !dy
		endif
		!dxs.append(!dx)
		!dys.append(!dy)
	enddo

	------------------------------------------------------------------
	-- two groups: A is whatever the first line runs along, B the   --
	-- first direction that is not A. parallel means the cross      --
	-- product of the unit directions is under sin(0.5 degrees)    --
	------------------------------------------------------------------
	!ax = !dxs[1]
	!ay = !dys[1]
	!bx = 0
	!by = 0
	!bset = false
	!grp = object ARRAY()
	do !i from 1 to !n
		!cr = !ax * !dys[!i] - !ay * !dxs[!i]
		if (!cr.abs() lt 0.0087) then
			!grp.append('A')
		elseif (not(!bset)) then
			!bx = !dxs[!i]
			!by = !dys[!i]
			!bset = true
			!grp.append('B')
		else
			!crb = !bx * !dys[!i] - !by * !dxs[!i]
			if (!crb.abs() lt 0.0087) then
				!grp.append('B')
			else
				!!alert.error('the plan lines run in three directions - a box has only two')
				return
			endif
		endif
	enddo
	if (not(!bset)) then
		!!alert.error('all the plan lines are parallel - lines across them are needed too')
		return
	endif

	!ia = !this.SortedGroup(!grp, 'A', !ax, !ay)
	!ib = !this.SortedGroup(!grp, 'B', !bx, !by)
	if (!ia.size() lt 2 or !ib.size() lt 2) then
		!!alert.error('two different lines are needed in each direction')
		return
	endif

	!made = 0
	!firsterr = ''
	!na = !ia.size() - 1
	!nb = !ib.size() - 1
	!ns = !levels.size() - 1
	do !s from 1 to !ns
		!s2 = !s + 1
		!ubot = !levels[!s] + !boff
		!utop = !levels[!s2] + !toff
		!dz = !utop - !ubot
		if (!dz.abs() lt 1) then
			if (!firsterr.eq('')) then
				!firsterr = 'a storey comes out with no height once the offsets are on'
			endif
		else
			do !i from 1 to !na
				do !j from 1 to !nb
					!i2 = !i + 1
					!j2 = !j + 1
					!p1 = !this.Cross(!ia[!i], !ib[!j])
					!p2 = !this.Cross(!ia[!i], !ib[!j2])
					!p3 = !this.Cross(!ia[!i2], !ib[!j])
					!err = !this.MakeBox(!p1, !p2, !p3, !ubot, !utop, '', '', '', '', '')
					if (!err.eq('')) then
						!made = !made + 1
					elseif (!firsterr.eq('')) then
						!firsterr = !err
					endif
				enddo
			enddo
		endif
	enddo

	!this.gresult.val = !made.string() & ' box(es) made - ' & !na.string() & ' x ' & !nb.string() & ' bays, ' & !ns.string() & ' storey(s)'
	if (!firsterr.neq('')) then
		!!alert.error(!made.string() & ' box(es) made, the rest failed: ' & !firsterr)
	endif

	------------------------------------------------------------------
	-- done with these lines. the typed levels and the offsets stay --
	-- for the next batch, the picked lines and their aids go       --
	------------------------------------------------------------------
	if (!made gt 0) then
		!this.planrefs = object ARRAY()
		!this.planlbls = object ARRAY()
		!this.plane1 = object ARRAY()
		!this.plann1 = object ARRAY()
		!this.plane2 = object ARRAY()
		!this.plann2 = object ARRAY()
		!this.planu = object ARRAY()
		!this.levrefs = object ARRAY()
		!this.levlbls = object ARRAY()
		!this.levus = object ARRAY()
		!this.GridRefreshList()
		AID CLEAR ALL
	endif
endmethod

---------------------------------------------------------------------
-- every level from low to high: the picked level lines plus Top U --
-- and Bottom U when they are filled in, with the same level twice --
-- (the same edge picked on two faces, two grid systems, or a      --
-- typed U that lands on a line) kept once. anything under 1mm     --
-- apart is the same level                                         --
---------------------------------------------------------------------
define method .SortedLevels() is ARRAY
	!res = object ARRAY()
	!all = object ARRAY()
	do !i from 1 to !this.levus.size()
		!all.append(!this.levus[!i])
	enddo
	if (!this.gutop.val.trim().neq('')) then
		!all.append(!this.NumOf(!this.gutop.val))
	endif
	if (!this.gubot.val.trim().neq('')) then
		!all.append(!this.NumOf(!this.gubot.val))
	endif
	if (!all.size() eq 0) then
		return !res
	endif
	!order = !all.sortedIndices()
	!last = 0
	!first = true
	do !k from 1 to !order.size()
		!oi = !order[!k]
		!u = !all[!oi]
		!keep = true
		if (not(!first)) then
			!d = !u - !last
			if (!d.abs() lt 1) then
				!keep = false
			endif
		endif
		if (!keep) then
			!res.append(!u)
			!last = !u
			!first = false
		endif
	enddo
	return !res
endmethod

---------------------------------------------------------------------
-- the lines of one group in order across the group, as indices    --
-- into the plan arrays. 'across' is along the normal of the       --
-- group's direction, and a line under 1mm from the one before it  --
-- is the same grid line again (picked on another plane, or from   --
-- another grid system) and is dropped                             --
---------------------------------------------------------------------
define method .SortedGroup(!grp is ARRAY, !which is STRING, !dx is REAL, !dy is REAL) is ARRAY
	!idx = object ARRAY()
	!off = object ARRAY()
	do !i from 1 to !grp.size()
		if (!grp[!i].eq(!which)) then
			!o = !this.plann1[!i] * !dx - !this.plane1[!i] * !dy
			!idx.append(!i)
			!off.append(!o)
		endif
	enddo

	!order = !off.sortedIndices()
	!res = object ARRAY()
	!last = 0
	!first = true
	do !k from 1 to !order.size()
		!oi = !order[!k]
		!o = !off[!oi]
		!keep = true
		if (not(!first)) then
			!d = !o - !last
			if (!d.abs() lt 1) then
				!keep = false
			endif
		endif
		if (!keep) then
			!res.append(!idx[!oi])
			!last = !o
			!first = false
		endif
	enddo
	return !res
endmethod

---------------------------------------------------------------------
-- where plan line !i crosses plan line !j, as a position on level --
-- 0 in the shape MakeBox takes. the two are never parallel here   --
-- - they come from different groups                               --
---------------------------------------------------------------------
define method .Cross(!i is REAL, !j is REAL) is POSITION
	!px = !this.plane1[!i]
	!py = !this.plann1[!i]
	!dx = !this.plane2[!i] - !px
	!dy = !this.plann2[!i] - !py
	!qx = !this.plane1[!j]
	!qy = !this.plann1[!j]
	!ex = !this.plane2[!j] - !qx
	!ey = !this.plann2[!j] - !qy
	!cr = !dx * !ey - !dy * !ex
	!t = ((!qx - !px) * !ey - (!qy - !py) * !ex) / !cr
	!x = !px + !dx * !t
	!y = !py + !dy * !t
	return !this.PosOf(!x, !y, 0)
endmethod

------------------------------------------------------------------
-- an offset field: blank is 0, otherwise a number in mm         --
------------------------------------------------------------------
define method .OffOf(!str is STRING) is REAL
	if (!str.trim().eq('')) then
		return 0
	endif
	return !this.NumOf(!str)
endmethod

define method .GridRefreshList()
	!rows = object ARRAY()
	do !i from 1 to !this.planlbls.size()
		!rows.append('plan   ' & !this.planlbls[!i])
	enddo
	do !i from 1 to !this.levlbls.size()
		!rows.append('level  ' & !this.levlbls[!i] & '   U ' & !this.levus[!i].string('D1').replace('mm', ''))
	enddo
	if (!rows.size() eq 0) then
		!this.glines.clear()
	else
		!this.glines.dtext = !rows
	endif
endmethod

------------------------------------------------------------------
-- an aid along the picked line with its label at the middle.    --
-- coordinates go out one by one, not as a POSITION - a POSITION --
-- expands with a WRT tail that AID will not take (the same trap --
-- noted on .MarkOne()). the aids are only feedback, so a        --
-- failure here is swallowed                                     --
------------------------------------------------------------------
define method .MarkLine(!e1 is REAL, !n1 is REAL, !e2 is REAL, !n2 is REAL, !u is REAL, !lbl is STRING)
	!s1 = 'E ' & !e1.string().replace('mm', '') & ' N ' & !n1.string().replace('mm', '') & ' U ' & !u.string().replace('mm', '')
	!s2 = 'E ' & !e2.string().replace('mm', '') & ' N ' & !n2.string().replace('mm', '') & ' U ' & !u.string().replace('mm', '')
	AID LINE $!s1 TO $!s2
	handle any
	endhandle
	!em = (!e1 + !e2) * 0.5
	!nm = (!n1 + !n2) * 0.5
	!emstr = !em.string().replace('mm', '')
	!nmstr = !nm.string().replace('mm', '')
	!ustr = !u.string().replace('mm', '')
	AID TEXT |$!lbl| AT E $!emstr N $!nmstr U $!ustr
	handle any
	endhandle
endmethod


----------------------------------------------
-- Split tab - cut an existing box in two   --
-- (or more) along its own X/Y/Z            --
----------------------------------------------
---------------------------------------------------------------------
-- CE must already be on the EQUI. steps CE down onto the one BOX   --
-- under it - one BOX per EQUI is how this form always builds them  --
-- - and leaves it there. returns '' on success, an error message   --
-- otherwise, in which case CE has not moved. shared by             --
-- .CurrentSplitBox() (CE starts on the EQUI) and .MergeBoxes()     --
-- (every entry on the Boxes list is an EQUI name)                  --
---------------------------------------------------------------------
define method .BoxUnderEqui() is STRING
	!ok = true
	var !boxes coll all box for ce
	handle any
		!ok = false
	endhandle
	!nobox = true
	if (!ok) then
		if (not(!boxes.unset())) then
			if (!boxes.size().gt(0)) then
				!nobox = false
			endif
		endif
	endif
	if (!nobox) then
		return 'this EQUI has no BOX under it'
	endif
	!box = !boxes[1]
	$!box
	return ''
endmethod

define method .CurrentSplitBox() is STRING
	!ok = true
	var !cetype type of ce
	handle any
		!ok = false
	endhandle
	if (not(!ok)) then
		!!alert.error('Navigate to a box first')
		return ''
	endif

	if (!cetype.eqnocase('EQUI')) then
		------------------------------------------------------------------
		-- one BOX per EQUI is how this form always builds them, so CE   --
		-- on the EQUI is as good as CE on the BOX itself - step down    --
		-- automatically rather than making the user do it by hand       --
		------------------------------------------------------------------
		!err = !this.BoxUnderEqui()
		if (!err.neq('')) then
			!!alert.error(!err)
			return ''
		endif
	elseif (not(!cetype.eqnocase('BOX'))) then
		!!alert.error('The current element is a ' & !cetype & ', not a BOX or an EQUI')
		return ''
	endif

	return !this.CurrentBoxEqui()
endmethod

------------------------------------------------------------------
-- button handler for Show Box - a plain toggle. a second press   --
-- while a box is already shown just hides it again; .PickSplitPoint() --
-- does not go through here, it calls .RefreshBox() directly so it --
-- always ends up showing whatever CE is right now rather than     --
-- toggling off something that happened to be shown already        --
------------------------------------------------------------------
------------------------------------------------------------------
-- Show Box always re-reads the box under CE and redraws its     --
-- axes. it used to toggle - a second press cleared the aids -   --
-- but on a tab a first-time user reads top to bottom, a button  --
-- that sometimes does nothing visible is one more thing to      --
-- puzzle over (user, 2026-09-20). the aids go with Close, or    --
-- with the next Show Box                                        --
------------------------------------------------------------------
define method .ShowBox()
	!this.RefreshBox()
endmethod

---------------------------------------------------------------------
-- reads the box's own geometry and caches it on the form, then     --
-- draws its centre and X/Y/Z axes. cached rather than re-read at   --
-- split time because CE can move on to something else before Pick --
-- Split Point is pressed - the split still has to act on the box  --
-- that was shown                                                   --
---------------------------------------------------------------------
define method .RefreshBox()
	AID CLEAR ALL
	!this.splitequi = ''
	!this.boxinfo.val = '(no box yet)'
	!equi = !this.CurrentSplitBox()
	if (!equi.eq('')) then
		return
	endif
	!equinav = !this.NavName(!equi)

	var !boxpos worpos
	var !xlen xlength
	var !ylen ylength
	var !zlen zlength
	var !ori ori wrt worl

	!this.splitequi = !equi
	!this.splitcen = !boxpos.position()
	!this.splitxdirstr = !ori.orientation().xdir().string().before('WRT')
	!this.splitydirstr = !ori.orientation().ydir().string().before('WRT')
	!this.splitxlen = !xlen.real()
	!this.splitylen = !ylen.real()
	!this.splitzlen = !zlen.real()

	------------------------------------------------------------------
	-- the sheet texts live on the EQUI, not the BOX, same as        --
	-- everywhere else in this form                                  --
	------------------------------------------------------------------
	!this.splitrev = !this.TagValue(!equinav, 'rev')
	!this.splittitle1 = !this.TagValue(!equinav, 'title1')
	!this.splittitle2 = !this.TagValue(!equinav, 'title2')
	!this.splittitle3 = !this.TagValue(!equinav, 'title3')

	------------------------------------------------------------------
	-- the box line: name, the three lengths, and where it sits in   --
	-- U - the numbers a face move is about to change                --
	------------------------------------------------------------------
	!halfz = !this.splitzlen * 0.5
	!ubot = !this.splitcen.up - !halfz
	!utop = !this.splitcen.up + !halfz
	!txt = !equi & '   X ' & !this.splitxlen.string('D0') & '  Y ' & !this.splitylen.string('D0') & '  Z ' & !this.splitzlen.string('D0')
	!txt = !txt & '   U ' & !ubot.string('D0').replace('mm', '') & ' .. ' & !utop.string('D0').replace('mm', '')
	!this.boxinfo.val = !txt

	!this.DrawBoxAxes()
endmethod

---------------------------------------------------------------------
-- Z is taken as world Up rather than read off the box's own ORI -  --
-- there is no .zdir() used anywhere else in this codebase to       --
-- confirm that call exists, and every box this form ever builds   --
-- is made with 'Z is U' anyway (see .MakeBoxAt()), so a box worth  --
-- showing here is level by construction. a box tilted out of that --
-- plane by some other route would show (and split) its Z wrong    --
---------------------------------------------------------------------
define method .DrawBoxAxes()
	!cen = !this.splitcen
	!xdir = object direction(!this.splitxdirstr)
	!ydir = object direction(!this.splitydirstr)
	!zdir = object direction('U')

	!halfx = !this.splitxlen * 0.5
	!halfy = !this.splitylen * 0.5
	!halfz = !this.splitzlen * 0.5

	------------------------------------------------------------------
	-- SPHERE and TEXT are written the same E/N/U way as .MarkOne(), --
	-- the one AID pattern in this form already proven in the field. --
	-- ARROW has no precedent of our own, so it follows the only     --
	-- AID ARROW in the whole tree (componentcreation.pmlfrm:1525),  --
	-- position/direction/height passed as $!<...>                   --
	------------------------------------------------------------------
	!censtr = !this.EnuOf(!cen)
	AID SPHERE $!censtr DIA 200

	!ptx = !cen.offset(!xdir, !halfx)
	!ptxstr = !this.EnuOf(!ptx)
	AID ARROW NUMBER 1 AT $!<cen> DIRECTION $!<xdir> HEIGH $!<halfx> PROPORTION 0.15
	AID TEXT |X| AT $!ptxstr

	!pty = !cen.offset(!ydir, !halfy)
	!ptystr = !this.EnuOf(!pty)
	AID ARROW NUMBER 1 AT $!<cen> DIRECTION $!<ydir> HEIGH $!<halfy> PROPORTION 0.15
	AID TEXT |Y| AT $!ptystr

	!ptz = !cen.offset(!zdir, !halfz)
	!ptzstr = !this.EnuOf(!ptz)
	AID ARROW NUMBER 1 AT $!<cen> DIRECTION $!<zdir> HEIGH $!<halfz> PROPORTION 0.15
	AID TEXT |Z| AT $!ptzstr
endmethod

---------------------------------------------------------------------
-- picks the single split point. Show Box must have run first -     --
-- there is nothing cached to split against otherwise, and no axis  --
-- checked means the pick would not cut anything                    --
---------------------------------------------------------------------
------------------------------------------------------------------
-- Show Box is a courtesy preview, not a required first step -    --
-- pressing Pick Split Point straight away re-runs the same       --
-- lookup off whatever CE is right now, so the two buttons always --
-- agree on what a pick is about to act on                        --
------------------------------------------------------------------
define method .PickSplitPoint()
	!this.RefreshBox()
	if (!this.splitequi.eq('')) then
		return
	endif
	if (not(!this.splitx.val) and not(!this.splity.val) and not(!this.splitz.val)) then
		!!alert.error('Check at least one of X / Y / Z to split along')
		return
	endif

	!this.DropPicking()
	!packet = object EDGPACKET()
	!packet.definePosition('Split point - anywhere inside the box, off to the side you want to cut')
	!packet.description = !this.edgdesc
	!packet.action = |!!DrawingPlan.SplitPointPicked(!this.return[1].position)|
	!packet.remove = false
	if (!!edgCntrl.add(!packet)) then
	endif
endmethod

------------------------------------------------------------------
-- re-passing a POSITION that arrived as one method's own typed  --
-- parameter into a SECOND method as that method's only argument --
-- failed in the field with 'Method DOSPLITAT(<UNTYPED>) not     --
-- found' - .DoSplitAt(!pos) is not found even though it is      --
-- declared to take exactly that. the position is written into a --
-- member instead and .DoSplitAt() reads it back.                --
-- the cause turned up later on the Grid tab (2026-09-20): !pos  --
-- is a reference into the packet's return array, and            --
-- .DropPicking() in between replaces the packet's EDGSTATE, so  --
-- by the time .DoSplitAt(!pos) was called !pos no longer         --
-- existed - hence <UNTYPED>. the member copy is taken before the --
-- drop, which is why it works. see .GridLevelPicked()            --
------------------------------------------------------------------
define method .SplitPointPicked(!pos is POSITION)
	!!DrawingPlan.splitpickpos = !pos
	!!DrawingPlan.DropPicking()
	!!DrawingPlan.DoSplitAt()
endmethod

---------------------------------------------------------------------
-- turns the picked point into an offset along the box's own X/Y   --
-- (and world Up for Z), splits every checked axis in two at that  --
-- offset, and builds one new box per combination - 1 axis checked --
-- makes 2 boxes, 2 axes make 4, 3 axes make 8.                    --
--                                                                 --
-- everything is validated before anything is created. the         --
-- original box is only deleted once every piece exists; if a      --
-- piece fails partway through, the pieces already made are rolled --
-- back and the original is left exactly as it was                 --
---------------------------------------------------------------------
define method .DoSplitAt()
	!posw = !this.splitpickpos.wrt(WORL)
	!cen = !this.splitcen
	!xdir = object direction(!this.splitxdirstr)
	!ydir = object direction(!this.splitydirstr)

	!halfx = !this.splitxlen * 0.5
	!halfy = !this.splitylen * 0.5
	!halfz = !this.splitzlen * 0.5

	------------------------------------------------------------------
	-- project the picked point onto the box's own X and Y.          --
	--                                                                --
	-- a coordinate difference (.east - .east) still carries the     --
	-- DIST unit, so multiplying two of them together, as the dot    --
	-- product below does, gives PDMS an area (SQDI) - 'DIMENSION    --
	-- (UNIT) MISMATCH ... cannot combine physical quantities DIST   --
	-- and SQDI' in the field. dividing the offset point's E/N/U     --
	-- difference by the offset's own DIST length (from .distance(), --
	-- not the bare number handed to .offset()) cancels the unit the --
	-- same way .MakeBox() already does for !ux/!uy - '!ux = (!e2 -  --
	-- !e1) / !xlen' - leaving a genuinely dimensionless component   --
	-- that is then safe to multiply against a DIST again            --
	------------------------------------------------------------------
	!refx = !cen.offset(!xdir, 1000)
	!lenx = !cen.distance(!refx)
	!uxE = (!refx.east - !cen.east) / !lenx
	!uxN = (!refx.north - !cen.north) / !lenx
	!uxU = (!refx.up - !cen.up) / !lenx

	!refy = !cen.offset(!ydir, 1000)
	!leny = !cen.distance(!refy)
	!uyE = (!refy.east - !cen.east) / !leny
	!uyN = (!refy.north - !cen.north) / !leny
	!uyU = (!refy.up - !cen.up) / !leny

	!dE = !posw.east - !cen.east
	!dN = !posw.north - !cen.north
	!dU = !posw.up - !cen.up

	!localx = !dE * !uxE + !dN * !uxN + !dU * !uxU
	!localy = !dE * !uyE + !dN * !uyN + !dU * !uyU
	!localz = !dU

	------------------------------------------------------------------
	-- Offset shifts the cut away from the point actually picked -   --
	-- e.g. the user clicks the underside of a steel beam to snap to --
	-- something, but the real cut is 50mm further down (Z offset    --
	-- -50). blank is 0mm, same as .ubot.val/.utop.val elsewhere      --
	------------------------------------------------------------------
	!xoff = 0
	if (not(!this.splitxoff.val.unset())) then
		!xoff = !this.splitxoff.val
	endif
	!yoff = 0
	if (not(!this.splityoff.val.unset())) then
		!yoff = !this.splityoff.val
	endif
	!zoff = 0
	if (not(!this.splitzoff.val.unset())) then
		!zoff = !this.splitzoff.val
	endif
	!localx = !localx + !xoff
	!localy = !localy + !yoff
	!localz = !localz + !zoff

	------------------------------------------------------------------
	-- a split half thinner than 1mm is not a usable drawing frame,  --
	-- so a checked axis whose point is too close to an end - or     --
	-- past it entirely, which happens whenever the point picked to  --
	-- line the cut up (an elbow, a beam) is not itself inside the   --
	-- box on every axis - is not an error any more. that axis is    --
	-- just left uncut, the same as if it had not been checked, and  --
	-- .splitresult says so afterwards. only every checked axis      --
	-- being unusable at once is an error, since then there would be --
	-- nothing left to split                                         --
	------------------------------------------------------------------
	!usex = false
	!usey = false
	!usez = false
	!skipped = ARRAY()

	if (!this.splitx.val) then
		if (!localx.lt(0 - !halfx + 1) or !localx.gt(!halfx - 1)) then
			!skipped.append('X')
		else
			!usex = true
		endif
	endif
	if (!this.splity.val) then
		if (!localy.lt(0 - !halfy + 1) or !localy.gt(!halfy - 1)) then
			!skipped.append('Y')
		else
			!usey = true
		endif
	endif
	if (!this.splitz.val) then
		if (!localz.lt(0 - !halfz + 1) or !localz.gt(!halfz - 1)) then
			!skipped.append('Z')
		else
			!usez = true
		endif
	endif

	if (not(!usex) and not(!usey) and not(!usez)) then
		!!alert.error('The picked point is too close to (or outside) every checked axis - nothing to split')
		return
	endif

	------------------------------------------------------------------
	-- one axis not checked = one state, offset 0mm, the full length --
	-- one axis checked = two states, the low half and the high half --
	-- looping every axis from 1 to its bound and multiplying them   --
	-- out this way visits every combination without needing an      --
	-- array of arrays, which nothing else in this codebase does     --
	------------------------------------------------------------------
	!xoffs = ARRAY()
	!xoffs.append(0)
	!xoffs.append(0)
	!xlens = ARRAY()
	!xlens.append(!this.splitxlen)
	!xlens.append(!this.splitxlen)
	!xbound = 1
	if (!usex) then
		!xoffs[1] = (!localx - !halfx) / 2
		!xoffs[2] = (!localx + !halfx) / 2
		!xlens[1] = !localx + !halfx
		!xlens[2] = !halfx - !localx
		!xbound = 2
	endif

	!yoffs = ARRAY()
	!yoffs.append(0)
	!yoffs.append(0)
	!ylens = ARRAY()
	!ylens.append(!this.splitylen)
	!ylens.append(!this.splitylen)
	!ybound = 1
	if (!usey) then
		!yoffs[1] = (!localy - !halfy) / 2
		!yoffs[2] = (!localy + !halfy) / 2
		!ylens[1] = !localy + !halfy
		!ylens[2] = !halfy - !localy
		!ybound = 2
	endif

	!zoffs = ARRAY()
	!zoffs.append(0)
	!zoffs.append(0)
	!zlens = ARRAY()
	!zlens.append(!this.splitzlen)
	!zlens.append(!this.splitzlen)
	!zbound = 1
	if (!usez) then
		!zoffs[1] = (!localz - !halfz) / 2
		!zoffs[2] = (!localz + !halfz) / 2
		!zlens[1] = !localz + !halfz
		!zlens[2] = !halfz - !localz
		!zbound = 2
	endif

	!zdir = object direction('U')

	!created = ARRAY()
	!failed = ''

	do !ix from 1 to !xbound
		do !iy from 1 to !ybound
			do !iz from 1 to !zbound
				!newcen = !cen.offset(!xdir, !xoffs[!ix])
				!newcen = !newcen.offset(!ydir, !yoffs[!iy])
				!newcen = !newcen.offset(!zdir, !zoffs[!iz])

				!err = !this.MakeBoxAt(!newcen, !this.splitydirstr, !xlens[!ix], !ylens[!iy], !zlens[!iz], '', !this.splitrev, !this.splittitle1, !this.splittitle2, !this.splittitle3)
				if (!err.neq('')) then
					!failed = !err
				else
					var !newequi namn of ce
					!created.append(!newequi)
				endif
			enddo
		enddo
	enddo

	if (!failed.neq('')) then
		----------------------------------------------------------------
		-- roll back whatever did get made rather than leave the       --
		-- model half split. the original box has not been touched    --
		----------------------------------------------------------------
		do !nm values !created
			!nmnav = !this.NavName(!nm)
			$!nmnav
			delete equi
			handle any
			endhandle
		enddo
		!!alert.error('Split failed (' & !failed & ') - no changes made')
		AID CLEAR ALL
		return
	endif

	!equinav = !this.NavName(!this.splitequi)
	$!equinav
	!ok = true
	delete equi
	handle any
		!ok = false
	endhandle
	if (not(!ok)) then
		!!alert.error('The ' & !created.size().string() & ' new box(es) were created, but the original box could not be deleted - please delete it by hand')
	endif

	AID CLEAR ALL
	!msg = !created.size().string() & ' box(es) created'
	if (!skipped.size().gt(0)) then
		!skipstr = ''
		do !s values !skipped
			!skipstr = !skipstr & !s
		enddo
		!msg = !msg & ' (' & !skipstr & ' skipped - point too close/outside)'
	endif
	!this.splitresult.val = !msg
	!this.splitequi = ''
endmethod

----------------------------------------------
-- Move Face (shares the Modify tab) - one   --
-- face of the box goes out or in, the       --
-- opposite face stays where it is           --
----------------------------------------------
---------------------------------------------------------------------
-- the box is changed in place - its POS and the length on that     --
-- axis - so its name, its sheet texts and whatever on the drawing  --
-- side refers to it all stay as they are; Split and Merge make new --
-- boxes, this must not. E3D's own XLEN/YLEN/ZLEN edit grows both   --
-- ends about the centre, which is never what a frame change wants: --
-- a storey top moves, a frame edge goes out 500 (user, 2026-09-20). --
-- every way in ends up as one outward distance for the chosen face --
-- and goes through .MoveFace()                                      --
---------------------------------------------------------------------

---------------------------------------------------------------------
-- the chosen face as numbers: its outward unit normal in world     --
-- E/N/U (dimensionless, made the offset-and-divide-by-distance way --
-- .DoSplitAt() explains), the half length of the box on that axis, --
-- and which axis it is. [1]=nE [2]=nN [3]=nU [4]=half [5]='X'|'Y'|'Z' --
-- [6]=the face's name for messages. reads the cached geometry, so  --
-- .RefreshBox() has to have run                                    --
---------------------------------------------------------------------
define method .FaceInfo() is ARRAY
	!cen = !this.splitcen
	!sel = !this.faceopt.val
	!info = ARRAY()

	if (!sel eq 5 or !sel eq 6) then
		!info.append(0)
		!info.append(0)
		!info.append(1)
		!info.append(!this.splitzlen * 0.5)
		!info.append('Z')
		!info.append('Top')
		if (!sel eq 6) then
			!info[3] = -1
			!info[6] = 'Bottom'
		endif
		return !info
	endif

	!dirstr = !this.splitxdirstr
	!half = !this.splitxlen * 0.5
	!axis = 'X'
	if (!sel eq 3 or !sel eq 4) then
		!dirstr = !this.splitydirstr
		!half = !this.splitylen * 0.5
		!axis = 'Y'
	endif
	!dir = object direction(!dirstr)
	!ref = !cen.offset(!dir, 1000)
	!len = !cen.distance(!ref)
	!nE = (!ref.east - !cen.east) / !len
	!nN = (!ref.north - !cen.north) / !len
	!nU = (!ref.up - !cen.up) / !len
	!name = '+' & !axis
	if (!sel eq 2 or !sel eq 4) then
		!nE = 0 - !nE
		!nN = 0 - !nN
		!nU = 0 - !nU
		!name = '-' & !axis
	endif
	!info.append(!nE)
	!info.append(!nN)
	!info.append(!nU)
	!info.append(!half)
	!info.append(!axis)
	!info.append(!name)
	return !info
endmethod

------------------------------------------------------------------
-- Move by: the offset typed in, + out and - in. the box is      --
-- looked up again off CE first, the same as Pick Split Point,   --
-- so Show Box is a preview and not a required step             --
------------------------------------------------------------------
define method .MoveFaceBy()
	if (!this.faceoff.val.unset()) then
		!!alert.error('Type the distance to move the face by (+ out, - in)')
		return
	endif
	!this.RefreshBox()
	if (!this.splitequi.eq('')) then
		return
	endif
	!this.MoveFace(!this.faceoff.val)
endmethod

------------------------------------------------------------------
-- Move to: a world coordinate for the face. only a face square  --
-- to the world axes has one - Top/Bottom always (U), +X..-Y     --
-- only when the box is not turned. the outward distance is how  --
-- far the face's present coordinate is from the one typed,      --
-- signed by which way outward points along that axis            --
------------------------------------------------------------------
define method .MoveFaceTo()
	if (!this.faceto.val.unset()) then
		!!alert.error('Type the coordinate to move the face to')
		return
	endif
	!this.RefreshBox()
	if (!this.splitequi.eq('')) then
		return
	endif
	!info = !this.FaceInfo()
	!nE = !info[1]
	!nN = !info[2]
	!nU = !info[3]
	!half = !info[4]
	!cen = !this.splitcen

	------------------------------------------------------------------
	-- which world axis the normal lies along, if any. 0.9998 is    --
	-- cos(1 degree)                                                 --
	------------------------------------------------------------------
	!sign = 0
	!cencoord = 0
	!axisname = ''
	if (!nU.abs() gt 0.9998) then
		!sign = 1
		if (!nU lt 0) then
			!sign = -1
		endif
		!cencoord = !cen.up
		!axisname = 'U'
	elseif (!nE.abs() gt 0.9998) then
		!sign = 1
		if (!nE lt 0) then
			!sign = -1
		endif
		!cencoord = !cen.east
		!axisname = 'E'
	elseif (!nN.abs() gt 0.9998) then
		!sign = 1
		if (!nN lt 0) then
			!sign = -1
		endif
		!cencoord = !cen.north
		!axisname = 'N'
	else
		!!alert.error('face ' & !info[6] & ' is not square to E/N/U - the box is turned. use Move by or Move to Picked Point')
		return
	endif

	!facecoord = !cencoord + !sign * !half
	!d = (!this.faceto.val - !facecoord) * !sign
	!this.MoveFace(!d)
endmethod

------------------------------------------------------------------
-- Move to Picked Point: the face is moved to pass through the   --
-- point, i.e. by however far the point is outside (or inside)   --
-- the face along its normal. the box is looked up before the    --
-- pick and the geometry cached, the same as Pick Split Point    --
------------------------------------------------------------------
define method .PickFacePoint()
	!this.RefreshBox()
	if (!this.splitequi.eq('')) then
		return
	endif
	!info = !this.FaceInfo()

	!this.DropPicking()
	!packet = object EDGPACKET()
	!packet.definePosition('Point to move face ' & !info[6] & ' to')
	!packet.description = !this.edgdesc
	!packet.action = |!!DrawingPlan.FacePointPicked(!this.return[1].position)|
	!packet.remove = false
	if (!!edgCntrl.add(!packet)) then
	endif
endmethod

------------------------------------------------------------------
-- the position is copied into a member BEFORE the packet is     --
-- dropped - see .GridLevelPicked() for why                      --
------------------------------------------------------------------
define method .FacePointPicked(!pos is POSITION)
	!!DrawingPlan.facepickpos = !pos
	!!DrawingPlan.DropPicking()
	!!DrawingPlan.MoveFaceToPoint()
endmethod

define method .MoveFaceToPoint()
	!posw = !this.facepickpos.wrt(WORL)
	!cen = !this.splitcen
	!info = !this.FaceInfo()
	!dE = !posw.east - !cen.east
	!dN = !posw.north - !cen.north
	!dU = !posw.up - !cen.up
	!along = !dE * !info[1] + !dN * !info[2] + !dU * !info[3]
	!d = !along - !info[4]
	!this.MoveFace(!d)
endmethod

---------------------------------------------------------------------
-- the move itself: !d is how far the chosen face goes outward      --
-- (negative for inward). the box keeps its orientation; its centre --
-- goes half of !d along the face normal and the length on that     --
-- axis grows by !d. CE is put back on the box by name rather than  --
-- trusted, since a pick may have been in between. the cache and    --
-- the axes are refreshed afterwards so the next move starts from   --
-- the new size                                                     --
---------------------------------------------------------------------
define method .MoveFace(!d is REAL)
	if (!d.abs() lt 0.5) then
		!this.splitresult.val = 'face is already there - nothing moved'
		return
	endif
	!info = !this.FaceInfo()
	!nE = !info[1]
	!nN = !info[2]
	!nU = !info[3]
	!half = !info[4]
	!axis = !info[5]
	!name = !info[6]

	!oldlen = !half * 2
	!newlen = !oldlen + !d
	if (!newlen lt 1) then
		!!alert.error('moving face ' & !name & ' by ' & !d.string('D0') & ' would leave the box thinner than 1mm on ' & !axis)
		return
	endif

	!cen = !this.splitcen
	!shift = !d * 0.5
	!newE = !cen.east + !nE * !shift
	!newN = !cen.north + !nN * !shift
	!newU = !cen.up + !nU * !shift
	!pcen = !this.PosOf(!newE, !newN, !newU)

	!equinav = !this.NavName(!this.splitequi)
	!ok = true
	$!equinav
	handle any
		!ok = false
	endhandle
	if (not(!ok)) then
		!!alert.error('cannot get back to ' & !this.splitequi)
		return
	endif
	!err = !this.BoxUnderEqui()
	if (!err.neq('')) then
		!!alert.error(!err)
		return
	endif

	POS $!pcen
	handle any
		!ok = false
	endhandle
	if (not(!ok)) then
		!!alert.error('cannot move ' & !this.splitequi)
		return
	endif
	------------------------------------------------------------------
	-- a handle only catches the command right before it, so each   --
	-- branch carries its own                                        --
	------------------------------------------------------------------
	if (!axis.eq('X')) then
		XLEN $!newlen
		handle any
			!ok = false
		endhandle
	elseif (!axis.eq('Y')) then
		YLEN $!newlen
		handle any
			!ok = false
		endhandle
	else
		ZLEN $!newlen
		handle any
			!ok = false
		endhandle
	endif
	if (not(!ok)) then
		!!alert.error('moved the centre of ' & !this.splitequi & ' but could not set its ' & !axis & ' length - check the box')
		return
	endif

	!this.RefreshBox()
	!this.splitresult.val = 'face ' & !name & ' of ' & !this.splitequi & ' moved ' & !d.string('D0') & ' out - ' & !axis & ' length ' & !oldlen.string('D0') & ' -> ' & !newlen.string('D0')
endmethod


----------------------------------------------
-- Merge (shares the Modify tab) - the       --
-- opposite of Split: replace several boxes  --
-- with the one box that covers all of them  --
----------------------------------------------
---------------------------------------------------------------------
-- what is 'selected' is whatever the user has picked in the model  --
-- or the Design Explorer (ctrl-click for several) - object          --
-- SELECTION()/.getcurrent()/.getselection() reads that back as an   --
-- array of navigable refs. a selected EQUI is stepped down onto     --
-- its BOX the same as CE is on the Split side; anything that is     --
-- not a BOX, not under an EQUI, or not under                        --
-- <projid>_DrawingPlanBox is silently skipped rather than rejecting --
-- the whole merge over one stray thing caught in a multi-select     --
--                                                                  --
-- everything the shared X/Y/Z direction and world-Up-for-Z only    --
-- mean anything if every selected box points the same way, so that --
-- is checked next (by comparing each one's Y direction string to   --
-- the first box's - boxes this form builds always agree exactly).  --
-- the merged box is the UNION of each selected box's own extent    --
-- along the shared X/Y/Z, projected the same offset-and-divide-by- --
-- distance way .DoSplitAt() projects a picked point, just run once --
-- per box instead of once per pick. this does not check the boxes  --
-- are actually adjacent or that there is no gap between them - it  --
-- just wraps a single box around whatever was selected              --
--                                                                  --
-- the new box is only created after every selected box has been    --
-- read successfully; the sources are only deleted after the new    --
-- box exists. a failure deleting a source is a warning, not a      --
-- rollback - the merge itself already succeeded by that point      --
---------------------------------------------------------------------
define method .MergeBoxes()
	var !projid proj id
	!sitename = '/' & !projid & '_DrawingPlanBox'

	!sele = object selection()
	!sele.getcurrent()
	!sels = !sele.getselection()

	!names = ARRAY()
	do !sel values !sels
		!ok = true
		$!sel
		handle any
			!ok = false
		endhandle

		if (!ok) then
			var !cetype type of ce
			if (!cetype.eqnocase('EQUI')) then
				!err = !this.BoxUnderEqui()
				if (!err.neq('')) then
					!ok = false
				endif
			elseif (not(!cetype.eqnocase('BOX'))) then
				!ok = false
			endif
		endif

		if (!ok) then
			var !site name of site of ce
			if (!site.eq(!sitename)) then
				var !equi namn of equi of ce
				if !names.find(!equi).size().eq(0) then
					!names.append(!equi)
				endif
			endif
		endif
	enddo

	if (!names.size().lt(2)) then
		!!alert.error('Select at least two boxes (or their EQUIs) under ' & !sitename & ' in the model, then press Merge')
		return
	endif

	!haveref = false
	!ydirstr = ''
	!badori = false
	!bad = ''

	do !nm values !names
		!equinav = !this.NavName(!nm)
		!ok = true
		$!equinav
		handle any
			!ok = false
		endhandle
		if (not(!ok)) then
			!!alert.error('Cannot navigate to ' & !nm)
			return
		endif

		!err = !this.BoxUnderEqui()
		if (!err.neq('')) then
			!!alert.error(!nm & ' - ' & !err)
			return
		endif

		var !boxpos worpos
		var !xlen xlength
		var !ylen ylength
		var !zlen zlength
		var !ori ori wrt worl
		!thisydir = !ori.orientation().ydir()
		!thishalfx = !xlen.real() * 0.5
		!thishalfy = !ylen.real() * 0.5
		!thishalfz = !zlen.real() * 0.5

		if (not(!haveref)) then
			----------------------------------------------------------
			-- the first box in the list becomes the reference frame --
			-- everything else is measured against                   --
			----------------------------------------------------------
			!refcen = !boxpos.position()
			!xdir = !ori.orientation().xdir()
			!ydir = !thisydir
			!ydirstr = !ydir.string().before('WRT')
			!haveref = true

			!minx = 0 - !thishalfx
			!maxx = !thishalfx
			!miny = 0 - !thishalfy
			!maxy = !thishalfy
			!minz = 0 - !thishalfz
			!maxz = !thishalfz
		else
			--------------------------------------------------------------
			-- a box is symmetric about its own axes, so Y pointing the  --
			-- opposite way describes the exact same box (the same trap  --
			-- noted in .MakeBox()) - two boxes that plainly should      --
			-- merge came back as 'Y is N 12.523 E' and 'Y is S 12.523   --
			-- W' in the field, 180 degrees apart and physically         --
			-- identical. .angle() only ever answers 0-180 with no sign, --
			-- so both 0 (same) and 180 (opposite) count as a match -    --
			-- anything else is a real difference                        --
			--------------------------------------------------------------
			!ang = !thisydir.angle(!ydir)
			if (!ang.gt(0.5) and !ang.lt(179.5)) then
				!badori = true
				!bad = !nm
			endif

			if (not(!badori)) then
				!thiscen = !boxpos.position()

				!refx = !refcen.offset(!xdir, 1000)
				!lenx = !refcen.distance(!refx)
				!uxE = (!refx.east - !refcen.east) / !lenx
				!uxN = (!refx.north - !refcen.north) / !lenx
				!uxU = (!refx.up - !refcen.up) / !lenx

				!refy = !refcen.offset(!ydir, 1000)
				!leny = !refcen.distance(!refy)
				!uyE = (!refy.east - !refcen.east) / !leny
				!uyN = (!refy.north - !refcen.north) / !leny
				!uyU = (!refy.up - !refcen.up) / !leny

				!dE = !thiscen.east - !refcen.east
				!dN = !thiscen.north - !refcen.north
				!dU = !thiscen.up - !refcen.up

				!ox = !dE * !uxE + !dN * !uxN + !dU * !uxU
				!oy = !dE * !uyE + !dN * !uyN + !dU * !uyU
				!oz = !dU

				!lo = !ox - !thishalfx
				!hi = !ox + !thishalfx
				if (!lo.lt(!minx)) then
					!minx = !lo
				endif
				if (!hi.gt(!maxx)) then
					!maxx = !hi
				endif

				!lo = !oy - !thishalfy
				!hi = !oy + !thishalfy
				if (!lo.lt(!miny)) then
					!miny = !lo
				endif
				if (!hi.gt(!maxy)) then
					!maxy = !hi
				endif

				!lo = !oz - !thishalfz
				!hi = !oz + !thishalfz
				if (!lo.lt(!minz)) then
					!minz = !lo
				endif
				if (!hi.gt(!maxz)) then
					!maxz = !hi
				endif
			endif
		endif
	enddo

	if (!badori) then
		!!alert.error(!bad & ' is not the same orientation as the rest of the selection - cannot merge')
		return
	endif

	!mcx = (!minx + !maxx) / 2
	!mcy = (!miny + !maxy) / 2
	!mcz = (!minz + !maxz) / 2
	!mxlen = !maxx - !minx
	!mylen = !maxy - !miny
	!mzlen = !maxz - !minz

	!mergecen = !refcen.offset(!xdir, !mcx)
	!mergecen = !mergecen.offset(!ydir, !mcy)
	!mergecen = !mergecen.offset(object direction('U'), !mcz)

	------------------------------------------------------------------
	-- the merged box comes out unnamed with no rev/titles - the     --
	-- boxes being merged could each have had their own, and there   --
	-- is no single right answer to pick between them                --
	------------------------------------------------------------------
	!err = !this.MakeBoxAt(!mergecen, !ydirstr, !mxlen, !mylen, !mzlen, '', '', '', '', '')
	if (!err.neq('')) then
		!!alert.error('Merge failed (' & !err & ') - no changes made')
		return
	endif

	!ndel = 0
	do !nm values !names
		!equinav = !this.NavName(!nm)
		!ok = true
		$!equinav
		handle any
			!ok = false
		endhandle
		if (!ok) then
			delete equi
			handle any
				!ok = false
			endhandle
		endif
		if (!ok) then
			!ndel = !ndel + 1
		endif
	enddo

	AID CLEAR ALL
	if (!ndel.lt(!names.size())) then
		!nleft = !names.size() - !ndel
		!!alert.error(!nleft.string() & ' of the merged box(es) could not be deleted - please delete them by hand')
	endif
	!this.splitresult.val = 'Merged ' & !ndel.string() & ' box(es) into 1'
endmethod

----------------------------------------------
-- Import tab - three points from a CAD file --
----------------------------------------------
define method .BrowseFile()
	using namespace 'Aveva.Core.Presentation'
	!browser = object PMLFILEBROWSER('OPEN')
	!browser.show(!this.userevar, '*.csv', 'CAD box file', false, 'csv files (*.csv)|*.csv|txt files (*.txt)|*.txt', 2)
	if (!browser.file().neq('')) then
		!this.userevar = !browser.file()
		!this.filetext.val = !browser.file()
	endif
endmethod

define method .ImportFile()
	!file = !this.filetext.val
	if (!file.eq('')) then
		!!alert.error('Choose a file first')
		return
	endif

	!opened = true
	!ff = object FILE(!file)
	!ff.open('READ')
	handle any
		!opened = false
	endhandle
	if (not(!opened)) then
		!!alert.error('Cannot open ' & !file)
		return
	endif
	!lines = !ff.readfile()
	!ff.close()

	if (not(!lines.set())) then
		!!alert.error(!file & ' is empty')
		return
	endif

	------------------------------------------------------------------
	-- the two Elevation boxes are the fallback for every line that  --
	-- does not carry its own, so read them once and remember        --
	-- whether they were filled in at all                            --
	------------------------------------------------------------------
	!defbot = 0
	!deftop = 0
	!havedef = false
	if (not(!this.ubot.val.unset()) and not(!this.utop.val.unset())) then
		!defbot = !this.ubot.val
		!deftop = !this.utop.val
		!havedef = true
	endif

	!log = ARRAY()
	!ok = 0
	!ng = 0
	!row = 0

	do !raw values !lines
		!row = !row + 1
		!line = !raw.trim()
		if (!line.neq('') and (not(!line.matchwild('--*')))) then
			!f = !this.SplitKeep(!line, ';')
			if (!f.size().lt(6)) then
				!ng = !ng + 1
				!log.append('line ' & !row.string() & ' - skipped, needs at least six coordinates')
			else
				!ubot = !defbot
				!utop = !deftop
				!haveelev = !havedef
				!botstr = !this.Field(!f, 12)
				!topstr = !this.Field(!f, 13)
				if (!botstr.neq('') and !topstr.neq('')) then
					!ubot = !this.NumOf(!botstr)
					!utop = !this.NumOf(!topstr)
					!haveelev = true
				endif

				if (not(!haveelev)) then
					!ng = !ng + 1
					!log.append('line ' & !row.string() & ' - skipped, no elevation on the line and none in the Elevation boxes')
				else
					!p1 = !this.PosOf(!this.NumOf(!this.Field(!f, 1)), !this.NumOf(!this.Field(!f, 2)), 0)
					!p2 = !this.PosOf(!this.NumOf(!this.Field(!f, 3)), !this.NumOf(!this.Field(!f, 4)), 0)
					!p3 = !this.PosOf(!this.NumOf(!this.Field(!f, 5)), !this.NumOf(!this.Field(!f, 6)), 0)

					!err = !this.MakeBox(!p1, !p2, !p3, !ubot, !utop, !this.Field(!f, 7), !this.Field(!f, 8), !this.Field(!f, 9), !this.Field(!f, 10), !this.Field(!f, 11))
					if (!err.neq('')) then
						!ng = !ng + 1
						!log.append('line ' & !row.string() & ' - ' & !err)
					else
						!ok = !ok + 1
						var !equi namn of ce
						!log.append('line ' & !row.string() & ' - created ' & !equi)
					endif
				endif
			endif
		endif
	enddo

	!log.append('')
	!log.append(!ok.string() & ' box(es) created, ' & !ng.string() & ' line(s) skipped')
	!this.log.dtext = !log
	!!alert.message(!ok.string() & ' box(es) created, ' & !ng.string() & ' line(s) skipped - see the Result list')
endmethod

define method .Field(!f is ARRAY, !i is REAL) is STRING
	if (!f.size().lt(!i)) then
		return ''
	endif
	return !f[!i].trim()
endmethod

---------------------------------------------------------------------
-- STRING.split() drops empty tokens, which would shift every       --
-- optional field along the line as soon as one is left blank, so   --
-- the separators are walked by hand and empty fields are kept      --
---------------------------------------------------------------------
define method .SplitKeep(!str is STRING, !sep is STRING) is ARRAY
	!out = ARRAY()
	!rest = !str
	!pat = '*' & !sep & '*'
	do !i from 1 to 500
		break if (not(!rest.matchwild(!pat)))
		!out.append(!rest.before(!sep))
		!rest = !rest.after(!sep)
	enddo
	!out.append(!rest)
	return !out
endmethod

define method .Close()
	!this.DropPicking()
	AID CLEAR ALL
	kill !!DrawingPlan
endmethod

	-----------------
	!file1 = 'C:\TEMP\rest.TXT'
	!ff1 = object file(!file1)
	!ff1.open('READ')
	!lines =!ff1.readfile()
	do !i From 1 to !lines.size()
		!line = !lines[!i]

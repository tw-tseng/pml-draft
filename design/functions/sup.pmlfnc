	!file1 = 'C:\TEMP\ATTA1.TXT'
	!ff1 = object file(!file1)
	!ff1.open('READ')	

	!attas =!ff1.readfile()	
	do !i From 1 to !attas.size()
		!name = !attas[!i]
		/$!name
		handle any
			$p error -> $!name
		elsehandle none      
			var !pipe CE
			var !pipename name of $!pipe
			$!pipename
			var !zone name of zone of $!pipe
			!pipename = '/c:\temp\' & !pipename.substring(2) & '!' & !zone.substring(2) & '.txt'
			$p $!pipename
			ALPHA FILE $!pipename
			OUTPUT $!pipe
			handle any
				!error = !!error.text
				WRITEALPHAFILE ''
				WRITEALPHAFILE ' ERROR - $!error'
				WRITEALPHAFILE ''
			endhandle
			TERM
		

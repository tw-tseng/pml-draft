--Description:  check if a reload of the object is required. The standard object don't know this method and produce a error, that mean the reload of the extended object is required
--
--Method Type:  Procedure
--
--Arguments:
-- [#] [R/RW]  [Data Type] [Description]
--
--Return:
--             [Data Type] [Description]
--
---------------------------------------------------------------------------

define method .VESObjReloadReq()

  --dont remove this empty method

endmethod

---------------------------------------------------------------------------
--Method:       ValidFileName()
--
--Description:  checks if the current string is a valid file name
--
--Method Type:  Function
--
--Arguments:
-- [#] [R/RW]  [Data Type] [Description]
--
--Return:
--             [Data Type] [Description]
--              BOOLEAN     true, if the current string does not contain any critical symbol
---------------------------------------------------------------------------

define method .ValidFileName() is BOOLEAN

  !InvalidString  = '" # $$ % * + / : < = > ? \ | ~ &'
  !InvalidSymbols = !InvalidString.Split()

  do !InvalidSymbol value !InvalidSymbols
    if ( !this.Split(!InvalidSymbol).Size().Gt(1) ) then
      return false
    endif
  enddo

  return true

endmethod


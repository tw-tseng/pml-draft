-------------------------------------------------------------------
-- match line per-element diff, one of five files                 --
-- Date     : 2026-08-28                                          --
--                                                                --
-- the match line's straights and texts carry no DDNA and no      --
-- stable name, so an update cannot find last run's copy of one   --
-- by identity the way the GLABs are found. what they do have is  --
-- geometry that is entirely derived from the view border and the --
-- neighbouring boxes -- so the match is done on that geometry:   --
-- an existing element standing exactly where this run wants one  --
-- IS that one, and is left untouched                             --
--                                                                --
-- the run's state lives in three parallel globals, filled by     --
-- .MatchCollect() and consumed by .MatchClaimRef():              --
--   !!DrawingPlan1MatchCandRefs / ...CandSigs / ...Claims        --
-- globals rather than form members for the usual reason: these   --
-- files are re-read on every call, the form only on kill/show    --
--                                                                --
-- PML finds a function by file name, so each of the five lives   --
-- in its own file: MatchXY / MatchCollect / MatchClaim /         --
-- MatchClaimRef / MatchCleanup                                   --
-------------------------------------------------------------------

-------------------------------------------------------------------
-- the same thing, but answering WHICH element was claimed. the    --
-- four border straights are handed to .Apply() afterwards by ref  --
-- (it puts them back on the corners once it knows how far the     --
-- annotation reaches), so for those it is not enough to know that --
-- one was found                                                   --
--                                                                --
-- '' means nothing is standing there and the caller should draw   --
-------------------------------------------------------------------
--------------------------------------------------------------------------
-- user rule, 2026-09-01: once an element exists and a REVI is on the   --
-- drawing, its position is fixed, no matter how far the box moves --   --
-- so unlike the 0.05mm cutoff this used to apply per field (fine while --
-- nothing but last-digit noise separated two runs, but a tick whose    --
-- real crossing point genuinely shifted a few mm on a box resize fell  --
-- outside it and got rebuilt -- old tick removed, new one drawn a few  --
-- mm off, a picture-diff cloud over a point nothing actually happened  --
-- to), matching a straight is now nearest-candidate-of-the-same-kind,  --
-- with no distance limit at all: whichever unclaimed straight already  --
-- standing is closest to where this run wants one IS that one          --
--                                                                       --
-- text keeps its exact-content requirement (line below) rather than    --
-- joining this -- a MATCH LINE E123456 label's own wording carries the --
-- true coordinate of a border that may really have moved, so a genuine --
-- change there is supposed to draw as one, the same way a dimension    --
-- figure is allowed to read a different number when what it measures   --
-- really changed                                                       --
--------------------------------------------------------------------------
define function !!DrawingPlan1MatchClaimRef(!sig is string) is string
	!answer = ''
	!n = 0
	!n = !!DrawingPlan1MatchCandSigs.size()
	handle any
		!n = 0
	endhandle
	!parts = !sig.split('~')
	!kind = !parts.getindexed(1)
	if (!kind.eq('T')) then
		!nf = 3
	else
		!nf = 5
	endif
	!bestref = ''
	!besti = 0
	!bestd = -1
	do !i from 1 to !n
		if (not(!!DrawingPlan1MatchClaims[!i])) then
			!cand = !!DrawingPlan1MatchCandSigs[!i]
			!cp = !cand.split('~')
			if (!cp.getindexed(1).eq(!kind)) then
				!same = true
				if (!kind.eq('T')) then
					if (not(!cp.getindexed(4).eq(!parts.getindexed(4)))) then
						!same = false
					endif
				endif
				!totd = 0
				if (!same) then
					do !k from 2 to !nf
						!a = !cp.getindexed(!k)
						!b = !parts.getindexed(!k)
						if (!a.eq('') or !b.eq('')) then
							-- one of them would not parse: cannot be called a match --
							if (not(!a.eq(!b))) then
								!same = false
							endif
						else
							!d = abs(!a.real() - !b.real())
							!totd = !totd + !d
						endif
					enddo
				endif
				if (!same and (!bestd.lt(0) or !totd.lt(!bestd))) then
					!bestref = !!DrawingPlan1MatchCandRefs[!i]
					!besti = !i
					!bestd = !totd
				endif
			endif
		endif
	enddo
	if (!besti.gt(0)) then
		!!DrawingPlan1MatchClaims[!besti] = true
		!answer = !bestref
	endif
	return !answer
endfunction

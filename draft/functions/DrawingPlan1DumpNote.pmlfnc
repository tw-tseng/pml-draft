-------------------------------------------------------------------
-- Function : one-shot probe, 2026-08-28                          --
--                                                                --
-- lists everything sitting in the view's NOTE 1 and, for each    --
-- STRA and TEXP, whatever of a list of candidate attributes      --
-- actually answers. the match line elements live in there mixed  --
-- with the keyplan OUTL and the border texts, and they carry no  --
-- DDNA and no stable name, so before they can be diffed on the   --
-- update path we have to know which attribute identifies them    --
-- (colour? line style? pen number?) and how their endpoints read --
-- back                                                           --
--                                                                --
-- AVEVA's own TestDrawList.pmlfrm reads a straight line's ends   --
-- as .dbref().ptfa[1].xypos / .ptfa[2].xypos and MdsDraftUtil    --
-- filters with 'coll all stra with nlpn eq 200', so those two    --
-- are the shapes worth confirming first                          --
--                                                                --
-- run it from the command line:                                  --
--   !!DrawingPlan1DumpNote('/DWGNO-004')                         --
-- delete this file once the match line diff is written           --
-------------------------------------------------------------------
define function !!DrawingPlan1DumpNote(!name is string)
	!f = object file('L:\E3D\pdms_prog\E3D2.1\PA_pmllibE3D2.1\check_note.txt')
	!f.open('overwrite')

	$!name/SS/S1/V1
	handle any
		!f.writerecord('CANNOT REACH ' & !name & '/SS/S1/V1')
		!f.close()
		return
	endhandle
	note 1
	handle any
		!f.writerecord('NO NOTE 1 UNDER THE VIEW')
		!f.close()
		return
	endhandle

	-------------------------------------------------------------
	-- what is in there at all, by type                         --
	-------------------------------------------------------------
	!kinds = 'stra texp outl sytm vrtx'
	do !k from 1 to 5
		!kind = !kinds.part(!k)
		!n = 0
		var !things coll all $!kind for ce
		handle any
			!things = object array()
		endhandle
		!n = !things.size()
		!f.writerecord('COUNT ' & !kind & ' = ' & !n.string())
	enddo

	-------------------------------------------------------------
	-- every STRA, with the attributes worth trying             --
	-------------------------------------------------------------
	!satts = object array()
	!satts[1] = 'nlpn'
	!satts[2] = 'nlstyle'
	!satts[3] = 'nlcolour'
	!satts[4] = 'colour'
	!satts[5] = 'purp'
	!satts[6] = 'namn'
	!satts[7] = 'type'

	-------------------------------------------------------------
	-- the user's own filter for the match line straights       --
	-- (2026-08-28): nlstyle 8029 = DChainedThick, nlcolour 16  --
	-- = Magenta. checked here against the unfiltered count     --
	-- above so we know it picks out exactly those and nothing  --
	-- else in the NOTE                                         --
	-------------------------------------------------------------
	note 1
	!mln = 0
	var !mlstras coll all stra with nlstyle eq 8029 and nlcolour eq 16 for ce
	handle any
		!mlstras = object array()
		!f.writerecord('FILTER coll all stra with nlstyle eq 8029 and nlcolour eq 16 -> FAILED')
	elsehandle none
		!mln = !mlstras.size()
		!f.writerecord('FILTER nlstyle 8029 + nlcolour 16 -> ' & !mln.string() & ' stra')
	endhandle

	note 1
	var !stras coll all stra for ce
	handle any
		!stras = object array()
	endhandle
	!si = 0
	do !s values !stras
		!si = !si + 1
		$!s
		handle any
			skip
		endhandle
		do !ai from 1 to !satts.size()
			!a = !satts[!ai]
			!q = 'ERR'
			var !q $!a
			handle any
				!q = 'ERR'
			endhandle
			!f.writerecord('STRA ' & !si.string() & ' ' & !a & ' = ' & !q)
		enddo
		-------------------------------------------------------
		-- the two ends, the way TestDrawList.pmlfrm reads    --
		-- them. wrapped one at a time: a line drawn with     --
		-- fpt/length/adegrees may only have one              --
		-------------------------------------------------------
		!e1 = 'ERR'
		!e1 = !s.dbref().ptfa[1].xypos.string()
		handle any
			!e1 = 'ERR'
		endhandle
		!e2 = 'ERR'
		!e2 = !s.dbref().ptfa[2].xypos.string()
		handle any
			!e2 = 'ERR'
		endhandle
		!f.writerecord('STRA ' & !si.string() & ' ptfa1=' & !e1 & ' ptfa2=' & !e2)
	enddo

	-------------------------------------------------------------
	-- every TEXP, same treatment                               --
	-------------------------------------------------------------
	!tatts = object array()
	!tatts[1] = 'btext'
	!tatts[2] = 'xypos'
	!tatts[3] = 'adegrees'
	!tatts[4] = 'cheitx'
	!tatts[5] = 'txcolour'
	!tatts[6] = 'just'
	!tatts[7] = 'alig'
	!tatts[8] = 'namn'

	note 1
	var !texps coll all texp for ce
	handle any
		!texps = object array()
	endhandle
	!ti = 0
	do !t values !texps
		!ti = !ti + 1
		$!t
		handle any
			skip
		endhandle
		do !ai from 1 to !tatts.size()
			!a = !tatts[!ai]
			!q = 'ERR'
			var !q $!a
			handle any
				!q = 'ERR'
			endhandle
			!f.writerecord('TEXP ' & !ti.string() & ' ' & !a & ' = ' & !q)
		enddo
	enddo

	!f.close()
endfunction

--------------------------------------
-- Function : Flow Arrow Annotation --
-- Auther   : tw tseng              --
-- Date     : 2025/08/15            --
--------------------------------------
define function !!DrawingPlan1FlowAnnotation(!name is string)
	--------------------------------------------------------------------
	-- update path: this LAYE survives from a previous run, so reuse it --
	-- instead of erroring on a duplicate name, the same as ateGRID and --
	-- ateLINE do. the attribute lines below reapply either way         --
	--------------------------------------------------------------------
	$!name/SS/S1/V1/ateFLOW
	handle any
		NEW LAYE $!name/SS/S1/V1/ateFLOW
	elsehandle none
	endhandle
	Purpose FLOW
	Lvisibility true
	Ucode mm  Distance  mm  Bore Nominal 
	Font 1
	Lterminator Off
	Justification Left
	Alignment Base
	Dterminator Arrows
	Tsize 2mm
	Chosht 6mm
	Asubtended 0
	Pjustification Towards 
	Overshoot 2mm
	Plclearance 0mm
	Doffset 25mm
	Dmspacing 0mm
	Cheight 3mm
	Lleader false
	Lframe false
	Lshape Straight
	Gbox 0mm
	Cspacing 0
	Lspacing 0
	Llclearance 0mm
	Xyscale 1 1
	Xyposition 10mm 10mm 
	Bpoffset 0mm 0mm
	Blnk false
	Bmargin 0mm
	Trsf unset
	Fterminator Default
	Pcode mms to 0 dpls  Inches to 1 dpls  Fractions to 32 ths  Angles to 1 dpls 
	NLStyle Solid 
	NLColour Cyan 
	FStyle SolidFilled 
	FColour Cyan 
	Txcolour yellow 
	LLStyle Solid 
	LLColour Cyan 
	LFStyle Solid 
	LFColour Cyan 
	DLStyle Solid 
	DLColour Grey 
	PLStyle Solid 
	PLColour Grey 
	MStyle Off 
	MColour Cyan 
	CHStyle Off 
	CHColour Grey 
	ACDSTY unset
	Posformat ENU
	Grsystem Nulref
	SpPurpose unset
	Function unset

	------------------------------------------------------------------------
	-- the arrows already on the layer, read before anything is drawn. a   --
	-- rebuilt sheet has none; on the update path they are last run's      --
	--                                                                     --
	-- an arrow does not ride with its pipe. its POS is a point in the     --
	-- model, written when the arrow was placed, and it stays there when   --
	-- the tube under it is moved: after 40-B-10 was moved 100mm in the    --
	-- model its arrow was left standing on the empty sheet beside the new --
	-- run (user, 2026-09-18). XYPO is 0 0 and OSET makes no difference to --
	-- that, the design point itself is what does not move                 --
	--                                                                     --
	-- so every arrow is measured against the tubes of this run, in the    --
	-- branch loop below: one which still stands on a visible run of its   --
	-- branch, points the way that run flows, and is clear of the arrows   --
	-- placed before it, is kept exactly as it is -- not one attribute     --
	-- written, so the DXF the revision compares comes out identical for   --
	-- it, the same rule as the pinned component labels -- and whatever is --
	-- left unclaimed at the bottom is deleted there                        --
	--                                                                     --
	-- where an arrow stands is shpos of its POS: with XYPO 0 0 the symbol --
	-- is drawn on the design point itself. a SLAB does not answer shpos   --
	-- of its own (see DrawingPlan1GridAnnotation)                         --
	--                                                                     --
	-- an arrow whose DDNA no longer resolves is never kept: a label whose --
	-- design element is gone is not drawn, so keeping it would leave the  --
	-- branch with no arrow on the paper while this code believed it had   --
	-- one. it is deleted and the branch gets a fresh one. the read-back   --
	-- goes to check_flow.txt, one FLOWEX line per arrow, so that a DDNA   --
	-- which reads back in a shape 'type of' cannot take can be seen       --
	------------------------------------------------------------------------
	!dbgok = true
	!dbgf = object file('L:\E3D\pdms_prog\E3D2.1\PA_pmllibE3D2.1\check_flow.txt')
	!dbgf.open('overwrite')
	handle any
		!dbgok = false
	endhandle
	if (!dbgok) then
		!dbgf.writerecord('FLOWRUN ' & !name)
	endif
	!exrefs = object array()
	!exsx = object array()
	!exsy = object array()
	!exang = object array()
	!exlives = object array()
	!exclaim = object array()
	!exslabs = object array()
	var !exslabs coll all slab for ce
	handle any
		!exslabs = object array()
	endhandle
	do !exsl values !exslabs
		!exok = true
		$!exsl
		handle any
			!exok = false
		endhandle
		skip if (not(!exok))
		var !exref ref
		!exddna = ''
		var !exddna ddna
		handle any
			!exddna = ''
		endhandle
		!expos = ''
		var !expos pos
		handle any
			!expos = ''
		endhandle
		!exadeg = '0'
		var !exadeg adeg
		handle any
			!exadeg = '0'
		endhandle
		!exlive = true
		!exdt = ''
		var !exdt type of $!exddna
		handle any
			!exlive = false
		endhandle
		!exsh = ''
		var !exsh shpos of $!expos
		handle any
			!exlive = false
		endhandle
		!exshx = 0
		!exshy = 0
		!exshx = !exsh.part(2).replace('mm', '').real()
		handle any
			!exlive = false
		endhandle
		!exshy = !exsh.part(4).replace('mm', '').real()
		handle any
			!exlive = false
		endhandle
		!exadegv = 0
		!exadegv = !exadeg.real()
		handle any
			!exlive = false
		endhandle
		!exrefs.append(!exref)
		!exsx.append(!exshx)
		!exsy.append(!exshy)
		!exang.append(!exadegv)
		!exlives.append(!exlive)
		!exclaim.append(false)
		if (!dbgok) then
			!dbgf.writerecord('FLOWEX ' & !exref & ' ddna=' & !exddna & ' type=' & !exdt & ' pos=' & !expos & ' sh=' & !exsh & ' adeg=' & !exadeg & ' live=' & string(!exlive))
		endif
	enddo
	--------------------------------------------------------------------
	-- back on the layer, where NEW SLAB below has to be made           --
	--------------------------------------------------------------------
	$!name/SS/S1/V1/ateFLOW

	------------------------------------------------
	-- sort !tubiss by how much of the tube shows --
	------------------------------------------------
	using namespace 'Aveva.Core.Samples'
	!obj = object AteSortLineNo()
	------------------------------------------------------------------------
	-- the tubes are gathered branch by branch, not pipe by pipe           --
	--                                                                     --
	-- the scan hands back branches, but the gathering used to be done on  --
	-- the name of the pipe, so every branch of a pipe picked up the whole --
	-- pipe again, settled on the same longest tube of the lot and laid    --
	-- another arrow on the very same spot. a pipe with three branches got --
	-- three arrows stacked on one run and nothing at all on the other     --
	-- two, however far they ran across the drawing                        --
	--                                                                     --
	-- taking one branch at a time gets rid of the stack and covers every  --
	-- run, because each branch settles on the longest tube it has of its  --
	-- own and those are in different places                               --
	------------------------------------------------------------------------
	var !brans vscan for all bran
	------------------------------------------------------------------------
	-- the rectangle of the view in sheet coordination, which is where the --
	-- visible run of each tube is worked out. the same four numbers as    --
	-- DrawingPlan1LineNoAnnotation takes                                  --
	------------------------------------------------------------------------
	!vwx1 = min(!!DrawingPlan1.boxLLsh.part(2).real(), !!DrawingPlan1.boxURsh.part(2).real())
	!vwx2 = max(!!DrawingPlan1.boxLLsh.part(2).real(), !!DrawingPlan1.boxURsh.part(2).real())
	!vwy1 = min(!!DrawingPlan1.boxLLsh.part(4).real(), !!DrawingPlan1.boxURsh.part(4).real())
	!vwy2 = max(!!DrawingPlan1.boxLLsh.part(4).real(), !!DrawingPlan1.boxURsh.part(4).real())
	------------------------------------------------------------------------
	-- the branches are worked from the top of the plant downwards, and    --
	-- where two of them sit at the same elevation the one with more of    --
	-- itself on show goes first                                           --
	--                                                                     --
	-- whoever is placed first gets the room. where two pipes cross or run --
	-- side by side on a plan they are often at different elevations, and  --
	-- the one underneath is the one the reader cannot see properly, so    --
	-- the higher pipe keeps the open spot on its run and the lower one is --
	-- pushed along its own pipe to wherever there is room left            --
	--                                                                     --
	-- elevation on its own is not enough. four branches off the same      --
	-- nozzle bank came back at exactly 101076 and the order between them  --
	-- fell to the order they were scanned in, which is to say chance, so  --
	-- which of them lost its arrow was chance as well. the length on show --
	-- settles it instead: a long run is the more telling place to put an  --
	-- arrow, so the short spool is the one which gives way                --
	--                                                                     --
	-- the elevation is taken from the head of the branch. only tubes      --
	-- which lie near flat are ever annotated, so a branch does not wander --
	-- far in elevation from its head, and this only has to be good enough --
	-- to say which of two pipes is on top                                 --
	------------------------------------------------------------------------
	------------------------------------------------------------------------
	-- a run of pipe shorter than !minrun on the sheet is not offered an   --
	-- arrow at all. the arrow is about 10mm of the sheet long, so on a    --
	-- stub which only shows for 3mm it comes out several times the length --
	-- of the pipe it belongs to and points at nothing in particular       --
	--                                                                     --
	-- this is what all the crowding round the nozzles really was. of the  --
	-- fourteen branches in the view seven showed for 11mm or more and     --
	-- seven for 5mm or less, with nothing in between, and every arrow     --
	-- which had to be shoved about or given up was one of the short ones. --
	-- once they are left out the seven which remain are 28mm apart at     --
	-- their closest, so !mindist and !hardmin below never come into it    --
	--                                                                     --
	-- they are kept all the same. another drawing, or another scale, can  --
	-- still bring two long runs alongside each other                      --
	------------------------------------------------------------------------
	!minrun = 10
	!minrun2 = !minrun * !minrun
	!bU = object array()
	!bR = object array()
	!bRef = object array()
	do !bran values !brans
		--------------------------------------------------------------------
		-- the scan hands the branch back as 'BRAN =2013286676/2167', the --
		-- type in front of the reference, the same way it hands tubes    --
		-- back as 'TUBI /COMP'. the reference on its own is what an      --
		-- attribute query wants, so it is taken off the front here, the  --
		-- same as !tubis[!tt].part(2) does further down                  --
		--                                                                --
		-- the whole string went to hpos before, every query fell into    --
		-- its handle and every branch came out at elevation nought, so   --
		-- the order was really just scan order and the higher pipe was   --
		-- not being placed first at all                                  --
		--------------------------------------------------------------------
		!branref = !bran.part(2)
		if (!branref.eq('')) then
			!branref = !bran
		endif
		!hp = ''
		var !hp hpos of $!branref
		handle any
		endhandle
		!branu = 0
		if (!hp.neq('')) then
			----------------------------------------------------------------
			-- read straight off the string and stripped of mm, the same   --
			-- as ltle and shpos are handled everywhere else here. going   --
			-- through position().up hands back a real with its unit still --
			-- on it, and the unit rode into the key                       --
			--                                                             --
			-- hpos reads 'E 306000mm N 303594mm U 102930mm', so part 6 is --
			-- the elevation and part 5 says which way. below datum it     --
			-- comes out as D and has to be turned negative by hand        --
			----------------------------------------------------------------
			!branu = !hp.part(6).replace('mm', '').real()
			handle any
				!branu = 0
			endhandle
			if (!hp.part(5).eqnocase('D')) then
				!branu = !branu * -1
			endif
		endif
		--------------------------------------------------------------------
		-- the longest run this branch has inside the view, squared. it is --
		-- only ever compared with another one of the same kind, so the    --
		-- square root is never wanted                                     --
		--                                                                 --
		-- this walks the tubes of the branch a second time, once here to  --
		-- work out the order and once again below to place the arrow. the --
		-- database work is doubled and that was accepted for the sake of  --
		-- getting the order right                                         --
		--------------------------------------------------------------------
		!branrun = 0
		!tubis = object array()
		var !tubis vscan for all tubi for $!bran
		handle any
		endhandle
		if defined(!tubis) then
			do !tt from 1 to !tubis.size()
				!tubi = 'ileave tube of ' & !tubis[!tt].part(2)
				var !grad gradient of $!tubi
				handle any
				elsehandle none
					if (abs(!grad.real()) leq 1) then
						!seen = !!DrawingPlan1.VisibleSheetRunOfTube(!tubi, !vwx1, !vwy1, !vwx2, !vwy2)
						if (not(!seen.empty())) then
							----------------------------------------------------
							-- the true longest run, with no !minrun test on   --
							-- it. this number only settles the order, and a   --
							-- branch with nothing long enough finds no        --
							-- candidate when its turn comes anyway, so there  --
							-- is nothing to gain by zeroing it here           --
							--                                                 --
							-- what is lost by zeroing it is the report. with  --
							-- the test in, every branch left out came back as --
							-- run2 0 and there was no way to see how short it --
							-- really was, which is the one number wanted when --
							-- deciding where to put !minrun                   --
							----------------------------------------------------
							if (!seen[1] gt !branrun) then
								!branrun = !seen[1]
							endif
						endif
					endif
				endhandle
			enddo
		endif
		!bU.append(!branu)
		!bR.append(!branrun)
		!bRef.append(!bran)
	enddo
	------------------------------------------------------------------------
	-- put in order by hand rather than through AteSortLineNo. that sort   --
	-- takes one number, so elevation and length would have to be packed   --
	-- into a single key: elevation runs to six figures, and multiplying   --
	-- it up to leave room for the length underneath pushes the key out to --
	-- the end of what a real can hold and into the shape which comes back --
	-- as 1E12 and cannot be read as a number. two fields compared plainly --
	-- have none of that, no packing, no keys which have to be kept apart  --
	--                                                                     --
	-- a plain selection sort. there are tens of branches in a view and    --
	-- the comparing is nothing beside the database work above             --
	------------------------------------------------------------------------
	!ord = object array()
	do !i from 1 to !bU.size()
		!ord.append(!i)
	enddo
	----------------------------------------------------------------------
	-- guarded the same way DrawingPlan1LineNoAnnotation guards its own  --
	-- 'to !mcount - 1' loop, so that a view holding one branch or none  --
	-- never reaches a loop counting up to nought                        --
	----------------------------------------------------------------------
	if (!ord.size() gt 1) then
		do !i from 1 to !ord.size() - 1
			!pick = !i
			do !j from !i + 1 to !ord.size()
				!a = !ord[!j]
				!b = !ord[!pick]
				!ahead = false
				if (!bU[!a] gt !bU[!b]) then
					!ahead = true
				elseif (!bU[!a] eq !bU[!b] and !bR[!a] gt !bR[!b]) then
					!ahead = true
				endif
				if (!ahead) then
					!pick = !j
				endif
			enddo
			if (!pick neq !i) then
				!tmp = !ord[!i]
				!ord[!i] = !ord[!pick]
				!ord[!pick] = !tmp
			endif
		enddo
	endif
	------------------------------------------------------------------------
	-- two branches which run side by side, a pair of drops off the same   --
	-- equipment for instance, settle on runs which are only a few mm      --
	-- apart on the sheet and their arrows end up touching                 --
	--                                                                     --
	-- !usedx / !usedy are where the arrows have gone so far, and every    --
	-- new one tries to keep !mindist of the sheet away from all of them.  --
	-- !fracs are the places along a run to try, the middle first and then --
	-- out towards the ends, so an arrow slides along its own tube to get  --
	-- clear rather than jumping off it. sliding keeps the arrow on the    --
	-- pipe it belongs to, which is the whole point of it                  --
	--                                                                     --
	-- !mindist is the one number to turn when the arrows come out too     --
	-- close or too scattered. it is centre to centre in mm of the sheet,  --
	-- and it has to be well clear of the length of the arrow itself, not  --
	-- merely equal to it, or two of them sit a gap of half an arrow apart --
	-- and still read as one mark. the reach goes out to a twentieth of    --
	-- the run at either end, which is as far as an arrow can go and still --
	-- read as belonging to that run                                       --
	--                                                                     --
	-- turning !mindist up is safe. when nothing on a branch can meet it   --
	-- the roomiest place found is taken instead, so a large value never   --
	-- loses an arrow, it only makes more of them go the roomiest way. a   --
	-- pipe on its own is not pushed about either: with no arrow down yet  --
	-- every place scores the same and the first one tried, the middle of  --
	-- the longest run, is the one kept                                    --
	------------------------------------------------------------------------
	!mindist = 20
	!mindist2 = !mindist * !mindist
	------------------------------------------------------------------------
	-- !hardmin is where giving the branch an arrow stops being worth it.  --
	-- a pair of short spools off two nozzles, one above the other, run    --
	-- along the very same line on a plan, and neither one is long enough  --
	-- to slide an arrow clear of the other. sliding cannot help and       --
	-- moving to another tube cannot help, because there is no other tube  --
	--                                                                     --
	-- the branches are worked from the top of the plant downwards, so     --
	-- whatever is already down belongs to the pipe above, the one the     --
	-- reader can actually see. the pipe underneath gives way and goes     --
	-- without, which is better than a second arrow smudged over the first --
	--                                                                     --
	-- this only bites when nowhere on the whole branch reaches !hardmin.  --
	-- everything with room to breathe still gets its arrow, so a pipe is  --
	-- only ever left out where an arrow could not have been read anyway   --
	------------------------------------------------------------------------
	!hardmin = 10
	!hardmin2 = !hardmin * !hardmin
	------------------------------------------------------------------------
	-- which symbol the arrow is drawn from, and how big. both come off    --
	-- the FlowArrow tab of the form, and both are read once here rather   --
	-- than per branch: they cannot change while this runs, and a bad name --
	-- is then reported once instead of once for every pipe in the view    --
	--                                                                     --
	-- the WELD-ARR below is what this function drew before the tab        --
	-- existed, so it stays as the fallback: an empty field, a name which  --
	-- is not there any more (a save file can outlive the symbol it        --
	-- names), or an older copy of the form still cached in memory with no --
	-- .flowtext member at all, all draw what they always drew instead of  --
	-- killing the whole annotation run                                    --
	------------------------------------------------------------------------
	!flowsytm = '/DRA/MAS/SYMBOLS/GEN/WELD/WELD-ARR'
	!formsytm = ''
	!formsytm = !!DrawingPlan1.flowtext.val
	handle any
		!formsytm = ''
	endhandle
	!formsytm = !formsytm.trim()
	if (!formsytm.neq('')) then
		!sytmok = false
		var !sytmtype type of $!formsytm
		handle any
		elsehandle none
			!sytmok = !sytmtype.eqnocase('SYTM')
		endhandle
		if (!sytmok) then
			!flowsytm = !formsytm
		else
			!!alert.warning('Flow Arrow ' & !formsytm & ' is not a SYTM in this project. The default arrow has been used instead.')
		endif
	endif
	------------------------------------------------------------------------
	-- Scale is how big the symbol is drawn, 1 being the size the SYTM     --
	-- itself was drawn at. an empty or nonsense field falls back to 1     --
	-- rather than shrinking every arrow in the view to nothing, the same  --
	-- way the north arrow guards its own Scale                            --
	------------------------------------------------------------------------
	!flowsca = 1
	!formsca = !!DrawingPlan1.flowsca.val
	handle any
		!formsca = 1
	endhandle
	if (not(!formsca.unset())) then
		!flowsca = !formsca
	endif
	if (!flowsca le 0) then
		!flowsca = 1
	endif
	------------------------------------------------------------------------
	-- how long the arrow is on the sheet, and how far clear of the ends   --
	-- of its visible run it has to stay, mm of the sheet                  --
	--                                                                     --
	-- the symbol is drawn from its tail: the point an arrow is placed at  --
	-- is where the feathers are, and it reaches forwards from there the   --
	-- way the pipe flows, which is from the first end of the tube to the --
	-- second, seen[4..5] to seen[6..7]. only the tail used to be kept     --
	-- inside the run, so an arrow slid to the far end of a short run      --
	-- beside the border was drawn out past the view (user, 2026-09-25:   --
	-- 50-B-9, 12.8mm of run, slid to 0.95 to get clear of its neighbour, --
	-- feathers 0.6mm inside the border and all of the head outside it)  --
	--                                                                     --
	-- WELD-ARR at Scale 1 came out 7.2 to 7.5mm long on that sheet (tails --
	-- 20.35mm apart in check_flow.txt were 62px apart on the screenshot), --
	-- so 8 per unit of Scale. E3D has no attribute giving the size a      --
	-- symbol comes out at; another symbol on the FlowArrow tab may want a --
	-- different number here. !minrun, 10, still leaves room for it: a run --
	-- long enough to be offered an arrow is long enough to hold one      --
	------------------------------------------------------------------------
	!alen = 8 * !flowsca
	!amarg = 0.5
	------------------------------------------------------------------------
	-- turn !dbg on to have every branch report where its arrow went, in   --
	-- the command window. that is the quickest way to tell a pair which   --
	-- really is too close from a pair which only looks it. the same lines --
	-- go to check_flow.txt whatever !dbg says, with KEPT / PLACED on each  --
	-- so that an update can be checked without the command window         --
	------------------------------------------------------------------------
	!dbg = false
	!usedx = object array()
	!usedy = object array()
	!fracs = object array()
	!fracs.append(0.5)
	!fracs.append(0.35)
	!fracs.append(0.65)
	!fracs.append(0.2)
	!fracs.append(0.8)
	!fracs.append(0.1)
	!fracs.append(0.9)
	!fracs.append(0.05)
	!fracs.append(0.95)
	!tubiss = object array()
	--------------------------------------------------------------------------
	-- the two directions every arrow angle is measured against. they are   --
	-- the view's, not the tube's, so they are read once here (CE is on the --
	-- layer, inside the view) instead of once per arrow                    --
	--------------------------------------------------------------------------
	var !viewdirup viewdir up
	var !viewdirri viewdir right
	!viewdirupa = object direction(!viewdirup)
	!viewdirria = object direction(!viewdirri)
	--------------------------------------------------------------------------
	-- how far off a tube's visible run an arrow may stand and still count  --
	-- as riding on it, in mm of the sheet, and how far off the angle. the  --
	-- run is worked out again from the model on every call, and the box    --
	-- corners it is cut against come down a different chain of arithmetic  --
	-- on the update path than on the rebuild path, so an arrow on a pipe   --
	-- that never moved can still come out a hair off where it was put. a   --
	-- pipe moved by less than 0.2mm of the sheet (6mm of the model at      --
	-- 1:30) keeps its arrow, which is nowhere near visible on a pipe drawn --
	-- over a millimetre wide                                                --
	--------------------------------------------------------------------------
	!ontol2 = 0.2 * 0.2
	!angtol = 0.5
	--------------------------------------------------------------------------
	-- forwards, because !ord is already highest first                       --
	--------------------------------------------------------------------------
	do !oo from 1 to !ord.size()
		!bb = !ord[!oo]
		!bran = !bRef[!bb]
		--------------------------------------------------------------------
		-- emptied first, so that a branch which cannot be scanned is left --
		-- out instead of being given the tubes of the branch before it,   --
		-- and so that the error does not stop every branch after it       --
		--------------------------------------------------------------------
		!tubis = object array()
		var !tubis vscan for all tubi for $!bran
		handle any
		endhandle
		!tubiss.clear()
		if defined(!tubis) then
			do !tt from 1 to !tubis.size()
				!tubi = 'ileave tube of ' & !tubis[!tt].part(2)
				---------------------------
				-- exclude vertical pipe --
				---------------------------
				var !grad gradient of $!tubi
				handle any
				elsehandle none
					if (abs(!grad.real()) leq 1) then
						------------------------------------------------------------
						-- the tubes are ranked on how much of them can be seen,  --
						-- not on ltle. ltle is the length in the model, and the  --
						-- longest tube of a pipe is very often one which runs    --
						-- mostly or wholly outside the view. the drawlist of the --
						-- view holds whole pipes, so the scan above hands those  --
						-- back just the same, and the arrow was then either put  --
						-- down out on the empty sheet or squeezed onto the       --
						-- border where the little that shows of the tube is      --
						--                                                        --
						-- a tube with nothing inside the view is left out here,  --
						-- and so is one which shows for less than !minrun, so   --
						-- neither can win                                        --
						------------------------------------------------------------
						!seen = !!DrawingPlan1.VisibleSheetRunOfTube(!tubi, !vwx1, !vwy1, !vwx2, !vwy2)
						if (not(!seen.empty())) then
							if (!seen[1] geq !minrun2) then
								----------------------------------------------------
								-- !seen[1] is the visible run squared. it is only --
								-- ever a ranking key, never a length             --
								--                                                --
								-- scaled up and the count added whole, for the   --
								-- same reason as the branch key above. a tube    --
								-- which comes out as a single point on the sheet --
								-- has nothing squared to nothing, and nought     --
								-- plus a tiny fraction is the kind of number the --
								-- sort cannot read back                          --
								----------------------------------------------------
								!seenkey = !seen[1] * 1000 + !tt
								!tubiss.append(!seenkey & '~' & !tubi & '~x!x!x!x!x!x')
							endif
						endif
					endif
				endhandle
			enddo
			if (not(!tubiss.empty())) then
				------------------------------------------------------------------
				-- the tubes of this branch, longest visible run first           --
				------------------------------------------------------------------
				!sorted = !obj.method('y', !tubiss)
				------------------------------------------------------------------
				-- where each tube shows on the sheet and which way its arrow   --
				-- has to point, worked out once here and read twice below: by  --
				-- the keeping test and by the placing. the angle used to be    --
				-- worked out after the tube was chosen; the keeping test needs --
				-- it before, for every tube it tries                           --
				--                                                               --
				-- angle() only ever hands back 0 to 180, so the angle to the   --
				-- top of the sheet says how far the pipe leans over but not    --
				-- which way it leans. which way is settled by the angle to the --
				-- right of the sheet: under 90 the pipe points to the right    --
				-- and the symbol has to turn clockwise, which is the negative  --
				-- way round for ADEGREES                                       --
				--                                                               --
				-- the test used to be against 40 rather than 90. that came out --
				-- right for the four square directions, which is most of the   --
				-- piping and is why it went unnoticed, but a sloping pipe      --
				-- leaning to the left came out mirrored, and one running       --
				-- downwards to either side came out turned right round, with   --
				-- the arrow against the flow                                   --
				--                                                               --
				-- the angle so far is the angle the arrow has to lie at on the --
				-- sheet. viewdir up and viewdir right are the model directions --
				-- which appear to point up and right on the sheet, so they     --
				-- already follow the rcode, and the angle between them and the --
				-- pipe is a sheet angle                                        --
				--                                                               --
				-- ADEGREES of the symbol is not read on the sheet though, it   --
				-- is read in the view. Portrait to Landscape puts RCODE LEFT   --
				-- on the view, which turns the view 90 degrees anticlockwise   --
				-- on the sheet, and the two differ by that much. the same 90   --
				-- degrees is taken off the grid symbols in .CreateGridSymbol(), --
				-- which is where this was first met                            --
				--                                                               --
				-- XYPO stays 0 0 and needs no turning, unlike the XYPO and     --
				-- APOF of the grid symbols, and POS is not touched either      --
				------------------------------------------------------------------
				!seens = object array()
				!tangs = object array()
				do !ii from 1 to !sorted.size()
					!trytubi = !sorted[!ii].split('~').getindexed(2)
					!seen = !!DrawingPlan1.VisibleSheetRunOfTube(!trytubi, !vwx1, !vwy1, !vwx2, !vwy2)
					!seens[!ii] = !seen
					!mtbe = !trytubi.after('of ')
					var !type type of $!mtbe
					if (!type.eqnocase('BRAN')) then
						var !pldir hdir of $!mtbe
					else
						var !pldir pl dir of $!mtbe
					endif
					!pldira = object direction(!pldir)
					!tang = !viewdirupa.angle(!pldira)
					if (!viewdirria.angle(!pldira).lt(90)) then
						!tang = !tang * -1
					endif
					if (!!DrawingPlan1.rcode.eqnocase('left')) then
						!tang = !tang - 90
						if (!tang lt -180) then
							!tang = !tang + 360
						endif
					endif
					!tangs[!ii] = !tang
				enddo
				------------------------------------------------------------------
				-- first, is one of last run's arrows still riding on this      --
				-- branch? one which stands on a visible run of one of its      --
				-- tubes (its foot on the run within !ontol2, between the two    --
				-- ends), points the way that run flows, and is still !hardmin  --
				-- clear of the arrows placed before it this run, is kept       --
				-- exactly as it is. it is not moved back to the middle of the  --
				-- longest run either: an arrow that was slid along its pipe to --
				-- make room last time stays slid, and a pipe that was only     --
				-- stretched keeps its arrow where it was. either would be a    --
				-- cloud on the next revision for nothing -- the pipe is where  --
				-- the arrow says it is                                          --
				--                                                               --
				-- !hardmin rather than !mindist: an arrow that far from the    --
				-- others is one the placing below would have settled for      --
				-- itself, so it is left alone. only when it is closer than     --
				-- that -- an arrow of a higher pipe has landed on it this run  --
				-- -- does the branch go through the placing again              --
				------------------------------------------------------------------
				!gotpos = false
				!kept = false
				!keptref = ''
				!tubi = ''
				!posx = 0
				!posy = 0
				!ang = 0
				do !ii from !sorted.size() to 1 by -1
					!seen = !seens[!ii]
					skip if (!seen.empty())
					!rx = !seen[6] - !seen[4]
					!ry = !seen[7] - !seen[5]
					!rl2 = !rx * !rx + !ry * !ry
					skip if (!rl2 le 0)
					!rl = !rl2.sqrt()
					!tang = !tangs[!ii]
					do !ci from 1 to !exrefs.size()
						skip if (!exclaim[!ci])
						skip if (not(!exlives[!ci]))
						!ax = !exsx[!ci]
						!ay = !exsy[!ci]
						!t = ((!ax - !seen[4]) * !rx + (!ay - !seen[5]) * !ry) / !rl2
						skip if (!t lt 0 or !t gt 1)
						!qx = !seen[4] + !t * !rx
						!qy = !seen[5] + !t * !ry
						!d2 = (!ax - !qx) * (!ax - !qx) + (!ay - !qy) * (!ay - !qy)
						skip if (!d2 gt !ontol2)
						--------------------------------------------------------
						-- and its head inside the view: one put down before  --
						-- 2026-09-25 at the far end of a short run by the    --
						-- border reaches out past it (see !alen), and goes   --
						-- through the placing again. only the view is tested --
						-- here, not the run: a head over the fitting at the  --
						-- end of its tube is still on the drawing, and      --
						-- moving it would be a cloud on the revision for     --
						-- nothing                                            --
						--------------------------------------------------------
						!hx = !ax + !alen * !rx / !rl
						!hy = !ay + !alen * !ry / !rl
						skip if (!hx lt !vwx1 - !amarg or !hx gt !vwx2 + !amarg)
						skip if (!hy lt !vwy1 - !amarg or !hy gt !vwy2 + !amarg)
						--------------------------------------------------------
						-- the two angles can be on either side of the wrap:  --
						-- ADEGREES reads back in whichever range E3D keeps   --
						-- it, and !tang runs -180 to 180. one step of 360    --
						-- brings the difference into -180 to 180 either way  --
						--------------------------------------------------------
						!da = !exang[!ci] - !tang
						if (!da gt 180) then
							!da = !da - 360
						elseif (!da lt -180) then
							!da = !da + 360
						endif
						!ada = abs(!da)
						skip if (!ada gt !angtol)
						!near2 = 999999999
						do !uu from 1 to !usedx.size()
							!dd2 = (!ax - !usedx[!uu]) * (!ax - !usedx[!uu]) + (!ay - !usedy[!uu]) * (!ay - !usedy[!uu])
							if (!dd2 lt !near2) then
								!near2 = !dd2
							endif
						enddo
						skip if (!near2 lt !hardmin2)
						!exclaim[!ci] = true
						!kept = true
						!gotpos = true
						!keptref = !exrefs[!ci]
						!tubi = !sorted[!ii].split('~').getindexed(2)
						!posx = !ax
						!posy = !ay
						!ang = !tang
						break
					enddo
					break if (!kept)
				enddo
				!tookbest = false
				!dropped = false
				!bestset = false
				!bestd = -1
				!bestx = 0
				!besty = 0
				!besttubi = ''
				!bestang = 0
				if (not(!kept)) then
					do !ii from !sorted.size() to 1 by -1
						!trytubi = !sorted[!ii].split('~').getindexed(2)
						!seen = !seens[!ii]
						------------------------------------------------------------
						-- the tail may go anywhere from !amarg past the first   --
						-- end of the run to !alen + !amarg short of the second, --
						-- so the whole arrow lies on the run and so inside the  --
						-- view. each place tried is pulled into that stretch:  --
						-- on a run of 17mm and more the middle, which is tried --
						-- first, is already in it and nothing moves; on a     --
						-- shorter one the tail is drawn back until the head    --
						-- fits. a run with no such stretch at all, only with a --
						-- Scale well over 1, is passed over                    --
						------------------------------------------------------------
						!fitok = false
						if (not(!seen.empty())) then
							!frx = !seen[6] - !seen[4]
							!fry = !seen[7] - !seen[5]
							!frl2 = !frx * !frx + !fry * !fry
							if (!frl2 gt 0) then
								!frl = !frl2.sqrt()
								!smin = !amarg
								!smax = !frl - !alen - !amarg
								if (!smax geq !smin) then
									!fitok = true
								endif
							endif
						endif
						if (!fitok) then
							do !ff from 1 to !fracs.size()
								!s = !fracs[!ff] * !frl
								if (!s lt !smin) then
									!s = !smin
								elseif (!s gt !smax) then
									!s = !smax
								endif
								!px = !seen[4] + (!s / !frl) * !frx
								!py = !seen[5] + (!s / !frl) * !fry
								----------------------------------------------------
								-- how far this spot is from the nearest arrow    --
								-- already down, squared to keep clear of sqrt.   --
								-- nothing down yet leaves it at the large value, --
								-- so the first arrow of the drawing takes the    --
								-- middle of its longest run                      --
								----------------------------------------------------
								!near2 = 999999999
								do !uu from 1 to !usedx.size()
									!d2 = (!px - !usedx[!uu]) * (!px - !usedx[!uu]) + (!py - !usedy[!uu]) * (!py - !usedy[!uu])
									if (!d2 lt !near2) then
										!near2 = !d2
									endif
								enddo
								if (!near2 geq !mindist2) then
									--------------------------------------------
									-- far enough from everything, take it     --
									--------------------------------------------
									!tubi = !trytubi
									!posx = !px
									!posy = !py
									!ang = !tangs[!ii]
									!gotpos = true
									break
								elseif (!near2 gt !bestd) then
									--------------------------------------------
									-- not clear, but the roomiest place found --
									-- so far. kept in case nothing on this    --
									-- branch comes out clear                  --
									--------------------------------------------
									!bestd = !near2
									!bestx = !px
									!besty = !py
									!besttubi = !trytubi
									!bestang = !tangs[!ii]
									!bestset = true
								endif
							enddo
						endif
						break if (!gotpos)
					enddo
					if (not(!gotpos) and !bestset) then
						if (!bestd geq !hardmin2) then
							--------------------------------------------------------
							-- nowhere on this branch is a full !mindist clear of  --
							-- the arrows already down, which is what happens round --
							-- a set of nozzles where short stubs run side by side. --
							-- the roomiest of the places tried is taken, so the    --
							-- arrow is pushed as far off the others as this branch --
							-- allows                                               --
							--                                                      --
							-- this used to fall back on the middle of the longest  --
							-- run instead, which is the crowded spot itself, and   --
							-- that is why the arrows came out touching             --
							--                                                      --
							-- the roomiest place can be on a shorter tube than the --
							-- longest one. an arrow on a shorter run of the right  --
							-- pipe reads better than two arrows on top of each     --
							-- other                                                --
							--------------------------------------------------------
							!tubi = !besttubi
							!posx = !bestx
							!posy = !besty
							!ang = !bestang
							!gotpos = true
							!tookbest = true
						else
							--------------------------------------------------------
							-- even the roomiest place on the branch is right on   --
							-- top of an arrow already down. this is the pipe       --
							-- underneath a pipe which runs the same line on the    --
							-- plan, and it goes without. see !hardmin above        --
							--------------------------------------------------------
							!dropped = true
						endif
					endif
				endif
				----------------------------------------------------------
				-- elevation and run come straight out of the two arrays --
				-- the order was worked out from, so what is reported is --
				-- exactly what decided this branch's turn               --
				--                                                        --
				-- how far the arrow really ended up from its nearest     --
				-- neighbour is worked out again on the place settled on, --
				-- so the number reported is the one on the sheet         --
				--                                                        --
				-- to check_flow.txt always, to the command window only   --
				-- with !dbg. the file is what tells a kept arrow from a  --
				-- placed one after an update                             --
				----------------------------------------------------------
				!branudbg = !bU[!bb]
				!brandbg = !bR[!bb]
				!bestlabel = 'no'
				if (!tookbest) then
					!bestlabel = 'yes'
				endif
				!dbgnear = 999999999
				if (!gotpos) then
					do !uu from 1 to !usedx.size()
						!d2 = (!posx - !usedx[!uu]) * (!posx - !usedx[!uu]) + (!posy - !usedy[!uu]) * (!posy - !usedy[!uu])
						if (!d2 lt !dbgnear) then
							!dbgnear = !d2
						endif
					enddo
					if (!kept) then
						!dbgline = 'FLOWDBG ' & !bran & ' u ' & string(!branudbg) & ' run2 ' & string(!brandbg) & ' x ' & string(!posx) & ' y ' & string(!posy) & ' near2 ' & string(!dbgnear) & ' KEPT ' & !keptref & ' on ' & !tubi
					else
						!dbgline = 'FLOWDBG ' & !bran & ' u ' & string(!branudbg) & ' run2 ' & string(!brandbg) & ' x ' & string(!posx) & ' y ' & string(!posy) & ' near2 ' & string(!dbgnear) & ' roomiest ' & !bestlabel & ' PLACED on ' & !tubi
					endif
				elseif (!dropped) then
					!dbgline = 'FLOWDBG ' & !bran & ' u ' & string(!branudbg) & ' run2 ' & string(!brandbg) & ' DROPPED, best near2 ' & string(!bestd)
				else
					!dbgline = 'FLOWDBG ' & !bran & ' u ' & string(!branudbg) & ' run2 ' & string(!brandbg) & ' NO PLACE'
				endif
				if (!dbgok) then
					!dbgf.writerecord(!dbgline)
				endif
				if (!dbg) then
					$p $!dbgline
				endif
				if (!gotpos) then
					!usedx.append(!posx)
					!usedy.append(!posy)
					if (not(!kept)) then
						------------------------------------------------------------------
						-- the arrow goes on the visible run and not in the middle of    --
						-- the whole tube, so it is always inside the view and never out --
						-- on the border. the place comes back in sheet mm and is handed --
						-- to enupos the same way the line number annotation does it,    --
						-- which also takes the E / N / W / S of a position string out   --
						-- of the way                                                    --
						------------------------------------------------------------------
						!midsh = 'x ' & string(!posx) & ' y ' & string(!posy)
						var !mid1 enupos of $!midsh
						NEW SLAB
						DDNA $!tubi
						tmrf $!flowsytm
						Font 1
						Blnk false
						Bmargin 0mm
						Xyscale $!flowsca $!flowsca
						Cheitx '2mm'
						Lvisibility true
						Txcolour Yellow
						LLColour Cyan
						LFColour Cyan
						Alignment Hbody
						POS $!mid1
						XYPO 0 0
						Adegrees $!ang
					endif
				endif
			else
				----------------------------------------------------------------
				-- nothing on this branch shows for !minrun or more, so it is  --
				-- not offered an arrow at all and never reaches the placing   --
				-- above. reported here so that a branch left out for being    --
				-- too short can be told apart from one left out for being     --
				-- crowded                                                     --
				----------------------------------------------------------------
				!dbgline = 'FLOWDBG ' & !bran & ' u ' & string(!bU[!bb]) & ' run2 ' & string(!bR[!bb]) & ' NO RUN reaches minrun'
				if (!dbgok) then
					!dbgf.writerecord(!dbgline)
				endif
				if (!dbg) then
					$p $!dbgline
				endif
			endif
		endif
	enddo
	------------------------------------------------------------------------
	-- last run's arrows that no branch kept this time: the pipe moved out --
	-- from under them, turned round, left the view, or was cut back below --
	-- !minrun -- and the ones whose design element is gone. deleted only  --
	-- now, after every branch has had its turn, so that no arrow is in    --
	-- !usedx while it is on its way out and no branch is kept off a spot  --
	-- that is about to be empty. on a rebuilt sheet there is nothing here --
	------------------------------------------------------------------------
	!gone = 0
	do !ci from 1 to !exrefs.size()
		if (not(!exclaim[!ci])) then
			----------------------------------------------------------
			-- copied into a plain variable before the navigation,   --
			-- the way DrawingPlan1MatchCleanup does it              --
			----------------------------------------------------------
			!cref = !exrefs[!ci]
			$!cref
			handle any
				skip
			endhandle
			delete slab
			handle any
				if (!dbgok) then
					!dbgf.writerecord('FLOWGONE ' & !cref & ' refused delete: ' & !!error.text)
				endif
			elsehandle none
				!gone = !gone + 1
				if (!dbgok) then
					!dbgf.writerecord('FLOWGONE ' & !cref & ' deleted')
				endif
			endhandle
		endif
	enddo
	if (!dbgok) then
		!dbgf.writerecord('FLOWEND existing ' & string(!exrefs.size()) & ' deleted ' & string(!gone) & ' arrows now ' & string(!usedx.size()))
		!dbgf.close()
	endif
endfunction

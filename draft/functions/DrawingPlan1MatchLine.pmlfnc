---------------------------------------------
-- Function : Draw match line main program --
-- Auther   : tw tseng                     --
-- Date     : 2025/12/28                   --
---------------------------------------------
define function !!DrawingPlan1MatchLine(!name is string, !equistr is string)
	var !projid proj id
	!dirlist = 'right left down up'
	!format = object format()
	!format.dp = 0
	--------------------------------------------------------------------
	-- everything this run may move or remove, read before anything is --
	-- drawn. the four sides below claim what they find already in the --
	-- right place and draw only what is missing; whatever is left     --
	-- unclaimed at the end was last run's and is removed. without     --
	-- this the whole match line was simply redrawn, which is fine on  --
	-- the rebuild path but on an update would clear and re-add every  --
	-- straight and every text on a drawing where nothing had actually --
	-- moved (2026-08-28)                                              --
	--------------------------------------------------------------------
	$!name/SS/S1/V1
	!!DrawingPlan1MatchCollect()
	--------------------------------------------------------------------
	-- emptied here, filled by the four sides below: one record per    --
	-- match line text, side and sheet extent, for the gap pass which  --
	-- runs after this function has put the texts in their final       --
	-- places. this function is called again after .RecenterView()     --
	-- moves the view, so starting fresh each call is what keeps the   --
	-- boxes on the positions the sheet actually ends up with          --
	--------------------------------------------------------------------
	!!DrawingPlan1MatchTexts = object array()
	!!DrawingPlan1MatchRowLog = object array()
	--------------------------------------------------------------------
	-- and what the texts have to keep off when their own row is taken --
	-- (user, 2026-09-11): the dimension chains and the grid bubbles,  --
	-- listed once here, read by DrawingPlan1MatchRow for every text   --
	--------------------------------------------------------------------
	--------------------------------------------------------------------
	-- the arrows from the texts that had to move out (see             --
	-- DrawingPlan1MatchArrow) start from nothing every run: an arrow  --
	-- is derived entirely from where its text stands now, so last     --
	-- run's are deleted here and the sides below draw this run's. gone --
	-- BEFORE the obstacles are collected -- an old arrow standing in   --
	-- row 1 would otherwise keep its own text out of the row it may   --
	-- now fit back into. the STRA/OUTL pairs are the first, short     --
	-- lived form of the arrow (MLARR_<side>_<k>_S and _H), swept the  --
	-- same way for the drawings made with it                          --
	--------------------------------------------------------------------
	$!name/SS/S1/V1
	!arrold = object array()
	var !arrold coll all (glab stra outl) for ce
	handle any
		!arrold = object array()
	endhandle
	do !ao values !arrold
		!aoname = ''
		var !aoname name of $!ao
		handle any
			!aoname = ''
		endhandle
		skip if (not(!aoname.upcase().matchwild('*/MLARR_*')))
		$!ao
		handle any
			skip
		endhandle
		!aotype = ''
		var !aotype type
		handle any
			skip
		endhandle
		delete $!aotype
		handle any
		endhandle
	enddo
	--------------------------------------------------------------------
	-- and the layer they go on. a GLAB cannot live under the NOTE the --
	-- texts are in, and the layers already there are swept by their   --
	-- own annotation (ateLINE reuses and removes GLABs it did not     --
	-- make). the attributes the arrows inherit are written here every --
	-- run, as DrawingPlan1GridAnnotation does for ateGRID: the head   --
	-- size is Tsiztx, the one number to tune                          --
	--------------------------------------------------------------------
	!mlok = true
	$!name/SS/S1/V1/ateMATCH
	handle any
		$!name/SS/S1/V1
		NEW LAYE $!name/SS/S1/V1/ateMATCH
		handle any
			!mlok = false
		endhandle
	endhandle
	if (!mlok) then
		Lvisibility true
		handle any
		endhandle
		Lleader true
		handle any
		endhandle
		Lframe false
		handle any
		endhandle
		Lshape Straight
		handle any
		endhandle
		Tsiztx '5mm'
		handle any
		endhandle
		Llcltx '0mm'
		handle any
		endhandle
		Txcolour Cyan
		handle any
		endhandle
		LLStyle Solid
		handle any
		endhandle
		LLColour Cyan
		handle any
		endhandle
		Blnk false
		handle any
		endhandle
	endif
	$!name/SS/S1/V1
	!!DrawingPlan1MatchObst = object array()
	!!DrawingPlan1MatchObstacles(!name)
	handle any
	endhandle
	do !jj from 1 to 4
		!dir = !dirlist.part(!jj)
		$!name/SS/S1/V1
		!!DrawingPlan1MatchLine1(!dir, !projid, !equistr, !format)
	enddo
	$!name/SS/S1/V1
	note 1
	-------------------------------------------------------------------
	-- the box round the view. these four are given sheet positions,  --
	-- so they sit on the sheet and do not travel with the view the   --
	-- way the dimensions and the labels do. .Apply() moves the view  --
	-- once it knows how far the annotation reaches, and puts these   --
	-- back on the corners afterwards -- it needs to know which four  --
	-- elements they are, and in which order they were drawn: top,    --
	-- bottom, right, left                                            --
	--                                                                --
	-- a global, not a member of the form: this file is re-read on    --
	-- every call and the form only on kill/show, so a member would   --
	-- break every run made between editing the two                   --
	-------------------------------------------------------------------
	--------------------------------------------------------------------
	-- .Apply() still needs all four of these, claimed or freshly      --
	-- drawn, and still in the order top, bottom, right, left -- so    --
	-- the claim has to hand back which element it matched, not just   --
	-- that it matched one. .ClaimRef() answers '' when there is       --
	-- nothing there and the ref of the one it claimed when there is   --
	--------------------------------------------------------------------
	!!DrawingPlan1MatchStras = object array()
	!bfrom = object array()
	!bto = object array()
	!bfrom[1] = !!DrawingPlan1.boxULsh
	!bto[1]   = !!DrawingPlan1.boxURsh
	!bfrom[2] = !!DrawingPlan1.boxLLsh
	!bto[2]   = !!DrawingPlan1.boxLRsh
	!bfrom[3] = !!DrawingPlan1.boxLRsh
	!bto[3]   = !!DrawingPlan1.boxURsh
	!bfrom[4] = !!DrawingPlan1.boxLLsh
	!bto[4]   = !!DrawingPlan1.boxULsh
	do !bi from 1 to 4
		!bf = !bfrom[!bi]
		!bt = !bto[!bi]
		!bfxy = !!DrawingPlan1MatchXY(!bf)
		!btxy = !!DrawingPlan1MatchXY(!bt)
		!bsig = 'S~' & !bfxy & '~' & !btxy
		!bref = !!DrawingPlan1MatchClaimRef(!bsig)
		if (!bref.eq('')) then
			new stra fpt $!bf tpt $!bt NLStyle DChainedThick  NLColour Magenta
			var !msref ref
			!!DrawingPlan1MatchStras.append(!msref)
		else
			----------------------------------------------------------------
			-- user rule, 2026-09-02: this straight marks the box's own    --
			-- edge, not a pipe crossing -- so unlike a GLAB or a DPOI it   --
			-- has no position of its own to freeze. reusing the ref used  --
			-- to mean leaving FPT/TPT exactly as they were, which was     --
			-- fine only because .RecenterView() always put them back on   --
			-- the corner afterwards -- but that only runs on the rebuild  --
			-- path. on an update, nothing ever moved this straight again, --
			-- so a claimed-but-untouched one just sat on last run's box   --
			-- edge forever while the box itself kept moving: reported     --
			-- live as the border sitting well off a box that had shrunk   --
			-- by nearly 2m. moving it onto this run's !bf/!bt every time, --
			-- claimed or new, is what keeps it on the box regardless      --
			----------------------------------------------------------------
			$!bref
			handle any
			endhandle
			FPT $!bf
			handle any
			endhandle
			TPT $!bt
			handle any
			endhandle
			!!DrawingPlan1MatchStras.append(!bref)
		endif
	enddo
	--------------------------------------------------------------------
	-- and whatever none of the four sides wanted this run             --
	--------------------------------------------------------------------
	!!DrawingPlan1MatchCleanup()
endfunction
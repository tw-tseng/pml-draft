------------------------------------
-- Function : Line No. Annotation --
-- Auther   : tw tseng            --
-- Date     : 2025/03/09          --
------------------------------------

import 'AteSortLineNo'
handle any
endhandle

--------------------------------------------------------------------------
-- !boxXlen / !boxYlen are no longer used. the width of the bands is now --
-- taken from the size of the view on the sheet, which is right whatever --
-- the box is turned to, and which also gets the swap of xlength and     --
-- ylength in .Apply() right. the two arguments are kept so that nothing --
-- which calls this function has to change                               --
--------------------------------------------------------------------------
define function !!DrawingPlan1LineNoAnnotation(!name is string, !boxXlen is real, !boxYlen is real)
	NEW LAYE $!name/SS/S1/V1/ateLINE_R$!!DrawingPlan1.rev
	Purpose LINE
	Lvisibility true
	Font 1
	Justification Left
	Alignment Template
	Tsiztx '3mm'
	Chostx '6mm'
	Asubtended 0degree
	Pjustification Towards 
	Oshttx '2mm'
	Plcltx '0mm'
	Doffset 25mm
	Dmsptx '0mm'
	Lleader true
	Lframe true
	Lshape Straight
	Gboxtx '1mm'
	Llcltx '0mm'
	Xyscale 1 1
	Xyposition 25mm 25mm 
	Blnk false
	Bmargin 0mm
	Trsf Nulref
	Txcolour Yellow 
	NLStyle Solid 
	NLColour Cyan 
	FStyle Off 
	FColour Grey 
	LLStyle Solid 
	LLColour Cyan 
	LFStyle Solid 
	LFColour Cyan 
	DLStyle Solid 
	DLColour Cyan 
	PLStyle Solid 
	PLColour Cyan 
	MColour Cyan 
	CHStyle Off 
	CHColour Grey
  Cheitx '3.00mm'
	
--	var !viewdirup    viewdir up
--	var !viewdirleft  viewdir left
	var !viewdirdown  viewdir down
	var !viewdirright viewdir right
	
	!dirlist = 'right left down up'

	--------------------------------------------------------------------------
	-- diagnostic switch, left in the way DrawingPlan1FlowAnnotation keeps  --
	-- its !dbg. there is far more of this than the command window can      --
	-- hold, so it goes to a file, written the same way as CouplingMto      --
	-- and checkCuttingLength do. only the left side of the view is         --
	-- reported, which is enough to follow one border at a time             --
	--                                                                      --
	-- the LABEL line is the useful one: it prints once per label that is   --
	-- really drawn, with the element and which TYPE found it, so a label   --
	-- on the sheet can be traced back without guessing. that is what found --
	-- the 2026-08-12 view rotation bug                                     --
	--                                                                      --
	-- L: on the machine running E3D is the same folder as D: here          --
	--------------------------------------------------------------------------
	!dbgln = false
	if (!dbgln) then
		!dbgf = object file('L:\E3D\pdms_prog\E3D2.1\PA_pmllibE3D2.1\check.txt')
		!dbgf.open('overwrite')
	endif

	---------------------------------------------------------------------------
	-- the sides of the view are only parallel to E and N when the drawing   --
	-- box is orthogonal to the world. when it is not, .Apply() turns the    --
	-- view with ADEGREES, and a band along one side of the view is then a   --
	-- turned rectangle in the model, which COLLECT ... WITHIN cannot take.  --
	-- so every band below is set out in sheet coordination, where the view  --
	-- is always square, WITHIN is given the world box which contains the    --
	-- band, and .CheckInSheetBand() throws away what that box picks up      --
	-- outside the band itself. this also covers rcode, because the sheet    --
	-- corners of the view are already turned by .Apply()                    --
	---------------------------------------------------------------------------
	!trans = !!DrawingPlan1.ViewSheetTransform()
	!vwx1 = min(!!DrawingPlan1.viewLLsh.part(2).real(), !!DrawingPlan1.viewURsh.part(2).real())
	!vwx2 = max(!!DrawingPlan1.viewLLsh.part(2).real(), !!DrawingPlan1.viewURsh.part(2).real())
	!vwy1 = min(!!DrawingPlan1.viewLLsh.part(4).real(), !!DrawingPlan1.viewURsh.part(4).real())
	!vwy2 = max(!!DrawingPlan1.viewLLsh.part(4).real(), !!DrawingPlan1.viewURsh.part(4).real())

	------------------------------------------------------------------
	-- !result is the array with th correct dimension attach points --
	------------------------------------------------------------------
	!result = object array()
	!!DrawingPlan1.equiparray.clear()
	do !jj from 1 to 4
		!dir = !dirlist.part(!jj)
		-------------------------------------------------------------------------
		-- !dir is the side of the view as it appears on the sheet, and so are  --
		-- the bands, the sorting, the border line to shoot at, the corners of  --
		-- the view, DIR / DOFFSET of the LDIM, the text angle and the padding  --
		-- spaces of Pltxt                                                      --
		--                                                                      --
		-- viewdir gives the model direction which appears to point that way on --
		-- the sheet, so it already follows both ADEGREES and rcode. !viewdir   --
		-- is only used as a model direction, to offset the attach point away   --
		-- from the view and to check the direction of a component. the same    --
		-- applies to !viewdirdown / !viewdirright above, which give DIR of the --
		-- LDIM                                                                 --
		-------------------------------------------------------------------------
		var !viewdir viewdir $!dir
		-------------------------------------------------------------------------
		-- !shdir is !dir in sheet coordination. it is used to shoot a line     --
		-- from the sheet position of a member to the border line of the view,  --
		-- both of them come from shpos, so it must not be taken from viewdir,  --
		-- which is a model direction                                           --
		-------------------------------------------------------------------------
		if (!dir.eq('right')) then
			!shdir = object direction('E')
		elseif (!dir.eq('left')) then
			!shdir = object direction('W')
		elseif (!dir.eq('down')) then
			!shdir = object direction('S')
		elseif (!dir.eq('up')) then
			!shdir = object direction('N')
		endif
		------------------------------------------------------------------------
		-- how deep the bands below reach in from the border, in sheet mm.     --
		-- !banddeep is 33% and !bandshal 10% of the view, as before, and      --
		-- !bandthin is the 10mm of the model which catches whatever crosses   --
		-- the border itself                                                   --
		------------------------------------------------------------------------
		!bandthin = 10 * !!DrawingPlan1.vsca
		if (!dir.eq('right') or !dir.eq('left')) then
			!banddeep = (!vwx2 - !vwx1) * 0.33
			!bandshal = (!vwx2 - !vwx1) * 0.1
		else
			!banddeep = (!vwy2 - !vwy1) * 0.33
			!bandshal = (!vwy2 - !vwy1) * 0.1
		endif
		!j = 1
		!result.clear()

		---------------------------------------------
		-- TYPE 1 situation                        --
		-- find pipes that cross right match line  --
		---------------------------------------------
		!types = object array()
		!band = !!DrawingPlan1.SheetBandOfSide(!dir, !bandthin)
		!wlim = !!DrawingPlan1.WorldLimitsOfSheetRect(!band[1], !band[2], !band[3], !band[4], !trans)
		!bminE = !wlim[1]
		!bminN = !wlim[2]
		!bmaxE = !wlim[3]
		!bmaxN = !wlim[4]
		!vlfm = 'E ' & $!bminE & ' N ' & $!bminN & ' U ' & $!!DrawingPlan1.minU
		!vlto = 'E ' & $!bmaxE & ' N ' & $!bmaxN & ' U ' & $!!DrawingPlan1.maxU

		$!name/SS/S1/V1_R$!!DrawingPlan1.rev
		var !mems coll all bran members within $!vlfm to $!vlto
		do !i from 1 to !mems.size()
			!mem = !mems[$!i]
			var !type type of $!mem
			!istube = false
			!tubeelem = ''
			if (!type.matchwild('*TUB*')) then
				!istube = true
				!tubeelem = !mems[$!i]
				var !mem mtbe of $!mems[$!i]
			endif
			if (!dbgln and !dir.eq('left')) then
				!dbgf.writerecord('TYPE1 raw=' & !mems[!i] & ' type=' & !type & ' istube=' & !istube.string() & ' mtbe=' & !mem)
			endif
			var !check IDLN for $!mem
	--      $p $!check
			handle any
	--      skip
			elsehandle none
				var !pipe namn of pipe of $!mem
				if (!check.eqnocase('INCLUDED')) then
					var !type type of $!mem
					if (!type.eqnocase('BRAN')) then
						var !memenupos hpos of $!mem
					else
						var !memenupos worpos of $!mem
					endif
					------------------------------------------------------------------
					-- a length of pipe with no fitting in it is an implied tube,    --
					-- and mtbe above turned it into the branch or the component it  --
					-- leaves from, which can be right across the drawing. so follow --
					-- the tube to where it really crosses the border and dimension  --
					-- there. only the elevation is kept from the element, so that   --
					-- BOP still comes out right                                     --
					--                                                               --
					-- while the box was orthogonal this went unnoticed, because a   --
					-- pipe crossing a border runs square with it and the leader,    --
					-- which is shot square at the border, landed on the right spot  --
					-- anyway. once the box is turned the pipe crosses at an angle   --
					-- and the leader ends up somewhere else along the border, or    --
					-- off the end of it                                             --
					------------------------------------------------------------------
					!useit = true
					if (!istube) then
						!crossenu = !!DrawingPlan1.CrossingOfTube(!tubeelem, !mem, !dir)
						if (!dbgln and !dir.eq('left')) then
							!dbgf.writerecord('TYPE1 tube=' & !tubeelem & ' owner=' & !mem & ' pipe=' & !pipe & ' crossenu=' & !crossenu)
						endif
						if (!crossenu.eq('NONE')) then
							--------------------------------------------------------
							-- the world box handed to WITHIN is bigger than the  --
							-- band when the view is turned, so a tube which does --
							-- not reach this border can still get this far. it   --
							-- is dropped here, otherwise a pipe which turns near --
							-- the border gets the same line number twice, once   --
							-- from the tube before the bend and once from the    --
							-- tube after it                                      --
							--------------------------------------------------------
							!useit = false
						elseif (!crossenu.neq('')) then
							!crosspos = object position(!crossenu)
							!crosspos.up = !memenupos.position().up
							---------------------------------------------------------------
							-- not !crosspos.string(): a POSITION built with object       --
							-- position(<string>) stringifies back with a 'WRT /*' tail,   --
							-- unlike the plain enupos / hpos / worpos strings used        --
							-- everywhere else in this function. that tail was seen in the --
							-- 2026-08-12 diagnostic output and SHPOS OF is not expected   --
							-- to read past it, so the E / N / U string is built by hand   --
							-- instead                                                     --
							--                                                             --
							-- the sign is written as the opposite compass letter (W/S/D)  --
							-- rather than a minus sign, to match every other position     --
							-- string here -- straight off hpos / worpos / enupos they all  --
							-- come as 'W 366058mm', never 'E -366058mm'. whether the      --
							-- minus form would actually have been rejected was never      --
							-- isolated; this only keeps the format consistent             --
							---------------------------------------------------------------
							if (!crosspos.east geq 0) then
								!epfx = 'E '
								!eval = !crosspos.east
							else
								!epfx = 'W '
								!eval = !crosspos.east * -1
							endif
							if (!crosspos.north geq 0) then
								!npfx = 'N '
								!nval = !crosspos.north
							else
								!npfx = 'S '
								!nval = !crosspos.north * -1
							endif
							if (!crosspos.up geq 0) then
								!upfx = 'U '
								!uval = !crosspos.up
							else
								!upfx = 'D '
								!uval = !crosspos.up * -1
							endif
							!memenupos = !epfx & string(!eval) & ' ' & !npfx & string(!nval) & ' ' & !upfx & string(!uval)
						endif
					endif
					if (!useit) then
						var !memshpos shpos of $!memenupos
						!memshx = !memshpos.split().getindexed(2).replace('mm','').real()
						!memshy = !memshpos.split().getindexed(4).replace('mm','').real()
						-----------------------------------------------------------------------
						-- is this point actually inside the band, checked here instead of    --
						-- via .CheckInSheetBand() on the raw collected item's WVOL. WVOL is   --
						-- world axis aligned; projected through the box's rotation it comes   --
						-- out as a rectangle bigger than the real footprint (a compact        --
						-- fitting turns into an elongated diagonal smear in sheet space), so  --
						-- against !bandthin's paper-thin strip a component that is genuinely  --
						-- outside the box can still have that inflated box graze the strip    --
						-- and pass. a single point cannot be inflated by rotation, and this    --
						-- is also the exact point the annotation ends up placed at (including  --
						-- the crossing-point override above for a tube), so testing it here    --
						-- instead of the raw WVOL is both simpler and more correct             --
						--                                                                      --
						-- found 2026-08-12: Copy-of-100-C-12, confirmed sitting outside the    --
						-- box (blue in the model view), kept passing the WVOL-based band check --
						-- for all of its fittings even though none of them are really at the   --
						-- border                                                               --
						--                                                                      --
						-- !postol guards the points which land exactly on the near edge of    --
						-- the band: a crossing is worked out from the same border line the    --
						-- band starts at, so its sheet coordinate can fall a hair either side --
						-- of !band[1] depending on which way round the arithmetic went.       --
						-- 0.01mm is far below anything geometrically meaningful here          --
						-----------------------------------------------------------------------
						!postol = 0.01
						!inband = true
						if (!memshx.lt(!band[1] - !postol) or !memshx.gt(!band[3] + !postol) or !memshy.lt(!band[2] - !postol) or !memshy.gt(!band[4] + !postol)) then
							!inband = false
						endif
						if (!dbgln and !dir.eq('left')) then
							!dbgf.writerecord('TYPE1 CHECK pipe=' & !pipe & ' inband=' & !inband.string() & ' memshx=' & !memshx.string() & ' memshy=' & !memshy.string() & ' band=' & !band[1].string() & ' ' & !band[2].string() & ' ' & !band[3].string() & ' ' & !band[4].string())
						endif
						if (!inband) then
							----------------------------------------------------------------
							-- y is the key of hashtable in .Net and cannot be duplicated --
							-- so a small value needs to be added to identify it          --
							----------------------------------------------------------------
							!x = !memshx + 0.0000000001 * !j
							!y = !memshy + 0.0000000001 * !j
							!memstr = !y & '~' & !x & '~type1!' & !memenupos & '!' & !memshpos & '!' & !mem & '!' & !pipe & '!y'
							!result[!j] = !memstr
							!j = !j + 1
							if (!dbgln and !dir.eq('left')) then
								!dbgf.writerecord('TYPE1 KEPT pipe=' & !pipe & ' memenupos=' & !memenupos & ' memshpos=' & !memshpos)
							endif
						endif
					endif
				elseif (!dbgln and !dir.eq('left')) then
					----------------------------------------------------------------
					-- !inband is no longer set at the top of this loop, so it is  --
					-- not printed here -- referring to it before the band test    --
					-- runs would raise 'Variable INBAND not defined' on the very  --
					-- first member that is not in the drawlist                    --
					----------------------------------------------------------------
					!dbgf.writerecord('TYPE1 SKIPPED check=' & !check & ' mem=' & !mem)
				endif
			endhandle
		enddo
		
		--------------------------------------------
		-- sort !sortedtypes by y or x coordinate --
		--------------------------------------------
		using namespace 'Aveva.Core.Samples'
		!obj = object AteSortLineNo()
		if (!dir.eq('right') or !dir.eq('left')) then
			!sortedtypes = !obj.method('y', !result)
		else
			!sortedtypes = !obj.method('x', !result)
		endif
		
		-----------------------------------------------------------------------
		-- remove the distance between type 2,3,4 and type1 is less then 4mm --
		-----------------------------------------------------------------------
		!newresult = object array()
		do !i from 1 to !sortedtypes.size()
			!del = true
			do !ii from 1 to !newresult.size()
				if (!dir.eq('right') or !dir.eq('left')) then
					if (abs(!sortedtypes[!i].split('~').getindexed(1).real() - !newresult[!ii].split('~').getindexed(1).real()) le 1) then
						!del = false
					endif
				else
					if (abs(!sortedtypes[!i].split('~').getindexed(2).real() - !newresult[!ii].split('~').getindexed(2).real()) le 1) then
						!del = false
					endif
				endif		
			enddo
			if (!del) then
				!newresult.append(!sortedtypes[!i])
			endif
		enddo
		!result = !newresult
		
		-------------------------------------------------------------
		-- j is the index of collection for dimension attach point --
		-- never initial it later                                  --
		-------------------------------------------------------------
		!j = 1

		---------------------------------------------
		-- TYPE 2a situation                       --
		-- find pipes that cross upper match line  --
		---------------------------------------------
		!band = !!DrawingPlan1.SheetBandOfSide(!dir, !banddeep)
		!wlim = !!DrawingPlan1.WorldLimitsOfSheetRect(!band[1], !band[2], !band[3], !band[4], !trans)
		!bminE = !wlim[1]
		!bminN = !wlim[2]
		!bmaxE = !wlim[3]
		!bmaxN = !wlim[4]
		!tempvl  = !!DrawingPlan1.maxU - 10
		!vlfm = 'E ' & $!bminE & ' N ' & $!bminN & ' U ' & $!tempvl
		!vlto = 'E ' & $!bmaxE & ' N ' & $!bmaxN & ' U ' & $!!DrawingPlan1.maxU

		$!name/SS/S1/V1_R$!!DrawingPlan1.rev
		var !mems coll all bran members within $!vlfm to $!vlto
		do !i from 1 to !mems.size()
			!mem = !mems[$!i]
			var !type type of $!mem
			if (!type.matchwild('*TUB*')) then
				var !mem mtbe of $!mems[$!i]
			endif
			var !check IDLN for $!mem
	--      $p $!check
			handle any
	--      skip
			elsehandle none
				var !pipe namn of pipe of $!mem
				if (!check.eqnocase('INCLUDED')) then
					var !type type of $!mem
					if (!type.eqnocase('BRAN')) then
						var !memenupos hpos of $!mem
					else
						var !memenupos worpos of $!mem
					endif
					var !memshpos shpos of $!memenupos
					!memshx = !memshpos.split().getindexed(2).replace('mm','').real()
					!memshy = !memshpos.split().getindexed(4).replace('mm','').real()
					--------------------------------------------------------------
					-- the point is tested against the band rather than the WVOL --
					-- of the raw collected item, for the reason set out in full --
					-- in TYPE 1 above                                           --
					--------------------------------------------------------------
					!postol = 0.01
					!inband = true
					if (!memshx.lt(!band[1] - !postol) or !memshx.gt(!band[3] + !postol) or !memshy.lt(!band[2] - !postol) or !memshy.gt(!band[4] + !postol)) then
						!inband = false
					endif
					if (!inband) then
						!x = !memshx + 0.0000000001 * !j
						!y = !memshy + 0.0000000001 * !j
						!memstr = !y & '~' & !x & '~type2a!' & !memenupos & '!' & !memshpos & '!' & !mem & '!' & !pipe
						!types[!j] = !memstr
						!j = !j + 1
						if (!dbgln and !dir.eq('left')) then
							!dbgf.writerecord('TYPE2A KEPT pipe=' & !pipe & ' mem=' & !mem & ' memshx=' & !memshx.string() & ' memshy=' & !memshy.string())
						endif
					endif
				endif
			endhandle
		enddo
		
		---------------------------------------------
		-- TYPE 2b situation                       --
		-- find pipes that cross lower match line  --
		---------------------------------------------
		!band = !!DrawingPlan1.SheetBandOfSide(!dir, !banddeep)
		!wlim = !!DrawingPlan1.WorldLimitsOfSheetRect(!band[1], !band[2], !band[3], !band[4], !trans)
		!bminE = !wlim[1]
		!bminN = !wlim[2]
		!bmaxE = !wlim[3]
		!bmaxN = !wlim[4]
		!tempvl  = !!DrawingPlan1.minU + 10
		!vlfm = 'E ' & $!bminE & ' N ' & $!bminN & ' U ' & $!!DrawingPlan1.minU
		!vlto = 'E ' & $!bmaxE & ' N ' & $!bmaxN & ' U ' & $!tempvl

		$!name/SS/S1/V1_R$!!DrawingPlan1.rev
		var !mems coll all bran members within $!vlfm to $!vlto
		do !i from 1 to !mems.size()
			!mem = !mems[$!i]
			var !type type of $!mem
			if (!type.matchwild('*TUB*')) then
				var !mem mtbe of $!mems[$!i]
			endif
			var !check IDLN for $!mem
	--      $p $!check
			handle any
	--      skip
			elsehandle none
				var !pipe namn of pipe of $!mem
				if (!check.eqnocase('INCLUDED')) then
					var !type type of $!mem
					if (!type.eqnocase('BRAN')) then
						var !memenupos hpos of $!mem
					else
						var !memenupos worpos of $!mem
					endif
					var !memshpos shpos of $!memenupos
					!memshx = !memshpos.split().getindexed(2).replace('mm','').real()
					!memshy = !memshpos.split().getindexed(4).replace('mm','').real()
					--------------------------------------------------------------
					-- the point is tested against the band rather than the WVOL --
					-- of the raw collected item, for the reason set out in full --
					-- in TYPE 1 above                                           --
					--------------------------------------------------------------
					!postol = 0.01
					!inband = true
					if (!memshx.lt(!band[1] - !postol) or !memshx.gt(!band[3] + !postol) or !memshy.lt(!band[2] - !postol) or !memshy.gt(!band[4] + !postol)) then
						!inband = false
					endif
					if (!inband) then
						!x = !memshx + 0.0000000001 * !j
						!y = !memshy + 0.0000000001 * !j
						!memstr = !y & '~' & !x & '~type2b!' & !memenupos & '!' & !memshpos & '!' & !mem & '!' & !pipe
						!types[!j] = !memstr
						!j = !j + 1
						if (!dbgln and !dir.eq('left')) then
							!dbgf.writerecord('TYPE2B KEPT pipe=' & !pipe & ' mem=' & !mem & ' memshx=' & !memshx.string() & ' memshy=' & !memshy.string())
						endif
					endif
				endif
			endhandle
		enddo

		------------------------------------
		-- TYPE 3 situation               --
		-- find elbows within view limit  --
		------------------------------------
		!tempvl  = !!DrawingPlan1.minU + 10
		!tempvl1  = !!DrawingPlan1.maxU - 10
		!band = !!DrawingPlan1.SheetBandOfSide(!dir, !banddeep)
		!wlim = !!DrawingPlan1.WorldLimitsOfSheetRect(!band[1], !band[2], !band[3], !band[4], !trans)
		!bminE = !wlim[1]
		!bminN = !wlim[2]
		!bmaxE = !wlim[3]
		!bmaxN = !wlim[4]
		!vlfm = 'E ' & $!bminE & ' N ' & $!bminN & ' U ' & $!tempvl
		!vlto = 'E ' & $!bmaxE & ' N ' & $!bmaxN & ' U ' & $!tempvl1

		$!name/SS/S1/V1_R$!!DrawingPlan1.rev
		var !mems coll all elbo within $!vlfm to $!vlto
		do !i from 1 to !mems.size()
			!mem = !mems[$!i]
			var !check IDLN for $!mem
	--      $p $!check
			handle any
	--      skip
			elsehandle none
				var !pipe namn of pipe of $!mem
				if (!check.eqnocase('INCLUDED')) then
					var !memenupos worpos of $!mem
					var !memshpos shpos of $!memenupos
					!memshx = !memshpos.split().getindexed(2).replace('mm','').real()
					!memshy = !memshpos.split().getindexed(4).replace('mm','').real()
					--------------------------------------------------------------
					-- the point is tested against the band rather than the WVOL --
					-- of the raw collected item, for the reason set out in full --
					-- in TYPE 1 above                                           --
					--------------------------------------------------------------
					!postol = 0.01
					!inband = true
					if (!memshx.lt(!band[1] - !postol) or !memshx.gt(!band[3] + !postol) or !memshy.lt(!band[2] - !postol) or !memshy.gt(!band[4] + !postol)) then
						!inband = false
					endif
					if (!inband) then
						!x = !memshx + 0.0000000001 * !j
						!y = !memshy + 0.0000000001 * !j
						!memstr = !y & '~' & !x & '~type3!' & !memenupos & '!' & !memshpos & '!' & !mem & '!' & !pipe
						!types[!j] = !memstr
						!j = !j + 1
						if (!dbgln and !dir.eq('left')) then
							!dbgf.writerecord('TYPE3 KEPT pipe=' & !pipe & ' mem=' & !mem & ' memshx=' & !memshx.string() & ' memshy=' & !memshy.string())
						endif
					endif
				endif
			endhandle
		enddo
		
		----------------------------------------
		-- find euqipments within view limit  --
		----------------------------------------
		!band = !!DrawingPlan1.SheetBandOfSide(!dir, !bandshal)
		!wlim = !!DrawingPlan1.WorldLimitsOfSheetRect(!band[1], !band[2], !band[3], !band[4], !trans)
		!bminE = !wlim[1]
		!bminN = !wlim[2]
		!bmaxE = !wlim[3]
		!bmaxN = !wlim[4]
		!vlfm = 'E ' & $!bminE & ' N ' & $!bminN & ' U ' & $!tempvl
		!vlto = 'E ' & $!bmaxE & ' N ' & $!bmaxN & ' U ' & $!tempvl1
		var !mems coll all equi with (not(matchwild(name, |*_DrawingPlan|))) within $!vlfm to $!vlto
		do !i from 1 to !mems.size()
			!mem = !mems[$!i]
			!inband = !!DrawingPlan1.CheckInSheetBand(!mem, !band, !trans)
			var !check IDLN for $!mem
			handle any
			elsehandle none
				var !equi namn of $!mem
				if (!check.eqnocase('INCLUDED') and !inband) then
					---------------------------------------------------------------
					-- check if most volume of equipment is within view boundary --
					-- the equipment has to reach at least 10mm of the sheet in  --
					-- from the border, measured on the sheet so that it still   --
					-- works when the view is turned                             --
					---------------------------------------------------------------
					var !wvol wvol of $!mem
					!memlim = !!DrawingPlan1.SheetLimitsOfVolume(!wvol, !trans)
					!checkwvol = false
					if (!dir.eq('right')) then
						if ((!vwx2 - !memlim[1]) geq 10)  then
							!checkwvol = true
						endif
					elseif (!dir.eq('left')) then
						if ((!memlim[3] - !vwx1) geq 10)  then
							!checkwvol = true
						endif
					elseif (!dir.eq('down')) then
						if ((!memlim[4] - !vwy1) geq 10)  then
							!checkwvol = true
						endif
					elseif (!dir.eq('up')) then
						if ((!vwy2 - !memlim[2]) geq 10)  then
							!checkwvol = true
						endif
					endif
					if (!checkwvol) then
						var !memenupos worpos of $!mem
						var !memshpos shpos of $!memenupos
						-------------------------------------------------------
						-- check if pos of equipment is within view boundary --
						-- along the side the annotation is drawn on         --
						-------------------------------------------------------
						!memx = !memshpos.split().getindexed(2).replace('mm','').real()
						!memy = !memshpos.split().getindexed(4).replace('mm','').real()
						!checkwvol = false
						if (!dir.eq('right') or !dir.eq('left')) then
							if (!memy lt !vwy2 and !memy gt !vwy1) then
								!checkwvol = true
							endif
						elseif (!dir.eq('down') or !dir.eq('up')) then
							if (!memx lt !vwx2 and !memx gt !vwx1) then
								!checkwvol = true
							endif
						endif
						if (!checkwvol) then
							!x = !memshpos.split().getindexed(2).replace('mm','').real() + 0.0000000001 * !j
							!y = !memshpos.split().getindexed(4).replace('mm','').real() + 0.0000000001 * !j
							!memstr = !y & '~' & !x & '~type1!' & !memenupos & '!' & !memshpos & '!' & !mem & '!' & !equi
							!result.append(!memstr)
							!!DrawingPlan1.equiparray.append(!equi)
						endif
					endif
				endif
			endhandle
		enddo		
		
		
		-------------------------------------------
		-- TYPE 4 situation                      --
		-- find bran href/tref is unset and      --
		-- hdir/tdir opposite to view direction  --
		-- and hpos/tpos is within view limit    --
		-------------------------------------------
		$!name/SS/S1/V1_R$!!DrawingPlan1.rev
		var !mems coll all bran with unset(href) or unset(tref) within $!vlfm to $!vlto
		do !i from 1 to !mems.size()
			!mem = !mems[$!i]
			var !pipe namn of pipe of $!mem
			var !hdir hdir of $!mem
			var !tdir tdir of $!mem
			!hdir1 = object direction(!hdir)
			!tref1 = object direction(!tdir)
			--------------------------------------------------------------------
			-- the head / tail has to be inside the view. east and north are  --
			-- no use for that when the view is turned, so the sheet position --
			-- is checked against the sheet rectangle of the view instead     --
			--------------------------------------------------------------------
			if (!hdir1.opposite().eq(object direction(!viewdir))) then
				var !memenupos hpos of $!mem
				!memenupos1 = object position(!memenupos)
				var !memshpos shpos of $!memenupos
				!memx = !memshpos.split().getindexed(2).replace('mm','').real()
				!memy = !memshpos.split().getindexed(4).replace('mm','').real()
				if (!memx lt !vwx2 and !memx gt !vwx1) then
					if (!memy lt !vwy2 and !memy gt !vwy1) then
						if (!memenupos1.up lt !!DrawingPlan1.maxU and !memenupos1.up gt !!DrawingPlan1.minU) then
							!x = !memx + 0.0000000001 * !j
							!y = !memy + 0.0000000001 * !j
							!memstr = !y & '~' & !x & '~type4!' & !memenupos & '!' & !memshpos & '!' & !mem & '!' & !pipe
							!types[!j] = !memstr
							!j = !j + 1
						endif
					endif
				endif
			endif
			if (!tref1.opposite().eq(object direction(!viewdir))) then
				var !memenupos tpos of $!mem
				!memenupos1 = object position(!memenupos)
				var !memshpos shpos of $!memenupos
				!memx = !memshpos.split().getindexed(2).replace('mm','').real()
				!memy = !memshpos.split().getindexed(4).replace('mm','').real()
				if (!memx lt !vwx2 and !memx gt !vwx1) then
					if (!memy lt !vwy2 and !memy gt !vwy1) then
						if (!memenupos1.up lt !!DrawingPlan1.maxU and !memenupos1.up gt !!DrawingPlan1.minU) then
							!x = !memx + 0.0000000001 * !j
							!y = !memy + 0.0000000001 * !j
							!memstr = !y & '~' & !x & '~type4!' & !memenupos & '!' & !memshpos & '!' & !mem & '!' & !pipe
							!types[!j] = !memstr
							!j = !j + 1
						endif
					endif
				endif
			endif
		enddo
		
		$(
		do !i from 1 to !types.size()
			$p $!types[$!i]
		enddo
		$p >>>>>>>>>>>>>>>>>>
		$)

		---------------------------------------
		-- sort !sortedtypes by y coordinate --
		---------------------------------------
		using namespace 'Aveva.Core.Samples'
		!obj = object AteSortLineNo()
		if (!dir.eq('right') or !dir.eq('left')) then
			!sortedtypes = !obj.method('y', !types)
		else
			!sortedtypes = !obj.method('x', !types)
		endif
		
		-----------------------------------------------------------------------
		-- remove the distance between type 2,3,4 and type1 is less then 4mm --
		-----------------------------------------------------------------------
		!dels = object array()
		do !i from 1 to !sortedtypes.size()
			!del = false
			do !ii from 1 to !result.size()
				if (!dir.eq('right') or !dir.eq('left')) then
					if (abs(!sortedtypes[!i].split('~').getindexed(1).real() - !result[!ii].split('~').getindexed(1).real()) le 4) then
						!del = true
					endif
				else
					if (abs(!sortedtypes[!i].split('~').getindexed(2).real() - !result[!ii].split('~').getindexed(2).real()) le 4) then
						!del = true
					endif
				endif
			enddo
			if (!del) then
				!dels.append(!i)
			endif
		enddo
		do !i from !dels.size() to 1 by -1
			!sortedtypes.remove(!dels[!i])
		enddo
		
	$(
		do !i from 1 to !sortedtypes.size()
			$p $!sortedtypes[$!i]
		enddo
			$p -----------------------
	$)
		
		-------------------------------------------------------
		-- determin which dimension attach point is correct  --
		-- when dimension left/right with same y coordinate  --
		-- or up/down with same x coordinate                 --
		-------------------------------------------------------
		!temp1s = object array()
		!i = 1
		do !go
			break if (!i gt !sortedtypes.size())		
			!temp = !sortedtypes[!i]
			!temp1s.clear()
			!temp1s.append(!temp)
			!ii = !i + 1
			do !go1
				break if (!ii gt !sortedtypes.size())
				if (!dir.eq('right') or !dir.eq('left')) then
					if (abs(!sortedtypes[!ii].split('~').getindexed(1).real() - !temp.split('~').getindexed(1).real()) le 4) then
						!temp1s.append(!sortedtypes[!ii])
						!ii = !ii + 1
					else
						break
					endif
				elseif (!dir.eq('down') or !dir.eq('up')) then
					if (abs(!sortedtypes[!ii].split('~').getindexed(2).real() - !temp.split('~').getindexed(2).real()) le 4) then
						!temp1s.append(!sortedtypes[!ii])
						!ii = !ii + 1
					else
						break
					endif
				endif
			enddo
	$(
			$p >>>>>>>>>>>>>>>>>
			do !temp1 values !temp1s
				$p $!temp1
			enddo
	$)
			if (!dir.eq('right')) then
				!result.append(!!DrawingPlan1.CheckDimensionAttachPoint('x', 'max', !temp1s, !viewdir))
			elseif (!dir.eq('left')) then
				!result.append(!!DrawingPlan1.CheckDimensionAttachPoint('x', 'min', !temp1s, !viewdir))
			elseif (!dir.eq('down')) then
				!result.append(!!DrawingPlan1.CheckDimensionAttachPoint('y', 'min', !temp1s, !viewdir))
			elseif (!dir.eq('up')) then
				!result.append(!!DrawingPlan1.CheckDimensionAttachPoint('y', 'max', !temp1s, !viewdir))
			endif
			
			!i = !ii
		enddo
		
		$!name/SS/S1/V1/ateLINE_R$!!DrawingPlan1.rev

		NEW LDIM $!name/SS/S1/V1/ateLINE_$!dir_R$!!DrawingPlan1.rev
		!ldimref = ce
		Dtangle par
	--		Dlcntmode 'on'-----------------------------------------------------------------------------------------------------
		Tsiztx '2mm'
		Dterid 8103
		Fterid 8103
		if (!dir.eq('right') or !dir.eq('left')) then
			DIR $!viewdirdown
		elseif (!dir.eq('down') or !dir.eq('up')) then
			DIR $!viewdirright
		endif

		do !i from 1 to !result.size()
			!resultl = !result[!i]
			!mem = !resultl.split('~').getindexed(3).split('!').getindexed(4)
			var !type type of $!mem
			--------------------------------------------------------------------
			-- the position was worked out when the member was found and is    --
			-- carried in the string, so take it from there instead of asking  --
			-- the element again. for a length of plain tube it is the point   --
			-- where the tube crosses the border of the view, and for a type 4 --
			-- tail it is tpos, neither of which hpos would hand back          --
			--------------------------------------------------------------------
			!mempos   = !resultl.split('~').getindexed(3).split('!').getindexed(2)
			!mempossh = !resultl.split('~').getindexed(3).split('!').getindexed(3)
			if (not(!type.eqnocase('EQUI'))) then
				if (!type.eqnocase('BRAN')) then
					var !aod phod of $!mem
				else
					var !aod aod of $!mem
				endif
				!bop = !mempos.position().up - !aod.real().value() * 0.5
				!bopu = !bop.nint().value()
			endif

			!intpt.delete()
			handle any
			endhandle
			!templine = object line(!mempossh.position(), !mempossh.position().offset(!shdir, 1))
			if (!dir.eq('right')) then
				!intpt = !!DrawingPlan1.viewRlinesh.intersection(!templine).string().before('U').replace('N', 'Y').replace('S', 'Y').replace('E', 'X').replace('W', 'X')
				handle any
					-- two lines are parellel
				endhandle
			elseif (!dir.eq('left')) then
				!intpt = !!DrawingPlan1.viewLlinesh.intersection(!templine).string().before('U').replace('N', 'Y').replace('S', 'Y').replace('E', 'X').replace('W', 'X')
				handle any
					-- two lines are parellel
				endhandle
			elseif (!dir.eq('down')) then
				!intpt = !!DrawingPlan1.viewDlinesh.intersection(!templine).string().before('U').replace('N', 'Y').replace('S', 'Y').replace('E', 'X').replace('W', 'X')
				handle any
					-- two lines are parellel
				endhandle
			elseif (!dir.eq('up')) then
				!intpt = !!DrawingPlan1.viewUlinesh.intersection(!templine).string().before('U').replace('N', 'Y').replace('S', 'Y').replace('E', 'X').replace('W', 'X')
				handle any
					-- two lines are parellel
				endhandle
			endif
			--------------------------------------------------------------------
			-- !ptok replaces the '$p $!intpt' which used to sit here. that   --
			-- print was what raised the error when the two lines came out    --
			-- parallel and !intpt was left unset, and the handle any below   --
			-- caught it, so commenting the print out let an unset !intpt     --
			-- through to enupos                                              --
			--------------------------------------------------------------------
			!ptok = true
			!ptx = !intpt.part(2).replace('mm', '').real()
			handle any
				------------------------------------------------
				-- no intersection point at all, nothing to do --
				------------------------------------------------
				!ptok = false
			endhandle
			if (!ptok) then
				--------------------------------------------------------------
				-- the border of the view is an endless line as far as       --
				-- intersection() is concerned, so a member which is off the --
				-- side of the view still gives a point, but one which lies  --
				-- outside the view. drop those, or the dimension runs off   --
				-- the drawing                                               --
				--------------------------------------------------------------
				!pty = !intpt.part(4).replace('mm', '').real()
				if (!ptx lt (!vwx1 - 1) or !ptx gt (!vwx2 + 1) or !pty lt (!vwy1 - 1) or !pty gt (!vwy2 + 1)) then
					!ptok = false
				endif
			endif
			if (!ptok) then
				--------------------------------------------------------------------
				-- temporary diagnostic 2026-08-12: prints one line per label that --
				-- actually gets drawn, with the element it is attached to and     --
				-- which TYPE found it, so a label seen on the sheet can be traced --
				-- back to its element without guessing. remove once answered      --
				--------------------------------------------------------------------
				if (!dbgln and !dir.eq('left')) then
					!dbgsrc  = !resultl.split('~').getindexed(3).split('!').getindexed(1)
					!dbgpipe = !resultl.split('~').getindexed(3).split('!').getindexed(5)
					!dbgf.writerecord('LABEL pipe=' & !dbgpipe & ' src=' & !dbgsrc & ' mem=' & !mem & ' type=' & !type & ' mempos=' & !mempos & ' mempossh=' & !mempossh)
				endif
				var !temppos enupos of $!intpt
				!attapos = object position(!temppos)
				--------------------------------------------------------------------
				-- the projection line starts at the member itself, not out at the --
				-- border of the view, so that it can be followed back to what it  --
				-- belongs to. the gridgap below then leaves the same 3mm of the   --
				-- sheet clear of the fitting as it used to leave of the border.   --
				-- a length of tube which crosses the border carries the crossing  --
				-- point as its position, so for those nothing moves               --
				--                                                                 --
				-- equipment is left on the border. its position is the middle of  --
				-- the equipment and a projection line starting there would be     --
				-- drawn right across it                                           --
				--------------------------------------------------------------------
				if (not(!type.eqnocase('EQUI'))) then
					!attapos = object position(!mempos)
				endif
				!attapos = !attapos.offset(!viewdir.direction(), !!DrawingPlan1.gridgap.val / !!DrawingPlan1.vsca )
				if (!type.eqnocase('BRAN')) then
					if (!resultl.split('~').getindexed(3).split('!').getindexed(6).eqnocase('y')) then
						if (!bopu.geq(0)) then
							if (!dir.eq('right') or !dir.eq('down')) then
								NEW DPOI POS $!attapos DDNA $!mem Pltxt '#PIPE(c2:) BOP EL+$!bopu'
							elseif (!dir.eq('left')) then
								NEW DPOI POS $!attapos DDNA $!mem Pltxt '#PIPE(c2:) BOP EL+$!bopu      '
							elseif (!dir.eq('up')) then
								NEW DPOI POS $!attapos DDNA $!mem Pltxt '      #PIPE(c2:) BOP EL+$!bopu'
							endif
						else
							if (!dir.eq('right') or !dir.eq('down')) then
								NEW DPOI POS $!attapos DDNA $!mem Pltxt '#PIPE(c2:) BOP EL$!bopu'
							elseif (!dir.eq('left')) then
								NEW DPOI POS $!attapos DDNA $!mem Pltxt '#PIPE(c2:) BOP EL$!bopu      '
							elseif (!dir.eq('up')) then	
								NEW DPOI POS $!attapos DDNA $!mem Pltxt '      #PIPE(c2:) BOP EL$!bopu'
							endif
						endif
					else
						if (!dir.eq('right') or !dir.eq('down')) then
							NEW DPOI POS $!attapos DDNA $!mem Pltxt '#PIPE(c2:)'
						elseif (!dir.eq('left')) then
							NEW DPOI POS $!attapos DDNA $!mem Pltxt '#PIPE(c2:)      '
						elseif (!dir.eq('up')) then
							NEW DPOI POS $!attapos DDNA $!mem Pltxt '      #PIPE(c2:)'
						endif
					endif
				elseif (!type.eqnocase('EQUI')) then
					if (!dir.eq('right') or !dir.eq('down')) then
						NEW DPOI POS $!attapos DDNA $!mem Pltxt '#EQUI(c2:)'
					elseif (!dir.eq('left')) then
						NEW DPOI POS $!attapos DDNA $!mem Pltxt '#EQUI(c2:)    '
					elseif (!dir.eq('up')) then
						NEW DPOI POS $!attapos DDNA $!mem Pltxt '    #EQUI(c2:)'
					endif
					Ptchtx '4mm'
				else
					if (!resultl.split('~').getindexed(3).split('!').getindexed(6).eqnocase('y')) then
						var !pabop abop of $!mem
						var !plbop lbop of $!mem
						if (abs(!pabop.position().up - !bop) le 5) then
							if (!dir.eq('right') or !dir.eq('down')) then
								NEW DPOI POS $!attapos DDNA $!mem Pltxt '#PIPE(c2:) BOP EL#PABOPU+'
							elseif (!dir.eq('left')) then
								NEW DPOI POS $!attapos DDNA $!mem Pltxt '#PIPE(c2:) BOP EL#PABOPU+      '
							elseif (!dir.eq('up')) then
								NEW DPOI POS $!attapos DDNA $!mem Pltxt '      #PIPE(c2:) BOP EL#PABOPU+'
							endif
						else
							if (!dir.eq('right') or !dir.eq('down')) then
								NEW DPOI POS $!attapos DDNA $!mem Pltxt '#PIPE(c2:) BOP EL#PLBOPU+'
							elseif (!dir.eq('left')) then
								NEW DPOI POS $!attapos DDNA $!mem Pltxt '#PIPE(c2:) BOP EL#PLBOPU+      '
							elseif (!dir.eq('up')) then
								NEW DPOI POS $!attapos DDNA $!mem Pltxt '      #PIPE(c2:) BOP EL#PLBOPU+'
							endif
						endif
					else
						if (!dir.eq('right') or !dir.eq('down')) then
							NEW DPOI POS $!attapos DDNA $!mem Pltxt '#PIPE(c2:)'
						elseif (!dir.eq('left')) then
							NEW DPOI POS $!attapos DDNA $!mem Pltxt '#PIPE(c2:)      '
						elseif (!dir.eq('up')) then
							NEW DPOI POS $!attapos DDNA $!mem Pltxt '      #PIPE(c2:)'
						endif
					endif
				endif
			endif
		enddo
		------------------------------------------------
		-- create dimension for grid                  --
		-- !!DrawingPlan1.allintersections including  --
		-- intersection points between view and grids --
		------------------------------------------------
		do !intersection value !!DrawingPlan1.allintersections
			!checkpt = false
			if (!intersection.split('-').getindexed(1).eqnocase('viewRlinesh') and !dir.eq('right')) then
				!checkpt = true
			elseif (!intersection.split('-').getindexed(1).eqnocase('viewLlinesh') and !dir.eq('left')) then
				!checkpt = true
			elseif (!intersection.split('-').getindexed(1).eqnocase('viewUlinesh') and !dir.eq('up')) then
				!checkpt = true
			elseif (!intersection.split('-').getindexed(1).eqnocase('viewDlinesh') and !dir.eq('down')) then
				!checkpt = true
			endif
			if (!checkpt) then
				!intpt = !intersection.split('-').getindexed(2).before('U').replace('N', 'Y').replace('S', 'Y').replace('E', 'X').replace('W', 'X')
				!ptx = !intpt.part(2).replace('mm', '').real()
				!pty = !intpt.part(4).replace('mm', '').real()
				--------------------------------------------------------------------
				-- a grid line whose ends are inside the view does not reach the   --
				-- border at all, the intersection above comes from the endless    --
				-- line through it, so the dimension ends up with nothing joining  --
				-- it to the grid. reach the point back in to where the grid line  --
				-- really ends, and the gridgap below then leaves the same 3mm of  --
				-- the sheet clear of it as it used to leave of the border         --
				--                                                                 --
				-- only the depth is taken from the end of the grid. the           --
				-- coordinate along the border stays as it was, so the dimension   --
				-- itself does not change                                          --
				--------------------------------------------------------------------
				!nearpt = ''
				!nearpt = !intersection.split('~').getindexed(2).before('U').replace('N', 'Y').replace('S', 'Y').replace('E', 'X').replace('W', 'X')
				handle any
					--------------------------------------------------------------
					-- no end of grid recorded, keep the point on the border    --
					--------------------------------------------------------------
				endhandle
				if (!nearpt.neq('')) then
					if (!dir.eq('right') or !dir.eq('left')) then
						!ptx = min(max(!nearpt.part(2).replace('mm', '').real(), !vwx1), !vwx2)
					else
						!pty = min(max(!nearpt.part(4).replace('mm', '').real(), !vwy1), !vwy2)
					endif
				endif
				!intsh = 'x ' & string(!ptx) & ' y ' & string(!pty)
				var !temppos enupos of $!intsh
				!attapos = object position(!temppos)
				!attapos = !attapos.offset(!viewdir.direction(), !!DrawingPlan1.gridgap.val / !!DrawingPlan1.vsca )
				NEW DPOI POS $!attapos
			endif
		enddo
		
		---------------------------------
		-- create dimension for limits --
		---------------------------------
		$!name/SS/S1/V1/ateLINE_$!dir_R$!!DrawingPlan1.rev
		var !dpois coll all dpoi for ce
		
		if (!dir.eq('right')) then
			var !temppos enupos of $!!DrawingPlan1.viewURsh
		elseif (!dir.eq('left')) then
			var !temppos enupos of $!!DrawingPlan1.viewULsh
		elseif (!dir.eq('down')) then
			var !temppos enupos of $!!DrawingPlan1.viewLLsh
		elseif (!dir.eq('up')) then
			var !temppos enupos of $!!DrawingPlan1.viewULsh
		endif
		
		!attapos = object position(!temppos)
		!attapos = !attapos.offset(!viewdir.direction(), !!DrawingPlan1.gridgap.val / !!DrawingPlan1.vsca )
		!run = true
		do !dpoi value !dpois
			$!dpoi
			var !temppos1 pos
			!attapos1 = object position(!temppos1)
			if (!attapos.distance(!attapos1).lt(5)) then
				!run = false
			endif
		enddo
		if (!run) then
			NEW DPOI POS $!attapos
		endif
		
		if (!dir.eq('right')) then
			var !temppos enupos of $!!DrawingPlan1.viewLRsh
		elseif (!dir.eq('left')) then
			var !temppos enupos of $!!DrawingPlan1.viewLLsh
		elseif (!dir.eq('down')) then
			var !temppos enupos of $!!DrawingPlan1.viewLRsh
		elseif (!dir.eq('up')) then
			var !temppos enupos of $!!DrawingPlan1.viewURsh
		endif
		!attapos = object position(!temppos)
		!run = true
		do !dpoi value !dpois
			$!dpoi
			var !temppos1 pos
			!attapos1 = object position(!temppos1)
			if (!attapos.distance(!attapos1).lt(5)) then
				!run = false
			endif
		enddo
		if (!run) then
			!attapos = !attapos.offset(!viewdir.direction(), !!DrawingPlan1.gridgap.val / !!DrawingPlan1.vsca )
			NEW DPOI POS $!attapos
		endif
		
		OWNER
		SORT DIM
		if (!dir.eq('right') or !dir.eq('up')) then
			DOFFSET 15 $( (10 - $!!DrawingPlan1.griddist.val) $)
		elseif (!dir.eq('left') or !dir.eq('down')) then
			DOFFSET -15
		endif
		
		----------------------------------------------------------
		-- rotate text 90 degree when distance is less than 7mm --
		----------------------------------------------------------
		
		$!name/SS/S1/V1/ateLINE_$!dir_R$!!DrawingPlan1.rev
		!mcount = mcount
		if (!mcount.gt(1)) then
			do !x from 1 to !mcount - 1
				$!x
				var !x1pos pos
				var !x1shpos shpos of $!x1pos
				NEXT
				var !x2pos pos
				var !x2shpos shpos of $!x2pos
				if (!dir.eq('right') or !dir.eq('left')) then
					if (abs(!x1shpos.part(4).replace('mm','').real() - !x2shpos.part(4).replace('mm','').real()) le 7) then
						Dtangle Horizontal
						Dtoftx 'X 0mm Y 4mm'
					else
						Dtangle Vertical
						Dtoftx 'X 0mm Y 2.2mm'
					endif
				else
					if (abs(!x1shpos.part(2).replace('mm','').real() - !x2shpos.part(2).replace('mm','').real()) le 7) then
						Dtangle Vertical
						Dtoftx 'X 0mm Y 4mm'
					else
						Dtangle Horizontal
						Dtoftx 'X 0mm Y 2.2mm'
					endif
				endif
				OWNER
			enddo
		endif
	enddo
	if (!dbgln) then
		!dbgf.close()
	endif
endfunction






$(  


	NEW DPPT ON $!mem Pltxt '#PIPE(c2:)'




  var !mems coll all bran members within $!vlfm to $!vlto
  do !i from 1 to !mems.size()
    !mem = !mems[$!i]
    -----------------------
    -- refer to rcollect --
    -----------------------
    $* filter collection for those items that are in drawlist for view
    if (!mem.matchwild('*ileave tube*')) then
      $* check that IL TUB element exists
      var !existcheck ref of $!mem
      handle any $* IL TUB <1mm or does not exist
        !component = !mem.after('of ')
        var !nexttype type of next of $!component
        handle any
          skip
        endhandle
        if (nexttype.eqnocase('ATTA') then
          var !atta ref of next $!component
          var !mem 'ileave tube of ' & $!atta
        endif
      endhandle
    endif
    var !check IDLN for $!mem
    handle any
      skip
    elsehandle none
      if (!check.eqnocase('INCLUDED')) then
        if (match(|$!ELEM|,|IL TUB|) neq 0) then
          $* check if IL TUB crosses or is contained within 3d volume
          CALLIBM UBOXCHECK $<$!ELEM$> $<$!LIMITS$>
          if ($!!CDRTNSTATUS eq 1) then
            $* assume it does not cross... do not append to array
          else
            if ($!!CDLNRTN) then
              var !!CDCARTN append |$!ELEM|
            else
              $* $!ELEM does not pass through side/box volume
            endif
          endif
        else
          var !!CDCARTN append |$!ELEM|
        endif
      endif
    endhandle
  enddo






  var !brans vscan for all bran
  !pipes = object array()
  do !bran values !brans
    var !isnamed isname of owner of $!bran
    if (!isnamed.boolean()) then
      var !pipe name of pipe of $!bran
      !pipes.append(!pipe)
    endif
  enddo
  !pipes.unique().sort()
--  q var !pipes.size()
  do !pipe values !pipes
    var !mems coll all bran members for $!pipe
    do !i from 1 to !mems.size()
      var !ref ref of $!mems[$!i]
      var !found find $!ref
      if (!found.eqnocase('found')) then
        var !type type of $!ref
--        $p $!type
        var !pos worpos of $!ref
        handle any
--          $p $!pipe
        elsehandle none
          NEW LDIM
  --        DPOS $!pos
          DIR N
          NEW DPOI POS $!pos DDNA $!ref Pltxt '#PIPE'
          break
        endhandle
      endif
    enddo    
  enddo
  
	$p -----------
  do !pipe values !pipes
    $p $!pipe
  enddo
$)  

------------------------------------
-- Function : Line No. Annotation --
-- Auther   : tw tseng            --
-- Date     : 2025/03/09          --
------------------------------------

import 'AteSortLineNo'
handle any
endhandle

--------------------------------------------------------------------------
-- !boxXlen / !boxYlen are no longer used. the width of the bands is now --
-- taken from the size of the view on the sheet, which is right whatever --
-- the box is turned to, and which also gets the swap of xlength and     --
-- ylength in .Apply() right. the two arguments are kept so that nothing --
-- which calls this function has to change                               --
--------------------------------------------------------------------------
define function !!DrawingPlan1LineNoAnnotation(!name is string, !boxXlen is real, !boxYlen is real)
	--------------------------------------------------------------------
	-- update path: this LAYE survives from a previous run, so reuse  --
	-- it instead of erroring on a duplicate name. attribute lines    --
	-- below always reapply, harmless whether the LAYE is new or old  --
	--------------------------------------------------------------------
	$!name/SS/S1/V1/ateLINE
	handle any
		NEW LAYE $!name/SS/S1/V1/ateLINE
	elsehandle none
	endhandle
	--------------------------------------------------------------------
	-- which of the two callers this is. a rebuild always arrives at a  --
	-- freshly made LAYE with no dimension on it yet; an update finds   --
	-- the four sides from the previous run still there. only used to   --
	-- send the diagnostic to its own file per mode, so that a rebuild  --
	-- and the update straight after it can be compared without the     --
	-- second overwriting the first (2026-08-28)                        --
	--------------------------------------------------------------------
	var !exldims coll all ldim for ce
	!isupdaterun = !exldims.size().gt(0)
	--------------------------------------------------------------------
	-- did the box change this run. when it did, the border moves and   --
	-- every point derived from the border has to move with it -- which --
	-- reads exactly like somebody having dragged that point aside, so  --
	-- the "was this dragged by hand" fallbacks below are switched off. --
	-- left on, they reused the old points where they stood and the     --
	-- chain kept its old border: ten points on the left side where     --
	-- seven belonged (2026-08-28)                                      --
	--------------------------------------------------------------------
	!boxchg = true
	!boxchg = !!DrawingPlan1BoxChanged
	handle any
		!boxchg = true
	endhandle
	$!name/SS/S1/V1/ateLINE
	Purpose LINE
	Lvisibility true
	Font 1
	Justification Left
	Alignment Template
	Tsiztx '3mm'
	Chostx '6mm'
	Asubtended 0degree
	Pjustification Towards 
	Oshttx '2mm'
	Plcltx '0mm'
	Doffset 25mm
	Dmsptx '0mm'
	Lleader true
	Lframe true
	Lshape Straight
	Gboxtx '1mm'
	Llcltx '0mm'
	Xyscale 1 1
	Xyposition 25mm 25mm 
	Blnk false
	Bmargin 0mm
	Trsf Nulref
	Txcolour Yellow 
	NLStyle Solid 
	NLColour Cyan 
	FStyle Off 
	FColour Grey 
	LLStyle Solid 
	LLColour Cyan 
	LFStyle Solid 
	LFColour Cyan 
	DLStyle Solid 
	DLColour Cyan 
	PLStyle Solid 
	PLColour Cyan 
	MColour Cyan
	CHStyle Off
	CHColour Grey
  Cheitx '3.00mm'

	--------------------------------------------------------------------
	-- GLABs from a previous run, and every !gelem this run actually   --
	-- ends up drawing a label for (across all four sides) -- used to  --
	-- reuse/move an existing GLAB instead of piling a new one on top  --
	-- of it, and to clean up ones whose element this run never found  --
	--------------------------------------------------------------------
	var !existingglabs coll all glab for ce
	!currentgelems = object array()
	--------------------------------------------------------------------
	-- the actual GLAB objects (not ddna strings) kept or reused this   --
	-- run -- cleanup below must ask "was THIS object claimed", not     --
	-- "does some element with this ddna appear anywhere this run":     --
	-- one ddna can legitimately carry more than one GLAB (see above),  --
	-- so a stale duplicate on a side nothing draws any more survived   --
	-- cleanup just because its own ddna also got used by an unrelated  --
	-- label on another side this run (2026-08-27, reported live: an   --
	-- orphaned right-side GLAB sat on top of its freshly placed        --
	-- replacement, both stillcurrent=TRUE in check.txt)                --
	--------------------------------------------------------------------
	!claimedglabs = object array()

--	var !viewdirup    viewdir up
--	var !viewdirleft  viewdir left
	var !viewdirdown  viewdir down
	var !viewdirright viewdir right
	
	!dirlist = 'right left down up'

	--------------------------------------------------------------------------
	-- diagnostic switch, left in the way DrawingPlan1FlowAnnotation keeps  --
	-- its !dbg. there is far more of this than the command window can      --
	-- hold, so it goes to a file, written the same way as CouplingMto      --
	-- and checkCuttingLength do. reports one side of the view at a time,   --
	-- currently 'up' (2026-08-13, chasing a DPOI with no Pltxt) -- change  --
	-- the '!dir.eq(...)' calls guarding the writerecord lines to move it   --
	--                                                                      --
	-- the LABEL line is the useful one: it prints once per label that is   --
	-- really drawn, with the element and which TYPE found it, so a label   --
	-- on the sheet can be traced back without guessing. that is what found --
	-- the 2026-08-12 view rotation bug                                     --
	--                                                                      --
	-- L: on the machine running E3D is the same folder as D: here          --
	--------------------------------------------------------------------------
	!dbgln = true
	if (!dbgln) then
		if (!isupdaterun) then
			!dbgf = object file('L:\E3D\pdms_prog\E3D2.1\PA_pmllibE3D2.1\check_update.txt')
		else
			!dbgf = object file('L:\E3D\pdms_prog\E3D2.1\PA_pmllibE3D2.1\check_rebuild.txt')
		endif
		!dbgf.open('overwrite')
	endif

	--------------------------------------------------------------------------
	-- diagnostic 2026-09-01: a snapshot of !existingglabs the instant it   --
	-- was collected (line 101, above), before any of the four sides has    --
	-- touched anything. chasing a 660005/right duplicate whose second     --
	-- ddna resolves to a component (a TEE) neither DPOISEQ nor GLABFINAL   --
	-- ever mentions this run -- so either it was already sitting there    --
	-- when this call started (meaning the rebuild moments earlier made    --
	-- it, not this update), or it is not in !existingglabs at all and     --
	-- something else creates it mid-run. this settles which. remove once  --
	-- answered                                                             --
	--------------------------------------------------------------------------
	if (!dbgln) then
		!egn0 = 0
		!egn0 = !existingglabs.size()
		handle any
			!egn0 = -1
		endhandle
		!dbgf.writerecord('EXISTINGGLAB0 count=' & !egn0.string())
		do !eg0 values !existingglabs
			$!eg0
			handle any
				!dbgf.writerecord('EXISTINGGLAB0 entry unreadable ($!eg0 failed)')
			elsehandle none
				!eg0ddna = 'UNSET'
				var !eg0ddna ddna
				handle any
					!eg0ddna = 'ERR'
				endhandle
				!eg0xypo = 'ERR'
				var !eg0xypo xypo
				handle any
					!eg0xypo = 'ERR'
				endhandle
				!dbgf.writerecord('EXISTINGGLAB0 ddna=' & !eg0ddna & ' xypo=' & !eg0xypo)
			endhandle
		enddo
	endif

	----------------------------------------------------------------------------
	-- every GLAB this call touches -- new or reused -- with which direction  --
	-- group it belongs to (right/left along-Y, up/down along-X), so that    --
	-- after LineNoAnnotation returns, DrawingPlan1.pmlfrm's canvas-fit view  --
	-- recenter can nudge each one's XYPO by the same dx/dy it just moved     --
	-- the view by. the view's box (VSEC/FPLA) and DPOI both re-project live  --
	-- off world coordinates and follow the view automatically; GLAB's XYPO  --
	-- is a baked leader offset that does not, which is what left GLAB rows  --
	-- 2.5mm off after rebuild's own recenter fired (found live, 2026-08-27) --
	--                                                                        --
	-- originally only the newly-created ones were collected here, since     --
	-- update never ran the recenter block at all. now that update can also  --
	-- recentre (2026-08-31: rebuild's and update's own view placement must  --
	-- land on the same XYPO/THRO for the same final box -- an existing LDIM --
	-- must sit in the same place with no exceptions, user rule), a REUSED   --
	-- glab needs the same nudge just as much -- its own POSITION/XYPO were  --
	-- computed off the view's position BEFORE this run's recentre moves it, --
	-- same as a brand new one                                               --
	----------------------------------------------------------------------------
	!!DrawingPlan1RunGlabRefs = object array()
	!!DrawingPlan1RunGlabDirs = object array()

	---------------------------------------------------------------------------
	-- the sides of the view are only parallel to E and N when the drawing   --
	-- box is orthogonal to the world. when it is not, .Apply() turns the    --
	-- view with ADEGREES, and a band along one side of the view is then a   --
	-- turned rectangle in the model, which COLLECT ... WITHIN cannot take.  --
	-- so every band below is set out in sheet coordination, where the view  --
	-- is always square, WITHIN is given the world box which contains the    --
	-- band, and .CheckInSheetBand() throws away what that box picks up      --
	-- outside the band itself. this also covers rcode, because the sheet    --
	-- corners of the view are already turned by .Apply()                    --
	---------------------------------------------------------------------------
	!trans = !!DrawingPlan1.ViewSheetTransform()
	!vwx1 = min(!!DrawingPlan1.boxLLsh.part(2).real(), !!DrawingPlan1.boxURsh.part(2).real())
	!vwx2 = max(!!DrawingPlan1.boxLLsh.part(2).real(), !!DrawingPlan1.boxURsh.part(2).real())
	!vwy1 = min(!!DrawingPlan1.boxLLsh.part(4).real(), !!DrawingPlan1.boxURsh.part(4).real())
	!vwy2 = max(!!DrawingPlan1.boxLLsh.part(4).real(), !!DrawingPlan1.boxURsh.part(4).real())

	------------------------------------------------------------------
	-- !result is the array with th correct dimension attach points --
	------------------------------------------------------------------
	!result = object array()
	!!DrawingPlan1.equiparray.clear()
	----------------------------------------------------------------------
	-- how far the annotation of each side reaches past the border of    --
	-- the view, in sheet mm. .Apply() shifts the view by these so that  --
	-- what hangs off it lands inside the canvas instead of off the edge --
	-- of the drawing                                                    --
	----------------------------------------------------------------------
	!!DrawingPlan1.labbandup = 0
	!!DrawingPlan1.labbanddown = 0
	!!DrawingPlan1.labbandleft = 0
	!!DrawingPlan1.labbandright = 0
	do !jj from 1 to 4
		!dir = !dirlist.part(!jj)
		--------------------------------------------------------------------
		-- 2026-08-13: counts every DPOI actually created on this side's   --
		-- LDIM, across the labelled loop, the grid crossings and the two --
		-- corner limits, in creation order -- creation order is what the --
		-- DPOI1, DPOI2 ... names in the Draw Explorer tree reflect. user --
		-- found a DPOI2 whose Q POS (W 311379mm N 310592mm) matches none --
		-- of the 5 labelled crossings this function's own LABEL print    --
		-- accounts for, on a fresh run, so something is creating a DPOI  --
		-- earlier than assumed. remove once answered                    --
		--------------------------------------------------------------------
		!dpoiseq = 0
		-------------------------------------------------------------------------
		-- !dir is the side of the view as it appears on the sheet, and so are  --
		-- the bands, the sorting, the border line to shoot at, the corners of  --
		-- the view, DIR / DOFFSET of the LDIM, the text angle and the padding  --
		-- spaces of Pltxt                                                      --
		--                                                                      --
		-- viewdir gives the model direction which appears to point that way on --
		-- the sheet, so it already follows both ADEGREES and rcode. !viewdir   --
		-- is only used as a model direction, to offset the attach point away   --
		-- from the view and to check the direction of a component. the same    --
		-- applies to !viewdirdown / !viewdirright above, which give DIR of the --
		-- LDIM                                                                 --
		-------------------------------------------------------------------------
		var !viewdir viewdir $!dir
		-------------------------------------------------------------------------
		-- !shdir is !dir in sheet coordination. it is used to shoot a line     --
		-- from the sheet position of a member to the border line of the view,  --
		-- both of them come from shpos, so it must not be taken from viewdir,  --
		-- which is a model direction                                           --
		-------------------------------------------------------------------------
		if (!dir.eq('right')) then
			!shdir = object direction('E')
		elseif (!dir.eq('left')) then
			!shdir = object direction('W')
		elseif (!dir.eq('down')) then
			!shdir = object direction('S')
		elseif (!dir.eq('up')) then
			!shdir = object direction('N')
		endif
		------------------------------------------------------------------------
		-- how deep the bands below reach in from the border, in sheet mm.     --
		-- !banddeep is 33% and !bandshal 10% of the view, as before, and      --
		-- !bandthin is the 10mm of the model which catches whatever crosses   --
		-- the border itself                                                   --
		------------------------------------------------------------------------
		!bandthin = 10 * !!DrawingPlan1.vsca
		if (!dir.eq('right') or !dir.eq('left')) then
			!banddeep = (!vwx2 - !vwx1) * 0.33
			!bandshal = (!vwx2 - !vwx1) * 0.1
		else
			!banddeep = (!vwy2 - !vwy1) * 0.33
			!bandshal = (!vwy2 - !vwy1) * 0.1
		endif
		!j = 1
		!result.clear()

		---------------------------------------------
		-- TYPE 1 situation                        --
		-- find pipes that cross right match line  --
		---------------------------------------------
		!types = object array()
		!band = !!DrawingPlan1.SheetBandOfSide(!dir, !bandthin)
		!wlim = !!DrawingPlan1.WorldLimitsOfSheetRect(!band[1], !band[2], !band[3], !band[4], !trans)
		!bminE = !wlim[1]
		!bminN = !wlim[2]
		!bmaxE = !wlim[3]
		!bmaxN = !wlim[4]
		!vlfm = 'E ' & $!bminE & ' N ' & $!bminN & ' U ' & $!!DrawingPlan1.minU
		!vlto = 'E ' & $!bmaxE & ' N ' & $!bmaxN & ' U ' & $!!DrawingPlan1.maxU

		$!name/SS/S1/V1
		var !mems coll all bran members within $!vlfm to $!vlto
		do !i from 1 to !mems.size()
			!mem = !mems[$!i]
			var !type type of $!mem
			!istube = false
			!tubeelem = ''
			if (!type.matchwild('*TUB*')) then
				!istube = true
				!tubeelem = !mems[$!i]
				var !mem mtbe of $!mems[$!i]
			endif
			if (!dbgln and !dir.eq('left')) then
				!dbgf.writerecord('TYPE1 raw=' & !mems[!i] & ' type=' & !type & ' istube=' & !istube.string() & ' mtbe=' & !mem)
			endif
			var !check IDLN for $!mem
	--      $p $!check
			handle any
	--      skip
			elsehandle none
				var !pipe namn of pipe of $!mem
				if (!check.eqnocase('INCLUDED')) then
					var !type type of $!mem
					if (!type.eqnocase('BRAN')) then
						var !memenupos hpos of $!mem
					else
						var !memenupos worpos of $!mem
					endif
					------------------------------------------------------------------
					-- a length of pipe with no fitting in it is an implied tube,    --
					-- and mtbe above turned it into the branch or the component it  --
					-- leaves from, which can be right across the drawing. so follow --
					-- the tube to where it really crosses the border and dimension  --
					-- there. only the elevation is kept from the element, so that   --
					-- BOP still comes out right                                     --
					--                                                               --
					-- while the box was orthogonal this went unnoticed, because a   --
					-- pipe crossing a border runs square with it and the leader,    --
					-- which is shot square at the border, landed on the right spot  --
					-- anyway. once the box is turned the pipe crosses at an angle   --
					-- and the leader ends up somewhere else along the border, or    --
					-- off the end of it                                             --
					------------------------------------------------------------------
					!useit = true
					if (!istube) then
						!crossenu = !!DrawingPlan1.CrossingOfTube(!tubeelem, !mem, !dir)
						if (!dbgln and !dir.eq('left')) then
							!dbgf.writerecord('TYPE1 tube=' & !tubeelem & ' owner=' & !mem & ' pipe=' & !pipe & ' crossenu=' & !crossenu)
						endif
						----------------------------------------------------------------
						-- every other TYPE1 log in this block only fires for dir=left --
						-- (left over from an unrelated 2026-08-13 investigation), so   --
						-- there was no visibility into what TYPE1 decides for THIS     --
						-- member on the right side at all -- targeted, all-direction   --
						-- log for just this one member while chasing why rebuild and   --
						-- update disagree over it with the box unchanged (2026-08-31)  --
						----------------------------------------------------------------
						if (!dbgln and !mem.matchwild('*660105*B3*')) then
							!dbgf.writerecord('B3CROSS ' & !dir & ' tube=' & !tubeelem & ' owner=' & !mem & ' pipe=' & !pipe & ' crossenu=' & !crossenu)
						endif
						if (!crossenu.eq('NONE')) then
							--------------------------------------------------------
							-- the world box handed to WITHIN is bigger than the  --
							-- band when the view is turned, so a tube which does --
							-- not reach this border can still get this far. it   --
							-- is dropped here, otherwise a pipe which turns near --
							-- the border gets the same line number twice, once   --
							-- from the tube before the bend and once from the    --
							-- tube after it                                      --
							--------------------------------------------------------
							!useit = false
						elseif (!crossenu.neq('')) then
							!crosspos = object position(!crossenu)
							!crosspos.up = !memenupos.position().up
							---------------------------------------------------------------
							-- not !crosspos.string(): a POSITION built with object       --
							-- position(<string>) stringifies back with a 'WRT /*' tail,   --
							-- unlike the plain enupos / hpos / worpos strings used        --
							-- everywhere else in this function. that tail was seen in the --
							-- 2026-08-12 diagnostic output and SHPOS OF is not expected   --
							-- to read past it, so the E / N / U string is built by hand   --
							-- instead                                                     --
							--                                                             --
							-- the sign is written as the opposite compass letter (W/S/D)  --
							-- rather than a minus sign, to match every other position     --
							-- string here -- straight off hpos / worpos / enupos they all  --
							-- come as 'W 366058mm', never 'E -366058mm'. whether the      --
							-- minus form would actually have been rejected was never      --
							-- isolated; this only keeps the format consistent             --
							---------------------------------------------------------------
							if (!crosspos.east geq 0) then
								!epfx = 'E '
								!eval = !crosspos.east
							else
								!epfx = 'W '
								!eval = !crosspos.east * -1
							endif
							if (!crosspos.north geq 0) then
								!npfx = 'N '
								!nval = !crosspos.north
							else
								!npfx = 'S '
								!nval = !crosspos.north * -1
							endif
							if (!crosspos.up geq 0) then
								!upfx = 'U '
								!uval = !crosspos.up
							else
								!upfx = 'D '
								!uval = !crosspos.up * -1
							endif
							!memenupos = !epfx & string(!eval) & ' ' & !npfx & string(!nval) & ' ' & !upfx & string(!uval)
						endif
					endif
					if (!useit) then
						var !memshpos shpos of $!memenupos
						!memshx = !memshpos.split().getindexed(2).replace('mm','').real()
						!memshy = !memshpos.split().getindexed(4).replace('mm','').real()
						-----------------------------------------------------------------------
						-- is this point actually inside the band, checked here instead of    --
						-- via .CheckInSheetBand() on the raw collected item's WVOL. WVOL is   --
						-- world axis aligned; projected through the box's rotation it comes   --
						-- out as a rectangle bigger than the real footprint (a compact        --
						-- fitting turns into an elongated diagonal smear in sheet space), so  --
						-- against !bandthin's paper-thin strip a component that is genuinely  --
						-- outside the box can still have that inflated box graze the strip    --
						-- and pass. a single point cannot be inflated by rotation, and this    --
						-- is also the exact point the annotation ends up placed at (including  --
						-- the crossing-point override above for a tube), so testing it here    --
						-- instead of the raw WVOL is both simpler and more correct             --
						--                                                                      --
						-- found 2026-08-12: Copy-of-100-C-12, confirmed sitting outside the    --
						-- box (blue in the model view), kept passing the WVOL-based band check --
						-- for all of its fittings even though none of them are really at the   --
						-- border                                                               --
						--                                                                      --
						-- !postol guards the points which land exactly on the near edge of    --
						-- the band: a crossing is worked out from the same border line the    --
						-- band starts at, so its sheet coordinate can fall a hair either side --
						-- of !band[1] depending on which way round the arithmetic went.       --
						-- 0.01mm is far below anything geometrically meaningful here          --
						-----------------------------------------------------------------------
						!postol = 0.01
						!inband = true
						if (!memshx.lt(!band[1] - !postol) or !memshx.gt(!band[3] + !postol) or !memshy.lt(!band[2] - !postol) or !memshy.gt(!band[4] + !postol)) then
							!inband = false
						endif
						if (!dbgln and !dir.eq('left')) then
							!dbgf.writerecord('TYPE1 CHECK pipe=' & !pipe & ' inband=' & !inband.string() & ' memshx=' & !memshx.string() & ' memshy=' & !memshy.string() & ' band=' & !band[1].string() & ' ' & !band[2].string() & ' ' & !band[3].string() & ' ' & !band[4].string())
						endif
						if (!dbgln and !mem.matchwild('*660105*B3*')) then
							!dbgf.writerecord('B3INBAND ' & !dir & ' pipe=' & !pipe & ' inband=' & !inband.string() & ' memshx=' & !memshx.string() & ' memshy=' & !memshy.string() & ' band=' & !band[1].string() & ' ' & !band[2].string() & ' ' & !band[3].string() & ' ' & !band[4].string())
						endif
						if (!inband) then
							----------------------------------------------------------------
							-- y is the key of hashtable in .Net and cannot be duplicated --
							-- so a small value needs to be added to identify it          --
							----------------------------------------------------------------
							!x = !memshx + 0.0000000001 * !j
							!y = !memshy + 0.0000000001 * !j
							!memstr = !y & '~' & !x & '~type1!' & !memenupos & '!' & !memshpos & '!' & !mem & '!' & !pipe & '!y'
							!result[!j] = !memstr
							!j = !j + 1
							if (!dbgln and !dir.eq('left')) then
								!dbgf.writerecord('TYPE1 KEPT pipe=' & !pipe & ' memenupos=' & !memenupos & ' memshpos=' & !memshpos)
							endif
						endif
					endif
				elseif (!dbgln and !dir.eq('left')) then
					----------------------------------------------------------------
					-- !inband is no longer set at the top of this loop, so it is  --
					-- not printed here -- referring to it before the band test    --
					-- runs would raise 'Variable INBAND not defined' on the very  --
					-- first member that is not in the drawlist                    --
					----------------------------------------------------------------
					!dbgf.writerecord('TYPE1 SKIPPED check=' & !check & ' mem=' & !mem)
				endif
			endhandle
		enddo
		
		--------------------------------------------
		-- sort !sortedtypes by y or x coordinate --
		--------------------------------------------
		using namespace 'Aveva.Core.Samples'
		!obj = object AteSortLineNo()
		if (!dir.eq('right') or !dir.eq('left')) then
			!sortedtypes = !obj.method('y', !result)
		else
			!sortedtypes = !obj.method('x', !result)
		endif
		
		-----------------------------------------------------------------------
		-- remove the distance between type 2,3,4 and type1 is less then 4mm --
		-----------------------------------------------------------------------
		!newresult = object array()
		do !i from 1 to !sortedtypes.size()
			!del = true
			!ipipe = !sortedtypes[!i].split('~').getindexed(3).split('!').getindexed(5)
			do !ii from 1 to !newresult.size()
				--------------------------------------------------------------------
				-- same pipe check added 2026-08-31. this 1mm proximity test used  --
				-- to fire on position alone, so two DIFFERENT pipes that happen   --
				-- to cross the border within 1mm of each other got treated as the --
				-- same crossing counted twice, and only whichever sorted first    --
				-- survived. with the box unchanged, rebuild kept one pipe's       --
				-- crossing (0150CB04_CSL_0080_P_660507) and update kept the       --
				-- other's (02.5HD01_AG_0600_T_660105) at the same slot -- their   --
				-- sheet y differed by only 0.34mm in one run, well inside this    --
				-- 1mm net, and which of the two sorted first flipped between runs --
				-- (2026-08-31). the same-pipe requirement is exactly the rule     --
				-- from the 4mm cluster dedup below: a pipe can be counted once,   --
				-- but never merged into a different pipe's point                 --
				--------------------------------------------------------------------
				!iipipe = !newresult[!ii].split('~').getindexed(3).split('!').getindexed(5)
				if (!ipipe.eq(!iipipe)) then
					if (!dir.eq('right') or !dir.eq('left')) then
						if (abs(!sortedtypes[!i].split('~').getindexed(1).real() - !newresult[!ii].split('~').getindexed(1).real()) le 1) then
							!del = false
						endif
					else
						if (abs(!sortedtypes[!i].split('~').getindexed(2).real() - !newresult[!ii].split('~').getindexed(2).real()) le 1) then
							!del = false
						endif
					endif
				endif
			enddo
			if (!del) then
				!newresult.append(!sortedtypes[!i])
			endif
		enddo
		!result = !newresult
		
		-------------------------------------------------------------
		-- j is the index of collection for dimension attach point --
		-- never initial it later                                  --
		-------------------------------------------------------------
		!j = 1

		---------------------------------------------
		-- TYPE 2a situation                       --
		-- find pipes that cross upper match line  --
		---------------------------------------------
		!band = !!DrawingPlan1.SheetBandOfSide(!dir, !banddeep)
		!wlim = !!DrawingPlan1.WorldLimitsOfSheetRect(!band[1], !band[2], !band[3], !band[4], !trans)
		!bminE = !wlim[1]
		!bminN = !wlim[2]
		!bmaxE = !wlim[3]
		!bmaxN = !wlim[4]
		!tempvl  = !!DrawingPlan1.maxU - 10
		!vlfm = 'E ' & $!bminE & ' N ' & $!bminN & ' U ' & $!tempvl
		!vlto = 'E ' & $!bmaxE & ' N ' & $!bmaxN & ' U ' & $!!DrawingPlan1.maxU

		$!name/SS/S1/V1
		var !mems coll all bran members within $!vlfm to $!vlto
		do !i from 1 to !mems.size()
			!mem = !mems[$!i]
			var !type type of $!mem
			if (!type.matchwild('*TUB*')) then
				var !mem mtbe of $!mems[$!i]
			endif
			var !check IDLN for $!mem
	--      $p $!check
			handle any
	--      skip
			elsehandle none
				var !pipe namn of pipe of $!mem
				if (!check.eqnocase('INCLUDED')) then
					var !type type of $!mem
					if (!type.eqnocase('BRAN')) then
						var !memenupos hpos of $!mem
					else
						var !memenupos worpos of $!mem
					endif
					var !memshpos shpos of $!memenupos
					!memshx = !memshpos.split().getindexed(2).replace('mm','').real()
					!memshy = !memshpos.split().getindexed(4).replace('mm','').real()
					--------------------------------------------------------------
					-- the point is tested against the band rather than the WVOL --
					-- of the raw collected item, for the reason set out in full --
					-- in TYPE 1 above                                           --
					--------------------------------------------------------------
					!postol = 0.01
					!inband = true
					if (!memshx.lt(!band[1] - !postol) or !memshx.gt(!band[3] + !postol) or !memshy.lt(!band[2] - !postol) or !memshy.gt(!band[4] + !postol)) then
						!inband = false
					endif
					if (!inband) then
						!x = !memshx + 0.0000000001 * !j
						!y = !memshy + 0.0000000001 * !j
						!memstr = !y & '~' & !x & '~type2a!' & !memenupos & '!' & !memshpos & '!' & !mem & '!' & !pipe
						!types[!j] = !memstr
						!j = !j + 1
						if (!dbgln and !dir.eq('left')) then
							!dbgf.writerecord('TYPE2A KEPT pipe=' & !pipe & ' mem=' & !mem & ' memshx=' & !memshx.string() & ' memshy=' & !memshy.string())
						endif
					endif
				endif
			endhandle
		enddo
		
		---------------------------------------------
		-- TYPE 2b situation                       --
		-- find pipes that cross lower match line  --
		---------------------------------------------
		!band = !!DrawingPlan1.SheetBandOfSide(!dir, !banddeep)
		!wlim = !!DrawingPlan1.WorldLimitsOfSheetRect(!band[1], !band[2], !band[3], !band[4], !trans)
		!bminE = !wlim[1]
		!bminN = !wlim[2]
		!bmaxE = !wlim[3]
		!bmaxN = !wlim[4]
		!tempvl  = !!DrawingPlan1.minU + 10
		!vlfm = 'E ' & $!bminE & ' N ' & $!bminN & ' U ' & $!!DrawingPlan1.minU
		!vlto = 'E ' & $!bmaxE & ' N ' & $!bmaxN & ' U ' & $!tempvl

		$!name/SS/S1/V1
		var !mems coll all bran members within $!vlfm to $!vlto
		do !i from 1 to !mems.size()
			!mem = !mems[$!i]
			var !type type of $!mem
			if (!type.matchwild('*TUB*')) then
				var !mem mtbe of $!mems[$!i]
			endif
			var !check IDLN for $!mem
	--      $p $!check
			handle any
	--      skip
			elsehandle none
				var !pipe namn of pipe of $!mem
				if (!check.eqnocase('INCLUDED')) then
					var !type type of $!mem
					if (!type.eqnocase('BRAN')) then
						var !memenupos hpos of $!mem
					else
						var !memenupos worpos of $!mem
					endif
					var !memshpos shpos of $!memenupos
					!memshx = !memshpos.split().getindexed(2).replace('mm','').real()
					!memshy = !memshpos.split().getindexed(4).replace('mm','').real()
					--------------------------------------------------------------
					-- the point is tested against the band rather than the WVOL --
					-- of the raw collected item, for the reason set out in full --
					-- in TYPE 1 above                                           --
					--------------------------------------------------------------
					!postol = 0.01
					!inband = true
					if (!memshx.lt(!band[1] - !postol) or !memshx.gt(!band[3] + !postol) or !memshy.lt(!band[2] - !postol) or !memshy.gt(!band[4] + !postol)) then
						!inband = false
					endif
					if (!inband) then
						!x = !memshx + 0.0000000001 * !j
						!y = !memshy + 0.0000000001 * !j
						!memstr = !y & '~' & !x & '~type2b!' & !memenupos & '!' & !memshpos & '!' & !mem & '!' & !pipe
						!types[!j] = !memstr
						!j = !j + 1
						if (!dbgln and !dir.eq('left')) then
							!dbgf.writerecord('TYPE2B KEPT pipe=' & !pipe & ' mem=' & !mem & ' memshx=' & !memshx.string() & ' memshy=' & !memshy.string())
						endif
					endif
				endif
			endhandle
		enddo

		------------------------------------
		-- TYPE 3 situation               --
		-- find elbows within view limit  --
		------------------------------------
		!tempvl  = !!DrawingPlan1.minU + 10
		!tempvl1  = !!DrawingPlan1.maxU - 10
		!band = !!DrawingPlan1.SheetBandOfSide(!dir, !banddeep)
		!wlim = !!DrawingPlan1.WorldLimitsOfSheetRect(!band[1], !band[2], !band[3], !band[4], !trans)
		!bminE = !wlim[1]
		!bminN = !wlim[2]
		!bmaxE = !wlim[3]
		!bmaxN = !wlim[4]
		!vlfm = 'E ' & $!bminE & ' N ' & $!bminN & ' U ' & $!tempvl
		!vlto = 'E ' & $!bmaxE & ' N ' & $!bmaxN & ' U ' & $!tempvl1

		$!name/SS/S1/V1
		var !mems coll all elbo within $!vlfm to $!vlto
		do !i from 1 to !mems.size()
			!mem = !mems[$!i]
			var !check IDLN for $!mem
	--      $p $!check
			handle any
	--      skip
			elsehandle none
				var !pipe namn of pipe of $!mem
				if (!check.eqnocase('INCLUDED')) then
					var !memenupos worpos of $!mem
					var !memshpos shpos of $!memenupos
					!memshx = !memshpos.split().getindexed(2).replace('mm','').real()
					!memshy = !memshpos.split().getindexed(4).replace('mm','').real()
					--------------------------------------------------------------
					-- the point is tested against the band rather than the WVOL --
					-- of the raw collected item, for the reason set out in full --
					-- in TYPE 1 above                                           --
					--------------------------------------------------------------
					!postol = 0.01
					!inband = true
					if (!memshx.lt(!band[1] - !postol) or !memshx.gt(!band[3] + !postol) or !memshy.lt(!band[2] - !postol) or !memshy.gt(!band[4] + !postol)) then
						!inband = false
					endif
					if (!inband) then
						!x = !memshx + 0.0000000001 * !j
						!y = !memshy + 0.0000000001 * !j
						!memstr = !y & '~' & !x & '~type3!' & !memenupos & '!' & !memshpos & '!' & !mem & '!' & !pipe
						!types[!j] = !memstr
						!j = !j + 1
						if (!dbgln and !dir.eq('left')) then
							!dbgf.writerecord('TYPE3 KEPT pipe=' & !pipe & ' mem=' & !mem & ' memshx=' & !memshx.string() & ' memshy=' & !memshy.string())
						endif
					endif
				endif
			endhandle
		enddo
		
		----------------------------------------
		-- find euqipments within view limit  --
		----------------------------------------
		!band = !!DrawingPlan1.SheetBandOfSide(!dir, !bandshal)
		!wlim = !!DrawingPlan1.WorldLimitsOfSheetRect(!band[1], !band[2], !band[3], !band[4], !trans)
		!bminE = !wlim[1]
		!bminN = !wlim[2]
		!bmaxE = !wlim[3]
		!bmaxN = !wlim[4]
		!vlfm = 'E ' & $!bminE & ' N ' & $!bminN & ' U ' & $!tempvl
		!vlto = 'E ' & $!bmaxE & ' N ' & $!bmaxN & ' U ' & $!tempvl1
		var !mems coll all equi with (not(matchwild(name, |*_DrawingPlan|))) within $!vlfm to $!vlto
		do !i from 1 to !mems.size()
			!mem = !mems[$!i]
			--------------------------------------------------------------
			-- only named equipment is dimensioned. an unnamed one has   --
			-- nothing to put in a label, and its NAME is an auto        --
			-- reference which is not the same thing twice, so it could  --
			-- never be matched back on an update either (user rule,     --
			-- 2026-08-28). EquiAnnotation skips the same ones, which it --
			-- has to do for itself: it labels exactly what is NOT in    --
			-- equiparray, so dropping one here would otherwise hand it  --
			-- a GLAB instead of a dimension                             --
			--------------------------------------------------------------
			!equinamed = 'FALSE'
			var !equinamed isnamed of $!mem
			handle any
				!equinamed = 'FALSE'
			endhandle
			if (not(!equinamed.boolean())) then
				skip
			endif
			!inband = !!DrawingPlan1.CheckInSheetBand(!mem, !band, !trans)
			var !check IDLN for $!mem
			handle any
			elsehandle none
				var !equi namn of $!mem
				if (!check.eqnocase('INCLUDED') and !inband) then
					---------------------------------------------------------------
					-- check if most volume of equipment is within view boundary --
					-- the equipment has to reach at least 10mm of the sheet in  --
					-- from the border, measured on the sheet so that it still   --
					-- works when the view is turned                             --
					---------------------------------------------------------------
					var !wvol wvol of $!mem
					!memlim = !!DrawingPlan1.SheetLimitsOfVolume(!wvol, !trans)
					!checkwvol = false
					--------------------------------------------------------------------
					-- snapped to 2 decimals before the geq 10 test. !vwx1/!vwx2/!vwy1/ --
					-- !vwy2 and !memlim both come out of ViewSheetTransform()'s chain   --
					-- of matrix ops, run fresh by rebuild and by update, and an         --
					-- equipment sitting close enough to the border that this reach      --
					-- lands within a rounding error of 10 is a coin flip between the    --
					-- two: same box, nothing changed, rebuild and update disagreed over --
					-- whether it should be dimensioned at all (2026-08-31,              --
					-- /02.5HD01_AG_0600_T_660105/B3, reach right at 10mm). 0.01mm of    --
					-- snapping cannot flip a genuine "clearly under 10" or "clearly     --
					-- over 10" case, only settle one already balanced on the line       --
					--------------------------------------------------------------------
					if (!dir.eq('right')) then
						!wreach = !vwx2 - !memlim[1]
						if (!wreach.string('D2').real() geq 10)  then
							!checkwvol = true
						endif
					elseif (!dir.eq('left')) then
						!wreach = !memlim[3] - !vwx1
						if (!wreach.string('D2').real() geq 10)  then
							!checkwvol = true
						endif
					elseif (!dir.eq('down')) then
						!wreach = !memlim[4] - !vwy1
						if (!wreach.string('D2').real() geq 10)  then
							!checkwvol = true
						endif
					elseif (!dir.eq('up')) then
						!wreach = !vwy2 - !memlim[2]
						if (!wreach.string('D2').real() geq 10)  then
							!checkwvol = true
						endif
					endif
					if (!dbgln) then
						!dbgf.writerecord('EQUIWVOL ' & !dir & ' equi=' & !equi & ' wreach=' & !wreach.string() & ' checkwvol=' & !checkwvol.string() & ' vwx1=' & !vwx1.string() & ' vwx2=' & !vwx2.string() & ' vwy1=' & !vwy1.string() & ' vwy2=' & !vwy2.string() & ' memlim=' & !memlim[1].string() & ' ' & !memlim[2].string() & ' ' & !memlim[3].string() & ' ' & !memlim[4].string())
					endif
					if (!checkwvol) then
						var !memenupos worpos of $!mem
						var !memshpos shpos of $!memenupos
						-------------------------------------------------------
						-- check if pos of equipment is within view boundary --
						-- along the side the annotation is drawn on         --
						-------------------------------------------------------
						!memx = !memshpos.split().getindexed(2).replace('mm','').real()
						!memy = !memshpos.split().getindexed(4).replace('mm','').real()
						!checkwvol = false
						if (!dir.eq('right') or !dir.eq('left')) then
							if (!memy lt !vwy2 and !memy gt !vwy1) then
								!checkwvol = true
							endif
						elseif (!dir.eq('down') or !dir.eq('up')) then
							if (!memx lt !vwx2 and !memx gt !vwx1) then
								!checkwvol = true
							endif
						endif
						if (!checkwvol) then
							!x = !memshpos.split().getindexed(2).replace('mm','').real() + 0.0000000001 * !j
							!y = !memshpos.split().getindexed(4).replace('mm','').real() + 0.0000000001 * !j
							!memstr = !y & '~' & !x & '~type1!' & !memenupos & '!' & !memshpos & '!' & !mem & '!' & !equi
							!result.append(!memstr)
							!!DrawingPlan1.equiparray.append(!equi)
						endif
					endif
				endif
			endhandle
		enddo		
		
		
		-------------------------------------------
		-- TYPE 4 situation                      --
		-- find bran href/tref is unset and      --
		-- hdir/tdir opposite to view direction  --
		-- and hpos/tpos is within view limit    --
		-------------------------------------------
		$!name/SS/S1/V1
		var !mems coll all bran with unset(href) or unset(tref) within $!vlfm to $!vlto
		do !i from 1 to !mems.size()
			!mem = !mems[$!i]
			var !pipe namn of pipe of $!mem
			var !hdir hdir of $!mem
			var !tdir tdir of $!mem
			!hdir1 = object direction(!hdir)
			!tref1 = object direction(!tdir)
			--------------------------------------------------------------------
			-- the head / tail has to be inside the view. east and north are  --
			-- no use for that when the view is turned, so the sheet position --
			-- is checked against the sheet rectangle of the view instead     --
			--------------------------------------------------------------------
			if (!hdir1.opposite().eq(object direction(!viewdir))) then
				var !memenupos hpos of $!mem
				!memenupos1 = object position(!memenupos)
				var !memshpos shpos of $!memenupos
				!memx = !memshpos.split().getindexed(2).replace('mm','').real()
				!memy = !memshpos.split().getindexed(4).replace('mm','').real()
				if (!memx lt !vwx2 and !memx gt !vwx1) then
					if (!memy lt !vwy2 and !memy gt !vwy1) then
						if (!memenupos1.up lt !!DrawingPlan1.maxU and !memenupos1.up gt !!DrawingPlan1.minU) then
							!x = !memx + 0.0000000001 * !j
							!y = !memy + 0.0000000001 * !j
							!memstr = !y & '~' & !x & '~type4!' & !memenupos & '!' & !memshpos & '!' & !mem & '!' & !pipe
							!types[!j] = !memstr
							!j = !j + 1
						endif
					endif
				endif
			endif
			if (!tref1.opposite().eq(object direction(!viewdir))) then
				var !memenupos tpos of $!mem
				!memenupos1 = object position(!memenupos)
				var !memshpos shpos of $!memenupos
				!memx = !memshpos.split().getindexed(2).replace('mm','').real()
				!memy = !memshpos.split().getindexed(4).replace('mm','').real()
				if (!memx lt !vwx2 and !memx gt !vwx1) then
					if (!memy lt !vwy2 and !memy gt !vwy1) then
						if (!memenupos1.up lt !!DrawingPlan1.maxU and !memenupos1.up gt !!DrawingPlan1.minU) then
							!x = !memx + 0.0000000001 * !j
							!y = !memy + 0.0000000001 * !j
							!memstr = !y & '~' & !x & '~type4!' & !memenupos & '!' & !memshpos & '!' & !mem & '!' & !pipe
							!types[!j] = !memstr
							!j = !j + 1
						endif
					endif
				endif
			endif
		enddo
		
		$(
		do !i from 1 to !types.size()
			$p $!types[$!i]
		enddo
		$p >>>>>>>>>>>>>>>>>>
		$)

		---------------------------------------
		-- sort !sortedtypes by y coordinate --
		---------------------------------------
		using namespace 'Aveva.Core.Samples'
		!obj = object AteSortLineNo()
		if (!dir.eq('right') or !dir.eq('left')) then
			!sortedtypes = !obj.method('y', !types)
		else
			!sortedtypes = !obj.method('x', !types)
		endif
		
		-----------------------------------------------------------------------
		-- remove the distance between type 2,3,4 and type1 is less then 4mm --
		-----------------------------------------------------------------------
		----------------------------------------------------------------------
		-- temporary diagnostic 2026-08-28: two points which existed on the  --
		-- right LDIM after a rebuild were simply not collected at all by    --
		-- the next update -- they never reached the DPOI matching, so they  --
		-- were deleted as orphans and their dimension segment vanished.     --
		-- this logs the three places a member can be dropped between being  --
		-- found and becoming a dimension point: the raw sorted list, the    --
		-- "too close to a type1 point" filter, and the clustering which    --
		-- keeps only one representative per 4mm. remove once answered       --
		----------------------------------------------------------------------
		if (!dbgln) then
			do !i from 1 to !sortedtypes.size()
				!dbgf.writerecord('TYPESRAW ' & !dir & ' i=' & !i.string() & ' y=' & !sortedtypes[!i].split('~').getindexed(1) & ' x=' & !sortedtypes[!i].split('~').getindexed(2) & ' mem=' & !sortedtypes[!i].split('~').getindexed(3).split('!').getindexed(4))
			enddo
			do !i from 1 to !result.size()
				!dbgf.writerecord('RESULTRAW ' & !dir & ' i=' & !i.string() & ' y=' & !result[!i].split('~').getindexed(1) & ' x=' & !result[!i].split('~').getindexed(2) & ' mem=' & !result[!i].split('~').getindexed(3).split('!').getindexed(4))
			enddo
		endif
		!dels = object array()
		do !i from 1 to !sortedtypes.size()
			!del = false
			do !ii from 1 to !result.size()
				if (!dir.eq('right') or !dir.eq('left')) then
					if (abs(!sortedtypes[!i].split('~').getindexed(1).real() - !result[!ii].split('~').getindexed(1).real()) le 4) then
						!del = true
						if (!dbgln) then
							!dbgf.writerecord('TYPESDEL ' & !dir & ' i=' & !i.string() & ' mem=' & !sortedtypes[!i].split('~').getindexed(3).split('!').getindexed(4) & ' y=' & !sortedtypes[!i].split('~').getindexed(1) & ' clashes result i=' & !ii.string() & ' mem=' & !result[!ii].split('~').getindexed(3).split('!').getindexed(4) & ' y=' & !result[!ii].split('~').getindexed(1))
						endif
					endif
				else
					if (abs(!sortedtypes[!i].split('~').getindexed(2).real() - !result[!ii].split('~').getindexed(2).real()) le 4) then
						!del = true
						if (!dbgln) then
							!dbgf.writerecord('TYPESDEL ' & !dir & ' i=' & !i.string() & ' mem=' & !sortedtypes[!i].split('~').getindexed(3).split('!').getindexed(4) & ' x=' & !sortedtypes[!i].split('~').getindexed(2) & ' clashes result i=' & !ii.string() & ' mem=' & !result[!ii].split('~').getindexed(3).split('!').getindexed(4) & ' x=' & !result[!ii].split('~').getindexed(2))
						endif
					endif
				endif
			enddo
			if (!del) then
				!dels.append(!i)
			endif
		enddo
		do !i from !dels.size() to 1 by -1
			!sortedtypes.remove(!dels[!i])
		enddo
		
	$(
		do !i from 1 to !sortedtypes.size()
			$p $!sortedtypes[$!i]
		enddo
			$p -----------------------
	$)
		
		-------------------------------------------------------
		-- determin which dimension attach point is correct  --
		-- when dimension left/right with same y coordinate  --
		-- or up/down with same x coordinate                 --
		-------------------------------------------------------
		!temp1s = object array()
		!i = 1
		do !go
			break if (!i gt !sortedtypes.size())		
			!temp = !sortedtypes[!i]
			!temp1s.clear()
			!temp1s.append(!temp)
			!ii = !i + 1
			do !go1
				break if (!ii gt !sortedtypes.size())
				if (!dir.eq('right') or !dir.eq('left')) then
					if (abs(!sortedtypes[!ii].split('~').getindexed(1).real() - !temp.split('~').getindexed(1).real()) le 4) then
						!temp1s.append(!sortedtypes[!ii])
						!ii = !ii + 1
					else
						break
					endif
				elseif (!dir.eq('down') or !dir.eq('up')) then
					if (abs(!sortedtypes[!ii].split('~').getindexed(2).real() - !temp.split('~').getindexed(2).real()) le 4) then
						!temp1s.append(!sortedtypes[!ii])
						!ii = !ii + 1
					else
						break
					endif
				endif
			enddo
	$(
			$p >>>>>>>>>>>>>>>>>
			do !temp1 values !temp1s
				$p $!temp1
			enddo
	$)
			if (!dbgln) then
				do !tt from 1 to !temp1s.size()
					!dbgf.writerecord('CLUSTER ' & !dir & ' at=' & !i.string() & ' member=' & !tt.string() & ' of=' & !temp1s.size().string() & ' y=' & !temp1s[!tt].split('~').getindexed(1) & ' x=' & !temp1s[!tt].split('~').getindexed(2) & ' mem=' & !temp1s[!tt].split('~').getindexed(3).split('!').getindexed(4))
				enddo
			endif
			--------------------------------------------------------------------
			-- every PIPE in the group gets its own dimension point -- but a  --
			-- single pipe can appear more than once in !temp1s (eg a type1   --
			-- tube crossing and a type3 elbow of the same pipe within 4mm    --
			-- of each other), and that is still just one pipe, not two, so   --
			-- it still collapses to one point. user rule, 2026-08-31: only   --
			-- DIFFERENT pipes crowded together must not be merged; the same  --
			-- pipe showing up twice in one cluster is a duplicate, not two   --
			-- pipes, and was silently deduped by the old per-pipe picking    --
			-- logic that this session's earlier edit accidentally dropped   --
			-- along with the cross-pipe merge it was also doing             --
			--------------------------------------------------------------------
			!pipeorder = object array()
			!pipegroups = object array()
			do !tt from 1 to !temp1s.size()
				!mpipe = !temp1s[!tt].split('~').getindexed(3).split('!').getindexed(5)
				!foundpipe = false
				do !gi from 1 to !pipeorder.size()
					if (!pipeorder[!gi].eq(!mpipe)) then
						!pipegroups[!gi].append(!temp1s[!tt])
						!foundpipe = true
						break
					endif
				enddo
				if (not(!foundpipe)) then
					!pipeorder.append(!mpipe)
					!newpipegroup = object array()
					!newpipegroup.append(!temp1s[!tt])
					!pipegroups.append(!newpipegroup)
				endif
			enddo
			do !gi from 1 to !pipegroups.size()
				if (!pipegroups[!gi].size() eq 1) then
					!result.append(!pipegroups[!gi][1])
				else
					if (!dir.eq('right')) then
						!result.append(!!DrawingPlan1.CheckDimensionAttachPoint('x', 'max', !pipegroups[!gi], !viewdir))
					elseif (!dir.eq('left')) then
						!result.append(!!DrawingPlan1.CheckDimensionAttachPoint('x', 'min', !pipegroups[!gi], !viewdir))
					elseif (!dir.eq('down')) then
						!result.append(!!DrawingPlan1.CheckDimensionAttachPoint('y', 'min', !pipegroups[!gi], !viewdir))
					elseif (!dir.eq('up')) then
						!result.append(!!DrawingPlan1.CheckDimensionAttachPoint('y', 'max', !pipegroups[!gi], !viewdir))
					endif
				endif
			enddo

			!i = !ii
		enddo
		
		$!name/SS/S1/V1/ateLINE

		--------------------------------------------------------------------
		-- update path: this side's LDIM survives from a previous run, so --
		-- reuse it instead of erroring on a duplicate name. rebuild path --
		-- always finds nothing here (the LAYE above was just created     --
		-- fresh), so this always falls through to NEW LDIM there         --
		--------------------------------------------------------------------
		!ldimexisted = true
		$!name/SS/S1/V1/ateLINE_$!dir
		handle any
			NEW LDIM $!name/SS/S1/V1/ateLINE_$!dir
			!ldimexisted = false
		elsehandle none
		endhandle
		!ldimref = ce
		Dtangle par
	--		Dlcntmode 'on'-----------------------------------------------------------------------------------------------------
		Tsiztx '2mm'
		Dterid 8103
		Fterid 8103
		if (!dir.eq('right') or !dir.eq('left')) then
			DIR $!viewdirdown
		elseif (!dir.eq('down') or !dir.eq('up')) then
			DIR $!viewdirright
		endif

		--------------------------------------------------------------------
		-- points already on this LDIM from a previous run. matched below --
		-- by DDNA (labelled/EQUI/tube-crossing points) or by position    --
		-- (grid crossings and corners, which carry no DDNA) so a point   --
		-- close enough to what this run would create is left alone       --
		-- instead of getting a duplicate piled on top of it              --
		--------------------------------------------------------------------
		var !existingdpois coll all dpoi for ce
		--------------------------------------------------------------------
		-- where this side's dimension LINE already sits, in sheet mm,     --
		-- read while everything is still as the last run left it.         --
		--                                                                  --
		-- the line is DOFFSET away from the chain's FIRST point, and the   --
		-- members are still in the order last run's SORT DIM left them in, --
		-- so member 1 is that point: its depth plus DOFFSET is where the   --
		-- line is. nothing is assumed about where a point 'ought' to sit   --
		-- -- an earlier attempt took the innermost existing point as the   --
		-- depth and picked up a labelled member's own DPOI instead, which  --
		-- pulled all four chains 35-47mm inward (reported live 2026-08-29) --
		--                                                                  --
		-- consumed by the DOFFSET block far below. anything unreadable     --
		-- leaves !hasfrozen false and the nominal 15 stays in charge       --
		--------------------------------------------------------------------
		!frozendepth = 0
		!hasfrozen = false
		if (!ldimexisted) then
			!exdoffs = 'BAD'
			var !exdoffs doffset
			handle any
				!exdoffs = 'BAD'
			endhandle
			if (not(!exdoffs.eq('BAD'))) then
				!gfx = 1
				$!gfx
				handle any
				elsehandle none
					var !expos pos
					var !exposh shpos of $!expos
					if (!dir.eq('right') or !dir.eq('left')) then
						!exdepth = !exposh.split().getindexed(2).replace('mm','').real()
					else
						!exdepth = !exposh.split().getindexed(4).replace('mm','').real()
					endif
					!frozendepth = !exdepth + !exdoffs.replace('mm','').real()
					handle any
					elsehandle none
						!hasfrozen = true
					endhandle
				endhandle
			endif
			$!name/SS/S1/V1/ateLINE_$!dir
			if (!dbgln) then
				!dbgf.writerecord('DIMBASE ' & !dir & ' doffread=' & !exdoffs & ' frozenline=' & !frozendepth.string() & ' ok=' & !hasfrozen.string())
			endif
		endif
		--------------------------------------------------------------------
		-- the actual DPOI objects reused this run, same reasoning as       --
		-- !claimedglabs above -- cleanup below asks "was THIS object       --
		-- claimed", not "does some member with this ddna appear anywhere   --
		-- this run", since one ddna can legitimately carry more than one   --
		-- DPOI (two tube crossings of the same elbow)                      --
		--------------------------------------------------------------------
		!claimeddpois = object array()

		----------------------------------------------------------------------
		-- every point put on this side's dimension, by the coordinate it   --
		-- falls on ALONG the dimension direction (sheet y for the left and --
		-- right sides, sheet x for up and down). two points sharing that   --
		-- coordinate measure 0 between them, which is what put a 0         --
		-- dimension and a projection line right across the drawing next to --
		-- grid H and grid 18 (2026-08-21) -- a pipe running along a grid   --
		-- line, dimensioned once as a labelled point and again as the grid --
		-- crossing. the grid crossings and the two view corners are        --
		-- checked against this list before they are created; labelled      --
		-- points are never dropped, each carries its own Pltxt             --
		--                                                                  --
		-- !dimtol is 1mm of the MODEL turned into sheet mm, ie only points --
		-- close enough that the dimension between them would read 0 count  --
		-- as the same point. raise the 1 if small but non-zero dimensions  --
		-- should go too                                                    --
		----------------------------------------------------------------------
		!dimalong = object array()
		!dimtol = 1 * !!DrawingPlan1.vsca

		----------------------------------------------------------------------
		-- the pipe numbers are not written on the dimension points any more --
		-- (see the labelled loop below), they are collected here and drawn  --
		-- as GLABs of their own once the dimension line is in place. all    --
		-- of these are sheet mm and are meant to be tuned by eye            --
		--                                                                   --
		--   !glabmin   the least room two labels may have between them      --
		--              along the dimension. one which would land closer     --
		--              than this to the one before is pushed on until it    --
		--              clears it, and gets a bent leader back to its own    --
		--              projection line                                      --
		--   !glabclr   gap between the dimension line and the text, for a   --
		--              label which has not been stepped. a stepped one     --
		--              starts where its leader stops turning instead.      --
		--              it has to clear the dimension figures, which sit    --
		--              2.2mm off the line and are 2mm tall                 --
		--   !glabrun   how far the bent leader runs before it turns        --
		--   !glabdiag  how far across the diagonal of that bend reaches    --
		--   !glabchei  label character height, and !glabceqi for equipment --
		--              which is what the old Ptchtx 4mm did                --
		--   !glabstyle label style. the layer is Lframe true, so without a --
		--              no-frame style every label comes out boxed          --
		--   !glabtxtgap  air between the text and the leader running along  --
		--              it, so the two do not touch                          --
		--   !glabover  how far the leader carries on past the end of the    --
		--              text                                                 --
		--   !glabwchr  how wide a character is as a fraction of the          --
		--              character height, and !glabwnar / !glabwthin /        --
		--              !glabwdot for the narrow ones. the font is            --
		--              proportional, so a single average width made the      --
		--              leaders overshoot by different amounts on different   --
		--              labels (2026-08-21): '11111 BOP EL+107248' is five    --
		--              narrow 1s and came out 2.4mm short of the estimate    --
		--              while '100-A-18 BOP EL+107358' was spot on. adding    --
		--              the characters up one at a time gets both right --    --
		--              22 characters at 3mm measured 40mm on the sheet and   --
		--              this table gives 39.75mm                              --
		--   !glabgrid air left round a grid bubble on top of its own       --
		--             diameter, which is the Grid tab's Diameter           --
		--   !glabfig   extra room on the sides where the dimension figures   --
		--              sit between the line and the label. they are 2mm tall --
		--              at 2.2mm off the line, and the first bend used to     --
		--              land in among them. only up and left need it: on down --
		--              and right the figures fall on the other side of the   --
		--              dimension line, clear of the labels                   --
		--                                                                  --
		-- !glabrun and !glabdiag started from the numbers read off the    --
		-- label the user built by hand (2026-08-21, check.txt):           --
		-- Bpoftx X -5mm Y 0mm X -8mm Y -5mm                               --
		----------------------------------------------------------------------
		!glabmin = 4
		!glabclr = 6
		!glabrun = 2
		!glabdiag = 4
		!glabchei = 3
		!glabceqi = 4
		!glabstyle = '/PW-LEAD_NOFRAME'
		!glabtxtgap = 1
		!glabfig = 5
		!glabover = 5
		!glabwchr = 0.7
		!glabwnar = 0.35
		!glabwthin = 0.45
		!glabwdot = 0.3
		!glabgrid = 2
		!glabrec = object array()

		--------------------------------------------------------------------
		-- every !mem this run found on this side. the cleanup pass at the --
		-- end uses it as the second of its two "leave this point alone"   --
		-- tests -- see the note down there for why the object test cannot --
		-- carry that on its own                                          --
		--------------------------------------------------------------------
		!currentmems = object array()

		do !i from 1 to !result.size()
			!resultl = !result[!i]
			!mem = !resultl.split('~').getindexed(3).split('!').getindexed(4)
			--------------------------------------------------------------------
			-- a label-only entry: another pipe sharing this cluster, carried  --
			-- through for its label alone. everything below still runs -- the --
			-- text, the height and the along-position are worked out the same --
			-- way -- but it takes no dimension point, so it must not claim    --
			-- one, create one, or say it is a current member (that last would --
			-- have the DDNA rescue keep the point it used to own back when it --
			-- was still far enough from its neighbour to have one)            --
			--------------------------------------------------------------------
			!labelonly = false
			if (!resultl.split('~').size().geq(4)) then
				if (!resultl.split('~').getindexed(4).eq('LABELONLY')) then
					!labelonly = true
				endif
			endif
			if (not(!labelonly)) then
				!currentmems.append(!mem)
			endif
			var !type type of $!mem
			--------------------------------------------------------------------
			-- the position was worked out when the member was found and is    --
			-- carried in the string, so take it from there instead of asking  --
			-- the element again. for a length of plain tube it is the point   --
			-- where the tube crosses the border of the view, and for a type 4 --
			-- tail it is tpos, neither of which hpos would hand back          --
			--------------------------------------------------------------------
			!mempos   = !resultl.split('~').getindexed(3).split('!').getindexed(2)
			!mempossh = !resultl.split('~').getindexed(3).split('!').getindexed(3)
			if (not(!type.eqnocase('EQUI'))) then
				if (!type.eqnocase('BRAN')) then
					var !aod phod of $!mem
				else
					var !aod aod of $!mem
				endif
				!bop = !mempos.position().up - !aod.real().value() * 0.5
				!bopu = !bop.nint().value()
			endif

			!intpt.delete()
			handle any
			endhandle
			!templine = object line(!mempossh.position(), !mempossh.position().offset(!shdir, 1))
			if (!dir.eq('right')) then
				!intpt = !!DrawingPlan1.boxRlinesh.intersection(!templine).string().before('U').replace('N', 'Y').replace('S', 'Y').replace('E', 'X').replace('W', 'X')
				handle any
					-- two lines are parellel
				endhandle
			elseif (!dir.eq('left')) then
				!intpt = !!DrawingPlan1.boxLlinesh.intersection(!templine).string().before('U').replace('N', 'Y').replace('S', 'Y').replace('E', 'X').replace('W', 'X')
				handle any
					-- two lines are parellel
				endhandle
			elseif (!dir.eq('down')) then
				!intpt = !!DrawingPlan1.boxDlinesh.intersection(!templine).string().before('U').replace('N', 'Y').replace('S', 'Y').replace('E', 'X').replace('W', 'X')
				handle any
					-- two lines are parellel
				endhandle
			elseif (!dir.eq('up')) then
				!intpt = !!DrawingPlan1.boxUlinesh.intersection(!templine).string().before('U').replace('N', 'Y').replace('S', 'Y').replace('E', 'X').replace('W', 'X')
				handle any
					-- two lines are parellel
				endhandle
			endif
			--------------------------------------------------------------------
			-- !ptok replaces the '$p $!intpt' which used to sit here. that   --
			-- print was what raised the error when the two lines came out    --
			-- parallel and !intpt was left unset, and the handle any below   --
			-- caught it, so commenting the print out let an unset !intpt     --
			-- through to enupos                                              --
			--------------------------------------------------------------------
			!ptok = true
			!ptx = !intpt.part(2).replace('mm', '').real()
			handle any
				------------------------------------------------
				-- no intersection point at all, nothing to do --
				------------------------------------------------
				!ptok = false
			endhandle
			if (!ptok) then
				--------------------------------------------------------------
				-- the border of the view is an endless line as far as       --
				-- intersection() is concerned, so a member which is off the --
				-- side of the view still gives a point, but one which lies  --
				-- outside the view. drop those, or the dimension runs off   --
				-- the drawing                                               --
				--------------------------------------------------------------
				!pty = !intpt.part(4).replace('mm', '').real()
				if (!ptx lt (!vwx1 - 1) or !ptx gt (!vwx2 + 1) or !pty lt (!vwy1 - 1) or !pty gt (!vwy2 + 1)) then
					!ptok = false
				endif
			endif
			if (!ptok) then
				--------------------------------------------------------------------
				-- a labelled point is always drawn, but remember where it falls   --
				-- along the dimension so that a grid crossing or a view corner    --
				-- landing on the same spot is not added on top of it              --
				--------------------------------------------------------------------
				if (not(!labelonly)) then
					if (!dir.eq('right') or !dir.eq('left')) then
						!dimalong.append(!pty)
					else
						!dimalong.append(!ptx)
					endif
				endif
				--------------------------------------------------------------------
				-- temporary diagnostic 2026-08-12: prints one line per label that --
				-- actually gets drawn, with the element it is attached to and     --
				-- which TYPE found it, so a label seen on the sheet can be traced --
				-- back to its element without guessing. remove once answered      --
				--------------------------------------------------------------------
				if (!dbgln) then
					!dbgsrc  = !resultl.split('~').getindexed(3).split('!').getindexed(1)
					!dbgpipe = !resultl.split('~').getindexed(3).split('!').getindexed(5)
					if (!dir.eq('left')) then
						!dbgf.writerecord('LABEL pipe=' & !dbgpipe & ' src=' & !dbgsrc & ' mem=' & !mem & ' type=' & !type & ' mempos=' & !mempos & ' mempossh=' & !mempossh)
					endif
				endif
				var !temppos enupos of $!intpt
				!attapos = object position(!temppos)
				--------------------------------------------------------------------
				-- the projection line starts at the member itself, not out at the --
				-- border of the view, so that it can be followed back to what it  --
				-- belongs to. the gridgap below then leaves the same 3mm of the   --
				-- sheet clear of the fitting as it used to leave of the border.   --
				-- a length of tube which crosses the border carries the crossing  --
				-- point as its position, so for those nothing moves               --
				--                                                                 --
				-- equipment is left on the border. its position is the middle of  --
				-- the equipment and a projection line starting there would be     --
				-- drawn right across it                                           --
				--------------------------------------------------------------------
				if (not(!type.eqnocase('EQUI'))) then
					!attapos = object position(!mempos)
				endif
				!attapos = !attapos.offset(!viewdir.direction(), !!DrawingPlan1.gridgap.val / !!DrawingPlan1.vsca )
				if (!dbgln) then
					!dpoiseq = !dpoiseq + 1
					!dbgf.writerecord('DPOISEQ ' & !dpoiseq.string() & ' dir=' & !dir & ' section=labelled labelonly=' & !labelonly.string() & ' pipe=' & !dbgpipe & ' mem=' & !mem & ' attapos=E ' & string(!attapos.east) & ' N ' & string(!attapos.north) & ' U ' & string(!attapos.up))
				endif
				---------------------------------------------------------------------
				-- 2026-08-21: the pipe number and the elevation used to be the     --
				-- Pltxt of this point, which E3D draws along its projection line.  --
				-- two points close together on the sheet then printed their text   --
				-- one over the other and neither could be read. the point is now   --
				-- created with no text at all and the wording goes on a GLAB of    --
				-- its own further down, which can be stepped clear of its          --
				-- neighbour and given a bent leader back to the end of this        --
				-- point's own projection line                                      --
				--                                                                  --
				-- the leading and trailing spaces the Pltxt used to carry have     --
				-- gone with it. they were there to shove the text sideways off     --
				-- the point; a GLAB is placed with XYPO and JUST instead, so the   --
				-- four sides no longer need a string each                          --
				--                                                                  --
				-- the wording itself does not change: '#PIPE(c2:)' is resolved by  --
				-- E3D from the DDNA, which the GLAB carries too, and the BOP       --
				-- figure is still worked out here and put into the text            --
				---------------------------------------------------------------------
				!labbop = 0
				!labhasbop = false
				---------------------------------------------------------------------
				-- field 6 of the record is the 'this one wants a BOP figure' flag, --
				-- and only the TYPE 1 pipe records carry it (:330). every other    --
				-- record -- equipment, and TYPE 2a/2b/3/4 -- stops at field 5, and --
				-- asking for field 6 there raises 'This function does not return a --
				-- result' (2026-08-21, reported live). the old code asked only     --
				-- inside its BRAN and 'other' branches and happened not to hit it; --
				-- this version asks once per point, so it counts the fields first  --
				---------------------------------------------------------------------
				!labparts = object array()
				!labparts = !resultl.split('~').getindexed(3).split('!')
				handle any
					!labparts = object array()
				endhandle
				!labwantbop = 'n'
				if (!labparts.size().geq(6)) then
					!labwantbop = !labparts.getindexed(6)
				endif
				if (!labwantbop.eqnocase('y')) then
					if (!type.eqnocase('BRAN')) then
						!labbop = !bopu
						!labhasbop = true
					elseif (not(!type.eqnocase('EQUI'))) then
						-------------------------------------------------------------------
						-- 2026-08-13, confirmed live via Q PLTXT: this branch (a         --
						-- component which is neither BRAN nor EQUI, picked up by TYPE 1) --
						-- was leaving its text at the default #DEF. '#PABOPU+' /         --
						-- '#PLBOPU+' were not real PDMS text macros -- unlike            --
						-- '#PIPE(c2:)', which is -- so PDMS could not parse them and     --
						-- dropped the whole string. !pabop / !plbop were worked out and  --
						-- compared against !bop to choose an end, but the chosen value   --
						-- was never actually put into the text                           --
						-------------------------------------------------------------------
						var !pabop abop of $!mem
						var !plbop lbop of $!mem
						if (abs(!pabop.position().up - !bop) le 5) then
							!labbop = !pabop.position().up.nint().value()
						else
							!labbop = !plbop.position().up.nint().value()
						endif
						!labhasbop = true
					endif
				endif
				if (!type.eqnocase('EQUI')) then
					!labtext = '#EQUI(c2:)'
					!labchei = !glabceqi
				else
					!labtext = '#PIPE(c2:)'
					!labchei = !glabchei
					if (!labhasbop) then
						if (!labbop.geq(0)) then
							!labtext = !labtext & ' BOP EL+' & !labbop.string()
						else
							!labtext = !labtext & ' BOP EL' & !labbop.string()
						endif
					endif
				endif
				--------------------------------------------------------------------
			-- update path: this member may already carry a DPOI from a       --
			-- previous run, found by matching DDNA back to !mem. within 5mm, --
			-- leave it exactly where it is; beyond that, move the same       --
			-- element's POS instead of creating a second one, so UPDATE ANNO --
			-- reads it as a change rather than an addition                   --
			--                                                                 --
			-- one owning element can legitimately have more than one DPOI    --
			-- sharing its DDNA (e.g. two separate tube crossings of the      --
			-- same elbow), confirmed live 2026-08-26. taking the first DDNA  --
			-- match and stopping used to grab whichever one came first in    --
			-- collection order regardless of where it actually was, and drag --
			-- it across the drawing onto this record's position -- leaving  --
			-- the OTHER matching point's original spot empty, which then    --
			-- had corner1 build a spurious extra DPOI to fill. every        --
			-- candidate sharing the DDNA is checked now and the nearest one  --
			-- to this record's own position is the one reused                --
			--------------------------------------------------------------------
			!founddpoi = false
			!bestdist = -1
			do !edp values !existingdpois
				$!edp
				handle any
				elsehandle none
					var !eddna ddna of ce
					var !ecandpos pos
					if (!dbgln) then
						!eddnastr = '' & !eddna
						!memstr = '' & !mem
						!dbgf.writerecord('MATCHCAND ' & !dir & ' mem=[' & !memstr & '] memlen=' & !memstr.length().string() & ' eddna=[' & !eddnastr & '] eddnalen=' & !eddnastr.length().string() & ' unset=' & !eddna.unset().string() & ' eq=' & !eddna.eq(!mem).string())
					endif
					if (not(!eddna.unset()) and !eddna.eq(!mem)) then
						!candposobj = object position(!ecandpos)
						!canddist = !candposobj.distance(!attapos)
						if (not(!founddpoi) or !canddist.lt(!bestdist)) then
							!founddpoi = true
							!founddpoiref = ce
							!foundpos = !candposobj
							!bestdist = !canddist
						endif
					endif
				endhandle
			enddo
			----------------------------------------------------------------------
			-- fallback: nothing shared this member's own ddna. same instability --
			-- as the GLAB side (see GLABPOSFALLBACK above) -- the nearest-      --
			-- labelled-member resolution (MTBE) can come back a different       --
			-- reference between rebuild and the very next update even with     --
			-- nothing else changed, so a ddna-only match loses the point        --
			-- outright: it gets deleted below as an orphan (nothing claims it)  --
			-- and a brand new DPOI appears wherever this run's resolution       --
			-- landed, which can be a real distance away, not just a few mm      --
			-- (confirmed live via a manual before/after DPOI dump, 2026-08-27:  --
			-- =67177338/9369496 at W221903/N4842246 existed after a fresh      --
			-- rebuild, vanished after update with nothing at that position     --
			-- taking its place). so a second pass drops the ddna requirement   --
			-- and matches on real position alone, same 5mm the reuse check     --
			-- below already treats as "the same point"                        --
			----------------------------------------------------------------------
			if (not(!founddpoi)) then
				!bestdist = -1
				!nearestcanddist = -1
				!nearestcanddna = ''
				do !edp values !existingdpois
					$!edp
					handle any
					elsehandle none
						-------------------------------------------------------------
						-- skip a grid-crossing/corner point (ddna '=0/0' or unset)  --
						-- here -- this fallback is only for a labelled point whose  --
						-- own ddna drifted, not a licence to steal a nearby grid    --
						-- point and relabel it                                     --
						-------------------------------------------------------------
						var !ecanddna ddna of ce
						if (not(!ecanddna.unset()) and not(!ecanddna.eq('=0/0'))) then
							var !ecandpos pos
							!candposobj = object position(!ecandpos)
							!canddist = !candposobj.distance(!attapos)
							if (!nearestcanddist.lt(0) or !canddist.lt(!nearestcanddist)) then
								!nearestcanddist = !canddist
								!nearestcanddna = '' & !ecanddna
							endif
							if (!canddist.lt(5) and (not(!founddpoi) or !canddist.lt(!bestdist))) then
								!founddpoi = true
								!founddpoiref = ce
								!foundpos = !candposobj
								!bestdist = !canddist
							endif
						endif
					endhandle
				enddo
				if (!dbgln) then
					!dbgf.writerecord('FALLBACKMISS ' & !dir & ' mem=' & !mem & ' attapos=' & !attapos.string() & ' founddpoi=' & !founddpoi.string() & ' nearestdist=' & !nearestcanddist.string() & ' nearestddna=[' & !nearestcanddna & ']')
				endif
			endif
			if (!dbgln) then
				!dbgf.writerecord('MATCH ' & !dir & ' mem=' & !mem & ' founddpoi=' & !founddpoi & ' attapos=' & !attapos.string())
			endif
			-- a label-only entry takes no dimension point, so it claims none --
			-- and creates none. see the note at the top of the loop         --
			if (not(!labelonly)) then
				if (!founddpoi) then
					if (!dbgln) then
						!dbgf.writerecord('MATCH ' & !dir & ' foundpos=' & !foundpos.string() & ' dist=' & !foundpos.distance(!attapos))
					endif
					!claimeddpois.append(!founddpoiref)
					$!founddpoiref
					DDNA $!mem
					----------------------------------------------------------------
					-- reverted 2026-09-02: the 2026-09-01 "found means frozen,   --
					-- always" version above was written for a member whose real  --
					-- crossing does not move (only the fresh intersection maths  --
					-- drifts by noise), which is true for a box edge moving      --
					-- roughly parallel to the pipe -- but a DIAGONAL pipe's true --
					-- crossing point genuinely slides along the boundary when    --
					-- the box edge moves, by a real, large amount, not noise.    --
					-- freezing POSITION unconditionally left the dot (and the    --
					-- dimension figure measured off it) sitting somewhere the    --
					-- pipe no longer crosses, which is wrong content, not just an --
					-- unwanted revision cloud. user rule, 2026-09-02: DPOI goes  --
					-- back to tracking the real crossing point -- only the GLAB  --
					-- label's own XYPO/position (not this dot) stays frozen      --
					-- unconditionally, per the fix above                         --
					----------------------------------------------------------------
					if (!foundpos.distance(!attapos).geq(5)) then
						POS $!attapos
					else
						----------------------------------------------------------
						-- within tolerance: leave the dot where it is, but read --
						-- the along value back off it (not off this run's fresh --
						-- !ptx/!pty) so the label's along-position and its      --
						-- leader agree with the dot instead of drifting by      --
						-- noise on every resize (2026-09-01 finding, still true --
						-- for the small-drift case)                             --
						----------------------------------------------------------
						var !frozensh shpos of $!foundpos
						if (!dir.eq('right') or !dir.eq('left')) then
							!pty = !frozensh.part(4).replace('mm', '').real()
						else
							!ptx = !frozensh.part(2).replace('mm', '').real()
						endif
					endif
				else
					NEW DPOI POS $!attapos DDNA $!mem
					----------------------------------------------------------------
					-- must be claimed too, same as the matched branch above --    --
					-- CLEANUPDUP below only recognises a member as "already has   --
					-- its point this run" via !claimeddpois/!claimedddnas. left   --
					-- out here, a fresh point never registers, so when the real   --
					-- crossing moves far enough that strict+fallback both miss    --
					-- (a real box change, not noise) the OLD point for the same   --
					-- DDNA is never recognised as superseded and survives         --
					-- cleanup untouched -- confirmed live 2026-09-02: a 1.8m box  --
					-- shift left 660005-010's old DPOI standing beside the new    --
					-- one, both still on the drawing                             --
					----------------------------------------------------------------
					!claimeddpois.append(ce)
				endif
			endif
				---------------------------------------------------------------------
				-- everything the GLAB will need, one string per label: the wording, --
				-- the element the text is resolved from, the character height, and  --
				-- where the label sits ALONG the dimension (sheet y for the left    --
				-- and right sides, sheet x for up and down). the other coordinate is --
				-- the dimension line itself, which is not known until DOFFSET has    --
				-- been set, so it is worked out down there                           --
				---------------------------------------------------------------------
				!labup = !attapos.up.nint().value()
				if (!dir.eq('right') or !dir.eq('left')) then
					!glabrec.append(!labtext & '~' & !mem & '~' & !labchei.string() & '~' & !pty.string() & '~' & !labup.string())
				else
					!glabrec.append(!labtext & '~' & !mem & '~' & !labchei.string() & '~' & !ptx.string() & '~' & !labup.string())
				endif
				---------------------------------------------------------------------
				-- 2026-08-13: reads DDNA straight back off the DPOI just created,   --
				-- while it is still CE, in true creation order. checks whether the  --
				-- section=grid/corner points below (created with no DDNA clause at  --
				-- all) already carry a real DDNA the instant PDMS creates them, or  --
				-- whether that only shows up later (e.g. after SORT DIM). user      --
				-- confirmed live, same q session: Draw Explorer's "Point 2" of      --
				-- ateLINE_up_R has q pos matching this run's DPOISEQ 6 (a grid      --
				-- point, no DDNA set here) but q ddna matching DPOISEQ 2's mem (the  --
				-- 80-A-11 elbow, a labelled point) -- so whatever attaches that     --
				-- DDNA to the grid point does not happen in this labelled branch.   --
				-- remove once answered                                              --
				---------------------------------------------------------------------
				if (!dbgln and !dir.eq('left')) then
					var !liveddna ddna of ce
					!dbgf.writerecord('LIVEDDNA ' & !dpoiseq.string() & ' section=labelled liveddna=' & !liveddna)
				endif
			endif
		enddo
		------------------------------------------------
		-- create dimension for grid                  --
		-- !!DrawingPlan1.allintersections including  --
		-- intersection points between view and grids --
		------------------------------------------------
		do !intersection value !!DrawingPlan1.allintersections
			!checkpt = false
			if (!intersection.split('-').getindexed(1).eqnocase('boxRlinesh') and !dir.eq('right')) then
				!checkpt = true
			elseif (!intersection.split('-').getindexed(1).eqnocase('boxLlinesh') and !dir.eq('left')) then
				!checkpt = true
			elseif (!intersection.split('-').getindexed(1).eqnocase('boxUlinesh') and !dir.eq('up')) then
				!checkpt = true
			elseif (!intersection.split('-').getindexed(1).eqnocase('boxDlinesh') and !dir.eq('down')) then
				!checkpt = true
			endif
			if (!checkpt) then
				!intpt = !intersection.split('-').getindexed(2).before('U').replace('N', 'Y').replace('S', 'Y').replace('E', 'X').replace('W', 'X')
				!ptx = !intpt.part(2).replace('mm', '').real()
				!pty = !intpt.part(4).replace('mm', '').real()
				--------------------------------------------------------------------
				-- a grid line whose ends are inside the view does not reach the   --
				-- border at all, the intersection above comes from the endless    --
				-- line through it, so the dimension ends up with nothing joining  --
				-- it to the grid. reach the point back in to where the grid line  --
				-- really ends, and the gridgap below then leaves the same 3mm of  --
				-- the sheet clear of it as it used to leave of the border         --
				--                                                                 --
				-- only the depth is taken from the end of the grid. the           --
				-- coordinate along the border stays as it was, so the dimension   --
				-- itself does not change                                          --
				--------------------------------------------------------------------
				!nearpt = ''
				!nearpt = !intersection.split('~').getindexed(2).before('U').replace('N', 'Y').replace('S', 'Y').replace('E', 'X').replace('W', 'X')
				handle any
					--------------------------------------------------------------
					-- no end of grid recorded, keep the point on the border    --
					--------------------------------------------------------------
				endhandle
				if (!nearpt.neq('')) then
					if (!dir.eq('right') or !dir.eq('left')) then
						!ptx = min(max(!nearpt.part(2).replace('mm', '').real(), !vwx1), !vwx2)
					else
						!pty = min(max(!nearpt.part(4).replace('mm', '').real(), !vwy1), !vwy2)
					endif
				endif
				----------------------------------------------------------------
				-- a pipe running along this grid line has already been put on --
				-- the dimension by the labelled loop above, at the same       --
				-- coordinate. adding the crossing as well only measures 0     --
				-- between the two and drags a second projection line across   --
				-- the view, so leave it out -- the labelled point holds the   --
				-- place and carries the text as well                          --
				----------------------------------------------------------------
				if (!dir.eq('right') or !dir.eq('left')) then
					!alongv = !pty
				else
					!alongv = !ptx
				endif
				!intsh = 'x ' & string(!ptx) & ' y ' & string(!pty)
				var !temppos enupos of $!intsh
				!attapos = object position(!temppos)
				!attapos = !attapos.offset(!viewdir.direction(), !!DrawingPlan1.gridgap.val / !!DrawingPlan1.vsca )
				---------------------------------------------------------------
				-- update path: no DDNA on a grid crossing, so a previous    --
				-- run's point at (close to) this position is the match --
				---------------------------------------------------------------
				--------------------------------------------------------------
				-- and it has to be CLAIMED, not just recognised: a grid    --
				-- crossing is created with no DDNA clause, but E3D does    --
				-- not leave it blank -- it hands the point back a real     --
				-- DDNA belonging to some other point (see the note in the  --
				-- labelled branch above, confirmed live 2026-08-13). the   --
				-- cleanup pass therefore does look at these points, and    --
				-- an unclaimed one is deleted: 11 points went that way in  --
				-- one update, taking their dimension segments with them    --
				-- (2026-08-28, rebuild wrote 40 points and the update      --
				-- straight after it wrote 36 off an identical collection)  --
				--                                                          --
				-- claimed BEFORE the DimAlongIsNew gate below, and without --
				-- stopping at the first hit. inside the gate a newly added --
				-- pipe which takes over this crossing's along-coordinate    --
				-- skips the whole block, leaving last run's point at this  --
				-- crossing unclaimed and therefore deleted -- the new pipe --
				-- silently costing an existing dimension. stopping at the  --
				-- first hit had the same effect whenever two points sit    --
				-- within the 5mm: only one of them got claimed             --
				--------------------------------------------------------------
				!foundgrid = false
				do !edp values !existingdpois
					$!edp
					var !epos pos
					!eposobj = object position(!epos)
					if (!eposobj.distance(!attapos).lt(5)) then
						!foundgrid = true
						!claimeddpois.append(ce)
					endif
				enddo
				if (!!DrawingPlan1.DimAlongIsNew(!dimalong, !alongv, !dimtol)) then
					!dimalong.append(!alongv)
					if (!dbgln and !dir.eq('left')) then
						--------------------------------------------------------------------
						-- 2026-08-13: .allintersections now carries the refgln's own NAME  --
						-- after a second '~' (see DrawingPlan1GridAnnotation.pmlfnc), so a --
						-- section=grid DPOI can be traced back to which grid line it is.   --
						-- remove once answered                                             --
						--------------------------------------------------------------------
						!gridname = ''
						!gridname = !intersection.split('~').getindexed(3)
						handle any
							-- old-format entry with no name field, leave !gridname blank --
						endhandle
						!dpoiseq = !dpoiseq + 1
						!dbgf.writerecord('DPOISEQ ' & !dpoiseq.string() & ' section=grid refgln=' & !gridname & ' attapos=E ' & string(!attapos.east) & ' N ' & string(!attapos.north) & ' U ' & string(!attapos.up))
					endif
					if (not(!foundgrid)) then
						NEW DPOI POS $!attapos
						!claimeddpois.append(ce)
						if (!dbgln and !dir.eq('left')) then
							var !liveddna ddna of ce
							!dbgf.writerecord('LIVEDDNA ' & !dpoiseq.string() & ' section=grid liveddna=' & !liveddna)
						endif
					endif
				endif
			endif
		enddo

		----------------------------------------------------------------
		-- create dimension for the match line ticks                   --
		--                                                             --
		-- the short lines marking where a neighbouring box meets this --
		-- border are dimensioned as well as drawn (user rule,         --
		-- 2026-08-28). where they go is decided by                    --
		-- DrawingPlan1MatchTicks, which runs just before this         --
		-- function -- the match line itself draws from the same list  --
		-- later on, so a tick and its dimension can not drift apart   --
		--                                                             --
		-- the points are treated exactly like a grid crossing above:  --
		-- no DDNA to match on, so a previous run's point close enough --
		-- to this one is the match, and it has to be CLAIMED or the   --
		-- cleanup at the end will delete it                           --
		----------------------------------------------------------------
		!tkn = 0
		!tkn = !!DrawingPlan1MatchTickPos.size()
		handle any
			!tkn = 0
		endhandle
		!tickdupes = object array()
		--------------------------------------------------------------
		-- every point this run recognised as having been dragged     --
		-- aside by hand. read again at DOFFSET below, to stop such a --
		-- point dragging the whole dimension line along with it      --
		--------------------------------------------------------------
		!movedrefs = object array()
		do !tki from 1 to !tkn
			!tkp = !!DrawingPlan1MatchTickPos[!tki].split('~')
			if (!tkp.getindexed(1).eq(!dir)) then
				!ptx = !tkp.getindexed(2).real()
				!pty = !tkp.getindexed(3).real()
				if (!dir.eq('right') or !dir.eq('left')) then
					!alongv = !pty
				else
					!alongv = !ptx
				endif
				!intsh = 'x ' & string(!ptx) & ' y ' & string(!pty)
				var !temppos enupos of $!intsh
				!attapos = object position(!temppos)
				!attapos = !attapos.offset(!viewdir.direction(), !!DrawingPlan1.gridgap.val / !!DrawingPlan1.vsca )
				------------------------------------------------------------
				-- a point still standing exactly where this run would    --
				-- put one                                                 --
				------------------------------------------------------------
				--------------------------------------------------------
				-- CE answers a DBREF, and a variable's type is fixed  --
				-- by its FIRST assignment -- so !tickauto must not be --
				-- cleared to '' between ticks (STRING=DBREF, reported --
				-- live 2026-08-28). a plain boolean says whether it   --
				-- holds anything this time round instead              --
				--------------------------------------------------------
				!hasauto = false
				do !edp values !existingdpois
					$!edp
					var !epos pos
					!eposobj = object position(!epos)
					if (!eposobj.distance(!attapos).lt(5)) then
						!claimeddpois.append(ce)
						if (not(!hasauto)) then
							!tickauto = ce
							!hasauto = true
						endif
					endif
				enddo
				------------------------------------------------------------
				-- and one that was dragged aside by hand. dragging it     --
				-- sideways is the whole reason the blue points can be     --
				-- moved at all: it only shortens or lengthens the         --
				-- projection line and leaves the measurement alone. the   --
				-- 5mm above is 5mm of the MODEL, a fifth of a millimetre  --
				-- on the sheet at 1:50, so any such nudge lost the point  --
				-- and this run drew a second one beside it -- reported    --
				-- live as an extra 0 dimension (2026-08-28)               --
				--                                                         --
				-- so ask again, this time on the coordinate ALONG the     --
				-- dimension only, which a sideways drag does not change,  --
				-- and skipping whatever the first pass already matched.   --
				-- a second pass rather than a looser first one: whatever  --
				-- matched before still matches exactly as it did          --
				------------------------------------------------------------
				!hasmoved = false
				!bestd = 1
				do !edp values !existingdpois
					if (!boxchg) then
						break
					endif
					$!edp
					var !epos pos
					!eposobj = object position(!epos)
					!d3 = !eposobj.distance(!attapos)
					if (!d3.geq(5)) then
						var !eposh shpos of $!epos
						if (!dir.eq('right') or !dir.eq('left')) then
							!ealong = !eposh.split().getindexed(4).replace('mm','').real()
						else
							!ealong = !eposh.split().getindexed(2).replace('mm','').real()
						endif
						!ed = abs(!ealong - !alongv)
						if (!ed.lt(!bestd)) then
							!bestd = !ed
							!tickmoved = ce
							!hasmoved = true
						endif
					endif
				enddo
				if (!hasmoved) then
					$!tickmoved
					!claimeddpois.append(ce)
					!movedrefs.append(ce)
					if (!dbgln) then
						!dbgf.writerecord('TICKALONG ' & !dir & ' alongv=' & !alongv.string() & ' off=' & !bestd.string() & ' hasauto=' & !hasauto.string())
					endif
				endif
				!foundtick = false
				if (!hasauto or !hasmoved) then
					!foundtick = true
				endif
				if (!!DrawingPlan1.DimAlongIsNew(!dimalong, !alongv, !dimtol)) then
					!dimalong.append(!alongv)
					if (not(!foundtick)) then
						$!name/SS/S1/V1/ateLINE_$!dir
						NEW DPOI POS $!attapos
						!claimeddpois.append(ce)
					elseif (!hasmoved and !hasauto) then
						------------------------------------------------------
						-- both a point somebody moved by hand AND one still --
						-- sitting where this run would place it, on the     --
						-- same coordinate. the pair measures nothing and    --
						-- shows up as a stray 0 on the drawing. the         --
						-- automatic one is the leftover -- it was drawn     --
						-- beside the moved one back when a moved point      --
						-- could not be recognised -- so it goes and the one --
						-- somebody placed on purpose stays                  --
						--                                                    --
						-- recorded, not deleted here: the corner blocks     --
						-- below walk !existingdpois with no handler and a   --
						-- dead reference would stop the run                 --
						------------------------------------------------------
						!tickdupes.append(!tickauto)
						if (!dbgln) then
							-- the two refs are DBREFs, not strings, so they are --
							-- deliberately not concatenated in here             --
							!dbgf.writerecord('TICKDUPE ' & !dir & ' alongv=' & !alongv.string() & ' movedby=' & !bestd.string())
						endif
					endif
				endif
			endif
		enddo

		---------------------------------
		-- create dimension for limits --
		---------------------------------
		$!name/SS/S1/V1/ateLINE_$!dir
		var !dpois coll all dpoi for ce
		
		if (!dir.eq('right')) then
			var !temppos enupos of $!!DrawingPlan1.boxURsh
			!alongv = !!DrawingPlan1.boxURsh.part(4).real()
		elseif (!dir.eq('left')) then
			var !temppos enupos of $!!DrawingPlan1.boxULsh
			!alongv = !!DrawingPlan1.boxULsh.part(4).real()
		elseif (!dir.eq('down')) then
			var !temppos enupos of $!!DrawingPlan1.boxLLsh
			!alongv = !!DrawingPlan1.boxLLsh.part(2).real()
		elseif (!dir.eq('up')) then
			var !temppos enupos of $!!DrawingPlan1.boxULsh
			!alongv = !!DrawingPlan1.boxULsh.part(2).real()
		endif
		if (!dbgln) then
			!dbgf.writerecord('CORNER1RAW viewULsh=' & !!DrawingPlan1.boxULsh & ' viewURsh=' & !!DrawingPlan1.boxURsh & ' viewLLsh=' & !!DrawingPlan1.boxLLsh & ' viewLRsh=' & !!DrawingPlan1.boxLRsh)
		endif

		!attapos = object position(!temppos)
		!attapos = !attapos.offset(!viewdir.direction(), !!DrawingPlan1.gridgap.val / !!DrawingPlan1.vsca )
		!run = true
		!hasc1auto = false
		do !dpoi value !dpois
			$!dpoi
			var !temppos1 pos
			!attapos1 = object position(!temppos1)
			if (!dbgln) then
				!dbgf.writerecord('CORNER1DEDUP attapos=' & !attapos.string() & ' cand=' & !attapos1.string() & ' dist=' & !attapos.distance(!attapos1))
			endif
			if (!attapos.distance(!attapos1).lt(5)) then
				!run = false
				-- claimed, for the same reason the grid crossings are --
				!claimeddpois.append(ce)
				if (not(!hasc1auto)) then
					!c1auto = ce
					!hasc1auto = true
				endif
			endif
		enddo
		------------------------------------------------------------------
		-- this corner's point may have been dragged aside by hand, the  --
		-- same way a match line tick can be. the 3d test above then     --
		-- misses it and a second point goes on the same coordinate,     --
		-- which reads as a stray 0 (see the tick block for the full     --
		-- story, 2026-08-28)                                            --
		--                                                               --
		-- only points nothing else this run has already accounted for   --
		-- are considered. a labelled point that happens to share this   --
		-- coordinate belongs to its own pipe, and mistaking it for a    --
		-- moved corner would silently stop the corner dimension from    --
		-- being drawn at all -- a far worse outcome than the stray 0    --
		------------------------------------------------------------------
		!hasc1moved = false
		!bestd = 1
		do !dpoi value !dpois
			if (!boxchg) then
				break
			endif
			$!dpoi
			var !temppos1 pos
			!attapos1 = object position(!temppos1)
			!d3 = !attapos.distance(!attapos1)
			if (!d3.geq(5)) then
				!cref = ce
				!alreadyused = false
				do !cd values !claimeddpois
					if (!cref.eq(!cd)) then
						!alreadyused = true
						break
					endif
				enddo
				if (not(!alreadyused)) then
					var !cposh shpos of $!temppos1
					if (!dir.eq('right') or !dir.eq('left')) then
						!ealong = !cposh.split().getindexed(4).replace('mm','').real()
					else
						!ealong = !cposh.split().getindexed(2).replace('mm','').real()
					endif
					!ed = abs(!ealong - !alongv)
					if (!ed.lt(!bestd)) then
						!bestd = !ed
						!c1moved = ce
						!hasc1moved = true
					endif
				endif
			endif
		enddo
		if (!hasc1moved) then
			$!c1moved
			!claimeddpois.append(ce)
			!movedrefs.append(ce)
			!run = false
			if (!dbgln) then
				!dbgf.writerecord('CORNER1ALONG ' & !dir & ' alongv=' & !alongv.string() & ' off=' & !bestd.string() & ' hasauto=' & !hasc1auto.string())
			endif
		endif
		if (!hasc1moved and !hasc1auto) then
			if (!!DrawingPlan1.DimAlongIsNew(!dimalong, !alongv, !dimtol)) then
				!tickdupes.append(!c1auto)
				if (!dbgln) then
					!dbgf.writerecord('CORNER1DUPE ' & !dir & ' alongv=' & !alongv.string() & ' movedby=' & !bestd.string())
				endif
			endif
		endif
		if (!dbgln) then
			!dbgf.writerecord('CORNER1 run-after-dist=' & !run & ' alongv=' & !alongv.string() & ' dimtol=' & !dimtol.string() & ' dimalong=' & !dimalong.size())
		endif
		-------------------------------------------------------------------
		-- the distance test above is a 3d one and misses a point which   --
		-- shares this corner's coordinate along the dimension but sits   --
		-- at a different depth -- exactly the pair that measures 0. it   --
		-- also compares against !dpois, read before this corner existed  --
		-------------------------------------------------------------------
		if (!run) then
			!run = !!DrawingPlan1.DimAlongIsNew(!dimalong, !alongv, !dimtol)
		endif
		if (!dbgln) then
			!dbgf.writerecord('CORNER1 run-after-along=' & !run)
		endif
		if (!run) then
			!dimalong.append(!alongv)
			if (!dbgln) then
				!dpoiseq = !dpoiseq + 1
				!dbgf.writerecord('DPOISEQ ' & !dpoiseq.string() & ' section=corner1 attapos=E ' & string(!attapos.east) & ' N ' & string(!attapos.north) & ' U ' & string(!attapos.up))
			endif
			NEW DPOI POS $!attapos
			!claimeddpois.append(ce)
			if (!dbgln) then
				var !liveddna ddna of ce
				!dbgf.writerecord('LIVEDDNA ' & !dpoiseq.string() & ' section=corner1 liveddna=' & !liveddna)
			endif
		endif

		if (!dir.eq('right')) then
			var !temppos enupos of $!!DrawingPlan1.boxLRsh
			!alongv = !!DrawingPlan1.boxLRsh.part(4).real()
		elseif (!dir.eq('left')) then
			var !temppos enupos of $!!DrawingPlan1.boxLLsh
			!alongv = !!DrawingPlan1.boxLLsh.part(4).real()
		elseif (!dir.eq('down')) then
			var !temppos enupos of $!!DrawingPlan1.boxLRsh
			!alongv = !!DrawingPlan1.boxLRsh.part(2).real()
		elseif (!dir.eq('up')) then
			var !temppos enupos of $!!DrawingPlan1.boxURsh
			!alongv = !!DrawingPlan1.boxURsh.part(2).real()
		endif
		!attapos = object position(!temppos)
		--------------------------------------------------------------------
		-- 2026-08-26: this dedup used to compare the un-offset border     --
		-- point against existing points that were created gridgap away   --
		-- from it, so it could never match and a redundant DPOI got      --
		-- created here on every single update run regardless of whether  --
		-- anything changed. the offset (same as corner1, below) now      --
		-- happens before the comparison so a genuinely unchanged corner  --
		-- is recognised as already covered                               --
		--------------------------------------------------------------------
		!attapos = !attapos.offset(!viewdir.direction(), !!DrawingPlan1.gridgap.val / !!DrawingPlan1.vsca )
		!run = true
		!hasc2auto = false
		do !dpoi value !dpois
			$!dpoi
			var !temppos1 pos
			!attapos1 = object position(!temppos1)
			if (!dbgln) then
				!dbgf.writerecord('CORNER2DEDUP attapos=' & !attapos.string() & ' cand=' & !attapos1.string() & ' dist=' & !attapos.distance(!attapos1))
			endif
			if (!attapos.distance(!attapos1).lt(5)) then
				!run = false
				-- claimed, for the same reason the grid crossings are --
				!claimeddpois.append(ce)
				if (not(!hasc2auto)) then
					!c2auto = ce
					!hasc2auto = true
				endif
			endif
		enddo
		------------------------------------------------------------------
		-- same second pass as corner1 above, same reasoning             --
		------------------------------------------------------------------
		!hasc2moved = false
		!bestd = 1
		do !dpoi value !dpois
			if (!boxchg) then
				break
			endif
			$!dpoi
			var !temppos1 pos
			!attapos1 = object position(!temppos1)
			!d3 = !attapos.distance(!attapos1)
			if (!d3.geq(5)) then
				!cref = ce
				!alreadyused = false
				do !cd values !claimeddpois
					if (!cref.eq(!cd)) then
						!alreadyused = true
						break
					endif
				enddo
				if (not(!alreadyused)) then
					var !cposh shpos of $!temppos1
					if (!dir.eq('right') or !dir.eq('left')) then
						!ealong = !cposh.split().getindexed(4).replace('mm','').real()
					else
						!ealong = !cposh.split().getindexed(2).replace('mm','').real()
					endif
					!ed = abs(!ealong - !alongv)
					if (!ed.lt(!bestd)) then
						!bestd = !ed
						!c2moved = ce
						!hasc2moved = true
					endif
				endif
			endif
		enddo
		if (!hasc2moved) then
			$!c2moved
			!claimeddpois.append(ce)
			!movedrefs.append(ce)
			!run = false
			if (!dbgln) then
				!dbgf.writerecord('CORNER2ALONG ' & !dir & ' alongv=' & !alongv.string() & ' off=' & !bestd.string() & ' hasauto=' & !hasc2auto.string())
			endif
		endif
		if (!hasc2moved and !hasc2auto) then
			if (!!DrawingPlan1.DimAlongIsNew(!dimalong, !alongv, !dimtol)) then
				!tickdupes.append(!c2auto)
				if (!dbgln) then
					!dbgf.writerecord('CORNER2DUPE ' & !dir & ' alongv=' & !alongv.string() & ' movedby=' & !bestd.string())
				endif
			endif
		endif
		if (!dbgln) then
			!dbgf.writerecord('CORNER2 run-after-dist=' & !run & ' alongv=' & !alongv.string() & ' dimtol=' & !dimtol.string() & ' dimalong=' & !dimalong.size())
		endif
		if (!run) then
			!run = !!DrawingPlan1.DimAlongIsNew(!dimalong, !alongv, !dimtol)
		endif
		if (!dbgln) then
			!dbgf.writerecord('CORNER2 run-after-along=' & !run)
		endif
		if (!run) then
			!dimalong.append(!alongv)
			if (!dbgln) then
				!dpoiseq = !dpoiseq + 1
				!dbgf.writerecord('DPOISEQ ' & !dpoiseq.string() & ' section=corner2 attapos=E ' & string(!attapos.east) & ' N ' & string(!attapos.north) & ' U ' & string(!attapos.up))
			endif
			NEW DPOI POS $!attapos
			!claimeddpois.append(ce)
			if (!dbgln) then
				var !liveddna ddna of ce
				!dbgf.writerecord('LIVEDDNA ' & !dpoiseq.string() & ' section=corner2 liveddna=' & !liveddna)
			endif
		endif

		--------------------------------------------------------------------
		-- update path cleanup: a DPOI from a previous run is removed only --
		-- when nothing this run accounts for it AT ALL -- neither the     --
		-- object itself being reused, nor its DDNA still being among the  --
		-- members this run collected. a DPOI with no DDNA (grid           --
		-- crossings, corners) is left alone -- but .unset() alone does    --
		-- NOT catch that: a DPOI created with no DDNA clause reads back   --
		-- as the literal string '=0/0' (a null DBREF), not a blank/unset  --
		-- string (confirmed live via CLEANUP debug -- this cost every     --
		-- corner/grid DPOI in the chain, 2026-08-26). both are checked    --
		--                                                                --
		-- the object test alone is NOT enough, and asking for it alone    --
		-- was wrong: grid crossings are only re-derived on the rebuild    --
		-- path. the update path deliberately leaves them alone and never  --
		-- fills .allintersections (see the note in DrawingPlan1.pmlfrm),  --
		-- so that loop does not run and no grid point can be claimed --   --
		-- yet E3D does not leave a no-DDNA point blank, it back-fills a   --
		-- real DDNA copied off another point, so cleanup sees them and    --
		-- reaped every one: 7 points per update, three whole grid lines   --
		-- off the up and down dimensions (2026-08-28, rebuild 56 points   --
		-- against the next update's 49)                                   --
		--                                                                --
		-- so the DDNA test is kept as well, and either one saves a point. --
		-- a point whose DDNA no longer appears anywhere -- the pipe       --
		-- really was deleted -- is still removed, which is what this pass --
		-- exists for. anything else is ambiguous (a back-filled grid      --
		-- point, or the second of two legitimate crossings of one elbow)  --
		-- and ambiguous points are KEPT: a stale duplicate is a far       --
		-- smaller problem than a dimension that silently disappears, and  --
		-- disappearing dimensions make a revision compare worthless       --
		--------------------------------------------------------------------
		--------------------------------------------------------------------
		-- confirmed live 2026-08-26 on a fresh rebuild (no update-path    --
		-- code involved at all): one elbow legitimately owns two DPOIs   --
		-- with the identical DDNA -- e.g. one tube crossing the border   --
		-- on each side of it -- so two existing DPOIs sharing a DDNA is  --
		-- normal, not leftover corruption. an earlier version of this   --
		-- cleanup collapsed same-DDNA entries down to one and wrongly    --
		-- deleted the second, legitimate crossing point every run. do   --
		-- not reintroduce that                                          --
		--------------------------------------------------------------------
		--------------------------------------------------------------------
		-- the leftover automatic points found beside a hand-placed one   --
		-- (the match line ticks and both corners). done here, where the  --
		-- walks over !existingdpois and !dpois that cannot survive a    --
		-- dead reference are already behind us                          --
		--------------------------------------------------------------------
		do !td values !tickdupes
			$!td
			handle any
				skip
			endhandle
			delete dpoi
			handle any
			endhandle
		enddo
		--------------------------------------------------------------------
		-- the DDNA every point this run claimed is carrying. read here,   --
		-- in a pass of its own, because the walk below is navigating one  --
		-- existing point at a time and must not go wandering off to a     --
		-- second element in the middle of reading the first               --
		--------------------------------------------------------------------
		!claimedddnas = object array()
		do !cd values !claimeddpois
			$!cd
			handle any
				skip
			endhandle
			var !cdddna ddna of ce
			if (not(!cdddna.unset()) and not(!cdddna.eq('=0/0'))) then
				!claimedddnas.append(!cdddna)
			endif
		enddo
		do !edp values !existingdpois
			$!edp
			handle any
			elsehandle none
				var !eddna ddna of ce
				!edpref = ce
				!edbgsh = ''
				var !edbgpos pos
				handle any
					!edbgpos = ''
				endhandle
				var !edbgsh shpos of $!edbgpos
				handle any
					!edbgsh = 'UNREADABLE'
				endhandle
				!objclaimed = false
				do !cd values !claimeddpois
					if (!edpref.eq(!cd)) then
						!objclaimed = true
						break
					endif
				enddo
				!stillcurrent = !objclaimed
				if (not(!eddna.unset()) and not(!eddna.eq('=0/0'))) then
					if (not(!stillcurrent)) then
						do !cm values !currentmems
							if (!eddna.eq(!cm)) then
								!stillcurrent = true
								break
							endif
						enddo
					endif
					--------------------------------------------------------------
					-- the DDNA rescue above keeps anything ambiguous, which is  --
					-- right for a point that could still belong -- but a point  --
					-- standing outside what the box now covers cannot, whatever --
					-- its DDNA says. that is exactly how a stale grid crossing  --
					-- survives: created with no DDNA of its own, E3D back-fills --
					-- one copied off another point, and while that pipe is      --
					-- still on the drawing the rescue saves the crossing too    --
					-- -- so a column line the box no longer reaches left an     --
					-- extra point splitting one span into two (reported live    --
					-- 2026-08-29: 1539 came back as 215 + 1324)                 --
					--                                                            --
					-- measured ALONG the dimension only. the depth is a whole    --
					-- gridgap outside the box by design, so testing that too    --
					-- would condemn every point on the chain. object-claimed    --
					-- points are never questioned: the corners sit exactly on   --
					-- the limit and belong there                                 --
					--------------------------------------------------------------
					if (!stillcurrent and not(!objclaimed)) then
						var !edppos pos
						var !edpsh shpos of $!edppos
						if (!dir.eq('right') or !dir.eq('left')) then
							!edpalong = !edpsh.split().getindexed(4).replace('mm','').real()
							!alo = !!DrawingPlan1.boxLLsh.part(4).real()
							!ahi = !!DrawingPlan1.boxULsh.part(4).real()
						else
							!edpalong = !edpsh.split().getindexed(2).replace('mm','').real()
							!alo = !!DrawingPlan1.boxLLsh.part(2).real()
							!ahi = !!DrawingPlan1.boxLRsh.part(2).real()
						endif
						if (!edpalong.lt(!alo - 0.5) or !edpalong.gt(!ahi + 0.5)) then
							!stillcurrent = false
							if (!dbgln) then
								!dbgf.writerecord('CLEANUPOUT ' & !dir & ' along=' & !edpalong.string() & ' span=' & !alo.string() & ' .. ' & !ahi.string())
							endif
						endif
					endif
					--------------------------------------------------------------
					-- second backstop, and the one CLEANUPOUT cannot be: a      --
					-- leftover standing INSIDE the box. the DDNA it carries     --
					-- names a member still on the drawing, so the rescue keeps  --
					-- it -- but that member has already been given its point    --
					-- this run, and a member gets one point per chain, so this  --
					-- is a second copy left behind by an earlier run            --
					--                                                            --
					-- measured live 2026-08-30, same box, rebuild against       --
					-- update: down came back with 9 points where the rebuild    --
					-- makes 8, the extra carrying 1761 while 1761's real point  --
					-- sat 40mm further along; right came back with 10 for 8,    --
					-- its two extras doubling an along coordinate exactly and   --
					-- so measuring 0                                            --
					--                                                            --
					-- narrow on purpose: it can never take a member's last      --
					-- point, because it only fires once a point carrying that   --
					-- same DDNA has been claimed and is therefore surviving.    --
					-- the elbow that legitimately owns two crossings is safe    --
					-- too -- this run works out both and claims both            --
					--------------------------------------------------------------
					if (!stillcurrent and not(!objclaimed)) then
						do !cdd values !claimedddnas
							if (!eddna.eq(!cdd)) then
								!stillcurrent = false
								if (!dbgln) then
									!dbgf.writerecord('CLEANUPDUP ' & !dir & ' eddna=' & !eddna & ' at=' & !edbgsh)
								endif
								break
							endif
						enddo
					endif
					if (!dbgln) then
						!dbgf.writerecord('CLEANUP ' & !dir & ' eddna=' & !eddna & ' at=' & !edbgsh & ' objclaimed=' & !objclaimed.string() & ' stillcurrent=' & !stillcurrent)
					endif
				else
					--------------------------------------------------------------
					-- a point carrying no DDNA of its own: a grid crossing, a   --
					-- match line tick, or one of the two corners. this used to  --
					-- be skipped outright and never deleted, because the update --
					-- path did not re-derive grid crossings and so could never  --
					-- claim them -- asking for a claim wiped every one of them  --
					-- (2026-08-26)                                              --
					--                                                            --
					-- that is no longer true: GridAnnotation runs on the update  --
					-- path as well now, so all three kinds are worked out again  --
					-- on both paths and each one that still belongs is claimed   --
					-- by the block that owns it. one that was not claimed is     --
					-- last run's, left standing on the border the view USED to   --
					-- have -- a box that grew put ten points on the left chain   --
					-- where seven belonged, the three extra being the two old    --
					-- corners and an old tick (2026-08-28)                       --
					--------------------------------------------------------------
					if (!dbgln) then
						!dbgf.writerecord('CLEANUPAUTO ' & !dir & ' eddna=' & !eddna & ' at=' & !edbgsh & ' claimed=' & !stillcurrent)
					endif
				endif
				if (not(!stillcurrent)) then
					delete dpoi
				endif
			endhandle
		enddo

		--------------------------------------------------------------------
		-- OWNER (below, original code) means "go to the owner of CE",   --
		-- not "confirm CE" -- it only worked because CE used to always  --
		-- be a freshly NEW'd DPOI (a child of the LDIM) at this point.  --
		-- now CE may already be the LDIM itself (nothing on this side   --
		-- needed touching this run), and OWNER would then step CE UP   --
		-- to the LAYE instead, which is what broke SORT DIM below. going --
		-- straight to the LDIM by its own path sidesteps OWNER entirely --
		--------------------------------------------------------------------
		$!name/SS/S1/V1/ateLINE_$!dir
		SORT DIM
		--------------------------------------------------------------------
		-- the dimension LINE sits DOFFSET away from the FIRST point of the --
		-- chain (the GLAB block below works on exactly that, and has done  --
		-- since it was written). after SORT DIM the first point is the one --
		-- at the far end of the dimension, which is the corner point       --
		--                                                                   --
		-- so somebody dragging that corner point aside does not just move  --
		-- the point: the next run re-lays the whole dimension line out     --
		-- from it, and the line, its text and its labels all travel with   --
		-- it. measured live at 6.39mm -- exactly what the point had been   --
		-- dragged -- turning one hand adjustment into a whole dimension     --
		-- that reads as changed on the revision compare (2026-08-28)       --
		--                                                                   --
		-- the drag is meant to move that one point and nothing else, so    --
		-- DOFFSET gives back whatever the point took: the line lands       --
		-- exactly where an undragged chain would have put it, and only     --
		-- the point's own projection line is longer                        --
		--                                                                   --
		-- only for a point THIS run recognised as hand-moved. a first      --
		-- point sitting at its own depth for an honest reason (a labelled  --
		-- point holding the corner coordinate, say) is left to place the   --
		-- line the way it always has                                       --
		--------------------------------------------------------------------
		!dimshift = 0
		!mvn = 0
		!mvn = !movedrefs.size()
		handle any
			!mvn = 0
		endhandle
		if (!mvn.gt(0)) then
			!gfirst = 1
			$!gfirst
			handle any
			elsehandle none
				!m1ref = ce
				!m1moved = false
				do !mvi from 1 to !mvn
					!mvr = !movedrefs[!mvi]
					if (!m1ref.eq(!mvr)) then
						!m1moved = true
						break
					endif
				enddo
				if (!m1moved) then
					----------------------------------------------------------
					-- the depth every automatically placed point sits at.   --
					-- gridgap is already in sheet millimetres, and the      --
					-- offset runs OUTWARD -- confirmed against the run's    --
					-- own numbers: left border x 312.684395, its points at  --
					-- 309.684395, gridgap 3. ticks and both corners all sit --
					-- there, so one number covers every automatic point     --
					----------------------------------------------------------
					!ggap = !!DrawingPlan1.gridgap.val
					if (!dir.eq('right')) then
						!stddepth = !!DrawingPlan1.boxURsh.part(2).real() + !ggap
					elseif (!dir.eq('left')) then
						!stddepth = !!DrawingPlan1.boxULsh.part(2).real() - !ggap
					elseif (!dir.eq('down')) then
						!stddepth = !!DrawingPlan1.boxLLsh.part(4).real() - !ggap
					else
						!stddepth = !!DrawingPlan1.boxULsh.part(4).real() + !ggap
					endif
					var !m1pos pos
					var !m1posh shpos of $!m1pos
					if (!dir.eq('right') or !dir.eq('left')) then
						!m1depth = !m1posh.split().getindexed(2).replace('mm','').real()
					else
						!m1depth = !m1posh.split().getindexed(4).replace('mm','').real()
					endif
					if (!dir.eq('right') or !dir.eq('up')) then
						!dimshift = !m1depth - !stddepth
					else
						!dimshift = !stddepth - !m1depth
					endif
					-- dragged inwards, or not really dragged at all: nothing to give back --
					if (!dimshift.lt(0)) then
						!dimshift = 0
					endif
					-- and never so far that the line would cross its own points --
					if (!dimshift.gt(15)) then
						!dimshift = 15
					endif
					if (!dbgln) then
						!dbgf.writerecord('DIMSHIFT ' & !dir & ' std=' & !stddepth.string() & ' m1=' & !m1depth.string() & ' shift=' & !dimshift.string())
					endif
				endif
			endhandle
		endif
		$!name/SS/S1/V1/ateLINE_$!dir
		--------------------------------------------------------------------
		-- !dimoff is the same number as DOFFSET, kept so that the GLAB    --
		-- block below can work out where the dimension line ended up      --
		--                                                                  --
		-- where a line is already there, DOFFSET stops being the nominal  --
		-- 15 and becomes whatever it takes to put the line back exactly   --
		-- where it already was, measured from wherever the first point    --
		-- has ended up this run. the chain is a revision baseline: the    --
		-- corner point legitimately travels when the box edge moves, but  --
		-- the line must not travel with it, or the dimension, its text    --
		-- and every label on it read as changed (2026-08-29). the         --
		-- hand-drag compensation above is this same idea one revision     --
		-- earlier and stays in charge on the rebuild path, where there is --
		-- no previous line to hold on to                                  --
		--------------------------------------------------------------------
		!m1depthnow = 0
		!hasm1 = false
		if (!hasfrozen) then
			!gfirstf = 1
			$!gfirstf
			handle any
			elsehandle none
				var !f1pos pos
				var !f1posh shpos of $!f1pos
				if (!dir.eq('right') or !dir.eq('left')) then
					!m1depthnow = !f1posh.split().getindexed(2).replace('mm','').real()
				else
					!m1depthnow = !f1posh.split().getindexed(4).replace('mm','').real()
				endif
				!hasm1 = true
			endhandle
		endif
		$!name/SS/S1/V1/ateLINE_$!dir
		if (!hasfrozen and !hasm1) then
			------------------------------------------------------------
			-- !frozendepth is already the LINE's own depth (member 1   --
			-- plus its DOFFSET, read before anything moved), so what   --
			-- puts the line back is simply the gap to wherever the     --
			-- first point has ended up this run. no nominal 15 comes   --
			-- into it -- adding one made the line creep 15mm every     --
			-- update (reported live 2026-08-29)                        --
			------------------------------------------------------------
			!doffv = !frozendepth - !m1depthnow
			DOFFSET $!doffv
			!dimoff = !doffv
			if (!dbgln) then
				!dbgf.writerecord('DIMFROZEN ' & !dir & ' frozenline=' & !frozendepth.string() & ' m1now=' & !m1depthnow.string() & ' doff=' & !doffv.string())
			endif
		elseif (!dir.eq('right') or !dir.eq('up')) then
			!doffv = 15 - !dimshift
			DOFFSET $!doffv $( (10 - $!!DrawingPlan1.griddist.val) $)
			!dimoff = !doffv
		elseif (!dir.eq('left') or !dir.eq('down')) then
			!doffv = (15 - !dimshift) * -1
			DOFFSET $!doffv
			!dimoff = !doffv
		endif
		--------------------------------------------------------------------
		-- how far past the border the dimension reaches on its own. this  --
		-- is the NOMINAL 15, not the given-back DOFFSET above: the whole  --
		-- point of that is to land the line where a 15 off an undragged   --
		-- point would have landed it, so the band it occupies is the same --
		--------------------------------------------------------------------
		!gbandmax = !!DrawingPlan1.gridgap.val + 15
		
		----------------------------------------------------------
		-- rotate text 90 degree when distance is less than 7mm --
		----------------------------------------------------------
		
		$!name/SS/S1/V1/ateLINE_$!dir
		!mcount = mcount
		if (!mcount.gt(1)) then
			do !x from 1 to !mcount - 1
				$!x
				var !x1pos pos
				var !x1shpos shpos of $!x1pos
				!x1txt = ''
				var !x1txt pltxt
				handle any
					!x1txt = 'NONE'
				endhandle
				NEXT
				var !x2pos pos
				var !x2shpos shpos of $!x2pos
				!x2txt = ''
				var !x2txt pltxt
				handle any
					!x2txt = 'NONE'
				endhandle
				if (!dbgln) then
					!dbgf.writerecord('LDIMORDER ' & !dir & ' x=' & !x.string() & ' mcount=' & !mcount.string() & ' x1sh=' & !x1shpos & ' x2sh=' & !x2shpos & ' x1txt=[' & !x1txt & '] x2txt=[' & !x2txt & ']')
				endif
				if (!dir.eq('right') or !dir.eq('left')) then
					if (abs(!x1shpos.part(4).replace('mm','').real() - !x2shpos.part(4).replace('mm','').real()) le 7) then
						Dtangle Horizontal
						Dtoftx 'X 0mm Y 4mm'
					else
						Dtangle Vertical
						Dtoftx 'X 0mm Y 2.2mm'
					endif
				else
					if (abs(!x1shpos.part(2).replace('mm','').real() - !x2shpos.part(2).replace('mm','').real()) le 7) then
						Dtangle Vertical
						Dtoftx 'X 0mm Y 4mm'
					else
						Dtangle Horizontal
						Dtoftx 'X 0mm Y 2.2mm'
					endif
				endif
				OWNER
			enddo
		endif

		----------------------------------------------------------------------
		-- the pipe numbers, as labels of their own                          --
		--                                                                   --
		-- one GLAB per labelled point, filed on the same layer as the       --
		-- dimensions. its leader is aimed at the end of that point's own    --
		-- projection line: the point is DOFFSET away from the dimension     --
		-- line, so that end is the point's coordinate along the dimension   --
		-- paired with the dimension line's own coordinate, and the          --
		-- dimension line is DOFFSET from the first point of the dimension   --
		--                                                                   --
		-- labels which crowd together are stepped off the line one after    --
		-- the other and get a bent leader back to the same place, so the    --
		-- text moves but it is still plain which point it belongs to. the   --
		-- first label of a crowd never moves                                --
		----------------------------------------------------------------------
		if (!glabrec.size().gt(0)) then
			------------------------------------------------------------------
			-- where the dimension line ended up                             --
			------------------------------------------------------------------
			$!name/SS/S1/V1/ateLINE_$!dir
			!gfirst = 1
			$!gfirst
			var !gfpos pos
			var !gfshpos shpos of $!gfpos
			if (!dir.eq('right') or !dir.eq('left')) then
				!dimline = !gfshpos.part(2).replace('mm','').real() + !dimoff
			else
				!dimline = !gfshpos.part(4).replace('mm','').real() + !dimoff
			endif
			OWNER
			------------------------------------------------------------------
			-- how far the dimension line itself sits past the border of the --
			-- view. each label below adds its own length to this            --
			------------------------------------------------------------------
			if (!dir.eq('right')) then
				!gdimdist = !dimline - !vwx2
			elseif (!dir.eq('left')) then
				!gdimdist = !vwx1 - !dimline
			elseif (!dir.eq('up')) then
				!gdimdist = !dimline - !vwy2
			else
				!gdimdist = !vwy1 - !dimline
			endif
			if (!gdimdist.gt(!gbandmax)) then
				!gbandmax = !gdimdist
			endif
			------------------------------------------------------------------
			-- sort the labels along the dimension, so that 'the one before'  --
			-- means the neighbour on the sheet. insertion sort -- PML has no --
			-- sort which can be given a key, and .sort() on the records      --
			-- would order them by their text                                 --
			------------------------------------------------------------------
			!glaba = object array()
			do !i from 1 to !glabrec.size()
				!glaba[!i] = !glabrec[!i].split('~').getindexed(4).real()
			enddo
			do !i from 2 to !glabrec.size()
				!gka = !glaba[!i]
				!gkr = !glabrec[!i]
				!j = !i - 1
				-- the subscripts are worked out into their own variable: an --
				-- expression inside [] is not something the rest of this    --
				-- codebase ever asks PML to parse                           --
				do !k from 1 to !i
					break if (!j lt 1)
					break if (!glaba[!j] le !gka)
					!jn = !j + 1
					!glaba[!jn] = !glaba[!j]
					!glabrec[!jn] = !glabrec[!j]
					!j = !j - 1
				enddo
				!jn = !j + 1
				!glaba[!jn] = !gka
				!glabrec[!jn] = !gkr
			enddo
			------------------------------------------------------------------
			-- which way the text runs from the dimension line, and which    --
			-- way a crowded label is stepped. the text of the up and down   --
			-- sides is turned 90 degree, as its Pltxt used to be            --
			--                                                               --
			-- it runs OUTWARD, away from the view, into the clear paper past --
			-- the dimension line -- that is the whole point of moving the    --
			-- pipe numbers onto labels of their own (user marked the wanted  --
			-- positions in red, 2026-08-21). the first attempt ran them      --
			-- inward the way the old Pltxt did, which just put the text back --
			-- on top of the drawing                                          --
			--                                                               --
			-- justification follows: the text origin is its own leading end, --
			-- so the end nearest the dimension line is the justified one     --
			------------------------------------------------------------------
			!goutx = 0
			!gouty = 0
			!gstepx = 0
			!gstepy = 0
			!gadeg = 0
			!gjust = 'Right'
			if (!dir.eq('right')) then
				!goutx = 1
				!gstepy = 1
				!gjust = 'Left'
			elseif (!dir.eq('left')) then
				!goutx = -1
				!gstepy = 1
				!gjust = 'Right'
			elseif (!dir.eq('up')) then
				!gouty = 1
				!gstepx = 1
				!gadeg = 90
				!gjust = 'Left'
			else
				!gouty = -1
				!gstepx = 1
				!gadeg = 90
				!gjust = 'Right'
			endif
			------------------------------------------------------------------
			-- rcode = left turns the whole view 90 degree anticlockwise on   --
			-- the sheet, and a label's ADEG is read in the view, not on the  --
			-- sheet. so the angle worked out above, which is the angle       --
			-- wanted on the sheet, has the view's own turn taken back off    --
			-- it -- exactly what .CreateGridSymbolwithIntersection() does    --
			-- with its Adegrees -90 (2026-08-21: without this every label    --
			-- came out square to the view instead of square to the sheet)    --
			------------------------------------------------------------------
			if (!!DrawingPlan1.rcode.eqnocase('left')) then
				!gadeg = !gadeg - 90
			endif
			------------------------------------------------------------------
			-- which way the text is nudged clear of its own leader. the     --
			-- leader runs along the text, so the air has to be across it:   --
			-- the sheet axis the dimension itself is measured in            --
			--                                                               --
			-- and it has to be the side the letters are on. Alignment Base  --
			-- puts them on the +Y side of their own baseline, which for the --
			-- turned text of the up and down sides is sheet -X: nudging     --
			-- those +X walked the leader into the middle of the letters     --
			-- instead of away from them (2026-08-21, reported live)         --
			------------------------------------------------------------------
			!ggapx = 0
			!ggapy = 0
			if (!dir.eq('right') or !dir.eq('left')) then
				!ggapy = 1
			else
				!ggapx = -1
			endif
			------------------------------------------------------------------
			-- the dimension figures sit between the line and the label on    --
			-- the up and left sides, so both the first bend and the start of --
			-- the text have to clear them there. down and right are already  --
			-- clear -- the figures fall on the other side of the line, which --
			-- is why the user asked for those two to be left alone           --
			------------------------------------------------------------------
			!gclrb = !glabclr
			!grun = !glabrun
			if (!dir.eq('up') or !dir.eq('left')) then
				!gclrb = !glabclr + !glabfig
				!grun = !glabrun + !glabfig
			endif
			------------------------------------------------------------------
			-- the grid annotation of this side, as bands along the          --
			-- dimension which a label may not sit across                    --
			--                                                               --
			-- a grid line runs from the border of the view out past its     --
			-- bubble, ie right through the band the labels are written in,  --
			-- so a label at the same coordinate crosses it whatever its     --
			-- length -- the user found a pipe number written straight       --
			-- through the H bubble (2026-08-24). there is nothing to test    --
			-- against the label's own length: EXBTEXT, which is what the     --
			-- width is counted from, only exists once the label has been     --
			-- created                                                       --
			--                                                               --
			-- the band is as wide as the bubble, so it covers the worst of   --
			-- the line as well. the Grid tab's Diameter is the size the user --
			-- has already set for those bubbles                             --
			------------------------------------------------------------------
			!gside = 'Right'
			if (!dir.eq('left')) then
				!gside = 'Left'
			elseif (!dir.eq('up')) then
				!gside = 'Top'
			elseif (!dir.eq('down')) then
				!gside = 'Bottom'
			endif
			!gbubs = object array()
			!gbubs = !!DrawingPlan1GridBubbles
			handle any
				!gbubs = object array()
			endhandle
			!gblock = object array()
			do !gbv values !gbubs
				!gbp = !gbv.split('~')
				if (!gbp.getindexed(1).eq(!gside)) then
					if (!dir.eq('right') or !dir.eq('left')) then
						!gblock.append(!gbp.getindexed(3).replace('mm','').real())
					else
						!gblock.append(!gbp.getindexed(2).replace('mm','').real())
					endif
				endif
			enddo
			!ghalf = !!DrawingPlan1.griddia.val * 0.5 + !glabgrid
			------------------------------------------------------------------
			-- the letters sit on one side of the baseline: +Y on the right   --
			-- and left sides, and -X on the turned text of the up and down   --
			-- ones, the same side the text is nudged towards                 --
			------------------------------------------------------------------
			if (!dir.eq('right') or !dir.eq('left')) then
				!gloff = 0
			else
				!gloff = -1
			endif
			------------------------------------------------------------------
			-- and draw them                                                 --
			------------------------------------------------------------------
			$!name/SS/S1/V1/ateLINE
			!gprev = 0
			!gprevplace = 0
			!gfirstlab = true
			do !i from 1 to !glabrec.size()
				!gparts = !glabrec[!i].split('~')
				!gtext = !gparts.getindexed(1)
				!gelem = !gparts.getindexed(2)
				!gchei = !gparts.getindexed(3)
				--------------------------------------------------------------------
				-- snapped to 0.001mm, the same grid XYPO and BPOF are written on.  --
				-- POSITION is built from this, so all three then land on one grid  --
				-- and a label that works out to the same place twice comes out     --
				-- byte for byte the same place                                     --
				--                                                                  --
				-- without it the sum does not close: an element that has moved     --
				-- carries POSITION the exact distance (1.666667mm on paper for a   --
				-- 50mm move at 1:30) while XYPO and BPOF can only answer 1.667,    --
				-- and the leader ends up a few thousandths out. reported live      --
				-- 2026-08-30 as two parallel leader runs about 0.01mm apart, and   --
				-- it is the same residue the BPOF note below already describes --   --
				-- not only near a .xx5 boundary, as was thought then, but on any   --
				-- move that is not a round number of sheet mm                      --
				--                                                                  --
				-- costs the attach point up to 0.0005mm against its own element    --
				--------------------------------------------------------------------
				!galong = !gparts.getindexed(4).real().string('D3').real()
				!gup = !gparts.getindexed(5).real()
				----------------------------------------------------------------------
				-- update path: an existing GLAB must never move, or every update    --
				-- would draw a revision cloud over labels nothing actually changed  --
				-- about (2026-08-27, confirmed live -- required for revision        --
				-- compare to mean anything). found by DDNA plus a re-derived        --
				-- along-position (the candidate's own unmoved model POSITION run   --
				-- back through the current view), which stays put regardless of    --
				-- packing pushes, so it is a safe key even when several elements   --
				-- share one DDNA                                                    --
				--                                                                    --
				-- its already-placed !gplace is recovered algebraically from its    --
				-- stored XYPO rather than re-run through the push/grid-band logic   --
				-- below: for right/left GTXX carries no !gstep term at all (GOUTX=0 --
				-- on that axis) and GTXY = !gstep + !glabtxtgap; for up/down it is  --
				-- the other way round, GTXX = !gstep - !glabtxtgap. solving either  --
				-- for !gstep and adding it back to !galong reproduces !gplace       --
				-- exactly, so the rest of this function (which recomputes GXYPO     --
				-- from !gplace the same way for every item) writes back the same    --
				-- number it already had -- nothing needs skipping further down      --
				----------------------------------------------------------------------
				----------------------------------------------------------------------
				-- !existingglabs spans all four sides (collected once, above the   --
				-- per-direction loop), and the same DDNA can legitimately carry a  --
				-- GLAB on more than one side, or more than once on the same side   --
				-- (an elbow crossing twice) -- the DPOI dedup earlier hit the same --
				-- shape of bug taking the first DDNA match instead of the closest, --
				-- which dragged the wrong point across the drawing. so every      --
				-- candidate is checked and the nearest by along-position wins,     --
				-- never the first                                                 --
				----------------------------------------------------------------------
				!gisexisting = false
				!gbestalongdiff = -1
				do !eg values !existingglabs
					$!eg
					handle any
					elsehandle none
						var !egddna ddna of ce
						if (not(!egddna.unset()) and !egddna.eq(!gelem)) then
							----------------------------------------------------------
							-- AT is not a gettable attribute (missing from a live   --
							-- Q ATT dump of a GLAB, 2026-08-27), so the candidate's --
							-- own along-position is recovered the same way !gposobj --
							-- below is: its (unmoved, model-space) POSITION run     --
							-- back through the current view via shpos of           --
							----------------------------------------------------------
							!egalong = 0
							!egdepth = 0
							!egmatched = false
							var !egpos position
							handle any
							elsehandle none
								!egposobj = object position(!egpos)
								var !egsh shpos of $!egposobj
								handle any
								elsehandle none
									if (!dir.eq('right') or !dir.eq('left')) then
										!egalong = !egsh.part(4).replace('mm', '').real()
										!egdepth = !egsh.part(2).replace('mm', '').real()
									else
										!egalong = !egsh.part(2).replace('mm', '').real()
										!egdepth = !egsh.part(4).replace('mm', '').real()
									endif
									!egmatched = true
								endhandle
							endhandle
							if (!dbgln) then
								!dbgf.writerecord('GLABEXISTCAND ' & !dir & ' i=' & !i.string() & ' galong=' & !galong.string() & ' egalong=' & !egalong.string() & ' egdepth=' & !egdepth.string() & ' dimline=' & !dimline.string() & ' egmatched=' & !egmatched)
							endif
							!egalongdiff = abs(!egalong - !galong)
							----------------------------------------------------------
							-- the DDNA above has already proved this is the same    --
							-- element's label, so there is no along-distance cap    --
							-- here: the element is allowed to have MOVED. a 1mm cap --
							-- used to stand here and it rejected exactly the case   --
							-- this whole revision path exists for -- a pipe shifted --
							-- 100mm in the model is 3.3mm on paper, so its own      --
							-- label was declared missing, a second one was built    --
							-- beside it, and cleanup kept the first because its     --
							-- DDNA was still current: two labels on one pipe        --
							-- (reported live 2026-08-30, three pipes moved, three   --
							-- doubled labels -- 1727 and 1761 down, 2697 up)        --
							--                                                        --
							-- what the cap was really doing was keeping this side   --
							-- from stealing the same element's label off another    --
							-- side, since !existingglabs spans all four. the DEPTH  --
							-- axis does that properly and does not care how far    --
							-- along anything moved: every label of a side sits on   --
							-- that side's row, outside the box, and the rows are    --
							-- tens of mm apart on paper. 5mm of slack because the   --
							-- row itself can shift a little between runs (0.84mm    --
							-- measured on the run this was found in)                --
							--                                                        --
							-- and never a label some earlier element already took.  --
							-- the cap used to separate two labels sharing a DDNA on --
							-- one side (an elbow crossing twice); with it gone,     --
							-- nearest-wins alone would hand both of them the same   --
							-- object                                                --
							----------------------------------------------------------
							!egsameside = false
							if (!egmatched) then
								!egdepthdiff = abs(!egdepth - !dimline)
								if (!egdepthdiff.lt(5)) then
									!egsameside = true
								endif
							endif
							!egref = ce
							!egclaimed = false
							do !cg values !claimedglabs
								if (!egref.eq(!cg)) then
									!egclaimed = true
									break
								endif
							enddo
							if (!egsameside and not(!egclaimed) and (!gbestalongdiff.lt(0) or !egalongdiff.lt(!gbestalongdiff))) then
								!gisexisting = true
								!gexistingref = ce
								!gbestalongdiff = !egalongdiff
								!gexistalong = !egalong
							endif
						endif
					endhandle
				enddo
				----------------------------------------------------------------------
				-- fallback: nothing shared this item's own ddna at all. E3D can       --
				-- resolve a boundary attach point to a different neighbouring member  --
				-- of the same bent tube across runs even though the point on the      --
				-- sheet has not actually moved -- right i=1 stayed pinned to          --
				-- =67128186/19424819 every run while its real previous label lived    --
				-- on =67177338/9369496, a different member 2.5mm away on the same     --
				-- along-axis. with no ddna match at all it never froze, so it kept    --
				-- being recomputed a little differently each run while the old        --
				-- object it used to be sat unclaimed and got cleaned up as an orphan  --
				-- (2026-08-27, reported live as a small but persistent drift between  --
				-- rebuild and update). so a second pass drops the ddna requirement    --
				-- and matches on along-position alone, same tolerance and             --
				-- closest-wins rule as above                                          --
				----------------------------------------------------------------------
				if (not(!gisexisting)) then
					!gbestalongdiff = -1
					do !eg values !existingglabs
						$!eg
						handle any
						elsehandle none
							!egalong = 0
							!egdepth = 0
							!egmatched = false
							var !egpos position
							handle any
							elsehandle none
								!egposobj = object position(!egpos)
								var !egsh shpos of $!egposobj
								handle any
								elsehandle none
									if (!dir.eq('right') or !dir.eq('left')) then
										!egalong = !egsh.part(4).replace('mm', '').real()
										!egdepth = !egsh.part(2).replace('mm', '').real()
									else
										!egalong = !egsh.part(2).replace('mm', '').real()
										!egdepth = !egsh.part(4).replace('mm', '').real()
									endif
									!egmatched = true
								endhandle
							endhandle
							--------------------------------------------------------------
							-- root cause, found live 2026-09-02: this loop has no ddna  --
							-- to go on at all (that is the whole point of it -- dropped --
							-- a few lines up), so with no depth/side guard the 1mm      --
							-- along-only test happily matches this pipe's own label on  --
							-- a DIFFERENT side (right/left/up/down all carry a GLAB for --
							-- the same multi-directional pipe, and !existingglabs spans --
							-- all four) whenever the two sides' raw sheet coordinates   --
							-- happen to land within 1mm of each other by coincidence.   --
							-- confirmed live: 660005's 'right' label adopted a wholly   --
							-- unrelated existing glab's POSITION (9m/2.3m away in world --
							-- space) this way, on a clean rebuild+update with nothing   --
							-- stale in the model -- the match itself was simply wrong.  --
							-- same fix as the strict-ddna loop above: require the       --
							-- candidate's DEPTH to sit within 5mm of this side's own    --
							-- dimension line before its along-position is trusted, and  --
							-- skip anything another element already claimed             --
							--------------------------------------------------------------
							!egsameside = false
							if (!egmatched) then
								!egdepthdiff = abs(!egdepth - !dimline)
								if (!egdepthdiff.lt(5)) then
									!egsameside = true
								endif
							endif
							!egref = ce
							!egclaimed = false
							do !cg values !claimedglabs
								if (!egref.eq(!cg)) then
									!egclaimed = true
									break
								endif
							enddo
							!egalongdiff = abs(!egalong - !galong)
							if (!egsameside and not(!egclaimed) and !egalongdiff.lt(1) and (!gbestalongdiff.lt(0) or !egalongdiff.lt(!gbestalongdiff))) then
								!gisexisting = true
								!gexistingref = ce
								!gbestalongdiff = !egalongdiff
								!gexistalong = !egalong
							endif
						endhandle
					enddo
					if (!dbgln) then
						!dbgf.writerecord('GLABPOSFALLBACK ' & !dir & ' i=' & !i.string() & ' isexisting=' & !gisexisting & ' bestalongdiff=' & !gbestalongdiff.string())
					endif
				endif
				if (!gisexisting) then
					$!gexistingref
					!gexxypo = ''
					var !gexxypo xypo
					handle any
						!gisexisting = false
					endhandle
				endif
				if (!gisexisting) then
					!claimedglabs.append(!gexistingref)
					!gexx = !gexxypo.part(1).replace('mm', '').real()
					!gexy = !gexxypo.part(2).replace('mm', '').real()
					if (!!DrawingPlan1.rcode.eqnocase('left')) then
						!gextmp = !gexx
						!gexx = !gexy * -1
						!gexy = !gextmp
					endif
					if (!dir.eq('right') or !dir.eq('left')) then
						!gstep = !gexy - !glabtxtgap
					else
						!gstep = !gexx + !glabtxtgap
					endif
					!gplace = !galong + !gstep
					--------------------------------------------------------------
					-- kept aside, untouched, so the packing/push logic below   --
					-- can overwrite !gstep freely without losing the value      --
					-- this label's own stored XYPO actually decodes to -- see  --
					-- the note where it is read back, further down             --
					--------------------------------------------------------------
					!gexiststep = !gstep
				endif
				--------------------------------------------------------------------
				-- an existing label keeps the placement it was given -- that is    --
				-- the whole point, an update must not shuffle labels nothing has   --
				-- happened to -- but only while that placement still WORKS. the    --
				-- rule was written when nothing in the model could move, so it     --
				-- froze the anti-collision packing along with everything else; a   --
				-- pipe that has since slid towards its neighbour then keeps a      --
				-- step of zero it can no longer afford and the two labels are      --
				-- written on top of each other (reported live 2026-08-30: down     --
				-- i=6 landed 2.055mm after i=5 with glabmin 4, and 100-A-15 sat    --
				-- across 100-A-18, which had not moved at all)                     --
				--                                                                  --
				-- so the freeze is conditional from here on: keep the inherited    --
				-- place while it clears the label before it, otherwise fall        --
				-- through to the packing below and earn a new one. only the        --
				-- PLACEMENT is given up -- the GLAB object itself is still reused  --
				-- (that is decided further down by !foundglab, not here), so this  --
				-- moves a label rather than replacing it                           --
				--                                                                  --
				-- one-sided on purpose: a label whose neighbour has moved AWAY     --
				-- keeps its old step even though it no longer needs one. tidier    --
				-- to undo it, but that would move a label for cosmetic reasons     --
				-- and draw a revision cloud over something nobody changed          --
				--------------------------------------------------------------------
				--------------------------------------------------------------------
				-- where the packing below starts from.                            --
				--                                                                  --
				-- for a new label that is simply where its element is. for one     --
				-- that already exists it is where that label actually SITS, which  --
				-- is its own along plus the step read back out of its XYPO -- not  --
				-- this element's new along, and not the step carried across onto   --
				-- it                                                               --
				--                                                                  --
				-- the packing is then run over that seed either way, so an         --
				-- existing label stays exactly where it is while that place still  --
				-- works, and is pushed only when it does not: crowded by the       --
				-- label before it, or sitting on a grid band. that is the 8/27     --
				-- rule (an existing GLAB does not move, or every update draws      --
				-- revision clouds over labels nothing happened to) with the one    --
				-- exception it always needed                                       --
				--                                                                  --
				-- two earlier shapes of this were both wrong. freezing outright    --
				-- skipped the packing, so a pipe that slid towards its neighbour   --
				-- kept a step of zero it could no longer afford and the two texts  --
				-- were written on top of each other. recomputing from the new      --
				-- along whenever the element moved fixed that but threw the        --
				-- placement away every time, so a label with room around it        --
				-- chased its pipe for no reason -- the down row moved while the    --
				-- up row, being crowded, did not, and the two rows stopped         --
				-- looking like they followed the same rule (2026-08-30)            --
				--                                                                  --
				-- idempotent: with nothing changed the seed IS the current place   --
				-- and the packing leaves it alone                                  --
				--------------------------------------------------------------------
				!gseed = !galong
				if (!gisexisting) then
					!gseed = !gexistalong + !gstep
				endif
				if (!dbgln) then
					!dbgf.writerecord('GLABSEED ' & !dir & ' i=' & !i.string() & ' elem=' & !gelem & ' isexisting=' & !gisexisting & ' seed=' & !gseed.string('D3') & ' along=' & !galong.string('D3') & ' movedby=' & !gbestalongdiff.string('D3'))
				endif
				-------------------------------------------------------------
				-- pack the labels along the dimension: each one goes where  --
				-- it belongs unless that is less than !glabmin from the one --
				-- before, in which case it is pushed on just far enough to  --
				-- clear it. !gstep is how far it had to move, and anything  --
				-- which had to move gets a bent leader back to its own      --
				-- projection line                                           --
				--                                                           --
				-- the list is sorted ascending, so the push is always       --
				-- forwards. the first try stepped a fixed 5mm in -Y on the  --
				-- right and left sides, ie backwards, which dropped every   --
				-- crowded label straight onto its predecessor -- check.txt  --
				-- had i=2 at 203.512 pushed to 199.5 and i=1 sitting at     --
				-- 199.98 (2026-08-21). a fixed step forwards is no better:  --
				-- it just lands on whatever comes next. pushing only as far --
				-- as needed, from one label to the next, cannot collide     --
				-------------------------------------------------------------
				----------------------------------------------------------------
				-- tried making this width-aware for up/down (their text is   --
				-- turned 90 degree, so it looked like width ran along the    --
				-- line instead of across it): using the frozen neighbour's   --
				-- real text width as the minimum gap overshot every time it  --
				-- was tried, first by an order of magnitude (28.7mm) when    --
				-- applied to right/left too, then still far too much (62.8mm --
				-- for a 28-character pipe name) once narrowed to up/down     --
				-- alone. check.txt's own long-settled up/down pairs (i=1..7, --
				-- none of them new) sit exactly !glabmin=4mm apart with no   --
				-- overlap ever reported, which is the real evidence: rotated --
				-- or not, a flat !glabmin has always been enough on this     --
				-- axis, so the extra width term was solving the wrong        --
				-- problem (2026-08-27, reverted after three rounds of        --
				-- overshoot reports on the same i=7/i=8 pair)                --
				----------------------------------------------------------------
				!gminclr = !glabmin
				!gplace = !gseed
				if (not(!gfirstlab)) then
					!gmin = !gprevplace + !gminclr
					if (!gplace lt !gmin) then
						!gplace = !gmin
					endif
				endif
				-------------------------------------------------------------
				-- and out of any grid band it would be written across      --
				--                                                          --
				-- which way it steps matters: the leader has to travel     --
				-- from the attach point to wherever the text ends up, so   --
				-- stepping across the grid line only trades the text       --
				-- crossing it for the leader crossing it, which is what    --
				-- the user saw at the H bubble (2026-08-24). so it steps   --
				-- out on the side the attach point is already on, and only --
				-- takes the other side when that one is shut               --
				--                                                          --
				-- shut means the label before it is in the way: the labels --
				-- are placed in ascending order, so stepping back is the   --
				-- one direction which can collide with what is already     --
				-- placed. !glowbound is how far back it may go             --
				--                                                          --
				-- the outer loop is there because clearing one band can    --
				-- drop the label into the next one; it can run at most as  --
				-- many times as there are bands                            --
				-------------------------------------------------------------
				!gcheir = !gchei.real()
				!glowoff = !gloff * !gcheir
				!glowbound = 0
				!ghaslow = false
				if (not(!gfirstlab)) then
					!glowbound = !gprevplace + !gminclr
					!ghaslow = true
				endif
				-- the side the attach point is on, from the first band it hits --
				!gback = true
				do !gbc values !gblock
					!gb1 = !gbc - !ghalf
					!gb2 = !gbc + !ghalf
					!glo = !gplace + !glowoff
					!ghi = !glo + !gcheir
					if (!glo lt !gb2 and !ghi gt !gb1) then
						if (!galong gt !gbc) then
							!gback = false
						endif
						break
					endif
				enddo
				do !kk from 1 to !gblock.size()
					!gmoved = false
					do !gbc values !gblock
						!gb1 = !gbc - !ghalf
						!gb2 = !gbc + !ghalf
						!glo = !gplace + !glowoff
						!ghi = !glo + !gcheir
						if (!glo lt !gb2 and !ghi gt !gb1) then
							if (!gback) then
								!gnew = !gb1 - !gcheir - !glowoff
								if (!ghaslow and !gnew lt !glowbound) then
									-- no room behind: go the other way instead --
									!gback = false
									!gplace = !gb2 - !glowoff
								else
									!gplace = !gnew
								endif
							else
								!gplace = !gb2 - !glowoff
							endif
							!gmoved = true
						endif
					enddo
					break if (not(!gmoved))
				enddo
				--------------------------------------------------------------------
				-- root cause, found live 2026-09-01: this subtraction is exactly  --
				-- what the comment below already describes as wrong -- !galong is --
				-- this run's fresh box-edge intersection, and it drifts by a      --
				-- fraction of a mm on every box resize even for a label whose own --
				-- seed (and therefore !gplace, when nothing pushed it off that    --
				-- seed) came straight from its own frozen XYPO. subtracting a     --
				-- drifting !galong from a frozen !gplace hands back a !gstep that --
				-- drifts by the same fraction the OTHER way -- not 0.03mm, not    --
				-- once: every dimension on the growing side, every single resize, --
				-- forever, because REVI compares pictures and does not forgive    --
				-- 0.0001mm (user rule, 2026-09-01: once a GLAB exists and a REVI  --
				-- is on the drawing, its position is fixed, full stop, no matter  --
				-- how the box changes, or every resize clouds the whole drawing)  --
				--                                                                  --
				-- second root cause, found live 2026-09-01 (same day, later): the --
				-- !gplaceseeddiff.lt(0.0001) gate below was meant to only refreeze --
				-- when nothing pushed !gplace off the seed -- but the packing loop --
				-- above repacks the WHOLE band together, so dropping a neighbour   --
				-- out of the band (its pipe left the box on a resize, or it simply --
				-- stopped being labelled) nudges !gplace for every survivor by a   --
				-- fraction of a mm even though none of them individually moved,    --
				-- which failed the gate and put this straight back through the     --
				-- same fresh subtraction the block above exists to avoid. live     --
				-- data: 660284/287/105/141 each isexisting with movedby=0.000, yet --
				-- !gplace still drifted ~0.055mm off !gseed once 660303/660507     --
				-- fell out of the same right-hand band on an ~1.9m box shrink --   --
				-- so the tolerance check itself cannot be trusted; per the user's  --
				-- rule above there is no magnitude of drift that is acceptable,    --
				-- so there is no tolerance to check: existing means frozen         --
				--------------------------------------------------------------------
				!gfrozen = !gisexisting
				if (!gfrozen) then
					!gstep = !gexiststep
				else
					!gstep = !gplace - !galong
				endif
				----------------------------------------------------------------
				-- snapped to the same 3 decimals XYPO is written with. an     --
				-- update does not recompute a frozen label's !gstep, it reads  --
				-- it back out of the stored XYPO -- which is a 3 decimal       --
				-- string -- so the update's !gstep always sits exactly on that --
				-- grid while a rebuild's came straight off the subtraction and --
				-- carries the full tail                                        --
				--                                                              --
				-- that tail matters because the leader's bend points are       --
				-- written at TWO decimals (BPOF, below): a !gstep landing near --
				-- a .xx5 boundary rounds one way from the full value and the   --
				-- other way from the stored one, and the bend moves 0.01mm     --
				-- between a rebuild and the update straight after it. only the --
				-- few labels sitting on such a boundary move, which is exactly --
				-- what was reported live (2026-08-28) -- with every logged     --
				-- quantity, POSITION XYPO BPOFTX CPOFTX included, identical    --
				-- between the two runs, because the log is written before BPOF --
				-- is applied                                                   --
				--                                                              --
				-- snapping here makes both paths start from the same number,   --
				-- so every later rounding lands the same way                    --
				----------------------------------------------------------------
				!gstepstr = !gstep.string('D3')
				!gstep = !gstepstr.real()
				-- how far it moved, either way. a label which had to step BACK  --
				-- to stay on its own side of a grid line has a negative !gstep, --
				-- and the two tests below used to ask .gt(0.01), so those got   --
				-- neither the bent leader nor the clearance meant for a stepped --
				-- label: check.txt had step=-6.242 come out lshape=Straight     --
				-- with bpoftx X 0mm Y 0mm (2026-08-24, reported live)           --
				!gstepabs = abs(!gstep)
				!gprevplace = !gplace
				-------------------------------------------------------------
				-- the end of this point's projection line, in sheet        --
				-- coordination, is what the leader is aimed at             --
				-------------------------------------------------------------
				--------------------------------------------------------------------
				-- reverted 2026-09-02, same day as the DPOI POSITION revert      --
				-- above: !galongat is the leader's DIMENSION-LINE-side end, and  --
				-- it belongs to the DPOI, not to the label -- it has to sit on   --
				-- the dot, wherever the dot actually is, or the leader points at --
				-- empty space next to it instead of starting from it. freezing   --
				-- it to !gexistalong (the GLAB's own past reprojection) was only --
				-- ever needed to kill fresh-intersection noise for a dot that    --
				-- has not really moved -- but !galong already carries that:      --
				-- it is read from !glabrec, which was filled from !ptx/!pty back --
				-- in the DPOI loop above, and that loop now only writes the      --
				-- fresh intersection into !ptx/!pty when the dot itself crossed  --
				-- the 5mm bar (see the DPOI POSITION revert). so !galong is the  --
				-- frozen, noise-free value when the dot did not move and the     --
				-- fresh one when it genuinely did -- exactly the dot's own real  --
				-- position either way, which is what the leader is supposed to   --
				-- aim at. a diagonal pipe's dot sliding along a moved box edge   --
				-- (reported live, TEST-0000010001) is exactly the case this      --
				-- undoes the freeze for: the label's XYPO stays put (!gstep is   --
				-- still frozen above, unconditionally), only this end moves, so  --
				-- the leader bends to reach it instead of drawing to the old spot --
				--------------------------------------------------------------------
				!galongat = !galong
				if (!dir.eq('right') or !dir.eq('left')) then
					!gatx = !dimline
					!gaty = !galongat
				else
					!gatx = !galongat
					!gaty = !dimline
				endif
				!gat = 'X ' & !gatx.string('D3') & 'mm Y ' & !gaty.string('D3') & 'mm'
				--------------------------------------------------------------------
				-- added 2026-09-02, alongside the !galongat revert above: BPOF is --
				-- measured FROM AT (confirmed in the comment further down, from   --
				-- the hand-built label), but the text itself sits at a FROZEN     --
				-- POSITION plus !gstep -- and AT can now genuinely be somewhere   --
				-- else, since it tracks the dot's real position instead of       --
				-- freezing with the label. !gstep alone no longer measures how   --
				-- far the leader has to reach: it only measures the packing push --
				-- from BEFORE the dot moved. !gatdrift is how far AT has moved   --
				-- since this label's frozen POSITION was built (0 for a label    --
				-- that is not existing yet, since there is nothing to have       --
				-- drifted from); !gleadstep folds that back in so the leader's   --
				-- bend -- not the text's XYPO, which must stay exactly as it was --
				-- reaches the text instead of stopping short of it, which is     --
				-- what a diagonal pipe's dot sliding along a moved box edge      --
				-- looked like (reported live, TEST-0000010001: dot moved, text   --
				-- correctly did not, leader stayed flat and missed both)         --
				--------------------------------------------------------------------
				!gatdrift = 0
				if (!gisexisting) then
					!gatdrift = !galongat - !gexistalong
				endif
				!gleadstep = !gstep - !gatdrift
				!gleadstepabs = abs(!gleadstep)
				-------------------------------------------------------------
				-- a label which has not been stepped keeps the old look:   --
				-- text right up against the dimension line, sitting on its --
				-- own projection line. a stepped one starts where its      --
				-- leader stops turning, so the leader meets the text at    --
				-- its edge instead of poking out from under it             --
				-------------------------------------------------------------
				if (!gleadstepabs.gt(0.01)) then
					!gclr = !grun + !glabdiag
				else
					!gclr = !gclrb
				endif
				!gtxx = !goutx * !gclr + !gstepx * !gstep + !ggapx * !glabtxtgap
				!gtxy = !gouty * !gclr + !gstepy * !gstep + !ggapy * !glabtxtgap
				-------------------------------------------------------------
				-- everything above is worked out on the sheet, but XYPO is  --
				-- read in the view. when rcode = left the view is turned 90 --
				-- degree anticlockwise, so the offset is turned back the    --
				-- same way before it is written -- the same conversion      --
				-- .CreateGridSymbolwithIntersection() makes for its own     --
				-- XYPO and APOF                                             --
				-------------------------------------------------------------
				if (!!DrawingPlan1.rcode.eqnocase('left')) then
					!gtmp = !gtxx
					!gtxx = !gtxy
					!gtxy = !gtmp * -1
				endif
				!gxypo = !gtxx.string('D3') & ' ' & !gtxy.string('D3')
				-- one line per label while the stepping is being settled --
				if (!dbgln) then
					-- abs() cannot be asked for a method straight off, it needs a variable --
					!ggap = abs(!galong - !gprev)
					!dbgf.writerecord('GLABROW ' & !dir & ' i=' & !i.string() & ' along=' & !galong.string('D3') & ' prev=' & !gprev.string('D3') & ' gap=' & !ggap.string('D3') & ' step=' & !gstep.string('D3') & ' xypo=' & !gxypo & ' text=' & !gtext)
				endif
				-------------------------------------------------------------
				-- the same point as a model position. a label's POSITION is --
				-- a model one -- the label the user built by hand reads     --
				-- Position W 250093mm N 4816876mm U 8600mm -- and ABSO / AT --
				-- with a sheet position does not touch it: check.txt came   --
				-- back 'position = unset' for every label, which is why     --
				-- they all fell back on their own element's position and    --
				-- sat out in the middle of the view (2026-08-21)            --
				--                                                           --
				-- ENUPOS OF <sheet position> is E3D's own way back to the   --
				-- model and the grid crossings above already use it, so     --
				-- there is no need to invert .ViewSheetTransform() by hand  --
				-- (the first attempt at that also appended a second 'mm' to --
				-- a value which already carried one, so the command was     --
				-- never accepted in the first place)                        --
				-------------------------------------------------------------
				!gsh = 'x ' & string(!gatx) & ' y ' & string(!gaty)
				var !gpos enupos of $!gsh
				!gposobj = object position(!gpos)
				--------------------------------------------------------------------
				-- update path: this element may already carry a GLAB from a       --
				-- previous run, found by matching DDNA back to !gelem. within 5mm, --
				-- leave its POSITION exactly where it is; beyond that, move the    --
				-- same element instead of creating a second one. everything else   --
				-- (BTEXT/CHEI/etc) always reapplies either way -- E3D's compare is --
				-- picture-based, so setting an attribute back to its own value     --
				-- draws no cloud                                                   --
				--------------------------------------------------------------------
				!currentgelems.append(!gelem)
				--------------------------------------------------------------------
				-- same reasoning as the DPOI match above: an element could in     --
				-- principle carry more than one GLAB sharing its DDNA, so every   --
				-- candidate is checked and the nearest one to this label's own    --
				-- target position is reused, instead of stopping at the first    --
				-- DDNA match found                                                --
				--------------------------------------------------------------------
				!foundglab = false
				!bestglabdist = -1
				--------------------------------------------------------------------
				-- root cause, found live 2026-09-01: !gisexisting (a few lines up) --
				-- already worked out which existing glab is this label's own prior --
				-- self -- DDNA match, or its own 1mm along-position fallback -- and --
				-- claimed it (!claimedglabs.append near the seed/step code above)   --
				-- for placement purposes. that claim and this search used to be two --
				-- entirely separate opinions: this loop (and its own 5mm fallback   --
				-- below) re-asks the same question with different criteria, and     --
				-- when it lands on the SAME object !gisexisting already put in      --
				-- !claimedglabs, it reads that as "someone else has it" and gives   --
				-- up -- creating a brand new GLAB right on top of the one           --
				-- !gisexisting was seeded from, which then sits there               --
				-- stillcurrent=TRUE (genuinely claimed, so cleanup leaves it) but    --
				-- never reused, showing its old content forever. (confirmed live:   --
				-- 660005/right's own glab kept resolving to a TEE it once shared a  --
				-- 4mm cluster with -- after a box resize moved the seed match but   --
				-- not this one, the TEE sat orphaned-but-claimed next to a fresh    --
				-- duplicate every run since, and deleting it without a rebuild      --
				-- first proved nothing was recreating it from scratch each time)    --
				--                                                                    --
				-- so before asking anything else, this simply agrees with           --
				-- !gisexisting instead of re-deciding: whatever it already claimed  --
				-- as this label's own object IS this label's own object            --
				--------------------------------------------------------------------
				if (!gisexisting) then
					$!gexistingref
					!gefpos = 'ERR'
					var !gefpos position
					handle any
						!gefpos = 'ERR'
					endhandle
					if (!gefpos.neq('ERR')) then
						!foundglab = true
						!foundglabref = !gexistingref
						!foundglabpos = object position(!gefpos)
						!bestglabdist = !foundglabpos.distance(!gposobj)
					endif
				endif
				do !eg values !existingglabs
					$!eg
					handle any
					elsehandle none
						var !egddna ddna of ce
						if (not(!egddna.unset()) and !egddna.eq(!gelem)) then
							var !egpos position
							!egposobj = object position(!egpos)
							!egdist = !egposobj.distance(!gposobj)
							if (not(!foundglab) or !egdist.lt(!bestglabdist)) then
								!foundglab = true
								!foundglabref = ce
								!bestglabdist = !egdist
								!foundglabpos = !egposobj
							endif
						endif
					endhandle
				enddo
				--------------------------------------------------------------------
				-- fallback: nothing shares this label's own ddna. the same MTBE/  --
				-- crossing-point resolution instability documented above for the  --
				-- DPOI match (and for !gisexisting's own seed search further up)  --
				-- applies here too -- E3D can hand back a differently-worded      --
				-- reference for the exact same member between two runs, so a     --
				-- strict ddna-only search never recognises its own earlier GLAB   --
				-- and piles a second one on top of it, orphaning the first        --
				-- (confirmed live 2026-09-01: right i=3's rebuild-created glab    --
				-- carried ddna==67160954/4663793, this run's own !gelem read back --
				-- as the named path instead, so the loop above never matched it   --
				-- -- NEW GLAB fired and the orphan, unclaimed, sat underneath the --
				-- fresh one showing 0010CB04_SLH1_0700_H_660005 twice). so a      --
				-- second pass drops the ddna requirement and matches on position  --
				-- alone, same 5mm the reuse check below already treats as "the    --
				-- same point", same nearest-wins rule, and still refusing         --
				-- anything !claimedglabs already has                              --
				--------------------------------------------------------------------
				!gelemdbg = !dir.eq('right')
				if (!dbgln and !gelemdbg) then
					!dbgf.writerecord('GLABFALLBACKSTART ' & !dir & ' gelem=' & !gelem & ' foundglab(strict)=' & !foundglab.string() & ' gposobj=' & !gposobj.string())
				endif
				if (not(!foundglab)) then
					!bestglabdist = -1
					do !eg values !existingglabs
						$!eg
						handle any
							if (!dbgln and !gelemdbg) then
								!dbgf.writerecord('GLABFALLBACKCAND ' & !dir & ' gelem=' & !gelem & ' $!eg navigation failed')
							endif
						elsehandle none
							!egref = ce
							!egclaimed = false
							do !cg values !claimedglabs
								if (!egref.eq(!cg)) then
									!egclaimed = true
									break
								endif
							enddo
							!egddnadbg = 'ERR'
							var !egddnadbg ddna
							handle any
								!egddnadbg = 'ERR'
							endhandle
							--------------------------------------------------------------
							-- spy 2026-09-01: unconditional, not gated by !gelemdbg --
							-- watches specifically for the one ddna the 660005/right   --
							-- duplicate keeps tracing back to, so whichever OTHER      --
							-- candidate's fallback claims it first shows up here even  --
							-- though that candidate's own !gelem has nothing to do     --
							-- with 660005 -- fallback matches on position alone, not   --
							-- ddna or pipe, so a nearer unrelated candidate can win it  --
							--------------------------------------------------------------
							if (!dbgln and !egddnadbg.eq('=67160954/4663793')) then
								!dbgf.writerecord('GLABFALLBACKSPY ' & !dir & ' this-candidate-gelem=' & !gelem & ' claimed-already=' & !egclaimed.string())
							endif
							if (not(!egclaimed)) then
								!egposerr = false
								var !egpos position
								handle any
									!egposerr = true
								endhandle
								if (!egposerr) then
									if (!dbgln and !gelemdbg) then
										!dbgf.writerecord('GLABFALLBACKCAND ' & !dir & ' gelem=' & !gelem & ' cand ddna=' & !egddnadbg & ' POSITION READ FAILED')
									endif
								else
									!egposobj = object position(!egpos)
									!egdist = !egposobj.distance(!gposobj)
									if (!dbgln and !gelemdbg) then
										!dbgf.writerecord('GLABFALLBACKCAND ' & !dir & ' gelem=' & !gelem & ' cand ddna=' & !egddnadbg & ' dist=' & !egdist.string() & ' claimed=' & !egclaimed.string())
									endif
									if (!egdist.lt(5) and (not(!foundglab) or !egdist.lt(!bestglabdist))) then
										!foundglab = true
										!foundglabref = ce
										!bestglabdist = !egdist
										!foundglabpos = !egposobj
									endif
								endif
							else
								if (!dbgln and !gelemdbg) then
									!dbgf.writerecord('GLABFALLBACKCAND ' & !dir & ' gelem=' & !gelem & ' cand ddna=' & !egddnadbg & ' SKIPPED already claimed')
								endif
							endif
						endhandle
					enddo
				endif
				if (!dbgln and !gelemdbg) then
					!dbgf.writerecord('GLABFALLBACKEND ' & !dir & ' gelem=' & !gelem & ' foundglab=' & !foundglab.string())
				endif
				if (!foundglab) then
					$!foundglabref
					!claimedglabs.append(!foundglabref)
					----------------------------------------------------------------
					-- same rule as the DPOI side, same day: found means frozen,   --
					-- always -- no <5mm carve-out any more. this label's own      --
					-- POSITION never moves once it exists and a REVI is on the    --
					-- drawing, no matter how far this run's fresh target sits     --
					-- from it                                                     --
					----------------------------------------------------------------
					!gposobj = !foundglabpos
				else
					NEW GLAB
				endif
				--------------------------------------------------------------------
				-- collected either way -- see the comment on the two globals up   --
				-- top: a reused glab needs the post-recentre nudge exactly like a --
				-- new one does                                                    --
				--------------------------------------------------------------------
				!!DrawingPlan1RunGlabRefs.append(ce)
				!!DrawingPlan1RunGlabDirs.append(!dir)
				DDNA $!gelem
				BTEXT |$!gtext|
				CHEI $!gchei
				Justification $!gjust
				Alignment Base
				ADEG $!gadeg
				ABSO
				AT $!gat
				POSITION $!gposobj
				handle any
				endhandle
				-------------------------------------------------------------
				-- OSET says how XYPO is read: TRUE means it is an offset    --
				-- from the label's own position, FALSE means it is an       --
				-- absolute page position. AVEVA's abaarrange.pmlfnc uses    --
				-- both in one breath and says so: 'put each label at zero   --
				-- offset from ddnm & get page position' around OSET TRUE /  --
				-- XYPO 0 0 / OSET FALSE                                     --
				--                                                           --
				-- ABSO alone does not set it. without this line every label --
				-- read its XYPO as a page position and they all landed on   --
				-- the same few spots, one per step of the fan, in a heap in --
				-- the middle of the view (2026-08-21, reported live)        --
				-------------------------------------------------------------
				OSET TRUE
				handle any
				endhandle
				XYPO $!gxypo
				-------------------------------------------------------------
				-- the leader runs the whole length of the text, from the   --
				-- dimension line to the far end of the wording, the way    --
				-- the user marked it in red (2026-08-21). that is the      --
				-- connection point: the text's own far end, in the text's  --
				-- frame, so the leader is drawn along the baseline         --
				--                                                          --
				-- Y stays 0. the baseline sits on the projection line      --
				-- (XYPO only offsets ALONG the line), so a zero Y is what  --
				-- keeps the leader straight and in line with it -- the     --
				-- Cpoftx X 2mm Y -1mm copied off the hand built label was  --
				-- what made every leader lean                              --
				--                                                          --
				-- EXBTEXT is the wording with the macros already resolved. --
				-- the width estimate is the one the NOZZ and REDU labels   --
				-- in DrawingPlan1.pmlfrm use, factor and all               --
				-------------------------------------------------------------
				!gexb = ''
				var !gexb exbtext
				handle any
					!gexb = ''
				endhandle
				if (!dbgln) then
					!gfinalsh = 'ERR'
					var !gfinalsh shpos of ce
					handle any
						!gfinalsh = 'ERR'
					endhandle
					!dbgf.writerecord('GLABTEXT ' & !dir & ' i=' & !i.string() & ' xypo=' & !gxypo & ' exbtext=' & !gexb & ' elem=' & !gelem & ' finalsh=' & !gfinalsh)
				endif
				-------------------------------------------------------------
				-- how wide the wording really is, added up a character at   --
				-- a time. '1' is a narrow one, so is a space and a dash,    --
				-- and a single average over the lot is what left the        --
				-- leaders ending at different distances past their text     --
				-------------------------------------------------------------
				!gsum = 0
				!gchn = !gexb.length()
				do !k from 1 to !gchn
					!gc = !gexb.substring(!k, 1)
					!gcw = !glabwchr
					if (!gc.eq('1')) then
						!gcw = !glabwnar
					elseif (!gc.eq(' ') or !gc.eq('-')) then
						!gcw = !glabwthin
					elseif (!gc.eq('.') or !gc.eq(',') or !gc.eq(':')) then
						!gcw = !glabwdot
					endif
					!gsum = !gsum + !gcw
				enddo
				!gwide = !gsum * !gchei.real()
				-------------------------------------------------------------
				-- the text has been nudged !glabtxtgap across its own      --
				-- leader, so the connection point takes the same amount    --
				-- out again and the leader is left where it was: straight, --
				-- and in line with the projection line                     --
				--                                                          --
				-- Y here is across the text's own direction. the nudge is  --
				-- always towards the letters, ie the +Y side of the        --
				-- baseline, so taking it out is always -Y, whatever ADEG   --
				-- has turned that into on the sheet                        --
				--                                                          --
				-- 2026-09-03: plus !gleadstep, for the same reason BPOF's  --
				-- gb2 carries it. this Y is measured from AT, not from the --
				-- text -- so on a drifted label, where the frozen text sits --
				-- !gleadstep away from AT along the dimension, a bare      --
				-- -!glabtxtgap left this end behind at AT's own level while --
				-- the bend climbed to the text: the run between them fell  --
				-- away and the leader came out as a tent (red/blue          --
				-- reference picture, TEST-0000010001). rising with it keeps --
				-- the run level and the 1mm text gap intact                --
				--                                                          --
				-- an undrifted label has !gleadstep 0 and so still gets     --
				-- exactly -!glabtxtgap, unchanged -- setting this end to a  --
				-- flat 0 instead, tried earlier the same day, moved EVERY   --
				-- label's connection point and was reported live as the     --
				-- whole LDIM row shifting                                   --
				-------------------------------------------------------------
				!gcpofy = !gleadstep - !glabtxtgap
				!greach = !gwide + !glabover
				-- how far this one reaches, measured from the border of the view --
				!gtot = !gdimdist + !gclr + !greach
				if (!gtot.gt(!gbandmax)) then
					!gbandmax = !gtot
				endif
				if (!gjust.eq('Right')) then
					!gcpof = 'X -' & !greach.string('D2') & 'mm Y ' & !gcpofy.string('D2') & 'mm'
				else
					!gcpof = 'X ' & !greach.string('D2') & 'mm Y ' & !gcpofy.string('D2') & 'mm'
				endif
				CPOFTX '$!gcpof'
				handle any
				endhandle
				-------------------------------------------------------------
				-- the layer is Lframe true, so without a no-frame style     --
				-- every label comes out in a box. the hand built one uses   --
				-- /PW-LEAD_NOFRAME. a project without that style keeps its  --
				-- frames rather than the whole run failing                  --
				-------------------------------------------------------------
				LBSTRF $!glabstyle
				handle any
				endhandle
				-------------------------------------------------------------
				-- and belt and braces on the frame: the style above is a    --
				-- project one and may not be there, while the layer's       --
				-- Lframe true is inherited by every label and boxed them    --
				-- all (2026-08-21, reported live). switching it off on the  --
				-- label itself depends on no style at all                   --
				-------------------------------------------------------------
				Lframe false
				handle any
				endhandle
				if (!gleadstepabs.gt(0.01)) then
					----------------------------------------------------------
					-- a bent leader: a short run out from the dimension     --
					-- line along the point's own line, then a diagonal      --
					-- across to the line the text has been stepped onto,    --
					-- and the rest of the way in to the text                --
					--                                                       --
					-- both bend points are measured from the same place AT  --
					-- is, confirmed 2026-08-21 from the label the user made --
					-- by hand: Bpoftx X -5mm Y 0mm X -8mm Y -5mm on a label --
					-- whose text sat at Xyposition -87mm -4mm, ie the bends --
					-- are next to the dimension line, not next to the text  --
					--                                                       --
					-- gb2's along component is !gstep, the same bare packing --
					-- push XYPO above uses -- reverted 2026-09-02, same day --
					-- as it was changed to !gleadstep: user rule confirmed  --
					-- live -- the bend itself must stay a small, fixed,    --
					-- "normal" kink next to the dimension line NO MATTER   --
					-- how far AT has drifted from the frozen text; only    --
					-- the leader's own auto-closing run into the text may  --
					-- grow long, never the bend. using !gleadstep here     --
					-- made the bend itself balloon to the full drift       --
					-- distance, which looks fine for a small drift but     --
					-- exaggerated/ugly for a large one (reported live,     --
					-- TEST-0000010001, a 2.3m box resize). gb2's own       --
					-- perpendicular reach (!grun+!glabdiag) already        --
					-- equals GTXX's (!gclr, same formula above), so gb2    --
					-- and the text sit on the exact same offset line from  --
					-- the dimension line regardless of !gstep -- only the  --
					-- along axis can differ, so whatever E3D draws from    --
					-- gb2 into the text closes that gap on a single flat   --
					-- run, never a second diagonal                        --
					--                                                       --
					-- settled 2026-09-03, after three wrong turns (bare      --
					-- !gstep = no kink at all; a flat !glabdiag = too big    --
					-- for a small drift; proportional-with-a-cap = the cap   --
					-- itself reintroduced the lean). the red/blue reference  --
					-- picture finally showed what "exaggerated" really meant: --
					-- never the RISE, always the TENT -- the bend climbed to  --
					-- the text's own along level and then the run back down   --
					-- to CPOFTX's fixed Y -1 fell away from it again, so the  --
					-- leader peaked in the middle. the rise itself is right   --
					-- and belongs uncapped: !gleadstep puts gb2 at exactly    --
					-- the frozen text's along (AT + gleadstep = POSITION's    --
					-- along, algebraically, whatever the drift), which is     --
					-- 1mm under the text baseline -- the same gap an          --
					-- undrifted label has always had. CPOFTX below now rises  --
					-- with it so the run stays level instead of drooping      --
					----------------------------------------------------------
					!gb2along = !gleadstep
					!gb1x = !goutx * !grun
					!gb1y = !gouty * !grun
					!gb2x = !goutx * (!grun + !glabdiag) + !gstepx * !gb2along
					!gb2y = !gouty * (!grun + !glabdiag) + !gstepy * !gb2along
					-- the bend points are offsets like XYPO, so they turn too --
					if (!!DrawingPlan1.rcode.eqnocase('left')) then
						!gtmp = !gb1x
						!gb1x = !gb1y
						!gb1y = !gtmp * -1
						!gtmp = !gb2x
						!gb2x = !gb2y
						!gb2y = !gtmp * -1
					endif
					----------------------------------------------------------
					-- bare numbers, four of them, which is how AVEVA's own   --
					-- aba/Tasks/abaarrange.pmlfrm writes it: BPOF -17 29.99  --
					-- (two numbers there, one bend point). the 'X -5mm Y 0mm --
					-- X -8mm Y -5mm' string form, copied off Q ATT, was not  --
					-- accepted -- the leader stayed straight and ran from    --
					-- the dimension line to the far end of the text in one   --
					-- long diagonal (2026-08-21, reported live)              --
					----------------------------------------------------------
					-- D3, not D2: the bend has to sit on the same 0.001mm grid as   --
					-- POSITION and XYPO or the three do not add up (see the note    --
					-- on !galong above)                                             --
					!gbpof = !gb1x.string('D3') & ' ' & !gb1y.string('D3') & ' ' & !gb2x.string('D3') & ' ' & !gb2y.string('D3')
					BPOF $!gbpof
					handle any
					endhandle
					LSHAPE Bent
					handle any
					endhandle
				else
					----------------------------------------------------------
					-- and straight when it is not stepped. this has to be    --
					-- written, not just left alone: a reused label carries   --
					-- whatever leader the run that made it gave it, and a    --
					-- label whose step has dropped back to zero would keep   --
					-- the old bend while its text moves to the unstepped     --
					-- place, leaving the leader pointing somewhere the text  --
					-- no longer is (reported live 2026-08-30: 100-A-15 on    --
					-- both the up and down rows, step 1.947 and 2.094 before --
					-- the pipe moved, 0.000 after, BPOF still X 0 Y -2 X 2   --
					-- Y -6 from the earlier run)                             --
					--                                                        --
					-- X 0mm Y 0mm is what an unstepped label reads back as   --
					----------------------------------------------------------
					BPOF 0 0
					handle any
					endhandle
					LSHAPE Straight
					handle any
					endhandle
				endif
				----------------------------------------------------------------
				-- every label's finished geometry, for comparing a rebuild    --
				-- against the update straight after it. the dump below only   --
				-- covers the first four a side, and the labels reported as    --
				-- 0.01mm out were not among them (2026-08-28). POSITION is    --
				-- the reused one when an existing GLAB was close enough to    --
				-- keep, so this is the only place the reuse override shows    --
				----------------------------------------------------------------
				if (!dbgln) then
					!gfpos = 'ERR'
					var !gfpos position
					handle any
						!gfpos = 'ERR'
					endhandle
					!gfbpof = 'ERR'
					var !gfbpof bpoftx
					handle any
						!gfbpof = 'ERR'
					endhandle
					!gfcpof = 'ERR'
					var !gfcpof cpoftx
					handle any
						!gfcpof = 'ERR'
					endhandle
					!dbgf.writerecord('GLABFINAL ' & !dir & ' i=' & !i.string() & ' elem=' & !gelem & ' pos=' & !gfpos & ' bpof=' & !gfbpof & ' cpof=' & !gfcpof)
				endif
				-------------------------------------------------------------
				-- the first label of each side, as it actually came out,   --
				-- next to what it was asked for. this is what settles      --
				-- which of POSITION / AT / XYPO the label really listens   --
				-- to. take it out once the placement is right              --
				-------------------------------------------------------------
				if (!dbgln and !i.leq(4)) then
					!dbgf.writerecord('GLAB ' & !dir & ' asked pos=' & !gpos & ' at=' & !gat & ' xypo=' & !gxypo & ' step=' & !gstep.string('D3') & ' dimline=' & !dimline.string())
					!gatts = object array()
					!gatts[1] = 'position'
					!gatts[2] = 'xypo'
					!gatts[3] = 'oset'
					!gatts[4] = 'apoftx'
					!gatts[5] = 'bpoftx'
					!gatts[6] = 'lshape'
					!gatts[7] = 'lbstrf'
					!gatts[8] = 'lframe'
					!gatts[9] = 'ddname'
					!gatts[10] = 'justification'
					!gatts[11] = 'adegrees'
					!gatts[12] = 'cpoftx'
					----------------------------------------------------------
					-- the user's point: a frame with a zero box gap sits     --
					-- tight around the text, so E3D knows what the text      --
					-- really measures and the width may not have to be       --
					-- estimated from the character count at all. Q ATT only  --
					-- lists stored attributes -- EXBTEXT is not on it either --
					-- and still answers -- so these are worth asking for.    --
					-- XYSC is the promising one, AVEVA's attribute table     --
					-- calls it 'Label XY size'                               --
					----------------------------------------------------------
					!gatts[13] = 'xysc'
					!gatts[14] = 'xysize'
					!gatts[15] = 'gbox'
					!gatts[16] = 'bmargin'
					!gatts[17] = 'exbtext'
					!gatts[18] = 'gaps'
					!gatts[19] = 'tsiztx'
					!gatts[20] = 'cspatx'
					do !ga values !gatts
						!gq = 'ERR'
						var !gq $!ga
						handle any
							!gq = 'ERR'
						endhandle
						!dbgf.writerecord('GLAB ' & !dir & ' got ' & !ga & ' = ' & !gq)
					enddo
				endif
				!gprev = !galong
				!gfirstlab = false
			enddo
		endif
		------------------------------------------------------------------
		-- what this side reaches, for .Apply() to shift the view by      --
		------------------------------------------------------------------
		if (!dir.eq('right')) then
			!!DrawingPlan1.labbandright = !gbandmax
		elseif (!dir.eq('left')) then
			!!DrawingPlan1.labbandleft = !gbandmax
		elseif (!dir.eq('up')) then
			!!DrawingPlan1.labbandup = !gbandmax
		else
			!!DrawingPlan1.labbanddown = !gbandmax
		endif
	enddo

	--------------------------------------------------------------------
	-- update path cleanup: a GLAB from a previous run not claimed by   --
	-- !claimedglabs (the actual objects reused/kept, above) this run   --
	-- is removed                                                       --
	--                                                                   --
	-- checking by ddna-in-currentgelems instead of by object used to   --
	-- let a stale duplicate survive: two different GLAB objects can    --
	-- legitimately share one ddna (different sides, or the same side   --
	-- twice), so a leftover on a side nothing draws any more still     --
	-- read "stillcurrent" whenever that same ddna happened to be used  --
	-- by an unrelated label on another side this run -- both came back --
	-- stillcurrent=TRUE in check.txt while sitting on top of each      --
	-- other on the sheet (2026-08-27, reported live)                   --
	--------------------------------------------------------------------
	do !eg values !existingglabs
		$!eg
		handle any
		elsehandle none
			var !egddna ddna of ce
			if (not(!egddna.unset()) and not(!egddna.eq('=0/0'))) then
				!egref = ce
				!stillcurrentg = false
				do !cg values !claimedglabs
					if (!egref.eq(!cg)) then
						!stillcurrentg = true
						break
					endif
				enddo
				if (!dbgln) then
					var !egxypo xypo
					handle any
						!egxypo = 'ERR'
					endhandle
					!dbgf.writerecord('CLEANUPGLAB eddna=' & !egddna & ' xypo=' & !egxypo & ' stillcurrent=' & !stillcurrentg)
				endif
				if (not(!stillcurrentg)) then
					delete glab
				endif
			endif
		endhandle
	enddo

	if (!dbgln) then
		!dbgf.close()
	endif
endfunction






$(  


	NEW DPPT ON $!mem Pltxt '#PIPE(c2:)'




  var !mems coll all bran members within $!vlfm to $!vlto
  do !i from 1 to !mems.size()
    !mem = !mems[$!i]
    -----------------------
    -- refer to rcollect --
    -----------------------
    $* filter collection for those items that are in drawlist for view
    if (!mem.matchwild('*ileave tube*')) then
      $* check that IL TUB element exists
      var !existcheck ref of $!mem
      handle any $* IL TUB <1mm or does not exist
        !component = !mem.after('of ')
        var !nexttype type of next of $!component
        handle any
          skip
        endhandle
        if (nexttype.eqnocase('ATTA') then
          var !atta ref of next $!component
          var !mem 'ileave tube of ' & $!atta
        endif
      endhandle
    endif
    var !check IDLN for $!mem
    handle any
      skip
    elsehandle none
      if (!check.eqnocase('INCLUDED')) then
        if (match(|$!ELEM|,|IL TUB|) neq 0) then
          $* check if IL TUB crosses or is contained within 3d volume
          CALLIBM UBOXCHECK $<$!ELEM$> $<$!LIMITS$>
          if ($!!CDRTNSTATUS eq 1) then
            $* assume it does not cross... do not append to array
          else
            if ($!!CDLNRTN) then
              var !!CDCARTN append |$!ELEM|
            else
              $* $!ELEM does not pass through side/box volume
            endif
          endif
        else
          var !!CDCARTN append |$!ELEM|
        endif
      endif
    endhandle
  enddo






  var !brans vscan for all bran
  !pipes = object array()
  do !bran values !brans
    var !isnamed isname of owner of $!bran
    if (!isnamed.boolean()) then
      var !pipe name of pipe of $!bran
      !pipes.append(!pipe)
    endif
  enddo
  !pipes.unique().sort()
--  q var !pipes.size()
  do !pipe values !pipes
    var !mems coll all bran members for $!pipe
    do !i from 1 to !mems.size()
      var !ref ref of $!mems[$!i]
      var !found find $!ref
      if (!found.eqnocase('found')) then
        var !type type of $!ref
--        $p $!type
        var !pos worpos of $!ref
        handle any
--          $p $!pipe
        elsehandle none
          NEW LDIM
  --        DPOS $!pos
          DIR N
          NEW DPOI POS $!pos DDNA $!ref Pltxt '#PIPE'
          break
        endhandle
      endif
    enddo    
  enddo
  
	$p -----------
  do !pipe values !pipes
    $p $!pipe
  enddo
$)  

-------------------------------------
-- Function : Equipment Annotation --
-- Auther   : tw tseng             --
-- Date     : 2025/08/05           --
-------------------------------------

$(
import 'AteSortLineNo'
handle any
endhandle
$)

define function !!DrawingPlan1EquiAnnotation(!name is string, !minE is string, !minN is string, !minU is string, !maxE is string, !maxN is string, !maxU is string)
	NEW LAYE $!name/SS/S1/V1/ateEQUI
	Purpose EQUI
	Lvisibility true
	Ucode mm  Distance  mm  Bore Nominal 
	Font 1
	Lterminator Off
	Justification Left
	Alignment Base
	Dterminator Arrows
	Tsize 2mm
	Chosht 6mm
	Asubtended 0
	Pjustification Towards 
	Overshoot 2mm
	Plclearance 0mm
	Doffset 25mm
	Dmspacing 0mm
	Cheight 4mm
	Lleader false
	Lframe false
	Lshape Straight
	Gbox 0mm
	Cspacing 0
	Lspacing 0
	Llclearance 0mm
	Xyscale 1 1
	Xyposition 10mm 10mm 
	Bpoffset 0mm 0mm
	Blnk true
	Bmargin 0mm
	Trsf unset
	Fterminator Default
	Pcode mms to 0 dpls  Inches to 1 dpls  Fractions to 32 ths  Angles to 1 dpls 
	NLStyle Solid 
	NLColour Cyan 
	FStyle SolidFilled 
	FColour Cyan 
	Txcolour yellow 
	LLStyle Solid 
	LLColour Cyan 
	LFStyle Solid 
	LFColour Cyan 
	DLStyle Solid 
	DLColour Grey 
	PLStyle Solid 
	PLColour Grey 
	MStyle Off 
	MColour Cyan 
	CHStyle Off 
	CHColour Grey 
	ACDSTY unset
	Posformat ENU
	Grsystem Nulref
	SpPurpose unset
	Function unset
	
	var !VIEW (NAME of VIEW )
	var !DIR1  (DIR of VIEW )
	var !equis coll all equi with (not(matchwild(name, |*_DrawingPlan|))) within E $!minE N $!minN U $!minU TO E $!maxE N $!maxN U $!maxU
	do !equi values !equis
		--------------------------------------------------------------
		-- only named equipment is labelled. this function labels    --
		-- exactly the equipment LineNoAnnotation did NOT dimension  --
		-- (the equiparray test below), and LineNoAnnotation now     --
		-- leaves the unnamed ones out -- so without this test they  --
		-- would land here and pick up a GLAB instead, which is the  --
		-- opposite of what was asked (user rule, 2026-08-28)        --
		--------------------------------------------------------------
		!equinamed = 'FALSE'
		var !equinamed isnamed of $!equi
		handle any
			!equinamed = 'FALSE'
		endhandle
	  var !namn namn of $!equi
		!tmpdirarray = !Dir1.Split(' ')
		!DIR = !tmpdirarray[1]

		$* Get limits of EQUI element
		var !ORIGIN array(POS of $!EQUI wrt /* )
		var !CPOS split |$!ORIGIN|
		var !WVOL WVOL of $!EQUI
		var !WLIM split |$!WVOL|
		$* Get VIEW information
		var !VSCA (VSCA of $!VIEW )
		var !OFFSET (2 / $!VSCA)
		var !VIEWDIRU1 VIEWDIR U
		var !VIEWDIRD1 VIEWDIR D
		var !VIEWDIRL1 VIEWDIR L
		var !VIEWDIRR1 VIEWDIR R
		!viewdiruarray = !VIEWDIRU1.Split(' ')
		!viewdirdarray = !VIEWDIRD1.Split(' ')
		!viewdirlarray = !VIEWDIRL1.Split(' ')
		!viewdirrarray = !VIEWDIRR1.Split(' ')
		!VIEWDIRU = !viewdiruarray[1]
		!VIEWDIRD = !viewdirdarray[1]
		!VIEWDIRL = !viewdirlarray[1]
		!VIEWDIRR = !viewdirrarray[1]
			
		$!name/SS/S1/V1/ateEQUI
			
		$(

		var !EXTENT EXTENT BTEX
		var !EX split |$!EXTENT|
		var !TLENR cons dist X $!EX[2] Y $!EX[4] to X $!EX[6] Y $!EX[8]
		var !TLENR ($!TLENR / $!VSCA)
		
		
		if (!WLIMR.real() le 3) then
			var !WLIML !WLIMR + 3
		else
			var !WLIML !WLIMR - 3
		endif
		if (!WLIMU.real() le 3) then
			var !WLIMD !WLIMU + 3
		else
			var !WLIMD !WLIMU - 3
		endif
		
		var !TLENU cons dist X $!EX[2] Y $!EX[4] to X $!EX[6] Y $!EX[8]
		var !TLENU ($!TLENU / $!VSCA)
		
		$)
				
		$* Calculate positions for stra's and texp's
		var !WLIM[1] ($!WLIM[1] - $!OFFSET mm )
		var !WLIM[2] ($!WLIM[2] - $!OFFSET mm )
		var !WLIM[3] ($!WLIM[3] - $!OFFSET mm )
		var !WLIM[4] ($!WLIM[4] + $!OFFSET mm )
		var !WLIM[5] ($!WLIM[5] + $!OFFSET mm )
		var !WLIM[6] ($!WLIM[6] + $!OFFSET mm )

			
		var !EPOS |E $!WLIM[4] N $!CPOS[2] U $!CPOS[3]|
		var !WPOS |E $!WLIM[1] N $!CPOS[2] U $!CPOS[3]|
		var !NPOS |E $!CPOS[1] N $!WLIM[5] U $!CPOS[3]|
		var !SPOS |E $!CPOS[1] N $!WLIM[2] U $!CPOS[3]|
		var !UPOS |E $!CPOS[1] N $!CPOS[2] U $!WLIM[6]|
		var !DPOS |E $!CPOS[1] N $!CPOS[2] U $!WLIM[3]|
		
		$(
				
		if (!namedir EQ 'up') then
			if ($!WLIMU le 3) then
				var !WLIM[$!WLIMU] ($!WLIM[$!WLIMU] - $!TLENU)
			else
				var !WLIM[$!WLIMU] ($!WLIM[$!WLIMU] + $!TLENU)
			endif
		elseif (!namedir EQ 'down') then
			if ($!WLIMD le 3) then
				var !WLIM[$!WLIMD] ($!WLIM[$!WLIMD] - $!TLENU)
			else
				var !WLIM[$!WLIMD] ($!WLIM[$!WLIMD] + $!TLENU)
			endif
		elseif (!namedir EQ 'left') then
			if ($!WLIML le 3) then
				var !WLIM[$!WLIML] ($!WLIM[$!WLIML] - $!TLENR)
			else
				var !WLIM[$!WLIML] ($!WLIM[$!WLIML] + $!TLENR)
			endif
		elseif (!namedir EQ 'right') then
			if ($!WLIMR le 3) then
				var !WLIM[$!WLIMR] ($!WLIM[$!WLIMR] - $!TLENR)
			else
				var !WLIM[$!WLIMR] ($!WLIM[$!WLIMR] + $!TLENR)
			endif
		endif
		
		$)

		var !EPOS1 |E $!WLIM[4] N $!CPOS[2] U $!CPOS[3]|
		var !WPOS1 |E $!WLIM[1] N $!CPOS[2] U $!CPOS[3]|
		var !NPOS1 |E $!CPOS[1] N $!WLIM[5] U $!CPOS[3]|
		var !SPOS1 |E $!CPOS[1] N $!WLIM[2] U $!CPOS[3]|
		var !UPOS1 |E $!CPOS[1] N $!CPOS[2] U $!WLIM[6]|
		var !DPOS1 |E $!CPOS[1] N $!CPOS[2] U $!WLIM[3]|

		$* Create stra's
		$!name/SS/S1/V1/ateEQUI/VNOT
		handle ANY
			NEW VNOT $!name/SS/S1/V1/ateEQUI/VNOT
			Pkdistance 0.5
			Adegrees 0
			Ppdirection -1
			Lvisibility true
			Justification Left
			Alignment Hbody
			Font 24
			Blnk true
			Bmargin 0mm
			Cheight 5mm
			Cspacing 0
			Lspacing 0
			Txcolour 67
			NLStyle Chained 
			NLColour 20
			FStyle Off 
			FColour Cyan 
			MStyle Off 
			MColour Cyan 
			ACDSTY unset
		endhandle
		
		var !origin1 (pos of $!equi wrt worl)
		!enupos = object position(!origin1)
		
		if( !DIR.eq(|W|) or !DIR.eq(|E|) or !DIR.eq(|-X|) or !DIR.eq(|X|) ) then
			NEW STRA $!EQUI$!VIEW/CenL3 FPT $!SPOS TPT $!NPOS
			Tcode Endpoint
			NEW STRA $!EQUI$!VIEW/CenL4 FPT $!DPOS TPT $!UPOS
			Tcode Endpoint
			!This.Reposition(!EQUI, !VIEW, !namedir, !VSCA, !DPOS, !UPOS, !SPOS, !NPOS, !DPOS1, !UPOS1, !SPOS1, !NPOS1, !DIR1)
		elseif( !DIR.eq(|N|) or !DIR.eq(|S|) or !DIR.eq(|-Y|) or !DIR.eq(|Y|) ) then
			NEW STRA $!EQUI$!VIEW/CenL3 FPT $!WPOS TPT $!EPOS
			Tcode Endpoint
			NEW STRA $!EQUI$!VIEW/CenL4 FPT $!DPOS TPT $!UPOS
			Tcode Endpoint
			!This.Reposition(!EQUI, !VIEW, !namedir, !VSCA, !WPOS, !EPOS, !DPOS, !UPOS, !WPOS1, !EPOS1, !DPOS1, !UPOS1, !DIR1)
		elseif (!DIR.eq(|U|) or !DIR.eq(|D|) or !DIR.eq(|-Z|) or !DIR.eq(|Z|) ) then
			------------------------------------------------------------
			-- check if position of equipment is within view boundary --
			------------------------------------------------------------
			!strahori = false
			if (!EPOS.part(4).real().leq(!maxN.real()) and !EPOS.part(4).real().geq(!minN.real())) then
				if (!EPOS.part(2).real().leq(!maxE.real()) and !WPOS.part(2).real().geq(!minE.real())) then
					!strahori = true
				elseif (!EPOS.part(2).real().leq(!maxE.real()) and not(!WPOS.part(2).real().geq(!minE.real()))) then
					!strahori = true
					!WPOS = !WPOS.part(1) & ' ' & !minE & ' ' & !WPOS.part(3) & ' ' & !WPOS.part(4) & ' ' & !WPOS.part(5) & ' ' & !WPOS.part(6)
				elseif (not(!EPOS.part(2).real().leq(!maxE.real())) and !WPOS.part(2).real().geq(!minE.real())) then
					!strahori = true
					!EPOS = !EPOS.part(1) & ' ' & !maxE & ' ' & !EPOS.part(3) & ' ' & !EPOS.part(4) & ' ' & !EPOS.part(5) & ' ' & !EPOS.part(6)
				endif
			endif
			if (!strahori) then
				!pos1 = object position(!WPOS)
				!pos2 = object position(!EPOS)
				!dist = !pos1.distance(!pos2) * !VSCA.real()
				if (!dist.leq(20)) then
					!strahori = false
				endif
			endif
			!stravert = false
			if (!NPOS.part(2).real().leq(!maxE.real()) and !NPOS.part(2).real().geq(!minE.real())) then
				if (!NPOS.part(4).real().leq(!maxN.real()) and !SPOS.part(4).real().geq(!minN.real())) then
					!stravert = true
				elseif (!NPOS.part(4).real().leq(!maxN.real()) and not(!SPOS.part(4).real().geq(!minN.real()))) then
					!stravert = true
					!SPOS = !SPOS.part(1) & ' ' & !SPOS.part(2) & ' ' & !SPOS.part(3) & ' ' & !minN & ' ' & !SPOS.part(5) & ' ' & !SPOS.part(6)
				elseif (not(!NPOS.part(4).real().leq(!maxN.real())) and !SPOS.part(4).real().geq(!minN.real())) then
					!stravert = true
					!NPOS = !NPOS.part(1) & ' ' & !NPOS.part(2) & ' ' & !NPOS.part(3) & ' ' & !maxN & ' ' & !NPOS.part(5) & ' ' & !NPOS.part(6)
				endif
			endif
			if (!stravert) then
				!pos1 = object position(!SPOS)
				!pos2 = object position(!NPOS)
				!dist = !pos1.distance(!pos2) * !VSCA.real()
				if (!dist.leq(20)) then
					!stravert = false
				endif
			endif
			if (!equinamed.boolean() and unset(!!DrawingPlan1.equiparray.findfirst(!namn))) then
				------------------------------------
				-- equipments are not dimensioned --
				------------------------------------
				if (abs(!wvol.part(1).real() - !wvol.part(4).real()) gt abs(!wvol.part(2).real() - !wvol.part(5).real())) then
					--------------------
					-- width > length --
					--------------------
					if (abs(!wvol.part(1).real() - !wvol.part(4).real()) / abs(!wvol.part(2).real() - !wvol.part(5).real()) gt 3) then
						-----------------------
						-- width/ length > 3 --
						-----------------------
						if (!strahori) then
							$!name/SS/S1/V1/ateEQUI
							NEW GLAB
							DDNA $!EQUI
							Btext |#EQUI(C2:)|
							ALIGN BBODY
							ABSO
							var !cpos1 shpos OF $!EPOS
							AT $!cpos1
							var !extent extent btext
							!temppos = !EPOS.part(2).real() + (abs(!extent.part(2).real() - !extent.part(6).real()) / !!DrawingPlan1.vsca)
							!EPOS = !EPOS.part(1) & ' ' & !temppos & ' ' & !EPOS.part(3) & ' ' & !EPOS.part(4) & ' ' & !EPOS.part(5) & ' ' & !EPOS.part(6)
							$!name/SS/S1/V1/ateEQUI/VNOT
							NEW STRA FPT $!WPOS TPT $!EPOS
							Tcode Endpoint
						endif
					else
						if (!strahori) then
							$!name/SS/S1/V1/ateEQUI
							NEW GLAB
							DDNA $!EQUI
							Btext |#EQUI(C2:)|
							ALIGN BBODY
							ABSO
							var !cpos1 shpos OF $!EPOS
							AT $!cpos1
							var !extent extent btext
							!temppos = !EPOS.part(2).real() + (abs(!extent.part(2).real() - !extent.part(6).real()) / !!DrawingPlan1.vsca)
							!EPOS = !EPOS.part(1) & ' ' & !temppos & ' ' & !EPOS.part(3) & ' ' & !EPOS.part(4) & ' ' & !EPOS.part(5) & ' ' & !EPOS.part(6)
							$!name/SS/S1/V1/ateEQUI/VNOT
							NEW STRA FPT $!WPOS TPT $!EPOS
							Tcode Endpoint
						endif
						if (!stravert) then
							$!name/SS/S1/V1/ateEQUI/VNOT
							NEW STRA FPT $!SPOS TPT $!NPOS
							Tcode Endpoint
						endif
					endif
				else
					--------------------
					-- width < length --
					--------------------
					if (abs(!wvol.part(2).real() - !wvol.part(5).real()) / abs(!wvol.part(1).real() - !wvol.part(4).real()) gt 3) then
						------------------------
						-- length / width > 3 --
						------------------------
						if (!stravert) then
							$!name/SS/S1/V1/ateEQUI/VNOT
							NEW STRA FPT $!SPOS TPT $!NPOS
							Tcode Endpoint
						endif
					else
						if (!strahori) then
							$!name/SS/S1/V1/ateEQUI/VNOT
							NEW STRA FPT $!WPOS TPT $!EPOS
							Tcode Endpoint
						endif
						if (!stravert) then
							$!name/SS/S1/V1/ateEQUI
							NEW GLAB
							DDNA $!EQUI
							Btext |#EQUI(C2:)|
							ALIGN BBODY
							ABSO
							Adegrees 90
							var !cpos1 shpos OF $!NPOS
							AT $!cpos1
							var !extent extent btext
							!temppos = !NPOS.part(4).real() + (abs(!extent.part(4).real() - !extent.part(8).real()) / !!DrawingPlan1.vsca)
							!NPOS = !NPOS.part(1) & ' ' & !NPOS.part(2) & ' ' & !NPOS.part(3) & ' ' & !temppos & ' ' & !NPOS.part(5) & ' ' & !NPOS.part(6)
							$!name/SS/S1/V1/ateEQUI/VNOT
							NEW STRA FPT $!SPOS TPT $!NPOS
							Tcode Endpoint
						endif
					endif
				endif
			else
				--------------------------------
				-- equipments are dimensioned --
				--------------------------------
				if (abs(!wvol.part(1).real() - !wvol.part(4).real()) gt abs(!wvol.part(2).real() - !wvol.part(5).real())) then
					--------------------
					-- width > length --
					--------------------
					if (abs(!wvol.part(1).real() - !wvol.part(4).real()) / abs(!wvol.part(2).real() - !wvol.part(5).real()) gt 3) then
						-----------------------
						-- width/ length > 3 --
						-----------------------
						if (!strahori) then
							$!name/SS/S1/V1/ateEQUI/VNOT
							NEW STRA FPT $!WPOS TPT $!EPOS
							Tcode Endpoint
						endif
					else
						if (!strahori) then
							$!name/SS/S1/V1/ateEQUI/VNOT
							NEW STRA FPT $!WPOS TPT $!EPOS
							Tcode Endpoint
						endif
						if (!stravert) then
							$!name/SS/S1/V1/ateEQUI/VNOT
							NEW STRA FPT $!SPOS TPT $!NPOS
							Tcode Endpoint
						endif
					endif
				else
					--------------------
					-- width < length --
					--------------------
					if (abs(!wvol.part(2).real() - !wvol.part(5).real()) / abs(!wvol.part(1).real() - !wvol.part(4).real()) gt 3) then
						------------------------
						-- length / width > 3 --
						------------------------
						if (!stravert) then
							$!name/SS/S1/V1/ateEQUI/VNOT
							NEW STRA FPT $!SPOS TPT $!NPOS
							Tcode Endpoint
						endif
					else
						if (!strahori) then
							$!name/SS/S1/V1/ateEQUI/VNOT
							NEW STRA FPT $!WPOS TPT $!EPOS
							Tcode Endpoint
						endif
						if (!stravert) then
							$!name/SS/S1/V1/ateEQUI/VNOT
							NEW STRA FPT $!SPOS TPT $!NPOS
							Tcode Endpoint
						endif
					endif
				endif
			endif
		else
			NEW STRA $!EQUI$!VIEW/CenL3 FPT $!WPOS TPT $!EPOS
			Tcode Endpoint
			NEW STRA $!EQUI$!VIEW/CenL4 FPT $!SPOS TPT $!NPOS
			Tcode Endpoint
			NEW STRA $!EQUI$!VIEW/CenL5 FPT $!DPOS TPT $!UPOS
			Tcode Endpoint
			!This.Reposition(!EQUI, !VIEW, !namedir, !VSCA, !WPOS, !EPOS, !SPOS, !NPOS, !WPOS1, !EPOS1, !SPOS1, !NPOS1, !DIR1)
		endif
	enddo
endfunction
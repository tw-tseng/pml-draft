--------------------------------
-- Function : Draw match line --
-- Auther   : tw tseng        --
-- Date     : 2025/12/28      --
--------------------------------
define function !!DrawingPlan1MatchLine(!name is string, !equistr is string)
	var !projid proj id
	!dirlist = 'right left down up'
	!format = object format()
	!format.dp = 0
	do !jj from 1 to 1
		!dir = !dirlist.part(!jj)
		!nearbybox = false
		$!name/SS/S1/V1_R$!!DrawingPlan1.rev
		var !viewdir viewdir $!dir
		var !rcode rcode
		if (!dir.eq('right')) then
			var !tempp1 enupos of $!!DrawingPlan1.viewURsh
			!tempp2 = object position(!tempp1)
			!tempp2.up = !!DrawingPlan1.minU + 50
			var !tempdirr viewdir right
			var !tempdird viewdir down
			!tempp3 = !tempp2.offset(!tempdirr.direction(), 50).offset(!tempdird.direction(), 50)			
			var !tempp4 enupos of $!!DrawingPlan1.viewLRsh
			!tempp5 = object position(!tempp4)
			var !tempdiru viewdir up
			!tempp6 = !tempp5.offset(!tempdirr.direction(), 50).offset(!tempdiru.direction(), 50)
			!tempp6.up = !!DrawingPlan1.maxU - 50
			var !boxes coll all box within $!tempp3 to $!tempp6 for /$!projid_DrawingPlanBox exclude /$!equistr
			handle any
				---------------------------
				-- for unnamed equipment --
				---------------------------
				var !boxes coll all box within $!tempp3 to $!tempp6 for /$!projid_DrawingPlanBox exclude $!equistr
			endhandle						
q var !boxes.size()
			!chks = object array()
			!ii = 0
			if !boxes.size().gt(0) then
				do !box values !boxes
					-------------------------------------------------------
					-- get ppoints which direction equal viewdir up/down --
					-------------------------------------------------------
					do !j from 1 to 6
						var !boxp$!j (p$!j dir of $!box wrt worl)
						!boxpd$!j = object direction(!boxp$!j)
						if !tempdiru.direction().eq(!boxpd$!j) or !tempdird.direction().eq(!boxpd$!j) then
							var !chk (p$!j pos of $!box wrt worl)
							var !chksh shpos of $!chk
							!chks.append(!chksh.part(4).replace('mm', '').real() + 0.0000000001 * !ii & '~' & !chksh.part(2).replace('mm', '') & '~' & !chksh & '!' & !box & '!' & !j)
							!ii = !ii + 1
						endif
					enddo
				enddo
q var !chks.size()				
				if !chks.size().gt(0) then
					using namespace 'Aveva.Core.Samples'
					!obj = object AteSortLineNo()
					!sortedtypes = !obj.method('y', !chks)
					---------------------------------------------------
					-- remove matchlines that are too close together --
					---------------------------------------------------
					if !sortedtypes.size().gt(1) then
						!delindex = object array()
						do !i from 1 to !sortedtypes.size() - 1
							if abs(!sortedtypes[!i].split('~').getindexed(1).real() - !sortedtypes[!i + 1].split('~').getindexed(1).real()) le 10 then
								!delindex.append(!i)
							endif
						enddo
						if !delindex.size().gt(0) then
							!delindex.invert()
							do !delinde values !delindex
								!sortedtypes.remove(!delinde)
							enddo
						endif
						!sortedtypes.compress()
					endif
					------------------------------------------------------
					-- remove matchlines that are not within view frame --
					------------------------------------------------------
					!delindex = object array()
					do !i from 1 to !sortedtypes.size()
						if !sortedtypes[!i].split('~').getindexed(1).real().geq(!!DrawingPlan1.viewURsh.part(4).real() - 5) or !sortedtypes[!i].split('~').getindexed(1).real().leq(!!DrawingPlan1.viewLRsh.part(4).real() + 5) then
							!delindex.append(!i)
						endif
					enddo
					if !delindex.size().gt(0) then
						!delindex.invert()
						do !delinde values !delindex
							!sortedtypes.remove(!delinde)
						enddo
					endif				
					!sortedtypes.compress()
q var !sortedtypes.size()
					!nearbybox = true
					note 1
					if !sortedtypes.size().eq(0) then
						---------------------
					  -- equals max dist --
						---------------------
						!tempb = !chks[1].split('!').getindexed(2)
						var !isnamed isnamed of equi of $!tempb
						if !isnamed.boolean() then
							var !tempe namn of equi of $!tempb
						endif
						if !rcode.eqnocase('up') then
							if !!DrawingPlan1.minE.gt(0) then
								if !isnamed.boolean() then
									!tempt = 'MATCH LINE E' & !!stringRoundUpValue($!!DrawingPlan1.minE, !format) & ' SEE ' & !tempe
								else
									!tempt = 'MATCH LINE E' & !!stringRoundUpValue($!!DrawingPlan1.minE, !format)
								endif
							else
								if !isnamed.boolean() then
									!tempt = 'MATCH LINE W' & !!stringRoundUpValue($!!DrawingPlan1.minE * -1, !format) & ' SEE ' & !tempe
								else
									!tempt = 'MATCH LINE W' & !!stringRoundUpValue($!!DrawingPlan1.minE * -1, !format)
								endif
							endif
						else
							-------------------
							-- !rcode = left --
							-------------------
							if !!DrawingPlan1.minN.gt(0) then
								if !isnamed.boolean() then
									!tempt = 'MATCH LINE N' & !!stringRoundUpValue($!!DrawingPlan1.minN, !format) & ' SEE ' & !tempe
								else
									!tempt = 'MATCH LINE N' & !!stringRoundUpValue($!!DrawingPlan1.minN, !format)
								endif
							else
								if !isnamed.boolean() then
									!tempt = 'MATCH LINE S' & !!stringRoundUpValue($!!DrawingPlan1.minN * -1, !format) & ' SEE ' & !tempe
								else
									!tempt = 'MATCH LINE S' & !!stringRoundUpValue($!!DrawingPlan1.minN * -1, !format)
								endif
							endif
						endif
						--------------------------------
						-- none orthorgonal direction --
						--------------------------------
						if not(!viewdir.direction().eq(object direction('E')) or !viewdir.direction().eq(object direction('W')) or !viewdir.direction().eq(object direction('N')) or !viewdir.direction().eq(object direction('S'))) then
							!tempt = 'MATCH LINE SEE ' & !tempe
						endif
						!posx = !!DrawingPlan1.viewURsh.part(2).real() + 1
						!posy = (!!DrawingPlan1.viewURsh.part(4).real() - !!DrawingPlan1.viewLRsh.part(4).real()) * 0.5 + !!DrawingPlan1.viewLRsh.part(4).real()
						if !viewdir.direction().eq(object direction('E')) or !viewdir.direction().eq(object direction('W')) or !viewdir.direction().eq(object direction('N')) or !viewdir.direction().eq(object direction('S')) or !isnamed.boolean() then
							new texp btext |$!tempt| origin x $!posx y $!posy adegrees 90 cheitx |$!!DrawingPlan1.dwgnohei.val| alig tbody just center txcolour yellow font 1
						endif
					else
						-----------------------------------
						-- find out the maximun distance --
						-----------------------------------
						
						
						
						
						do !i from 1 to !sortedtypes.size()
							!newx = !!DrawingPlan1.viewURsh.part(2)
							!newy = !sortedtypes[!i].split('~').getindexed(1)
							new stra fpt x $!newx y $!newy length 10 adegrees 0 NLStyle 201 NLColour Magenta
							
							
							
$(							
							
							
							
							
						if !viewdir.direction().eq(object direction('E')) or !viewdir.direction().eq(object direction('W')) or !viewdir.direction().eq(object direction('N')) or !viewdir.direction().eq(object direction('S')) then
							if !rcode.eqnocase('up') then
								if !!DrawingPlan1.minE.gt(0) then
									!tempb = !chks[1].split('!').getindexed(2)
									var !tempe namn of equi of $!tempb
									!tempt = 'MATCH LINE E' & !!stringRoundUpValue($!!DrawingPlan1.minE, !format) & ' SEE ' & !tempe
								else
									!tempt = 'MATCH LINE W' & !!stringRoundUpValue($!!DrawingPlan1.minE * -1, !format) & ' SEE ' & !tempe
								endif
							else
								-------------------
								-- !rcode = left --
								-------------------
								if !!DrawingPlan1.minN.gt(0) then
									!tempb = !chks[1].split('!').getindexed(2)
									var !tempe namn of equi of $!tempb
									!tempt = 'MATCH LINE N' & !!stringRoundUpValue($!!DrawingPlan1.minN, !format) & ' SEE ' & !tempe
								else
									!tempt = 'MATCH LINE S' & !!stringRoundUpValue($!!DrawingPlan1.minN * -1, !format) & ' SEE ' & !tempe
								endif
							endif
							!posx = !!DrawingPlan1.viewURsh.part(2).real() + 1
							!posy = (!!DrawingPlan1.viewURsh.part(4).real() - !!DrawingPlan1.viewLRsh.part(4).real()) * 0.5 + !!DrawingPlan1.viewLRsh.part(4).real()
							new texp btext |$!tempt| origin x $!posx y $!posy adegrees 90 cheitx |$!!DrawingPlan1.dwgnohei.val| alig tbody just center txcolour yellow font 1
						else
							--------------------------------
							-- none orthorgonal direction --
							--------------------------------
							!tempb = !chks[1].split('!').getindexed(2)
							var !tempe namn of equi of $!tempb
							!tempt = 'MATCH LINE SEE ' & !tempe
							!posx = !!DrawingPlan1.viewURsh.part(2).real() + 1
							!posy = (!!DrawingPlan1.viewURsh.part(4).real() - !!DrawingPlan1.viewLRsh.part(4).real()) * 0.5 + !!DrawingPlan1.viewLRsh.part(4).real()
							new texp btext |$!tempt| origin x $!posx y $!posy adegrees 90 cheitx |$!!DrawingPlan1.dwgnohei.val| alig tbody just center txcolour yellow font 1
						endif	
							
							
							
							
	$)						
							
							
							
							
							
							
							
							
							
							
							
						enddo
					endif
					q var !sortedtypes[1]
					q var !sortedtypes[2]
					q var !sortedtypes[3]
					q var !sortedtypes[4]
				endif
			endif
			
			note 1
			if not(!nearbybox) then
				---------------------------------------------------
				-- only write coordinate if orthogonal direction --
				---------------------------------------------------
				if !viewdir.direction().eq(object direction('E')) or !viewdir.direction().eq(object direction('W')) or !viewdir.direction().eq(object direction('N')) or !viewdir.direction().eq(object direction('S')) then
					if !rcode.eqnocase('up') then
						if !!DrawingPlan1.minE.gt(0) then
							!tempt = 'BATTERY LIMITS E' & !!stringRoundUpValue($!!DrawingPlan1.minE, !format)
						else
							!tempt = 'BATTERY LIMITS W' & !!stringRoundUpValue($!!DrawingPlan1.minE * -1, !format)
						endif
					else
						-------------------
						-- !rcode = left --
						-------------------
						if !!DrawingPlan1.minN.gt(0) then
							!tempt = 'BATTERY LIMITS N' & !!stringRoundUpValue($!!DrawingPlan1.minN, !format)
						else
							!tempt = 'BATTERY LIMITS S' & !!stringRoundUpValue($!!DrawingPlan1.minN * -1, !format)
						endif
					endif
					!posx = !!DrawingPlan1.viewURsh.part(2).real() + 1
					!posy = (!!DrawingPlan1.viewURsh.part(4).real() - !!DrawingPlan1.viewLRsh.part(4).real()) * 0.5 + !!DrawingPlan1.viewLRsh.part(4).real()
					new texp btext |$!tempt| origin x $!posx y $!posy adegrees 90 cheitx |$!!DrawingPlan1.dwgnohei.val| alig tbody just center txcolour yellow font 1
				endif
			endif
		elseif (!dir.eq('left')) then
		elseif (!dir.eq('down')) then
		elseif (!dir.eq('up')) then
		endif
	enddo
				
$($)				
	note 1
	new stra fpt $!!DrawingPlan1.viewULsh tpt $!!DrawingPlan1.viewURsh NLStyle 201 NLColour Magenta 
	new stra fpt $!!DrawingPlan1.viewLLsh tpt $!!DrawingPlan1.viewLRsh NLStyle 201 NLColour Magenta 
	new stra fpt $!!DrawingPlan1.viewLRsh tpt $!!DrawingPlan1.viewURsh NLStyle 201 NLColour Magenta 
	new stra fpt $!!DrawingPlan1.viewLLsh tpt $!!DrawingPlan1.viewULsh NLStyle 201 NLColour Magenta


endfunction
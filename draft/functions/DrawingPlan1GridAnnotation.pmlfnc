--------------------------------
-- Function : Grid Annotation --
-- Auther   : tw tseng        --
-- Date     : 2025/01/08      --
--------------------------------
define function !!DrawingPlan1GridAnnotation(!name is string)
	!vw = !!DrawingPlan1ViewPath(!name)
	----------------------------------------------------------------------
	-- where every grid bubble of this drawing ends up on the sheet, so  --
	-- that !!DrawingPlan1LineNoAnnotation can keep the pipe numbers out --
	-- of them. filled in by .CreateGridSymbol() and                     --
	-- .CreateGridSymbolwithIntersection(), one 'side~x~y' per bubble    --
	--                                                                   --
	-- a global rather than a member of the form: the two files are read --
	-- at different times (a .pmlfnc on every call, the form only on     --
	-- kill/show), so a member breaks every run made in between          --
	----------------------------------------------------------------------
	!!DrawingPlan1GridBubbles = object array()
	--------------------------------------------------------------------
	-- update path: this LAYE survives from a previous run, so reuse it --
	-- instead of erroring on a duplicate name. the attribute lines     --
	-- below always reapply, harmless whether it is new or old -- same  --
	-- as DrawingPlan1LineNoAnnotation does with ateLINE (2026-08-28)   --
	--------------------------------------------------------------------
	$!vw/ateGRID
	handle any
		NEW LAYE $!vw/ateGRID
	elsehandle none
	endhandle
	Purpose GRIDA
	Lvisibility true
	Font 1
	Justification Left
	Alignment Template
	Tsiztx '5mm'
	Chostx '6mm'
	Asubtended 0degree
	Pjustification Towards 
	Oshttx '2mm'
	Plcltx '0mm'
	Doffset 25mm
	Dmsptx '0mm'
	Lleader true
	Lframe true
	Lshape Straight
	Gboxtx '1mm'
	Llcltx '0mm'
	Xyscale 1 1
	Xyposition 25mm 25mm 
	Blnk false
	Bmargin 0mm
	Trsf Nulref
	Txcolour Yellow 
	NLStyle Solid 
	NLColour Cyan 
	FStyle Off 
	FColour Grey 
	LLStyle Chained 
	LLColour Cyan 
	LFStyle Solid 
	LFColour Cyan 
	DLStyle Solid 
	DLColour Cyan 
	PLStyle Solid 
	PLColour Cyan 
	MColour Cyan 
	CHStyle Off 
	CHColour Grey
  ----------------------------------------------------------------
  -- grid bubble character height. .gridhei has sat on the Grid   --
  -- tab unread since it was added; this is the line it was       --
  -- always meant to drive. its form default was 3 while this     --
  -- printed 4, so the default moved to 4 in the same change:     --
  -- wiring it up without that would have shrunk every existing   --
  -- bubble and clouded whole drawings on the next update         --
  ----------------------------------------------------------------
  !cheigridv = 4
  !cheigridv = !!DrawingPlan1.gridhei.val
  handle any
    !cheigridv = 4
  endhandle
  !cheigrid = !cheigridv.string('D2') & 'mm'
  Cheitx '$!cheigrid'
	
	--------------------------------------------------------------------
	-- every bubble already on this layer, read before anything is      --
	-- drawn. each one is named by the grid line it belongs to (DDNA),  --
	-- which end of it (NPPT) and which side of the view it came out on --
	-- (AGSIDE); DrawingPlan1GridClaim matches on those three and hands --
	-- back the one to reuse, so a bubble keeps its identity across an  --
	-- update even when the box has grown and moved it. whatever no     --
	-- grid line wants this run is deleted at the bottom                --
	--------------------------------------------------------------------
	!dbgg0 = object file('L:\E3D\pdms_prog\E3D2.1\PA_pmllibE3D2.1\check_grid.txt')
	!dbgg0.open('overwrite')
	!dbgg0.writerecord('GRIDRUN ' & !name)
	!dbgg0.close()
	handle any
	endhandle
	!!DrawingPlan1GridSlabRefs = object array()
	!!DrawingPlan1GridSlabDdna = object array()
	!!DrawingPlan1GridSlabSide = object array()
	!!DrawingPlan1GridSlabNppt = object array()
	!!DrawingPlan1GridSlabClaims = object array()
	!!DrawingPlan1GridSlabXypo = object array()
	$!vw/ateGRID
	var !exslabs coll all slab for ce
	handle any
		!exslabs = object array()
	endhandle
	do !exsl values !exslabs
		$!exsl
		handle any
			skip
		endhandle
		var !exref ref
		!exddna = ''
		var !exddna ddna
		handle any
			!exddna = ''
		endhandle
		!exside = ''
		var !exside agside
		handle any
			!exside = ''
		endhandle
		!exnstr = ''
		var !exnstr nppt
		handle any
			!exnstr = ''
		endhandle
		!exnppt = 0
		!exnppt = !exnstr.real()
		handle any
			!exnppt = 0
		endhandle
		!exxypo = ''
		var !exxypo xypo
		handle any
			!exxypo = ''
		endhandle
		!!DrawingPlan1GridSlabRefs.append(!exref)
		!!DrawingPlan1GridSlabDdna.append(!exddna)
		!!DrawingPlan1GridSlabSide.append(!exside)
		!!DrawingPlan1GridSlabNppt.append(!exnppt)
		!!DrawingPlan1GridSlabClaims.append(false)
		!!DrawingPlan1GridSlabXypo.append(!exxypo)
	enddo
	
	--------------------------------------------------------------------
	-- the sheet depth each side's bubbles are ALREADY sitting at.     --
	-- a bubble on an issued drawing never moves, so a new one on a    --
	-- side that already has some must line up with them and not with  --
	-- the box edge -- the box edge has moved since they were placed,  --
	-- and on the side the box grew the two are 34.9mm apart (measured --
	-- live 2026-08-29: a new left bubble wanted XYPO -65.926 where    --
	-- its three frozen neighbours sit at -31.008)                     --
	--                                                                  --
	-- a SLAB does not answer shpos, so the depth is rebuilt the way it --
	-- was written: the refgln's own NPPT end projected to the sheet,   --
	-- plus the bubble's XYPO. XYPO is in view coordination, so the     --
	-- rcode swap has to be undone first -- the inverse of the one in   --
	-- .CreateGridSymbol*. every bubble on one side shares a depth, so  --
	-- the first readable one per side is enough                        --
	--------------------------------------------------------------------
	!!DrawingPlan1GridFrozenSides = object array()
	!!DrawingPlan1GridFrozenDepths = object array()
	$!vw/ateGRID
	!fn = 0
	!fn = !!DrawingPlan1GridSlabRefs.size()
	handle any
		!fn = 0
	endhandle
	do !fi from 1 to !fn
		!fside = !!DrawingPlan1GridSlabSide[!fi]
		!fddna = !!DrawingPlan1GridSlabDdna[!fi]
		!fnppt = !!DrawingPlan1GridSlabNppt[!fi]
		!fxypo = !!DrawingPlan1GridSlabXypo[!fi]
		if (!fside.eq('') or !fddna.eq('') or !fddna.eq('=0/0') or !fxypo.eq('')) then
			skip
		endif
		!fseen = false
		do !fj from 1 to !!DrawingPlan1GridFrozenSides.size()
			if (!!DrawingPlan1GridFrozenSides[!fj].eqnocase(!fside)) then
				!fseen = true
				break
			endif
		enddo
		if (!fseen) then
			skip
		endif
		!fend = ''
		if (!fnppt.eq(2)) then
			var !fend p2 pos of $!fddna wrt worl
			handle any
				!fend = ''
			endhandle
		else
			var !fend p1 pos of $!fddna wrt worl
			handle any
				!fend = ''
			endhandle
		endif
		if (!fend.eq('')) then
			skip
		endif
		!fendp = object position(!fend)
		!fendp.up = 0
		!fendsh = ''
		var !fendsh shpos of $!fendp
		handle any
			!fendsh = ''
		endhandle
		if (!fendsh.eq('')) then
			skip
		endif
		!fxv = !fxypo.part(1).replace('mm','').real()
		!fyv = !fxypo.part(2).replace('mm','').real()
		!fxs = !fxv
		!fys = !fyv
		if (!!DrawingPlan1.rcode.eqnocase('left')) then
			!fys = !fxv
			!fxs = !fyv * -1
		endif
		!fdepth = 0
		if (!fside.eqnocase('Left') or !fside.eqnocase('Right')) then
			!fdepth = !fendsh.part(2).replace('mm','').real() + !fxs
		else
			!fdepth = !fendsh.part(4).replace('mm','').real() + !fys
		endif
		!!DrawingPlan1GridFrozenSides.append(!fside)
		!!DrawingPlan1GridFrozenDepths.append(!fdepth)
		!dbggf = object file('L:\E3D\pdms_prog\E3D2.1\PA_pmllibE3D2.1\check_grid.txt')
		!dbggf.open('append')
		!dbggf.writerecord('FROZEN side=' & !fside & ' end=' & !fendsh & ' xypo=' & !fxypo & ' depth=' & !fdepth.string('D3'))
		!dbggf.close()
		handle any
		endhandle
	enddo

	----------------------------------------------
	-- calculate view four corners coordination --
	----------------------------------------------
	$!vw
--	var !shxypos shxypos
--	var !size size
	
  -------------------------------------
  -- collect grids from drawing list --
	-- never from a specific volume    --
	-- it may miss some grids          --
	-------------------------------------
  
	!gridels = object array()
  
	!temps = object array()
	!idlpath = !!DrawingPlan1LibPath(!name) & '/DRAWLIST/DRWG'
	var !addes coll all adde for $!idlpath
	do !adde values !addes
	  var !type type of idna of $!adde
		if (!type.eq('REFGRD')) then
		  var !idna idna of $!adde
		  var !temps coll all gridel for $!idna
 			do !temp values !temps
			  !gridels.append(!temp)
			enddo
 		endif
	enddo
	
	$!vw/ateGRID
	do !gridel values !gridels
	  var !gridpls coll all gridpl for $!gridel
		var !refglns coll all refgln for $!gridpls[1]
		do !refgln values !refglns
		  var !p1pos p1 pos of $!refgln wrt worl
		  var !p2pos p2 pos of $!refgln wrt worl
		  var !p2dir p2 dir of $!refgln wrt worl
      
      !p1posenu = object position(!p1pos)
      !p1posenu.up = 0
      !p2posenu = object position(!p2pos)
      !p2posenu.up = 0      
      !p12line = object line(!p1posenu, !p2posenu)
      
      var !p1possh shpos of $!p1posenu
      var !p2possh shpos of $!p2posenu
      !p12linesh = object line(!p1possh.position(), !p2possh.position())
			!p1dirsh = !p1possh.position().direction(!p2possh.position())
			
--			$p $!p1dirsh

			$!vw/ateGRID
			-------------------------------------------------------------------------
			-- .intersections holds the intersections of THIS refgln only, because --
			-- the checks below pick them up by getindexed(1) and getindexed(2).   --
			-- every intersection is also kept in .allintersections, which         --
			-- !!DrawingPlan1LineNoAnnotation() uses to dimension the grid          --
			-------------------------------------------------------------------------
			!!DrawingPlan1.intersections = object array()
			--------------------------------------------------------------------------
			-- check if grids are in view volume                                    --
			-- step 1. find out intersction points between view frame and grid line --
			--         ignore grids that less than two intersection points          --
			-- step 2. check intersection point is on bounded grid line             --
			-- step 3. there are three conditions for grid lines                    --
			--------------------------------------------------------------------------
			if (!!DrawingPlan1.boxUlinesh.intersection(!p12linesh).east.geq(!!DrawingPlan1.boxLLsh.position().east.value()) and !!DrawingPlan1.boxUlinesh.intersection(!p12linesh).east.leq(!!DrawingPlan1.boxLRsh.position().east.value())) then
				!!DrawingPlan1.intersections.append('boxUlinesh-' & !!DrawingPlan1.boxUlinesh.intersection(!p12linesh).string())
			endif
			handle any
			  -- for parellel condition --
			endhandle
			if (!!DrawingPlan1.boxDlinesh.intersection(!p12linesh).east.geq(!!DrawingPlan1.boxLLsh.position().east.value()) and !!DrawingPlan1.boxDlinesh.intersection(!p12linesh).east.leq(!!DrawingPlan1.boxLRsh.position().east.value())) then
				!!DrawingPlan1.intersections.append('boxDlinesh-' & !!DrawingPlan1.boxDlinesh.intersection(!p12linesh).string())
			endif
			handle any
			  -- for parellel condition --
			endhandle
      if (!!DrawingPlan1.boxLlinesh.intersection(!p12linesh).north.geq(!!DrawingPlan1.boxLLsh.position().north.value()) and !!DrawingPlan1.boxLlinesh.intersection(!p12linesh).north.leq(!!DrawingPlan1.boxULsh.position().north.value())) then
				!!DrawingPlan1.intersections.append('boxLlinesh-' & !!DrawingPlan1.boxLlinesh.intersection(!p12linesh).string())
      endif
			handle any
			  -- for parellel condition --
			endhandle
      if (!!DrawingPlan1.boxRlinesh.intersection(!p12linesh).north.geq(!!DrawingPlan1.boxLLsh.position().north.value()) and !!DrawingPlan1.boxRlinesh.intersection(!p12linesh).north.leq(!!DrawingPlan1.boxULsh.position().north.value())) then
				!!DrawingPlan1.intersections.append('boxRlinesh-' & !!DrawingPlan1.boxRlinesh.intersection(!p12linesh).string())
      endif
			handle any
			  -- for parellel condition --
			endhandle
			
			!!DrawingPlan1.intersections.unique()

			-------------------------------------------------------------------------
			-- .allintersections carries where the grid line really ends as well, --
			-- after a '~', so that !!DrawingPlan1LineNoAnnotation() can reach    --
			-- the projection line of the dimension in to the grid instead of     --
			-- stopping it at the border of the view. .intersections itself is    --
			-- left alone, the two .CreateGridSymbol*() methods read it           --
			--                                                                     --
			-- 2026-08-13: a second '~' then carries the grid line's own NAME, so --
			-- a section=grid DPOI logged by !!DrawingPlan1LineNoAnnotation() can  --
			-- be traced back to which grid line it is -- user could not tell     --
			-- which grid line a blank-text dimension point belonged to from the  --
			-- q pos / q ddna it queried alone. name of $!refgln turned out to be --
			-- unnamed (came back as a bare =DB/ref, confirmed live) -- name of   --
			-- $!gridel came back '/PIPERACK_P1_A01/Elev', confirmed live too --  --
			-- but per the user, this project's convention keeps the real plan   --
			-- position grid lines (like P1.3 / P1.4) filed underneath 'Elev',   --
			-- not as 'Elev' itself, so this is one level too high. !gridpls[1]  --
			-- (:80, the one gridpl actually used to collect !refglns) is the    --
			-- next level down -- read its name too to see if that is where the --
			-- real position-line name lives. temporary, remove once answered   --
			-------------------------------------------------------------------------
			var !refglnname name of $!gridel
			var !gridplname name of $!gridpls[1]
			------------------------------------------------------------
			-- the number this grid line's bubble will print. the label --
			-- template prints #gridid, which is the GRIDPL's IDPLANE   --
			-- (user, 2026-09-07) -- NOT anything on the REFGLN, whose  --
			-- NAME is empty for every one of them in this project (the --
			-- 2026-08-13 hunt in README)                                --
			--                                                           --
			-- the plane is reached through the REFGLN's GRDREF, not      --
			-- through its DB owner:                                     --
			--   q idplane of grdref   ->  IDPlane 18                    --
			-- confirmed live on =67128186/4483677 (user, 2026-09-07)    --
			--                                                           --
			-- the owner is a different thing entirely and answers 1 for --
			-- every line on the drawing: this loop only ever collects   --
			-- refglns from !gridpls[1], so they all share that one      --
			-- owner, and one GRIDPL holds several lines at different    --
			-- positions anyway, so its IDPLANE could never be a         --
			-- per-line number                                           --
			--                                                           --
			-- handed to the two .CreateGridSymbol*() methods through a  --
			-- global, the same way the claim list and the frozen depths --
			-- are: the caller is the FORM while the collecting is done  --
			-- here, and the two files are read at different times       --
			------------------------------------------------------------
			!gidnow = ''
			var !gidnow idplane of grdref of $!refgln
			handle any
				!gidnow = ''
			endhandle
			!!DrawingPlan1GridIdNow = !gidnow

			------------------------------------------------------------------
			-- one crossing on the grid line itself (the !total = 1 case     --
			-- below): which crossing that is, and which end of the line is  --
			-- the inside one. worked out here because it also decides what  --
			-- goes into .allintersections                                   --
			--                                                               --
			-- an end lying ON the border counts as inside (0.01mm). a view  --
			-- drawn by hand with its limits typed on the grid lines         --
			-- themselves put ES.A along the bottom edge: p1 at ES.1 inside, --
			-- p2 at the corner, which is the crossing. the old strict test  --
			-- read p1 as outside and hung the Left bubble off p2, in the    --
			-- middle of the view, and the match line text moved out five    --
			-- rows to get past it (user, 2026-09-28, check_grid /           --
			-- check_gap). when both ends pass, the one farther from the     --
			-- crossing is the inside end -- the other one IS the crossing   --
			------------------------------------------------------------------
			!gi = 0
			!gii = 0
			if (!!DrawingPlan1.intersections.size().geq(2)) then
				!gon1 = !p12linesh.on(!!DrawingPlan1.intersections.getindexed(1).split('-').getindexed(2).position(), true)
				!gon2 = !p12linesh.on(!!DrawingPlan1.intersections.getindexed(2).split('-').getindexed(2).position(), true)
				if (!gon1 and not(!gon2)) then
					!gi = 1
					!gii = 2
				elseif (!gon2 and not(!gon1)) then
					!gi = 2
					!gii = 1
				endif
			endif
			!guse1 = true
			!gstub = false
			!gstubint = ''
			if (!gi.gt(0)) then
				!gtol = 0.01
				!gxl = !!DrawingPlan1.boxULsh.position().east.value() - !gtol
				!gxr = !!DrawingPlan1.boxURsh.position().east.value() + !gtol
				!gyb = !!DrawingPlan1.boxLLsh.position().north.value() - !gtol
				!gyt = !!DrawingPlan1.boxULsh.position().north.value() + !gtol
				!g1x = !p1possh.position().east.value()
				!g1y = !p1possh.position().north.value()
				!g2x = !p2possh.position().east.value()
				!g2y = !p2possh.position().north.value()
				!gin1 = false
				if (!g1x.gt(!gxl) and !g1x.lt(!gxr) and !g1y.gt(!gyb) and !g1y.lt(!gyt)) then
					!gin1 = true
				endif
				!gin2 = false
				if (!g2x.gt(!gxl) and !g2x.lt(!gxr) and !g2y.gt(!gyb) and !g2y.lt(!gyt)) then
					!gin2 = true
				endif
				!gcr = !!DrawingPlan1.intersections.getindexed(!gi).split('-').getindexed(2).position()
				!gcx = !gcr.east.value()
				!gcy = !gcr.north.value()
				!g1d = (!g1x - !gcx) * (!g1x - !gcx) + (!g1y - !gcy) * (!g1y - !gcy)
				!g2d = (!g2x - !gcx) * (!g2x - !gcx) + (!g2y - !gcy) * (!g2y - !gcy)
				!guse1 = !gin1
				if (!gin1 and !gin2) then
					!guse1 = !g1d.geq(!g2d)
				endif
				--------------------------------------------------------------
				-- a line that only just pokes in over the border is not in  --
				-- this view at all. ES.B..ES.D start at ES.1, which sits    --
				-- 0.025mm inside the right border of /DWGNO-002 (the margin --
				-- Apply adds round the box), and run east, out of the view. --
				-- the far crossing, on the LEFT border, is only where the   --
				-- endless line would cross: its bubble hung 274mm of leader --
				-- off ES.1 and the left dimension reached its point in to   --
				-- ES.1 as well, a projection line right across the drawing  --
				-- on rows E, F and H -- and those points took the along     --
				-- coordinate of the plant grid's own E, F and H crossings,  --
				-- which then were left out (user, 2026-09-29). under 1mm    --
				-- of paper: no bubble and no dimension on the far side. the --
				-- near side, the border the line really touches, is kept    --
				--------------------------------------------------------------
				!gind = !g2d
				if (!guse1) then
					!gind = !g1d
				endif
				if (!gind.lt(1)) then
					!gstub = true
					!gstubint = !!DrawingPlan1.intersections.getindexed(!gii)
					!dbggf = object file('L:\E3D\pdms_prog\E3D2.1\PA_pmllibE3D2.1\check_grid.txt')
					!dbggf.open('append')
					!dbggf.writerecord('GRIDSTUB id=' & !gidnow & ' inside=' & !gind.sqrt().string('D3') & ' dropped=' & !gstubint & ' gln=' & !refgln.string())
					!dbggf.close()
					handle any
					endhandle
				endif
			endif

			do !thisint values !!DrawingPlan1.intersections
				if (!gstub) then
					if (!thisint.eq(!gstubint)) then
						skip
					endif
				endif
				!thisintpt = !thisint.split('-').getindexed(2).position()
				!thisend = !!DrawingPlan1.NearEndOfGrid(!p12linesh, !p1possh, !p2possh, !thisintpt)
				!!DrawingPlan1.allintersections.append(!thisint & '~' & !thisend.string() & '~' & !refglnname & '/' & !gridplname)
			enddo

			!total = 0
			if (!!DrawingPlan1.intersections.size().geq(2)) then
				if (!p12linesh.on(!!DrawingPlan1.intersections.getindexed(1).split('-').getindexed(2).position(), true)) then
				  !total = !total + 1
				endif
				if (!p12linesh.on(!!DrawingPlan1.intersections.getindexed(2).split('-').getindexed(2).position(), true)) then
				  !total = !total + 1
				endif
			endif

			!framedir = object direction()
			!griddir = object direction()
			!nppt = 0
			-----------------------------------------------------------
			-- !total = 2 which means the grid is inside view limits --
			-- there are two intersection points with view frame     --
			-----------------------------------------------------------
			if (!total.eq(2)) then
				do !i from 1 to !!DrawingPlan1.intersections.size()
				  !!DrawingPlan1.CreateGridSymbolwithIntersection(!i, !p12linesh, !p1possh, !p2possh, !refgln)
				enddo
			endif
			
			-----------------------------------------------------------
			-- !total = 1 which means the grid is inside view limits --
			-- there is one intersection point between view frame    --
			-- and one of end point of grid is inside view limits    --
			-----------------------------------------------------------
			if (!total.eq(1)) then
				-- !gi / !gii, the inside end and !gstub: worked out above --
				!i = !gi
				!ii = !gii
				!!DrawingPlan1.CreateGridSymbolwithIntersection(!i, !p12linesh, !p1possh, !p2possh, !refgln)
				if (not(!gstub)) then
					if (!guse1) then
						!!DrawingPlan1.CreateGridSymbol(!ii, !p12linesh, !p1possh, !p2possh, !refgln, 1)
					else
						!!DrawingPlan1.CreateGridSymbol(!ii, !p12linesh, !p2possh, !p1possh, !refgln, 2)
					endif
				endif
			endif
			
			----------------------------------------------------------------------------------
			-- !total = 0 which means the entire grid line is inside or outside view limits --
			-- therefore check if both end points are inside view limits                    --
			----------------------------------------------------------------------------------
			if (!total.eq(0)) then
				if (!p1possh.position().east.gt(!!DrawingPlan1.boxULsh.position().east) and !p1possh.position().east.lt(!!DrawingPlan1.boxURsh.position().east) and !p1possh.position().north.gt(!!DrawingPlan1.boxLLsh.position().north) and !p1possh.position().north.lt(!!DrawingPlan1.boxULsh.position().north)) then
					if (!p1possh.position().distance(!!DrawingPlan1.intersections.getindexed(1).split('-').getindexed(2).position()).lt(!p2possh.position().distance(!!DrawingPlan1.intersections.getindexed(1).split('-').getindexed(2).position()))) then
						!!DrawingPlan1.CreateGridSymbol(1, !p12linesh, !p1possh, !p2possh, !refgln, 1)
						!!DrawingPlan1.CreateGridSymbol(2, !p12linesh, !p2possh, !p1possh, !refgln, 2)
					else
						!!DrawingPlan1.CreateGridSymbol(2, !p12linesh, !p1possh, !p2possh, !refgln, 1)
						!!DrawingPlan1.CreateGridSymbol(1, !p12linesh, !p2possh, !p1possh, !refgln, 2)
					endif
				endif
			endif
$(			
			do !a value !!DrawingPlan1.intersections
			  $p $!a
			enddo
$)			
		enddo
	enddo
	--------------------------------------------------------------------
	-- bubbles from a previous run that no grid line asked for this     --
	-- time -- a grid line that no longer reaches the view after the    --
	-- box changed, say. run once, after every side has had its turn    --
	--------------------------------------------------------------------
	!gsn = 0
	!gsn = !!DrawingPlan1GridSlabRefs.size()
	handle any
		!gsn = 0
	endhandle
	do !gsi from 1 to !gsn
		if (not(!!DrawingPlan1GridSlabClaims[!gsi])) then
			!gsref = !!DrawingPlan1GridSlabRefs[!gsi]
			$!gsref
			handle any
				skip
			endhandle
			delete slab
			handle any
			endhandle
		endif
	enddo
endfunction
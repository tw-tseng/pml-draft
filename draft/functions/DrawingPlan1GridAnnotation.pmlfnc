--------------------------------
-- Function : Grid Annotation --
-- Auther   : tw tseng        --
-- Date     : 2025/01/08      --
--------------------------------
define function !!DrawingPlan1GridAnnotation(!name is string)
	----------------------------------------------------------------------
	-- where every grid bubble of this drawing ends up on the sheet, so  --
	-- that !!DrawingPlan1LineNoAnnotation can keep the pipe numbers out --
	-- of them. filled in by .CreateGridSymbol() and                     --
	-- .CreateGridSymbolwithIntersection(), one 'side~x~y' per bubble    --
	--                                                                   --
	-- a global rather than a member of the form: the two files are read --
	-- at different times (a .pmlfnc on every call, the form only on     --
	-- kill/show), so a member breaks every run made in between          --
	----------------------------------------------------------------------
	!!DrawingPlan1GridBubbles = object array()
	--------------------------------------------------------------------
	-- update path: this LAYE survives from a previous run, so reuse it --
	-- instead of erroring on a duplicate name. the attribute lines     --
	-- below always reapply, harmless whether it is new or old -- same  --
	-- as DrawingPlan1LineNoAnnotation does with ateLINE (2026-08-28)   --
	--------------------------------------------------------------------
	$!name/SS/S1/V1/ateGRID
	handle any
		NEW LAYE $!name/SS/S1/V1/ateGRID
	elsehandle none
	endhandle
	Purpose GRIDA
	Lvisibility true
	Font 1
	Justification Left
	Alignment Template
	Tsiztx '5mm'
	Chostx '6mm'
	Asubtended 0degree
	Pjustification Towards 
	Oshttx '2mm'
	Plcltx '0mm'
	Doffset 25mm
	Dmsptx '0mm'
	Lleader true
	Lframe true
	Lshape Straight
	Gboxtx '1mm'
	Llcltx '0mm'
	Xyscale 1 1
	Xyposition 25mm 25mm 
	Blnk false
	Bmargin 0mm
	Trsf Nulref
	Txcolour Yellow 
	NLStyle Solid 
	NLColour Cyan 
	FStyle Off 
	FColour Grey 
	LLStyle Chained 
	LLColour Cyan 
	LFStyle Solid 
	LFColour Cyan 
	DLStyle Solid 
	DLColour Cyan 
	PLStyle Solid 
	PLColour Cyan 
	MColour Cyan 
	CHStyle Off 
	CHColour Grey
  Cheitx '4.00mm'
	
	--------------------------------------------------------------------
	-- every bubble already on this layer, read before anything is      --
	-- drawn. each one is named by the grid line it belongs to (DDNA),  --
	-- which end of it (NPPT) and which side of the view it came out on --
	-- (AGSIDE); DrawingPlan1GridClaim matches on those three and hands --
	-- back the one to reuse, so a bubble keeps its identity across an  --
	-- update even when the box has grown and moved it. whatever no     --
	-- grid line wants this run is deleted at the bottom                --
	--------------------------------------------------------------------
	!!DrawingPlan1GridSlabRefs = object array()
	!!DrawingPlan1GridSlabDdna = object array()
	!!DrawingPlan1GridSlabSide = object array()
	!!DrawingPlan1GridSlabNppt = object array()
	!!DrawingPlan1GridSlabClaims = object array()
	$!name/SS/S1/V1/ateGRID
	var !exslabs coll all slab for ce
	handle any
		!exslabs = object array()
	endhandle
	do !exsl values !exslabs
		$!exsl
		handle any
			skip
		endhandle
		var !exref ref
		!exddna = ''
		var !exddna ddna
		handle any
			!exddna = ''
		endhandle
		!exside = ''
		var !exside agside
		handle any
			!exside = ''
		endhandle
		!exnstr = ''
		var !exnstr nppt
		handle any
			!exnstr = ''
		endhandle
		!exnppt = 0
		!exnppt = !exnstr.real()
		handle any
			!exnppt = 0
		endhandle
		!!DrawingPlan1GridSlabRefs.append(!exref)
		!!DrawingPlan1GridSlabDdna.append(!exddna)
		!!DrawingPlan1GridSlabSide.append(!exside)
		!!DrawingPlan1GridSlabNppt.append(!exnppt)
		!!DrawingPlan1GridSlabClaims.append(false)
	enddo

	----------------------------------------------
	-- calculate view four corners coordination --
	----------------------------------------------
	$!name/SS/S1/V1
--	var !shxypos shxypos
--	var !size size
	
  -------------------------------------
  -- collect grids from drawing list --
	-- never from a specific volume    --
	-- it may miss some grids          --
	-------------------------------------
  
	!gridels = object array()
  
	!temps = object array()
	var !addes coll all adde for $!name/SS/DRAWLIST/DRWG
	do !adde values !addes
	  var !type type of idna of $!adde
		if (!type.eq('REFGRD')) then
		  var !idna idna of $!adde
		  var !temps coll all gridel for $!idna
 			do !temp values !temps
			  !gridels.append(!temp)
			enddo
 		endif
	enddo
	
	$!name/SS/S1/V1/ateGRID
	do !gridel values !gridels
	  var !gridpls coll all gridpl for $!gridel
		var !refglns coll all refgln for $!gridpls[1]
		do !refgln values !refglns
		  var !p1pos p1 pos of $!refgln wrt worl
		  var !p2pos p2 pos of $!refgln wrt worl
		  var !p2dir p2 dir of $!refgln wrt worl
      
      !p1posenu = object position(!p1pos)
      !p1posenu.up = 0
      !p2posenu = object position(!p2pos)
      !p2posenu.up = 0      
      !p12line = object line(!p1posenu, !p2posenu)
      
      var !p1possh shpos of $!p1posenu
      var !p2possh shpos of $!p2posenu
      !p12linesh = object line(!p1possh.position(), !p2possh.position())
			!p1dirsh = !p1possh.position().direction(!p2possh.position())
			
--			$p $!p1dirsh

			$!name/SS/S1/V1/ateGRID
			-------------------------------------------------------------------------
			-- .intersections holds the intersections of THIS refgln only, because --
			-- the checks below pick them up by getindexed(1) and getindexed(2).   --
			-- every intersection is also kept in .allintersections, which         --
			-- !!DrawingPlan1LineNoAnnotation() uses to dimension the grid          --
			-------------------------------------------------------------------------
			!!DrawingPlan1.intersections = object array()
			--------------------------------------------------------------------------
			-- check if grids are in view volume                                    --
			-- step 1. find out intersction points between view frame and grid line --
			--         ignore grids that less than two intersection points          --
			-- step 2. check intersection point is on bounded grid line             --
			-- step 3. there are three conditions for grid lines                    --
			--------------------------------------------------------------------------
			if (!!DrawingPlan1.boxUlinesh.intersection(!p12linesh).east.geq(!!DrawingPlan1.boxLLsh.position().east.value()) and !!DrawingPlan1.boxUlinesh.intersection(!p12linesh).east.leq(!!DrawingPlan1.boxLRsh.position().east.value())) then
				!!DrawingPlan1.intersections.append('boxUlinesh-' & !!DrawingPlan1.boxUlinesh.intersection(!p12linesh).string())
			endif
			handle any
			  -- for parellel condition --
			endhandle
			if (!!DrawingPlan1.boxDlinesh.intersection(!p12linesh).east.geq(!!DrawingPlan1.boxLLsh.position().east.value()) and !!DrawingPlan1.boxDlinesh.intersection(!p12linesh).east.leq(!!DrawingPlan1.boxLRsh.position().east.value())) then
				!!DrawingPlan1.intersections.append('boxDlinesh-' & !!DrawingPlan1.boxDlinesh.intersection(!p12linesh).string())
			endif
			handle any
			  -- for parellel condition --
			endhandle
      if (!!DrawingPlan1.boxLlinesh.intersection(!p12linesh).north.geq(!!DrawingPlan1.boxLLsh.position().north.value()) and !!DrawingPlan1.boxLlinesh.intersection(!p12linesh).north.leq(!!DrawingPlan1.boxULsh.position().north.value())) then
				!!DrawingPlan1.intersections.append('boxLlinesh-' & !!DrawingPlan1.boxLlinesh.intersection(!p12linesh).string())
      endif
			handle any
			  -- for parellel condition --
			endhandle
      if (!!DrawingPlan1.boxRlinesh.intersection(!p12linesh).north.geq(!!DrawingPlan1.boxLLsh.position().north.value()) and !!DrawingPlan1.boxRlinesh.intersection(!p12linesh).north.leq(!!DrawingPlan1.boxULsh.position().north.value())) then
				!!DrawingPlan1.intersections.append('boxRlinesh-' & !!DrawingPlan1.boxRlinesh.intersection(!p12linesh).string())
      endif
			handle any
			  -- for parellel condition --
			endhandle
			
			!!DrawingPlan1.intersections.unique()

			-------------------------------------------------------------------------
			-- .allintersections carries where the grid line really ends as well, --
			-- after a '~', so that !!DrawingPlan1LineNoAnnotation() can reach    --
			-- the projection line of the dimension in to the grid instead of     --
			-- stopping it at the border of the view. .intersections itself is    --
			-- left alone, the two .CreateGridSymbol*() methods read it           --
			--                                                                     --
			-- 2026-08-13: a second '~' then carries the grid line's own NAME, so --
			-- a section=grid DPOI logged by !!DrawingPlan1LineNoAnnotation() can  --
			-- be traced back to which grid line it is -- user could not tell     --
			-- which grid line a blank-text dimension point belonged to from the  --
			-- q pos / q ddna it queried alone. name of $!refgln turned out to be --
			-- unnamed (came back as a bare =DB/ref, confirmed live) -- name of   --
			-- $!gridel came back '/PIPERACK_P1_A01/Elev', confirmed live too --  --
			-- but per the user, this project's convention keeps the real plan   --
			-- position grid lines (like P1.3 / P1.4) filed underneath 'Elev',   --
			-- not as 'Elev' itself, so this is one level too high. !gridpls[1]  --
			-- (:80, the one gridpl actually used to collect !refglns) is the    --
			-- next level down -- read its name too to see if that is where the --
			-- real position-line name lives. temporary, remove once answered   --
			-------------------------------------------------------------------------
			var !refglnname name of $!gridel
			var !gridplname name of $!gridpls[1]
			do !thisint values !!DrawingPlan1.intersections
				!thisintpt = !thisint.split('-').getindexed(2).position()
				!thisend = !!DrawingPlan1.NearEndOfGrid(!p12linesh, !p1possh, !p2possh, !thisintpt)
				!!DrawingPlan1.allintersections.append(!thisint & '~' & !thisend.string() & '~' & !refglnname & '/' & !gridplname)
			enddo

			!total = 0
			if (!!DrawingPlan1.intersections.size().geq(2)) then
				if (!p12linesh.on(!!DrawingPlan1.intersections.getindexed(1).split('-').getindexed(2).position(), true)) then
				  !total = !total + 1
				endif
				if (!p12linesh.on(!!DrawingPlan1.intersections.getindexed(2).split('-').getindexed(2).position(), true)) then
				  !total = !total + 1
				endif
			endif

			!framedir = object direction()
			!griddir = object direction()
			!nppt = 0
			-----------------------------------------------------------
			-- !total = 2 which means the grid is inside view limits --
			-- there are two intersection points with view frame     --
			-----------------------------------------------------------
			if (!total.eq(2)) then
				do !i from 1 to !!DrawingPlan1.intersections.size()
				  !!DrawingPlan1.CreateGridSymbolwithIntersection(!i, !p12linesh, !p1possh, !p2possh, !refgln)
				enddo
			endif
			
			-----------------------------------------------------------
			-- !total = 1 which means the grid is inside view limits --
			-- there is one intersection point between view frame    --
			-- and one of end point of grid is inside view limits    --
			-----------------------------------------------------------
			if (!total.eq(1)) then
				if (!p12linesh.on(!!DrawingPlan1.intersections.getindexed(1).split('-').getindexed(2).position(), true)) then
				  !i = 1
					!ii = 2
				else
				  !i = 2
					!ii = 1
				endif
				!!DrawingPlan1.CreateGridSymbolwithIntersection(!i, !p12linesh, !p1possh, !p2possh, !refgln)
				
				-------------------------------------------------
				-- check which end point is inside view limits --
				-------------------------------------------------
				if (!p1possh.position().east.gt(!!DrawingPlan1.boxULsh.position().east) and !p1possh.position().east.lt(!!DrawingPlan1.boxURsh.position().east) and !p1possh.position().north.gt(!!DrawingPlan1.boxLLsh.position().north) and !p1possh.position().north.lt(!!DrawingPlan1.boxULsh.position().north)) then
					!!DrawingPlan1.CreateGridSymbol(!ii, !p12linesh, !p1possh, !p2possh, !refgln, 1)
				else
					!!DrawingPlan1.CreateGridSymbol(!ii, !p12linesh, !p2possh, !p1possh, !refgln, 2)
				endif
			endif
			
			----------------------------------------------------------------------------------
			-- !total = 0 which means the entire grid line is inside or outside view limits --
			-- therefore check if both end points are inside view limits                    --
			----------------------------------------------------------------------------------
			if (!total.eq(0)) then
				if (!p1possh.position().east.gt(!!DrawingPlan1.boxULsh.position().east) and !p1possh.position().east.lt(!!DrawingPlan1.boxURsh.position().east) and !p1possh.position().north.gt(!!DrawingPlan1.boxLLsh.position().north) and !p1possh.position().north.lt(!!DrawingPlan1.boxULsh.position().north)) then
					if (!p1possh.position().distance(!!DrawingPlan1.intersections.getindexed(1).split('-').getindexed(2).position()).lt(!p2possh.position().distance(!!DrawingPlan1.intersections.getindexed(1).split('-').getindexed(2).position()))) then
						!!DrawingPlan1.CreateGridSymbol(1, !p12linesh, !p1possh, !p2possh, !refgln, 1)
						!!DrawingPlan1.CreateGridSymbol(2, !p12linesh, !p2possh, !p1possh, !refgln, 2)
					else
						!!DrawingPlan1.CreateGridSymbol(2, !p12linesh, !p1possh, !p2possh, !refgln, 1)
						!!DrawingPlan1.CreateGridSymbol(1, !p12linesh, !p2possh, !p1possh, !refgln, 2)
					endif
				endif
			endif
$(			
			do !a value !!DrawingPlan1.intersections
			  $p $!a
			enddo
$)			
		enddo
	enddo
	--------------------------------------------------------------------
	-- bubbles from a previous run that no grid line asked for this     --
	-- time -- a grid line that no longer reaches the view after the    --
	-- box changed, say. run once, after every side has had its turn    --
	--------------------------------------------------------------------
	!gsn = 0
	!gsn = !!DrawingPlan1GridSlabRefs.size()
	handle any
		!gsn = 0
	endhandle
	do !gsi from 1 to !gsn
		if (not(!!DrawingPlan1GridSlabClaims[!gsi])) then
			!gsref = !!DrawingPlan1GridSlabRefs[!gsi]
			$!gsref
			handle any
				skip
			endhandle
			delete slab
			handle any
			endhandle
		endif
	enddo
endfunction
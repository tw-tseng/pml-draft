-----------------------------------------
-- Function : Draw match line function --
-- Auther   : tw tseng                 --
-- Date     : 2026/03/11               --
-----------------------------------------
import 'AteSort'
handle any
endhandle
define function !!DrawingPlan1MatchLine1(!dir is string, !projid is string, !equistr is string, !format is format)
	var !viewdir viewdir $!dir
	var !rcode rcode
	--------------------------------------------------------------------
	-- the neighbouring boxes along this side, and where their edges   --
	-- meet this border. lifted out into its own function because the  --
	-- ticks below are now dimensioned as well as drawn, and the       --
	-- dimension is built long before this runs (DrawingPlan1MatchTicks --
	-- / DrawingPlan1LineNoAnnotation, 2026-08-28)                     --
	--------------------------------------------------------------------
	!sortedtypes = !!DrawingPlan1MatchSorted(!dir, !projid, !equistr)
	note 1
	--------------------------------------------------------------------
	-- the short ticks marking where a neighbouring box meets this     --
	-- border. where they go was decided by DrawingPlan1MatchTicks     --
	-- before the line number annotation ran, so that the same points  --
	-- could be put on the dimension chain -- drawing them from that   --
	-- one list is what keeps a tick and its own dimension together    --
	--------------------------------------------------------------------
	!tkn = 0
	!tkn = !!DrawingPlan1MatchTickPos.size()
	handle any
		!tkn = 0
	endhandle
	do !tki from 1 to !tkn
		!tkp = !!DrawingPlan1MatchTickPos[!tki].split('~')
		if (!tkp.getindexed(1).eq(!dir)) then
			!tkx = !tkp.getindexed(2).real()
			!tky = !tkp.getindexed(3).real()
			!tkadeg = !tkp.getindexed(4).real()
			------------------------------------------------------------
			-- these ticks are 10mm long and run out of the border at  --
			-- a fixed angle, so where the far end lands is known here --
			-- without reading it back -- which is what lets the tick  --
			-- be compared against an existing one on the same footing --
			-- as the four border straights (2026-08-28)               --
			------------------------------------------------------------
			!tkx2 = !tkx
			!tky2 = !tky
			if (!tkadeg.eq(0)) then
				!tkx2 = !tkx + 10
			elseif (!tkadeg.eq(180)) then
				!tkx2 = !tkx - 10
			elseif (!tkadeg.eq(90)) then
				!tky2 = !tky + 10
			else
				!tky2 = !tky - 10
			endif
			!tksig = 'S~' & !tkx.string() & '~' & !tky.string() & '~' & !tkx2.string() & '~' & !tky2.string()
			!tkxs = !tkx.string()
			!tkys = !tky.string()
			!tkas = !tkadeg.string()
			!tkref = !!DrawingPlan1MatchClaimRef(!tksig)
			if (!tkref.eq('')) then
				new stra fpt x $!tkxs y $!tkys length 10 adegrees $!tkas NLStyle DChainedThick  NLColour Magenta
			else
				----------------------------------------------------------------
				-- user rule, 2026-09-02, same as the border straights: a tick --
				-- marks where the box border sits, not a pipe crossing, so    --
				-- reusing it has to mean moving it onto this run's !tkx/!tky, --
				-- not leaving it on last run's -- otherwise a genuinely       --
				-- resized box leaves its ticks behind exactly like the border --
				-- straights did before this same fix                          --
				----------------------------------------------------------------
				$!tkref
				handle any
				endhandle
				FPT X $!tkxs Y $!tkys
				handle any
				endhandle
				LENGTH 10
				handle any
				endhandle
				ADEGREES $!tkas
				handle any
				endhandle
			endif
		endif
	enddo
	--------------------------------------------------------------------
	-- .MatchSorted() counts the points it found before AteSort pairs  --
	-- them up, which is the number this has always tested             --
	--------------------------------------------------------------------
	if !!DrawingPlan1MatchChkCount.gt(0) then
		do !i from 1 to !sortedtypes.size()
			if !i.modulo(2).eq(1) then
				!tempt = ''
				if !i.eq(1) then
					---------------------------
					-- the maximun distance  --
					-- write all information --
					---------------------------
					if !viewdir.direction().eq(object direction('E')) or !viewdir.direction().eq(object direction('W')) or !viewdir.direction().eq(object direction('N')) or !viewdir.direction().eq(object direction('S')) then
						if !rcode.eqnocase('up') then
							if !sortedtypes[!i].split('!').getindexed(5).eqnocase('') then
								if !dir.eq('right') then
									if !!DrawingPlan1.maxE.gt(0) then
										!tempt = 'MATCH LINE E' & !!stringRoundUpValue($!!DrawingPlan1.maxE, !format)
									else
										!tempt = 'MATCH LINE W' & !!stringRoundUpValue($!!DrawingPlan1.maxE * -1, !format)
									endif
								elseif !dir.eq('left') then
									if !!DrawingPlan1.minE.gt(0) then
										!tempt = 'MATCH LINE E' & !!stringRoundUpValue($!!DrawingPlan1.minE, !format)
									else
										!tempt = 'MATCH LINE W' & !!stringRoundUpValue($!!DrawingPlan1.minE * -1, !format)
									endif
								elseif !dir.eq('up') then
									if !!DrawingPlan1.maxN.gt(0) then
										!tempt = 'MATCH LINE N' & !!stringRoundUpValue($!!DrawingPlan1.maxN, !format)
									else
										!tempt = 'MATCH LINE S' & !!stringRoundUpValue($!!DrawingPlan1.maxN * -1, !format)
									endif
								elseif !dir.eq('down') then
									if !!DrawingPlan1.minN.gt(0) then
										!tempt = 'MATCH LINE N' & !!stringRoundUpValue($!!DrawingPlan1.minN, !format)
									else
										!tempt = 'MATCH LINE S' & !!stringRoundUpValue($!!DrawingPlan1.minN * -1, !format)
									endif
								endif
							else
								if !dir.eq('right') then
									if !!DrawingPlan1.maxE.gt(0) then
										!tempt = 'MATCH LINE E' & !!stringRoundUpValue($!!DrawingPlan1.maxE, !format) & ' SEE ' & !sortedtypes[!i].split('!').getindexed(5)
									else
										!tempt = 'MATCH LINE W' & !!stringRoundUpValue($!!DrawingPlan1.maxE * -1, !format) & ' SEE ' & !sortedtypes[!i].split('!').getindexed(5)
									endif
								elseif !dir.eq('left') then
									if !!DrawingPlan1.minE.gt(0) then
										!tempt = 'MATCH LINE E' & !!stringRoundUpValue($!!DrawingPlan1.minE, !format) & ' SEE ' & !sortedtypes[!i].split('!').getindexed(5)
									else
										!tempt = 'MATCH LINE W' & !!stringRoundUpValue($!!DrawingPlan1.minE * -1, !format) & ' SEE ' & !sortedtypes[!i].split('!').getindexed(5)
									endif
								elseif !dir.eq('up') then
									if !!DrawingPlan1.maxN.gt(0) then
										!tempt = 'MATCH LINE N' & !!stringRoundUpValue($!!DrawingPlan1.maxN, !format) & ' SEE ' & !sortedtypes[!i].split('!').getindexed(5)
									else
										!tempt = 'MATCH LINE S' & !!stringRoundUpValue($!!DrawingPlan1.maxN * -1, !format) & ' SEE ' & !sortedtypes[!i].split('!').getindexed(5)
									endif
								elseif !dir.eq('down') then
									if !!DrawingPlan1.minN.gt(0) then
										!tempt = 'MATCH LINE N' & !!stringRoundUpValue($!!DrawingPlan1.minN, !format) & ' SEE ' & !sortedtypes[!i].split('!').getindexed(5)
									else
										!tempt = 'MATCH LINE S' & !!stringRoundUpValue($!!DrawingPlan1.minN * -1, !format) & ' SEE ' & !sortedtypes[!i].split('!').getindexed(5)
									endif
								endif
							endif
						else
							-------------------
							-- !rcode = left --
							-------------------
							if !sortedtypes[!i].split('!').getindexed(5).eqnocase('') then
								if !dir.eq('right') then
									if !!DrawingPlan1.minN.gt(0) then
										!tempt = 'MATCH LINE N' & !!stringRoundUpValue($!!DrawingPlan1.minN, !format)
									else
										!tempt = 'MATCH LINE S' & !!stringRoundUpValue($!!DrawingPlan1.minN * -1, !format)
									endif
								elseif !dir.eq('left') then
									if !!DrawingPlan1.maxN.gt(0) then
										!tempt = 'MATCH LINE N' & !!stringRoundUpValue($!!DrawingPlan1.maxN, !format)
									else
										!tempt = 'MATCH LINE S' & !!stringRoundUpValue($!!DrawingPlan1.maxN * -1, !format)
									endif
								elseif !dir.eq('up') then
									if !!DrawingPlan1.maxE.gt(0) then
										!tempt = 'MATCH LINE E' & !!stringRoundUpValue($!!DrawingPlan1.maxE, !format)
									else
										!tempt = 'MATCH LINE W' & !!stringRoundUpValue($!!DrawingPlan1.maxE * -1, !format)
									endif
								elseif !dir.eq('down') then
									if !!DrawingPlan1.minE.gt(0) then
										!tempt = 'MATCH LINE E' & !!stringRoundUpValue($!!DrawingPlan1.minE, !format)
									else
										!tempt = 'MATCH LINE W' & !!stringRoundUpValue($!!DrawingPlan1.minE * -1, !format)
									endif
								endif
							else
								if !dir.eq('right') then
									if !!DrawingPlan1.minN.gt(0) then
										!tempt = 'MATCH LINE N' & !!stringRoundUpValue($!!DrawingPlan1.minN, !format) & ' SEE ' & !sortedtypes[!i].split('!').getindexed(5)
									else
										!tempt = 'MATCH LINE S' & !!stringRoundUpValue($!!DrawingPlan1.minN * -1, !format) & ' SEE ' & !sortedtypes[!i].split('!').getindexed(5)
									endif
								elseif !dir.eq('left') then
									if !!DrawingPlan1.maxN.gt(0) then
										!tempt = 'MATCH LINE N' & !!stringRoundUpValue($!!DrawingPlan1.maxN, !format) & ' SEE ' & !sortedtypes[!i].split('!').getindexed(5)
									else
										!tempt = 'MATCH LINE S' & !!stringRoundUpValue($!!DrawingPlan1.maxN * -1, !format) & ' SEE ' & !sortedtypes[!i].split('!').getindexed(5)
									endif
								elseif !dir.eq('up') then
									if !!DrawingPlan1.maxE.gt(0) then
										!tempt = 'MATCH LINE E' & !!stringRoundUpValue($!!DrawingPlan1.maxE, !format) & ' SEE ' & !sortedtypes[!i].split('!').getindexed(5)
									else
										!tempt = 'MATCH LINE W' & !!stringRoundUpValue($!!DrawingPlan1.maxE * -1, !format) & ' SEE ' & !sortedtypes[!i].split('!').getindexed(5)
									endif
								elseif !dir.eq('down') then
									if !!DrawingPlan1.minE.gt(0) then
										!tempt = 'MATCH LINE E' & !!stringRoundUpValue($!!DrawingPlan1.minE, !format) & ' SEE ' & !sortedtypes[!i].split('!').getindexed(5)
									else
										!tempt = 'MATCH LINE W' & !!stringRoundUpValue($!!DrawingPlan1.minE * -1, !format) & ' SEE ' & !sortedtypes[!i].split('!').getindexed(5)
									endif
								endif
							endif
						endif
					elseif not(!sortedtypes[!i].split('!').getindexed(5).eqnocase('')) then
						!tempt = 'MATCH LINE SEE ' & !sortedtypes[!i].split('!').getindexed(5)
					endif
				else
					if not(!sortedtypes[!i].split('!').getindexed(5).eqnocase('')) then
						!tempt = 'SEE ' & !sortedtypes[!i].split('!').getindexed(5)
					endif
				endif
				if (!dir.eq('right') or !dir.eq('left')) and not(!tempt.eqnocase('')) then
					if !dir.eq('right') then							
						!posx = !!DrawingPlan1.boxURsh.part(2).real() + 1
					else
						!posx = !!DrawingPlan1.boxULsh.part(2).real() - 1
					endif
					!posy = !sortedtypes[!i].split('!').getindexed(4).real() + (!sortedtypes[!i + 1].split('!').getindexed(4).real() - !sortedtypes[!i].split('!').getindexed(4).real()) * 0.5
					------------------------------------------------------------
					-- the ALIG lines below act on whatever was just created,  --
					-- so they have to sit inside the same guard: skipping the --
					-- NEW but still running the ALIG would re-align whichever --
					-- element CE happened to be left on                       --
					------------------------------------------------------------
					!mlsig = 'T~' & !posx.string() & '~' & !posy.string() & '~' & !tempt
					!mlref = !!DrawingPlan1MatchClaimRef(!mlsig)
					if (!mlref.eq('')) then
						new texp btext |$!tempt| origin x $!posx y $!posy adegrees 90 cheitx |$!!DrawingPlan1.dwgnohei.val| just center txcolour yellow font 1
						if !dir.eq('right') then
							alig tbody
						else
							alig bbody
						endif
					else
						---------------------------------------------------------
						-- same reuse-must-move rule as the ticks/border above: --
						-- this text's content is often box-size-independent    --
						-- ("MATCH LINE SEE DWGNO-005", no coordinate in it),   --
						-- so an exact-content match can keep succeeding run    --
						-- after run while the box moves under it -- move the  --
						-- reused text onto this run's position every time      --
						---------------------------------------------------------
						$!mlref
						handle any
						endhandle
						ORIG X $!posx Y $!posy
						handle any
						endhandle
					endif
				elseif (!dir.eq('up') or !dir.eq('down')) and not(!tempt.eqnocase('')) then
					!posx = !sortedtypes[!i].split('!').getindexed(3).real() + (!sortedtypes[!i + 1].split('!').getindexed(3).real() - !sortedtypes[!i].split('!').getindexed(3).real()) * 0.5
					if !dir.eq('up') then
						!posy = !!DrawingPlan1.boxURsh.part(4).real() + 1
					else
					!posy = !!DrawingPlan1.boxLRsh.part(4).real() - 1
					endif
					!mlsig = 'T~' & !posx.string() & '~' & !posy.string() & '~' & !tempt
					!mlref = !!DrawingPlan1MatchClaimRef(!mlsig)
					if (!mlref.eq('')) then
						new texp btext |$!tempt| origin x $!posx y $!posy adegrees 0 cheitx |$!!DrawingPlan1.dwgnohei.val| just center txcolour yellow font 1
						if !dir.eq('up') then
							alig bbody
						else
							alig tbody
						endif
					else
						-- reuse-must-move, same reasoning as the right/left branch above --
						$!mlref
						handle any
						endhandle
						ORIG X $!posx Y $!posy
						handle any
						endhandle
					endif
				endif
			endif
--			$p $!sortedtypes[$!i]
		enddo
	else
		!tempt = ''
		if !viewdir.direction().eq(object direction('E')) or !viewdir.direction().eq(object direction('W')) or !viewdir.direction().eq(object direction('N')) or !viewdir.direction().eq(object direction('S')) then
			if !rcode.eqnocase('up') then
				if !dir.eq('right') then
					if !!DrawingPlan1.minE.gt(0) then
						!tempt = 'MATCH LINE E' & !!stringRoundUpValue($!!DrawingPlan1.maxE, !format)
					else
						!tempt = 'MATCH LINE W' & !!stringRoundUpValue($!!DrawingPlan1.maxE * -1, !format)
					endif
				elseif !dir.eq('left') then
					if !!DrawingPlan1.maxE.gt(0) then
						!tempt = 'MATCH LINE E' & !!stringRoundUpValue($!!DrawingPlan1.minE, !format)
					else
						!tempt = 'MATCH LINE W' & !!stringRoundUpValue($!!DrawingPlan1.minE * -1, !format)
					endif
				elseif !dir.eq('up') then
					if !!DrawingPlan1.maxN.gt(0) then
						!tempt = 'MATCH LINE N' & !!stringRoundUpValue($!!DrawingPlan1.maxN, !format)
					else
						!tempt = 'MATCH LINE S' & !!stringRoundUpValue($!!DrawingPlan1.maxN * -1, !format)
					endif
				elseif !dir.eq('down') then
					if !!DrawingPlan1.minN.gt(0) then
						!tempt = 'MATCH LINE N' & !!stringRoundUpValue($!!DrawingPlan1.minN, !format)
					else
						!tempt = 'MATCH LINE S' & !!stringRoundUpValue($!!DrawingPlan1.minN * -1, !format)
					endif
				endif
			else
				-------------------
				-- !rcode = left --
				-------------------
				if !dir.eq('right') then
					if !!DrawingPlan1.minN.gt(0) then
						!tempt = 'MATCH LINE N' & !!stringRoundUpValue($!!DrawingPlan1.minN, !format)
					else
						!tempt = 'MATCH LINE S' & !!stringRoundUpValue($!!DrawingPlan1.minN * -1, !format)
					endif
				elseif !dir.eq('left') then
					if !!DrawingPlan1.maxN.gt(0) then
						!tempt = 'MATCH LINE N' & !!stringRoundUpValue($!!DrawingPlan1.maxN, !format)
					else
						!tempt = 'MATCH LINE S' & !!stringRoundUpValue($!!DrawingPlan1.maxN * -1, !format)
					endif
				elseif !dir.eq('up') then
					if !!DrawingPlan1.maxE.gt(0) then
						!tempt = 'MATCH LINE E' & !!stringRoundUpValue($!!DrawingPlan1.maxE, !format)
					else
						!tempt = 'MATCH LINE W' & !!stringRoundUpValue($!!DrawingPlan1.maxE * -1, !format)
					endif
				elseif !dir.eq('down') then
					if !!DrawingPlan1.minE.gt(0) then
						!tempt = 'MATCH LINE E' & !!stringRoundUpValue($!!DrawingPlan1.minE, !format)
					else
						!tempt = 'MATCH LINE W' & !!stringRoundUpValue($!!DrawingPlan1.minE * -1, !format)
					endif
				endif
			endif
		endif
		if not(!tempt.eqnocase('')) then
			------------------------------------------------------------
			-- the position is worked out first, on its own, so that   --
			-- the "is one already standing here" question can be      --
			-- asked once for all four sides instead of four times     --
			------------------------------------------------------------
			if !dir.eq('right') then
				!posx = !!DrawingPlan1.boxURsh.part(2).real() + 1
				!posy = !!DrawingPlan1.boxLRsh.part(4).real() + (!!DrawingPlan1.boxURsh.part(4).real() - !!DrawingPlan1.boxLRsh.part(4).real()) * 0.5
			elseif !dir.eq('left') then
				!posx = !!DrawingPlan1.boxULsh.part(2).real() - 1
				!posy = !!DrawingPlan1.boxLRsh.part(4).real() + (!!DrawingPlan1.boxURsh.part(4).real() - !!DrawingPlan1.boxLRsh.part(4).real()) * 0.5
			elseif !dir.eq('up') then
				!posx = !!DrawingPlan1.boxULsh.part(2).real() + (!!DrawingPlan1.boxURsh.part(2).real() - !!DrawingPlan1.boxULsh.part(2).real()) * 0.5
				!posy = !!DrawingPlan1.boxURsh.part(4).real() + 1
			elseif !dir.eq('down') then
				!posx = !!DrawingPlan1.boxULsh.part(2).real() + (!!DrawingPlan1.boxURsh.part(2).real() - !!DrawingPlan1.boxULsh.part(2).real()) * 0.5
				!posy = !!DrawingPlan1.boxLRsh.part(4).real() - 1
			endif
			!mlsig = 'T~' & !posx.string() & '~' & !posy.string() & '~' & !tempt
			!mlref = !!DrawingPlan1MatchClaimRef(!mlsig)
			if (!mlref.eq('')) then
				if !dir.eq('right') then
					new texp btext |$!tempt| origin x $!posx y $!posy adegrees 90 cheitx |$!!DrawingPlan1.dwgnohei.val| just center alig tbody txcolour yellow font 1
				elseif !dir.eq('left') then
					new texp btext |$!tempt| origin x $!posx y $!posy adegrees 90 cheitx |$!!DrawingPlan1.dwgnohei.val| just center alig bbody txcolour yellow font 1
				elseif !dir.eq('up') then
					new texp btext |$!tempt| origin x $!posx y $!posy adegrees 0 cheitx |$!!DrawingPlan1.dwgnohei.val| alig bbody just center alig bbody txcolour yellow font 1
				elseif !dir.eq('down') then
					new texp btext |$!tempt| origin x $!posx y $!posy adegrees 0 cheitx |$!!DrawingPlan1.dwgnohei.val| alig bbody just center alig tbody txcolour yellow font 1
				endif
			else
				-- reuse-must-move, same reasoning as the multi-count branch above --
				$!mlref
				handle any
				endhandle
				ORIG X $!posx Y $!posy
				handle any
				endhandle
			endif
		endif
	endif
endfunction
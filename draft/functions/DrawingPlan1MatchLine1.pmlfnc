-----------------------------------------
-- Function : Draw match line function --
-- Auther   : tw tseng                 --
-- Date     : 2026/03/11               --
-----------------------------------------
import 'AteSort'
handle any
endhandle
define function !!DrawingPlan1MatchLine1(!dir is string, !projid is string, !equistr is string, !format is format)
	var !viewdir viewdir $!dir
	var !rcode rcode
	var !tempdiru viewdir up
	var !tempdird viewdir down
	var !tempdirl viewdir left
	var !tempdirr viewdir right
	if !dir.eq('right') then
		var !tempp1 enupos of $!!DrawingPlan1.viewURsh
		var !tempp4 enupos of $!!DrawingPlan1.viewLRsh
	elseif !dir.eq('left') then
		var !tempp1 enupos of $!!DrawingPlan1.viewULsh
		var !tempp4 enupos of $!!DrawingPlan1.viewLLsh
	elseif !dir.eq('up') then
		var !tempp1 enupos of $!!DrawingPlan1.viewULsh
		var !tempp4 enupos of $!!DrawingPlan1.viewURsh
	elseif !dir.eq('down') then
		var !tempp1 enupos of $!!DrawingPlan1.viewLLsh
		var !tempp4 enupos of $!!DrawingPlan1.viewLRsh
	endif
	!tempp2 = object position(!tempp1)
	!tempp2.up = !!DrawingPlan1.minU + 50
	if !dir.eq('right') then
		!tempp3 = !tempp2.offset(!tempdirr.direction(), 50).offset(!tempdird.direction(), 50)
	elseif !dir.eq('left') then	
		!tempp3 = !tempp2.offset(!tempdirl.direction(), 50).offset(!tempdird.direction(), 50)
	elseif !dir.eq('up') then	
		!tempp3 = !tempp2.offset(!tempdirr.direction(), 50).offset(!tempdiru.direction(), 50)
	elseif !dir.eq('down') then
		!tempp3 = !tempp2.offset(!tempdirr.direction(), 50).offset(!tempdird.direction(), 50)
	endif
	!tempp5 = object position(!tempp4)
	if !dir.eq('right') then
		!tempp6 = !tempp5.offset(!tempdirr.direction(), 50).offset(!tempdiru.direction(), 50)
	elseif !dir.eq('left') then	
		!tempp6 = !tempp5.offset(!tempdirl.direction(), 50).offset(!tempdiru.direction(), 50)
	elseif !dir.eq('up') then	
		!tempp6 = !tempp5.offset(!tempdirl.direction(), 50).offset(!tempdiru.direction(), 50)
	elseif !dir.eq('down') then
		!tempp6 = !tempp5.offset(!tempdirl.direction(), 50).offset(!tempdird.direction(), 50)
	endif			
	!tempp6.up = !!DrawingPlan1.maxU - 50
	var !boxes coll all box within $!tempp3 to $!tempp6 for /$!projid_DrawingPlanBox exclude /$!equistr
	handle any
		---------------------------
		-- for unnamed equipment --
		---------------------------
		var !boxes coll all box within $!tempp3 to $!tempp6 for /$!projid_DrawingPlanBox exclude $!equistr
	endhandle						
	!chks = object array()
	do !box values !boxes
		-------------------------------------------------------
		-- get ppoints which direction equal viewdir up/down --
		-------------------------------------------------------
		var !isnamed isnamed of equi of $!box
		if !isnamed.boolean() then
			var !tempe namn of equi of $!box
		else
			!tempe = ''
		endif
		do !j from 1 to 6
			var !boxp$!j (p$!j dir of $!box wrt worl)
			!boxpd$!j = object direction(!boxp$!j)
			!chkpt = false
			if (!dir.eq('right') or !dir.eq('left')) and (!tempdiru.direction().eq(!boxpd$!j) or !tempdird.direction().eq(!boxpd$!j)) then
				!chkpt = true
			elseif (!dir.eq('up') or !dir.eq('down')) and (!tempdirl.direction().eq(!boxpd$!j) or !tempdirr.direction().eq(!boxpd$!j)) then
				!chkpt = true
			endif
			if !chkpt then
				var !chk (p$!j pos of $!box wrt worl)
				var !chksh shpos of $!chk
				if !dir.eq('right') or !dir.eq('left') then
					if !chksh.part(4).replace('mm', '').real().geq(!!DrawingPlan1.viewURsh.part(4).real() - 5 ) then
						!chks.append(!box & '!' & !chksh.part(2).replace('mm', '') & '!' & !!DrawingPlan1.viewURsh.part(4) & '!' & !tempe & '!' & !j)
					elseif !chksh.part(4).replace('mm', '').real().leq(!!DrawingPlan1.viewLRsh.part(4).real() + 5 ) then
						!chks.append(!box & '!' & !chksh.part(2).replace('mm', '') & '!' & !!DrawingPlan1.viewLRsh.part(4) & '!' & !tempe & '!' & !j)
					else
						!chks.append(!box & '!' & !chksh.part(2).replace('mm', '') & '!' & !chksh.part(4).replace('mm', '') & '!' & !tempe & '!' & !j)
					endif
				elseif !dir.eq('up') or !dir.eq('down') then
					if !chksh.part(2).replace('mm', '').real().geq(!!DrawingPlan1.viewURsh.part(2).real() - 5 ) then
						!chks.append(!box & '!' & !!DrawingPlan1.viewURsh.part(2) & '!' & !chksh.part(4).replace('mm', '') & '!' & !tempe & '!' & !j)
					elseif !chksh.part(2).replace('mm', '').real().leq(!!DrawingPlan1.viewULsh.part(2).real() + 5 ) then
						!chks.append(!box & '!' & !!DrawingPlan1.viewULsh.part(2) & '!' & !chksh.part(4).replace('mm', '') & '!' & !tempe & '!' & !j)
					else
						!chks.append(!box & '!' & !chksh.part(2).replace('mm', '') & '!' & !chksh.part(4).replace('mm', '') & '!' & !tempe & '!' & !j)
					endif
				endif
			endif
		enddo
	enddo
	note 1
	if !chks.size().gt(0) then
		!exists = object array()
		using namespace 'Aveva.Core.Samples'
		!obj = object AteSort()
		---------------------------------------------------------------
		-- AteSort argument2 indicates                               --
		--   true  = sort by field1 + field2 (ref of box + x coord.) --
		--   false = sort by field1 + field3 (ref of box + y coord.) --
		---------------------------------------------------------------
		if !dir.eq('right') or !dir.eq('left') then
			!sortedtypes = !obj.method1(!chks, false)
		elseif !dir.eq('up') or !dir.eq('down') then
			!sortedtypes = !obj.method1(!chks, true)
		endif
		do !i from 1 to !sortedtypes.size()
			if !i.modulo(2).eq(1) then
				!tempt = ''
				if !i.eq(1) then
					---------------------------
					-- the maximun distance  --
					-- write all information --
					---------------------------
					if !viewdir.direction().eq(object direction('E')) or !viewdir.direction().eq(object direction('W')) or !viewdir.direction().eq(object direction('N')) or !viewdir.direction().eq(object direction('S')) then
						if !rcode.eqnocase('up') then
							if !sortedtypes[!i].split('!').getindexed(5).eqnocase('') then
								if !dir.eq('right') then
									if !!DrawingPlan1.maxE.gt(0) then
										!tempt = 'MATCH LINE E' & !!stringRoundUpValue($!!DrawingPlan1.maxE, !format)
									else
										!tempt = 'MATCH LINE W' & !!stringRoundUpValue($!!DrawingPlan1.maxE * -1, !format)
									endif
								elseif !dir.eq('left') then
									if !!DrawingPlan1.minE.gt(0) then
										!tempt = 'MATCH LINE E' & !!stringRoundUpValue($!!DrawingPlan1.minE, !format)
									else
										!tempt = 'MATCH LINE W' & !!stringRoundUpValue($!!DrawingPlan1.minE * -1, !format)
									endif
								elseif !dir.eq('up') then
									if !!DrawingPlan1.maxN.gt(0) then
										!tempt = 'MATCH LINE N' & !!stringRoundUpValue($!!DrawingPlan1.maxN, !format)
									else
										!tempt = 'MATCH LINE S' & !!stringRoundUpValue($!!DrawingPlan1.maxN * -1, !format)
									endif
								elseif !dir.eq('down') then
									if !!DrawingPlan1.minN.gt(0) then
										!tempt = 'MATCH LINE N' & !!stringRoundUpValue($!!DrawingPlan1.minN, !format)
									else
										!tempt = 'MATCH LINE S' & !!stringRoundUpValue($!!DrawingPlan1.minN * -1, !format)
									endif
								endif
							else
								if !dir.eq('right') then
									if !!DrawingPlan1.maxE.gt(0) then
										!tempt = 'MATCH LINE E' & !!stringRoundUpValue($!!DrawingPlan1.maxE, !format) & ' SEE ' & !sortedtypes[!i].split('!').getindexed(5)
									else
										!tempt = 'MATCH LINE W' & !!stringRoundUpValue($!!DrawingPlan1.maxE * -1, !format) & ' SEE ' & !sortedtypes[!i].split('!').getindexed(5)
									endif
								elseif !dir.eq('left') then
									if !!DrawingPlan1.minE.gt(0) then
										!tempt = 'MATCH LINE E' & !!stringRoundUpValue($!!DrawingPlan1.minE, !format) & ' SEE ' & !sortedtypes[!i].split('!').getindexed(5)
									else
										!tempt = 'MATCH LINE W' & !!stringRoundUpValue($!!DrawingPlan1.minE * -1, !format) & ' SEE ' & !sortedtypes[!i].split('!').getindexed(5)
									endif
								elseif !dir.eq('up') then
									if !!DrawingPlan1.maxN.gt(0) then
										!tempt = 'MATCH LINE N' & !!stringRoundUpValue($!!DrawingPlan1.maxN, !format) & ' SEE ' & !sortedtypes[!i].split('!').getindexed(5)
									else
										!tempt = 'MATCH LINE S' & !!stringRoundUpValue($!!DrawingPlan1.maxN * -1, !format) & ' SEE ' & !sortedtypes[!i].split('!').getindexed(5)
									endif
								elseif !dir.eq('down') then
									if !!DrawingPlan1.minN.gt(0) then
										!tempt = 'MATCH LINE N' & !!stringRoundUpValue($!!DrawingPlan1.minN, !format) & ' SEE ' & !sortedtypes[!i].split('!').getindexed(5)
									else
										!tempt = 'MATCH LINE S' & !!stringRoundUpValue($!!DrawingPlan1.minN * -1, !format) & ' SEE ' & !sortedtypes[!i].split('!').getindexed(5)
									endif
								endif
							endif
						else
							-------------------
							-- !rcode = left --
							-------------------
							if !sortedtypes[!i].split('!').getindexed(5).eqnocase('') then
								if !dir.eq('right') then
									if !!DrawingPlan1.minN.gt(0) then
										!tempt = 'MATCH LINE N' & !!stringRoundUpValue($!!DrawingPlan1.minN, !format)
									else
										!tempt = 'MATCH LINE S' & !!stringRoundUpValue($!!DrawingPlan1.minN * -1, !format)
									endif
								elseif !dir.eq('left') then
									if !!DrawingPlan1.maxN.gt(0) then
										!tempt = 'MATCH LINE N' & !!stringRoundUpValue($!!DrawingPlan1.maxN, !format)
									else
										!tempt = 'MATCH LINE S' & !!stringRoundUpValue($!!DrawingPlan1.maxN * -1, !format)
									endif
								elseif !dir.eq('up') then
									if !!DrawingPlan1.maxE.gt(0) then
										!tempt = 'MATCH LINE E' & !!stringRoundUpValue($!!DrawingPlan1.maxE, !format)
									else
										!tempt = 'MATCH LINE W' & !!stringRoundUpValue($!!DrawingPlan1.maxE * -1, !format)
									endif
								elseif !dir.eq('down') then
									if !!DrawingPlan1.minE.gt(0) then
										!tempt = 'MATCH LINE E' & !!stringRoundUpValue($!!DrawingPlan1.minE, !format)
									else
										!tempt = 'MATCH LINE W' & !!stringRoundUpValue($!!DrawingPlan1.minE * -1, !format)
									endif
								endif
							else
								if !dir.eq('right') then
									if !!DrawingPlan1.minN.gt(0) then
										!tempt = 'MATCH LINE N' & !!stringRoundUpValue($!!DrawingPlan1.minN, !format) & ' SEE ' & !sortedtypes[!i].split('!').getindexed(5)
									else
										!tempt = 'MATCH LINE S' & !!stringRoundUpValue($!!DrawingPlan1.minN * -1, !format) & ' SEE ' & !sortedtypes[!i].split('!').getindexed(5)
									endif
								elseif !dir.eq('left') then
									if !!DrawingPlan1.maxN.gt(0) then
										!tempt = 'MATCH LINE N' & !!stringRoundUpValue($!!DrawingPlan1.maxN, !format) & ' SEE ' & !sortedtypes[!i].split('!').getindexed(5)
									else
										!tempt = 'MATCH LINE S' & !!stringRoundUpValue($!!DrawingPlan1.maxN * -1, !format) & ' SEE ' & !sortedtypes[!i].split('!').getindexed(5)
									endif
								elseif !dir.eq('up') then
									if !!DrawingPlan1.maxE.gt(0) then
										!tempt = 'MATCH LINE E' & !!stringRoundUpValue($!!DrawingPlan1.maxE, !format) & ' SEE ' & !sortedtypes[!i].split('!').getindexed(5)
									else
										!tempt = 'MATCH LINE W' & !!stringRoundUpValue($!!DrawingPlan1.maxE * -1, !format) & ' SEE ' & !sortedtypes[!i].split('!').getindexed(5)
									endif
								elseif !dir.eq('down') then
									if !!DrawingPlan1.minE.gt(0) then
										!tempt = 'MATCH LINE E' & !!stringRoundUpValue($!!DrawingPlan1.minE, !format) & ' SEE ' & !sortedtypes[!i].split('!').getindexed(5)
									else
										!tempt = 'MATCH LINE W' & !!stringRoundUpValue($!!DrawingPlan1.minE * -1, !format) & ' SEE ' & !sortedtypes[!i].split('!').getindexed(5)
									endif
								endif
							endif
						endif
					elseif not(!sortedtypes[!i].split('!').getindexed(5).eqnocase('')) then
						!tempt = 'MATCH LINE SEE ' & !sortedtypes[!i].split('!').getindexed(5)
					endif
				else
					if not(!sortedtypes[!i].split('!').getindexed(5).eqnocase('')) then
						!tempt = 'SEE ' & !sortedtypes[!i].split('!').getindexed(5)
					endif
				endif
				if (!dir.eq('right') or !dir.eq('left')) and not(!tempt.eqnocase('')) then
					if !dir.eq('right') then							
						!posx = !!DrawingPlan1.viewURsh.part(2).real() + 1
					else
						!posx = !!DrawingPlan1.viewULsh.part(2).real() - 1
					endif
					!posy = !sortedtypes[!i].split('!').getindexed(4).real() + (!sortedtypes[!i + 1].split('!').getindexed(4).real() - !sortedtypes[!i].split('!').getindexed(4).real()) * 0.5
						new texp btext |$!tempt| origin x $!posx y $!posy adegrees 90 cheitx |$!!DrawingPlan1.dwgnohei.val| just center txcolour yellow font 1
					if !dir.eq('right') then
						alig tbody
					else
						alig bbody
					endif
				elseif (!dir.eq('up') or !dir.eq('down')) and not(!tempt.eqnocase('')) then
					!posx = !sortedtypes[!i].split('!').getindexed(3).real() + (!sortedtypes[!i + 1].split('!').getindexed(3).real() - !sortedtypes[!i].split('!').getindexed(3).real()) * 0.5
					if !dir.eq('up') then
						!posy = !!DrawingPlan1.viewURsh.part(4).real() + 1
					else
					!posy = !!DrawingPlan1.viewLRsh.part(4).real() - 1
					endif
					new texp btext |$!tempt| origin x $!posx y $!posy adegrees 0 cheitx |$!!DrawingPlan1.dwgnohei.val| just center txcolour yellow font 1
					if !dir.eq('up') then
						alig bbody
					else
						alig tbody
					endif
				endif
			endif
			------------------------------------------------------------------
			-- to draw a match line if position is not on the border corner --
			------------------------------------------------------------------
			!exist = false
			-----------------------------------------
			-- check if the match line is existing --
			-----------------------------------------
			if !dir.eq('right') or !dir.eq('left') then
				if not( abs(!sortedtypes[!i].split('!').getindexed(4).real() - !!DrawingPlan1.viewURsh.part(4).real()) leq 5 or abs(!sortedtypes[!i].split('!').getindexed(4).real() - !!DrawingPlan1.viewLRsh.part(4).real()) leq 5) then
					do !j from 1 to !exists.size()
						if abs(!exists[!j].real() - !sortedtypes[!i].split('!').getindexed(4).real()) leq 5 then
							!exist = true
						endif
					enddo
				else
					!exist = true
				endif
			else
				if not( abs(!sortedtypes[!i].split('!').getindexed(3).real() - !!DrawingPlan1.viewULsh.part(2).real()) leq 5 or abs(!sortedtypes[!i].split('!').getindexed(3).real() - !!DrawingPlan1.viewURsh.part(2).real()) leq 5) then
					do !j from 1 to !exists.size()
						if abs(!exists[!j].real() - !sortedtypes[!i].split('!').getindexed(3).real()) leq 5 then
							!exist = true
						endif
					enddo
				else
					!exist = true
				endif
			endif
			if not(!exist) then
				if !dir.eq('right') or !dir.eq('left') then
					!exists.append(!sortedtypes[!i].split('!').getindexed(4))
					!newy = !sortedtypes[!i].split('!').getindexed(4)
					if !dir.eq('right') then
						!newx = !!DrawingPlan1.viewURsh.part(2)
						new stra fpt x $!newx y $!newy length 10 adegrees 0 NLStyle DChainedThick  NLColour Magenta
					else
						!newx = !!DrawingPlan1.viewULsh.part(2)
						new stra fpt x $!newx y $!newy length 10 adegrees 180 NLStyle DChainedThick  NLColour Magenta
					endif
				else
					!exists.append(!sortedtypes[!i].split('!').getindexed(3))
					!newx = !sortedtypes[!i].split('!').getindexed(3)
					if !dir.eq('up') then
						!newy = !!DrawingPlan1.viewURsh.part(4)
						new stra fpt x $!newx y $!newy length 10 adegrees 90 NLStyle DChainedThick  NLColour Magenta						
					else
						!newy = !!DrawingPlan1.viewLRsh.part(4)
						new stra fpt x $!newx y $!newy length 10 adegrees -90 NLStyle DChainedThick  NLColour Magenta	
					endif
				endif
			endif
--			$p $!sortedtypes[$!i]
		enddo
	else
		!tempt = ''
		if !viewdir.direction().eq(object direction('E')) or !viewdir.direction().eq(object direction('W')) or !viewdir.direction().eq(object direction('N')) or !viewdir.direction().eq(object direction('S')) then
			if !rcode.eqnocase('up') then
				if !dir.eq('right') then
					if !!DrawingPlan1.minE.gt(0) then
						!tempt = 'MATCH LINE E' & !!stringRoundUpValue($!!DrawingPlan1.maxE, !format)
					else
						!tempt = 'MATCH LINE W' & !!stringRoundUpValue($!!DrawingPlan1.maxE * -1, !format)
					endif
				elseif !dir.eq('left') then
					if !!DrawingPlan1.maxE.gt(0) then
						!tempt = 'MATCH LINE E' & !!stringRoundUpValue($!!DrawingPlan1.minE, !format)
					else
						!tempt = 'MATCH LINE W' & !!stringRoundUpValue($!!DrawingPlan1.minE * -1, !format)
					endif
				elseif !dir.eq('up') then
					if !!DrawingPlan1.maxN.gt(0) then
						!tempt = 'MATCH LINE N' & !!stringRoundUpValue($!!DrawingPlan1.maxN, !format)
					else
						!tempt = 'MATCH LINE S' & !!stringRoundUpValue($!!DrawingPlan1.maxN * -1, !format)
					endif
				elseif !dir.eq('down') then
					if !!DrawingPlan1.minN.gt(0) then
						!tempt = 'MATCH LINE N' & !!stringRoundUpValue($!!DrawingPlan1.minN, !format)
					else
						!tempt = 'MATCH LINE S' & !!stringRoundUpValue($!!DrawingPlan1.minN * -1, !format)
					endif
				endif
			else
				-------------------
				-- !rcode = left --
				-------------------
				if !dir.eq('right') then
					if !!DrawingPlan1.minN.gt(0) then
						!tempt = 'MATCH LINE N' & !!stringRoundUpValue($!!DrawingPlan1.minN, !format)
					else
						!tempt = 'MATCH LINE S' & !!stringRoundUpValue($!!DrawingPlan1.minN * -1, !format)
					endif
				elseif !dir.eq('left') then
					if !!DrawingPlan1.maxN.gt(0) then
						!tempt = 'MATCH LINE N' & !!stringRoundUpValue($!!DrawingPlan1.maxN, !format)
					else
						!tempt = 'MATCH LINE S' & !!stringRoundUpValue($!!DrawingPlan1.maxN * -1, !format)
					endif
				elseif !dir.eq('up') then
					if !!DrawingPlan1.maxE.gt(0) then
						!tempt = 'MATCH LINE E' & !!stringRoundUpValue($!!DrawingPlan1.maxE, !format)
					else
						!tempt = 'MATCH LINE W' & !!stringRoundUpValue($!!DrawingPlan1.maxE * -1, !format)
					endif
				elseif !dir.eq('down') then
					if !!DrawingPlan1.minE.gt(0) then
						!tempt = 'MATCH LINE E' & !!stringRoundUpValue($!!DrawingPlan1.minE, !format)
					else
						!tempt = 'MATCH LINE W' & !!stringRoundUpValue($!!DrawingPlan1.minE * -1, !format)
					endif
				endif
			endif
		endif
		if not(!tempt.eqnocase('')) then
			if !dir.eq('right') then
				!posx = !!DrawingPlan1.viewURsh.part(2).real() + 1
				!posy = !!DrawingPlan1.viewLRsh.part(4).real() + (!!DrawingPlan1.viewURsh.part(4).real() - !!DrawingPlan1.viewLRsh.part(4).real()) * 0.5
				new texp btext |$!tempt| origin x $!posx y $!posy adegrees 90 cheitx |$!!DrawingPlan1.dwgnohei.val| just center alig tbody txcolour yellow font 1
			elseif !dir.eq('left') then
				!posx = !!DrawingPlan1.viewULsh.part(2).real() - 1
				!posy = !!DrawingPlan1.viewLRsh.part(4).real() + (!!DrawingPlan1.viewURsh.part(4).real() - !!DrawingPlan1.viewLRsh.part(4).real()) * 0.5
				new texp btext |$!tempt| origin x $!posx y $!posy adegrees 90 cheitx |$!!DrawingPlan1.dwgnohei.val| just center alig bbody txcolour yellow font 1
			elseif !dir.eq('up') then
				!posx = !!DrawingPlan1.viewULsh.part(2).real() + (!!DrawingPlan1.viewURsh.part(2).real() - !!DrawingPlan1.viewULsh.part(2).real()) * 0.5
				!posy = !!DrawingPlan1.viewURsh.part(4).real() + 1
				new texp btext |$!tempt| origin x $!posx y $!posy adegrees 0 cheitx |$!!DrawingPlan1.dwgnohei.val| alig bbody just center alig bbody txcolour yellow font 1
			elseif !dir.eq('down') then
				!posx = !!DrawingPlan1.viewULsh.part(2).real() + (!!DrawingPlan1.viewURsh.part(2).real() - !!DrawingPlan1.viewULsh.part(2).real()) * 0.5
				!posy = !!DrawingPlan1.viewLRsh.part(4).real() - 1
				new texp btext |$!tempt| origin x $!posx y $!posy adegrees 0 cheitx |$!!DrawingPlan1.dwgnohei.val| alig bbody just center alig tbody txcolour yellow font 1
			endif
		endif
	endif
endfunction
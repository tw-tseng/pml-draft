-------------------------------------------------------------------
-- match line per-element diff, one of five files                 --
-- Date     : 2026-08-28                                          --
--                                                                --
-- the match line's straights and texts carry no DDNA and no      --
-- stable name, so an update cannot find last run's copy of one   --
-- by identity the way the GLABs are found. what they do have is  --
-- geometry that is entirely derived from the view border and the --
-- neighbouring boxes -- so the match is done on that geometry:   --
-- an existing element standing exactly where this run wants one  --
-- IS that one, and is left untouched                             --
--                                                                --
-- the run's state lives in three parallel globals, filled by     --
-- .MatchCollect() and consumed by .MatchClaimRef():              --
--   !!DrawingPlan1MatchCandRefs / ...CandSigs / ...Claims        --
-- globals rather than form members for the usual reason: these   --
-- files are re-read on every call, the form only on kill/show    --
--                                                                --
-- PML finds a function by file name, so each of the five lives   --
-- in its own file: MatchXY / MatchCollect / MatchClaim /         --
-- MatchClaimRef / MatchCleanup                                   --
-------------------------------------------------------------------

-------------------------------------------------------------------
-- the two numbers out of whatever shape 'fpt' / 'tpt' / 'origin' --
-- answer in -- 'X 100mm Y 200mm' and 'x 100 y 200' both reduce   --
-- to the same 'x~y'. anything that will not parse comes back     --
-- empty, which .Claim() treats as "cannot be compared", so the   --
-- element simply does not match and is redrawn rather than the   --
-- run falling over                                               --
-------------------------------------------------------------------
define function !!DrawingPlan1MatchXY(!raw is string) is string
	!xs = ''
	!ys = ''
	!toks = !raw.split()
	handle any
		!toks = object array()
	endhandle
	do !t values !toks
		!tt = !t.replace('mm', '')
		!ok = true
		!r = 0
		!r = !tt.real()
		handle any
			!ok = false
		endhandle
		if (!ok) then
			if (!xs.eq('')) then
				!xs = !r.string()
			elseif (!ys.eq('')) then
				!ys = !r.string()
			endif
		endif
	enddo
	return !xs & '~' & !ys
endfunction

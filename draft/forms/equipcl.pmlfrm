define method .Del()
  prompt off
  prompt load escape |Identify a EQUI Name to Delete|
  var !lab IDENTIFY GLAB @
  handle ANY $* USER cancel
    prompt on
    prompt dismiss
  elsehandle NONE
    $!lab
    var !VIEW (NAME of VIEW )
    var !name NAME of $!lab
    !chk = !VIEW & '/CenL'
    if (!name.matchwild('*$!chk*')) then
      !name1 = !name.before('/CenL')
      $!name1/CenL1
      handle ANY
      elsehandle NONE
        DELETE GLAB
      endhandle
      
      $!name1/CenL2
      handle ANY
      elsehandle NONE
        DELETE GLAB
      endhandle
      
      $!name1/CenL3
      handle ANY
      elsehandle NONE
        DELETE STRA
      endhandle
      
      $!name1/CenL4
      handle ANY
      elsehandle NONE
        DELETE STRA
      endhandle
      
      $!name1/CenL5
      handle ANY
      elsehandle NONE
        DELETE STRA
      endhandle
    endif
    prompt on
    prompt dismiss
  endhandle
endmethod

define method .Close()
  kill !!EQUIPCL
endmethod


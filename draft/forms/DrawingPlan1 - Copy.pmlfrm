layout form !!DrawingPlan1

	!this.formTitle = 'Drawing Options'
	
  toggle .gridorthogonal at xmin ymax+0.2 'Rotate View to Orthogonal Grids'

  toggle .portrait at xmin ymax+0.2 'Portrait to Landscape'
	
	button .apply  'Apply'  at xmin ymax+0.2 width 30 call '!This.Apply()'
	
	button .Cancel 'Cancel' at xmin.apply  ymax.apply + 0.3 width 10 call '!This.Close()'
	
	member .vsca is real

exit

define method .Apply()


  !box = object dbref('/TESTBOX') 
	
	new drwg
	handle any
	  var !type type
	  !!alert.error('cannot create DRWG under ' & $!type)
	elsehandle none
    
	  var !isnamed isnamed of $!box
	  if (!isnamed.boolean()) then
		  var !name name of $!box
		else
		  var !name ref of $!box
		endif
		
    delete drwg
		$!name/SS
		handle any
		  !del = 'none'
		elsehandle none
--		  !del = !!alert.confirm('Overwrite Existing DRWG?')
		  !del = 'YES'
		endhandle
		if (!del eq 'YES') then
		  !order = order
		  delete drwg
			if (!order neq 1) then
			  !order = !order - 1
				$!order
			endif
		endif
		
		if (!del neq 'NO') then
		  new drwg $!name/SS
			size 841 594
			new liby $!name/SS/LIBY
			new pllb $!name/SS/S1/V1/PLANES
			new dllb $!name/SS/DRAWLIST
			new idli $!name/SS/DRAWLIST/DRWG
			
			--------------------------
			-- calculate box limits --
			--------------------------
			
			$!box
			var !boxPos worpos
			var !boxXlen xlength
			var !boxYlen ylength
			var !boxZlen zlength
      var !ori ori wrt worl
      !boxXdir = !ori.orientation().xdir()
      !boxYdir = !ori.orientation().ydir()
			
			$!name/SS/DRAWLIST/DRWG
			
 			!maxE = !boxPos.position().offset(!boxXdir, !boxXlen.real() * 0.5).east
			!minE = !boxPos.position().offset(!boxXdir.opposite(), !boxXlen.real() * 0.5).east
			!maxN = !boxPos.position().offset(!boxYdir, !boxYlen.real() * 0.5).north
			!minN = !boxPos.position().offset(!boxYdir.opposite(), !boxYlen.real() * 0.5).north
			!maxU = !boxPos.position().offset(object direction('U'), !boxZlen.real() * 0.5).up
			!minU = !boxPos.position().offset(object direction('D'), !boxZlen.real() * 0.5).up

$(
			!maxE = !boxPos.position().offset(object direction('E'), !boxXlen.real() * 0.5).east
			!minE = !boxPos.position().offset(object direction('W'), !boxXlen.real() * 0.5).east
			!maxN = !boxPos.position().offset(object direction('N'), !boxYlen.real() * 0.5).north
			!minN = !boxPos.position().offset(object direction('S'), !boxYlen.real() * 0.5).north
			!maxU = !boxPos.position().offset(object direction('U'), !boxZlen.real() * 0.5).up
			!minU = !boxPos.position().offset(object direction('D'), !boxZlen.real() * 0.5).up
$)
			
			limits E $!minE N $!minN U $!minU TO E $!maxE N $!maxN U $!maxU
			!lim = limits
--			$p $!lim[1] $!lim[2] $!lim[3] $!lim[4] $!lim[5] $!lim[6]
			
			-- add all zone within w314200 n295530 u 100000 to w310540 n301140 u 104376
			add all zone within E $!minE N $!minN U $!minU to E $!maxE N $!maxN U $!maxU
			add all REFGRD within E $!minE N $!minN U $!minU to E $!maxE N $!maxN U $!maxU
      
      
			
			!thpoE = !boxPos.position().east
			!thpoN = !boxPos.position().north
			!thpoU = !boxPos.position().up
			
			$!name/SS/S1/V1/PLANES
			
			new fpla $!name/SS/S1/V1/TOUP
			position E $!thpoE N $!thpoN U $!maxU
			norm D
			end
			new fpla $!name/SS/S1/V1/TONP
			position E $!thpoE N $!maxN U $!thpoU
			norm S
			end
			new fpla $!name/SS/S1/V1/TOEP
			position E $!maxE N $!thpoN U $!thpoU
			norm W
			end
			new fpla $!name/SS/S1/V1/FRUP
			position E $!thpoE N $!thpoN U $!minU
			norm U
			end
			new fpla $!name/SS/S1/V1/FRNP
			position E $!thpoE N $!minN U $!thpoU
			norm N
			end
			new fpla $!name/SS/S1/V1/FREP
			position E $!minE N $!thpoN U $!thpoU
			norm E
			end
			
			new shee $!name/SS/S1
			IDLN $!name/SS/DRAWLIST/DRWG
      bsrf /TT/DRA/PRJ/BACKS/MET/BLACKA1
			new view $!name/SS/S1/V1
			thposition E $!thpoE N $!thpoN U $!thpoU
			Direction D
			Onposition 0mm 0mm
			Arctolerance 15
			Vtype Global HLine
			Idlname $!name/SS/DRAWLIST/DRWG
      
      
--      Adegrees 12
			
			------------------------------------------
			-- reprensetation rules and hatch rules --
			------------------------------------------
			rrsf /TT/DRA/PRJ/REPRW/GEN/ALL
			hrsf /TT/DRA/PRJ/HRUL/PIPE/Hatch-Gen
			
			Crsf Nulref
      Agmode 'OFF'
			
			-----------------------------------------
			-- for A1 border,                      --
			-- the max. view size is 500mm x 400mm --
			-----------------------------------------
			if (!boxXlen.real() gt !boxYlen.real()) then
			  !ratio = !boxXlen.real() / 500
			else
			  !ratio = !boxYlen.real() / 400
			endif
--      $p $!ratio
			$(
			--------------------------
			-- redundant view scale --
			--------------------------
			if (!ratio le 1) then
			  !this.vsca = 1
			elseif (!ratio le 2) then
			  !this.vsca = 0.5
			elseif (!ratio le 3) then
			  !this.vsca = 0.33333333
			elseif (!ratio le 5) then
			  !this.vsca = 0.25
			elseif (!ratio le 10) then
			  !this.vsca = 0.1
			elseif (!ratio le 20) then
			  !this.vsca = 0.05
			elseif (!ratio le 25) then
			  !this.vsca = 0.04
			$)	
			if (!ratio le 33) then
			  !this.vsca = 0.03333333
			elseif (!ratio le 50) then
			  !this.vsca = 0.02
			elseif (!ratio le 100) then
			  !this.vsca = 0.01
			elseif (!ratio le 150) then
			  !this.vsca = 0.00666666
			elseif (!ratio le 200) then
			  !this.vsca = 0.005
			elseif (!ratio le 250) then
			  !this.vsca = 0.004
			elseif (!ratio le 500) then
			  !this.vsca = 0.002
			elseif (!ratio le 750) then
			  !this.vsca = 0.00133333
			elseif (!ratio le 1000) then
			  !this.vsca = 0.001
			elseif (!ratio le 1500) then
			  !this.vsca = 0.00066666
			elseif (!ratio le 2000) then
			  !this.vsca = 0.0005
			elseif (!ratio le 2500) then
			  !this.vsca = 0.0004
			elseif (!ratio le 3000) then
			  !this.vsca = 0.00033333
			elseif (!ratio le 3500) then
			  !this.vsca = 0.00028571
			elseif (!ratio le 4000) then
			  !this.vsca = 0.00025
			elseif (!ratio le 5000) then
			  !this.vsca = 0.0002
			elseif (!ratio le 10000) then
			  !this.vsca = 0.0001
			endif
			
			!sizeX = !boxXlen.real() * !this.vsca
			!sizeY = !boxYlen.real() * !this.vsca
			size $!sizeX $!sizeY
			
			--------------------------------------
			-- assume center of view is 340,320 --
			--------------------------------------			
			xyposition X 340 Y 320
			Lframe true
			NLStyle Solid 
			NLColour 147 
			Lvisibility true
			Vgaplength 2mm
			Smode Standard
			
--			:CDLIMITS |FROM E $!minE N $!minN U $!minU TO E $!maxE N $!maxN U $!maxU|
			:CDLIMITS |E $!minE N $!minN U $!minU TO E $!maxE N $!maxN U $!maxU|
			vsca $!this.vsca
			
			new vsec $!name/SS/S1/V1/TOUP/VSEC
			plrf $!name/SS/S1/V1/TOUP
			end
			new vsec $!name/SS/S1/V1/TONP/VSEC
			plrf $!name/SS/S1/V1/TONP
			end
			new vsec $!name/SS/S1/V1/TOEP/VSEC
			plrf $!name/SS/S1/V1/TOEP
			end
			new vsec $!name/SS/S1/V1/FRUP/VSEC
			plrf $!name/SS/S1/V1/FRUP
			end
			new vsec $!name/SS/S1/V1/FRNP/VSEC
			plrf $!name/SS/S1/V1/FRNP
			end
			new vsec $!name/SS/S1/V1/FREP/VSEC
			plrf $!name/SS/S1/V1/FREP
			end
			$!name/SS/S1/V1
			update design
			1
			last
      
      ---------------------
      -- grid annotation --
      ---------------------
			!!DrawingPlan1GridAnnotation(!name, !minE, !minN, !minU, !maxE, !maxN, !maxU)      
      
      ---------------
      -- dimension --
      ---------------
			NEW LAYE $!name/SS/S1/V1/ateDIM
			Purpose DIMA
			Lvisibility true
			Font 1
			Justification Left
			Alignment Template
			Tsiztx '2.5mm'
			Chostx '6mm'
			Asubtended 0degree
			Pjustification Towards 
			Oshttx '2mm'
			Plcltx '0mm'
			Doffset 25mm
			Dmsptx '0mm'
			Lleader true
			Lframe true
			Lshape Straight
			Gboxtx '1mm'
			Llcltx '0mm'
			Xyscale 1 1
			Xyposition 25mm 25mm 
			Blnk false
			Bmargin 0mm
			Trsf Nulref
			Txcolour Yellow 
			NLStyle Solid 
			NLColour Cyan 
			FStyle Off 
			FColour Grey 
			LLStyle Solid 
			LLColour Cyan 
			LFStyle Solid 
			LFColour Cyan 
			DLStyle Solid 
			DLColour Cyan 
			PLStyle Solid 
			PLColour Cyan 
			MColour Cyan 
			CHStyle Off 
			CHColour Grey
      
      var !brans vscan for all bran
      !pipes = object array()
      do !bran values !brans
        var !pipe name of pipe of $!bran
        !pipes.append(!pipe)
      enddo
      !pipes.unique().sort()
--      do !pipe values !pipes
--        $p $!pipe
--      enddo
      
      
      
      
			---------------------------
      -- portrait to landscape --
			---------------------------
      if (!this.portrait.val) then
			  $!name/SS/S1/V1
			  RCODE LEFT
			endif
      
		endif
	endhandle
endmethod

define method .DrawingPlan1()
endmethod

define method .Close()
   kill !!DrawingPlan1
endmethod
--------------------------------------------------
-- Copyright ATOMTECH Ltd 2026                  --
--                                              --
-- Function : Revise (issue) GA drawings        --
-- Author   : Tseng                             --
-- Date     : 2026/09/13                        --
--------------------------------------------------
--
-- Stand-alone revision form. It does not depend on DrawingPlan1 and
-- nothing is passed between the two: DrawingPlan1 draws, this form
-- turns what was drawn into a numbered revision.
--
-- The agreed design is the "revision program (2026-09-13)" toggle on the
-- project's Notion page (E3D pipe-plan program summary, page id
-- 3c8dd89e-3acd-80a7-9a3d-cecae639393f, toggle id
-- 3dadd89e-3acd-8156-8692-cbc39c1a742c) -- read that before changing
-- the rules below. In short:
--
--   * the user builds a list of SHEEs with Add CE / Remove / Remove All.
--     Add CE takes the sheet CE is on or inside, or every sheet below
--     CE when it stands above them (DRWG, REGI, DEPT). Remove drops the
--     row selected in the table, or the sheet CE resolves to when no
--     row is selected. the list IS the work list, no separate tick box
--   * the revision codes and their order come from <PROJID>_REV.txt in
--     the project folder (one level above evar '<projcode>000'). the
--     project owner maintains it, this form never writes it
--   * a REVI only counts as a real revision when BOTH RVSN and STEXT
--     are set. STEXT is written last, so it doubles as the "this one
--     was finished" flag. anything without it is ignored
--   * REVIs are not named. nothing here needs a name, and an unnamed
--     REVI cannot clash on (41,12)
--   * per sheet: old clouds off -> compare -> NEW REVI -> freeze labels
--     -> CreateSnapshot -> Q PICF -> DXF -> new clouds -> STEXT. snapshot
--     and DXF are both the clean picture, clouds live on the sheet only
--     (user decision 2026-09-14). one SAVEWORK before the whole batch,
--     never after -- saving the result is the user's decision
--   * freeze labels: the component labels DrawingPlan1 lays out with
--     BlankPos (layers ateNOZZ ateVALV ateREDU ateINST ateSUPT -- GLABs
--     and SLABs alike) are created with OSET TRUE, so their XYPO is an
--     offset from the design point and E3D drags them along when the
--     element moves in the model. on a revised sheet that is wrong: the
--     support tags rode 3.33mm with their pipe and showed as moved
--     (user, 2026-09-15). OSET FALSE turns XYPO into an absolute page
--     position -- E3D converts the value itself, the label does not
--     shift -- and from then on the text stays put and only the leader
--     follows the element. done here, at revision time, because that is
--     the moment the sheet and the model agree; the update path is too
--     late (the design point already reads the moved model). AVEVA's own
--     abaarrange.pmlfnc switches OSET both ways the same way
--   * compare: the sheet is exported to a temporary DXF and RevCloud.exe
--     (bin\RevCloud.exe beside a PMLLIB entry, like BlankPos) diffs it
--     against the previous revision's DXF. that answers two things: what
--     changed (the clouds) and whether anything changed at all. with the
--     'Skip sheets with no drawing change' toggle on, an unchanged sheet
--     is left alone -- no REVI -- and reported apart from the failures.
--     the Next column is the plan, the log is the result (user decision
--     2026-09-14). a first revision has nothing to compare with and is
--     always made
--   * clouds: drawn from the revision named on a 'CLOUD <code>' line in
--     <PROJID>_REV.txt onwards (project-wide, user decision 2026-09-14).
--     they live in NOTE <sheet>/REVCLOUD, and only the latest revision
--     carries them. the previous clouds are deleted BEFORE the temporary
--     export, so what RevCloud compares is clean on both sides and no
--     cloud ever has to be recognised (user suggestion 2026-09-15 --
--     the read-back of OUTL vertices it replaced never worked: a VRTX
--     holds no position of its own, only a PTRF, and three real runs
--     clouded the old clouds over again). a sheet that is then skipped
--     as unchanged, or whose comparison fails, gets its clouds back from
--     <PICF>_<code>.clouds.txt, RevCloud's answer kept beside that
--     revision's DXF when the clouds were drawn. DXFOUT exports an OUTL
--     on layer 0 whatever VLAYRF says (2026-09-14), so the virtual layer
--     /REVCLOUD is set only as a courtesy
--   * revision triangle: every outer cloud gets an upright triangle with
--     the revision code in it, drawn as an OUTL and a TEXP in the same
--     REVCLOUD note (user decision 2026-09-15: no SYTM -- a SYMB carries
--     no text and a SLAB would need a design element and a layer outside
--     the note). the text height is the form's 'Rev text height' and
--     sets the size of the triangle too. WHERE it goes is RevCloud's
--     answer ('tri i x y' after each outer cloud): RevCloud knows every
--     box on the new sheet and puts the triangle where it touches
--     nothing, inside the CANVAS when the sequence file names one (user
--     requirement 2026-09-15). no 'tri' record (older lists) = the top
--     right corner of the cloud's box. the code is written into the
--     .clouds.txt as a 'revision <code>' line so a restored set keeps
--     its own code
--   * the border (user, 2026-09-15: no rule says which border texts are
--     TEXPs and which the backing sheet fills in, every project differs).
--     so the border is declared, not read: inside the CANVAS everything
--     is compared; outside it nothing is, except inside WATCH rectangles,
--     where even the backing sheet's own text counts. DrawingPlan1 writes
--     the canvas and the box of every border text it writes itself (the
--     drawing number) into the DRWG's NTEXT as 'CV x1 y1 x2 y2;W x1 y1 x2
--     y2' (user decision 2026-09-15), read here per sheet. <PROJID>_REV.txt
--     adds, per project: 'CANVAS x1 y1 x2 y2' (used when the DRWG has no
--     NTEXT -- drawn before this existed), 'WATCH x1 y1 x2 y2' for a title
--     field the project wants clouded (typed or attribute, either way),
--     'NOCLOUD x1 y1 x2 y2' for a spot inside the canvas that must never
--     cloud. a sheet with no canvas at all falls back to RevCloud's
--     older guess (backing sheet out, title strip out)
--   * the DXF is <PICF>_<code>.dxf so every revision keeps its own file
--     even when PICF did not move (user decision 2026-09-14)
--   * a failure skips that sheet and carries on. the batch usually runs
--     after hours, so everything is written to <PROJID>_REV.log. a dialog
--     at the end only when something was skipped or failed -- an all-OK
--     run shows itself in the Current column (user decision 2026-09-14)
--
--------------------------------------------------

import 'Aveva.Pdms.SDInteraction.UI'
handle any
endhandle
using namespace 'Aveva.Pdms.SDInteraction.UI.Gui.RevisionControl'
handle any
endhandle
-- the three-column sheet table is a .NET grid: a plain PML list uses a
-- proportional font, so space-padded columns never line up
import 'GridControl'
handle any
endhandle
using namespace 'Aveva.Core.Presentation'
handle any
endhandle

layout form !!DrawingPlan1Revision dialog dock
	!this.formTitle = 'Drawing Revision'

	container .rows nobox PmlNetControl 'NET' width 50 height 12
	button .addce  'Add CE'      at xmax.rows+0.5 ymin.rows      width 12 call '!this.AddCe()'
	button .remce  'Remove'      at xmin.addce  ymax.addce+0.3   width 12 call '!this.RemoveCe()'
	button .remall 'Remove All'  at xmin.addce  ymax.remce+0.3   width 12 call '!this.RemoveAll()'
	option .target 'Revision'    at xmin.rows   ymax.rows+0.3    tagwidth 9 width 12
	toggle .skipsame at xmax.target+2 ymin.target 'Skip sheets with no drawing change'
	text   .revhei 'Rev text height (mm)' at xmin.rows ymax.target+0.3 tagwidth 19 width 5 is REAL
	button .apply  'Apply'       at xmin.rows   ymax.revhei+0.5  width 12 call '!this.Apply()'
	button .cancel 'Cancel'      at xmax.apply+2 ymin.apply      width 12 call '!this.Close()'

	member .grid   is NETGRIDCONTROL $( the .NET grid living in .rows $)
	member .projcode is string  $( 3-letter project code, the same one the <code>000 evars are built on $)
	member .seq    is array    $( revision codes from <PROJID>_REV.txt, in file order              $)
	member .seqok  is boolean  $( the sequence file was found and holds at least one code          $)
	member .seqerr is string   $( why it is not ok -- shown once when the form opens, and by Apply $)
	member .seqdir is string   $( project folder holding the sequence file and the log, no trailing \ $)
	member .shees  is array    $( SHEE dbref strings in the list, in display order                  $)
	member .cur    is array    $( per sheet: current code, '' = no revision yet, '?' = code not in file $)
	member .nxt    is array    $( per sheet: code it will be revised to, '' = skip this sheet       $)
	member .reuse  is array    $( per sheet: dbref of an unfinished REVI carrying the target code, '' = none. Apply finishes it instead of NEW $)
	member .curref is array    $( per sheet: dbref of the REVI that IS the current version, '' = none      $)
	member .cloudfrom is string $( code on the CLOUD line of <PROJID>_REV.txt; clouds from that revision on. '' = never $)
	member .cloudexe is string $( full path of RevCloud.exe, '' = not found beside any PMLLIB entry       $)
	member .workdir is string  $( folder for the temporary DXF and RevCloud's answer, ends with \        $)
	member .cloudlines is array $( RevCloud's answer for the sheet being processed, line by line          $)
	member .canvas     is string $( 'x1,y1,x2,y2' from the CANVAS line of the sequence file, '' = none     $)
	member .nocloud    is array  $( 'x1,y1,x2,y2' per NOCLOUD line of the sequence file                    $)
	member .watch      is array  $( 'x1,y1,x2,y2' per WATCH line of the sequence file                      $)
	member .cleared    is real  $( cloud notes the last .ClearClouds deleted                              $)
exit

-------------
-- initial --
-------------
define method .DrawingPlan1Revision()
	var !projcode proj code
	!this.projcode = !projcode.upcase()
	!this.shees = object array()
	!this.cur   = object array()
	!this.nxt   = object array()
	!this.reuse = object array()
	!this.curref = object array()
	!this.cloudfrom = ''
	!this.cloudlines = object array()
	-- an empty revision by accident is worse than a re-issue that has to
	-- be asked for twice, so the skip is on by default
	!this.skipsame.val = true
	!this.revhei.val   = 3.5

	--------------------------------------------------------------------
	-- where the temporary DXF and RevCloud's answer go. same choice as  --
	-- DrawingPlan1's .blankdir: AVEVA_DESIGN_USER is E3D's own writable --
	-- per-user area, so two people on one machine do not share a file  --
	--------------------------------------------------------------------
	!this.workdir = !!evar('AVEVA_DESIGN_USER')
	handle any
		!this.workdir = ''
	endhandle
	if (!this.workdir.eq('')) then
		!this.workdir = 'D:\Documents\Python\'
	endif
	if (!this.workdir.substring(!this.workdir.length(), 1).neq('\')) then
		!this.workdir = !this.workdir & '\'
	endif
	--------------------------------------------------------------------
	-- RevCloud.exe lives in a bin folder beside a PML library entry,    --
	-- same rule as BlankPos.exe (DrawingPlan1 constructor): PMLLIB is a --
	-- ';' separated search path, first bin\RevCloud.exe that exists wins --
	--------------------------------------------------------------------
	!this.cloudexe = ''
	!pmllib = !!evar('PMLLIB')
	handle any
		!pmllib = ''
	endhandle
	!pmldirs = !pmllib.split(';')
	do !pmldir values !pmldirs
		!pd = !pmldir.trim()
		skip if (!pd.eq(''))
		if (!pd.substring(!pd.length(), 1).neq('\')) then
			!pd = !pd & '\'
		endif
		!cand = !pd & 'bin\RevCloud.exe'
		!cf = object FILE(!cand)
		if (!cf.exists()) then
			!this.cloudexe = !cand
			break
		endif
	enddo

	using namespace 'Aveva.Core.Presentation'
	!this.grid = object NETGRIDCONTROL()
	!this.rows.control = !this.grid.handle()
	!this.grid.fixedHeaders(false)
	!this.grid.outlookGroupStyle(false)
	!this.grid.columnExcelFilter(false)
	!this.grid.headerSort(false)
	!this.grid.columnSummaries(false)
	!this.grid.singleRowSelection(true)

	!this.LoadSequence()
	-- user decision 2026-09-14: no on-form 'Sequence file: ...' line, it
	-- told the user nothing useful when things worked. when they do not,
	-- say so once here -- Apply is greyed out below and would otherwise
	-- go grey without a word
	if (not !this.seqok) then
		!!alert.error(!this.seqerr)
	endif

	!this.target.callback = '!this.Refresh()'
	!this.Refresh()
endmethod

define method .Close()
	kill !!DrawingPlan1Revision
endmethod

----------------------------------------------------------------------
-- read <PROJID>_REV.txt. one code per line in order, blank lines   --
-- and lines starting with -- are ignored. the first code is what a --
-- sheet with no revision yet is issued at                          --
----------------------------------------------------------------------
define method .LoadSequence()
	!this.seq    = object array()
	!this.seqok  = false
	!this.cloudfrom = ''
	!this.canvas  = ''
	!this.nocloud = object array()
	!this.watch   = object array()
	!this.seqerr = 'Sequence file: not loaded'
	!this.seqdir = ''

	!evname = !this.projcode.lowcase() & '000'
	!p000 = ''
	var !p000 evar '$!evname'
	handle any
		!p000 = ''
	endhandle
	if (!p000.eq('')) then
		!this.seqerr = 'Sequence file: evar ' & !evname & ' is empty (proj code ' & !this.projcode & ')'
		return
	endif

	-- evar points at ...\<projcode>000. the file lives one level up.
	-- drop the last path component only; do not split and rejoin, that
	-- loses the leading \\ of a UNC path (\\SVRE3D\pdms_proj\...)
	!p = !p000.replace('/', '\')
	if (!p.substring(!p.length(), 1).eq('\')) then
		!p = !p.substring(1, !p.length() - 1)
	endif
	!parts = !p.split('\')
	!last  = !parts[!parts.size()]
	!dir   = !p.substring(1, !p.length() - !last.length() - 1)
	!this.seqdir = !dir

	!path = !dir & '\' & !this.projcode & '_REV.txt'
	!f = object FILE(!path)
	if (not !f.exists()) then
		!this.seqerr = 'Sequence file: NOT FOUND ' & !path
		return
	endif
	!f.open('read')
	!lines = !f.readfile()
	!f.close()

	do !line values !lines
		!t = !line.trim()
		skip if (!t.eq(''))
		if (!t.length().geq(2)) then
			skip if (!t.substring(1, 2).eq('--'))
		endif
		-- 'CLOUD <code>': revision clouds are drawn from that code on.
		-- one line for the whole project (user decision 2026-09-14)
		if (!t.part(1).upcase().eq('CLOUD')) then
			!this.cloudfrom = ''
			!this.cloudfrom = !t.part(2).trim()
			handle any
				!this.cloudfrom = ''
			endhandle
			skip
		endif
		-- 'CANVAS / WATCH / NOCLOUD x1 y1 x2 y2', sheet mm
		!kw = !t.part(1).upcase()
		if (!kw.eq('CANVAS') or !kw.eq('NOCLOUD') or !kw.eq('WATCH')) then
			!rect = !this.RectOf(!t)
			if (!rect.eq('')) then
				!this.seqerr = 'Sequence file: cannot read the rectangle on the line ' & !t & ' in ' & !path
				return
			endif
			if (!kw.eq('CANVAS')) then
				!this.canvas = !rect
			elseif (!kw.eq('WATCH')) then
				!this.watch.append(!rect)
			else
				!this.nocloud.append(!rect)
			endif
			skip
		endif
		!this.seq.append(!t)
	enddo

	if (!this.seq.size().eq(0)) then
		!this.seqerr = 'Sequence file: EMPTY ' & !path
		return
	endif
	if (!this.cloudfrom.neq('')) then
		if (!this.SeqIndex(!this.cloudfrom).eq(0)) then
			!this.seqerr = 'Sequence file: CLOUD code ' & !this.cloudfrom & ' is not one of the revision codes in ' & !path
			return
		endif
	endif

	!this.seqok  = true
	!this.seqerr = ''

	-- entry 1 is the "next after current" mode, the rest are explicit codes
	!opts = object array()
	!opts.append('Next')
	!opts.appendarray(!this.seq)
	!this.target.dtext = !opts
	!this.target.val = 1
endmethod

-- position of a code in the sequence, 0 when it is not there
-- 'WORD x1 y1 x2 y2' -> 'x1,y1,x2,y2', '' when the four are not numbers
define method .RectOf(!t is STRING) is STRING
	!out = ''
	do !k from 2 to 5
		!v = ''
		!v = !t.part(!k).trim()
		handle any
			return ''
		endhandle
		!num = !v.real()
		handle any
			return ''
		endhandle
		if (!out.neq('')) then
			!out = !out & ','
		endif
		!out = !out & !v
	enddo
	return !out
endmethod

define method .SeqIndex(!code is STRING) is REAL
	do !i from 1 to !this.seq.size()
		if (!this.seq[!i].eq(!code)) then
			return !i
		endif
	enddo
	return 0
endmethod

----------------------------------------------------------------------
-- the SHEE that CE is, or sits inside. '' when CE is above every   --
-- SHEE (DRWG, REGI, ...) or outside DRAFT altogether. CE is put     --
-- back where it was                                                --
----------------------------------------------------------------------
define method .SheetOfCe() is STRING
	!save  = !!ce
	!found = ''
	do !i from 1 to 30
		var !type type
		if (!type.eq('SHEE')) then
			var !found ref
			break
		endif
		break if (!type.eq('WORL'))
		!!ce = !!ce.owner
		handle any
			break
		endhandle
	enddo
	!!ce = !save
	return !found
endmethod

define method .AddSheet(!ref is STRING)
	if (!ref.eq('')) then
		return
	endif
	do !s values !this.shees
		if (!s.eq(!ref)) then
			return
		endif
	enddo
	!this.shees.append(!ref)
endmethod

----------------------------------------------------------------------
-- one button for both cases. CE on or inside a SHEE: that sheet.   --
-- CE above the sheets (DRWG, REGI, DEPT): every SHEE below it, any --
-- depth. nothing is added twice                                    --
----------------------------------------------------------------------
define method .AddCe()
	!ref = !this.SheetOfCe()
	if (!ref.neq('')) then
		!this.AddSheet(!ref)
		!this.Refresh()
		return
	endif
	var !coll coll all shee for ce
	handle any
		!coll = object array()
	endhandle
	if (!coll.size().eq(0)) then
		!!alert.error('CE is not a SHEE, is not inside one, and has no SHEE below it')
		return
	endif
	do !s values !coll
		!this.AddSheet(!s)
	enddo
	!this.Refresh()
endmethod

----------------------------------------------------------------------
-- a row selected in the table wins; with nothing selected, fall     --
-- back to the sheet CE is on or inside. row tags are 1-based and in --
-- the order Refresh bound them, which is the order of !this.shees   --
----------------------------------------------------------------------
define method .RemoveCe()
	!ref = ''
	!picked = false
	!picked = !this.grid.getSelectedRows().set()
	handle any
		!picked = false
	endhandle
	if (!picked) then
		!rowno = !this.grid.getSelectedRowTags()[1].real()
		handle any
			!rowno = 0
		endhandle
		if (!rowno.geq(1) and !rowno.leq(!this.shees.size())) then
			!ref = !this.shees[!rowno]
		endif
	endif
	if (!ref.eq('')) then
		!ref = !this.SheetOfCe()
	endif
	if (!ref.eq('')) then
		!!alert.error('Select a row in the table, or make a SHEE (or something inside one) the CE')
		return
	endif
	!keep = object array()
	do !s values !this.shees
		if (!s.neq(!ref)) then
			!keep.append(!s)
		endif
	enddo
	!this.shees = !keep
	!this.Refresh()
endmethod

define method .RemoveAll()
	!this.shees = object array()
	!this.Refresh()
endmethod

----------------------------------------------------------------------
-- rescan every sheet in the list and redraw the rows.              --
--                                                                  --
-- current version: of the REVIs that have BOTH rvsn and stext, the --
-- one whose code sits furthest along the sequence. a finished REVI --
-- whose code is not in the file at all marks the sheet '?' and it  --
-- is left alone. REVIs missing stext are unfinished: they never    --
-- count as a version, but one carrying the target code is          --
-- remembered so Apply can finish it instead of making a duplicate  --
--                                                                  --
-- next version: 'Next' mode is current + 1. an explicit code is    --
-- accepted only when it lies after the current one, which also     --
-- guarantees no finished REVI already has it. anything else leaves --
-- the Next column blank and Apply skips the row                    --
----------------------------------------------------------------------
define method .Refresh()
	-- keep the table in box-name order whatever order the sheets came in
	if (!this.shees.size().gt(1)) then
		!names = object array()
		do !s values !this.shees
			!names.append(!this.BoxName(!s))
		enddo
		!this.shees.reindex(!names.sortedIndices())
		handle any
		endhandle
	endif

	!this.cur   = object array()
	!this.nxt   = object array()
	!this.reuse = object array()
	!this.curref = object array()

	!pick = ''
	if (!this.seqok) then
		if (!this.target.val.gt(1)) then
			!pick = !this.seq[!this.target.val - 1]
		endif
	endif

	!rows = object array()
	!any  = false
	do !i from 1 to !this.shees.size()
		!ref = !this.shees[!i]
		!cur   = ''
		!nxt   = ''
		!reuse = ''
		!curr  = ''
		!curidx  = 0
		!unknown = false
		!inccode = object array()
		!incref  = object array()

		var !revs coll all revi for $!ref
		handle any
			!revs = object array()
		endhandle
		do !r values !revs
			!rvsn = ''
			!stext = ''
			var !rvsn rvsn of $!r
			handle any
				!rvsn = ''
			endhandle
			var !stext stext of $!r
			handle any
				!stext = ''
			endhandle
			!rvsn  = !rvsn.trim()
			!stext = !stext.trim()
			if (!rvsn.upcase().eq('UNSET')) then
				!rvsn = ''
			endif
			if (!stext.upcase().eq('UNSET')) then
				!stext = ''
			endif
			skip if (!rvsn.eq(''))
			if (!stext.eq('')) then
				!inccode.append(!rvsn)
				!incref.append(!r)
				skip
			endif
			!idx = !this.SeqIndex(!rvsn)
			if (!idx.eq(0)) then
				!unknown = true
			elseif (!idx.gt(!curidx)) then
				!curidx = !idx
				!curr   = !r
			endif
		enddo

		if (!unknown) then
			!cur = '?'
		elseif (!curidx.gt(0)) then
			!cur = !this.seq[!curidx]
		endif

		if (!this.seqok and not !unknown) then
			if (!pick.eq('')) then
				if (!curidx.lt(!this.seq.size())) then
					!nxt = !this.seq[!curidx + 1]
				endif
			else
				if (!this.SeqIndex(!pick).gt(!curidx)) then
					!nxt = !pick
				endif
			endif
		endif

		if (!nxt.neq('')) then
			do !k from 1 to !inccode.size()
				if (!inccode[!k].eq(!nxt)) then
					!reuse = !incref[!k]
					break
				endif
			enddo
			!any = true
		endif

		!this.cur.append(!cur)
		!this.nxt.append(!nxt)
		!this.reuse.append(!reuse)
		!this.curref.append(!curr)

		!curtxt = !cur
		if (!cur.eq('')) then
			!curtxt = '-'
		endif
		!row = object array()
		!row[1] = !this.BoxName(!ref)
		!row[2] = !curtxt
		!row[3] = !nxt
		!rows.append(!row)
	enddo

	!headings = object array()
	!headings.append('Box')
	!headings.append('Current')
	!headings.append('Next')
	using namespace 'Aveva.Core.Presentation'
	!nds = object NETDATASOURCE('Sheets', !headings, !rows)
	!this.grid.bindToDataSource(!nds)
	handle any
	endhandle
	-- binding resets every column to a stub width, so refit after each one
	!this.grid.autoFitColumns()
	handle any
	endhandle
	!this.apply.active = (!this.seqok and !any)
endmethod

----------------------------------------------------------------------
-- /X/SS/S1 -> X, which is what DrawingPlan1 shows in its own list.  --
-- X may itself look like =23718/1671: an unnamed box EQUI is known  --
-- by its reference, and that reference becomes the drawing name.   --
-- anything not ending in /SS/S1 is shown as it is                   --
----------------------------------------------------------------------
define method .BoxName(!ref is STRING) is STRING
	!name = ''
	var !name name of $!ref
	handle any
		!name = !ref
	endhandle
	if (!name.length().gt(7)) then
		if (!name.substring(!name.length() - 5, 6).eq('/SS/S1')) then
			!core = !name.substring(2, !name.length() - 7)
			if (!core.neq('')) then
				return !core
			endif
		endif
	endif
	return !name
endmethod

-- 'hh:mm dd Mon yyyy', the form REVD and SETCOMPDATE both use
define method .NowStamp() is STRING
	!mon = object array()
	!mon.append('Jan')
	!mon.append('Feb')
	!mon.append('Mar')
	!mon.append('Apr')
	!mon.append('May')
	!mon.append('Jun')
	!mon.append('Jul')
	!mon.append('Aug')
	!mon.append('Sep')
	!mon.append('Oct')
	!mon.append('Nov')
	!mon.append('Dec')
	!d  = object DATETIME()
	!hh = !d.hour().string()
	!mm = !d.minute().string()
	!dd = !d.date().string()
	if (!hh.length().eq(1)) then
		!hh = '0' & !hh
	endif
	if (!mm.length().eq(1)) then
		!mm = '0' & !mm
	endif
	if (!dd.length().eq(1)) then
		!dd = '0' & !dd
	endif
	return !hh & ':' & !mm & ' ' & !dd & ' ' & !mon[!d.month()] & ' ' & !d.year().string()
endmethod

----------------------------------------------------------------------
-- /%APSPIC%/26/M2013286677-151450-10000-3                          --
--     -> <value of evar APSPIC>\26\M2013286677-151450-10000-3      --
-- '' when the evar cannot be resolved. the project code is taken   --
-- from the string itself, nothing is hard-wired                    --
----------------------------------------------------------------------
define method .PicPath(!picf is STRING) is STRING
	!s = !picf
	if (!s.length().lt(3)) then
		return ''
	endif
	if (!s.substring(1, 1).eq('/')) then
		!s = !s.substring(2, !s.length() - 1)
	endif
	if (!s.substring(1, 1).neq('%')) then
		return !s.replace('/', '\')
	endif
	!rest   = !s.substring(2, !s.length() - 1)
	!evname = !rest.before('%')
	!tail   = !rest.after('%')
	!base   = ''
	var !base evar '$!evname'
	handle any
		!base = ''
	endhandle
	if (!base.eq('')) then
		return ''
	endif
	!base = !base.replace('/', '\')
	if (!base.substring(!base.length(), 1).eq('\')) then
		!base = !base.substring(1, !base.length() - 1)
	endif
	return !base & !tail.replace('/', '\')
endmethod

----------------------------------------------------------------------
-- write REVD (attribute RVDT) on the CE. RVDT is string(12) (DMRM  --
-- 17.22.21): anything longer is refused with the misleading (2,9)  --
-- Too many values given -- 21:31 13 Sep 2026 is 17 chars and was   --
-- rejected that way on 2026-09-13. so the time cannot live here.   --
-- '' = success, otherwise the error text                            --
----------------------------------------------------------------------
define method .SetRevd(!stamp is STRING) is STRING
	-- user decision 2026-09-13: REVD = 'dd Mon yyyy', the SETCOMPDATE
	-- date form without the time (11 chars, fits string(12)). the
	-- hyphenated form is only a fallback for a version that dislikes
	-- the spaces; !stamp (the full hh:mm form) is kept for the log only
	!d   = object DATETIME()
	!dd  = !d.date().string()
	if (!dd.length().eq(1)) then
		!dd = '0' & !dd
	endif
	!mon = !d.monthString().string().substring(1, 3)
	!yy  = !d.year().string()
	!forms = object array()
	!forms.append(!dd & ' ' & !mon & ' ' & !yy)
	!forms.append(!dd & '-' & !mon & '-' & !yy)

	!err = ''
	do !k from 1 to !forms.size()
		!try = !forms[!k]
		!set = false
		REVD |$!try|
		handle any
			!err = !!error.text
		elsehandle none
			!set = true
		endhandle
		if (!set) then
			if (!k.gt(1)) then
				!this.Log('REVD took form ' & !k & ' (' & !try & '); form 1 (' & !forms[1] & ') was rejected: ' & !err)
			endif
			return ''
		endif
	enddo
	return !err
endmethod

-- one line into <PROJID>_REV.log, silently dropped when the folder is unknown
define method .Log(!line is STRING)
	if (!this.seqdir.eq('')) then
		return
	endif
	!f = object FILE(!this.seqdir & '\' & !this.projcode & '_REV.log')
	!opened = true
	!f.open('append')
	handle any
		!opened = false
	endhandle
	if (!opened) then
		!f.writerecord(!this.NowStamp() & '  ' & !line)
		!f.close()
	endif
endmethod

----------------------------------------------------------------------
-- the previous revision's DXF for sheet !i, '' when there is none.  --
-- <PICF>_<code>.dxf first, then the plain <PICF>.dxf the 2026-09-13 --
-- runs wrote                                                        --
----------------------------------------------------------------------
define method .PrevDxf(!i is REAL) is STRING
	!curr = !this.curref[!i]
	if (!curr.eq('')) then
		return ''
	endif
	!stext = ''
	var !stext stext of $!curr
	handle any
		!stext = ''
	endhandle
	!base = !this.PicPath(!stext.trim())
	if (!base.eq('')) then
		return ''
	endif
	!cand = !base & '_' & !this.cur[!i] & '.dxf'
	!f = object FILE(!cand)
	if (!f.exists()) then
		return !cand
	endif
	!cand = !base & '.dxf'
	!f = object FILE(!cand)
	if (!f.exists()) then
		return !cand
	endif
	return ''
endmethod

----------------------------------------------------------------------
-- export the sheet as it stands and let RevCloud diff it against    --
-- the previous revision's DXF. answers:                             --
--   'none'  nothing to compare with (first revision)                --
--   'same'  compared, no difference                                 --
--   'diff'  compared, differences found; .cloudlines holds the      --
--           outlines to draw                                        --
--   anything else is an error text and the sheet fails on it: a     --
--   previous revision whose DXF is missing, an exe that is not      --
--   there, an export or a run that produced nothing. these are not  --
--   silently turned into 'no clouds', an issued drawing without     --
--   its clouds is a wrong drawing                                   --
--                                                                   --
-- the caller has taken the previous clouds off the sheet already,  --
-- so the temporary DXF is as clean as the archived one              --
----------------------------------------------------------------------
define method .Compare(!i is REAL, !box is STRING, !nxt is STRING) is STRING
	!ref  = !this.shees[!i]
	!prev = !this.PrevDxf(!i)
	if (!prev.eq('')) then
		if (!this.curref[!i].eq('')) then
			!this.Log(!box & ' -> ' & !nxt & '  compare: first revision, nothing to compare with')
			return 'none'
		endif
		return 'previous revision ' & !this.cur[!i] & ' has no DXF beside its picture file (STEXT of ' & !this.curref[!i] & ')'
	endif
	if (!this.cloudexe.eq('')) then
		return 'RevCloud.exe not found in any bin folder on the PMLLIB search path'
	endif

	!tmp = !this.workdir & 'RevCloud_new.dxf'
	!out = !this.workdir & 'RevCloud_out.txt'
	!f = object FILE(!tmp)
	if (!f.exists()) then
		!f.deletefile()
		handle any
		endhandle
	endif
	!f = object FILE(!out)
	if (!f.exists()) then
		!f.deletefile()
		handle any
		endhandle
	endif

	-- the projection lines of the sheet as it stands, for RevCloud to
	-- leave alone (.WriteDimLines); the old sheet's list sits beside
	-- its DXF when that revision was made after 2026-09-17
	!dlnew = !this.workdir & 'RevCloud_new.dimlines.txt'
	!ndl   = !this.WriteDimLines(!ref, !dlnew, !box, !nxt)
	!dlold = !this.DimLinesPath(!prev)
	!fo = object FILE(!dlold)
	!hasold = !fo.exists()
	handle any
		!hasold = false
	endhandle
	$!ref
	LIEXEC /Draft_DXF_LI 'DXFOUT' OutputF '$!tmp'
	handle any
		return 'temporary DXF export failed: ' & !!error.text
	endhandle
	!f = object FILE(!tmp)
	if (not !f.exists()) then
		return 'temporary DXF export wrote nothing to ' & !tmp
	endif

	-- one extra pair of quotes round the whole command: cmd /c strips the
	-- first and the last quote character when there are more than two, so
	-- the outer pair is what gets eaten (DrawingPlan1's BlankPos call)
	!hei = !this.revhei.val
	handle any
		!hei = 3.5
	endhandle
	if (!hei.leq(0)) then
		!hei = 3.5
	endif
	-- 2.2, not 2.5 (user, 2026-09-18: still a bit big, one more step
	-- down). kept the same in .DrawClouds() below -- RevCloud has to
	-- know the size actually drawn or it avoids the wrong box
	!trisize = !hei * 2.2
	!opts = ' --tri-size ' & !trisize.string('D2')
	-- the canvas and DrawingPlan1's own border texts, from the DRWG's
	-- NTEXT ('CV x1 y1 x2 y2;W x1 y1 x2 y2', a DRWG has no DESC); the
	-- sequence file's CANVAS
	-- only when the DRWG carries none
	!cv = ''
	!watches = object array()
	!dsc = ''
	var !dsc ntext of owner of $!ref
	handle any
		!dsc = ''
	endhandle
	!items = !dsc.split(';')
	do !item values !items
		!it = !item.trim()
		skip if (!it.eq(''))
		!rect = !this.RectOf(!it)
		skip if (!rect.eq(''))
		if (!it.part(1).upcase().eq('CV')) then
			!cv = !rect
		elseif (!it.part(1).upcase().eq('W')) then
			!watches.append(!rect)
		endif
	enddo
	!cvfrom = 'DRWG NTEXT'
	if (!cv.eq('')) then
		!cv = !this.canvas
		!cvfrom = 'sequence file'
	endif
	do !r values !this.watch
		!watches.append(!r)
	enddo
	if (!cv.neq('')) then
		!opts = !opts & ' --canvas ' & !cv
		do !r values !watches
			!opts = !opts & ' --watch ' & !r
		enddo
		!this.Log(!box & ' -> ' & !nxt & '  compare: canvas ' & !cv & ' (' & !cvfrom & '), ' & !watches.size() & ' watched rectangle(s)')
	else
		!this.Log(!box & ' -> ' & !nxt & '  compare: no canvas (no NTEXT on the DRWG, no CANVAS line), border left to the RevCloud guess: backing sheet out, title strip out')
	endif
	do !r values !this.nocloud
		!opts = !opts & ' --exclude ' & !r
	enddo
	if (!ndl.geq(0)) then
		!opts = !opts & ' --dimlines-new "' & !dlnew & '"'
	endif
	if (!hasold) then
		!opts = !opts & ' --dimlines-old "' & !dlold & '"'
	endif
	!oldtxt = 'none'
	if (!hasold) then
		!oldtxt = !dlold
	endif
	!this.Log(!box & ' -> ' & !nxt & '  compare: projection lines left out of the diff: ' & !ndl & ' listed for this sheet, old list ' & !oldtxt)
	!cmd = '""' & !this.cloudexe & '" --cloud-layer REVCLOUD' & !opts & ' "' & !prev & '" "' & !tmp & '" "' & !out & '""'
	syscom |$!cmd|
	handle any
		return 'RevCloud did not run: ' & !!error.text
	endhandle
	!f = object FILE(!out)
	if (not !f.exists()) then
		return 'RevCloud gave no answer, see ' & !out & '.log'
	endif
	!f.open('read')
	!lines = !f.readfile()
	!f.close()
	if (!lines.size().eq(0)) then
		return 'RevCloud answer is empty, see ' & !out & '.log'
	endif
	!head = !lines[1].trim()
	if (!head.part(1).neq('clouds')) then
		return 'RevCloud answer not understood: ' & !head
	endif
	!n = !head.part(2).real()
	handle any
		return 'RevCloud answer not understood: ' & !head
	endhandle
	!this.Log(!box & ' -> ' & !nxt & '  compare: ' & !head & '  (against ' & !prev & ')')
	if (!n.eq(0)) then
		return 'same'
	endif
	!this.cloudlines = !lines
	return 'diff'
endmethod

----------------------------------------------------------------------
-- the clouds live in NOTE <sheet>/REVCLOUD. '' when the sheet has no --
-- name to hang that on (every DrawingPlan1 sheet is /X/SS/S1)       --
----------------------------------------------------------------------
define method .CloudNote(!ref is STRING) is STRING
	!sname = ''
	var !sname name of $!ref
	handle any
		!sname = ''
	endhandle
	!sname = !sname.trim()
	if (!sname.eq('') or !sname.substring(1, 1).neq('/')) then
		return ''
	endif
	return !sname & '/REVCLOUD'
endmethod

----------------------------------------------------------------------
-- the component labels of the sheet pinned to the page: OSET FALSE  --
-- on every GLAB/SLAB under a layer named ate<NOZZ|VALV|REDU|INST|   --
-- SUPT>, so a later model change stretches the leader but leaves    --
-- the text where BlankPos put it (see the header). other labels are --
-- left alone: line numbers, grid bubbles and flow arrows are        --
-- re-placed by the update path itself (a flow arrow does NOT ride   --
-- on its pipe -- its POS is a fixed model point -- so FlowAnnotation --
-- keeps or re-places each one on the update path, 2026-09-18). '' = --
-- success (a label that refuses is counted and logged, the revision --
-- still goes out), otherwise the error text                         --
----------------------------------------------------------------------
define method .FreezeLabels(!ref is STRING, !box is STRING, !nxt is STRING) is STRING
	!labs = object array()
	var !labs coll all (glab slab) for $!ref
	handle any
		return 'cannot collect the labels of ' & !ref & ': ' & !!error.text
	endhandle
	!kinds   = ' NOZZ VALV REDU INST SUPT '
	!frozen  = 0
	!already = 0
	!refused = 0
	do !l values !labs
		!lname = ''
		var !lname name of owner of $!l
		handle any
			!lname = ''
		endhandle
		-- '/X/SS/S1/V1/ateSUPT' -> 'SUPT'
		!kind = !lname.after('/ate').upcase()
		skip if (!kind.eq(''))
		skip if (not !kinds.matchwild('* ' & !kind & ' *'))
		!os = ''
		var !os oset of $!l
		handle any
			!os = ''
		endhandle
		if (!os.upcase().eq('FALSE')) then
			!already = !already + 1
			skip
		endif
		!nav = true
		$!l
		handle any
			!nav = false
		endhandle
		if (not !nav) then
			!refused = !refused + 1
			skip
		endif
		OSET FALSE
		handle any
			!refused = !refused + 1
			!this.Log(!box & ' -> ' & !nxt & '  freeze: ' & !l & ' under ' & !lname & ' refused OSET FALSE: ' & !!error.text)
		elsehandle none
			!frozen = !frozen + 1
		endhandle
	enddo
	!this.Log(!box & ' -> ' & !nxt & '  freeze: ' & !frozen & ' label(s) pinned to the page (OSET FALSE), ' & !already & ' already, ' & !refused & ' refused')
	return ''
endmethod

-- <PICF>_<code>.clouds.txt beside <PICF>_<code>.dxf
define method .CloudListPath(!dxf is STRING) is STRING
	if (!dxf.upcase().matchwild('*.DXF')) then
		return !dxf.substring(1, !dxf.length() - 4) & '.clouds.txt'
	endif
	return !dxf & '.clouds.txt'
endmethod

-- <PICF>_<code>.dimlines.txt beside <PICF>_<code>.dxf
define method .DimLinesPath(!dxf is STRING) is STRING
	if (!dxf.upcase().matchwild('*.DXF')) then
		return !dxf.substring(1, !dxf.length() - 4) & '.dimlines.txt'
	endif
	return !dxf & '.dimlines.txt'
endmethod

----------------------------------------------------------------------
-- the sheet's dimension projection lines, written as the 'dimline  --
-- <dir> x1 y1 x2 y2' records DrawingPlan1DimLines makes for        --
-- BlankPos, so RevCloud can leave them out of the diff: a pipe     --
-- moved sideways takes its projection line along, and clouding     --
-- that line drew a band from the dimension chain through the match --
-- line text down to the pipe (user, 2026-09-17). the pipe and the  --
-- changed figures are clouded on their own. kept beside every      --
-- revision's DXF (like the cloud list) so the next comparison has  --
-- the old sheet's lines too; the temporary one goes to .workdir.   --
-- returns how many records were written, -1 when the list could   --
-- not be made -- RevCloud then simply gets no list, as before.     --
-- DrawingPlan1DimLines wants the DRWG name without /SS, which is   --
-- read off the sheet name; leaves CE on an LDIM                     --
----------------------------------------------------------------------
define method .WriteDimLines(!ref is STRING, !path is STRING, !box is STRING, !nxt is STRING) is REAL
	!shn = ''
	var !shn name of $!ref
	handle any
		!shn = ''
	endhandle
	if (not !shn.matchwild('*/SS/S1')) then
		!this.Log(!box & ' -> ' & !nxt & '  dimlines: sheet ' & !shn & ' is not named <drawing>/SS/S1, no projection line list')
		return -1
	endif
	!name = !shn.substring(1, !shn.length() - 6)
	!recs = object array()
	!recs = !!DrawingPlan1DimLines(!name)
	handle any
		!this.Log(!box & ' -> ' & !nxt & '  dimlines: DrawingPlan1DimLines failed: ' & !!error.text)
		return -1
	endhandle
	!f = object FILE(!path)
	!f.open('overwrite')
	handle any
		!this.Log(!box & ' -> ' & !nxt & '  dimlines: cannot write ' & !path & ': ' & !!error.text)
		return -1
	endhandle
	do !r values !recs
		!f.writerecord(!r)
	enddo
	!f.close()
	handle any
	endhandle
	return !recs.size()
endmethod

----------------------------------------------------------------------
-- RevCloud's answer for this revision, copied beside the DXF: what  --
-- .RestoreClouds redraws when the next run takes the clouds off for --
-- its comparison and then leaves the sheet at this revision. not    --
-- fatal: without the copy a skipped sheet loses its clouds, which   --
-- is logged when it happens                                         --
----------------------------------------------------------------------
define method .SaveCloudList(!dxf is STRING, !box is STRING, !nxt is STRING)
	!path = !this.CloudListPath(!dxf)
	!f = object FILE(!path)
	!f.open('overwrite')
	handle any
		!this.Log(!box & ' -> ' & !nxt & '  clouds: cannot write ' & !path & ': ' & !!error.text)
		return
	endhandle
	-- the code first, so .DrawClouds labels a restored set with the
	-- revision it belongs to and not with the one being skipped
	!f.writerecord('revision ' & !nxt)
	do !line values !this.cloudlines
		skip if (!line.trim().part(1).eq('revision'))
		!f.writerecord(!line)
	enddo
	!f.close()
	handle any
	endhandle
	!this.Log(!box & ' -> ' & !nxt & '  clouds: list kept in ' & !path)
endmethod

----------------------------------------------------------------------
-- the clouds of the sheet's current revision put back, from the    --
-- list kept beside that revision's DXF (!prev, the file .Compare   --
-- diffed against). for a sheet whose clouds came off for the       --
-- comparison and which is not being revised after all. '' =        --
-- success or nothing to do, otherwise the error text               --
----------------------------------------------------------------------
define method .RestoreClouds(!ref is STRING, !box is STRING, !nxt is STRING, !prev is STRING) is STRING
	if (!prev.eq('')) then
		return ''
	endif
	!path = !this.CloudListPath(!prev)
	!f = object FILE(!path)
	if (not !f.exists()) then
		!this.Log(!box & ' -> ' & !nxt & '  clouds: WARNING the clouds of ' & !this.BoxName(!ref) & ' were taken off for the comparison and no list to redraw them from exists (' & !path & '). draw them again by revising, or accept the loss')
		return 'no cloud list to restore from: ' & !path
	endif
	!f.open('read')
	handle any
		return 'cannot read ' & !path & ': ' & !!error.text
	endhandle
	!this.cloudlines = !f.readfile()
	!f.close()
	!errtxt = !this.DrawClouds(!ref, !box, !nxt, true, 'diff')
	if (!errtxt.eq('')) then
		!this.Log(!box & ' -> ' & !nxt & '  clouds: restored from ' & !path)
	endif
	return !errtxt
endmethod

----------------------------------------------------------------------
-- the clouds off the sheet: before the comparison, so the temporary --
-- export is clean, and again before the snapshot, which must be    --
-- the clean picture. every NOTE under the sheet that is the cloud  --
-- note by name OR carries FUNC REVCLOUD goes -- not just the one   --
-- the name resolves to, so a stale or renamed one cannot survive a --
-- revision. how many went is left in .cleared. '' = success        --
----------------------------------------------------------------------
define method .ClearClouds(!ref is STRING, !box is STRING, !nxt is STRING) is STRING
	!note = !this.CloudNote(!ref)
	if (!note.eq('')) then
		return 'sheet ' & !ref & ' has no name, cannot place NOTE .../REVCLOUD'
	endif
	!notes = object array()
	var !notes coll all note for $!ref
	handle any
		return 'cannot collect the NOTEs of ' & !ref & ': ' & !!error.text
	endhandle
	!this.cleared = 0
	!ndel = 0
	do !n values !notes
		!nname = ''
		var !nname name of $!n
		handle any
			!nname = ''
		endhandle
		!nfunc = ''
		var !nfunc func of $!n
		handle any
			!nfunc = ''
		endhandle
		skip if (!nname.trim().neq(!note) and !nfunc.trim().upcase().neq('REVCLOUD'))
		!nav = true
		$!n
		handle any
			!nav = false
		endhandle
		if (not !nav) then
			return 'cannot reach old clouds ' & !n & ' (' & !nname & ')'
		endif
		DELETE NOTE
		handle any
			return 'cannot delete old clouds ' & !n & ' (' & !nname & '): ' & !!error.text
		endhandle
		!ndel = !ndel + 1
	enddo
	!this.cleared = !ndel
	if (!ndel.gt(0)) then
		!this.Log(!box & ' -> ' & !nxt & '  clouds: ' & !ndel & ' old cloud note(s) deleted of ' & !notes.size() & ' NOTE(s) under the sheet')
	endif
	return ''
endmethod

----------------------------------------------------------------------
-- new clouds, after the snapshot and the DXF (neither carries them).--
-- NOTE <sheet>/REVCLOUD is rebuilt                                  --
-- from RevCloud's answer when clouds are wanted and there is        --
-- something to draw. one OUTL per 'cloud' record -- a scalloped    --
-- band hugging the changed geometry, and a change shaped like a    --
-- frame sends a second record for the band's inner edge (user      --
-- sketch 2026-09-14: not a box round everything) -- red line, no   --
-- fill, vertices straight from the 'v x y' records (sheet mm ==    --
-- DXF mm). BrightRed, not Red: DRAFT's Red is RGB 189,0,0 and      --
-- DXFOUT only writes a plain ACI index when the RGB sits within 4  --
-- of its own palette entry (ACI 12 there is 166,0,0), so Red goes  --
-- out as true colour 420=189,0,0 and a monochrome CTB keyed on     --
-- ACI 1 still plots it red. BrightRed is 255,0,0 = ACI 1 exactly,  --
-- so the DXF gets '62 1' and nothing else (2026-09-18).            --
-- then one revision triangle per outer ring, the code              --
-- from a 'revision <code>' line when the lines come from a kept    --
-- list, otherwise the code being issued.                           --
-- the next comparison takes them off the sheet first (see          --
-- .ClearClouds), so nothing here has to be recognisable later. '' = --
-- success, otherwise the error text                                --
----------------------------------------------------------------------
define method .DrawClouds(!ref is STRING, !box is STRING, !nxt is STRING, !wantcloud is BOOLEAN, !cmp is STRING) is STRING
	!note = !this.CloudNote(!ref)
	if (!note.eq('')) then
		return 'sheet ' & !ref & ' has no name, cannot place NOTE .../REVCLOUD'
	endif

	if (not !wantcloud) then
		if (!this.cloudfrom.eq('')) then
			!this.Log(!box & ' -> ' & !nxt & '  clouds: no CLOUD line in the sequence file, none drawn')
		else
			!this.Log(!box & ' -> ' & !nxt & '  clouds: ' & !nxt & ' is before CLOUD code ' & !this.cloudfrom & ', none drawn')
		endif
		return ''
	endif
	if (!cmp.neq('diff')) then
		!this.Log(!box & ' -> ' & !nxt & '  clouds: nothing to draw (' & !cmp & ')')
		return ''
	endif

	$!ref
	NEW NOTE $!note
	handle any
		return 'NEW NOTE ' & !note & ' failed: ' & !!error.text
	endhandle
	!noteref = !!ce
	FUNC |REVCLOUD|
	handle any
	endhandle
	-- a courtesy only: DXFOUT puts the OUTLs on layer 0 regardless
	-- (2026-09-14); the next comparison deletes the NOTE before
	-- exporting, so the layer never matters
	VLAYRF /REVCLOUD
	handle any
		!this.Log(!box & ' -> ' & !nxt & '  clouds: VLAYRF /REVCLOUD refused (' & !!error.text & '), not needed')
	endhandle

	!ncloud = 0
	!nvert  = 0
	!code   = !nxt
	!boxes  = object array()
	!triat  = object array()
	do !line values !this.cloudlines
		!kw = !line.trim().part(1)
		handle any
			skip
		endhandle
		if (!kw.eq('revision')) then
			!code = !line.trim().part(2)
			handle any
				!code = !nxt
			endhandle
		elseif (!kw.eq('cloud')) then
			-- 'cloud i x1 y1 x2 y2 outer|hole': the box, for the triangle
			!kind = ''
			!kind = !line.trim().part(7)
			handle any
				!kind = ''
			endhandle
			if (!kind.eq('outer')) then
				!boxes.append(!line.trim())
				!triat.append('')
			endif
		elseif (!kw.eq('tri')) then
			-- 'tri i x y': RevCloud's place for the last outer cloud's triangle
			if (!triat.size().gt(0)) then
				!triat[!triat.size()] = !line.trim().part(3) & ' ' & !line.trim().part(4)
				handle any
					!triat[!triat.size()] = ''
				endhandle
			endif
			!!ce = !noteref
			NEW OUTL
			handle any
				return 'NEW OUTL failed: ' & !!error.text
			endhandle
			NLCOLOUR BrightRed
			handle any
				NLCOLOUR Red
				handle any
				endhandle
			endhandle
			FSTYLE OFF
			handle any
			endhandle
			!ncloud = !ncloud + 1
		elseif (!kw.eq('v')) then
			!vx = !line.trim().part(2)
			!vy = !line.trim().part(3)
			NEW VRTX
			handle any
				return 'NEW VRTX failed: ' & !!error.text
			endhandle
			XYPO $!vx $!vy
			handle any
				return 'VRTX XYPO ' & !vx & ' ' & !vy & ' refused: ' & !!error.text
			endhandle
			!nvert = !nvert + 1
		endif
	enddo

	-- the revision triangle at the top right of every outer cloud: an
	-- upright equilateral triangle, side 2.2 x the text height, corner
	-- just off the cloud's box, the code centred a third of the way up
	!hei = !this.revhei.val
	handle any
		!hei = 3.5
	endhandle
	if (!hei.leq(0)) then
		!hei = 3.5
	endif
	-- 2.2, matching .Compare()'s --tri-size above -- keep the two in step
	!side = !hei * 2.2
	!ntri = 0
	!nfree = 0
	do !ib from 1 to !boxes.size()
		!b  = !boxes[!ib]
		!at = !triat[!ib]
		!bx = 0
		!by = 0
		if (!at.neq('')) then
			-- where RevCloud found room
			!bx = !at.part(1).real()
			handle any
				!at = ''
			endhandle
			!by = !at.part(2).real()
			handle any
				!at = ''
			endhandle
		endif
		if (!at.neq('')) then
			!nfree = !nfree + 1
		else
			!bx = !b.part(4).real() + 0.5
			handle any
				skip
			endhandle
			!by = !b.part(5).real() + 0.5
			handle any
				skip
			endhandle
		endif
		-- (no method on a bracketed expression: PML raises (47,15) at run time)
		!rx2 = !bx + !side
		!rxm = !bx + !side / 2
		!ry2 = !by + !side * 0.866
		!ryt = !by + !side * 0.3
		!x1 = !bx.string('D3')
		!x2 = !rx2.string('D3')
		!xm = !rxm.string('D3')
		!y1 = !by.string('D3')
		!y2 = !ry2.string('D3')
		!yt = !ryt.string('D3')
		!!ce = !noteref
		NEW OUTL
		handle any
			return 'NEW OUTL (triangle) failed: ' & !!error.text
		endhandle
		NLCOLOUR BrightRed
		handle any
			NLCOLOUR Red
			handle any
			endhandle
		endhandle
		FSTYLE OFF
		handle any
		endhandle
		LCLOSED true
		handle any
		endhandle
		NEW VRTX
		handle any
			return 'NEW VRTX (triangle) failed: ' & !!error.text
		endhandle
		XYPO $!x1 $!y1
		handle any
			return 'triangle vertex refused: ' & !!error.text
		endhandle
		NEW VRTX
		handle any
			return 'NEW VRTX (triangle) failed: ' & !!error.text
		endhandle
		XYPO $!x2 $!y1
		handle any
			return 'triangle vertex refused: ' & !!error.text
		endhandle
		NEW VRTX
		handle any
			return 'NEW VRTX (triangle) failed: ' & !!error.text
		endhandle
		XYPO $!xm $!y2
		handle any
			return 'triangle vertex refused: ' & !!error.text
		endhandle
		!!ce = !noteref
		!heimm = !hei.string() & 'mm'
		NEW TEXP
		handle any
			return 'NEW TEXP (revision code) failed: ' & !!error.text
		endhandle
		BTEXT |$!code|
		handle any
			return 'revision code text refused: ' & !!error.text
		endhandle
		ORIGIN X $!xm Y $!yt
		handle any
			return 'revision code origin refused: ' & !!error.text
		endhandle
		CHEITX |$!heimm|
		handle any
			return 'revision code height refused: ' & !!error.text
		endhandle
		JUST Centre
		handle any
		endhandle
		ALIGN Hbody
		handle any
		endhandle
		TXCOLOUR BrightRed
		handle any
			TXCOLOUR Red
			handle any
			endhandle
		endhandle
		FONT 1
		handle any
		endhandle
		!ntri = !ntri + 1
	enddo
	!this.Log(!box & ' -> ' & !nxt & '  clouds: ' & !ncloud & ' drawn, ' & !nvert & ' vertices, ' & !ntri & ' triangle(s) marked ' & !code & ' at ' & !hei & 'mm (' & !nfree & ' placed by RevCloud), in ' & !note)
	return ''
endmethod

----------------------------------------------------------------------
-- the batch. no confirmation dialog: the SAVEWORK that must come   --
-- first stores the state the user has already checked, and whether --
-- to save the revisions afterwards is the user's call, not ours    --
----------------------------------------------------------------------
define method .Apply()
	if (not !this.seqok) then
		!!alert.error(!this.seqerr)
		return
	endif

	-- run against what is on screen, not against a stale scan
	!this.Refresh()
	!todo = 0
	do !i from 1 to !this.shees.size()
		if (!this.nxt[!i].neq('')) then
			!todo = !todo + 1
		endif
	enddo
	if (!todo.eq(0)) then
		!!alert.error('Nothing to do: no sheet has a next revision')
		return
	endif

	-- RVAU is always the Windows account: Q LOGIN, not Q USER (the E3D
	-- user, usually SYSTEM). user decision 2026-09-14: no Author field,
	-- nothing to edit here
	var !author login
	!author = !author.trim()
	!save   = !!ce
	!cf = !this.cloudfrom
	if (!cf.eq('')) then
		!cf = '(none)'
	endif
	!this.Log('---- Apply: ' & !todo & ' sheet(s), author ' & !author & ', clouds from ' & !cf & ', skip unchanged ' & !this.skipsame.val.string() & ', RevCloud ' & !this.cloudexe)

	-- what each sheet holds right now, so a run explains itself afterwards
	do !i from 1 to !this.shees.size()
		!ref = !this.shees[!i]
		var !revs coll all revi for $!ref
		handle any
			!revs = object array()
		endhandle
		!desc = ''
		do !r values !revs
			!rv = ''
			!st = ''
			var !rv rvsn of $!r
			handle any
			endhandle
			var !st stext of $!r
			handle any
			endhandle
			!flag = 'complete'
			if (!st.trim().eq('') or !st.trim().upcase().eq('UNSET')) then
				!flag = 'no stext'
			endif
			!desc = !desc & ' [' & !r & ' rvsn=' & !rv.trim() & ' ' & !flag & ']'
		enddo
		!this.Log(!this.BoxName(!ref) & '  revis=' & !revs.size() & !desc & '  cur=' & !this.cur[!i] & ' next=' & !this.nxt[!i] & ' reuse=' & !this.reuse[!i])
	enddo

	-- one SAVEWORK for the whole batch, and only when there is something to save
	!session = current session
	if (!session.modified()) then
		!errtxt = ''
		SAVEWORK
		handle any
			!errtxt = !!error.text
		endhandle
		if (!errtxt.neq('')) then
			!this.Log('SAVEWORK failed: ' & !errtxt)
			!!alert.error('SAVEWORK failed, nothing was revised: ' & !errtxt)
			return
		endif
		!this.Log('SAVEWORK done')
	else
		!this.Log('SAVEWORK skipped, nothing modified')
	endif

	!fails   = object array()
	!skipped = object array()
	!done    = 0
	do !i from 1 to !this.shees.size()
		!nxt = !this.nxt[!i]
		skip if (!nxt.eq(''))
		!ref    = !this.shees[!i]
		!box    = !this.BoxName(!ref)
		!ok     = true
		!step   = ''
		!errtxt = ''
		!stamp  = !this.NowStamp()

		--------------------------------------------------------------
		-- 0  the previous clouds off, then compare with the previous --
		--    revision's DXF. clouds are wanted from the CLOUD code   --
		--    on; the comparison is also what tells an unchanged      --
		--    sheet apart, and with the toggle on such a sheet is     --
		--    skipped: no REVI, and its clouds put back from the list --
		--    kept beside its DXF. the same when the comparison       --
		--    itself fails, so a failed sheet is not left bare        --
		--------------------------------------------------------------
		!wantcloud = false
		if (!this.cloudfrom.neq('')) then
			!wantcloud = !this.SeqIndex(!nxt).geq(!this.SeqIndex(!this.cloudfrom))
		endif
		!this.cloudlines = object array()
		!this.cleared = 0
		!cmp = 'none'
		if (!wantcloud or !this.skipsame.val) then
			!step = 'clear clouds'
			!errtxt = !this.ClearClouds(!ref, !box, !nxt)
			if (!errtxt.neq('')) then
				!ok = false
			endif
		endif
		if (!ok and (!wantcloud or !this.skipsame.val)) then
			!step = 'compare'
			!cmp  = !this.Compare(!i, !box, !nxt)
			if (!cmp.eq('same') and !this.skipsame.val) then
				!skipped.append(!box & ' (' & !this.cur[!i] & ')')
				!this.Log(!box & ' -> ' & !nxt & '  no change since ' & !this.cur[!i] & ', not revised')
				if (!this.cleared.gt(0)) then
					!errtxt = !this.RestoreClouds(!ref, !box, !nxt, !this.PrevDxf(!i))
					if (!errtxt.neq('')) then
						!this.Log(!box & ' -> ' & !nxt & '  clouds: NOT restored: ' & !errtxt)
					endif
				endif
				skip
			endif
			if (!cmp.neq('none') and !cmp.neq('same') and !cmp.neq('diff')) then
				!ok = false
				!errtxt = !cmp
				if (!this.cleared.gt(0)) then
					!err2 = !this.RestoreClouds(!ref, !box, !nxt, !this.PrevDxf(!i))
					if (!err2.neq('')) then
						!this.Log(!box & ' -> ' & !nxt & '  clouds: NOT restored: ' & !err2)
					endif
				endif
			endif
		endif

		--------------------------------------------------------------
		-- 1  the REVI. an unfinished one carrying this code is taken --
		--    over rather than duplicated. REVD is written now, so   --
		--    SETCOMPDATE REVD lands on the SAVEWORK session above    --
		--------------------------------------------------------------
		if (!this.reuse[!i].neq('')) then
			!step = 'reuse REVI'
			!rstr = !this.reuse[!i]
			$!rstr
			handle any
				!ok = false
				!errtxt = !!error.text
			endhandle
			!this.Log(!box & ' -> ' & !nxt & '  taking over unfinished REVI ' & !rstr)
		else
			!step = 'NEW REVI'
			-- NEW with CE on the sheet inserts as its FIRST member, and E3D
			-- calls the LAST REVI in member order the latest (the GUI's own
			-- revisions go at the very end, after NOTE etc. -- seen
			-- 2026-09-13). so stand on the last member first, then NEW puts
			-- the REVI after it. an empty sheet leaves CE on the sheet
			$!ref
			LAST MEM
			handle any
			endhandle
			NEW REVI
			handle any
				!ok = false
				!errtxt = !!error.text
			endhandle
			!this.Log(!box & ' -> ' & !nxt & '  NEW REVI')
		endif
		if (!ok) then
			!revi = !!ce
			!step = 'RVSN'
			RVSN |$!nxt|
			handle any
				!ok = false
				!errtxt = !!error.text
			endhandle
		endif
		if (!ok) then
			!step = 'REVD'
			!errtxt = !this.SetRevd(!stamp)
			if (!errtxt.neq('')) then
				!ok = false
			endif
		endif
		if (!ok) then
			!step = 'RVAU'
			RVAU |$!author|
			handle any
				!ok = false
				!errtxt = !!error.text
			endhandle
		endif

		--------------------------------------------------------------
		-- 1b the previous revision's clouds off, before the snapshot: --
		--    the snapshot is the clean picture (user decision        --
		--    2026-09-14). usually nothing left after step 0; this is --
		--    the sweep for a sheet that was not compared             --
		--------------------------------------------------------------
		if (!ok) then
			!step = 'clear clouds'
			!errtxt = !this.ClearClouds(!ref, !box, !nxt)
			if (!errtxt.neq('')) then
				!ok = false
			endif
			!!ce = !revi
			handle any
			endhandle
		endif

		--------------------------------------------------------------
		-- 1c freeze the component labels on the page (OSET FALSE)   --
		--    while the sheet still matches the model -- see the     --
		--    header. a label that refuses is logged, not fatal      --
		--------------------------------------------------------------
		if (!ok) then
			!step = 'freeze labels'
			!errtxt = !this.FreezeLabels(!ref, !box, !nxt)
			if (!errtxt.neq('')) then
				!ok = false
			endif
			!!ce = !revi
			handle any
			endhandle
		endif

		--------------------------------------------------------------
		-- 2  snapshot. PmlRevisionControl acts on the sheet that is --
		--    current in the canvas -- whether PmlLoadSheet can stand --
		--    in for that is the open test in the Notion toggle. if   --
		--    it turns out the canvas must be switched, this is where --
		--    that goes                                               --
		--------------------------------------------------------------
		if (!ok) then
			!step = 'CreateSnapshot'
			-- the file-top using namespace did not reach this scope (46,87 on
			-- 2026-09-13); the grid only works because its namespace is
			-- repeated inside the method, so do the same here
			using namespace 'Aveva.Pdms.SDInteraction.UI.Gui.RevisionControl'
			!rc = object PmlRevisionControl()
			handle any
				!ok = false
				!errtxt = !!error.text
			endhandle
		endif
		if (!ok) then
			-- without an explicit sheet the API found no revision at all on
			-- 2026-09-13: (40,152) Unable to find revision A while the GUI
			-- listed A. the manual says a sheet opened with PmlLoadSheet
			-- takes precedence over the canvas sheet even in graphical
			-- mode, so give it the sheet explicitly. the bare calls stay
			-- as fallbacks and everything is logged
			!snap = false
			!loaded = false
			using namespace 'Aveva.Pdms.SDInteraction.UI.Process'
			!ld = object PmlLoadSheet()
			handle any
				!this.Log(!box & ' -> ' & !nxt & '  PmlLoadSheet not available: ' & !!error.text)
			elsehandle none
				!ld.Open(!ref.dbref())
				handle any
					!this.Log(!box & ' -> ' & !nxt & '  PmlLoadSheet.Open refused: ' & !!error.text)
				elsehandle none
					!loaded = true
				endhandle
			endhandle
			if (!loaded) then
				!rc.CreateSnapshot(!revi)
				handle any
					!errtxt = !!error.text
					!this.Log(!box & ' -> ' & !nxt & '  CreateSnapshot(dbref) after PmlLoadSheet refused: ' & !errtxt)
				elsehandle none
					!snap = true
					!this.Log(!box & ' -> ' & !nxt & '  CreateSnapshot(dbref) after PmlLoadSheet accepted')
				endhandle
				!ld.Close()
				handle any
				endhandle
			endif
			if (not !snap) then
				!rc.CreateSnapshot(!revi)
				handle any
					!errtxt = !!error.text
				elsehandle none
					!snap = true
				endhandle
			endif
			if (not !snap) then
				!this.Log(!box & ' -> ' & !nxt & '  CreateSnapshot(dbref) refused: ' & !errtxt)
				!rc.CreateSnapshot(!nxt)
				handle any
					!errtxt = !!error.text
				elsehandle none
					!snap = true
					!this.Log(!box & ' -> ' & !nxt & '  CreateSnapshot(rvsn string) accepted')
				endhandle
			endif
			if (not !snap) then
				!this.Log(!box & ' -> ' & !nxt & '  CreateSnapshot(rvsn string) refused: ' & !errtxt)
				$!ref
				!rc.CreateSnapshot(!nxt)
				handle any
					!errtxt = !!error.text
				elsehandle none
					!snap = true
					!this.Log(!box & ' -> ' & !nxt & '  CreateSnapshot(rvsn string, CE on sheet) accepted')
				endhandle
			endif
			if (not !snap) then
				!ok = false
			endif
		endif

		--------------------------------------------------------------
		-- 3  the picture file name, read AFTER the snapshot because --
		--    CreateSnapshot bumps the PVNO on the end of it         --
		--------------------------------------------------------------
		if (!ok) then
			!step = 'PICF'
			!picf = ''
			$!ref
			var !picf picf
			handle any
				var !picf picfilename
				handle any
					!ok = false
					!errtxt = !!error.text
				endhandle
			endhandle
			if (!ok and !picf.trim().eq('')) then
				!ok = false
				!errtxt = 'PICF is empty'
			endif
		endif

		--------------------------------------------------------------
		-- 4  DXF next to the picture file: <PICF>_<code>.dxf. the    --
		--    code is in the name because PICF does not move when     --
		--    the sheet was not changed and saved since the previous  --
		--    revision, and every revision keeps its own file (user   --
		--    decision 2026-09-14). .Compare knows this naming and   --
		--    the plain <PICF>.dxf the 2026-09-13 runs left behind    --
		--------------------------------------------------------------
		if (!ok) then
			!step = 'DXF'
			!dxf = !this.PicPath(!picf.trim())
			if (!dxf.eq('')) then
				!ok = false
				!errtxt = 'cannot resolve ' & !picf
			else
				!dxf = !dxf & '_' & !nxt & '.dxf'
				$!ref
				LIEXEC /Draft_DXF_LI 'DXFOUT' OutputF '$!dxf'
				handle any
					!ok = false
					!errtxt = !!error.text
				endhandle
				-- and the sheet's projection lines beside it, for the
				-- next comparison's old side (.WriteDimLines). not fatal
				if (!ok) then
					!dlp = !this.DimLinesPath(!dxf)
					!ndl = !this.WriteDimLines(!ref, !dlp, !box, !nxt)
					if (!ndl.geq(0)) then
						!this.Log(!box & ' -> ' & !nxt & '  dimlines: ' & !ndl & ' projection line(s) kept in ' & !dlp)
					endif
				endif
			endif
		endif

		--------------------------------------------------------------
		-- 4b new clouds, after the snapshot AND the DXF so neither   --
		--    carries them: both are the clean record, clouds are for --
		--    the sheet and the plot (user decision 2026-09-14). drawn --
		--    when this code is at or past the CLOUD line and the     --
		--    comparison found something                              --
		--------------------------------------------------------------
		if (!ok) then
			!step = 'clouds'
			!errtxt = !this.DrawClouds(!ref, !box, !nxt, !wantcloud, !cmp)
			if (!errtxt.neq('')) then
				!ok = false
			else
				if (!wantcloud and !cmp.eq('diff')) then
					!this.SaveCloudList(!dxf, !box, !nxt)
				endif
			endif
			!!ce = !revi
			handle any
			endhandle
		endif

		--------------------------------------------------------------
		-- 5  STEXT last: it is the "finished" flag Refresh looks for --
		--------------------------------------------------------------
		if (!ok) then
			!step = 'STEXT'
			!pv = !picf.trim()
			!!ce = !revi
			STEXT |$!pv|
			handle any
				!ok = false
				!errtxt = !!error.text
			endhandle
		endif

		if (!ok) then
			!done = !done + 1
			!this.Log(!box & ' -> ' & !nxt & '  OK  ' & !picf.trim())
		else
			!fails.append(!box & ' -> ' & !nxt & ' (' & !step & ')')
			!this.Log(!box & ' -> ' & !nxt & '  FAILED at ' & !step & ': ' & !errtxt)
		endif
	enddo

	!!ce = !save
	handle any
	endhandle
	!this.Log('---- Apply end: ' & !done & ' OK, ' & !skipped.size() & ' skipped (no change), ' & !fails.size() & ' failed')
	!this.Refresh()

	-- no dialog when every sheet went through: the Current column has
	-- just moved to the new code, which says it already (user decision
	-- 2026-09-14). a sheet that was skipped or failed is a different
	-- matter -- left to the log alone it is exactly the one that gets
	-- missed the morning after a batch run, so those are still shouted
	if (!skipped.size().eq(0) and !fails.size().eq(0)) then
		return
	endif
	!msg = 'Revision finished: ' & !done & ' OK, ' & !skipped.size() & ' skipped (no change), ' & !fails.size() & ' failed.'
	if (!skipped.size().gt(0)) then
		!msg = !msg & ' Skipped: '
		do !k from 1 to !skipped.size()
			if (!k.gt(1)) then
				!msg = !msg & '; '
			endif
			!msg = !msg & !skipped[!k]
		enddo
		!msg = !msg & '.'
	endif
	if (!fails.size().gt(0)) then
		!msg = !msg & ' Failed: '
		do !k from 1 to !fails.size()
			if (!k.gt(1)) then
				!msg = !msg & '; '
			endif
			!msg = !msg & !fails[!k]
		enddo
		!msg = !msg & '.'
	endif
	!msg = !msg & ' See ' & !this.projcode & '_REV.log in ' & !this.seqdir
	if (!fails.size().gt(0)) then
		!!alert.error(!msg)
	else
		!!alert.message(!msg)
	endif
endmethod

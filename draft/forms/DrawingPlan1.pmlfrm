define method .ReduAnnotation(!name is string)
	NEW LAYE $!name/SS/S1/V1/ateREDU_R$!this.rev
	Purpose REDU
	Lvisibility true
	Ucode mm  Distance  mm  Bore Nominal 
	Font 1
	Lterminator Off
	Justification Centre
	Alignment Hbody
	Dterminator Arrows
	Tsize 2mm
	Chosht 6mm
	Asubtended 0
	Pjustification Towards 
	Overshoot 2mm
	Plclearance 0mm
	Doffset 25mm
	Dmspacing 0mm
	Cheight 3mm
	Lleader true
	Lframe false
	Lshape Straight
	Gbox 0mm
	Cspacing 0
	Lspacing 0
	Llclearance 0mm
	Xyscale 1 1
	Xyposition 10mm 10mm 
	Bpoffset 0mm 0mm
	Blnk true
	Bmargin 0mm
	Trsf unset
	Fterminator Default
	Pcode mms to 0 dpls  Inches to 1 dpls  Fractions to 32 ths  Angles to 1 dpls 
	NLStyle Solid 
	NLColour Cyan 
	FStyle SolidFilled 
	FColour Cyan 
	Txcolour yellow 
	LLStyle Solid 
	LLColour Cyan 
	LFStyle Solid 
	LFColour Cyan 
	DLStyle Solid 
	DLColour Grey 
	PLStyle Solid 
	PLColour Grey 
	MStyle Off 
	MColour Cyan 
	CHStyle Off 
	CHColour Grey 
	ACDSTY unset
	Posformat ENU
	Grsystem Nulref
	SpPurpose unset
	Function unset
	
	!ff = object file('D:\Documents\Python\WriteLabelToText.txt')
	!ff.open('append')

	var !redus vscan for all (redu tee)
	do !redu values !redus
		!redu = !redu.part(2)
		var !pdir p1 dir of $!redu
		---------------------------------------------------
		-- only tag tee/reducer for horizontal direction --
		---------------------------------------------------
		if not(!pdir.direction().eq(object direction('U')) or !pdir.direction().eq(object direction('D'))) then
			var !type type of $!redu
			!btext = ''
			if (!type.eqnocase('REDU')) then
				!btext = '#P1BOR<FROM ' & !redu & '>x' & '#P2BOR<FROM ' & !redu & '> RC'
			else
				var !p1bore p1 bore of $!redu
				var !p3bore p3 bore of $!redu
				if (!p1bore.neq(!p3bore)) then
					!btext = '#P1BOR<FROM ' & !redu & '>x' & '#P3BOR<FROM ' & !redu & '> RT'
				endif
			endif
			if (!btext neq '') then
				NEW GLAB
				DDNA $!redu
				BTEXT |$!btext|
				Justification Centre
				Alignment Hbody
				ABSO
				var !apos ( pos of $!redu wrt worl )
				var !apos1 shpos of $!apos
				AT $!apos1
				XYPO 10 10
				
				------------------------------------------------------------------
				-- save label info. in D:\Documents\Python\WriteLabelToText.txt --
				------------------------------------------------------------------
				var !label ref
				!shposx = !apos1.part(2).replace('mm', '')
				!shposy = !apos1.part(4).replace('mm', '')
				var !chei chei
				if !chei.eqnocase('ByVStyle') then
					var !chei chei of owner
				endif
				var !exbtext exbtext
				!height = !chei.replace('mm', '').real() + 0.5
				!width = !exbtext.length() * !height * 0.65  $( 0.65 is text width factor $)
				
				!ff.writerecord(!label & ' ' & !shposx & ' ' & !shposy & ' ' & !width & ' ' & !height & ' box')

			endif
		endif
	enddo
	!ff.close()

endmethod


import 'AteSortLineNo'
handle any
endhandle
import 'PMLFileBrowser'
handle any
endhandle

layout form !!DrawingPlan1 dialog dock
	!this.formTitle = 'Drawing Options'
	
	frame .tabset tabset
		frame .drawings 'Drawing' width 40
			frame .hiera
				list   .files1 'All'    multiple width 25 height 10
				button .addce  ' >'     at xmax.files1+0.4 ymin.files1+1 width 3 call '!This.selectce()'
				button .addall '>>'     at xmin.addce  ymax.addce+0.6  width 3 call '!This.selectall()'
				button .remce  ' <'     at xmin.addce  ymax.addall+0.6 width 3 call '!This.removece()'
				button .remall '<<'     at xmin.addce  ymax.remce+0.6  width 3 call '!This.removeall()'
				list   .files  'In Use' at xmax.addce+0.5 ymin.files1 multiple width 25 height 10
        
        
--				button .import 'Import'     at xmin.addce  ymax.addce+0.2  width 12 call '!This.importfile()'
--				button .export 'Export'     at xmin.addce  ymax.import+0.2 width 12 call '!This.exportfile()'
--				button .sort   'Sort  '     at xmin.addce  ymax.export+0.2 width 12 call '!This.sortce()'
			exit
			text .dest     'Destination'     at xmin.hiera ymax.hiera+0.5 width 33 is string 
			button .desbut 'CE'              at xmax.dest+0.1 ymin.dest width 6 call '!This.desce()'
			button .apply  'Create Drawings' at xmin.dest ymax.dest+0.5 width 23 call '!This.Apply()'
			button .Cancel 'Cancel'          at xmax.apply+15 ymin.apply width 12 call '!This.Close()'
		exit
		frame .viewframe 'View' width 40
			text .frametext 'Backing Sheet' tagwidth 20 width 30 is string 
			button .framebutn 'CE' at xmax.frametext+0.4 ymin.frametext width 5 call |!This.typepick('BACK', 'frametext')|
			paragraph .framepara at xmax.framebutn+0.5 ymin.framebutn+0.1 text 'BACK'
			text .rrsftext 'Representation Style' at xmin.frametext ymax.frametext+0.1 tagwidth 20 width 30 is string 
			button .rrsfbutn 'CE' at xmax.rrsftext+0.4 ymin.rrsftext width 5 call |!This.typepick('RRST', 'rrsftext')|
			paragraph .rrsfpara at xmax.rrsfbutn+0.5 ymin.rrsfbutn+0.1 text 'RRST'
			text .hrsftext 'Hatching Style' at xmin.rrsftext ymax.rrsftext+0.1 tagwidth 20 width 30 is string
			button .hrsfbutn 'CE' at xmax.hrsftext+0.4 ymin.hrsftext width 5 call |!This.typepick('HRST', 'hrsftext')|
			paragraph .hrsfpara at xmax.hrsfbutn+0.5 ymin.hrsfbutn+0.1 text 'HRST'
			button .palibybutn 'Import PA-LIBY' at xmin.hrsftext ymax.hrsftext+0.1 width 15 call |!This.ImportPaLiby()|
			list .excllist 'Exclude from View' at xmin.hrsftext ymax.palibybutn+0.2 multiple width 34 height 4
			-- +0.75 drops the three buttons clear of the list's own tag row, so that
			-- Add CE lines up with the top of the list box and not with the label
			button .excladdbutn 'Add CE'     at xmax.excllist+0.5 ymin.excllist+0.75  width 12 call '!This.ExclAddCe()'
			button .exclrembutn 'Remove CE'  at xmin.excladdbutn  ymax.excladdbutn+0.3 width 12 call '!This.ExclRemoveCe()'
			button .exclallbutn 'Remove All' at xmin.excladdbutn  ymax.exclrembutn+0.3 width 12 call '!This.ExclRemoveAll()'
			option .scaleopt 'Drawing Scale' at xmin.excllist ymax.excllist+0.3 tagwidth 20 width 10
			text .scaletext 'User Define' at xmax.scaleopt+1 ymin.scaleopt tagwidth 11 width 10 is string
			toggle .portrait at xmin.frametext ymax.scaletext+0.2 'Portrait to Landscape'
			button .canvas  'Pick Canvas Size' at xmin.portrait ymax.portrait+0.1 width 15 call |!This.canvaspick()|
			paragraph .canvasp at xmax.canvas+1 ymin.canvas text 'X unset Y unset' width 25
			toggle .openshee at xmin.canvas ymax.canvas+0.1   'Open SHEE after finish'
			toggle .delshee  at xmin.openshee ymax.openshee+0.1 'Overwrite Existing DRWG'
			
			button .save   'Save'   at xmin.delshee   ymax.delshee+0.4 width 6 call '!This.Save()'
			button .load   'Load'   at xmax.save+0.8  ymin.save        width 6 call '!This.Load()'

		exit
		frame .info 'BorderText' width 40
			text .dwgnopos  'Dwg.No. position'                                       tagwidth 15 width 10 is string
			text .dwgnohei  'Text height'     at xmax.dwgnopos+2  ymin.dwgnopos      tagwidth 10 width 5 is string
			text .scalepos  'Scale position'  at xmin.dwgnopos    ymax.dwgnopos      tagwidth 15 width 10 is string
			text .scalehei  'Text height'     at xmax.scalepos+2  ymin.scalepos      tagwidth 10 width 5 is string
			text .revpos    'Rev position'    at xmin.dwgnopos    ymax.scalepos      tagwidth 15 width 10 is string
			text .revhei    'Text height'     at xmax.revpos+2    ymin.revpos        tagwidth 10 width 5 is string
			text .title1pos 'Title1 position' at xmin.revpos      ymax.revpos+0.2    tagwidth 15 width 10 is string 
			text .title1hei 'Text height'     at xmax.title1pos+2 ymin.title1pos     tagwidth 10 width 5 is string 
			text .title2pos 'Title2 position' at xmin.revpos      ymax.title1pos+0.2 tagwidth 15 width 10 is string 
			text .title2hei 'Text height'     at xmax.title2pos+2 ymin.title2pos     tagwidth 10 width 5 is string 
			text .title3pos 'Title3 position' at xmin.revpos      ymax.title2pos+0.2 tagwidth 15 width 10 is string 
			text .title3hei 'Text height'     at xmax.title3pos+2 ymin.title3pos     tagwidth 10 width 5 is string 
			text .name1pos  'Name1 position'  at xmin.revpos      ymax.title3pos+0.2 tagwidth 15 width 10 is string 
			text .name1hei  'Text height'     at xmax.name1pos+2  ymin.name1pos      tagwidth 10 width 5 is string 
			text .name2pos  'Name2 position'  at xmin.revpos      ymax.name1pos+0.2  tagwidth 15 width 10 is string 
			text .name2hei  'Text height'     at xmax.name2pos+2  ymin.name2pos      tagwidth 10 width 5 is string 
			text .name3pos  'Name3 position'  at xmin.revpos      ymax.name2pos+0.2  tagwidth 15 width 10 is string 
			text .name3hei  'Text height'     at xmax.name3pos+2  ymin.name3pos      tagwidth 10 width 5 is string 
			text .date1pos  'Date1 position'  at xmin.revpos      ymax.name3pos+0.2  tagwidth 15 width 10 is string 
			text .date1hei  'Text height'     at xmax.date1pos+2  ymin.date1pos      tagwidth 10 width 5 is string 
			text .date2pos  'Date2 position'  at xmin.revpos      ymax.date1pos+0.2  tagwidth 15 width 10 is string 
			text .date2hei  'Text height'     at xmax.date2pos+2  ymin.date2pos      tagwidth 10 width 5 is string 
			text .date3pos  'Date3 position'  at xmin.revpos      ymax.date2pos+0.2  tagwidth 15 width 10 is string 
			text .date3hei  'Text height'     at xmax.date3pos+2  ymin.date3pos      tagwidth 10 width 5 is string 
		exit
		frame .fra 'Keyplan'
			text .keyovertext 'KeyPlan' tagwidth 22 width 27 is string
			button .keyoverbutn 'CE' at xmax.keyovertext+0.4 ymin.keyovertext width 5 call |!This.typepick('OVER', 'keyovertext')|
			paragraph .keyoverpara at xmax.keyoverbutn+0.5 ymin.keyoverbutn+0.1 text 'OVER'
			text .keytext1 'Lower Left Paper Coord.' tagwidth 22 at xmin.keyovertext ymax.keyovertext+0.1 width 27 is string
			button .keybutn1 'Pick' at xmax.keytext1+0.4 ymin.keytext1 width 5 call |!This.keyplanpick()|
			text .keytext2 'Lower Left Model Coord.  E'  tagwidth 22 at xmin.keytext1 ymax.keytext1+0.1 width 11 is string 
			text .keytext3 'N' at xmax.keytext2+2 ymin.keytext2 width 11 is string 
			text .keytext4 'Keyplan Scale'  tagwidth 22 at xmin.keytext2 ymax.keytext2+0.1 width 27 is string
			text .keytext5 'Keyplan Y axis is'  tagwidth 22 at xmin.keytext2 ymax.keytext4+0.1 width 27 is string
		exit
		frame .northarrow 'NorthArrow'
			text .northtext 'North Arrow' tagwidth 22 width 27 is string
			button .northbutn 'CE' at xmax.northtext+0.4 ymin.northtext width 5 call |!This.typepick('SYTM', 'northtext')|
			paragraph .northpara at xmax.northbutn+0.5 ymin.northbutn+0.1 text 'SYTM'
			text .northsca 'Scale' tagwidth 22 at xmin.northtext ymax.northtext+0.1 width 27 is real
			text .northpostext 'POS' tagwidth 22 at xmin.northsca ymax.northsca+0.1 width 27 is string
			button .northposbutn 'Pick' at xmax.northpostext+0.4 ymin.northpostext width 5 call |!This.northarrowpick()|
		exit
		frame .flowarrow 'FlowArrow'
			---------------------------------------------------------------------
			-- the symbol drawn on a pipe to show which way it flows. the CE    --
			-- button goes through .typepick(), so the field only ever takes a  --
			-- SYTM and says so instead of accepting whatever CE happens to be  --
			---------------------------------------------------------------------
			text .flowtext 'Flow Arrow' tagwidth 22 width 27 is string
			button .flowbutn 'CE' at xmax.flowtext+0.4 ymin.flowtext width 5 call |!This.typepick('SYTM', 'flowtext')|
			paragraph .flowpara at xmax.flowbutn+0.5 ymin.flowbutn+0.1 text 'SYTM'
			text .flowsca 'Scale' tagwidth 22 at xmin.flowtext ymax.flowtext+0.1 width 27 is real
		exit
		frame .gridframe 'Grid'
			text .griddist 'Distance'    tagwidth 10 width 6 is real
			text .gridgap  'Gap'         tagwidth 10 at xmin.griddist ymax.griddist+0.1 width 6 is real
			text .gridhei  'Text Height' tagwidth 10 at xmin.gridgap  ymax.gridgap+0.1  width 6 is real
			text .griddia  'Diameter'    tagwidth 10 at xmin.gridhei  ymax.gridhei+0.1  width 6 is real
--			para .sketch at xmax.griddist+2 ymin.griddist pixmap width 5 height 5
		exit
		frame .anno 'Annotation'
			--------------------------------------------------------------
			-- text heights: one field per thing the user can see, each  --
			-- feeding EVERY place that height is written. .annotext     --
			-- keeps its gadget name so settings files saved by an older --
			-- form still load; only its label changed, from the far too --
			-- broad 'Text Height' to what it actually drives -- the     --
			-- five component label layers and the support symbol        --
			--------------------------------------------------------------
			text .annotext  'Component Label Height' tagwidth 22 width 6 is string
			text .lineheitx 'Pipe Label Height'      tagwidth 22 at xmin.annotext ymax.annotext+0.1 width 6 is real
			text .equiheitx 'Equipment Name Height'  tagwidth 22 at xmin.lineheitx ymax.lineheitx+0.1 width 6 is real
			text .dimheitx  'Dimension Text Height'  tagwidth 22 at xmin.equiheitx ymax.equiheitx+0.1 width 6 is real
			--------------------------------------------------------------
			-- the match line text used to read .dwgnohei -- the Dwg.No.  --
			-- height on the BorderText tab -- so changing the drawing    --
			-- number in the title block silently resized every match     --
			-- line callout on the sheet, from another tab. string, not   --
			-- real, because the call sites pass it straight through as   --
			-- cheitx |<val>| the way .dwgnohei always did                --
			--------------------------------------------------------------
			text .matchhei  'Match Line Text Height' tagwidth 22 at xmin.dimheitx ymax.dimheitx+0.1 width 6 is string
			toggle .autoplace at xmin.annotext ymax.matchhei+0.1  'Automatic Label Placement'
			frame .instframe 'Instrument' at xmin.annotext ymax.autoplace+0.1
				toggle .insttog  'Create Label'
				text .insttext1 'Inst Rule'   tagwidth 12 at xmin.insttog ymax.insttog+0.1 width 40 is string
				text .insttext2 'Inst Format' tagwidth 12 at xmin.insttog ymax.insttext1+0.1 width 40 is string
				text .insttext3 'Diameter'    tagwidth 12 at xmin.insttog ymax.insttext2+0.1 width 40 is real
	$(		-- for template reference	
				button .instbutn 'CE' at xmax.insttext2+0.4 ymin.insttext2 width 5 call |!This.typepick('SYTM', 'insttext2')|
				paragraph .instpara at xmax.instbutn+0.5 ymin.instbutn+0.1 text 'SYTM'
	$)			
			exit
			frame .nozzframe 'Nozzle' at xmin.annotext ymax.instframe+0.1
				toggle .nozztog  'Create Label'
				text .nozztext1 'Nozz Rule'   tagwidth 12 at xmin.nozztog ymax.nozztog+0.1  width 40 is string
				text .nozztext2 'Nozz Format' tagwidth 12 at xmin.nozztog ymax.nozztext1+0.1 width 40 is string
			exit
			frame .valvframe 'Valve' at xmin.annotext ymax.nozzframe+0.1
				toggle .valvtog  'Create Label'
				text .valvtext1 'Valv Rule'   tagwidth 12 at xmin.valvtog ymax.valvtog+0.1 width 40 is string
				text .valvtext2 'Valv Format' tagwidth 12 at xmin.valvtog ymax.valvtext1+0.1 width 40 is string
			exit
			frame .suptframe 'Support' at xmin.annotext ymax.valvframe+0.1
				toggle .supttog  'Create Label'
				toggle .supttog1 'Flat Oval Frame'
			exit
			frame .userframe 'User Defined' at xmin.annotext ymax.suptframe+0.1
				toggle .usertog 'Create Label'
				text .usertext1 'Rule'   tagwidth 12 at xmin.usertog ymax.usertog+0.1 width 40 is string
				text .usertext2 'Format' tagwidth 12 at xmin.usertog ymax.usertext1+0.1 width 40 is string
			exit
			frame .reduframe 'Reducer/Red.Tee' at xmin.annotext ymax.userframe+0.1
				toggle .redutog 'Create Label'
				paragraph .redupara at xmax.redutog+35 ymin.redutog text ' '
			exit
		exit
	exit
	
	member .vsca is real
  member .viewULsh is string
  member .viewURsh is string
  member .viewLLsh is string
  member .viewLRsh is string
  
  member .viewUlinesh is line
  member .viewDlinesh is line
  member .viewRlinesh is line
  member .viewLlinesh is line
  
  ------------------------------------------------------------------------
  -- the same four corners for the BOX rather than the view. while the   --
  -- view is placed by the rebuild path the two are the same thing, but  --
  -- an update freezes THPOSITION/XYPOSITION and recalculates SIZE        --
  -- symmetric about the frozen centre, so the side of the box that did  --
  -- not grow ends up inset from the border by the padding. the border   --
  -- is only a reservation of paper after that; the box edge is where    --
  -- the VSEC planes actually cut, so it is what the match line marks    --
  -- and what the view corner dimension points sit on (2026-08-29)       --
  ------------------------------------------------------------------------
  member .boxULsh is string
  member .boxURsh is string
  member .boxLLsh is string
  member .boxLRsh is string
  
  member .boxUlinesh is line
  member .boxDlinesh is line
  member .boxRlinesh is line
  member .boxLlinesh is line
  
  member .maxE is real
	member .minE is real
	member .maxN is real
	member .minN is real
	member .maxU is real
	member .minU is real
	------------------------------------------------------------------------
	-- the world bounding box of the drawing box. .minE .. .maxN above are --
	-- the faces of the box measured along the box's own directions, which --
	-- once the box is turned is the box shrunk by cos(angle), not a box   --
	-- which contains it -- see the comment by LIMITS in .Apply(). these   --
	-- are the values to hand to a world axis aligned COLLECT ... WITHIN,  --
	-- with a check in sheet coordination afterwards to throw away what    --
	-- the wider volume picks up outside the view                          --
	------------------------------------------------------------------------
	member .wmaxE is real
	member .wminE is real
	member .wmaxN is real
	member .wminN is real

	member .intersections is array    $( intersections of the current refgln only  $)
	member .allintersections is array $( intersections of every refgln of the drawing, used by !!DrawingPlan1LineNoAnnotation  $)
	member .canvassize is string
	member .equiparray is array   $( array for equipments are dimensioned $)
	member .userevar is string    $( for path of text file  $)
	member .supttmp is string     $( for support callout template  $)
	member .suptstack is array    $( support labels sharing one point: '<top slab> <line height> <slab below> ...'  $)
	member .blankdir is string    $( folder BlankPos reads and writes, always ends with a backslash  $)
	member .blankexe is string    $( full path of BlankPos.exe  $)
	member .rcode is string       $( view rcode, 'up' or 'left'  $)
	member .labbandup is real       $( how far the annotation reaches past  $)
	member .labbanddown is real     $( the border of the view on each side, $)
	member .labbandleft is real     $( in sheet mm. filled in by            $)
	member .labbandright is real    $( DrawingPlan1LineNoAnnotation         $)
	member .titletop is real        $( sheet y the view title hangs from, set by .RecenterView() $)
	

exit

-------------
-- initial --
-------------
define method .DrawingPlan1()
  !this.frametext.val = |/TT/DRA/PRJ/BACKS/MET/BLACKA1_TEST|
  ------------------------------------------------------------------------
  -- the project's own representation and hatch libraries under /PA-LIBY --
  -- (user, 2026-09-16). .Apply() imports PA-LIBY.txt when a DB does not  --
  -- have them yet, so these defaults work in a fresh project too         --
  ------------------------------------------------------------------------
  !this.rrsftext.val = |/PA-LIBY/REPR/PIPE/GA|
  !this.hrsftext.val = |/PA-LIBY/HRUL/GEN/Hatch-Gen|
	----------------------------------------------------------------------
	-- Import PA-LIBY is live only while the project has no /PA-LIBY     --
	-- (user, 2026-09-25), looked up again on every show: the form stays --
	-- loaded between shows, and meanwhile a Create Drawings, or another --
	-- user's Save Work, may have brought it in                          --
	----------------------------------------------------------------------
	!this.initcall = '!this.PaLibyButton()'
	----------------------------------------------------------------------
	-- the scales a job normally draws at, auto first for the fit the    --
	-- program used to make on its own, Other last for anything not in   --
	-- the list. User Define is the only one which reads the field       --
	-- beside it, and that field takes a whole ratio -- a drawing is not --
	-- always a reduction, 2:1 is as good an answer as 1:30              --
	----------------------------------------------------------------------
	!scales = object array()
	!scales[1] = 'auto'
	!scales[2] = '1:1'
	!scales[3] = '1:2'
	!scales[4] = '1:3'
	!scales[5] = '1:5'
	!scales[6] = '1:10'
	!scales[7] = '1:20'
	!scales[8] = '1:25'
	!scales[9] = '1:30'
	!scales[10] = '1:50'
	!scales[11] = '1:75'
	!scales[12] = '1:100'
	!scales[13] = '1:150'
	!scales[14] = '1:200'
	!scales[15] = '1:250'
	!scales[16] = '1:500'
	!scales[17] = '1:750'
	!scales[18] = '1:1000'
	!scales[19] = '1:1250'
	!scales[20] = '1:2000'
	!scales[21] = '1:2500'
	!scales[22] = 'User Define'
	!this.scaleopt.dtext = !scales
	!this.scaleopt.val = 1
	!this.scaletext.val = ''
	----------------------------------------------------------------------
	-- the callback goes on the gadget here rather than on its line in   --
	-- the layout: an option gadget in this form's dialect will not take --
	-- 'callback' nor 'call' up there (both came back CP: Syntax error,  --
	-- 2026-08-21). assigning the member is how AVEVA's own              --
	-- draft/forms/dralabeloffset.pmlfrm does it                         --
	--                                                                   --
	-- if even that is refused the form still comes up, with the User    --
	-- Define field simply left alive the whole time                     --
	----------------------------------------------------------------------
	!this.scaleopt.callback = '!this.ScalePick()'
	handle any
	endhandle
	!this.ScalePick()
	handle any
	endhandle
  !this.griddist.val = 50
  !this.gridgap.val = 3
  !this.gridhei.val = 4
  !this.griddia.val = 10
	!this.northtext.val = |/DRA/MAS/SYMBOLS/GEN/MISC/P-NARR|
	!this.northsca.val = 1
	!this.flowtext.val = |/DRA/MAS/SYMBOLS/GEN/WELD/WELD-ARR|
	!this.flowsca.val = 1
	!this.rcode = 'up'
	!this.openshee.val = true
	!this.delshee.val = true
	!this.annotext.val = |3|
	!this.lineheitx.val = 3
	!this.equiheitx.val = 4
	!this.dimheitx.val = 3
	!this.matchhei.val = |4|
	!this.autoplace.val=TRUE
	!this.insttog.val=TRUE
	!this.insttext1.val = |ALL INST WITH ISNAMED|
	!this.insttext2.val = |#NAME(P-:1)(C2:)#/#NAME(P-2:)(C2:)|
--	!this.insttext2.val = |/DRA/PRJ/ADP/SCHED/LOCAL/NAME_CIRC|
	!this.insttext3.val = 10
	!this.nozztog.val = TRUE
	!this.nozztext1.val = |ALL NOZZ WITH ISNAMED|
	!this.nozztext2.val = |"#NAME(P/2:)(C2:)"|
	!this.valvtog.val = TRUE
	!this.valvtext1.val = |ALL VALV WITH ISNAMED|
	!this.valvtext2.val = |#NAME(C2:)|
	!this.supttog.val = TRUE
	!this.supttog1.val = TRUE
	!this.usertog.val = FALSE
	!this.usertext1.val=||
	!this.usertext2.val=||
	!this.redutog.val = false
	if !this.userevar.eq('') then
		!this.userevar = 'c:\temp\'
	endif
	--------------------------------------------------------------------
	-- where BlankPos reads and writes. AVEVA_DESIGN_USER is E3D's own --
	-- writable per user area -- PMLLIB's saverestoreview keeps its    --
	-- .dat files there -- so it survives an E3D upgrade and two       --
	-- people on one machine do not share one WriteLabelToText.txt.    --
	-- no sub folder is made: PML has no directory create, and this    --
	-- one is certain to already exist. the old hard coded path is     --
	-- kept as the fallback for an environment without the variable    --
	--------------------------------------------------------------------
	!this.blankdir = !!evar('AVEVA_DESIGN_USER')
	handle any
		!this.blankdir = ''
	endhandle
	if !this.blankdir.eq('') then
		!this.blankdir = 'D:\Documents\Python\'
	endif
	----------------------------------------------------------------
	-- AVEVA's own code concatenates this variable straight onto a  --
	-- file name (saverestoreview.pmlfrm), so it is expected to end --
	-- with a separator. do not rely on that -- put one on if the   --
	-- site has set it without                                      --
	----------------------------------------------------------------
	!nbd    = !this.blankdir.length()
	!lastch = !this.blankdir.substring(!nbd, 1)
	if (not(!lastch.eq('\'))) then
		!this.blankdir = !this.blankdir & '\'
	endif
	--------------------------------------------------------------------
	-- BlankPos.exe lives in a bin folder beside a PML library, so that --
	-- anyone who can load this form can also reach it -- the old hard  --
	-- coded D: path did not exist on every machine (user, 2026-09-09)  --
	--------------------------------------------------------------------
	!this.blankexe = !this.FindOnPmllib('bin\BlankPos.exe')
	!this.dest.active = false
	------------------------------------------
	-- select the first REGI as destination --
	------------------------------------------
	if !this.dest.val.eq('') then
		-------------------------------------------------------------------
		-- this was 'worl / dept 1 / regi 1', which only reaches a REGI    --
		-- when CE happens to be in the DRAFT database. showing the form   --
		-- while CE was a design element (which is now the normal way to   --
		-- work, the View tab's exclude list is filled from model          --
		-- elements) sent 'worl' to the design world and 'dept 1' then     --
		-- raised 'Cannot access element type DEPT from the level of       --
		-- WORLD /*' (2026-08-21). that killed the whole constructor: the  --
		-- BorderText and Keyplan defaults below and .AllBoxes() never     --
		-- ran, so the form came up with both box lists empty              --
		--                                                                 --
		-- an unscoped COLL ALL REGI finds the registries from wherever CE --
		-- is, the way AVEVA's own abaregistry.pmlfrm does it, and it      --
		-- never moves CE. if it finds nothing the field is simply left    --
		-- for the user to set with the CE button                          --
		-------------------------------------------------------------------
		!regis = object array()
		var !regis coll all REGI
		handle any
			!regis = object array()
		endhandle
		-- an empty collect can come back unset, .size() on that would raise --
		if (not(!regis.unset())) then
			if (!regis.size().gt(0)) then
				!firstregi = !regis[1]
				!this.dest.val = !firstregi
			endif
		endif
	endif
	!this.apply.active = false	
	!this.dwgnopos.val = '700,55'
	!this.dwgnohei.val = '3'
	!this.scalepos.val = '740,29'
	!this.scalehei.val = '3'
	!this.revpos.val = '670,55'
	!this.revhei.val = '3'
	!this.title1pos.val = '585,60'
	!this.title1hei.val = '3'
	!this.title2pos.val = '585,55'
	!this.title2hei.val = '3'
	!this.title3pos.val = '585,50'
	!this.title3hei.val = '3'
	!this.keytext1.val = 'X 720 y 70'
	!this.keytext2.val = '-322000'
	!this.keytext3.val = '289000'
	!this.keytext4.val = '0.0025'
	!this.keytext5.val = 'N'
	
	!this.AllBoxes()
	
--	!this.sketch.addPixmap(!!pml.getPathname('grid.png'))
endmethod

--------------------------------------------------------------------------
-- full path of a file that sits beside a PML library, '' when none does. --
-- PMLLIB is a ';' separated search path, e.g.                            --
--   L:\E3D\pdms_prog\E3D2.1\PA_pmllibE3D2.1;C:\AVEVA\EVERYT~1.10\pmllib\;...  --
-- so it is walked in that order and the first <entry>\<rel> that exists  --
-- wins. entries arrive both with and without a trailing backslash, hence --
-- the normalising. !!pml.getPathName() would do the same through         --
-- pml.index, but that only knows a file after a pml rehash -- this does  --
-- not, so a freshly copied exe or data file is found straight away       --
--------------------------------------------------------------------------
define method .FindOnPmllib(!rel is string) is string
	!pmllib = !!evar('PMLLIB')
	handle any
		!pmllib = ''
	endhandle
	!pmldirs = !pmllib.split(';')
	do !pmldir values !pmldirs
		!pd = !pmldir.trim()
		if (!pd.eq('')) then
			skip
		endif
		!npd    = !pd.length()
		!pdlast = !pd.substring(!npd, 1)
		if (not(!pdlast.eq('\'))) then
			!pd = !pd & '\'
		endif
		!cand = !pd & !rel
		!cfile = object file(!cand)
		if (!cfile.exists()) then
			return !cand
		endif
	enddo
	return ''
endmethod

-----------------------------------
-- search all boxes for drawings --
-----------------------------------
define method .AllBoxes()
	var !projid proj id
	!sitename = '/' & !projid & '_DrawingPlanBox'
	!str = object array()

	----------------------------------------------------------------------
	-- old code did 'coll all equi with (matchwild(name of site, ...))' --
	-- which walks every EQUI in the whole project to test its site      --
	-- name. scoping the collect to the box site's own subtree instead   --
	-- is what makes this fast on large projects. the site may not exist --
	-- yet (nobody has built a box here), so check first and skip        --
	----------------------------------------------------------------------
	!ce = ref
	!found = true
	$!sitename
	handle any
		!found = false
	endhandle
	$!ce

	if (!found) then
		var !equis coll all equi for $!sitename
		do !equi values !equis
			var !equi namn of $!equi
			if !str.find(!equi).size().eq(0) then
				!str.append(!equi)
			endif
		enddo
		!str.sort()
	endif

	!this.files1.dtext = !str
endmethod

----------------------------
-- Add CE to drawing list --
----------------------------
define method .selectce()
	!strs1 = !this.files1.selection()
	!strs = !this.files.dtext
	if !strs1.size().gt(0) then
		!strs.appendarray(!strs1)
		!strs.sort()
		!this.files.dtext = !strs
		do !str1 values !strs1
			!this.files1.clear(!str1)
		enddo
	endif
	
	if not(!this.dest.val.eqnocase('')) and !this.files.dtext.size().gt(0) then
		!this.apply.active = true
	else
		!this.apply.active = false
	endif
endmethod

-----------------------------
-- Add all to drawing list --
-----------------------------
define method .selectall()
	!strs1 = !this.files1.dtext
	!strs = !this.files.dtext
	if !strs1.size().gt(0) then
		!strs.appendarray(!strs1)
		!strs.sort()
		!this.files.dtext = !strs
		!this.files1.clear()
	endif
	if not(!this.dest.val.eqnocase('')) and !this.files.dtext.size().gt(0) then
		!this.apply.active = true
	else
		!this.apply.active = false
	endif
endmethod

-------------------------------
-- Remove CE to drawing list --
-------------------------------
define method .removece()
	!strs = !this.files.selection()
	if !strs.size().gt(0) then
		do !str values !strs
			!this.files.clear(!str)
		enddo
		!strs1 = !this.files1.dtext
		!strs1.appendarray(!strs)
		!strs1.sort()
		!this.files1.dtext = !strs1
	endif
	
	if not(!this.dest.val.eqnocase('')) and !this.files.dtext.size().gt(0) then
		!this.apply.active = true
	else
		!this.apply.active = false
	endif
endmethod

--------------------------------
-- Remove all to drawing list --
--------------------------------
define method .removeall()
	!strs = !this.files.dtext
	if !strs.size().gt(0) then
		!this.files.clear()		
		!strs1 = !this.files1.dtext
		!strs1.appendarray(!strs)
		!strs1.sort()
		!this.files1.dtext = !strs1
	endif
	
	!this.apply.active = false
endmethod

--------------------------------------------------------------------------
-- the View tab's default Representation Style and Hatching Style live    --
-- under /PA-LIBY (user, 2026-09-16), a DEPT the project's own DRAFT DB   --
-- does not have until somebody puts it there. draft\PA-LIBY.txt in this  --
-- library is that DEPT written out by E3D's OUTPUT command, so a DB      --
-- without it gets the file run in as a macro once, and the rrsf/hrsf    --
-- lines further down .Apply() find what they name                        --
--                                                                        --
-- only done when a field actually points into /PA-LIBY: a user who has   --
-- typed a project library of their own gets no DEPT they never asked for --
--                                                                        --
-- false means .Apply() should stop -- the run would otherwise die at the --
-- rrsf line with a bare 'element does not exist' after the DRWG and      --
-- drawing list were already made                                         --
--------------------------------------------------------------------------
define method .EnsurePaLiby() is boolean
	!wantsr = !this.rrsftext.val.matchwild('/PA-LIBY/*')
	!wantsh = !this.hrsftext.val.matchwild('/PA-LIBY/*')
	if (not(!wantsr or !wantsh)) then
		return true
	endif
	if (!this.HavePaLiby()) then
		return true
	endif
	!ok = !this.ImportPaLibyNow()
	!this.PaLibyButton()
	return !ok
endmethod

--------------------------------------------------------------------------
-- whether the project has /PA-LIBY, without moving CE -- this runs on   --
-- every show of the form, and a CE jumping to a library the user never  --
-- asked for would be a surprise                                         --
--------------------------------------------------------------------------
define method .HavePaLiby() is boolean
	!have = !this.NameExists('/PA-LIBY')
	return !have
endmethod

--------------------------------------------------------------------------
-- whether an element of that name exists, without moving CE. a name     --
-- that is not there makes DBREF raise (AVEVA's admauthuser.pmlfrm:422   --
-- tests a name the same way)                                            --
--------------------------------------------------------------------------
define method .NameExists(!n is string) is boolean
	!ref = object DBREF(!n)
	handle any
		return false
	endhandle
	if (!ref.badref()) then
		return false
	endif
	return true
endmethod

--------------------------------------------------------------------------
-- Import PA-LIBY greyed out once the project has it (user, 2026-09-25)  --
--------------------------------------------------------------------------
define method .PaLibyButton()
	!have = !this.HavePaLiby()
	!this.palibybutn.active = not(!have)
endmethod

--------------------------------------------------------------------------
-- the Import PA-LIBY button: the same import .Apply() makes on its own, --
-- for a user who wants to pick another style under /PA-LIBY with the    --
-- CE buttons before the project's first Create Drawings (user,         --
-- 2026-09-25). it goes into the Destination's database like the        --
-- drawings, so a Destination is needed first; CE is put back after     --
--------------------------------------------------------------------------
define method .ImportPaLiby()
	if (!this.HavePaLiby()) then
		!this.PaLibyButton()
		return
	endif
	if (!this.dest.val.eq('')) then
		!!alert.error('Set the Destination on the Drawing tab first - /PA-LIBY goes into the same database as the drawings')
		return
	endif
	!prev = ce
	!ok = !this.ImportPaLibyNow()
	$!prev
	handle any
	endhandle
	!this.PaLibyButton()
	if (!ok) then
		!!alert.message('/PA-LIBY imported. Save Work to keep it - other users see it after that')
	endif
endmethod

--------------------------------------------------------------------------
-- run draft\PA-LIBY.txt into the Destination's database. false, with   --
-- the reason already shown, when it could not                          --
--                                                                       --
-- the file is NOT given to $M (2026-09-25). it starts with a UTF-8 BOM  --
-- -- E3D's OUTPUT writes one, and so does every file PML writes -- and --
-- run by $M its first line, NEW DEPT /PA-LIBY, did not make the DEPT:   --
-- the rest of the macro ran on the Destination's own DEPT, setting its --
-- SIZE, FONT and colours and putting /PA-LIBY/REPR and the other LIBYs --
-- under it beside the REGI (user). so the DEPT is made here, where a   --
-- failure shows E3D's own message, and lines 2 on are run one by one,  --
-- $!ln, which never sees the BOM and can say which line failed. the    --
-- file is one command a line (NEW/OLD/END and attribute settings, no   --
-- $ | ! in it), so a line is a whole command. the file itself stays as  --
-- OUTPUT wrote it                                                       --
--                                                                       --
-- a NEW, OLD or END that fails stops the run: going on would build the --
-- rest at the wrong level, which is what happened. a setting that      --
-- fails -- a colour this machine's dictionary lacks, say -- is noted   --
-- and passed over, listed in check_liby.txt only                       --
--                                                                       --
-- every name the macro makes is looked up first: one left over from a --
-- run like the one above would stop it at its NEW with /PA-LIBY half   --
-- built, and the button then grey. afterwards the two styles the View  --
-- tab defaults to must be there. the whole run goes to check_liby.txt  --
--------------------------------------------------------------------------
define method .ImportPaLibyNow() is boolean
	!log = object array()
	!file = !this.FindOnPmllib('draft\PA-LIBY.txt')
	if (!file.eq('')) then
		!!alert.error('PA-LIBY.txt not found beside any PMLLIB entry - /PA-LIBY representation library cannot be imported')
		return false
	endif
	!log.append('PALIBY file=' & !file & ' dest=' & !this.dest.val)
	!ff = object file(!file)
	!ff.open('read')
	!lines = !ff.readfile()
	!ff.close()
	if (!lines.size().lt(2)) then
		!!alert.error('PA-LIBY.txt is empty - /PA-LIBY cannot be imported')
		return false
	endif
	!first = !lines[1].upcase()
	if (not(!first.matchwild('*NEW DEPT /PA-LIBY*'))) then
		!!alert.error('PA-LIBY.txt does not start with NEW DEPT /PA-LIBY - /PA-LIBY cannot be imported')
		return false
	endif

	!taken = object array()
	do !i from 2 to !lines.size()
		!parts = !lines[!i].trim().split()
		skip if (!parts.size().lt(3))
		skip if (!parts[1].upcase().neq('NEW'))
		if (!this.NameExists(!parts[3])) then
			!taken.append(!parts[3])
			!log.append('TAKEN ' & !parts[3])
		endif
	enddo
	if (!taken.size().gt(0)) then
		!this.LibyLog(!log)
		!few = ''
		!nf = min(3, !taken.size())
		do !i from 1 to !nf
			!few = !few & ' ' & !taken[!i]
		enddo
		!!alert.error(!taken.size().string() & ' of the names PA-LIBY.txt makes already exist, left over from an earlier import - delete them first (deleting a LIBY takes what is under it):' & !few & ' ... all in check_liby.txt')
		return false
	endif

	----------------------------------------------------------------------
	-- standing on the DEPT that owns the destination REGI, a NEW DEPT   --
	-- goes in beside it, in the same (writable) DB the drawings go into --
	----------------------------------------------------------------------
	$!this.dest.val
	handle any
		!!alert.error('Destination ' & !this.dest.val & ' not found - /PA-LIBY cannot be imported')
		return false
	endhandle
	owner
	handle any
	endhandle
	!otype = ''
	var !otype type
	handle any
		!otype = ''
	endhandle
	if (!otype.neq('DEPT')) then
		!!alert.error('The Destination is not in a DEPT (its owner is ' & !otype & ') - /PA-LIBY cannot be imported')
		return false
	endif
	new dept /PA-LIBY
	handle any
		!log.append('NEWDEPT failed: ' & !!error.text)
		!this.LibyLog(!log)
		!!alert.error('Could not create DEPT /PA-LIBY: ' & !!error.text)
		return false
	endhandle
	!log.append('NEWDEPT ok')

	!bad = object array()
	!run = 0
	do !i from 2 to !lines.size()
		!ln = !lines[!i].trim()
		skip if (!ln.eq(''))
		!parts = !ln.split()
		!kw = !parts[1].upcase()
		!run = !run + 1
		$!ln
		handle any
			!msg = 'line ' & !i.string() & ': ' & !ln & ' - ' & !!error.text
			if (!kw.eq('NEW') or !kw.eq('OLD') or !kw.eq('END')) then
				!log.append('STOPPED ' & !msg)
				!this.LibyLog(!log)
				!!alert.error('PA-LIBY.txt stopped at ' & !msg & ' - /PA-LIBY is half built')
				return false
			endif
			!bad.append(!msg)
			!log.append('REFUSED ' & !msg)
		endhandle
	enddo
	!log.append('RAN ' & !run.string() & ' commands, ' & !bad.size().string() & ' settings refused')

	!ok = !this.NameExists('/PA-LIBY/REPR/PIPE/GA')
	if (!ok) then
		!ok = !this.NameExists('/PA-LIBY/HRUL/GEN/Hatch-Gen')
	endif
	if (not(!ok)) then
		!log.append('MISSING /PA-LIBY/REPR/PIPE/GA or /PA-LIBY/HRUL/GEN/Hatch-Gen')
		!this.LibyLog(!log)
		!!alert.error('PA-LIBY.txt ran but /PA-LIBY/REPR/PIPE/GA or /PA-LIBY/HRUL/GEN/Hatch-Gen is not there - see check_liby.txt')
		return false
	endif
	----------------------------------------------------------------------
	-- the refused settings are in check_liby.txt only: a success is one --
	-- dialog, the button's message (user, 2026-09-25). on the test      --
	-- machine they are BOCOLO/BOSTYL/OCCOLO/OCSTYL on all nine STYLEs,  --
	-- attributes its E3D does not have                                 --
	----------------------------------------------------------------------
	!log.append('DONE')
	!this.LibyLog(!log)
	return true
endmethod

--------------------------------------------------------------------------
-- check_liby.txt, the record of the last .ImportPaLibyNow(). a dump    --
-- that cannot be written is skipped, never an error                    --
--------------------------------------------------------------------------
define method .LibyLog(!log is array)
	!f = object file('L:\E3D\pdms_prog\E3D2.1\PA_pmllibE3D2.1\check_liby.txt')
	!f.writefile('OVERWRITE', !log)
	handle any
	endhandle
endmethod

--------------------------------------
-- main program of drawing creation --
--------------------------------------
define method .Apply()
	if (not(!this.CheckCompanyNetwork())) then
		!!alert.error('Cannot verify office network connection - Create Drawings is only available inside the company network')
		return
	endif
	if (not(!this.EnsurePaLiby())) then
		return
	endif
	$!this.dest.val
	do !equistr values !this.files.dtext
		if !equistr.substring(1,1).eqnocase('=') then
			var !boxs coll all box for $!equistr
		else
			var !boxs coll all box for /$!equistr
		endif
		!title1 = ''
		!title2 = ''
		!title3 = ''

		!name = '/' & !equistr
		!box = !boxs[1]
		!this.intersections = object array()
		!this.allintersections = object array()
		--------------------------------------------------------------------
		-- default for the rebuild path, where there is no previous box to  --
		-- compare against and nothing on the sheet to reuse anyway. the    --
		-- update branch replaces it with what it actually found            --
		--------------------------------------------------------------------
		!!DrawingPlan1BoxChanged = true
		!hasrevi = false
		new drwg
		handle any
			!!alert.error('cannot create DRWG under this level')
		elsehandle none
			delete drwg
			!drwgexists = true
			$!name/SS
			handle any
				!drwgexists = false
			elsehandle none
				var !revis coll all revi for ce
				!hasrevi = !revis.size().gt(0)
			endhandle
			if (!drwgexists) and not(!hasrevi) then
				if (!this.delshee.val) then
					!order = order
					delete drwg
				else
					------------------------- for future
				endif
			endif
			
			$!this.dest.val
			handle any
				-------------------
				-- ce is deleted --
				-------------------
				if (!order neq 1) then
					!order = !order - 1
					$!order
				endif
			endhandle
			if (not(!hasrevi)) then
				new drwg $!name/SS
				size 841 594
				new liby $!name/SS/LIBY
				new pllb $!name/SS/S1/V1/PLANES
				new dllb $!name/SS/DRAWLIST
				new idli $!name/SS/DRAWLIST/DRWG
				
				--------------------------
				-- calculate box limits --
				--------------------------
				
				$!box
				var !boxPos worpos
				var !wvol wvol
				var !boxXlen xlength
				var !boxYlen ylength
				var !boxZlen zlength
				var !ori ori wrt worl
				!boxXdir = !ori.orientation().xdir()
				!boxYdir = !ori.orientation().ydir()
				
				$!name/SS/DRAWLIST/DRWG
				-------------------------------------
				-- if box is slope, not orthogonal --
				-- extend limits for drawing list  --
				-------------------------------------
				!minE = !wvol.part(1).replace('mm', '').real()
				!minN = !wvol.part(2).replace('mm', '').real()
				!minU = !wvol.part(3).replace('mm', '').real()
				!maxE = !wvol.part(4).replace('mm', '').real()
				!maxN = !wvol.part(5).replace('mm', '').real()
				!maxU = !wvol.part(6).replace('mm', '').real()
				add all zone within E $!minE N $!minN U $!minU to E $!maxE N $!maxN U $!maxU
				add all REFGRD within E $!minE N $!minN U $!minU to E $!maxE N $!maxN U $!maxU
				------------------------------------------------------------------
				-- whatever sits in the View tab's exclude list is taken back    --
				-- out of the drawing list again, so the view does not draw it.  --
				--                                                               --
				-- 2026-08-21: this ran a plain 'REMOVE <name>' command and the  --
				-- element stayed in the drawing (user reported the .dgn ZONE    --
				-- still drawn); whatever the command did, the handler below was --
				-- swallowing it. the IDLIST object is what AVEVA's own 'Remove  --
				-- from View' uses (draft/forms/dra3dview.pmlfrm .viewRem), so   --
				-- the REME is filed through that instead                        --
				--                                                               --
				-- it still has to come after the ADDs, a drawing list is read   --
				-- in the order its members are filed in. an element deleted or  --
				-- renamed since it was put in the list comes back as a bad ref  --
				-- and is stepped over                                           --
				------------------------------------------------------------------
				!excls = object array()
				!excls = !this.excllist.dtext
				handle any
					!excls = object array()
				endhandle
				if (!excls.size().gt(0)) then
					!idlname = |$!name/SS/DRAWLIST/DRWG|
					!idli = object IDLIST(!idlname.dbref())
					do !excl values !excls
						!exclref = object DBREF()
						!exclref = !excl.dbref()
						handle any
						endhandle
						if (not(!exclref.badref())) then
							!idli.remove(!exclref)
							handle any
							endhandle
						endif
					enddo
					----------------------------------------------------------
					-- back to the drawing list, LIMITS below is set on it   --
					----------------------------------------------------------
					$!name/SS/DRAWLIST/DRWG
				endif
				------------------------------------------------------------------------
				-- keep the world bounding box of the box element. it is the same as   --
				-- the box itself while the box is orthogonal, and contains the box    --
				-- when the box is turned. LIMITS and CDLIMITS below are world axis    --
				-- aligned and so cannot hold a turned box any tighter than this; the  --
				-- six VSEC planes further down cut the real shape of the box, so a    --
				-- wider volume here does not draw anything outside the frame          --
				------------------------------------------------------------------------
				!wminE = !minE - 0.025
				!wminN = !minN - 0.025
				!wminU = !minU - 0.025
				!wmaxE = !maxE + 0.025
				!wmaxN = !maxN + 0.025
				!wmaxU = !maxU + 0.025
				
				
				!efpla = object direction()
				!nfpla = object direction()
				if min(abs(!boxYdir.angle(object direction('E'))), abs(!boxYdir.angle(object direction('W')))) lt min(abs(!boxYdir.angle(object direction('N'))), abs(!boxYdir.angle(object direction('S')))) then
					!efpla1 = !boxYdir
					!nfpla1 = !boxXdir
					!elen = !boxYlen
					!nlen = !boxXlen
				else
					!efpla1 = !boxXdir
					!nfpla1 = !boxYdir
					!elen = !boxXlen
					!nlen = !boxYlen
				endif
				if abs(!efpla1.angle(object direction('E'))) lt abs(!efpla1.angle(object direction('W'))) then
          !efpla = !efpla1
				else
          !efpla = !efpla1.opposite()
				endif				
				if abs(!nfpla1.angle(object direction('N'))) lt abs(!nfpla1.angle(object direction('S'))) then
          !nfpla = !nfpla1
				else
          !nfpla = !nfpla1.opposite()
				endif
				
				--------------------------------------
				-- add 0.025 for decimal precistion --
				--------------------------------------				
				!maxE1 = !boxPos.position().offset(!efpla,                !elen.real()  * 0.5 + 0.025).east
				!minE1 = !boxPos.position().offset(!efpla.opposite(),     !elen.real() * 0.5 + 0.025).east
				!maxN1 = !boxPos.position().offset(!nfpla,                !nlen.real()  * 0.5 + 0.025).north
				!minN1 = !boxPos.position().offset(!nfpla.opposite(),     !nlen.real()  * 0.5 + 0.025).north
				!maxU = !boxPos.position().offset(object direction('U'), !boxZlen.real() * 0.5 + 0.025).up
				!minU = !boxPos.position().offset(object direction('D'), !boxZlen.real() * 0.5 + 0.025).up
				!maxE = max(!maxE1, !minE1)
				!minE = min(!maxE1, !minE1)
				!maxN = max(!maxN1, !minN1)
				!minN = min(!maxN1, !minN1)
				
				------------------------------------------------------------------------
				-- !minE .. !maxU above are the faces of the box, measured along the  --
				-- direction the box itself points in. once the box is turned, taking --
				-- .east of a point half the length away along a turned direction     --
				-- gives centre + length / 2 * cos(angle), which is short of the      --
				-- corner of the box by half the other side times sin(angle). that    --
				-- is the box shrunk, not the box, so it must not be used for a world --
				-- axis aligned limit -- it cuts a wedge off two corners of the       --
				-- drawing while the annotation, which works from the sheet rectangle --
				-- of the view, still finds and dimensions the pipes in there         --
				------------------------------------------------------------------------
				limits E $!wminE N $!wminN U $!wminU TO E $!wmaxE N $!wmaxN U $!wmaxU
				!this.maxE = !maxE
				!this.minE = !minE
				!this.maxN = !maxN
				!this.minN = !minN
				!this.maxU = !maxU
				!this.minU = !minU
				!this.wmaxE = !wmaxE
				!this.wminE = !wminE
				!this.wmaxN = !wmaxN
				!this.wminN = !wminN
--				$p $!minE $!minN $!minU $!maxE $!maxN $!maxU

				!thpoE = !boxPos.position().east
				!thpoN = !boxPos.position().north
				!thpoU = !boxPos.position().up
				
				!thpoEforN = !boxPos.position().offset(!nfpla,            !nlen.real() * 0.5).east
				!thpoEforS = !boxPos.position().offset(!nfpla.opposite(), !nlen.real() * 0.5).east
				!thpoNforR = !boxPos.position().offset(!efpla,            !elen.real() * 0.5).north
				!thpoNforL = !boxPos.position().offset(!efpla.opposite(), !elen.real() * 0.5).north
        
--        $p $!thpoEforN $!thpoEforS $!thpoNforR $!thpoNforL
				
				$!name/SS/S1/V1/PLANES
				
				new fpla $!name/SS/S1/V1/TOUP
				position E $!thpoE N $!thpoN U $!maxU
				norm D
				end
				new fpla $!name/SS/S1/V1/TONP
				position E $!thpoEforN N $!maxN U $!thpoU
				!tempdir = !nfpla.opposite().string().before('WRT')
				norm $!tempdir
				end
				new fpla $!name/SS/S1/V1/TOEP
				position E $!maxE N $!thpoNforR U $!thpoU
				!tempdir = !efpla.opposite().string().before('WRT')
				norm $!tempdir
				end
				new fpla $!name/SS/S1/V1/FRUP
				position E $!thpoE N $!thpoN U $!minU
				norm U
				end
				new fpla $!name/SS/S1/V1/FRNP
				position E $!thpoEforS N $!minN U $!thpoU
				!tempdir = !nfpla.string().before('WRT')
				norm $!tempdir
				end
				new fpla $!name/SS/S1/V1/FREP
				position E $!minE N $!thpoNforL U $!thpoU
				!tempdir = !efpla.string().before('WRT')
				norm $!tempdir
				end
				
				------------------------------------------
				-- create instrument template reference --
				------------------------------------------
				$!name/SS/LIBY
				new lalb $!name/SS/LALB
				new sytm $!name/SS/LALB/NAME_CIRC
				XYPS X 0mm Y 0mm
				JUST Centre
				ALIGN Hbody
				FONT 1
				CHEITX '3mm'
				CSPATX '0'
				LSPATX '0'
				TXCOLO 1
				NLSTYL Solid
				NLCOLO 1
				LLSTYL Solid
				LLCOLO 1
				FSTYLE Off
				FCOLOUR 1
				MCOLOUR 1
				LZCOLO 1
				LZLSTY Solid
				LZVIS true
				LZPRIN true
				
				NEW CIRCLE
				Origin Centre Offset X 0mm Y 0mm
				-- bubble size from the Annotation tab. .insttext3 'Diameter'  --
				-- had no reader at all until now: field, default and Save     --
				-- record existed, nothing consumed it, and the circle was     --
				-- this literal (same shape as .gridhei, 2026-09-08)           --
				!instdiav = !this.insttext3.val
				!instdia = !instdiav.string('D2') & 'mm'
				DIAM $!instdia
				NLSTYL Solid
				NLCOLO 5
				FSTYLE Off
				FCOLOUR 1
				
				NEW TEXTPRIMITIVE
				Origin Offset X 0mm Y 0mm
				FONT 1
				CHEITX '1.5mm'
				CSPATX '0'
				LSPATX '0'
				JUST Centre
				ALIGN Hbody
				BTEX |$!this.insttext2.val|
				TXCOLO 5
				
				new shee $!name/SS/S1
				IDLN $!name/SS/DRAWLIST/DRWG
				if (!this.frametext.val.neq('')) then
					bsrf $!this.frametext.val
				endif
				if (!this.keyovertext.val.neq('')) then
					NEW OLAY $!name/SS/S1/KEYPLAN
					XYSCALE 1 1
					OSRF $!this.keyovertext.val
					OPOSITION $!this.keytext1.val
				endif
				new view $!name/SS/S1/V1
				lframe false
				thposition E $!thpoE N $!thpoN U $!thpoU
				Direction D
				Onposition 0mm 0mm
				Arctolerance 15
				Vtype Global HLine
				Idlname $!name/SS/DRAWLIST/DRWG
				
				!temp.delete()
				handle any
				endhandle
				!temp = !efpla.angle(object direction('E'))
				------------------------------------------------------------------------
				-- .angle() only ever answers 0 to 180, it has no sign, so a box       --
				-- turned 10 degree towards the north and one turned 10 degree         --
				-- towards the south both come out of the line above as 10 and both    --
				-- used to be handed to Adegrees as +10. one of the two is then turned --
				-- the wrong way, and the frame of the view stops being the outline of --
				-- the box -- it becomes the box turned about its own centre by twice  --
				-- the angle. what sits outside the box then falls inside the frame    --
				-- and gets annotated, and what is really inside the box is clipped    --
				-- away and leaves a blank wedge. this is the same trap as the flow    --
				-- arrows (see the README section on the 40 degree test), where the    --
				-- sign also had to be worked out separately from .angle()             --
				--                                                                     --
				-- the sheet x axis of the view runs along east turned by minus        --
				-- Adegrees, so to line the frame up with the box, an efpla leaning    --
				-- north needs a negative Adegrees. measured 2026-08-12 on a box with  --
				-- ori Y is S 10 E: efpla came out E 10 N, Adegrees +10 put the sheet  --
				-- x axis on E 10 S, 20 degree away from the box                       --
				------------------------------------------------------------------------
				if (abs(!efpla.angle(object direction('N'))) lt abs(!efpla.angle(object direction('S')))) then
					!temp = !temp * -1
				endif
				if !temp.eq(0) then

				else
					Adegrees $!temp
				endif
				
				
				
				

				------------------------------------------
				-- reprensetation rules and hatch rules --
				------------------------------------------
				if (!this.rrsftext.val.neq('')) then
					rrsf $!this.rrsftext.val
				endif
				if (!this.hrsftext.val.neq('')) then
					hrsf $!this.hrsftext.val
				endif
				
				Crsf Nulref
				Agmode 'OFF'
				Agside 'All'

				-----------------------------------------
				-- for A1 border,                      --
				-- the max. view size is 500mm x 400mm --
				-----------------------------------------
				if (!!DrawingPlan1.canvassize.unset()) then
					!tempsize1 = 500
					!tempsize2 = 400
				else
					!tempsize1 = abs(!!DrawingPlan1.canvassize.part(6).real() - !!DrawingPlan1.canvassize.part(2).real())
					!tempsize2 = abs(!!DrawingPlan1.canvassize.part(8).real() - !!DrawingPlan1.canvassize.part(4).real())
				endif
				
				if (!boxXlen.real() gt !boxYlen.real()) then
					!ratio = !boxXlen.real() / !tempsize1
				else
					!ratio = !boxYlen.real() / !tempsize2
				endif
	--      $p $!ratio
				$(
				--------------------------
				-- redundant view scale --
				--------------------------
				if (!ratio le 1) then
					!this.vsca = 1
				elseif (!ratio le 2) then
					!this.vsca = 0.5
				elseif (!ratio le 3) then
					!this.vsca = 0.33333333
				elseif (!ratio le 5) then
					!this.vsca = 0.2
				elseif (!ratio le 10) then
					!this.vsca = 0.1
				elseif (!ratio le 20) then
					!this.vsca = 0.05
				elseif (!ratio le 25) then
					!this.vsca = 0.04
				$)	
				if (!ratio le 33) then
					!this.vsca = 0.03333333
				elseif (!ratio le 50) then
					!this.vsca = 0.02
				elseif (!ratio le 100) then
					!this.vsca = 0.01
				elseif (!ratio le 150) then
					!this.vsca = 0.00666666
				elseif (!ratio le 200) then
					!this.vsca = 0.005
				elseif (!ratio le 250) then
					!this.vsca = 0.004
				elseif (!ratio le 500) then
					!this.vsca = 0.002
				elseif (!ratio le 750) then
					!this.vsca = 0.00133333
				elseif (!ratio le 1000) then
					!this.vsca = 0.001
				elseif (!ratio le 1500) then
					!this.vsca = 0.00066666
				elseif (!ratio le 2000) then
					!this.vsca = 0.0005
				elseif (!ratio le 2500) then
					!this.vsca = 0.0004
				elseif (!ratio le 3000) then
					!this.vsca = 0.00033333
				elseif (!ratio le 3500) then
					!this.vsca = 0.00028571
				elseif (!ratio le 4000) then
					!this.vsca = 0.00025
				elseif (!ratio le 5000) then
					!this.vsca = 0.0002
				elseif (!ratio le 10000) then
					!this.vsca = 0.0001
				endif
				------------------------------------------------------------------
				-- a scale typed on the View tab wins over the one the fit above  --
				-- picked. a job normally draws every plan at the same scale, and --
				-- letting each drawing pick its own also moves the view between  --
				-- revisions, which clouds the whole sheet when they are compared --
				--                                                                --
				-- the fit is still run: it costs nothing and its answer is what  --
				-- the field is left empty for                                    --
				------------------------------------------------------------------
				!scalestr = !this.scaleopt.selection()
				if (!scalestr.eqnocase('User Define')) then
					!scalestr = !this.scaletext.val
				elseif (!scalestr.eqnocase('auto')) then
					!scalestr = ''
				endif
				!scalestr = !scalestr.replace(' ', '')
				if (!scalestr.neq('')) then
					---------------------------------------------------------------
					-- a scale is a ratio and it is not always a reduction: 2:1   --
					-- is as good an answer as 1:30, so both halves are read. a   --
					-- bare number is taken as 1:that, which is what the entries  --
					-- of the list amount to anyway                               --
					---------------------------------------------------------------
					!scalenum = 1
					!scaleden = 0
					if (!scalestr.matchwild('*:*')) then
						!scalenum = 0
						!scalenum = !scalestr.before(':').real()
						handle any
							!scalenum = 0
						endhandle
						!scaleden = !scalestr.after(':').real()
						handle any
							!scaleden = 0
						endhandle
					else
						!scaleden = !scalestr.real()
						handle any
							!scaleden = 0
						endhandle
					endif
					if (!scalenum.gt(0) and !scaleden.gt(0)) then
						!this.vsca = !scalenum / !scaleden
					else
						!!alert.error('Drawing Scale on the View tab is not a ratio: ' & !scalestr & '. Pick one from the list, or choose User Define and type a ratio such as 1:30 or 2:1. The fitted scale has been used instead.')
					endif
				endif
				!sizeX = !elen.real() * !this.vsca
				!sizeY = !nlen.real() * !this.vsca
				size $!sizeX $!sizeY
				
				--------------------------------------
				-- assume center of view is 357,315 --
				--------------------------------------
				if (!!DrawingPlan1.canvassize.unset()) then
					xyposition X 357 Y 315
				else
					!p1 = object position('X ' & !!DrawingPlan1.canvassize.part(2) & ' Y ' & !!DrawingPlan1.canvassize.part(4))
					!p2 = object position('X ' & !!DrawingPlan1.canvassize.part(6) & ' Y ' & !!DrawingPlan1.canvassize.part(8))
					!mid = !p1.midpoint(!p2).string()
					!mid1 = 'X ' & !mid.part(2) & ' Y ' & !mid.part(4)
					xyposition $!mid1
				endif
				
				NLStyle Solid 
				NLColour 147 
				Lvisibility true
				Vgaplength 2mm
				Smode Standard
				
	--      $p |E $!minE N $!minN U $!minU TO E $!maxE N $!maxN U $!maxU|
				
				----------------------------------------------------------------------
				-- the world bounding box of the box element, not the faces of the   --
				-- box, for the same reason as LIMITS above. the VSEC planes created --
				-- below cut the view down to the real shape of the box              --
				----------------------------------------------------------------------
				:CDLIMITS |FROM E $!wminE N $!wminN U $!wminU TO E $!wmaxE N $!wmaxN U $!wmaxU|
				handle any
				endhandle
	--			:CDLIMITS |E $!minE N $!minN U $!minU TO E $!maxE N $!maxN U $!maxU|
				vsca $!this.vsca
				
				new vsec $!name/SS/S1/V1/TOUP/VSEC
				plrf $!name/SS/S1/V1/TOUP
				end
				new vsec $!name/SS/S1/V1/TONP/VSEC
				plrf $!name/SS/S1/V1/TONP
				end
				new vsec $!name/SS/S1/V1/TOEP/VSEC
				plrf $!name/SS/S1/V1/TOEP
				end
				new vsec $!name/SS/S1/V1/FRUP/VSEC
				plrf $!name/SS/S1/V1/FRUP
				end
				new vsec $!name/SS/S1/V1/FRNP/VSEC
				plrf $!name/SS/S1/V1/FRNP
				end
				new vsec $!name/SS/S1/V1/FREP/VSEC
				plrf $!name/SS/S1/V1/FREP
				end
				
				----------------------------------------------
				-- calculate view four corners coordination --
				----------------------------------------------
				$!name/SS/S1/V1
				var !shxypos shxypos
				var !size size
				
				---------------------------
				-- portrait to landscape --
				---------------------------
				if !this.portrait.val and !size.part(1).real().value().lt(!size.part(2).real().value()) then
					$!name/SS/S1/V1
					RCODE LEFT
					--------------------------------
					-- label may rotate 90 degree --
					--------------------------------
				endif
				
				var !size size						
				--------------------------------------
				-- add 0.025 for decimal precistion --
				--------------------------------------
				var !rcode rcode
				!this.rcode = !rcode
				if !rcode.eqnocase('up') then
					!this.viewULsh = 'x ' & string(!shxypos.part(1).real().value() - !size.part(1).real().value() * 0.5 - 0.025) & ' y ' & string(!shxypos.part(2).real().value() + !size.part(2).real().value() * 0.5 + 0.025)
					!this.viewURsh = 'x ' & string(!shxypos.part(1).real().value() + !size.part(1).real().value() * 0.5 + 0.025) & ' y ' & string(!shxypos.part(2).real().value() + !size.part(2).real().value() * 0.5 + 0.025)
					!this.viewLLsh = 'x ' & string(!shxypos.part(1).real().value() - !size.part(1).real().value() * 0.5 - 0.025) & ' y ' & string(!shxypos.part(2).real().value() - !size.part(2).real().value() * 0.5 - 0.025)
					!this.viewLRsh = 'x ' & string(!shxypos.part(1).real().value() + !size.part(1).real().value() * 0.5 + 0.025) & ' y ' & string(!shxypos.part(2).real().value() - !size.part(2).real().value() * 0.5 - 0.025)
				else
					------------------
					-- rcode = left --
					------------------
					!this.viewULsh = 'x ' & string(!shxypos.part(1).real().value() - !size.part(2).real().value() * 0.5 - 0.025) & ' y ' & string(!shxypos.part(2).real().value() + !size.part(1).real().value() * 0.5 + 0.025)
					!this.viewURsh = 'x ' & string(!shxypos.part(1).real().value() + !size.part(2).real().value() * 0.5 + 0.025) & ' y ' & string(!shxypos.part(2).real().value() + !size.part(1).real().value() * 0.5 + 0.025)
					!this.viewLLsh = 'x ' & string(!shxypos.part(1).real().value() - !size.part(2).real().value() * 0.5 - 0.025) & ' y ' & string(!shxypos.part(2).real().value() - !size.part(1).real().value() * 0.5 - 0.025)
					!this.viewLRsh = 'x ' & string(!shxypos.part(1).real().value() + !size.part(2).real().value() * 0.5 + 0.025) & ' y ' & string(!shxypos.part(2).real().value() - !size.part(1).real().value() * 0.5 - 0.025)
				endif
				!this.viewUlinesh = object line(!this.viewULsh.position(), !this.viewURsh.position())
				!this.viewDlinesh = object line(!this.viewLLsh.position(), !this.viewLRsh.position())
				!this.viewRlinesh = object line(!this.viewLRsh.position(), !this.viewURsh.position())
				!this.viewLlinesh = object line(!this.viewLLsh.position(), !this.viewULsh.position())
				--------------------------------------------------------------------
				-- on this path the view is placed on the box, so the box edge and  --
				-- the border are the same four corners. they are kept apart all    --
				-- the same, because the update path freezes the placement and the  --
				-- two stop agreeing there -- everything downstream reads the box   --
				-- corners and so behaves identically on both paths (2026-08-29)    --
				--------------------------------------------------------------------
				!this.boxULsh = !this.viewULsh
				!this.boxURsh = !this.viewURsh
				!this.boxLLsh = !this.viewLLsh
				!this.boxLRsh = !this.viewLRsh
				!this.boxUlinesh = object line(!this.boxULsh.position(), !this.boxURsh.position())
				!this.boxDlinesh = object line(!this.boxLLsh.position(), !this.boxLRsh.position())
				!this.boxRlinesh = object line(!this.boxLRsh.position(), !this.boxURsh.position())
				!this.boxLlinesh = object line(!this.boxLLsh.position(), !this.boxULsh.position())
				
				$!name/SS/S1/V1
				update design
				1
				last
				---------------------
				-- grid annotation --
				---------------------
				!!DrawingPlan1GridAnnotation(!name)      
				
				$!name/SS/S1/V1
				1
				last
				
				------------------------------------------------------------------
				-- where the match line's ticks go. worked out here, before the  --
				-- line number annotation, because those points are dimensioned  --
				-- as well as drawn and the dimension has to be built while the  --
				-- chain is being built -- adding points afterwards would land   --
				-- outside the spacing test which decides whether a dimension    --
				-- text has to be turned 90 degrees. the match line itself is    --
				-- drawn much later, off this same list (2026-08-28)             --
				------------------------------------------------------------------
				$!name/SS/S1/V1
				!!DrawingPlan1MatchTicks(!name, !equistr)
				-------------------------
				-- line no. annotation --
				-------------------------
				$!name/SS/S1/V1
				1
				last
				!!DrawingPlan1LineNoAnnotation(!name, !boxXlen.real(), !boxYlen.real())
				--------------------------
				-- equipment annotation --
				--------------------------
				$!name/SS/S1/V1
				1
				last
				!!DrawingPlan1EquiAnnotation(!name, !minE.string(), !minN.string(), !minU.string(), !maxE.string(), !maxN.string(), !maxU.string())

				!dbgf5 = object file('L:\E3D\pdms_prog\E3D2.1\PA_pmllibE3D2.1\check5.txt')
				!dbgf5.open('overwrite')
				!dbgf5.writerecord('CHECKPOINT A after EquiAnnotation')
				!dbgf5.close()

				-------------------------------------------
				-- highlight the drawing area in keyplan --
				-------------------------------------------
				$!name/SS/S1/V1
				new note
				if (!this.keytext1.val neq '' and !this.keytext2.val neq '' and !this.keytext3.val neq '' and !this.keytext4.val neq '' and !this.keytext5.val neq '') then
					$!name/SS/S1/V1

					----------------------------------------------------------------------
					-- E/N -> sheet X/Y transform for the keyplan itself, same shape as   --
					-- .SheetLimitsOfVolume()'s !trans, but built from the keyplan's own  --
					-- paper origin (keytext1), reference E/N (keytext2/3), scale         --
					-- (keytext4) and up direction (keytext5), not the detail view's own  --
					-- placement, so the highlight box keeps the keyplan's own north      --
					-- regardless of how the detail view itself is rotated                --
					----------------------------------------------------------------------
					!keytrans = object array()
					!keytrans[1] = !this.keytext1.val.split().getindexed(2).real()
					!keytrans[2] = !this.keytext1.val.split().getindexed(4).real()
					!keytrans[3] = !this.keytext2.val.real()
					!keytrans[4] = !this.keytext3.val.real()
					!keysca = !this.keytext4.val.real()
					!keydir = !this.keytext5.val.trim()
					if !keydir.eqnocase('E') then
						!keytrans[5] = 0
						!keytrans[6] = !keysca
						!keytrans[7] = -1 * !keysca
						!keytrans[8] = 0
					elseif !keydir.eqnocase('S') then
						!keytrans[5] = -1 * !keysca
						!keytrans[6] = 0
						!keytrans[7] = 0
						!keytrans[8] = -1 * !keysca
					elseif !keydir.eqnocase('W') then
						!keytrans[5] = 0
						!keytrans[6] = -1 * !keysca
						!keytrans[7] = !keysca
						!keytrans[8] = 0
					else
						--------------------------------------------------------
						-- 'N' (or anything unrecognised) -- north up, as before --
						--------------------------------------------------------
						!keytrans[5] = !keysca
						!keytrans[6] = 0
						!keytrans[7] = 0
						!keytrans[8] = !keysca
					endif

					----------------------------------------------------------------------
					-- the view's own box on the sheet is always square to the paper,   --
					-- but when the view is rotated (ADEGREES) that square corresponds  --
					-- to a turned rectangle in the world, not to !!ce.vlimits' world-  --
					-- axis-aligned box. so the world E/N of each paper corner is read  --
					-- back out through .ViewSheetTransform()'s inverse (same formula   --
					-- as .WorldLimitsOfSheetRect(), just kept per-corner instead of    --
					-- collapsed to min/max), which is what actually carries the        --
					-- view's rotation into the keyplan box                             --
					----------------------------------------------------------------------
					!vtrans = !this.ViewSheetTransform()
					!cornersh = object array()
					!cornersh[1] = !this.viewLLsh
					!cornersh[2] = !this.viewULsh
					!cornersh[3] = !this.viewURsh
					!cornersh[4] = !this.viewLRsh

					!cornerEs = object array()
					!cornerNs = object array()
					do !i from 1 to 4
						!cshx = !cornersh[!i].part(2).real()
						!cshy = !cornersh[!i].part(4).real()
						!cdx = !cshx - !vtrans[1]
						!cdy = !cshy - !vtrans[2]
						!cornerEs[!i] = !vtrans[3] + (!cdx * !vtrans[8] - !cdy * !vtrans[7]) / !vtrans[9]
						!cornerNs[!i] = !vtrans[4] + (!cdy * !vtrans[5] - !cdx * !vtrans[6]) / !vtrans[9]
					enddo

					----------------------------------------------------------------------
					-- .ViewSheetTransform() needs CE still on the view (see its own      --
					-- header comment), so the corner maths above has to run before CE    --
					-- moves down into NOTE 1 / the new OUTL to actually draw the box      --
					----------------------------------------------------------------------
					note 1
					new outl lclosed true fstyle SystemStyle 9 NLColour cyan FColour cyan
					!!ce.PrBlnkFlag = |false|
					do !i from 1 to 4
						!de = !cornerEs[!i] - !keytrans[3]
						!dn = !cornerNs[!i] - !keytrans[4]
						!offx3 = !keytrans[1] + !de * !keytrans[5] + !dn * !keytrans[7]
						!offy3 = !keytrans[2] + !de * !keytrans[6] + !dn * !keytrans[8]
						new VRTX at X ($!offx3) Y ($!offy3)
					enddo
				endif
				
				-----------------------------
				-- fill border information --
				-----------------------------				
				if not(!this.dwgnopos.val.eqnocase('')) and not(!this.dwgnohei.val.eqnocase('')) then
					!posx = !this.dwgnopos.val.split(',').getindexed(1)
					!posy = !this.dwgnopos.val.split(',').getindexed(2)
					new texp btext |$!equistr| origin x $!posx y $!posy cheitx |$!this.dwgnohei.val| alig base just left txcolour yellow font 1
				endif
				if not(!title1.eqnocase('')) and not(!this.title1pos.val.eqnocase('')) and not(!this.title1hei.val.eqnocase('')) then
					!posx = !this.title1pos.val.split(',').getindexed(1)
					!posy = !this.title1pos.val.split(',').getindexed(2)
					new texp btext |$!title1| origin x $!posx y $!posy cheitx |$!this.title1hei.val| alig base just left txcolour yellow font 1
				endif
				if not(!title2.eqnocase('')) and not(!this.title2pos.val.eqnocase('')) and not(!this.title2hei.val.eqnocase('')) then
					!posx = !this.title2pos.val.split(',').getindexed(1)
					!posy = !this.title2pos.val.split(',').getindexed(2)
					new texp btext |$!title2| origin x $!posx y $!posy cheitx |$!this.title2hei.val| alig base just left txcolour yellow font 1
				endif
				if not(!title3.eqnocase('')) and not(!this.title3pos.val.eqnocase('')) and not(!this.title3hei.val.eqnocase('')) then
					!posx = !this.title3pos.val.split(',').getindexed(1)
					!posy = !this.title3pos.val.split(',').getindexed(2)
					new texp btext |$!title3| origin x $!posx y $!posy cheitx |$!this.title3hei.val| alig base just left txcolour yellow font 1
				endif

				-----------------------------------------------------------------------
				-- north arrow                                                       --
				--                                                                   --
				-- .ViewSheetTransform() reads SHPOS / ENUPOS out of the view, so the --
				-- direction north takes on the sheet has to be measured while CE is  --
				-- still the view. only after that can CE move to the sheet, and a    --
				-- SYMB cannot hang off SHEE itself -- it has to be created down in   --
				-- NOTE 1, the same note the border text above is written into        --
				-----------------------------------------------------------------------
				if (!this.northpostext.val.neq('')) then
					$!name/SS/S1/V1
					!ntrans = !this.ViewSheetTransform()
					!ndx = !ntrans[7]
					!ndy = !ntrans[8]
					-------------------------------------------------------------------
					-- 'rotated' is not asked of ADEGREES or RCODE separately -- each --
					-- of them on its own, and the two together, can leave north off  --
					-- the up direction of the sheet, so it is the measured north     --
					-- vector which decides. compared as squares to keep clear of     --
					-- sqrt, the same way .ViewSheetTransform() does                  --
					-------------------------------------------------------------------
					!nlen2 = !ndx * !ndx + !ndy * !ndy
					!ntol2 = !nlen2 * 0.000001
					!nrotated = true
					if (!nlen2 le 0) then
						----------------------------------------------------------
						-- nothing was measured -- treat the view as upright so  --
						-- the arrow still gets drawn and no angle is worked out --
						-- from a zero length vector                             --
						----------------------------------------------------------
						!nrotated = false
					elseif (!ndx * !ndx lt !ntol2 and !ndy gt 0) then
						!nrotated = false
					endif
					!nsytm = !this.northtext.val
					if (!nsytm.neq('')) then
						-----------------------------------------------------------------
						-- ADEGREES turns the symbol anticlockwise and a north arrow is --
						-- drawn pointing up the sheet, so the turn wanted is the one   --
						-- which takes sheet up onto the measured north. turning (0,1)  --
						-- by t gives (-sin t, cos t), hence cos t = ndy / len and the  --
						-- sign of the turn is the opposite of the sign of ndx. the     --
						-- cosine is clamped because a value a hair outside -1 .. 1,    --
						-- which rounding can produce, has no arc cosine                --
						-----------------------------------------------------------------
						!nang = 0
						if (!nrotated) then
							!ncos = !ndy / sqrt(!nlen2)
							if (!ncos gt 1) then
								!ncos = 1
							endif
							if (!ncos lt -1) then
								!ncos = -1
							endif
							!nang = acos(!ncos)
							if (!ndx gt 0) then
								!nang = !nang * -1
							endif
						endif
						----------------------------------------------------------------
						-- the Pick button writes 'X <x> Y <y>', but the field can be  --
						-- typed into by hand as well, so the 'x,y' the border text    --
						-- fields use is taken too                                     --
						----------------------------------------------------------------
						!npos = !this.northpostext.val.trim()
						if (!npos.matchwild('*,*')) then
							!npx = !npos.split(',').getindexed(1).trim().real()
							!npy = !npos.split(',').getindexed(2).trim().real()
						else
							!npx = !npos.replace('mm', '').part(2).real()
							!npy = !npos.replace('mm', '').part(4).real()
						endif
						-----------------------------------------------------------------
						-- Scale is how big the symbol is drawn. an empty or nonsense   --
						-- field falls back to 1, which is the size the SYTM itself was --
						-- drawn at, rather than shrinking the arrow to nothing         --
						-----------------------------------------------------------------
						!nsca = 1
						if (not(!this.northsca.val.unset())) then
							!nsca = !this.northsca.val
						endif
						if (!nsca le 0) then
							!nsca = 1
						endif
						$!name/SS/S1
						note 1
						new symb
						tmrf $!nsytm
						XYPO X $!npx Y $!npy
						XYSCALE $!nsca $!nsca
						----------------------------------------------------------------
						-- the text and the line fill both have to be told white, or   --
						-- the arrow comes out in whatever colour the SYTM was drawn   --
						-- in rather than white                                        --
						----------------------------------------------------------------
						Txcolour white
						LFColour white
						if (!nrotated) then
							ADEG $!nang
						endif
					endif
				endif


				---------------------
				-- draw match line --
				---------------------
				!!DrawingPlan1MatchLine(!name, !equistr)
				
				-----------------------------------------------------------------------------
				-- label placement automatically                                           --
				-- 1. pml writes label info. to WriteLabelToText.txt in .blankdir        --
				-- 2. python read the file and find blank space for each                   --
				-- 3. python writes blank space info. to LabelSpace.txt in the same dir  --
				-- 4. pml read the file and reposition labels to blank space               --
				-----------------------------------------------------------------------------
				!ff = object file(!this.blankdir & 'WriteLabelToText.txt')
				if !ff.exists() then
					!ff.deletefile()
				endif
				--------------------------------------------------------------
				-- and the record of which support labels share a point, so --
				-- that a run with the support toggle off cannot be read    --
				-- against the slabs of the run before it                   --
				--------------------------------------------------------------
				!this.suptstack = object array()
				!bpdxf = !this.blankdir & 'BlankPos1.dxf'
				LIEXEC /Draft_DXF_LI 'DXFOUT' OutputF '$!bpdxf'
				
				----------------------------
				-- reducer, rt annotation --
				----------------------------
				if (!this.redutog.val) then
					$!name/SS/S1/V1
					1
					last
					!this.ReduAnnotation(!name)
				endif

				-----------------------
				-- nozzle annotation --
				-----------------------
				if (!this.nozztog.val) then
					$!name/SS/S1/V1
					1
					last
					!this.NozzleAnnotation(!name)
				endif

				-----------------------
				-- valve annotation --
				-----------------------
				if (!this.valvtog.val) then
					$!name/SS/S1/V1
					1
					last
					!this.ValveAnnotation(!name)
				endif
				
				---------------------------
				-- instrument annotation --
				---------------------------
				if (!this.insttog.val) then
					$!name/SS/S1/V1
					1
					last
					!this.InstAnnotation(!name)
				endif
				
				------------------------
				-- support annotation --
				------------------------
				if (!this.supttog.val) then
					$!name/SS/S1/V1
					1
					last
					!this.SuptAnnotation(!name)
				endif
				!this.AppendDimLines(!name)
				
				!this.RunBlankPos()
				
				!ff = object file(!this.blankdir & 'LabelSpace.txt')
				if !ff.exists() then
					!ff.open('read')
					!lines =!ff.readfile()
					do !i From 1 to !lines.size()
						!this.PlaceLabelFromSpace(!lines[!i], !rcode, false)
					enddo
					!ff.close()
				endif

				!dbgf5 = object file('L:\E3D\pdms_prog\E3D2.1\PA_pmllibE3D2.1\check5.txt')
				!dbgf5.open('append')
				!dbgf5.writerecord('CHECKPOINT B before recenter block')
				!dbgf5.close()

				------------------------------------------------------------------
				-- move the view so that its annotation lands inside the canvas, --
				-- and put back everything that does not travel with the view    --
				-- automatically. shared with the update path -- see            --
				-- .RecenterView() for why it has to be                          --
				------------------------------------------------------------------
				!this.RecenterView(!name, !equistr)
				----------------------------------------------------------------
				-- and the breaks where a dimension crosses a match line text. --
				-- last, because it needs the texts where they finally ended   --
				-- up: MatchLine is called once above and .RecenterView()      --
				-- calls it again after moving the view, and it is that second --
				-- set of positions the gaps have to line up with              --
				--                                                              --
				-- it leaves CE on an LDIM or a bubble, so the view is         --
				-- navigated back to afterwards -- reading VIEWDIR or VSCA off  --
				-- the wrong element is what broke EquiAnnotation (c0a3e5d)     --
				----------------------------------------------------------------
				!!DrawingPlan1MatchGaps(!name)
				handle any
				endhandle
				$!name/SS/S1/V1
				handle any
				endhandle

				------------------------------------------------------------------
				-- the view title under the drawing: PLAN at ELEVATION +<top of  --
				-- box> and SCALE 1:n. after .RecenterView(), which left room    --
				-- for it and says where it goes (.titletop)                     --
				------------------------------------------------------------------
				!ttop = !this.titletop
				if (!ttop.unset()) then
					!ttop = !this.TitleTopNow()
				endif
				!this.ViewTitle(!name, !box.string(), !ttop)
				$!name/SS/S1/V1
				handle any
				endhandle

				---------------------------
				-- flow arrow annotation --
				---------------------------
				$!name/SS/S1/V1
				1
				last
				!!DrawingPlan1FlowAnnotation(!name)
				
				----------------
				-- open sheet --
				----------------
				if (!!DrawingPlan1.openshee.val) then
					$!name/SS/S1/V1
					!!cmsys.executecommand('AVEVA.Draw.OpenSheetByCE')
				endif
			else
				--------------------------------------------------------------------
				-- update path (has REVI): DRWG/SHEE/VIEW/LIBY/LALB stay exactly    --
				-- as they are -- no delete, no NEW. THPOSITION/XYPOSITION/ADEGREES --
				-- are never touched below either -- view placement is frozen.     --
				-- DRAWLIST/LIMITS/CDLIMITS redo every run; VSEC/FPLA redo only if --
				-- the box actually changed; SIZE is recalculated symmetric around --
				-- the frozen sheet centre (see the blocks below). Grid/MatchTicks/ --
				-- LineNo/Equi/MatchLine/MatchGaps/Flow run below with per-element --
				-- reuse. NOT run on this path (user decision 2026-09-14, to be    --
				-- revisited once drawings are issued in volume): the five BlankPos --
				-- SLAB passes (Redu/Nozzle/Valve/Inst/Supt, with DimLines and the --
				-- DXF export) -- those labels stay exactly as the last rebuild    --
				-- left them, except the ones a model change runs into (see        --
				-- .PinnedLabelPass). also by decision: no confirmation            --
				-- prompt before updating a revised sheet, a REVI simply means     --
				-- update, never rebuild                                           --
				--------------------------------------------------------------------
				!dbgf3 = object file('L:\E3D\pdms_prog\E3D2.1\PA_pmllibE3D2.1\check3.txt')
				!dbgf3.open('overwrite')
				!dbgf3.writerecord('STEP6 APPLY START name=' & !name)
				$!box
				var !boxPos worpos
				var !wvol wvol
				var !boxXlen xlength
				var !boxYlen ylength
				var !boxZlen zlength
				var !ori ori wrt worl
				!boxXdir = !ori.orientation().xdir()
				!boxYdir = !ori.orientation().ydir()
				!minE = !wvol.part(1).replace('mm', '').real()
				!minN = !wvol.part(2).replace('mm', '').real()
				!minU = !wvol.part(3).replace('mm', '').real()
				!maxE = !wvol.part(4).replace('mm', '').real()
				!maxN = !wvol.part(5).replace('mm', '').real()
				!maxU = !wvol.part(6).replace('mm', '').real()
				!efpla = object direction()
				!nfpla = object direction()
				if min(abs(!boxYdir.angle(object direction('E'))), abs(!boxYdir.angle(object direction('W')))) lt min(abs(!boxYdir.angle(object direction('N'))), abs(!boxYdir.angle(object direction('S')))) then
					!efpla1 = !boxYdir
					!nfpla1 = !boxXdir
					!elen = !boxYlen
					!nlen = !boxXlen
				else
					!efpla1 = !boxXdir
					!nfpla1 = !boxYdir
					!elen = !boxXlen
					!nlen = !boxYlen
				endif
				if abs(!efpla1.angle(object direction('E'))) lt abs(!efpla1.angle(object direction('W'))) then
					!efpla = !efpla1
				else
					!efpla = !efpla1.opposite()
				endif
				if abs(!nfpla1.angle(object direction('N'))) lt abs(!nfpla1.angle(object direction('S'))) then
					!nfpla = !nfpla1
				else
					!nfpla = !nfpla1.opposite()
				endif
				!maxE1 = !boxPos.position().offset(!efpla,                !elen.real()  * 0.5 + 0.025).east
				!minE1 = !boxPos.position().offset(!efpla.opposite(),     !elen.real() * 0.5 + 0.025).east
				!maxN1 = !boxPos.position().offset(!nfpla,                !nlen.real()  * 0.5 + 0.025).north
				!minN1 = !boxPos.position().offset(!nfpla.opposite(),     !nlen.real()  * 0.5 + 0.025).north
				!maxU = !boxPos.position().offset(object direction('U'), !boxZlen.real() * 0.5 + 0.025).up
				!minU = !boxPos.position().offset(object direction('D'), !boxZlen.real() * 0.5 + 0.025).up
				!maxE = max(!maxE1, !minE1)
				!minE = min(!maxE1, !minE1)
				!maxN = max(!maxN1, !minN1)
				!minN = min(!maxN1, !minN1)
				!this.maxE = !maxE
				!this.minE = !minE
				!this.maxN = !maxN
				!this.minN = !minN
				!this.maxU = !maxU
				!this.minU = !minU
				!this.wmaxE = !maxE + 0.025
				!this.wminE = !minE - 0.025
				!this.wmaxN = !maxN + 0.025
				!this.wminN = !minN - 0.025

				--------------------------------------------------------------------
				-- DRAWLIST/LIMITS/CDLIMITS redo every update run -- they are      --
				-- computed purely from the box's current world extent, so redoing --
				-- is idempotent when the box has not moved and correct when it    --
				-- has. the IDLIST is cleared first, same object AVEVA's own       --
				-- 'Remove from View' uses, so a shrunk box does not leave stale   --
				-- zones behind                                                    --
				--------------------------------------------------------------------
				$!name/SS/DRAWLIST/DRWG
				!idlname = |$!name/SS/DRAWLIST/DRWG|
				!idli = object IDLIST(!idlname.dbref())
				!idli.clear()
				add all zone within E $!this.wminE N $!this.wminN U $!this.minU to E $!this.wmaxE N $!this.wmaxN U $!this.maxU
				add all REFGRD within E $!this.wminE N $!this.wminN U $!this.minU to E $!this.wmaxE N $!this.wmaxN U $!this.maxU
				!excls = object array()
				!excls = !this.excllist.dtext
				handle any
					!excls = object array()
				endhandle
				if (!excls.size().gt(0)) then
					do !excl values !excls
						!exclref = object DBREF()
						!exclref = !excl.dbref()
						handle any
						endhandle
						if (not(!exclref.badref())) then
							!idli.remove(!exclref)
							handle any
							endhandle
						endif
					enddo
					$!name/SS/DRAWLIST/DRWG
				endif
				limits E $!this.wminE N $!this.wminN U $!this.minU TO E $!this.wmaxE N $!this.wmaxN U $!this.maxU

				$!name/SS/S1/V1
				:CDLIMITS |FROM E $!this.wminE N $!this.wminN U $!this.minU TO E $!this.wmaxE N $!this.wmaxN U $!this.maxU|
				handle any
				endhandle

				--------------------------------------------------------------------
				-- VSEC/FPLA only redo when the box has actually moved or resized  --
				-- since the last run -- a non-orthogonal view's VSEC can get       --
				-- manually rotated square by the user, and that hand fix must     --
				-- survive an update where the box did not change. no separate     --
				-- record of "last box" is kept; the six existing FPLA positions   --
				-- already are that record, so they are read back and compared to  --
				-- the box's current faces instead                                 --
				--------------------------------------------------------------------
				!boxchanged = false
				$!name/SS/S1/V1/TOUP
				handle any
					!boxchanged = true
					!dbgf3.writerecord('STEP6 FPLA TOUP missing -> boxchanged=true')
				elsehandle none
					var !oldp position
					!oldpobj = object position(!oldp)
					!dbgf3.writerecord('STEP6 FPLA TOUP old.up=' & !oldpobj.up & ' new.maxU=' & !maxU & ' diff=' & (!oldpobj.up - !maxU))
					if (abs(!oldpobj.up - !maxU) gt 1) then
						!boxchanged = true
					endif
				endhandle
				if (not(!boxchanged)) then
					$!name/SS/S1/V1/FRUP
					var !oldp position
					!oldpobj = object position(!oldp)
					!dbgf3.writerecord('STEP6 FPLA FRUP old.up=' & !oldpobj.up & ' new.minU=' & !minU & ' diff=' & (!oldpobj.up - !minU))
					if (abs(!oldpobj.up - !minU) gt 1) then
						!boxchanged = true
					endif
				endif
				if (not(!boxchanged)) then
					$!name/SS/S1/V1/TOEP
					var !oldp position
					!oldpobj = object position(!oldp)
					!dbgf3.writerecord('STEP6 FPLA TOEP old.east=' & !oldpobj.east & ' new.maxE=' & !maxE & ' diff=' & (!oldpobj.east - !maxE))
					if (abs(!oldpobj.east - !maxE) gt 1) then
						!boxchanged = true
					endif
				endif
				if (not(!boxchanged)) then
					$!name/SS/S1/V1/FREP
					var !oldp position
					!oldpobj = object position(!oldp)
					!dbgf3.writerecord('STEP6 FPLA FREP old.east=' & !oldpobj.east & ' new.minE=' & !minE & ' diff=' & (!oldpobj.east - !minE))
					if (abs(!oldpobj.east - !minE) gt 1) then
						!boxchanged = true
					endif
				endif
				if (not(!boxchanged)) then
					$!name/SS/S1/V1/TONP
					var !oldp position
					!oldpobj = object position(!oldp)
					!dbgf3.writerecord('STEP6 FPLA TONP old.north=' & !oldpobj.north & ' new.maxN=' & !maxN & ' diff=' & (!oldpobj.north - !maxN))
					if (abs(!oldpobj.north - !maxN) gt 1) then
						!boxchanged = true
					endif
				endif
				if (not(!boxchanged)) then
					$!name/SS/S1/V1/FRNP
					var !oldp position
					!oldpobj = object position(!oldp)
					!dbgf3.writerecord('STEP6 FPLA FRNP old.north=' & !oldpobj.north & ' new.minN=' & !minN & ' diff=' & (!oldpobj.north - !minN))
					if (abs(!oldpobj.north - !minN) gt 1) then
						!boxchanged = true
					endif
				endif
				!dbgf3.writerecord('STEP6 boxchanged=' & !boxchanged)
				--------------------------------------------------------------------
				-- the annotation functions need to know this too. when the box    --
				-- has changed the border moves, and every point derived from the  --
				-- border moves with it -- which looks exactly like somebody       --
				-- having dragged that point aside, and the "was this dragged by   --
				-- hand" fallbacks would happily reuse it where it stands and      --
				-- leave it on the OLD border (2026-08-28)                         --
				--                                                                  --
				-- a global, not a member: the .pmlfnc files are re-read on every  --
				-- call and this form only on kill/show                            --
				--------------------------------------------------------------------
				!!DrawingPlan1BoxChanged = !boxchanged

				if (!boxchanged) then
					!thpoE = !boxPos.position().east
					!thpoN = !boxPos.position().north
					!thpoU = !boxPos.position().up
					!thpoEforN = !boxPos.position().offset(!nfpla,            !nlen.real() * 0.5).east
					!thpoEforS = !boxPos.position().offset(!nfpla.opposite(), !nlen.real() * 0.5).east
					!thpoNforR = !boxPos.position().offset(!efpla,            !elen.real() * 0.5).north
					!thpoNforL = !boxPos.position().offset(!efpla.opposite(), !elen.real() * 0.5).north

					------------------------------------------------------------------
					-- the six sides, listed the way DrawingPlan1LineNoAnnotation   --
					-- lists its own four (!dirlist / .part()). an array constructor --
					-- written straight into the loop -- do !side values object      --
					-- array('TOUP', ...) -- is not something PML will parse: it     --
					-- answers 'Invalid array expression' the moment box-changed is  --
					-- true and this branch is first reached (2026-08-28, reported   --
					-- live on the first box-grew test). same shape as the           --
					-- constructor-chaining restriction already known here           --
					------------------------------------------------------------------
					-- the element type is part of the command: a bare 'delete' is  --
					-- answered with 'CP: Incomplete command line' (2026-08-28).    --
					-- the two lines above create these as 'new vsec .../VSEC' and  --
					-- 'new fpla .../<side>', and the rest of this form deletes by  --
					-- type the same way ('delete drwg')                            --
					!sidelist = 'TOUP TONP TOEP FRUP FRNP FREP'
					do !ss from 1 to 6
						!side = !sidelist.part(!ss)
						$!name/SS/S1/V1/$!side/VSEC
						handle any
						elsehandle none
							delete vsec
						endhandle
						$!name/SS/S1/V1/$!side
						handle any
						elsehandle none
							delete fpla
						endhandle
					enddo

					$!name/SS/S1/V1/PLANES
					new fpla $!name/SS/S1/V1/TOUP
					position E $!thpoE N $!thpoN U $!maxU
					norm D
					end
					new fpla $!name/SS/S1/V1/TONP
					position E $!thpoEforN N $!maxN U $!thpoU
					!tempdir = !nfpla.opposite().string().before('WRT')
					norm $!tempdir
					end
					new fpla $!name/SS/S1/V1/TOEP
					position E $!maxE N $!thpoNforR U $!thpoU
					!tempdir = !efpla.opposite().string().before('WRT')
					norm $!tempdir
					end
					new fpla $!name/SS/S1/V1/FRUP
					position E $!thpoE N $!thpoN U $!minU
					norm U
					end
					new fpla $!name/SS/S1/V1/FRNP
					position E $!thpoEforS N $!minN U $!thpoU
					!tempdir = !nfpla.string().before('WRT')
					norm $!tempdir
					end
					new fpla $!name/SS/S1/V1/FREP
					position E $!minE N $!thpoNforL U $!thpoU
					!tempdir = !efpla.string().before('WRT')
					norm $!tempdir
					end

					$!name/SS/S1/V1
					new vsec $!name/SS/S1/V1/TOUP/VSEC
					plrf $!name/SS/S1/V1/TOUP
					end
					new vsec $!name/SS/S1/V1/TONP/VSEC
					plrf $!name/SS/S1/V1/TONP
					end
					new vsec $!name/SS/S1/V1/TOEP/VSEC
					plrf $!name/SS/S1/V1/TOEP
					end
					new vsec $!name/SS/S1/V1/FRUP/VSEC
					plrf $!name/SS/S1/V1/FRUP
					end
					new vsec $!name/SS/S1/V1/FRNP/VSEC
					plrf $!name/SS/S1/V1/FRNP
					end
					new vsec $!name/SS/S1/V1/FREP/VSEC
					plrf $!name/SS/S1/V1/FREP
					end
				endif

				--------------------------------------------------------------------
				-- view's own sheet-corner positions and scale, read from the      --
				-- existing (frozen) view instead of recalculated from the box.    --
				-- this also makes the update path use the view's real VSCA        --
				-- rather than the form's Drawing Scale field, ahead of step 7      --
				--------------------------------------------------------------------
				$!name/SS/S1/V1
				var !shxypos shxypos
				var !rcode rcode
				var !vsca vsca
				!this.rcode = !rcode
				!this.vsca = !vsca.real()
				var !oldsize size
				!dbgf3.writerecord('STEP6 SIZE old=' & !oldsize.part(1) & ' ' & !oldsize.part(2) & ' shxypos=' & !shxypos.part(1) & ' ' & !shxypos.part(2) & ' rcode=' & !rcode & ' vsca=' & !vsca)

				--------------------------------------------------------------------
				-- SIZE recalculated symmetric around the existing sheet centre     --
				-- (shxypos, which is XYPOSITION/THPOSITION projected to the sheet, --
				-- neither touched here), reaching out to the box's current extent  --
				-- on each side via shpos of. reproduces the existing SIZE exactly  --
				-- when the box has not moved or grown; grows it when it has, same  --
				-- side-that-did-not-grow-gets-padding rule as rebuild              --
				--------------------------------------------------------------------
				!ptEplus  = !boxPos.position().offset(!efpla,            !elen.real() * 0.5)
				!ptEminus = !boxPos.position().offset(!efpla.opposite(), !elen.real() * 0.5)
				!ptNplus  = !boxPos.position().offset(!nfpla,            !nlen.real() * 0.5)
				!ptNminus = !boxPos.position().offset(!nfpla.opposite(), !nlen.real() * 0.5)
				$!name/SS/S1/V1
				var !ptEplussh shpos of $!ptEplus
				var !ptEminussh shpos of $!ptEminus
				var !ptNplussh shpos of $!ptNplus
				var !ptNminussh shpos of $!ptNminus
				--------------------------------------------------------------------
				-- all four points on BOTH axes, not the E pair on X and the N pair --
				-- on Y. that pairing only holds while the view is unturned: with   --
				-- rcode Left the view is round 90 degrees, so the east extent      --
				-- lands on sheet Y and the north extent on sheet X -- and reading  --
				-- the E pair's X then measured the one coordinate those two points --
				-- SHARE, ie not the extent at all but the gap between the box      --
				-- centre and the view centre. that gave halfX 1.165 against a real --
				-- 162.413 and SIZE threw it out, taking the whole update down      --
				-- (reported live 2026-09-03 on /=23718/1652, rcode Left, 1:30)     --
				--                                                                  --
				-- taking the envelope of all four on each axis needs to know        --
				-- nothing about which way the view is turned: the pair that varies  --
				-- on an axis sets the extent there, and the pair that does not      --
				-- cannot exceed it                                                  --
				--------------------------------------------------------------------
				!hx1 = abs(!ptEplussh.part(2).replace('mm', '').real() - !shxypos.part(1).real().value())
				!hx2 = abs(!ptEminussh.part(2).replace('mm', '').real() - !shxypos.part(1).real().value())
				!hx3 = abs(!ptNplussh.part(2).replace('mm', '').real() - !shxypos.part(1).real().value())
				!hx4 = abs(!ptNminussh.part(2).replace('mm', '').real() - !shxypos.part(1).real().value())
				!halfX = max(max(!hx1, !hx2), max(!hx3, !hx4))
				!hy1 = abs(!ptEplussh.part(4).replace('mm', '').real() - !shxypos.part(2).real().value())
				!hy2 = abs(!ptEminussh.part(4).replace('mm', '').real() - !shxypos.part(2).real().value())
				!hy3 = abs(!ptNplussh.part(4).replace('mm', '').real() - !shxypos.part(2).real().value())
				!hy4 = abs(!ptNminussh.part(4).replace('mm', '').real() - !shxypos.part(2).real().value())
				!halfY = max(max(!hy1, !hy2), max(!hy3, !hy4))
				!dbgf3.writerecord('STEP6 SIZE ptEplussh=' & !ptEplussh & ' ptEminussh=' & !ptEminussh & ' ptNplussh=' & !ptNplussh & ' ptNminussh=' & !ptNminussh & ' halfX=' & !halfX & ' halfY=' & !halfY)
				-- the box's own extent, so a degenerate one shows up here rather --
				-- than only as a rejected SIZE further down                      --
				!dbgf3.writerecord('STEP6 SIZE inputs elen=' & !elen & ' nlen=' & !nlen & ' boxPos=' & !boxPos)
				if !rcode.eqnocase('up') then
					!sizePart1 = !halfX * 2
					!sizePart2 = !halfY * 2
				else
					!sizePart1 = !halfY * 2
					!sizePart2 = !halfX * 2
				endif
				!dbgf3.writerecord('STEP6 SIZE new=' & !sizePart1 & ' ' & !sizePart2)
				--------------------------------------------------------------------
				-- flushed here on purpose. SIZE below can reject what it is given  --
				-- ("Illegal value(s) for attribute SIZE", reported live on an      --
				-- update 2026-09-03), and the close() at the end of this block     --
				-- never runs when it does -- which left check3.txt three bytes     --
				-- long with none of the numbers that would say WHY                 --
				--------------------------------------------------------------------
				!dbgf3.close()
				handle any
				endhandle
				!dbgf3 = object file('L:\E3D\pdms_prog\E3D2.1\PA_pmllibE3D2.1\check3.txt')
				!dbgf3.open('append')
				$!name/SS/S1/V1
				--------------------------------------------------------------------
				-- and a rejected SIZE must not take the whole update down with it. --
				-- the view keeps the size it already had, which is the same thing  --
				-- an unchanged box would have given it, and the run carries on --   --
				-- everything below reads !size back off the view rather than       --
				-- assuming the write landed                                        --
				--------------------------------------------------------------------
				--------------------------------------------------------------------
				-- and only when the box actually changed. the note above claims   --
				-- this reproduces the existing SIZE exactly on an unchanged box,  --
				-- but that only holds while the view centre IS the box centre --   --
				-- it is on a drawing the rebuild centred, and it is not on        --
				-- /=23718/1652, whose two centres sit 1.165 x 17.951mm apart. on  --
				-- that one the symmetric formula answers 187 x 325 against an     --
				-- existing 155 x 357: a view that changes shape on an update      --
				-- where nothing moved, which clouds the whole drawing and can     --
				-- clip content off the short side. boxchanged is measured off the --
				-- six FPLA limits right above, so FALSE really does mean the      --
				-- extent is untouched and there is nothing to grow into           --
				--------------------------------------------------------------------
				if (!boxchanged) then
					SIZE $!sizePart1 $!sizePart2
					handle any
						!dbgf3.writerecord('STEP6 SIZE REJECTED part1=' & !sizePart1.string() & ' part2=' & !sizePart2.string() & ' -- view keeps its existing size')
					endhandle
				else
					!dbgf3.writerecord('STEP6 SIZE SKIPPED boxchanged=FALSE -- view keeps its existing size')
				endif
				var !size size

				if !rcode.eqnocase('up') then
					!this.viewULsh = 'x ' & string(!shxypos.part(1).real().value() - !size.part(1).real().value() * 0.5 - 0.025) & ' y ' & string(!shxypos.part(2).real().value() + !size.part(2).real().value() * 0.5 + 0.025)
					!this.viewURsh = 'x ' & string(!shxypos.part(1).real().value() + !size.part(1).real().value() * 0.5 + 0.025) & ' y ' & string(!shxypos.part(2).real().value() + !size.part(2).real().value() * 0.5 + 0.025)
					!this.viewLLsh = 'x ' & string(!shxypos.part(1).real().value() - !size.part(1).real().value() * 0.5 - 0.025) & ' y ' & string(!shxypos.part(2).real().value() - !size.part(2).real().value() * 0.5 - 0.025)
					!this.viewLRsh = 'x ' & string(!shxypos.part(1).real().value() + !size.part(1).real().value() * 0.5 + 0.025) & ' y ' & string(!shxypos.part(2).real().value() - !size.part(2).real().value() * 0.5 - 0.025)
				else
					!this.viewULsh = 'x ' & string(!shxypos.part(1).real().value() - !size.part(2).real().value() * 0.5 - 0.025) & ' y ' & string(!shxypos.part(2).real().value() + !size.part(1).real().value() * 0.5 + 0.025)
					!this.viewURsh = 'x ' & string(!shxypos.part(1).real().value() + !size.part(2).real().value() * 0.5 + 0.025) & ' y ' & string(!shxypos.part(2).real().value() + !size.part(1).real().value() * 0.5 + 0.025)
					!this.viewLLsh = 'x ' & string(!shxypos.part(1).real().value() - !size.part(2).real().value() * 0.5 - 0.025) & ' y ' & string(!shxypos.part(2).real().value() - !size.part(1).real().value() * 0.5 - 0.025)
					!this.viewLRsh = 'x ' & string(!shxypos.part(1).real().value() + !size.part(2).real().value() * 0.5 + 0.025) & ' y ' & string(!shxypos.part(2).real().value() - !size.part(1).real().value() * 0.5 - 0.025)
				endif
				!this.viewUlinesh = object line(!this.viewULsh.position(), !this.viewURsh.position())
				!this.viewDlinesh = object line(!this.viewLLsh.position(), !this.viewLRsh.position())
				!this.viewRlinesh = object line(!this.viewLRsh.position(), !this.viewURsh.position())
				!this.viewLlinesh = object line(!this.viewLLsh.position(), !this.viewULsh.position())
				--------------------------------------------------------------------
				-- the box edge in sheet coordinates. SIZE above is symmetric about --
				-- the frozen centre, so on the side the box did not grow the       --
				-- border stands off from it -- and everything the match line is    --
				-- made of belongs on the box edge, which is where the VSEC planes  --
				-- really cut, not on that padding. the four face midpoints were    --
				-- already projected for the SIZE calculation above; ADEGREES keeps --
				-- a turned box square on the sheet, so min/max over the four is    --
				-- the box outline whichever way round rcode has it (2026-08-29)    --
				--------------------------------------------------------------------
				!bxX1 = !ptEplussh.part(2).replace('mm', '').real()
				!bxX2 = !ptEminussh.part(2).replace('mm', '').real()
				!bxX3 = !ptNplussh.part(2).replace('mm', '').real()
				!bxX4 = !ptNminussh.part(2).replace('mm', '').real()
				!bxY1 = !ptEplussh.part(4).replace('mm', '').real()
				!bxY2 = !ptEminussh.part(4).replace('mm', '').real()
				!bxY3 = !ptNplussh.part(4).replace('mm', '').real()
				!bxY4 = !ptNminussh.part(4).replace('mm', '').real()
				!bxminX = min(min(!bxX1, !bxX2), min(!bxX3, !bxX4)) - 0.025
				!bxmaxX = max(max(!bxX1, !bxX2), max(!bxX3, !bxX4)) + 0.025
				!bxminY = min(min(!bxY1, !bxY2), min(!bxY3, !bxY4)) - 0.025
				!bxmaxY = max(max(!bxY1, !bxY2), max(!bxY3, !bxY4)) + 0.025
				!this.boxULsh = 'x ' & string(!bxminX) & ' y ' & string(!bxmaxY)
				!this.boxURsh = 'x ' & string(!bxmaxX) & ' y ' & string(!bxmaxY)
				!this.boxLLsh = 'x ' & string(!bxminX) & ' y ' & string(!bxminY)
				!this.boxLRsh = 'x ' & string(!bxmaxX) & ' y ' & string(!bxminY)
				!this.boxUlinesh = object line(!this.boxULsh.position(), !this.boxURsh.position())
				!this.boxDlinesh = object line(!this.boxLLsh.position(), !this.boxLRsh.position())
				!this.boxRlinesh = object line(!this.boxLRsh.position(), !this.boxURsh.position())
				!this.boxLlinesh = object line(!this.boxLLsh.position(), !this.boxULsh.position())
				!dbgf3.writerecord('STEP6 BOXCORNERS boxULsh=' & !this.boxULsh & ' boxURsh=' & !this.boxURsh & ' boxLLsh=' & !this.boxLLsh & ' boxLRsh=' & !this.boxLRsh)
				!dbgf3.writerecord('STEP6 APPLY END viewULsh=' & !this.viewULsh & ' viewURsh=' & !this.viewURsh & ' viewLLsh=' & !this.viewLLsh & ' viewLRsh=' & !this.viewLRsh)
				!dbgf3.close()

				-------------------------
				-- line no. annotation --
				-------------------------
				------------------------------------------------------------------
				-- update path never refreshed the view's own knowledge of the   --
				-- model before reading it back -- the rebuild path always does  --
				-- (UPDATE DESIGN, right above the same GridAnnotation/          --
				-- LineNoAnnotation/EquiAnnotation calls further up), but this   --
				-- branch went straight from SIZE into LineNoAnnotation with no  --
				-- update at all. reported live as label member resolution      --
				-- (MTBE) coming back a different, newly-made-up reference on   --
				-- every single update even with nothing else changing between  --
				-- runs -- consistent with the view working off whatever it     --
				-- last resolved at rebuild time instead of the model as it     --
				-- actually stands now (2026-08-27)                             --
				------------------------------------------------------------------
				$!name/SS/S1/V1
				UPDATE ALL
				------------------------------------------------------------------
				-- grid bubbles, now that they know how to reuse what is already --
				-- on the layer (DrawingPlan1GridClaim.pmlfnc). they hang off the --
				-- view border, so a box change moves every one of them, and      --
				-- leaving them out was why they stayed on the OLD border         --
				--                                                                --
				-- it also refills .allintersections, which is what lets the line --
				-- number annotation dimension the grid crossings on this path at --
				-- all -- until now that array was left empty on an update and    --
				-- the crossings were simply never revisited (2026-08-28)         --
				------------------------------------------------------------------
				!!DrawingPlan1GridAnnotation(!name)
				------------------------------------------------------------------
				-- the match line's tick positions, for the same reason as on    --
				-- the rebuild path above: they are dimensioned, so they have to --
				-- be known while the dimension chain is being built             --
				------------------------------------------------------------------
				$!name/SS/S1/V1
				!!DrawingPlan1MatchTicks(!name, !equistr)
				$!name/SS/S1/V1
				1
				last
				!!DrawingPlan1LineNoAnnotation(!name, !boxXlen.real(), !boxYlen.real())
				------------------------------------------------------------------
				-- equipment names and centre lines, added to this path         --
				-- 2026-09-03. left out until now, which meant a piece of        --
				-- equipment added to the model after the drawing was built     --
				-- never got a label, one deleted from it left its label        --
				-- standing for ever, and one that moved left its label behind  --
				-- (reported live). EquiAnnotation now claims its own name      --
				-- labels back by equipment NAME and redraws the centre lines   --
				-- from scratch, so calling it again is idempotent              --
				--                                                              --
				-- after LineNoAnnotation, not before: .equiparray is cleared   --
				-- and filled in there, and it is what tells this function      --
				-- which equipment already carries a dimension and so needs no  --
				-- name label of its own. same order as the rebuild path        --
				------------------------------------------------------------------
				$!name/SS/S1/V1
				!!DrawingPlan1EquiAnnotation(!name, !minE.string(), !minN.string(), !minU.string(), !maxE.string(), !maxN.string(), !maxU.string())
				------------------------------------------------------------------
				-- match line, now that it knows how to reuse what is already    --
				-- on the sheet (DrawingPlan1MatchClaim.pmlfnc). it is drawn     --
				-- entirely off the view border, so a box change moves every     --
				-- part of it -- leaving it out was why the match line stayed on --
				-- the OLD border after the first box-grew test (2026-08-28)     --
				--                                                               --
				-- the five BlankPos SLAB passes are still left out -- deferred, --
				-- see the note at the top of this branch. Flow runs last, below --
				------------------------------------------------------------------
				$!name/SS/S1/V1
				!!DrawingPlan1MatchLine(!name, !equistr)
				------------------------------------------------------------------
				-- the component labels FreezeLabels pinned to the page at the   --
				-- last revision, but only the ones a model change has run into: --
				-- a pipe drawn through a label is a wrong drawing, and the      --
				-- freeze is there to keep clouds off labels that did NOT change, --
				-- not to protect a wrong drawing (user, 2026-09-16; Notion      --
				-- revision toggle section 13). every one is offered to BlankPos --
				-- as 'pinned' with where it stands; BlankPos moves only those   --
				-- whose text box a hard entity actually crosses, to the nearest --
				-- free spot, and answers 'kept' for the rest, which are not     --
				-- touched at all. the DXF is exported here, labels included --  --
				-- the rebuild path exports before its labels exist. still not   --
				-- on this path: labels for new components, removal of labels    --
				-- whose component is gone                                       --
				------------------------------------------------------------------
				!this.PinnedLabelPass(!name, !rcode)
				----------------------------------------------------------------
				-- and the breaks where a dimension crosses a match line text. --
				-- last, because it needs the texts where they finally ended   --
				-- up: MatchLine is called once above and .RecenterView()      --
				-- calls it again after moving the view, and it is that second --
				-- set of positions the gaps have to line up with. a label the --
				-- pass above moved is where it now stands, too                 --
				--                                                              --
				-- it leaves CE on an LDIM or a bubble, so the view is         --
				-- navigated back to afterwards -- reading VIEWDIR or VSCA off  --
				-- the wrong element is what broke EquiAnnotation (c0a3e5d)     --
				----------------------------------------------------------------
				!!DrawingPlan1MatchGaps(!name)
				handle any
				endhandle
				$!name/SS/S1/V1
				handle any
				endhandle
				------------------------------------------------------------------
				-- flow arrows, added to this path 2026-09-18. they were left   --
				-- out on the belief that an arrow rides on its pipe -- it does  --
				-- not: its POS is a point in the model, written when the arrow  --
				-- was placed, and a pipe moved 100mm left its arrow standing on --
				-- the empty sheet (reported live). FlowAnnotation now reads the --
				-- arrows already on ateFLOW and keeps every one that still     --
				-- stands on a visible run of its branch, untouched, so an       --
				-- unchanged pipe is not clouded for its arrow; the rest are     --
				-- deleted and placed again. same place in the order as on the   --
				-- rebuild path: last, after MatchGaps, so the arrows are not    --
				-- offered as obstacles to anything                              --
				------------------------------------------------------------------
				$!name/SS/S1/V1
				1
				last
				!!DrawingPlan1FlowAnnotation(!name)
				------------------------------------------------------------------
				-- the view title: its words follow the box (a moved top) and    --
				-- the view scale, its place stays where it was. a sheet issued  --
				-- before the title existed gets one under what is there now,    --
				-- without the view moving -- see .ViewTitle()                   --
				------------------------------------------------------------------
				$!name/SS/S1/V1
				handle any
				endhandle
				!this.ViewTitle(!name, !box.string(), !this.TitleTopNow())
				$!name/SS/S1/V1
				handle any
				endhandle
				------------------------------------------------------------------
				-- update deliberately does NOT call .RecenterView() (2026-09-01, --
				-- reverted same day it was added): once a REVI exists the view   --
				-- must never move, full stop -- already tested and documented    --
				-- (Notion revision-management design doc, section 1 point 6): a  --
				-- view shifted 10mm on the sheet clouds the ENTIRE drawing,      --
				-- because the comparison is a picture diff, not an element diff. --
				-- .RecenterView() exists to move the view, so it is only safe    --
				-- on the rebuild path, before any REVI exists. update's          --
				-- XYPOSITION/THPOSITION stay exactly where they were (see the    --
				-- frozen-centre SIZE block above) even though that means         --
				-- rebuild's and update's own view placement can end up different --
				-- for the same box -- that is the accepted 2026-08-29 trade-off  --
				-- (padding on the side that did not grow), not a bug to          --
				-- converge away                                                  --
				------------------------------------------------------------------
			endif
		endhandle
		---------------------------------------------------------------------
		-- what DrawingPlan1Revision needs to know about this sheet's border --
		-- goes into the DRWG's NTEXT (user 2026-09-15: a DRWG has no DESC): --
		-- and the box of every text this form itself writes into the        --
		-- border. the revision form compares everything inside the canvas   --
		-- and, outside it, only those boxes -- so a changed drawing number  --
		-- gets a cloud and a changed drafter or date never does, whatever   --
		-- the project's border looks like. both paths, every run: the       --
		-- canvas may have been picked again since                          --
		---------------------------------------------------------------------
		!this.WriteRevInfo(!name, !equistr)
	enddo
endmethod

------------------------------------------------------------------------
-- one BlankPos 'pinned' record per component label already on the    --
-- sheet, or per support stack (the top label speaks for the block,   --
-- .suptstack is refilled so .PlaceLabelFromSpace can hang the rows): --
--                                                                      --
--   <ref> <anchor x> <anchor y> <w> <h> <type> pinned <cx> <cy> <rot> --
--                                                                      --
-- anchor: sheet position of the design point, as on the rebuild path. --
-- w/h/type: the same formulas the five annotation methods used when   --
-- they created the label, upright size -- the box BlankPos placed, so --
-- the crossing test is against what was reserved, not what the font   --
-- happens to draw. cx/cy: where the text stands now, the min/max of   --
-- the four EXTENT BTEX corners (as DrawingPlan1MatchGaps reads them), --
-- the union over a stack. rot: 270 when the label is turned 90 on top --
-- of the view's own rcode turn, else 0 -- BlankPos swaps w/h for it.  --
-- a label anything cannot be read from is left out, i.e. stays as it  --
-- is. labels of the other layers (line numbers, grid bubbles, flow    --
-- arrows) are not touched: the update path re-places them itself      --
------------------------------------------------------------------------
define method .PinnedLabelRecords(!name is string, !rcode is string) is array
	!recs = object array()
	!this.suptstack = object array()
	!labs = object array()
	$!name/SS/S1/V1
	handle any
		return !recs
	endhandle
	var !labs coll all (glab slab) for ce
	handle any
		return !recs
	endhandle
	!kinds = ' NOZZ VALV REDU INST SUPT '
	!base = 0
	if (!rcode.eqnocase('left')) then
		!base = 270
	endif
	!chsupt = !this.annotext.val.real()
	if (!this.supttog1.val) then
		!lineh = !chsupt * 1.2
	else
		!lineh = !chsupt
	endif
	----------------------------------------------------------------
	-- supports are gathered here and grouped by anchor further down --
	----------------------------------------------------------------
	!srefs  = object array()
	!saxs   = object array()   $( anchor, the exact strings for the record $)
	!says   = object array()
	!sxa    = object array()   $( anchor as numbers, for the grouping       $)
	!sya    = object array()
	!sws    = object array()   $( width by the support formula             $)
	!slen   = object array()   $( text length, orders the rows              $)
	!slead  = object array()   $( has the leader = top of its stack         $)
	!sx1    = object array()   $( text extent                               $)
	!sx2    = object array()
	!sy1    = object array()
	!sy2    = object array()
	!srot   = object array()
	do !l values !labs
		!lname = ''
		var !lname name of owner of $!l
		handle any
			skip
		endhandle
		-- '/X/SS/S1/V1/ateSUPT' -> 'SUPT'
		!kind = !lname.after('/ate').upcase()
		skip if (!kind.eq(''))
		skip if (not(!kinds.matchwild('* ' & !kind & ' *')))
		!ok = true
		$!l
		handle any
			!ok = false
		endhandle
		skip if (not(!ok))
		var !apos ( pos of ddna of $!l wrt worl )
		handle any
			!ok = false
		endhandle
		skip if (not(!ok))
		var !apos1 shpos of $!apos
		handle any
			!ok = false
		endhandle
		skip if (not(!ok))
		!axs = !apos1.part(2).replace('mm', '')
		!ays = !apos1.part(4).replace('mm', '')
		--------------------------------------------------------------
		-- where the text stands: four corners, min/max on each axis --
		--------------------------------------------------------------
		!ext = ''
		var !ext extent btex
		handle any
			!ok = false
		endhandle
		skip if (not(!ok))
		!ep = object array()
		!ep = !ext.split()
		skip if (!ep.size().lt(16))
		!x1 = !ep[2].replace('mm', '').real()
		!x2 = !x1
		!y1 = !ep[4].replace('mm', '').real()
		!y2 = !y1
		do !ci from 2 to 4
			!cix = !ci * 4 - 2
			!ciy = !ci * 4
			!cxv = !ep[!cix].replace('mm', '').real()
			!cyv = !ep[!ciy].replace('mm', '').real()
			!x1 = min(!x1, !cxv)
			!x2 = max(!x2, !cxv)
			!y1 = min(!y1, !cyv)
			!y2 = max(!y2, !cyv)
		enddo
		--------------------------------------------------------------
		-- turned on top of the view's own turn? the label's turn is  --
		-- 90 over the rcode base (0 up / 270 left), see the table in --
		-- .PlaceLabelFromSpace                                        --
		--------------------------------------------------------------
		!adeg = '0'
		var !adeg adeg
		handle any
			!adeg = '0'
		endhandle
		!rel = !adeg.real() - !base
		handle any
			!rel = 0
		endhandle
		if (!rel.lt(0)) then
			!rel = !rel + 360
		endif
		!rots = '0'
		if (!rel.gt(45) and !rel.lt(135)) then
			!rots = '270'
		endif
		if (!kind.eq('SUPT')) then
			!stext = ''
			var !stext stext of ddna
			handle any
				!ok = false
			endhandle
			skip if (not(!ok))
			if (!this.supttog1.val) then
				!w = !stext.length() * !chsupt * 0.66 + !chsupt
			else
				!w = !stext.length() * !chsupt * 0.6
			endif
			!ll = 'true'
			var !ll lleader
			handle any
				!ll = 'true'
			endhandle
			!srefs.append(!l)
			!saxs.append(!axs)
			!says.append(!ays)
			!sxa.append(!axs.real())
			!sya.append(!ays.real())
			!sws.append(!w)
			!slen.append(!stext.length())
			!slead.append(!ll.upcase().eq('TRUE'))
			!sx1.append(!x1)
			!sx2.append(!x2)
			!sy1.append(!y1)
			!sy2.append(!y2)
			!srot.append(!rots)
			skip
		endif
		if (!kind.eq('INST')) then
			!w   = 10
			!h   = 10
			!typ = 'circle'
		else
			var !chei chei
			if !chei.eqnocase('ByVStyle') then
				var !chei chei of owner
			endif
			var !exbtext exbtext
			!h   = !chei.replace('mm', '').real() + 0.5
			!w   = !exbtext.length() * !h * 0.65  $( 0.65 is text width factor $)
			!typ = 'box'
		endif
		!cx = (!x1 + !x2) * 0.5
		!cy = (!y1 + !y2) * 0.5
		!recs.append(!l & ' ' & !axs & ' ' & !ays & ' ' & !w.string('D3') & ' ' & !h.string('D3') & ' ' & !typ & ' pinned ' & !cx.string('D3') & ' ' & !cy.string('D3') & ' ' & !rots)
	enddo
	----------------------------------------------------------------
	-- support stacks: the ones sharing a point (1mm, as when they  --
	-- were made) are one block, as wide as the widest row and as   --
	-- tall as all of them, standing where their texts jointly are. --
	-- the top row is the one still carrying the leader; the rows   --
	-- below it go longest first, the order .SuptAnnotation made    --
	----------------------------------------------------------------
	!suptol = 1.0
	!ns = !srefs.size()
	!taken = object array()
	do !i from 1 to !ns
		!taken.append(false)
	enddo
	do !i from 1 to !ns
		skip if (!taken[!i])
		!grp = object array()
		!grp.append(!i)
		!taken[!i] = true
		do !j from 1 to !ns
			skip if (!taken[!j])
			-- through variables: a method cannot be called on what abs() returns
			!ddx = abs(!sxa[!j] - !sxa[!i])
			!ddy = abs(!sya[!j] - !sya[!i])
			if (!ddx.lt(!suptol) and !ddy.lt(!suptol)) then
				!grp.append(!j)
				!taken[!j] = true
			endif
		enddo
		!gn = !grp.size()
		-- the top: the row with the leader, else the first
		!itop = !grp[1]
		do !k from 1 to !gn
			!ik = !grp[!k]
			if (!slead[!ik]) then
				!itop = !ik
				break
			endif
		enddo
		-- block size and where it stands
		!maxw = 0
		!ux1 = !sx1[!itop]
		!ux2 = !sx2[!itop]
		!uy1 = !sy1[!itop]
		!uy2 = !sy2[!itop]
		do !k from 1 to !gn
			!ik = !grp[!k]
			if (!sws[!ik].gt(!maxw)) then
				!maxw = !sws[!ik]
			endif
			!ux1 = min(!ux1, !sx1[!ik])
			!ux2 = max(!ux2, !sx2[!ik])
			!uy1 = min(!uy1, !sy1[!ik])
			!uy2 = max(!uy2, !sy2[!ik])
		enddo
		!stackh = !lineh * !gn
		!cx = (!ux1 + !ux2) * 0.5
		!cy = (!uy1 + !uy2) * 0.5
		!top = !srefs[!itop]
		!recs.append(!top & ' ' & !saxs[!itop] & ' ' & !says[!itop] & ' ' & !maxw.string('D3') & ' ' & !stackh.string('D3') & ' boxr pinned ' & !cx.string('D3') & ' ' & !cy.string('D3') & ' ' & !srot[!itop])
		if (!gn.gt(1)) then
			-- followers, longest text first
			!fidx = object array()
			do !k from 1 to !gn
				!ik = !grp[!k]
				skip if (!ik.eq(!itop))
				!fidx.append(!ik)
			enddo
			!nf = !fidx.size()
			!nfm1 = !nf - 1
			do !a from 1 to !nfm1
				do !b from 1 to !nfm1
					!b1 = !b + 1
					!ia = !fidx[!b]
					!ib = !fidx[!b1]
					if (!slen[!ib].gt(!slen[!ia])) then
						!fidx[!b]  = !ib
						!fidx[!b1] = !ia
					endif
				enddo
			enddo
			!followers = ''
			do !k from 1 to !nf
				!fi = !fidx[!k]
				!followers = !followers & ' ' & !srefs[!fi]
			enddo
			!this.suptstack.append(!top & ' ' & !lineh & !followers)
		endif
	enddo
	return !recs
endmethod

------------------------------------------------------------------------
-- 'cloud <n>' records for BlankPos, one per OUTL of the sheet's       --
-- revision cloud NOTEs (name .../REVCLOUD or FUNC REVCLOUD, the same  --
-- test DrawingPlan1Revision uses to find them): n is how many VRTX   --
-- the OUTL has. the update path's DXF carries the clouds of the last --
-- revision -- DXFOUT writes them as loose polylines on layer 0 with  --
-- exactly that many vertices, and the revision triangle as a closed  --
-- 3 vertex one with the code text inside -- and to BlankPos they     --
-- were hard obstacles: a label a cloud outline crossed was 'hit',    --
-- moved, clouded at its new place, hit again by that cloud at the    --
-- next update... (user, 2026-09-17, 1 -> 2). the vertex count is the --
-- one thing PML can read of a cloud (a VRTX has no position          --
-- attribute), and it is enough for BlankPos to pick the outlines out --
------------------------------------------------------------------------
define method .CloudRecords(!name is string) is array
	!out = object array()
	!notes = object array()
	var !notes coll all note for $!name/SS/S1
	handle any
		return !out
	endhandle
	do !n values !notes
		!nname = ''
		var !nname name of $!n
		handle any
			!nname = ''
		endhandle
		!nfunc = ''
		var !nfunc func of $!n
		handle any
			!nfunc = ''
		endhandle
		skip if (not(!nname.trim().upcase().matchwild('*/REVCLOUD')) and !nfunc.trim().upcase().neq('REVCLOUD'))
		!outls = object array()
		var !outls coll all outl for $!n
		handle any
			skip
		endhandle
		do !o values !outls
			!vs = object array()
			var !vs coll all vrtx for $!o
			handle any
				skip
			endhandle
			!nv = !vs.size()
			skip if (!nv.lt(3))
			!out.append('cloud ' & !nv)
		enddo
		----------------------------------------------------------------
		-- and where the revision code texts stand (TEXP origin, the   --
		-- one thing of a cloud NOTE that CAN be read): a 3 vertex     --
		-- outline is only a revision triangle when one of these sits  --
		-- inside it -- the match line arrow heads (DrawingPlan1Match- --
		-- Arrow) are 3 vertex outlines too and must stay obstacles    --
		----------------------------------------------------------------
		!ctexts = object array()
		var !ctexts coll all texp for $!n
		handle any
			skip
		endhandle
		do !t values !ctexts
			!torg = ''
			var !torg origin of $!t
			handle any
				skip
			endhandle
			!txy = !!DrawingPlan1MatchXY(!torg)
			!tp = !txy.split('~')
			skip if (!tp.size().lt(2))
			skip if (!tp[1].eq('') or !tp[2].eq(''))
			!out.append('cloudtext ' & !tp[1] & ' ' & !tp[2])
		enddo
	enddo
	return !out
endmethod

------------------------------------------------------------------------
-- the update path's label pass, see the call in .Apply(): every      --
-- component label on the sheet goes to BlankPos as 'pinned' and only  --
-- the ones it answers 'moved' for are placed again -- switched to     --
-- relative for the arithmetic and pinned to the page once more        --
-- (.PlaceLabelFromSpace with freeze). an exported DXF this run could  --
-- not make means no pass at all: BlankPos would test the labels       --
-- against whatever DXF was left in the folder. a stale answer file is --
-- deleted for the same reason                                         --
------------------------------------------------------------------------
define method .PinnedLabelPass(!name is string, !rcode is string)
	!recs = object array()
	!recs = !this.PinnedLabelRecords(!name, !rcode)
	if (!recs.size().eq(0)) then
		return
	endif
	!pf = object file(!this.blankdir & 'WriteLabelToText.txt')
	if (!pf.exists()) then
		!pf.deletefile()
		handle any
		endhandle
	endif
	!pok = true
	!pf.open('overwrite')
	handle any
		!pok = false
	endhandle
	if (not(!pok)) then
		return
	endif
	do !r values !recs
		!pf.writerecord(!r)
	enddo
	!crecs = object array()
	!crecs = !this.CloudRecords(!name)
	handle any
		!crecs = object array()
	endhandle
	do !r values !crecs
		!pf.writerecord(!r)
	enddo
	!pf.close()
	handle any
	endhandle
	!this.AppendDimLines(!name)
	!ls = object file(!this.blankdir & 'LabelSpace.txt')
	if (!ls.exists()) then
		!ls.deletefile()
		handle any
		endhandle
	endif
	$!name/SS/S1/V1
	handle any
	endhandle
	!bpdxf = !this.blankdir & 'BlankPos1.dxf'
	!dxfok = true
	LIEXEC /Draft_DXF_LI 'DXFOUT' OutputF '$!bpdxf'
	handle any
		!dxfok = false
	endhandle
	if (not(!dxfok)) then
		return
	endif
	!this.RunBlankPos()
	!nmoved  = 0
	!nfailed = 0
	!ls = object file(!this.blankdir & 'LabelSpace.txt')
	if (!ls.exists()) then
		!ls.open('read')
		!lines = !ls.readfile()
		do !i from 1 to !lines.size()
			!lp = object array()
			!lp = !lines[!i].split()
			skip if (!lp.size().lt(10))
			skip if (not(!lp[10].eq('moved')))
			!this.PlaceLabelFromSpace(!lines[!i], !rcode, true)
			handle any
				!nfailed = !nfailed + 1
			elsehandle none
				!nmoved = !nmoved + 1
			endhandle
		enddo
		!ls.close()
	endif
	-- the update branch's own debug dump, see the STEP6 lines in .Apply()
	!dbgf3 = object file('L:\E3D\pdms_prog\E3D2.1\PA_pmllibE3D2.1\check3.txt')
	!dbgf3.open('append')
	handle any
	elsehandle none
		!dbgf3.writerecord('PINNED pass: ' & !recs.size() & ' label record(s) offered, ' & !nmoved & ' moved, ' & !nfailed & ' failed to place')
		!dbgf3.close()
	endhandle
	$!name/SS/S1/V1
	handle any
	endhandle
endmethod

------------------------------------------------------------------------
-- the lines a label is ALLOWED to stand on, appended to the BlankPos --
-- parameter file after every annotation has had its say. see          --
-- DrawingPlan1DimLines for why this list is PML's to write and not    --
-- something BlankPos works out from the DXF. an empty list is the old --
-- behaviour exactly -- every entity solid                             --
------------------------------------------------------------------------
define method .AppendDimLines(!name is string)
	!dlrecs = object array()
	!dlrecs = !!DrawingPlan1DimLines(!name)
	handle any
		!dlrecs = object array()
	endhandle
	if (!dlrecs.size().gt(0)) then
		!dlopen = true
		!dlf = object file(!this.blankdir & 'WriteLabelToText.txt')
		!dlf.open('append')
		handle any
			!dlopen = false
		endhandle
		if (!dlopen) then
			do !dlr values !dlrecs
				!dlf.writerecord(!dlr)
			enddo
			!dlf.close()
			handle any
			endhandle
		endif
	endif
endmethod

------------------------------------------------------------------------
-- run BlankPos.exe on what is in .blankdir. says so loudly when the   --
-- exe was not found on the PMLLIB path: letting the syscom fail       --
-- quietly would leave every label at its starting point with nothing --
-- to say why. shared by the rebuild path and the pinned label pass of --
-- the update path                                                     --
------------------------------------------------------------------------
define method .RunBlankPos()
	------------------------------------------------------------------
	-- the folder goes on the command line, so PML is the only place --
	-- that decides it and the exe never needs a rebuild to follow   --
	-- it. strip the trailing backslash first: Windows argv parsing  --
	-- reads a backslash before the closing quote as an escape and   --
	-- would swallow the quote, handing the exe a mangled path       --
	------------------------------------------------------------------
	!bpnd  = !this.blankdir.length() - 1
	!bparg = !this.blankdir.substring(1, !bpnd)
	------------------------------------------------------------------
	-- and the match line rectangle, so BlankPos can keep labels     --
	-- inside it where it can. outside the box is where the          --
	-- dimensions live, and a leader dragged out there crosses them. --
	-- BlankPos cannot test that directly -- the DXF export puts     --
	-- every entity on layer 0, so a dimension line and a pipe       --
	-- centre line are indistinguishable to it -- so staying inside  --
	-- the box stands in for it. the four match line straights are   --
	-- drawn on exactly these corners, see DrawingPlan1MatchLine,    --
	-- and on the sheet the box is always square, so two corners do  --
	------------------------------------------------------------------
	!bpx1 = !this.boxLLsh.part(2).real()
	!bpy1 = !this.boxLLsh.part(4).real()
	!bpx2 = !this.boxURsh.part(2).real()
	!bpy2 = !this.boxURsh.part(4).real()
	!bprect = '' & !bpx1 & ' ' & !bpy1 & ' ' & !bpx2 & ' ' & !bpy2
	------------------------------------------------------------------
	-- say so loudly when the exe was not found on the PMLLIB path. --
	-- letting the syscom fail quietly would leave every label at    --
	-- its XYPO 15 15 starting point with nothing to say why         --
	------------------------------------------------------------------
	if (!this.blankexe.eq('')) then
		!!alert.error('BlankPos.exe not found in any bin folder on the PMLLIB search path - labels will not be repositioned')
	else
		--------------------------------------------------------------
		-- the whole command carries one extra pair of quotes round  --
		-- the outside. cmd /c, given a string with more than two    --
		-- quote characters, strips the leading one and the last one --
		-- -- so a plain '"exe" "dir" "rect"' reaches the shell as   --
		-- exe" "dir" "rect and fails on an executable name with a   --
		-- trailing quote, silently (nothing was written at all,     --
		-- 2026-09-10; the same command run by hand worked). the     --
		-- outer pair is what gets eaten instead                     --
		--------------------------------------------------------------
		!bpcmd = '""' & !this.blankexe & '" "' & !bparg & '" "' & !bprect & '""'
		syscom |$!bpcmd|
	endif
endmethod

------------------------------------------------------------------------
-- one line of LabelSpace.txt back onto the sheet: XYPO, Adegrees and  --
-- the leader attach point of the label it names, plus the rows of a  --
-- support stack hung under it (.suptstack). !freeze is the update    --
-- path's flag: the label is OSET FALSE on the page and has to be     --
-- switched to relative for the arithmetic below, then pinned again   --
------------------------------------------------------------------------
define method .PlaceLabelFromSpace(!lsline is string, !rcode is string, !freeze is boolean)
	!slab = !lsline.part(1)
	$!slab
	if (!freeze) then
		OSET TRUE
		handle any
		endhandle
	endif
	var !apos ( pos of ddna of $!slab wrt worl )
	var !apos1 shpos of $!apos
	------------------------------------------------------------------
	-- a label BlankPos could only fit by standing on end comes back --
	-- with 270 in field 9. field 9 is absent when the deployed      --
	-- BlankPos predates this, which reads as no turn                --
	--                                                                --
	-- these are TWO different turns and the first version of this   --
	-- conflated them (2026-09-11, measured off a real sheet):        --
	--                                                                --
	--  * rcode left turns the whole VIEW. XYPO counts in the view's  --
	--    own frame, so its axes turn with it and the x/y swap below  --
	--    is what puts a label where the sheet coordinate says. this  --
	--    is the original behaviour and is keyed on rcode ALONE       --
	--                                                                --
	--  * field 9 turns ONE LABEL. Adegrees only turns the text --   --
	--    it does not move the frame XYPO counts in -- so a turned    --
	--    label's position is worked out exactly like an unturned     --
	--    one. taking the rcode-left branch for it put every turned   --
	--    label somewhere else entirely: /162966 was asked for sheet  --
	--    (405.8, 399.9) and landed on (265.1, 365.8), 140mm away,    --
	--    which is why it sat outside the match line box on a leader  --
	--    across half the drawing                                     --
	------------------------------------------------------------------
	!lparts = !lsline.split()
	!nlp    = !lparts.size()
	!lrot   = 0
	if (!nlp.gt(8)) then
		!lrot = !lparts[9].real()
	endif
	!turned = !lrot.gt(45)
	------------------------------------------------------------------
	-- position: the view's frame, and nothing else                  --
	------------------------------------------------------------------
	if (!rcode.eqnocase('up')) then
		!newx = !lsline.part(2).real() - !apos1.part(2).replace('mm', '').real()
		!newy = !lsline.part(3).real() - !apos1.part(4).replace('mm', '').real()
		!adeg = 0
	else
		--------------------------------------------------------------
		-- rcode left: the view is round 90 degrees, so view +x runs  --
		-- up the sheet and XYPO swaps with it. 270 cancels the turn  --
		-- so the text still reads across the sheet                   --
		--------------------------------------------------------------
		!newx = !lsline.part(3).real() - !apos1.part(4).replace('mm', '').real()
		!newy = ( !lsline.part(2).real() - !apos1.part(2).replace('mm', '').real()) * -1
		!adeg = 270
	endif
	------------------------------------------------------------------
	-- and the label's own turn on top of that, as an angle only.    --
	--                                                                --
	-- 90 and not 270, so a label that had to stand on end reads     --
	-- the way the dimension figures beside it already do: bottom to  --
	-- top, head tilted left. 270 was tried first and came out the    --
	-- other way up (user, 2026-09-11). this also decides which end   --
	-- of the stack the longest row goes -- see the table below       --
	------------------------------------------------------------------
	if (!turned) then
		!adeg = !adeg + 90
		if (!adeg.gt(359)) then
			!adeg = !adeg - 360
		endif
	endif
	------------------------------------------------------------------
	-- spelled out rather than substituted from the number: a REAL   --
	-- can come back as 270.00000 and this is a command line, not a  --
	-- PML expression                                                --
	------------------------------------------------------------------
	!adegs = '0'
	if (!adeg.eq(90)) then
		!adegs = '90'
	elseif (!adeg.eq(180)) then
		!adegs = '180'
	elseif (!adeg.eq(270)) then
		!adegs = '270'
	endif
	Adegrees $!adegs
	XYPO $!newx $!newy
	------------------------------------------------------------------
	-- which way is UP for whoever reads this label, in the same      --
	-- frame XYPO counts in. the rows of a stack go this way, longest --
	-- at the top:                                                     --
	--   Adegrees   0 -> +y      90 -> -x                             --
	--            180 -> -y     270 -> +x                             --
	------------------------------------------------------------------
	!rowdx = 0
	!rowdy = 1
	if (!adeg.eq(270)) then
		!rowdx = 1
		!rowdy = 0
	elseif (!adeg.eq(180)) then
		!rowdx = 0
		!rowdy = -1
	elseif (!adeg.eq(90)) then
		!rowdx = -1
		!rowdy = 0
	endif
	--------------------------------------------------------------
	-- a support label that carries a stack was written out as   --
	-- one block, so what came back is where the block goes, not --
	-- where this label goes. lift it to the top row and hang    --
	-- the rest underneath, along !rowdx/!rowdy above           --
	--------------------------------------------------------------
	!sparts = object array()
	do !sline values !this.suptstack
		!sp = !sline.split()
		if (!sp[1].eq(!slab)) then
			!sparts = !sp
			break
		endif
	enddo
	!shift = 0
	!nsp   = !sparts.size()
	if (!nsp.gt(0)) then
		!slineh = !sparts[2].real()
		!nrows  = !nsp - 1
		!shift  = (!nrows - 1) * !slineh * 0.5
		--------------------------------------------------------------
		-- the rows run along whichever axis is UP for the reader,    --
		-- not always y: a turned label reads down the sheet, so its  --
		-- rows sit side by side instead. stacking them in y the way  --
		-- an unturned one does put all three on one spot, one inside --
		-- the next (2026-09-11, /162966's three rows)                --
		--------------------------------------------------------------
		!topx = !newx + !rowdx * !shift
		!topy = !newy + !rowdy * !shift
		XYPO $!topx $!topy
		do !r from 3 to !nsp
			!fslab = !sparts[!r]
			$!fslab
			if (!freeze) then
				OSET TRUE
				handle any
				endhandle
			endif
			var !fapos ( pos of ddna of $!fslab wrt worl )
			var !fapos1 shpos of $!fapos
			if (!rcode.eqnocase('up')) then
				!fx0 = !lsline.part(2).real() - !fapos1.part(2).replace('mm', '').real()
				!fy0 = !lsline.part(3).real() - !fapos1.part(4).replace('mm', '').real()
			else
				!fx0 = !lsline.part(3).real() - !fapos1.part(4).replace('mm', '').real()
				!fy0 = ( !lsline.part(2).real() - !fapos1.part(2).replace('mm', '').real()) * -1
			endif
			Adegrees $!adegs
			!rdown = !r - 2
			!roff  = !shift - !rdown * !slineh
			!fx    = !fx0 + !rowdx * !roff
			!fy    = !fy0 + !rowdy * !roff
			XYPO $!fx $!fy
		enddo
		$!slab
	endif
	--------------------------------------------------
	-- change label connect point to make leader is --
	-- from attachment point to label center point  --
	--------------------------------------------------
	!ltype = !lsline.part(8)
	if (!ltype.matchwild('box*')) then
		--------------------------------
		-- create label text boundary --
		--------------------------------
		!tboxLD = 'x ' & str(!lsline.part(2).real() - !lsline.part(6).real() * 0.5) & ' y ' & str(!lsline.part(3).real() - !lsline.part(7).real() * 0.5)
		!tboxRD = 'x ' & str(!lsline.part(2).real() + !lsline.part(6).real() * 0.5) & ' y ' & str(!lsline.part(3).real() - !lsline.part(7).real() * 0.5)
		!tboxLU = 'x ' & str(!lsline.part(2).real() - !lsline.part(6).real() * 0.5) & ' y ' & str(!lsline.part(3).real() + !lsline.part(7).real() * 0.5)
		!tboxRU = 'x ' & str(!lsline.part(2).real() + !lsline.part(6).real() * 0.5) & ' y ' & str(!lsline.part(3).real() + !lsline.part(7).real() * 0.5)
		!tboxL = object line()
		!tboxL.startposition = !tboxLD.position()
		!tboxL.endposition = !tboxLU.position()
		!tboxR = object line()
		!tboxR.startposition = !tboxRD.position()
		!tboxR.endposition = !tboxRU.position()
		!tboxU = object line()
		!tboxU.startposition = !tboxLU.position()
		!tboxU.endposition = !tboxRU.position()
		!tboxD = object line()
		!tboxD.startposition = !tboxLD.position()
		!tboxD.endposition = !tboxRD.position()
		!labell = object line()
		!labelltemp = 'x ' & !lsline.part(2) & ' y ' & !lsline.part(3)
		!labell.startposition = !labelltemp.position()
		!labelltemp = 'x ' & !apos1.part(2).replace('mm', '') & ' y ' & !apos1.part(4).replace('mm', '')
		!labell.endposition = !labelltemp.position()
		--------------------------------------------------------------------------------------
		-- check intersections between label boundary and leader line are on label boundary --
		-- sort the distance between attachment point and intersections and get the minimun --
		--------------------------------------------------------------------------------------
		!tboxpt = object array()
		!tempp = !labell.intersection(!tboxL)
		handle any
			-- for parellel condition --
		elsehandle none
			if !tboxL.on(!tempp, true) then
				!tboxpt.append(!tempp)
			endif
		endhandle
		!tempp = !labell.intersection(!tboxR)
		handle any
			-- for parellel condition --
		elsehandle none
			if !tboxR.on(!tempp, true) then
				!tboxpt.append(!tempp)
			endif
		endhandle
		!tempp = !labell.intersection(!tboxU)
		handle any
			-- for parellel condition --
		elsehandle none
			if !tboxU.on(!tempp, true) then
				!tboxpt.append(!tempp)
			endif
		endhandle
		!tempp = !labell.intersection(!tboxD)
		handle any
			-- for parellel condition --
		elsehandle none
			if !tboxD.on(!tempp, true) then
				!tboxpt.append(!tempp)
			endif
		endhandle
		-------------------------------------------------------------------------
		-- pick the intersection nearest !apos1 directly in PML instead of via  --
		-- AteSortLineNo.Method(). that method round-trips the sort key through --
		-- PML .string() and then C# double.Parse, and on a turned box it threw --
		-- FormatException (PML Error in method METHOD: 輸入字串格式不正確).      --
		-- the exact string that broke the parse was never captured, so the fix --
		-- is to drop the round trip altogether rather than guess at it: only   --
		-- the nearest of four points is wanted, which needs no sorting and no  --
		-- crossing of the PML/.NET boundary                                    --
		-------------------------------------------------------------------------
		if !tboxpt.size().gt(0) then
			!closept = !tboxpt[1]
			!closedist = !apos1.position().distance(!closept)
			do !k from 2 to !tboxpt.size()
				!thisdist = !apos1.position().distance(!tboxpt[!k])
				if !thisdist.lt(!closedist) then
					!closept = !tboxpt[!k]
					!closedist = !thisdist
				endif
			enddo
			!closestr = '' & !closept
			!cdx = !closestr.part(2).replace('mm', '').real() - !lsline.part(2).real()
			!cdy = !closestr.part(4).replace('mm', '').real() - !lsline.part(3).real()
			--------------------------------------------------------
			-- three frames, and cpoftx wants the third:            --
			--                                                      --
			--  sheet  what LabelSpace and the box corners above    --
			--         are in                                       --
			--  view   what XYPO counts in. a left hand view is the --
			--         sheet turned 90, so x and y swap -- the same --
			--         swap XYPO took further up                    --
			--  text   what cpoftx counts in: the VIEW frame turned --
			--         by Adegrees. found the hard way (2026-09-11): --
			--         a label BlankPos had stood on end took its   --
			--         leader straight through the frame to the     --
			--         middle of the text, because a sheet offset   --
			--         of (-1.8, 0) read as a text offset came out  --
			--         on the sheet as (0, -1.8). it never showed   --
			--         before because rcode left turns the view 90  --
			--         and the text 270, which lands the text frame --
			--         back on the sheet's                          --
			--------------------------------------------------------
			if (!rcode.eqnocase('up')) then
				!vdx = !cdx
				!vdy = !cdy
			else
				!vdx = !cdy
				!vdy = !cdx * -1
			endif
			--------------------------------------------------------
			-- the boundary above is the whole block, but a label  --
			-- carrying a stack no longer sits at the block centre --
			-- -- it was lifted to the top row. take that back out --
			-- or the leader lands one row short. !rowdx/!rowdy    --
			-- are in the view frame, so this goes here            --
			--------------------------------------------------------
			!vdx = !vdx - !rowdx * !shift
			!vdy = !vdy - !rowdy * !shift
			--------------------------------------------------------
			-- view -> text. Adegrees is anticlockwise, so the      --
			-- text's axes in the view are (cos, sin) and           --
			-- (-sin, cos):                                          --
			--     0: ( x,  y)     90: ( y, -x)                     --
			--   180: (-x, -y)    270: (-y,  x)                     --
			--------------------------------------------------------
			if (!adeg.eq(90)) then
				!cpx = !vdy
				!cpy = !vdx * -1
			elseif (!adeg.eq(180)) then
				!cpx = !vdx * -1
				!cpy = !vdy * -1
			elseif (!adeg.eq(270)) then
				!cpx = !vdy * -1
				!cpy = !vdx
			else
				!cpx = !vdx
				!cpy = !vdy
			endif
			cpoftx |$!cpx $!cpy|
		endif
	endif
	----------------------------------------------------------------
	-- and back onto the page. the update path hands in labels that --
	-- DrawingPlan1Revision.FreezeLabels pinned (OSET FALSE) at the --
	-- last revision; they were switched to relative above so the   --
	-- XYPO/cpoftx arithmetic is the same as on the rebuild path,   --
	-- and are pinned again here, followers included. E3D converts  --
	-- the coordinates on the switch, the picture does not move     --
	----------------------------------------------------------------
	if (!freeze) then
		$!slab
		OSET FALSE
		handle any
		endhandle
		do !r from 3 to !nsp
			!fslab = !sparts[!r]
			$!fslab
			OSET FALSE
			handle any
			endhandle
		enddo
		$!slab
		handle any
		endhandle
	endif
endmethod

------------------------------------------------------------------------
-- NTEXT of DRWG <name>/SS: 'CV x1 y1 x2 y2' (the canvas, sheet mm) and --
-- 'W x1 y1 x2 y2' per text this form writes into the border, joined   --
-- with ';'. read by DrawingPlan1Revision.Compare. the built in canvas  --
-- is the one .RecenterView() falls back to when none was picked        --
------------------------------------------------------------------------
define method .WriteRevInfo(!name is string, !equistr is string)
	!cv = 'CV 107 115 607 515'
	if (not(!!DrawingPlan1.canvassize.unset())) then
		!c = '' & !!DrawingPlan1.canvassize
		!cv = 'CV ' & !c.part(2) & ' ' & !c.part(4) & ' ' & !c.part(6) & ' ' & !c.part(8)
		handle any
			!cv = 'CV 107 115 607 515'
		endhandle
	endif
	!info = !cv
	if not(!this.dwgnopos.val.eqnocase('')) and not(!this.dwgnohei.val.eqnocase('')) then
		!w = !this.WatchRect(!this.dwgnopos.val, !this.dwgnohei.val, !equistr)
		if (!w.neq('')) then
			!info = !info & ';' & !w
		endif
	endif
	$!name/SS
	handle any
		return
	endhandle
	NTEXT |$!info|
	handle any
	endhandle
endmethod

------------------------------------------------------------------------
-- 'W x1 y1 x2 y2' round a border text written with alig base just    --
-- left at 'x,y' (sheet mm), height !hei (with or without mm), !text. --
-- the width is an estimate, 0.8 x height per character, which is all --
-- the revision comparison needs: the box only says which changed     --
-- primitives count, it is not drawn. '' when the numbers do not parse --
------------------------------------------------------------------------
define method .WatchRect(!pos is string, !hei is string, !text is string) is string
	!xy = !pos.split(',')
	if (!xy.size().lt(2)) then
		return ''
	endif
	!x = !xy[1].trim().real()
	handle any
		return ''
	endhandle
	!y = !xy[2].trim().real()
	handle any
		return ''
	endhandle
	!hs = !hei.replace('mm', '').trim()
	!h = !hs.real()
	handle any
		return ''
	endhandle
	!w = 0.8 * !h * !text.length() + 2
	!x1 = !x - 1
	!y1 = !y - 1
	!x2 = !x + !w
	!y2 = !y + !h + 1
	return 'W ' & !x1.string('D1') & ' ' & !y1.string('D1') & ' ' & !x2.string('D1') & ' ' & !y2.string('D1')
endmethod

------------------------------------------------------------------------
-- fit the view (and everything hanging off it) to the printable canvas --
-- and put back the handful of things that do not travel with a view    --
-- move automatically. shared by both the rebuild and the update branch --
-- of .Apply() -- update did not call this at all until 2026-08-31, and --
-- that asymmetry (not any per-label freeze logic) was the actual cause --
-- of rebuild's and update's GLAB/LDIM sheet positions disagreeing after --
-- a box resize: every element's real-world anchor already agreed, only --
-- the view's own placement on the sheet did not                        --
--                                                                       --
-- idempotent by construction: it asks "does the CURRENT view, with the --
-- CURRENT annotation reach, already fit the CURRENT canvas" and moves   --
-- it only by however much it does not. run it twice in a row and the   --
-- second call finds nothing left to fix                                --
------------------------------------------------------------------------
define method .RecenterView(!name is string, !equistr is string)
	!cvx1 = 107
	!cvx2 = 607
	!cvy1 = 115
	!cvy2 = 515
	if (not(!!DrawingPlan1.canvassize.unset())) then
		!cvx1 = min(!!DrawingPlan1.canvassize.part(2).real(), !!DrawingPlan1.canvassize.part(6).real())
		!cvx2 = max(!!DrawingPlan1.canvassize.part(2).real(), !!DrawingPlan1.canvassize.part(6).real())
		!cvy1 = min(!!DrawingPlan1.canvassize.part(4).real(), !!DrawingPlan1.canvassize.part(8).real())
		!cvy2 = max(!!DrawingPlan1.canvassize.part(4).real(), !!DrawingPlan1.canvassize.part(8).real())
	endif
	-- the view, grown by what its annotation reaches on each side --
	!ocx1 = min(!this.viewLLsh.part(2).real(), !this.viewURsh.part(2).real()) - !this.labbandleft
	!ocx2 = max(!this.viewLLsh.part(2).real(), !this.viewURsh.part(2).real()) + !this.labbandright
	!ocy1 = min(!this.viewLLsh.part(4).real(), !this.viewURsh.part(4).real()) - !this.labbanddown
	!ocy2 = max(!this.viewLLsh.part(4).real(), !this.viewURsh.part(4).real()) + !this.labbandup
	----------------------------------------------------------------------
	-- and by the grid bubbles, which are not in those bands. the bands  --
	-- are filled in by LineNoAnnotation and describe its own dimension  --
	-- chain and labels; the bubbles are placed by GridAnnotation, 50mm  --
	-- of the sheet outside the view border on every side. on a side     --
	-- where the labels reach further out the bubbles change nothing --  --
	-- but where they do not, the drawing was pushed off centre by the   --
	-- difference: measured on the A1 which reported this, up 73.00 and  --
	-- left 71.95 covered their bubbles while down 40.20 and right 41.60 --
	-- did not, so the view was moved 16.4mm down onto a bottom bubble   --
	-- 3mm from the edge of the canvas with 20mm of air left above it    --
	-- (reported live 2026-09-04)                                        --
	--                                                                    --
	-- .DrawingPlan1GridBubbles carries one side~x~y record per bubble,  --
	-- in sheet coordination, appended as each one is placed. it is      --
	-- emptied at the top of GridAnnotation, which runs once per drawing --
	-- and before this, so it holds this drawing and no other. !gbubrad  --
	-- is the bubble drawing itself, which hangs off the recorded point: --
	-- 3.8mm of it measured below the centre of the bottom one, rounded  --
	-- up so that the allowance never falls short                        --
	----------------------------------------------------------------------
	!gbubn = 0
	!gbubn = !!DrawingPlan1GridBubbles.size()
	handle any
		!gbubn = 0
	endhandle
	!gbubrad = 5
	do !gbubi from 1 to !gbubn
		!gbubp = object array()
		!gbubp = !!DrawingPlan1GridBubbles[!gbubi].split('~')
		handle any
			skip
		endhandle
		if (!gbubp.size().gt(2)) then
			--------------------------------------------------------
			-- the mm comes off before .real(), the way every other --
			-- reading of a coordinate in this file does it. these  --
			-- records are written with string(), which keeps the   --
			-- unit on, and .real() keeps it on too -- the unit     --
			-- then travelled all the way through !ocx1 into !dx    --
			-- and out again as XYPOSITION X 365.475mmmm, which E3D --
			-- refused, and into the cached view corners, where the --
			-- .NET sort in FlowAnnotation would not parse it       --
			-- (reported live 2026-09-04)                           --
			--------------------------------------------------------
			!gbubx = !gbubp[2].replace('mm', '').real()
			!gbuby = !gbubp[3].replace('mm', '').real()
			!ocx1 = min(!ocx1, !gbubx - !gbubrad)
			!ocx2 = max(!ocx2, !gbubx + !gbubrad)
			!ocy1 = min(!ocy1, !gbuby - !gbubrad)
			!ocy2 = max(!ocy2, !gbuby + !gbubrad)
		endif
	enddo
	----------------------------------------------------------------------
	-- and by the view title, which goes under all of it (.ViewTitle(),  --
	-- user 2026-09-24): the bottom of the annotation as it stands is    --
	-- where the title hangs from, and the title's own depth is added    --
	-- below that so the centring makes room for it instead of pushing  --
	-- it off the canvas afterwards                                      --
	----------------------------------------------------------------------
	!this.titletop = !ocy1
	!ocy1 = !ocy1 - !this.TitleDepth()
	----------------------------------------------------------------------
	-- how far it sticks out of each edge, and the move which centres it --
	--                                                                   --
	-- (!ovl - !ovr) * 0.5 IS the centring shift: it multiplies out to   --
	-- the middle of the canvas minus the middle of the content, and it  --
	-- holds whichever way the two overflows come out. so there is one   --
	-- formula and no branches -- content which fits lands in the middle --
	-- of the canvas, and content too big for the canvas has what will   --
	-- not fit shared evenly between the two sides, which is what the    --
	-- both-overflowing branch used to do on its own                     --
	--                                                                   --
	-- it used to move the view only when a side really overflowed, and  --
	-- then by the least it could get away with, so content which fitted --
	-- was left wherever .Apply() first put it. that centres the view    --
	-- FRAME and not what is drawn: the label bands are not symmetric    --
	-- (73mm of sheet on the left against 18mm on the right, 46.6 up     --
	-- against 66.95 down, measured on the A1 which reported this), so   --
	-- the drawing sat low in its canvas with room to spare above it     --
	-- (reported live 2026-09-04)                                        --
	--                                                                   --
	-- only the rebuild path comes through here. the update path does    --
	-- not call .RecenterView() at all (see the note by the call), so a  --
	-- drawing which has been issued is never re-centred underneath its  --
	-- own dimensions                                                    --
	----------------------------------------------------------------------
	!ovl = !cvx1 - !ocx1
	!ovr = !ocx2 - !cvx2
	!dx = (!ovl - !ovr) * 0.5
	!ovd = !cvy1 - !ocy1
	!ovu = !ocy2 - !cvy2
	!dy = (!ovd - !ovu) * 0.5
	----------------------------------------------------------------------
	-- no unit past this point. these two are written into an XYPOSITION --
	-- command and added into the cached view corners, and a stray mm    --
	-- breaks both -- E3D refuses XYPOSITION X 365.475mmmm outright, and --
	-- the .NET sort in FlowAnnotation will not parse a corner which has --
	-- one. the guard is here, at the one place the numbers stop being   --
	-- arithmetic and start being command text, because a unit can enter --
	-- from any of the sources above (2026-09-04)                        --
	----------------------------------------------------------------------
	!dx = !dx.string('D6').replace('mm', '').real()
	!dy = !dy.string('D6').replace('mm', '').real()
	!adx = abs(!dx)
	!ady = abs(!dy)
	!dbgf4 = object file('L:\E3D\pdms_prog\E3D2.1\PA_pmllibE3D2.1\check4.txt')
	!dbgf4.open('overwrite')
	!dbgf4.writerecord('RECENTER entry ok')
	----------------------------------------------------------------------
	-- the raw value has to be coerced separately: an unset canvassize is --
	-- a perfectly legal state (nobody has run .canvaspick() yet, and     --
	-- every real use of it below guards for exactly that), but '&' on an --
	-- unset argument is a hard error -- so this line, whose whole job    --
	-- was to report that the value is unset, was itself what stopped the --
	-- rebuild: "Argument 2 to + or & is unset", reported live 2026-09-03. --
	-- the handle any further down does not save it either, since a       --
	-- handle attaches to the single statement before it, not the block   --
	----------------------------------------------------------------------
	!cvsraw = 'UNSET'
	!cvsraw = '' & !!DrawingPlan1.canvassize
	handle any
	endhandle
	!dbgf4.writerecord('RECENTER canvassize unset=' & !!DrawingPlan1.canvassize.unset().string() & ' raw=' & !cvsraw)
	!dbgf4.writerecord('RECENTER cvx1=' & !cvx1.string('D2') & ' cvx2=' & !cvx2.string('D2') & ' cvy1=' & !cvy1.string('D2') & ' cvy2=' & !cvy2.string('D2'))
	!dbgf4.writerecord('RECENTER viewLLsh=' & !this.viewLLsh & ' viewURsh=' & !this.viewURsh)
	!dbgf4.writerecord('RECENTER labbandleft=' & !this.labbandleft.string('D2') & ' labbandright=' & !this.labbandright.string('D2') & ' labbandup=' & !this.labbandup.string('D2') & ' labbanddown=' & !this.labbanddown.string('D2') & ' gbubn=' & !gbubn.string() & ' bubbles-in=' & !ocx1.string('D2') & ' ' & !ocx2.string('D2') & ' ' & !ocy1.string('D2') & ' ' & !ocy2.string('D2'))
	!dbgf4.writerecord('RECENTER ocx1=' & !ocx1.string('D2') & ' ocx2=' & !ocx2.string('D2') & ' ocy1=' & !ocy1.string('D2') & ' ocy2=' & !ocy2.string('D2'))
	!dbgf4.writerecord('RECENTER ovl=' & !ovl.string('D2') & ' ovr=' & !ovr.string('D2') & ' ovd=' & !ovd.string('D2') & ' ovu=' & !ovu.string('D2'))
	!dbgf4.close()
	handle any
	endhandle
	!dbgf4 = object file('L:\E3D\pdms_prog\E3D2.1\PA_pmllibE3D2.1\check4.txt')
	!dbgf4.open('append')
	!dbgf4.writerecord('RECENTER dx=' & !dx.string() & ' dy=' & !dy.string() & ' adx=' & !adx.string() & ' ady=' & !ady.string())
	!dbgf4.close()
	handle any
		!dbgf4 = object file('L:\E3D\pdms_prog\E3D2.1\PA_pmllibE3D2.1\check4.txt')
		!dbgf4.open('append')
		!dbgf4.writerecord('RECENTER dx/dy string() errored')
		!dbgf4.close()
	endhandle
	if (!adx.gt(0.05) or !ady.gt(0.05)) then
		$!name/SS/S1/V1
		!vxy = ''
		var !vxy xyposition
		handle any
			!vxy = ''
		endhandle
		!dbgf4 = object file('L:\E3D\pdms_prog\E3D2.1\PA_pmllibE3D2.1\check4.txt')
		!dbgf4.open('append')
		!dbgf4.writerecord('RECENTER before vxy=' & !vxy)
		!dbgf4.close()
		if (!vxy.neq('')) then
			!nvx = !vxy.part(2).replace('mm', '').real() + !dx
			!nvy = !vxy.part(4).replace('mm', '').real() + !dy
			!nxy = 'X ' & !nvx.string('D3') & 'mm Y ' & !nvy.string('D3') & 'mm'
			xyposition $!nxy
			handle any
				!dbgf4 = object file('L:\E3D\pdms_prog\E3D2.1\PA_pmllibE3D2.1\check4.txt')
				!dbgf4.open('append')
				!dbgf4.writerecord('RECENTER xyposition command errored')
				!dbgf4.close()
			endhandle
			var !vxyafter xyposition
			handle any
				!vxyafter = 'READ-ERROR'
			endhandle
			!dbgf4 = object file('L:\E3D\pdms_prog\E3D2.1\PA_pmllibE3D2.1\check4.txt')
			!dbgf4.open('append')
			!dbgf4.writerecord('RECENTER nxy=' & !nxy & ' vxyafter=' & !vxyafter)
			!dbgf4.close()
			------------------------------------------------------------
			-- the cached sheet corners describe where the view WAS.   --
			-- everything read from them after this point would be out --
			-- by the move, so bring them, and the four lines built    --
			-- from them, along with it                                --
			------------------------------------------------------------
			!this.viewULsh = 'x ' & string(!this.viewULsh.part(2).real() + !dx) & ' y ' & string(!this.viewULsh.part(4).real() + !dy)
			!this.viewURsh = 'x ' & string(!this.viewURsh.part(2).real() + !dx) & ' y ' & string(!this.viewURsh.part(4).real() + !dy)
			!this.viewLLsh = 'x ' & string(!this.viewLLsh.part(2).real() + !dx) & ' y ' & string(!this.viewLLsh.part(4).real() + !dy)
			!this.viewLRsh = 'x ' & string(!this.viewLRsh.part(2).real() + !dx) & ' y ' & string(!this.viewLRsh.part(4).real() + !dy)
			!this.titletop = !this.titletop + !dy
			------------------------------------------------------------
			-- the box corners are sheet coordinates too, so they move  --
			-- with the view exactly as the border corners do           --
			------------------------------------------------------------
			!this.boxULsh = 'x ' & string(!this.boxULsh.part(2).real() + !dx) & ' y ' & string(!this.boxULsh.part(4).real() + !dy)
			!this.boxURsh = 'x ' & string(!this.boxURsh.part(2).real() + !dx) & ' y ' & string(!this.boxURsh.part(4).real() + !dy)
			!this.boxLLsh = 'x ' & string(!this.boxLLsh.part(2).real() + !dx) & ' y ' & string(!this.boxLLsh.part(4).real() + !dy)
			!this.boxLRsh = 'x ' & string(!this.boxLRsh.part(2).real() + !dx) & ' y ' & string(!this.boxLRsh.part(4).real() + !dy)
			!this.boxUlinesh = object line(!this.boxULsh.position(), !this.boxURsh.position())
			!this.boxDlinesh = object line(!this.boxLLsh.position(), !this.boxLRsh.position())
			!this.boxRlinesh = object line(!this.boxLRsh.position(), !this.boxURsh.position())
			!this.boxLlinesh = object line(!this.boxLLsh.position(), !this.boxULsh.position())
			!this.viewUlinesh = object line(!this.viewULsh.position(), !this.viewURsh.position())
			!this.viewDlinesh = object line(!this.viewLLsh.position(), !this.viewLRsh.position())
			!this.viewRlinesh = object line(!this.viewLRsh.position(), !this.viewURsh.position())
			!this.viewLlinesh = object line(!this.viewLLsh.position(), !this.viewULsh.position())
			------------------------------------------------------------
			-- GLAB's XYPO is a baked leader offset, not a re-projected --
			-- world position, so unlike the box (VSEC/FPLA) and DPOI  --
			-- it does not follow the view when it moves. nudge every  --
			-- GLAB LineNoAnnotation just touched (new or reused) by   --
			-- the same move -- right/left rows measure along sheet Y, --
			-- up/down along X                                        --
			------------------------------------------------------------
			!glabn = 0
			!glabn = !!DrawingPlan1RunGlabRefs.size()
			handle any
				!glabn = 0
			endhandle
			!dbgf4 = object file('L:\E3D\pdms_prog\E3D2.1\PA_pmllibE3D2.1\check4.txt')
			!dbgf4.open('append')
			!dbgf4.writerecord('GLABFIX count=' & !glabn.string())
			!dbgf4.close()
			do !gi from 1 to !glabn
				$!!DrawingPlan1RunGlabRefs[!gi]
				handle any
					skip
				endhandle
				!gdir = !!DrawingPlan1RunGlabDirs[!gi]
				!gcurxypo = ''
				var !gcurxypo xypo
				handle any
					!gcurxypo = ''
				endhandle
				if (!gcurxypo.neq('')) then
					!gxx = !gcurxypo.part(1).replace('mm', '').real()
					!gyy = !gcurxypo.part(2).replace('mm', '').real()
					----------------------------------------------------------
					-- subtract, not add: the view's own reference corner   --
					-- (viewULsh etc, which XYPO is measured against) moves  --
					-- BY dx/dy, so to land the label on the same spot it     --
					-- was aimed at, XYPO has to move the OPPOSITE way (found --
					-- live -- +dy overshot to roughly double the gap instead --
					-- of closing it, -dy matched update's own number exactly)--
					----------------------------------------------------------
					if (!gdir.eq('right') or !gdir.eq('left')) then
						!gyy = !gyy - !dy
					else
						!gxx = !gxx - !dx
					endif
					!gnewxypo = !gxx.string('D3') & ' ' & !gyy.string('D3')
					XYPO $!gnewxypo
					handle any
					endhandle
				endif
			enddo
			------------------------------------------------------------
			-- the match line box is the one thing on the drawing that --
			-- is drawn straight onto the sheet -- new stra fpt <sheet --
			-- position> -- rather than into the view, so unlike the   --
			-- dimensions and the labels it does not travel with the   --
			-- view and was left behind at the old position            --
			-- (2026-08-24, reported live). its four lines are put     --
			-- back on the corners here, in the order MatchLine drew   --
			-- them: top, bottom, right, left                          --
			------------------------------------------------------------
			!msfrom = object array()
			!msto = object array()
			!msfrom[1] = !this.boxULsh
			!msto[1] = !this.boxURsh
			!msfrom[2] = !this.boxLLsh
			!msto[2] = !this.boxLRsh
			!msfrom[3] = !this.boxLRsh
			!msto[3] = !this.boxURsh
			!msfrom[4] = !this.boxLLsh
			!msto[4] = !this.boxULsh
			-- !!DrawingPlan1MatchStras is a global rather than a member of  --
			-- this form on purpose: DrawingPlan1MatchLine.pmlfnc fills it   --
			-- in, and a .pmlfnc is re-read on every call while this form is --
			-- only re-read on kill/show. as a member, editing the two files --
			-- together broke every run until the form was reloaded          --
			-- ('Object does not have a member MATCHSTRAS', 2026-08-24)      --
			-- a global which has never been set at all does not answer     --
			-- .unset() either, it raises, so the count is read behind a     --
			-- handler rather than tested                                    --
			!msn = 0
			!msn = !!DrawingPlan1MatchStras.size()
			handle any
				!msn = 0
			endhandle
			if (!msn.gt(4)) then
				!msn = 4
			endif
			do !msi from 1 to !msn
				!msref = !!DrawingPlan1MatchStras[!msi]
				!msf = !msfrom[!msi]
				!mst = !msto[!msi]
				$!msref
				handle any
					skip
				endhandle
				FPT $!msf
				handle any
				endhandle
				TPT $!mst
				handle any
				endhandle
			enddo
			------------------------------------------------------------
			-- those four are the only part of the match line that     --
			-- belongs on a corner. its ticks and its texts belong     --
			-- wherever the neighbouring box's edge came out on the    --
			-- sheet, and that was worked out through 'shpos of'       --
			-- BEFORE this move -- so every rebuild left them behind   --
			-- by dx/dy while the update path, which never moves the   --
			-- view, put them in the right place. seen live as a       --
			-- red/green pair of ticks 2.5mm apart on the revision     --
			-- compare (2026-08-28)                                    --
			--                                                          --
			-- rather than shifting each one, the whole match line is  --
			-- simply asked for again now that the view has settled:   --
			-- it reuses whatever already stands where it wants one    --
			-- (the four lines just snapped above) and redraws only    --
			-- what the move actually invalidated                      --
			------------------------------------------------------------
			-- the tick positions are sheet coordinates, so the move --
			-- invalidated them too and they are worked out again    --
			-- here. the dimension points themselves are world       --
			-- positions and travelled with the view, so the two     --
			-- still land on each other                              --
			$!name/SS/S1/V1
			!!DrawingPlan1MatchTicks(!name, !equistr)
			$!name/SS/S1/V1
			!!DrawingPlan1MatchLine(!name, !equistr)
		endif
	endif
endmethod

------------------------------------------------------------------------
-- the two heights of the view title, sheet mm: [1] the green line, the --
-- match line text height; [2] the yellow line, the pipe label height   --
-- (user, 2026-09-24). a field that does not read falls back to the    --
-- form's own default                                                   --
------------------------------------------------------------------------
define method .TitleHeights() is array
	!h1 = 4
	!s1 = !this.matchhei.val.replace('mm', '').trim()
	!h1 = !s1.real()
	handle any
		!h1 = 4
	endhandle
	!h2 = 3
	if (not(!this.lineheitx.val.unset())) then
		!h2 = !this.lineheitx.val
	endif
	!h = object array()
	!h.append(!h1)
	!h.append(!h2)
	return !h
endmethod

------------------------------------------------------------------------
-- where the view title's parts go, sheet y, hanging from !top: [1] the --
-- green text's origin, [2] the underline, [3] the yellow text's origin --
--                                                                      --
-- the texts are alig bbody, and font 1 draws its capitals from 0.29 x  --
-- height above such an origin to 1.15 x height above it (measured off  --
-- a sheet, 2026-09-25: 4mm text, capitals 3.44 tall standing 1.16 up;  --
-- 3mm the same). the gaps here are the ones seen on paper: 5mm from   --
-- the annotation above to the capitals, then the picture the user     --
-- drew (error.png, 2026-09-25), in green text heights so it keeps its --
-- look at any height: 0.18 from the capitals down to the line, 0.25   --
-- from the line down to the yellow capitals -- 0.7 and 1.0 at 4mm.    --
-- they were 2.1 on both sides, too far (user)                         --
------------------------------------------------------------------------
define method .TitleRows(!top is real) is array
	!h = !this.TitleHeights()
	!y1 = !top - 5 - 1.15 * !h[1]
	!yu = !y1 + 0.29 * !h[1] - 0.18 * !h[1]
	!y2 = !yu - 0.25 * !h[1] - 1.15 * !h[2]
	!r = object array()
	!r.append(!y1)
	!r.append(!yu)
	!r.append(!y2)
	return !r
endmethod

------------------------------------------------------------------------
-- how far the view title reaches below the point it hangs from, sheet  --
-- mm, down to the yellow text's origin -- .TitleRows() from 0          --
------------------------------------------------------------------------
define method .TitleDepth() is real
	!r = !this.TitleRows(0)
	!d = 0 - !r[3]
	return !d
endmethod

------------------------------------------------------------------------
-- the underline's length, sheet mm: as wide as the green text, the way --
-- the user drew it. E3D has no attribute giving the width a text comes --
-- out at, so it is font 1's, measured off a sheet (2026-09-25): 0.625  --
-- x height per character, both lines alike -- 62.5 for 25 characters  --
-- at 4mm, 18.9 for 10 at 3mm. the first guess, 0.8, overshot by 8.7   --
-- at each end                                                          --
------------------------------------------------------------------------
define method .TitleWidth(!t is string, !h is real) is real
	!w = 0.625 * !h * !t.length()
	return !w
endmethod

------------------------------------------------------------------------
-- the bottom of everything under the view as it stands, sheet y -- the --
-- view border less the label band below it, and the grid bubbles -- the --
-- same reckoning .RecenterView() makes, for the update path, which      --
-- never moves the view and so never runs that                           --
------------------------------------------------------------------------
define method .TitleTopNow() is real
	!y = min(!this.viewLLsh.part(4).replace('mm', '').real(), !this.viewURsh.part(4).replace('mm', '').real())
	!band = 0
	!band = !this.labbanddown
	handle any
		!band = 0
	endhandle
	if (!band.unset()) then
		!band = 0
	endif
	!y = !y - !band
	!gbubn = 0
	!gbubn = !!DrawingPlan1GridBubbles.size()
	handle any
		!gbubn = 0
	endhandle
	do !gbubi from 1 to !gbubn
		!gbubp = object array()
		!gbubp = !!DrawingPlan1GridBubbles[!gbubi].split('~')
		handle any
			skip
		endhandle
		if (!gbubp.size().gt(2)) then
			!gbuby = !gbubp[3].replace('mm', '').real() - 5
			!y = min(!y, !gbuby)
		endif
	enddo
	return !y
endmethod

------------------------------------------------------------------------
-- the title under the view (user, 2026-09-24):                         --
--     PLAN at ELEVATION +119510     green (colour 20), match line text --
--     ---------------------------   height, underlined                  --
--            SCALE 1:50             yellow, pipe label height          --
-- both centred on the view. the elevation is the top of the box, E3D's --
-- own U, signed; the scale is the view's own VSCA, so it is whatever   --
-- was really drawn, fitted or picked.                                   --
--                                                                       --
-- a NOTE of its own under the view, named <drwg>/SS/S1/V1/VTITLE, with --
-- ELEV, ULINE and SCALE in it, so a later run finds it by name. found,  --
-- only the words are rewritten, and the underline's length with them   --
-- (.TitleLine()): an issued sheet keeps its layout, the same rule as   --
-- the view itself. not found, it is made with its top at sheet y !top, --
-- laid out by .TitleRows(); the underline is as wide as the green text --
-- by font 1's measured width (.TitleWidth()), centred like the text,   --
-- so an estimate off either way is off evenly at both ends             --
------------------------------------------------------------------------
define method .ViewTitle(!name is string, !box is string, !top is real)
	!ok = true
	var !bw wvol of $!box
	handle any
		!ok = false
	endhandle
	if (not(!ok)) then
		return
	endif
	!topu = !bw.part(6).replace('mm', '').real()
	!elev = !topu.string('D0').replace('mm', '')
	if (!topu ge 0) then
		!elev = '+' & !elev
	endif
	!t1 = 'PLAN at ELEVATION ' & !elev

	!vs = 0
	$!name/SS/S1/V1
	var !vsstr vsca
	handle any
		!vsstr = ''
	endhandle
	!vs = !vsstr.replace('mm', '').real()
	handle any
		!vs = 0
	endhandle
	!t2 = 'SCALE'
	if (!vs gt 0 and !vs lt 1) then
		!den = 1 / !vs
		!t2 = 'SCALE 1:' & !den.string('D0').replace('mm', '')
	elseif (!vs ge 1) then
		!t2 = 'SCALE ' & !vs.string('D0').replace('mm', '') & ':1'
	endif

	!this.TitleLog('VTITLE ' & !name & ' top=' & !top.string('D3') & ' t1=' & !t1 & ' t2=' & !t2)

	!nt = !name & '/SS/S1/V1/VTITLE'
	!elevnm = !nt & '/ELEV'
	!scalenm = !nt & '/SCALE'
	!exists = true
	$!nt
	handle any
		!exists = false
	endhandle
	if (!exists) then
		!whole = true
		$!elevnm
		handle any
			!whole = false
		endhandle
		$!scalenm
		handle any
			!whole = false
		endhandle
		if (!whole) then
			$!elevnm
			BTEXT |$!t1|
			handle any
				!this.TitleLog('  ELEV btext failed: ' & !!error.text)
			endhandle
			$!scalenm
			BTEXT |$!t2|
			handle any
				!this.TitleLog('  SCALE btext failed: ' & !!error.text)
			endhandle
			!this.TitleLine(!nt, !t1)
			!this.TitleLog('  found, words rewritten, place kept')
			return
		endif
		----------------------------------------------------------------
		-- a NOTE without its texts is what the first version left     --
		-- behind (cheitx unquoted, 2026-09-25): found by name, it     --
		-- would only ever have its missing texts "rewritten", so it   --
		-- is deleted and made again below                             --
		----------------------------------------------------------------
		$!nt
		delete note
		handle any
			!this.TitleLog('  half made, delete failed: ' & !!error.text)
			return
		endhandle
		!this.TitleLog('  half made, deleted, made again')
	endif

	!h = !this.TitleHeights()
	!h1 = !h[1]
	!h2 = !h[2]
	!xl = !this.viewLLsh.part(2).replace('mm', '').real()
	!xr = !this.viewLRsh.part(2).replace('mm', '').real()
	!cx = (!xl + !xr) * 0.5
	!rows = !this.TitleRows(!top)
	!y1 = !rows[1]
	!yu = !rows[2]
	!y2 = !rows[3]
	!w = !this.TitleWidth(!t1, !h1)
	!xa = !cx - !w * 0.5
	!xb = !cx + !w * 0.5

	!cxs = !cx.string('D3').replace('mm', '')
	!y1s = !y1.string('D3').replace('mm', '')
	!yus = !yu.string('D3').replace('mm', '')
	!y2s = !y2.string('D3').replace('mm', '')
	!xas = !xa.string('D3').replace('mm', '')
	!xbs = !xb.string('D3').replace('mm', '')
	!h1s = !h1.string('D2').replace('mm', '')
	!h2s = !h2.string('D2').replace('mm', '')

	------------------------------------------------------------------
	-- cheitx takes text: every other call in this library quotes it  --
	-- (|4|, '3mm'), and the unquoted number this first had rejected  --
	-- the whole line, silently under the handle -- both texts missing --
	-- and only the underline drawn (user, 2026-09-25). the colours    --
	-- go on lines of their own, AVEVA's way (assyboundbox.pmlfnc:173) --
	-- -- a number not in the colour dictionary is (61,604) and must   --
	-- not cost the text itself -- and fall back to green              --
	------------------------------------------------------------------
	$!name/SS/S1/V1
	new note $!nt
	handle any
		!this.TitleLog('  new note failed: ' & !!error.text)
		return
	endhandle

	!made = true
	new texp $!elevnm btext |$!t1| origin x $!cxs y $!y1s cheitx |$!h1s| alig bbody just center font 1
	handle any
		!made = false
		!this.TitleLog('  ELEV failed: ' & !!error.text)
	endhandle
	if (!made) then
		!colok = true
		txcolour 20
		handle any
			!colok = false
			!this.TitleLog('  ELEV txcolour 20 failed, green instead: ' & !!error.text)
		endhandle
		if (not(!colok)) then
			txcolour green
			handle any
			endhandle
		endif
	endif

	$!nt
	!made = true
	new stra $!nt/ULINE fpt x $!xas y $!yus tpt x $!xbs y $!yus
	handle any
		!made = false
		!this.TitleLog('  ULINE failed: ' & !!error.text)
	endhandle
	if (!made) then
		!colok = true
		NLColour 20
		handle any
			!colok = false
			!this.TitleLog('  ULINE nlcolour 20 failed, green instead: ' & !!error.text)
		endhandle
		if (not(!colok)) then
			NLColour green
			handle any
			endhandle
		endif
	endif

	$!nt
	new texp $!scalenm btext |$!t2| origin x $!cxs y $!y2s cheitx |$!h2s| alig bbody just center txcolour yellow font 1
	handle any
		!this.TitleLog('  SCALE failed: ' & !!error.text)
	endhandle
	!this.TitleLog('  made: cx=' & !cxs & ' y1=' & !y1s & ' yu=' & !yus & ' y2=' & !y2s & ' h1=' & !h1s & ' h2=' & !h2s & ' uline ' & !xas & '..' & !xbs)
endmethod

------------------------------------------------------------------------
-- an existing title's underline made as wide as its new words, about  --
-- its own middle and at its own y: the update path keeps the title    --
-- where it is, but the line hugs the text now, so one more digit in   --
-- the elevation must not leave it short (or a sheet from before       --
-- 2026-09-25 with the 0.8 estimate's long line). the height is read   --
-- off the text itself, which keeps the height it was made with        --
------------------------------------------------------------------------
define method .TitleLine(!nt is string, !t1 is string)
	!hh = !this.TitleHeights()
	!he = !hh[1]
	!elevnm = !nt & '/ELEV'
	!chs = ''
	$!elevnm
	var !chs chei
	handle any
		!chs = ''
	endhandle
	!hr = !chs.replace('mm', '').real()
	handle any
		!hr = 0
	endhandle
	if (!hr gt 0) then
		!he = !hr
	endif

	!ulnm = !nt & '/ULINE'
	!uf = ''
	!ut = ''
	$!ulnm
	handle any
		!this.TitleLog('  no ULINE to resize')
		return
	endhandle
	var !uf fpt
	handle any
		!uf = ''
	endhandle
	var !ut tpt
	handle any
		!ut = ''
	endhandle
	!sf = !!DrawingPlan1MatchXY(!uf)
	!st = !!DrawingPlan1MatchXY(!ut)
	!pf = !sf.split('~')
	!pt = !st.split('~')
	if (!pf.size().lt(2) or !pt.size().lt(2)) then
		!this.TitleLog('  ULINE ends unreadable: ' & !uf & ' / ' & !ut)
		return
	endif
	if (!pf[1].eq('') or !pf[2].eq('') or !pt[1].eq('')) then
		!this.TitleLog('  ULINE ends unreadable: ' & !uf & ' / ' & !ut)
		return
	endif
	!ax = !pf[1].real()
	!bx = !pt[1].real()
	!uys = !pf[2]
	!mx = (!ax + !bx) * 0.5
	!w = !this.TitleWidth(!t1, !he)
	!xa = !mx - !w * 0.5
	!xb = !mx + !w * 0.5
	!xas = !xa.string('D3').replace('mm', '')
	!xbs = !xb.string('D3').replace('mm', '')
	fpt x $!xas y $!uys
	handle any
		!this.TitleLog('  ULINE fpt failed: ' & !!error.text)
		return
	endhandle
	tpt x $!xbs y $!uys
	handle any
		!this.TitleLog('  ULINE tpt failed: ' & !!error.text)
		return
	endhandle
	!this.TitleLog('  ULINE now ' & !xas & '..' & !xbs & ' at y ' & !uys & ' (height ' & !he.string('D2') & ')')
endmethod

------------------------------------------------------------------------
-- one line of check_title.txt, the record of what .ViewTitle() did.   --
-- appended, one block per sheet; a dump that cannot be written is     --
-- skipped, never an error                                             --
------------------------------------------------------------------------
define method .TitleLog(!msg is string)
	!f = object file('L:\E3D\pdms_prog\E3D2.1\PA_pmllibE3D2.1\check_title.txt')
	!f.open('append')
	handle any
		return
	endhandle
	!f.writerecord(!msg)
	handle any
	endhandle
	!f.close()
	handle any
	endhandle
endmethod

define method .NozzleAnnotation(!name is string)
	NEW LAYE $!name/SS/S1/V1/ateNOZZ
	Purpose NOZZ
	Lvisibility true
	Ucode mm  Distance  mm  Bore Nominal 
	Font 1
	Lterminator Off
	Justification Centre
	Alignment Hbody
	Dterminator Arrows
	Tsize 2mm
	Chosht 6mm
	Asubtended 0
	Pjustification Towards 
	Overshoot 2mm
	Plclearance 0mm
	Doffset 25mm
	Dmspacing 0mm
	!cheicomp = !this.annotext.val & 'mm'
	Cheight $!cheicomp
	Lleader true
	Lframe false
	Lshape Straight
	Gbox 0mm
	Cspacing 0
	Lspacing 0
	Llclearance 0mm
	Xyscale 1 1
	Xyposition 10mm 10mm 
	Bpoffset 0mm 0mm
	Blnk true
	Bmargin 0mm
	Trsf unset
	Fterminator Default
	Pcode mms to 0 dpls  Inches to 1 dpls  Fractions to 32 ths  Angles to 1 dpls 
	NLStyle Solid 
	NLColour Cyan 
	FStyle SolidFilled 
	FColour Cyan 
	Txcolour yellow 
	LLStyle Solid 
	LLColour Cyan 
	LFStyle Solid 
	LFColour Cyan 
	DLStyle Solid 
	DLColour Grey 
	PLStyle Solid 
	PLColour Grey 
	MStyle Off 
	MColour Cyan 
	CHStyle Off 
	CHColour Grey 
	ACDSTY unset
	Posformat ENU
	Grsystem Nulref
	SpPurpose unset
	Function unset	
	
	!ff = object file(!this.blankdir & 'WriteLabelToText.txt')
	!ff.open('append')

	var !nozzs coll $!this.nozztext1.val within E $!this.wminE N $!this.wminN U $!this.minU TO E $!this.wmaxE N $!this.wmaxN U $!this.maxU
	do !nozz values !nozzs
		var !apos ( pos of $!nozz wrt worl )
		var !apos1 shpos of $!apos
		------------------------------------------------------------------
		-- the volume above is the world box which contains the drawing  --
		-- box, so on a turned box it reaches past the corners. the      --
		-- sheet position is what says whether this really sits in the   --
		-- view, the same test the line number annotation uses           --
		------------------------------------------------------------------
		if (not(!this.InViewOnSheet(!apos1))) then
			skip
		endif
		NEW GLAB
		DDNA $!nozz
		Btext |$!this.nozztext2.val|
		Justification Centre
		Alignment Hbody
		ABSO
		AT $!apos1
		XYPO 5 5

		------------------------------------------------------------------
		-- save label info. in WriteLabelToText.txt under .blankdir     --
		------------------------------------------------------------------
		var !label ref
		!shposx = !apos1.part(2).replace('mm', '')
		!shposy = !apos1.part(4).replace('mm', '')
		var !chei chei
		if !chei.eqnocase('ByVStyle') then
			var !chei chei of owner
		endif
		var !exbtext exbtext
		!height = !chei.replace('mm', '').real() + 0.5
		!width = !exbtext.length() * !height * 0.65  $( 0.65 is text width factor $)
		
		!ff.writerecord(!label & ' ' & !shposx & ' ' & !shposy & ' ' & !width & ' ' & !height & ' box')
	enddo
	!ff.close()
endmethod

---------------------------------------
-- Select CE for drawing destination --
---------------------------------------
define method .desce()
	!ce = name
	new drwg
	handle any
		!this.dest.val = ''
		!!alert.error('Cannot create DEPT under this level')
	elsehandle none
		delete drwg
		$!ce
		!this.dest.val = !ce
	endhandle
	if not(!this.dest.val.eqnocase('')) and !this.files.dtext.size().gt(0) then
		!this.apply.active = true
	else
		!this.apply.active = false
	endif
endmethod

----------------------------------------------------
-- Export contents of drawing list into text file --
----------------------------------------------------
define method .exportfile()
	using namespace 'Aveva.Core.Presentation'
	!browser = object PMLFILEBROWSER('OPEN')	
	!browser.show( !this.userevar, '*.txt', 'Text file', false, 'txt files (*.txt)|*.txt', 2)
	if (!browser.file() neq '') then
	  !this.userevar = !browser.file()
	  !filedata = object file(!this.userevar)
		!filedata.writefile('OVERWRITE', !this.files.dtext)
		!filedata.close()
	endif
endmethod

----------------------------------------------------
-- Import contents of text file into drawing list --
----------------------------------------------------
define method .importfile()
	using namespace 'Aveva.Core.Presentation'
	!browser = object PMLFILEBROWSER('OPEN')	
	!browser.show( !this.userevar, '*.txt', 'Text file', false, 'txt files (*.txt)|*.txt', 2)
	if (!browser.file() neq '') then
	  !this.userevar = !browser.file()
	  !filedata = object file(!this.userevar)
		!filedata.open('READ')
		!lines = !filedata.readfile()
		if !lines.set() then
			!str = !this.files.dtext
      do !x from 1 to !lines.size()
	      !line = !lines[!x]
				if !line.neq('') then
					if !line.substring(1,1).neq('/') and !line.substring(1,1).neq('=') then
						!line = '/' & !line						
					endif
					var !type type of $!line
					if !type.eqnocase('BOX') or !type.eqnocase('TEXT') or !type.eqnocase('EQUI') then
						var !site name of site of $!line
						if !site.matchwild('*_DrawingPlanBox') then
							var !equi namn of equi of $!line
							if !str.find(!equi).size().eq(0) then
								!str.append(!equi)
								!this.files.dtext = !str
							endif
						endif
					else
						var !equis coll all equi for ce
						do !equi values !equis
							var !site name of site of $!equi
							if !site.matchwild('*_DrawingPlanBox') then
								var !equi namn of $!equi
								if !str.find(!equi).size().eq(0) then
									!str.append(!equi)
									!this.files.dtext = !str
								endif
							endif
						enddo
					endif
			  endif
			enddo
		endif
		!filedata.close()
	endif
	if not(!this.dest.val.eqnocase('')) and !this.files.dtext.size().gt(0) then
		!this.apply.active = true
	else
		!this.apply.active = false
	endif
endmethod

-----------------------------------
-- sort contents of drawing list --
-----------------------------------
define method .sortce()
	!str = !this.files.dtext
	!str.sort()
	!this.files.dtext = !str
endmethod

---------------------------------
-- Save options in a text file --
---------------------------------
define method .Save()
	var !login login
	var !projid proj id
	import 'pmlfilebrowser'
	handle any
	endhandle
	using namespace 'Aveva.Core.Presentation'
	!browser = object PMLFILEBROWSER('Save')
	!browser.show('c:\temp\', |$!login_$!projid|, 'Filename', false ,' text files (*.txt)|*.txt' , 2)
	!file = !browser.file()
	if (!file neq '') then
		!ff = object file(!file)
		!ff.open('overwrite')
		---------------------------------------------------------------------
		-- 'In Use' box list (Drawing tab) is an array, not a plain .val -- --
		-- join it into one comma separated, pipe quoted line; .Load()     --
		-- rebuilds the array from it instead of the generic $!option =    --
		-- $!val used for every other (scalar) field below                --
		---------------------------------------------------------------------
		!filestr = ''
		do !f values !this.files.dtext
			if (!filestr.eq('')) then
				!filestr = !f
			else
				!filestr = !filestr & ',' & !f
			endif
		enddo
		!ff.writerecord('!this.files.dtext' & '=|' & !filestr & '|')
		!ff.writerecord('!this.dest.val' & '=|' & !this.dest.val & '|')
		!ff.writerecord('!this.portrait.val' & '=' & !this.portrait.val)
		!ff.writerecord('!this.canvasp.val' & '=|' & !this.canvasp.val & '|')
		!ff.writerecord('!this.openshee.val' & '=' & !this.openshee.val)
		!ff.writerecord('!this.delshee.val' & '=' & !this.delshee.val)
		!ff.writerecord('!this.frametext.val' & '=|' & !this.frametext.val & '|')
		!ff.writerecord('!this.rrsftext.val' & '=|' & !this.rrsftext.val & '|')
		!ff.writerecord('!this.hrsftext.val' & '=|' & !this.hrsftext.val & '|')
		!ff.writerecord('!this.scaleopt.selection()' & '=|' & !this.scaleopt.selection() & '|')
		!ff.writerecord('!this.scaletext.val' & '=|' & !this.scaletext.val & '|')
		-- the exclude list is an array, joined the same way as the box list above --
		!exclstr = ''
		do !e values !this.excllist.dtext
			if (!exclstr.eq('')) then
				!exclstr = !e
			else
				!exclstr = !exclstr & ',' & !e
			endif
		enddo
		!ff.writerecord('!this.excllist.dtext' & '=|' & !exclstr & '|')
		!ff.writerecord('!this.dwgnopos.val' & '=|' & !this.dwgnopos.val & '|')
		!ff.writerecord('!this.dwgnohei.val' & '=|' & !this.dwgnohei.val & '|')
		!ff.writerecord('!this.scalepos.val' & '=|' & !this.scalepos.val & '|')
		!ff.writerecord('!this.scalehei.val' & '=|' & !this.scalehei.val & '|')
		!ff.writerecord('!this.revpos.val' & '=|' & !this.revpos.val & '|')
		!ff.writerecord('!this.revhei.val' & '=|' & !this.revhei.val & '|')
		!ff.writerecord('!this.title1pos.val' & '=|' & !this.title1pos.val & '|')
		!ff.writerecord('!this.title1hei.val' & '=|' & !this.title1hei.val & '|')
		!ff.writerecord('!this.title2pos.val' & '=|' & !this.title2pos.val & '|')
		!ff.writerecord('!this.title2hei.val' & '=|' & !this.title2hei.val & '|')
		!ff.writerecord('!this.title3pos.val' & '=|' & !this.title3pos.val & '|')
		!ff.writerecord('!this.title3hei.val' & '=|' & !this.title3hei.val & '|')
		!ff.writerecord('!this.name1pos.val' & '=|' & !this.name1pos.val & '|')
		!ff.writerecord('!this.name1hei.val' & '=|' & !this.name1hei.val & '|')
		!ff.writerecord('!this.name2pos.val' & '=|' & !this.name2pos.val & '|')
		!ff.writerecord('!this.name2hei.val' & '=|' & !this.name2hei.val & '|')
		!ff.writerecord('!this.name3pos.val' & '=|' & !this.name3pos.val & '|')
		!ff.writerecord('!this.name3hei.val' & '=|' & !this.name3hei.val & '|')
		!ff.writerecord('!this.date1pos.val' & '=|' & !this.date1pos.val & '|')
		!ff.writerecord('!this.date1hei.val' & '=|' & !this.date1hei.val & '|')
		!ff.writerecord('!this.date2pos.val' & '=|' & !this.date2pos.val & '|')
		!ff.writerecord('!this.date2hei.val' & '=|' & !this.date2hei.val & '|')
		!ff.writerecord('!this.date3pos.val' & '=|' & !this.date3pos.val & '|')
		!ff.writerecord('!this.date3hei.val' & '=|' & !this.date3hei.val & '|')
		!ff.writerecord('!this.keyovertext.val' & '=|' & !this.keyovertext.val & '|')
		!ff.writerecord('!this.keytext1.val' & '=|' & !this.keytext1.val & '|')
		!ff.writerecord('!this.keytext2.val' & '=|' & !this.keytext2.val & '|')
		!ff.writerecord('!this.keytext3.val' & '=|' & !this.keytext3.val & '|')
		!ff.writerecord('!this.keytext4.val' & '=|' & !this.keytext4.val & '|')
		!ff.writerecord('!this.keytext5.val' & '=|' & !this.keytext5.val & '|')
		!ff.writerecord('!this.northtext.val' & '=|' & !this.northtext.val & '|')
		!ff.writerecord('!this.northsca.val' & '=' & !this.northsca.val)
		!ff.writerecord('!this.northpostext.val' & '=|' & !this.northpostext.val & '|')
		!ff.writerecord('!this.flowtext.val' & '=|' & !this.flowtext.val & '|')
		!ff.writerecord('!this.flowsca.val' & '=' & !this.flowsca.val)
		!ff.writerecord('!this.griddist.val' & '=' & !this.griddist.val)
		!ff.writerecord('!this.gridgap.val' & '=' & !this.gridgap.val)
		!ff.writerecord('!this.gridhei.val' & '=' & !this.gridhei.val)
		!ff.writerecord('!this.griddia.val' & '=' & !this.griddia.val)
		!ff.writerecord('!this.annotext.val' & '=|' & !this.annotext.val & '|')
		!ff.writerecord('!this.lineheitx.val' & '=' & !this.lineheitx.val)
		!ff.writerecord('!this.equiheitx.val' & '=' & !this.equiheitx.val)
		!ff.writerecord('!this.dimheitx.val' & '=' & !this.dimheitx.val)
		!ff.writerecord('!this.matchhei.val' & '=|' & !this.matchhei.val & '|')
		!ff.writerecord('!this.autoplace.val' & '=' & !this.autoplace.val)
		!ff.writerecord('!this.insttog.val' & '=' & !this.insttog.val)
		!ff.writerecord('!this.insttext1.val' & '=|' & !this.insttext1.val & '|')
		!ff.writerecord('!this.insttext2.val' & '=|' & !this.insttext2.val & '|')
		!ff.writerecord('!this.insttext3.val' & '=' & !this.insttext3.val)
		!ff.writerecord('!this.nozztog.val' & '=' & !this.nozztog.val)
		!ff.writerecord('!this.nozztext1.val' & '=|' & !this.nozztext1.val & '|')
		!ff.writerecord('!this.nozztext2.val' & '=|' & !this.nozztext2.val & '|')
		!ff.writerecord('!this.valvtog.val' & '=' & !this.valvtog.val)
		!ff.writerecord('!this.valvtext1.val' & '=|' & !this.valvtext1.val & '|')
		!ff.writerecord('!this.valvtext2.val' & '=|' & !this.valvtext2.val & '|')
		!ff.writerecord('!this.supttog.val' & '=' & !this.supttog.val)
		!ff.writerecord('!this.supttog1.val' & '=' & !this.supttog1.val)
		!ff.writerecord('!this.usertog.val' & '=' & !this.usertog.val)
		!ff.writerecord('!this.usertext1.val' & '=|' & !this.usertext1.val & '|')
		!ff.writerecord('!this.usertext2.val' & '=|' & !this.usertext2.val & '|')
		!ff.writerecord('!this.redutog.val' & '=' & !this.redutog.val)
		!ff.close()
	endif
endmethod

-----------------------------------
-- Load options from a text file --
-----------------------------------
define method .Load()
	import 'pmlfilebrowser'
	handle any
	endhandle
	using namespace 'Aveva.Core.Presentation'
	!browser = object PMLFILEBROWSER('Open')
	!browser.show('c:\temp\', '', 'Filename', true ,' text files (*.txt)|*.txt' , 1)
	!file = !browser.file()
	if (!file neq '') then
		!ff = object file(!file)
		!ff.open('read')
		!lines =!ff.readfile()
		do !i From 1 to !lines.size()
			!line = !lines[!i]
			-----------------------------------------------------------------------
			-- split on the FIRST '=' only -- a saved value (a Rule/Format text) --
			-- can legitimately contain '=' further on, and .split('=') would    --
			-- otherwise silently truncate it                                    --
			-----------------------------------------------------------------------
			!option = !line.before('=')
			!val = !line.after('=')
			handle any
			elsehandle none
				if (!option.eq('!this.files.dtext')) then
					---------------------------------------------------------------------
					-- 'In Use' box list is an array, not a plain .val -- rebuild it    --
					-- from the comma joined string, split the boxes over the two lists --
					-- the way .selectce() would, and refresh the Create Drawings button --
					-- instead of falling through to the generic $!option = $!val below  --
					-- (which only handles scalars)                                      --
					---------------------------------------------------------------------
					!filestr = !val
					if (!filestr.length() gt 0 and !filestr.substring(1,1).eq('|')) then
						!filestr = !filestr.substring(2, !filestr.length() - 2)
					endif
					if (!filestr.neq('')) then
						!fileslist = !filestr.split(',')
					else
						!fileslist = object array()
					endif
					---------------------------------------------------------------------
					-- rebuild BOTH lists from the boxes that exist right now instead   --
					-- of clear()ing the saved names out of 'All': the saved box may be  --
					-- gone (deleted/renamed since the Save -- unnamed ones are stored   --
					-- as a raw ref like '=23718/1652'), or it may already have been     --
					-- moved to 'In Use' by hand before Load was pressed. In both cases  --
					-- .clear() raises 'Cannot find requested field' and kills the whole --
					-- load, so filter the names first and assign .dtext directly        --
					---------------------------------------------------------------------
					!this.AllBoxes()
					!allboxes = !this.files1.dtext
					!inuse = object array()
					!missing = object array()
					do !fn values !fileslist
						if (!allboxes.find(!fn).size().gt(0)) then
							if (!inuse.find(!fn).size().eq(0)) then
								!inuse.append(!fn)
							endif
						else
							!missing.append(!fn)
						endif
					enddo
					!remain = object array()
					do !bx values !allboxes
						if (!inuse.find(!bx).size().eq(0)) then
							!remain.append(!bx)
						endif
					enddo
					-- an empty array is not a safe .dtext value -- empty the list instead
					if (!inuse.size().gt(0)) then
						!this.files.dtext = !inuse
					else
						!this.files.clear()
					endif
					if (!remain.size().gt(0)) then
						!this.files1.dtext = !remain
					else
						!this.files1.clear()
					endif
					if (!missing.size().gt(0)) then
						!msg = ''
						do !m values !missing
							if (!msg.eq('')) then
								!msg = !m
							else
								!msg = !msg & ',' & !m
							endif
						enddo
						!!alert.warning('These saved Drawing Boxes are not in this project any more and have been skipped: ' & !msg)
					endif
					if not(!this.dest.val.eqnocase('')) and !this.files.dtext.size().gt(0) then
						!this.apply.active = true
					else
						!this.apply.active = false
					endif
				elseif (!option.eq('!this.excllist.dtext')) then
					---------------------------------------------------------------------
					-- the View tab's exclude list is an array like the box list above, --
					-- so it is rebuilt from the comma joined string the same way. the  --
					-- names are not checked against the model, .Apply() already steps  --
					-- over one which has gone                                          --
					---------------------------------------------------------------------
					!exclstr = !val
					if (!exclstr.length() gt 0 and !exclstr.substring(1,1).eq('|')) then
						!exclstr = !exclstr.substring(2, !exclstr.length() - 2)
					endif
					if (!exclstr.neq('')) then
						!this.excllist.dtext = !exclstr.split(',')
					else
						!this.excllist.clear()
					endif
				elseif (!option.eq('!this.scaleopt.selection()')) then
					---------------------------------------------------------------------
					-- the scale is stored as what it says, not as its place in the      --
					-- list, so a file still loads if the list ever gains an entry        --
					---------------------------------------------------------------------
					!scstr = !val
					if (!scstr.length() gt 0 and !scstr.substring(1,1).eq('|')) then
						!scstr = !scstr.substring(2, !scstr.length() - 2)
					endif
					!scitems = !this.scaleopt.dtext
					do !si from 1 to !scitems.size()
						if (!scitems[!si].eqnocase(!scstr)) then
							!this.scaleopt.val = !si
							break
						endif
					enddo
					!this.ScalePick()
					handle any
					endhandle
				elseif (!option.eq('!this.canvasp.val')) then
					---------------------------------------------------------------------
					-- .canvasp is only the text shown on the form. the canvas .Apply()  --
					-- actually reads is the member .canvassize, and only .canvaspick()  --
					-- ever set it -- so a loaded file put the right canvas on the form  --
					-- and still drew with the built in 500x400 at X357 Y315. that is a  --
					-- silent change of view centre between one run and the next, which  --
					-- clouds the whole sheet when two revisions are compared            --
					---------------------------------------------------------------------
					!canvstr = !val
					if (!canvstr.length() gt 0 and !canvstr.substring(1,1).eq('|')) then
						!canvstr = !canvstr.substring(2, !canvstr.length() - 2)
					endif
					!this.canvasp.val = !canvstr
					if (!canvstr.neq('') and not(!canvstr.matchwild('*unset*'))) then
						!this.canvassize = !canvstr
					endif
				elseif (!option.eq('!this.dest.val')) then
					-----------------------------------------------------------------------
					-- Destination is a raw DB reference (eg '=2013286677/35036'), not a  --
					-- stable name -- it can go stale if the database gets reorganised    --
					-- between the Save and the Load, so unlike every other field it is   --
					-- verified before being trusted: try to CE-navigate to it and warn   --
					-- instead of silently leaving a dead reference sitting in the field  --
					-----------------------------------------------------------------------
					!destref = !val
					if (!destref.length() gt 0 and !destref.substring(1,1).eq('|')) then
						!destref = !destref.substring(2, !destref.length() - 2)
					endif
					if (!destref.eq('')) then
						!this.dest.val = ''
					else
						!savedce = name
						-------------------------------------------------------------
						-- the navigation has to come BEFORE the handler. it used   --
						-- to sit in the elsehandle none block, which runs when the --
						-- guarded statement did NOT fail -- so the guarded         --
						-- statement was '!destvalid = true', which cannot fail,    --
						-- and $!destref ran outside the handler entirely. the      --
						-- check described above therefore never caught anything:   --
						--   (2,107) Undefined reference =2013286677/35036          --
						-- killed the whole .Load() instead of warning (2026-09-09) --
						-------------------------------------------------------------
						!destvalid = true
						$!destref
						handle any
							!destvalid = false
						endhandle
						if (!destvalid) then
							!this.dest.val = !destref
						else
							!this.dest.val = ''
							!!alert.warning('The saved Destination no longer exists in this database. Please set it again with the CE button next to Destination.')
						endif
						-- same shape as above: navigate, THEN handle             --
						$!savedce
						handle any
						endhandle
					endif
					if not(!this.dest.val.eqnocase('')) and !this.files.dtext.size().gt(0) then
						!this.apply.active = true
					else
						!this.apply.active = false
					endif
				else
					-----------------------------------------------------------------------
					-- older/hand-edited save files can carry a free-text value that was --
					-- never pipe-quoted (eg. a Rule like 'ALL INST WITH ISNAMED', from a --
					-- form version whose .Save() forgot the '|' on that field). splicing --
					-- that in bare turns $!option = $!val into a CP syntax error, which  --
					-- is raised while parsing the substituted text -- handle any cannot  --
					-- trap that, so it has to be quoted here before that ever happens    --
					-----------------------------------------------------------------------
					if (!val.length() gt 0 and !val.substring(1,1).neq('|') and not(!val.eqnocase('TRUE')) and not(!val.eqnocase('FALSE'))) then
						!isnum = true
						!junk = !val.real()
						handle any
							!isnum = false
						elsehandle none
						endhandle
						if (not(!isnum)) then
							!val = '|' & !val & '|'
						endif
					endif
					-----------------------------------------------------------------------
					-- the handler has to sit right behind the statement it is meant to --
					-- cover. it used to be opened at the top of the elsehandle none     --
					-- branch above instead, with no statement in front of it, so it     --
					-- guarded nothing and a save file naming a field this version of    --
					-- the form no longer has (northrottext, dropped when the second     --
					-- north arrow SYTM became Scale) aborted the whole Load with        --
					-- 'Object does not have a member NORTHROTTEXT'. skip that one line  --
					-- and keep reading the rest of the file                             --
					-----------------------------------------------------------------------
					$!option = $!val
					handle any
					endhandle
				endif
			endhandle
		enddo
		!ff.close()
	endif
endmethod

define method .typepick(!type1 is string, !gedget is string)
	!ce = ce
	var !type type of $!ce
	if (!type.eqnocase(!type1)) then
		var !name name of $!ce
		!option = '!this.' & |$!gedget| & '.val'
		$!option = |$!name|
	else
		!!alert.error('You must be at a ' & !type1 & ', to set this reference')
	endif
endmethod

----------------------------------------------------------------------
-- 'Exclude from View' list, View tab. what the user puts in here is --
-- taken back out of the drawing list of every drawing .Apply()      --
-- creates, so it is not drawn in the view                           --
----------------------------------------------------------------------
define method .ExclAddCe()
	!ce = ce
	if (!this.IsModelElement()) then
		var !name name of $!ce
		!items = !this.excllist.dtext
		if (!items.find(!name).size().gt(0)) then
			!!alert.message(!name & ' is already in the list')
		else
			!items.append(!name)
			!this.excllist.dtext = !items
		endif
	else
		!!alert.error('You must be at a model element (design database) to add it to the list')
	endif
endmethod

define method .ExclRemoveCe()
	!strs = !this.excllist.selection()
	if (!strs.size().gt(0)) then
		do !str values !strs
			!this.excllist.clear(!str)
		enddo
	else
		!!alert.error('Select one or more items in the list first')
	endif
endmethod

define method .ExclRemoveAll()
	!this.excllist.clear()
endmethod

--------------------------------------------------------------------------
-- true when CE lives in the design database, ie something that can      --
-- appear in a view at all. DBTYPE answers which database the element   --
-- is in and 'DESI' is the design one -- the same test AVEVA's own      --
-- 'Remove from View' makes (draft/forms/dra3dview.pmlfrm). this        --
-- replaces an owner walk looking for a WORL or a SITE, which was       --
-- guessing at from the hierarchy what DBTYPE says outright             --
--------------------------------------------------------------------------
define method .IsModelElement() is boolean
	!dbt = ''
	!dbt = dbtype
	handle any
		!dbt = ''
	endhandle
	return !dbt.eqnocase('DESI')
endmethod

----------------------------------------------------------------------
-- the field beside the scale list is only for a scale which is not  --
-- in it, so it is only alive while User Define is the choice        --
----------------------------------------------------------------------
define method .ScalePick()
	if (!this.scaleopt.selection().eqnocase('User Define')) then
		!this.scaletext.active = true
	else
		!this.scaletext.active = false
	endif
endmethod

define method .canvaspick()
	var !size rshpos @
	handle any
	elsehandle none
		!size1 = !size.replace('mm', '')
		!!DrawingPlan1.canvassize = 'X ' & !size1.part(2).real().string('D0') & ' Y ' & !size1.part(4).real().string('D0') & ' X ' & !size1.part(6).real().string('D0') & ' Y ' & !size1.part(8).real().string('D0')
		!!DrawingPlan1.canvasp.val = !!DrawingPlan1.canvassize
	endhandle
endmethod

define method .keyplanpick()
	var !size1 shpo @
	handle any
		prompt on
		prompt dismiss
		break
	elsehandle none
		!!DrawingPlan1.keytext1.val = 'X ' & !size1.replace('mm', '').part(2).real().string('D0') & ' Y ' & !size1.replace('mm', '').part(4).real().string('D0')
	endhandle
endmethod

define method .northarrowpick()
	var !size1 shpo @
	handle any
		prompt on
		prompt dismiss
		break
	elsehandle none
		!!DrawingPlan1.northpostext.val = 'X ' & !size1.replace('mm', '').part(2).real().string('D0') & ' Y ' & !size1.replace('mm', '').part(4).real().string('D0')
	endhandle
endmethod

define method .ValveAnnotation(!name is string)
	NEW LAYE $!name/SS/S1/V1/ateVALV
	Purpose VALV
	Lvisibility true
	Ucode mm  Distance  mm  Bore Nominal 
	Font 1
	Lterminator Off
	Justification Centre
	Alignment Hbody
	Dterminator Arrows
	Tsize 2mm
	Chosht 6mm
	Asubtended 0
	Pjustification Towards 
	Overshoot 2mm
	Plclearance 0mm
	Doffset 25mm
	Dmspacing 0mm
	!cheicomp = !this.annotext.val & 'mm'
	Cheight $!cheicomp
	Lleader true
	Lframe false
	Lshape Straight
	Gbox 0mm
	Cspacing 0
	Lspacing 0
	Llclearance 0mm
	Xyscale 1 1
	Xyposition 10mm 10mm 
	Bpoffset 0mm 0mm
	Blnk true
	Bmargin 0mm
	Trsf unset
	Fterminator Default
	Pcode mms to 0 dpls  Inches to 1 dpls  Fractions to 32 ths  Angles to 1 dpls 
	NLStyle Solid 
	NLColour Cyan 
	FStyle SolidFilled 
	FColour Cyan 
	Txcolour yellow 
	LLStyle Solid 
	LLColour Cyan 
	LFStyle Solid 
	LFColour Cyan 
	DLStyle Solid 
	DLColour Grey 
	PLStyle Solid 
	PLColour Grey 
	MStyle Off 
	MColour Cyan 
	CHStyle Off 
	CHColour Grey 
	ACDSTY unset
	Posformat ENU
	Grsystem Nulref
	SpPurpose unset
	Function unset
	
	!ff = object file(!this.blankdir & 'WriteLabelToText.txt')
	!ff.open('append')

	var !valvs coll $!this.valvtext1.val within E $!this.wminE N $!this.wminN U $!this.minU TO E $!this.wmaxE N $!this.wmaxN U $!this.maxU
	do !valv values !valvs
		var !apos ( pos of $!valv wrt worl )
		var !apos1 shpos of $!apos
		------------------------------------------------------------------
		-- see the note in .NozzleAnnotation() -- the volume above is    --
		-- the world box containing the drawing box, the sheet position  --
		-- is what says whether this really sits in the view             --
		------------------------------------------------------------------
		if (not(!this.InViewOnSheet(!apos1))) then
			skip
		endif
		NEW GLAB
		DDNA $!valv
		Btext |$!this.valvtext2.val|
		Justification Centre
		Alignment Hbody
		ABSO
		AT $!apos1
		XYPO 5 5

		------------------------------------------------------------------
		-- save label info. in WriteLabelToText.txt under .blankdir     --
		------------------------------------------------------------------
		var !label ref
		!shposx = !apos1.part(2).replace('mm', '')
		!shposy = !apos1.part(4).replace('mm', '')
		var !chei chei
		if !chei.eqnocase('ByVStyle') then
			var !chei chei of owner
		endif
		var !exbtext exbtext
		!height = !chei.replace('mm', '').real() + 0.5
		!width = !exbtext.length() * !height * 0.65  $( 0.65 is text width factor $)
		
		!ff.writerecord(!label & ' ' & !shposx & ' ' & !shposy & ' ' & !width & ' ' & !height & ' box')
	enddo
	!ff.close()
endmethod

define method .ReduAnnotation(!name is string)
	NEW LAYE $!name/SS/S1/V1/ateREDU
	Purpose REDU
	Lvisibility true
	Ucode mm  Distance  mm  Bore Nominal 
	Font 1
	Lterminator Off
	Justification Centre
	Alignment Hbody
	Dterminator Arrows
	Tsize 2mm
	Chosht 6mm
	Asubtended 0
	Pjustification Towards 
	Overshoot 2mm
	Plclearance 0mm
	Doffset 25mm
	Dmspacing 0mm
	!cheicomp = !this.annotext.val & 'mm'
	Cheight $!cheicomp
	Lleader true
	Lframe false
	Lshape Straight
	Gbox 0mm
	Cspacing 0
	Lspacing 0
	Llclearance 0mm
	Xyscale 1 1
	Xyposition 10mm 10mm 
	Bpoffset 0mm 0mm
	Blnk true
	Bmargin 0mm
	Trsf unset
	Fterminator Default
	Pcode mms to 0 dpls  Inches to 1 dpls  Fractions to 32 ths  Angles to 1 dpls 
	NLStyle Solid 
	NLColour Cyan 
	FStyle SolidFilled 
	FColour Cyan 
	Txcolour yellow 
	LLStyle Solid 
	LLColour Cyan 
	LFStyle Solid 
	LFColour Cyan 
	DLStyle Solid 
	DLColour Grey 
	PLStyle Solid 
	PLColour Grey 
	MStyle Off 
	MColour Cyan 
	CHStyle Off 
	CHColour Grey 
	ACDSTY unset
	Posformat ENU
	Grsystem Nulref
	SpPurpose unset
	Function unset
	
	!ff = object file(!this.blankdir & 'WriteLabelToText.txt')
	!ff.open('append')

	var !redus vscan for all (redu tee)
	do !redu values !redus
		!redu = !redu.part(2)
		var !pdir p1 dir of $!redu
		---------------------------------------------------
		-- only tag tee/reducer for horizontal direction --
		---------------------------------------------------
		if not(!pdir.direction().eq(object direction('U')) or !pdir.direction().eq(object direction('D'))) then
			var !type type of $!redu
			!btext = ''
			if (!type.eqnocase('REDU')) then
				!btext = '#P1BOR<FROM ' & !redu & '>x' & '#P2BOR<FROM ' & !redu & '> RC'
			else
				var !p1bore p1 bore of $!redu
				var !p3bore p3 bore of $!redu
				if (!p1bore.neq(!p3bore)) then
					!btext = '#P1BOR<FROM ' & !redu & '>x' & '#P3BOR<FROM ' & !redu & '> RT'
				endif
			endif
			if (!btext neq '') then
				NEW GLAB
				DDNA $!redu
				BTEXT |$!btext|
				Justification Centre
				Alignment Hbody
				ABSO
				var !apos ( pos of $!redu wrt worl )
				var !apos1 shpos of $!apos
				AT $!apos1
				XYPO 10 10
				
				------------------------------------------------------------------
				-- save label info. in WriteLabelToText.txt under .blankdir     --
				------------------------------------------------------------------
				var !label ref
				!shposx = !apos1.part(2).replace('mm', '')
				!shposy = !apos1.part(4).replace('mm', '')
				var !chei chei
				if !chei.eqnocase('ByVStyle') then
					var !chei chei of owner
				endif
				var !exbtext exbtext
				!height = !chei.replace('mm', '').real() + 0.5
				!width = !exbtext.length() * !height * 0.65  $( 0.65 is text width factor $)
				
				!ff.writerecord(!label & ' ' & !shposx & ' ' & !shposy & ' ' & !width & ' ' & !height & ' box')

			endif
		endif
	enddo
	!ff.close()

endmethod

define method .InstAnnotation(!name is string)
	NEW LAYE $!name/SS/S1/V1/ateINST
	Purpose INST
	Lvisibility true
	Ucode mm  Distance  mm  Bore Nominal 
	Font 1
	Lterminator Off
	Justification Left
	Alignment Base
	Dterminator Arrows
	Tsize 2mm
	Chosht 6mm
	Asubtended 0
	Pjustification Towards 
	Overshoot 2mm
	Plclearance 0mm
	Doffset 25mm
	Dmspacing 0mm
	!cheicomp = !this.annotext.val & 'mm'
	Cheight $!cheicomp
	Lleader true
	Lframe false
	Lshape Straight
	Gbox 0mm
	Cspacing 0
	Lspacing 0
	Llclearance 0mm
	Xyscale 1 1
	Xyposition 10mm 10mm 
	Bpoffset 0mm 0mm
	Blnk true
	Bmargin 0mm
	Trsf unset
	Fterminator Default
	Pcode mms to 0 dpls  Inches to 1 dpls  Fractions to 32 ths  Angles to 1 dpls 
	NLStyle Solid 
	NLColour Cyan 
	FStyle SolidFilled 
	FColour Cyan 
	Txcolour yellow 
	LLStyle Solid 
	LLColour Cyan 
	LFStyle Solid 
	LFColour Cyan 
	DLStyle Solid 
	DLColour Grey 
	PLStyle Solid 
	PLColour Grey 
	MStyle Off 
	MColour Cyan 
	CHStyle Off 
	CHColour Grey 
	ACDSTY unset
	Posformat ENU
	Grsystem Nulref
	SpPurpose unset
	Function unset
	----------------------------------------------------------------
	-- the bubble circle lives in the NAME_CIRC symbol, which is   --
	-- built once by .Apply() on the create path only. re-applied  --
	-- here, which runs on both paths, so changing Diameter and    --
	-- updating an existing drawing works the same as creating a   --
	-- new one -- the rule agreed for text heights, 2026-09-08     --
	----------------------------------------------------------------
	!instdiav = !this.insttext3.val
	!instdia = !instdiav.string('D2') & 'mm'
	$!name/SS/LALB/NAME_CIRC
	handle any
	elsehandle none
		var !ncircs coll all circle for ce
		do !nc values !ncircs
			$!nc
			handle any
				skip
			endhandle
			DIAM $!instdia
		enddo
	endhandle
	----------------------------------------------------------------
	-- back onto the layer: the NEW SLABs below are created under  --
	-- whatever CE is left here                                    --
	----------------------------------------------------------------
	$!name/SS/S1/V1/ateINST
	handle any
	endhandle
	
	!ff = object file(!this.blankdir & 'WriteLabelToText.txt')
	!ff.open('append')
	var !insts coll $!this.insttext1.val within E $!this.wminE N $!this.wminN U $!this.minU TO E $!this.wmaxE N $!this.wmaxN U $!this.maxU
	do !inst values !insts
		var !apos ( pos of $!inst wrt worl )
		var !apos1 shpos of $!apos
		------------------------------------------------------------------
		-- see the note in .NozzleAnnotation() -- the volume above is    --
		-- the world box containing the drawing box, the sheet position  --
		-- is what says whether this really sits in the view             --
		------------------------------------------------------------------
		if (not(!this.InViewOnSheet(!apos1))) then
			skip
		endif
		NEW SLAB
		DDNA $!inst
		tmrf $!name/SS/LALB/NAME_CIRC
		Font 1
		Blnk true
		Bmargin 0mm
		Xyscale 1 1
		----------------------------------------------------------------
		-- the bubble text. hard coded 3mm here beat the ateINST layer  --
		-- set just above, so Component Label Height moved every other  --
		-- component label and left the instrument numbers at 3mm       --
		-- (reported 2026-09-08, q Cheitx on the SLAB still said 3mm)   --
		----------------------------------------------------------------
		!cheiinst = !this.annotext.val & 'mm'
		Cheitx '$!cheiinst'
		Lvisibility true
		Txcolour Yellow
		LLColour Cyan
		LFColour Cyan
		Alignment Hbody
		ABSO
		AT $!apos1
		XYPO 15 15

		------------------------------------------------------------------
		-- save label info. in WriteLabelToText.txt under .blankdir     --
		------------------------------------------------------------------
		var !label ref
		!shposx = !apos1.part(2).replace('mm', '')
		!shposy = !apos1.part(4).replace('mm', '')
		!ff.writerecord(!label & ' ' & !shposx & ' ' & !shposy & ' 10 10 circle')
	enddo
	!ff.close()
endmethod


---------------------------------------------------------------------------
-- create a grid label based on intersection between grid and view frame --
---------------------------------------------------------------------------
define method .CreateGridSymbolwithIntersection(!i is real, !p12linesh is line, !p1possh is string, !p2possh is string, !refgln is string)
	!framedir = object direction()
	!griddir = object direction()
	!nppt = 0
	if (!this.intersections.getindexed(!i).split('-').getindexed(1).eq('boxUlinesh')) then
		!framedir = object direction('N')
		!agside = 'Top'
	elseif (!this.intersections.getindexed(!i).split('-').getindexed(1).eq('boxDlinesh')) then
		!framedir = object direction('S')
		!agside = 'Bottom'
	elseif (!this.intersections.getindexed(!i).split('-').getindexed(1).eq('boxLlinesh')) then
		!framedir = object direction('W')
		!agside = 'Left'
	elseif (!this.intersections.getindexed(!i).split('-').getindexed(1).eq('boxRlinesh')) then
		!framedir = object direction('E')
		!agside = 'Right'
	endif

	if (!framedir.angle(!p12linesh.direction()).leq(!framedir.angle(!p12linesh.direction().opposite()))) then
		!griddir = !p12linesh.direction()
	else
		!griddir = !p12linesh.direction().opposite()
	endif
	if (!p1possh.position().distance(!this.intersections.getindexed(!i).split('-').getindexed(2).position()).leq(!p2possh.position().distance(!this.intersections.getindexed(!i).split('-').getindexed(2).position()))) then
		!nppt = 1
		!npptp = !p1possh.position()
	else
		!nppt = 2
		!npptp = !p2possh.position()
	endif

	!x = (!this.intersections.getindexed(!i).split('-').getindexed(2).position().offset(!griddir, !this.griddist.val).east - !npptp.east)
	!y = (!this.intersections.getindexed(!i).split('-').getindexed(2).position().offset(!griddir, !this.griddist.val).north - !npptp.north)
	!xap = (!this.intersections.getindexed(!i).split('-').getindexed(2).position().offset(!griddir, !this.gridgap.val).east - !npptp.east)
	!yap = (!this.intersections.getindexed(!i).split('-').getindexed(2).position().offset(!griddir, !this.gridgap.val).north - !npptp.north)
	----------------------------------------------------------------------
	-- where this bubble lands on the sheet, before the rcode swap below --
	-- turns the offset into view coordination. !x / !y are measured     --
	-- from !npptp, so adding it back gives the sheet position itself     --
	----------------------------------------------------------------------
	!gbx = !x + !npptp.east
	!gby = !y + !npptp.north
	----------------------------------------------------------------------
	-- a side which already has bubbles keeps its depth: those are      --
	-- frozen, so a new one lines up with them rather than with the box --
	-- edge they no longer sit on. the shift goes on the axis that      --
	-- crosses the border, and on APOF too so the leader keeps its gap  --
	----------------------------------------------------------------------
	!frz = !!DrawingPlan1GridFrozen(!agside)
	if (not(!frz.eq(''))) then
		if (!agside.eqnocase('Left') or !agside.eqnocase('Right')) then
			!fdel = !frz.real() - !gbx
			!x = !x + !fdel
			!xap = !xap + !fdel
			!gbx = !gbx + !fdel
		else
			!fdel = !frz.real() - !gby
			!y = !y + !fdel
			!yap = !yap + !fdel
			!gby = !gby + !fdel
		endif
	endif
	----------------------------------------------------------------------
	-- another bubble may already be standing on this exact spot: this   --
	-- project has more than one grid system over the same ground. the   --
	-- same number twice is the same column position twice, so this one  --
	-- is dropped; a different number is a real second label and gets     --
	-- stacked one circle further out, sharing the leader of the one     --
	-- below it (user's rule and sketch, 2026-09-07)                     --
	--                                                                    --
	-- the drop happens BEFORE the claim below, so a duplicate left on   --
	-- the layer by an earlier run goes unclaimed and is deleted by      --
	-- DrawingPlan1GridAnnotation's own cleanup -- nothing extra needed  --
	----------------------------------------------------------------------
	!gid = !!DrawingPlan1GridIdNow
	handle any
		!gid = ''
	endhandle
	!gstack = '0'
	!gstackerr = ''
	!gstack = !!DrawingPlan1GridStack(!agside, !gbx, !gby, !gid)
	handle any
		!gstack = '0'
		!gstackerr = !!error.text
	endhandle
	if (!gstack.eq('SKIP')) then
		return
	endif
	!gpush = !gstack.real()
	if (!gpush.gt(0)) then
		------------------------------------------------------------------
		-- outwards, on the axis that crosses the border. !x / !y are    --
		-- still in sheet coordination here -- the rcode swap is below   --
		-- -- so this is the same footing the frozen-depth shift works on --
		------------------------------------------------------------------
		if (!agside.eqnocase('Top')) then
			!y = !y + !gpush
			!gby = !gby + !gpush
		elseif (!agside.eqnocase('Bottom')) then
			!y = !y - !gpush
			!gby = !gby - !gpush
		elseif (!agside.eqnocase('Right')) then
			!x = !x + !gpush
			!gbx = !gbx + !gpush
		else
			!x = !x - !gpush
			!gbx = !gbx - !gpush
		endif
	endif
	!!DrawingPlan1GridBubbles.append(!agside & '~' & string(!gbx) & '~' & string(!gby) & '~' & !gid)
	handle any
	endhandle

	--------------------------------------------------------------------------
	-- !x !y !xap !yap above are in sheet coordination, because they come   --
	-- from shpos, but XYPO and APOF are in view coordination. when         --
	-- rcode = left the view is rotated 90 degrees anticlockwise on the     --
	-- sheet, so convert them back before writing. same conversion as the   --
	-- one in .Apply() for the labels of LabelSpace.                        --
	-- AGSIDE is not converted, it always means the side of the view as it  --
	-- appears on the sheet, whatever the rcode is                          --
	--------------------------------------------------------------------------
	if (!this.rcode.eqnocase('left')) then
		!tempxy = !x
		!x     = !y
		!y     = !tempxy * -1
		!tempxy = !xap
		!xap   = !yap
		!yap   = !tempxy * -1
	endif

	------------------------------------------------------------------
	-- the bubble for this grid line, this end, this side may already --
	-- be on the layer from a previous run. reuse it rather than      --
	-- piling a second one on top: DDNA / NPPT / AGSIDE name it, and  --
	-- they do not change when the box does, so it is still found     --
	-- after a resize has moved it (2026-08-28)                       --
	--                                                                 --
	-- an existing bubble is then left completely alone: XYPO / APOF  --
	-- are written only on one this run creates. they are offsets      --
	-- from the grid line's own end, so a box change would move them,  --
	-- but a bubble already on an issued drawing must not move -- it   --
	-- is part of the comparison baseline, same rule as the dimension  --
	-- chain (2026-08-29)                                              --
	------------------------------------------------------------------
	!gsref = !!DrawingPlan1GridClaim(!refgln, !agside, !nppt)
	!dbgg = object file('L:\E3D\pdms_prog\E3D2.1\PA_pmllibE3D2.1\check_grid.txt')
	!dbgg.open('append')
	!dbgg.writerecord('GRIDBUB side=' & !agside & ' nppt=' & !nppt.string() & ' new=' & !gsref.eq('').string() & ' xypo=' & !x.string('D3') & ' ' & !y.string('D3') & ' sheet=' & !gbx.string('D3') & ' ' & !gby.string('D3') & ' id=' & !gid & ' push=' & !gpush.string('D1') & ' stack=' & !gstack & ' err=[' & !gstackerr & '] gln=' & !refgln)
	!dbgg.close()
	handle any
	endhandle
	if (!gsref.eq('')) then
		NEW SLAB
		DDNA $!refgln
		NPPT $!nppt
		TMRF /TT/DRA/PRJ/LABEL/REFGRD/ID
		XYPO $!x $!y
		APOF $!xap $!yap
		Agside |$!agside|
		----------------------------------------------------------------
		-- a stacked bubble shares the leader of the one it sits on, so --
		-- it must not draw its own: that line would run straight       --
		-- through the circle below it                                  --
		----------------------------------------------------------------
		if (!gpush.gt(0)) then
			Lleader false
		endif
		----------------------------------------------------------------
		-- turn the symbol back upright when the view is rotated       --
		----------------------------------------------------------------
		if (!this.rcode.eqnocase('left')) then
			Adegrees -90
		endif
	else
		$!gsref
		!exxy = ''
		var !exxy xypo
		handle any
			!exxy = 'UNREADABLE'
		endhandle
		!dbgg2 = object file('L:\E3D\pdms_prog\E3D2.1\PA_pmllibE3D2.1\check_grid.txt')
		!dbgg2.open('append')
		!dbgg2.writerecord('  KEPT side=' & !agside & ' nppt=' & !nppt.string() & ' existing xypo=' & !exxy)
		!dbgg2.close()
		handle any
		endhandle
	endif
endmethod

----------------------------------------------------
-- create a grid label based on end point of grid --
----------------------------------------------------
define method .CreateGridSymbol(!i is real, !p12linesh is line, !thispossh is string, !thatpossh is string, !refgln is string, !nppt is real)
	if (!this.intersections.getindexed(!i).split('-').getindexed(1).eq('boxUlinesh')) then
		!agside = 'Top'
	elseif (!this.intersections.getindexed(!i).split('-').getindexed(1).eq('boxDlinesh')) then
		!agside = 'Bottom'
	elseif (!this.intersections.getindexed(!i).split('-').getindexed(1).eq('boxLlinesh')) then
		!agside = 'Left'
	elseif (!this.intersections.getindexed(!i).split('-').getindexed(1).eq('boxRlinesh')) then
		!agside = 'Right'
	endif

	---------------------------------------------------------------------------------
	-- the bubble goes GRIDDIST beyond where this grid line meets the view frame,   --
	-- always. never beside the line's own end                                      --
	--                                                                               --
	-- this is the method called for an end which stops INSIDE the view -- see the  --
	-- !total = 1 and !total = 0 branches of DrawingPlan1GridAnnotation.pmlfnc. it   --
	-- used to put the bubble GRIDDIST past that end whenever the end was more than  --
	-- 100mm from the frame, which landed it in the middle of the drawing on top of  --
	-- the model (user, 2026-09-07)                                                  --
	--                                                                               --
	-- user's rule: every column position gets a bubble, and they all line up        --
	-- outside the frame. so a grid line which stops short gets its bubble on the    --
	-- frame like every other one -- which is what                                   --
	-- .CreateGridSymbolwithIntersection() has always done for the ends that do      --
	-- cross, and the two now agree                                                  --
	--                                                                               --
	-- the intersection is of the line EXTENDED, so it exists even for a line which  --
	-- never reaches the frame: DrawingPlan1GridAnnotation collects them by crossing  --
	-- unbounded lines and only afterwards tests which ones are on the bounded one   --
	---------------------------------------------------------------------------------
	!line = object line(!thatpossh.position(), !thispossh.position())
	!dir = !line.direction()
	!gintpt = !this.intersections.getindexed(!i).split('-').getindexed(2).position()
	!x = !gintpt.offset(!dir, !this.griddist.val).east - !thispossh.position().east
	!y = !gintpt.offset(!dir, !this.griddist.val).north - !thispossh.position().north
	!xap = !gintpt.offset(!dir, !this.gridgap.val).east - !thispossh.position().east
	!yap = !gintpt.offset(!dir, !this.gridgap.val).north - !thispossh.position().north
	----------------------------------------------------------------------
	-- same as .CreateGridSymbolwithIntersection(): the sheet position of --
	-- the bubble, kept for the pipe number labels to stay clear of. !x / --
	-- !y are measured from !thispossh here                               --
	----------------------------------------------------------------------
	!gbx = !x + !thispossh.position().east
	!gby = !y + !thispossh.position().north
	----------------------------------------------------------------------
	-- a side which already has bubbles keeps its depth: those are      --
	-- frozen, so a new one lines up with them rather than with the box --
	-- edge they no longer sit on. the shift goes on the axis that      --
	-- crosses the border, and on APOF too so the leader keeps its gap  --
	----------------------------------------------------------------------
	!frz = !!DrawingPlan1GridFrozen(!agside)
	if (not(!frz.eq(''))) then
		if (!agside.eqnocase('Left') or !agside.eqnocase('Right')) then
			!fdel = !frz.real() - !gbx
			!x = !x + !fdel
			!xap = !xap + !fdel
			!gbx = !gbx + !fdel
		else
			!fdel = !frz.real() - !gby
			!y = !y + !fdel
			!yap = !yap + !fdel
			!gby = !gby + !fdel
		endif
	endif
	----------------------------------------------------------------------
	-- another bubble may already be standing on this exact spot: this   --
	-- project has more than one grid system over the same ground. the   --
	-- same number twice is the same column position twice, so this one  --
	-- is dropped; a different number is a real second label and gets     --
	-- stacked one circle further out, sharing the leader of the one     --
	-- below it (user's rule and sketch, 2026-09-07)                     --
	--                                                                    --
	-- the drop happens BEFORE the claim below, so a duplicate left on   --
	-- the layer by an earlier run goes unclaimed and is deleted by      --
	-- DrawingPlan1GridAnnotation's own cleanup -- nothing extra needed  --
	----------------------------------------------------------------------
	!gid = !!DrawingPlan1GridIdNow
	handle any
		!gid = ''
	endhandle
	!gstack = '0'
	!gstackerr = ''
	!gstack = !!DrawingPlan1GridStack(!agside, !gbx, !gby, !gid)
	handle any
		!gstack = '0'
		!gstackerr = !!error.text
	endhandle
	if (!gstack.eq('SKIP')) then
		return
	endif
	!gpush = !gstack.real()
	if (!gpush.gt(0)) then
		------------------------------------------------------------------
		-- outwards, on the axis that crosses the border. !x / !y are    --
		-- still in sheet coordination here -- the rcode swap is below   --
		-- -- so this is the same footing the frozen-depth shift works on --
		------------------------------------------------------------------
		if (!agside.eqnocase('Top')) then
			!y = !y + !gpush
			!gby = !gby + !gpush
		elseif (!agside.eqnocase('Bottom')) then
			!y = !y - !gpush
			!gby = !gby - !gpush
		elseif (!agside.eqnocase('Right')) then
			!x = !x + !gpush
			!gbx = !gbx + !gpush
		else
			!x = !x - !gpush
			!gbx = !gbx - !gpush
		endif
	endif
	!!DrawingPlan1GridBubbles.append(!agside & '~' & string(!gbx) & '~' & string(!gby) & '~' & !gid)
	handle any
	endhandle

	--------------------------------------------------------------------------
	-- !x !y !xap !yap above are in sheet coordination, because they come   --
	-- from shpos, but XYPO and APOF are in view coordination. when         --
	-- rcode = left the view is rotated 90 degrees anticlockwise on the     --
	-- sheet, so convert them back before writing. same conversion as the   --
	-- one in .Apply() for the labels of LabelSpace.                        --
	-- AGSIDE is not converted, it always means the side of the view as it  --
	-- appears on the sheet, whatever the rcode is                          --
	--------------------------------------------------------------------------
	if (!this.rcode.eqnocase('left')) then
		!tempxy = !x
		!x     = !y
		!y     = !tempxy * -1
		!tempxy = !xap
		!xap   = !yap
		!yap   = !tempxy * -1
	endif

	------------------------------------------------------------------
	-- the bubble for this grid line, this end, this side may already --
	-- be on the layer from a previous run. reuse it rather than      --
	-- piling a second one on top: DDNA / NPPT / AGSIDE name it, and  --
	-- they do not change when the box does, so it is still found     --
	-- after a resize has moved it (2026-08-28)                       --
	--                                                                 --
	-- an existing bubble is then left completely alone: XYPO / APOF  --
	-- are written only on one this run creates. they are offsets      --
	-- from the grid line's own end, so a box change would move them,  --
	-- but a bubble already on an issued drawing must not move -- it   --
	-- is part of the comparison baseline, same rule as the dimension  --
	-- chain (2026-08-29)                                              --
	------------------------------------------------------------------
	!gsref = !!DrawingPlan1GridClaim(!refgln, !agside, !nppt)
	!dbgg = object file('L:\E3D\pdms_prog\E3D2.1\PA_pmllibE3D2.1\check_grid.txt')
	!dbgg.open('append')
	!dbgg.writerecord('GRIDBUB side=' & !agside & ' nppt=' & !nppt.string() & ' new=' & !gsref.eq('').string() & ' xypo=' & !x.string('D3') & ' ' & !y.string('D3') & ' sheet=' & !gbx.string('D3') & ' ' & !gby.string('D3') & ' id=' & !gid & ' push=' & !gpush.string('D1') & ' stack=' & !gstack & ' err=[' & !gstackerr & '] gln=' & !refgln)
	!dbgg.close()
	handle any
	endhandle
	if (!gsref.eq('')) then
		NEW SLAB
		DDNA $!refgln
		NPPT $!nppt
		TMRF /TT/DRA/PRJ/LABEL/REFGRD/ID
		XYPO $!x $!y
		APOF $!xap $!yap
		Agside |$!agside|
		----------------------------------------------------------------
		-- a stacked bubble shares the leader of the one it sits on, so --
		-- it must not draw its own: that line would run straight       --
		-- through the circle below it                                  --
		----------------------------------------------------------------
		if (!gpush.gt(0)) then
			Lleader false
		endif
		----------------------------------------------------------------
		-- turn the symbol back upright when the view is rotated       --
		----------------------------------------------------------------
		if (!this.rcode.eqnocase('left')) then
			Adegrees -90
		endif
	else
		$!gsref
		!exxy = ''
		var !exxy xypo
		handle any
			!exxy = 'UNREADABLE'
		endhandle
		!dbgg2 = object file('L:\E3D\pdms_prog\E3D2.1\PA_pmllibE3D2.1\check_grid.txt')
		!dbgg2.open('append')
		!dbgg2.writerecord('  KEPT side=' & !agside & ' nppt=' & !nppt.string() & ' existing xypo=' & !exxy)
		!dbgg2.close()
		handle any
		endhandle
	endif
endmethod

--------------------------------------------------------------------------
-- is a sheet position inside the rectangle of the view. !shpos is a     --
-- string as SHPOS OF hands it back, e.g. 'X 231.0mm Y 196.0mm'          --
--                                                                       --
-- COLLECT ... WITHIN can only be given a volume square with E / N / U,  --
-- so for a turned box it has to be handed the world box which contains  --
-- the drawing box, which reaches past the corners. this is the check    --
-- which throws away what that wider volume picks up outside the view.   --
-- .viewLLsh / .viewURsh already carry 0.025mm of slack outwards, so a   --
-- position exactly on the border stays in                               --
--                                                                       --
-- on an orthogonal box the wider volume is the box, so nothing is       --
-- thrown away and the answer is the same as before                      --
--------------------------------------------------------------------------
define method .InViewOnSheet(!shpos is string) is boolean
	!answer = true
	------------------------------------------------------------------
	-- a handle any only covers the one statement in front of it, so --
	-- the two reads get one each, and an unreadable position leaves --
	-- !ok false and the answer true -- better to keep an annotation --
	-- which may well belong on the drawing than to lose it          --
	------------------------------------------------------------------
	!ok = true
	!x = 0
	!y = 0
	!x = !shpos.part(2).replace('mm', '').real()
	handle any
		!ok = false
	endhandle
	!y = !shpos.part(4).replace('mm', '').real()
	handle any
		!ok = false
	endhandle
	if (!ok) then
		!x1 = min(!this.boxLLsh.part(2).real(), !this.boxURsh.part(2).real())
		!x2 = max(!this.boxLLsh.part(2).real(), !this.boxURsh.part(2).real())
		!y1 = min(!this.boxLLsh.part(4).real(), !this.boxURsh.part(4).real())
		!y2 = max(!this.boxLLsh.part(4).real(), !this.boxURsh.part(4).real())
		if (!x lt !x1 or !x gt !x2 or !y lt !y1 or !y gt !y2) then
			!answer = false
		endif
	endif
	return !answer
endmethod

--------------------------------------------------------------------------
-- the four sides of the view are parallel to E and N only when the      --
-- drawing box is orthogonal to the world. when it is not, .Apply() puts --
-- ADEGREES on the view so that the box still comes out square on the    --
-- sheet, and a volume such as "10mm inside the right hand side of the   --
-- view" can no longer be handed to COLLECT ... WITHIN, because WITHIN   --
-- only takes volumes which are square with E / N / U                    --
--                                                                       --
-- the methods below work in sheet coordination instead, where the view  --
-- is always square, and convert between the two coordinations with a    --
-- 2 by 2 matrix measured from the view itself, so the view scale,       --
-- ADEGREES and RCODE are all carried by it                              --
--                                                                       --
-- .ViewSheetTransform() returns that matrix as                          --
--   1, 2  sheet x, y of the centre of the view                          --
--   3, 4  east, north of the centre of the view                         --
--   5, 6  sheet x, y of a 1mm step to the east                          --
--   7, 8  sheet x, y of a 1mm step to the north                         --
--   9     determinant, for the way back                                 --
--   10    1 when the view sits square on the sheet, that is when the    --
--         box is orthogonal to the world, whatever rcode is. the world  --
--         box of a band is then the band itself and nothing has to be   --
--         checked a second time                                         --
-- CE must be the view or an element inside it                           --
--------------------------------------------------------------------------
define method .ViewSheetTransform() is array
	!trans = object array()
	!c0x = (!this.viewLLsh.part(2).real() + !this.viewURsh.part(2).real()) * 0.5
	!c0y = (!this.viewLLsh.part(4).real() + !this.viewURsh.part(4).real()) * 0.5
	!c0sh = 'x ' & string(!c0x) & ' y ' & string(!c0y)
	var !c0enu enupos of $!c0sh
	!cen = object position(!c0enu)
	!trans[1] = !c0x
	!trans[2] = !c0y
	!trans[3] = !cen.east
	!trans[4] = !cen.north
	!tempp = !cen.offset(object direction('E'), 1000)
	var !tempsh shpos of $!tempp
	!trans[5] = (!tempsh.part(2).replace('mm', '').real() - !c0x) / 1000
	!trans[6] = (!tempsh.part(4).replace('mm', '').real() - !c0y) / 1000
	!tempp = !cen.offset(object direction('N'), 1000)
	var !tempsh shpos of $!tempp
	!trans[7] = (!tempsh.part(2).replace('mm', '').real() - !c0x) / 1000
	!trans[8] = (!tempsh.part(4).replace('mm', '').real() - !c0y) / 1000
	!trans[9] = !trans[5] * !trans[8] - !trans[7] * !trans[6]
	----------------------------------------------------------------------
	-- square means east lies along one of the two sheet axes and north  --
	-- along the other one. compared as squares to keep clear of sqrt    --
	----------------------------------------------------------------------
	!scal2 = !trans[5] * !trans[5] + !trans[6] * !trans[6]
	!tol2 = !scal2 * 0.000001
	!trans[10] = 0
	if ((!trans[6] * !trans[6] lt !tol2 and !trans[7] * !trans[7] lt !tol2) or (!trans[5] * !trans[5] lt !tol2 and !trans[8] * !trans[8] lt !tol2)) then
		!trans[10] = 1
	endif
	return !trans
endmethod

------------------------------------------------------------------------
-- the band along one side of the BOX, !depth mm deep measured from    --
-- the box edge, in sheet coordination -- the box edge and not the     --
-- view border, because an update freezes the placement and pads the   --
-- side that did not grow, and a band hung off that padding would go   --
-- looking for members where nothing is drawn (2026-08-29)             --
-- !dir is the side as it appears on the sheet                         --
-- returns x1, y1, x2, y2                                              --
------------------------------------------------------------------------
define method .SheetBandOfSide(!dir is string, !depth is real) is array
	!x1 = min(!this.boxLLsh.part(2).real(), !this.boxURsh.part(2).real())
	!x2 = max(!this.boxLLsh.part(2).real(), !this.boxURsh.part(2).real())
	!y1 = min(!this.boxLLsh.part(4).real(), !this.boxURsh.part(4).real())
	!y2 = max(!this.boxLLsh.part(4).real(), !this.boxURsh.part(4).real())
	if (!dir.eq('right')) then
		!x1 = !x2 - !depth
	elseif (!dir.eq('left')) then
		!x2 = !x1 + !depth
	elseif (!dir.eq('up')) then
		!y1 = !y2 - !depth
	elseif (!dir.eq('down')) then
		!y2 = !y1 + !depth
	endif
	--------------------------------------------------------------------
	-- pad the box-facing edge by a hair. an equipment sitting exactly --
	-- on the box border is a genuine coin flip here: rebuild and      --
	-- update each derive boxLLsh/boxURsh through their own chain of   --
	-- floating point ops, and a difference of a fraction of a         --
	-- millimetre is enough to put the border-line equipment's WVOL on --
	-- one side of the strict boundary test in one run and the other   --
	-- side in the next -- a same-box, nothing-changed update then     --
	-- disagreed with rebuild over whether it should be dimensioned at --
	-- all (2026-08-31, /02.5HD01_AG_0600_T_660105/B3 landed exactly   --
	-- on the right edge, present in update's "coll all equi within"   --
	-- and absent from rebuild's). 0.5mm is nowhere near enough to     --
	-- pull in a genuinely different element, just enough to absorb    --
	-- rounding noise on one that already sits on the line             --
	--------------------------------------------------------------------
	if (!dir.eq('right')) then
		!x2 = !x2 + 0.5
	elseif (!dir.eq('left')) then
		!x1 = !x1 - 0.5
	elseif (!dir.eq('up')) then
		!y2 = !y2 + 0.5
	elseif (!dir.eq('down')) then
		!y1 = !y1 - 0.5
	endif
	!band = object array()
	!band[1] = !x1
	!band[2] = !y1
	!band[3] = !x2
	!band[4] = !y2
	return !band
endmethod

------------------------------------------------------------------------
-- the world axis aligned volume which contains a sheet rectangle.     --
-- it is the same rectangle when the box is orthogonal, and bigger     --
-- than it when the view is turned, so it is safe to hand to WITHIN    --
-- returns min E, min N, max E, max N                                  --
------------------------------------------------------------------------
define method .WorldLimitsOfSheetRect(!x1 is real, !y1 is real, !x2 is real, !y2 is real, !trans is array) is array
	!xs = object array()
	!ys = object array()
	!xs[1] = !x1
	!ys[1] = !y1
	!xs[2] = !x2
	!ys[2] = !y1
	!xs[3] = !x2
	!ys[3] = !y2
	!xs[4] = !x1
	!ys[4] = !y2
	!es = object array()
	!ns = object array()
	do !i from 1 to 4
		!dx = !xs[!i] - !trans[1]
		!dy = !ys[!i] - !trans[2]
		!es[!i] = !trans[3] + (!dx * !trans[8] - !dy * !trans[7]) / !trans[9]
		!ns[!i] = !trans[4] + (!dy * !trans[5] - !dx * !trans[6]) / !trans[9]
	enddo
	!lim = object array()
	!lim[1] = min(min(!es[1], !es[2]), min(!es[3], !es[4]))
	!lim[2] = min(min(!ns[1], !ns[2]), min(!ns[3], !ns[4]))
	!lim[3] = max(max(!es[1], !es[2]), max(!es[3], !es[4]))
	!lim[4] = max(max(!ns[1], !ns[2]), max(!ns[3], !ns[4]))
	return !lim
endmethod

------------------------------------------------------------------------
-- the sheet rectangle which contains a world axis aligned volume,     --
-- WVOL of an element                                                  --
-- returns x1, y1, x2, y2                                              --
------------------------------------------------------------------------
define method .SheetLimitsOfVolume(!wvol is string, !trans is array) is array
	!e1 = !wvol.part(1).replace('mm', '').real()
	!n1 = !wvol.part(2).replace('mm', '').real()
	!e2 = !wvol.part(4).replace('mm', '').real()
	!n2 = !wvol.part(5).replace('mm', '').real()
	!es = object array()
	!ns = object array()
	!es[1] = !e1
	!ns[1] = !n1
	!es[2] = !e2
	!ns[2] = !n1
	!es[3] = !e2
	!ns[3] = !n2
	!es[4] = !e1
	!ns[4] = !n2
	!xs = object array()
	!ys = object array()
	do !i from 1 to 4
		!de = !es[!i] - !trans[3]
		!dn = !ns[!i] - !trans[4]
		!xs[!i] = !trans[1] + !de * !trans[5] + !dn * !trans[7]
		!ys[!i] = !trans[2] + !de * !trans[6] + !dn * !trans[8]
	enddo
	!lim = object array()
	!lim[1] = min(min(!xs[1], !xs[2]), min(!xs[3], !xs[4]))
	!lim[2] = min(min(!ys[1], !ys[2]), min(!ys[3], !ys[4]))
	!lim[3] = max(max(!xs[1], !xs[2]), max(!xs[3], !xs[4]))
	!lim[4] = max(max(!ys[1], !ys[2]), max(!ys[3], !ys[4]))
	return !lim
endmethod

------------------------------------------------------------------------
-- does the element really reach into the band, checked in sheet       --
-- coordination. the volume handed to WITHIN is only the world box     --
-- which contains the band, so this is what keeps the elements which   --
-- sit in the corners of that box out of the annotation               --
-- an element whose WVOL cannot be read is kept                        --
------------------------------------------------------------------------
define method .CheckInSheetBand(!elem is string, !band is array, !trans is array) is boolean
	!answer = true
	if (!trans[10] neq 1) then
		var !wvol wvol of $!elem
		handle any
			----------------------------------------------
			-- no volume to check against, keep it      --
			----------------------------------------------
		elsehandle none
			!lim = !this.SheetLimitsOfVolume(!wvol, !trans)
			if (!lim[1] gt !band[3] or !lim[3] lt !band[1] or !lim[2] gt !band[4] or !lim[4] lt !band[2]) then
				!answer = false
			endif
			----------------------------------------------------------------
			-- the CHECKBAND diagnostic that used to sit here is gone.     --
			-- TYPE 1 / 2a / 2b / 3 no longer call this method at all --   --
			-- they test the annotation point against the band directly    --
			-- (see DrawingPlan1LineNoAnnotation.pmlfnc) -- so this only    --
			-- runs for equipment now, where the WVOL is genuinely large   --
			-- and the extra checks after it already cover the case        --
			----------------------------------------------------------------
		endhandle
	endif
	return !answer
endmethod

--------------------------------------------------------------------------
-- where the tube which leaves !elem crosses one border of the view, as  --
-- a world position. answers 'NONE' when the tube is known not to reach  --
-- that border, and '' when it cannot be worked out at all, so that the  --
-- caller can tell the two apart                                         --
--                                                                       --
-- a straight run of pipe is not an element of its own, it turns up in a --
-- collection as an implied tube and MTBE gives the thing the tube       --
-- leaves from, which is the BRAN when the tube leaves the head of the   --
-- branch and a component otherwise. that element can be right across    --
-- the drawing from the border, so its own position must not be used to  --
-- dimension against. the tube is followed instead, the same way as      --
-- E3dDraftModify and DrawingPlan1FlowAnnotation follow one             --
--                                                                       --
-- the crossing has to sit on the tube itself and not on the endless     --
-- line through it. where a pipe turns near a border, the tube before    --
-- the bend and the tube after it both have a line which cuts that       --
-- border, a short distance apart, but only one of them really reaches   --
-- it. without this the pipe gets two identical line numbers side by     --
-- side. ITLE gives the length of the tube, as in E3dDraftModify         --
--                                                                       --
-- !tube is the implied tube as it came out of the collection, !elem is  --
-- what MTBE made of it                                                  --
-- !dir is the side of the view as it appears on the sheet               --
-- CE must be the view or an element inside it                           --
--------------------------------------------------------------------------
define method .CrossingOfTube(!tube is string, !elem is string, !dir is string) is string
	!answer = ''
	!ok = true
	!stpos = ''
	!stdir = ''
	!tubelen = 0
	var !type type of $!elem
	handle any
		!ok = false
	endhandle
	if (!ok) then
		if (!type.eqnocase('BRAN')) then
			var !stpos hposition of $!elem
			handle any
				!ok = false
			endhandle
			var !stdir hdirection of $!elem
			handle any
				!ok = false
			endhandle
		else
			var !stpos pl pos of $!elem
			handle any
				!ok = false
			endhandle
			var !stdir pl dir of $!elem
			handle any
				!ok = false
			endhandle
		endif
	endif
	if (!ok) then
		----------------------------------------------------------------
		-- the tube on the sheet, from where it leaves !elem along the --
		-- direction it leaves in                                      --
		----------------------------------------------------------------
		!p1 = object position(!stpos)
		--------------------------------------------------------------
		-- the far end of the tube. when ITLE does not answer, walk  --
		-- 1000mm instead and let the crossing be taken from the     --
		-- endless line, as it was before                            --
		--------------------------------------------------------------
		var !itle itle of $!tube
		handle any
			!itle = ''
		endhandle
		----------------------------------------------------------------
		-- .real() of an empty string does not throw here -- it just  --
		-- comes back unset, which the handle below never sees since  --
		-- no error was raised, so ITLE not answering has to be ruled --
		-- out before the conversion is even attempted                --
		----------------------------------------------------------------
		if (!itle.eq('')) then
			!tubelen = 0
		else
			!tubelen = !itle.replace('mm', '').real()
			handle any
				!tubelen = 0
			endhandle
		endif
		if (!tubelen gt 0) then
			!p2 = !p1.offset(!stdir.direction(), !tubelen)
		else
			!p2 = !p1.offset(!stdir.direction(), 1000)
		endif
		var !p1sh shpos of $!p1
		var !p2sh shpos of $!p2
		------------------------------------------------------------------
		-- a tube which runs up or down is a single point on a plan, so  --
		-- its two ends land on top of each other on the sheet. handing  --
		-- that to intersection() only earns a warning about coincident  --
		-- start and end positions, and there is nothing to work out     --
		-- either. answered as '' so that the caller falls back on the   --
		-- position of the element, which for such a tube is the same    --
		-- point on the plan anyway                                      --
		------------------------------------------------------------------
		if (!p1sh.position().distance(!p2sh.position()) lt 0.001) then
			!ok = false
		endif
	endif
	if (!ok) then
		!tubeline = object line(!p1sh.position(), !p2sh.position())
		!crosssh = ''
		if (!dir.eq('right')) then
			!crosssh = !this.boxRlinesh.intersection(!tubeline).string().before('U').replace('N', 'Y').replace('S', 'Y').replace('E', 'X').replace('W', 'X')
			handle any
				------------------------------------------------
				-- the tube runs along that border            --
				------------------------------------------------
				!ok = false
			endhandle
		elseif (!dir.eq('left')) then
			!crosssh = !this.boxLlinesh.intersection(!tubeline).string().before('U').replace('N', 'Y').replace('S', 'Y').replace('E', 'X').replace('W', 'X')
			handle any
				!ok = false
			endhandle
		elseif (!dir.eq('down')) then
			!crosssh = !this.boxDlinesh.intersection(!tubeline).string().before('U').replace('N', 'Y').replace('S', 'Y').replace('E', 'X').replace('W', 'X')
			handle any
				!ok = false
			endhandle
		elseif (!dir.eq('up')) then
			!crosssh = !this.boxUlinesh.intersection(!tubeline).string().before('U').replace('N', 'Y').replace('S', 'Y').replace('E', 'X').replace('W', 'X')
			handle any
				!ok = false
			endhandle
		endif
	endif
	if (!ok and !tubelen gt 0) then
		------------------------------------------------------------------
		-- the crossing has to lie between the two ends of the tube. the --
		-- point is known to be on the line through them, so comparing   --
		-- the distances is enough. 1mm of the sheet is allowed either   --
		-- end, for a bend which sits right on the border                --
		------------------------------------------------------------------
		!s1 = !p1sh.position()
		!s2 = !p2sh.position()
		!cs = !crosssh.position()
		!slen = !s1.distance(!s2)
		if (!slen gt 0.001) then
			if (!s1.distance(!cs) gt (!slen + 1) or !s2.distance(!cs) gt (!slen + 1)) then
				------------------------------------------------------------
				-- this tube does not reach that border. answered apart   --
				-- from '' so that the caller can drop the member instead --
				-- of falling back on the position of the element         --
				------------------------------------------------------------
				!answer = 'NONE'
				!ok = false
			endif
		endif
	endif
	if (!ok) then
		var !crossenu enupos of $!crosssh
		handle any
			!ok = false
		endhandle
		if (!ok) then
			!answer = !crossenu
		endif
	endif
	------------------------------------------------------------------------
	-- temporary diagnostic 2026-08-13: a crossing is being accepted for a --
	-- component whose implied tube apparently does not really reach that --
	-- border (elbow 4 of /80-A-11/B1, confirmed by the user against the   --
	-- model). the between-the-tube's-own-ends check just above is only   --
	-- run when !tubelen is gt 0 -- if ITLE could not be read, !tubelen    --
	-- stayed 0, !p2 became an arbitrary 1000mm walk in !stdir, and        --
	-- whatever it happened to cross gets accepted with no verification    --
	-- against where the tube really ends. logging every case where a     --
	-- real crossing survived with !tubelen = 0 will confirm or rule this --
	-- out directly instead of guessing further. remove once answered      --
	------------------------------------------------------------------------
	if (!answer.neq('') and !answer.neq('NONE') and !tubelen.leq(0)) then
		!dbgf2 = object file('L:\E3D\pdms_prog\E3D2.1\PA_pmllibE3D2.1\check2.txt')
		if (!dbgf2.exists()) then
			!dbgf2.open('append')
		else
			!dbgf2.open('overwrite')
		endif
		!dbgf2.writerecord('CROSSING-NOLEN tube=' & !tube & ' elem=' & !elem & ' dir=' & !dir & ' stpos=' & !stpos & ' stdir=' & !stdir & ' answer=' & !answer)
		!dbgf2.close()
	endif
	return !answer
endmethod

--------------------------------------------------------------------------
-- how much of !tube can be seen inside the view, and where the middle   --
-- of that visible run falls, all in sheet coordination                  --
--                                                                       --
-- answers [ length squared, middle x, middle y, x1, y1, x2, y2 ], and   --
-- an empty array when no part of the tube is inside the view. the four  --
-- numbers on the end are the two ends of the visible run, which let the --
-- caller slide the arrow along the tube to get it clear of another one  --
--                                                                       --
-- the length comes back squared so that it can be compared without      --
-- sqrt, the same way .ViewSheetTransform() keeps clear of it. nothing   --
-- else is done with it, it is only ever used to tell one tube from      --
-- another                                                               --
--                                                                       --
-- the border of the view is an endless line as far as intersection() is --
-- concerned, so a tube which runs past the side of the view still gives --
-- a crossing, out on the extension of the border and away from the      --
-- sheet. asking each border in turn and keeping the nearest crossing    --
-- picks those up, and it also picks up crossings which lie behind the   --
-- start of the tube. the run is cut against the rectangle itself here   --
-- instead, one side at a time, along the parameter of the tube, so what --
-- comes back is always a piece of the tube and always inside the view   --
--                                                                       --
-- the view is an upright rectangle in sheet coordination whatever the   --
-- box is turned to on the model, which is why the sides can be taken    --
-- one at a time like this. see the note on .SheetBandOfSide()           --
--------------------------------------------------------------------------
define method .VisibleSheetRunOfTube(!tube is string, !vwx1 is real, !vwy1 is real, !vwx2 is real, !vwy2 is real) is array
	!answer = object array()
	!ok = true
	var !p1 pos p1 of $!tube wrt worl
	handle any
		!ok = false
	endhandle
	if (!ok) then
		var !p2 pos p2 of $!tube wrt worl
		handle any
			!ok = false
		endhandle
	endif
	if (!ok) then
		----------------------------------------------------------------
		-- the elevation is dropped before the ends are put on the     --
		-- sheet, as the flow annotation has always done               --
		----------------------------------------------------------------
		!p1enu = object position(!p1)
		!p2enu = object position(!p2)
		!p1enu.up = 0
		!p2enu.up = 0
		var !p1sh shpos of $!p1enu
		handle any
			!ok = false
		endhandle
	endif
	if (!ok) then
		var !p2sh shpos of $!p2enu
		handle any
			!ok = false
		endhandle
	endif
	if (!ok) then
		!x1 = !p1sh.split().getindexed(2).replace('mm', '').real()
		!y1 = !p1sh.split().getindexed(4).replace('mm', '').real()
		!x2 = !p2sh.split().getindexed(2).replace('mm', '').real()
		!y2 = !p2sh.split().getindexed(4).replace('mm', '').real()
		!dx = !x2 - !x1
		!dy = !y2 - !y1
		------------------------------------------------------------------
		-- !t0 and !t1 are how far along the tube the visible run starts --
		-- and ends, 0 being the first end and 1 the second. each side   --
		-- of the view pulls them in                                     --
		--                                                               --
		-- !p is how fast the tube crosses that side and !q how far the  --
		-- first end sits inside it. !p under zero means the tube comes  --
		-- in over that side and pushes !t0 up, over zero means it goes  --
		-- out and pulls !t1 down                                        --
		------------------------------------------------------------------
		!t0 = 0.0
		!t1 = 1.0
		!inview = true
		!ps = object array()
		!qs = object array()
		!ps.append(!dx * -1)
		!qs.append(!x1 - !vwx1)
		!ps.append(!dx)
		!qs.append(!vwx2 - !x1)
		!ps.append(!dy * -1)
		!qs.append(!y1 - !vwy1)
		!ps.append(!dy)
		!qs.append(!vwy2 - !y1)
		do !k from 1 to 4
			!p = !ps[!k]
			!q = !qs[!k]
			----------------------------------------------------------------
			-- the sign of !p is tested first and the tube which runs     --
			-- along the side is left to the else, so that !p can never   --
			-- be nought where the division is. a tolerance test round    --
			-- the division is not enough: a pipe square with the sheet   --
			-- makes !p exactly nought on two of the four sides, which is --
			-- most of the piping, and CALCULATOR ERROR: division by zero --
			-- came straight back                                         --
			--                                                            --
			-- no tolerance is wanted either way. where the tube is very  --
			-- nearly along the side !t comes out huge, and a huge !t     --
			-- neither pulls !t1 down nor pushes !t0 up, which is right   --
			----------------------------------------------------------------
			if (!p lt 0) then
				!t = !q / !p
				if (!t gt !t1) then
					!inview = false
				elseif (!t gt !t0) then
					!t0 = !t
				endif
			elseif (!p gt 0) then
				!t = !q / !p
				if (!t lt !t0) then
					!inview = false
				elseif (!t lt !t1) then
					!t1 = !t
				endif
			else
				--------------------------------------------------------
				-- the tube runs along this side, so it is either      --
				-- wholly inside it or wholly outside it and there is  --
				-- nothing to cut                                      --
				--------------------------------------------------------
				if (!q lt 0) then
					!inview = false
				endif
			endif
		enddo
		if (!inview and !t1 gt !t0) then
			!cx1 = !x1 + !t0 * !dx
			!cy1 = !y1 + !t0 * !dy
			!cx2 = !x1 + !t1 * !dx
			!cy2 = !y1 + !t1 * !dy
			!answer.append((!cx2 - !cx1) * (!cx2 - !cx1) + (!cy2 - !cy1) * (!cy2 - !cy1))
			!answer.append((!cx1 + !cx2) * 0.5)
			!answer.append((!cy1 + !cy2) * 0.5)
			!answer.append(!cx1)
			!answer.append(!cy1)
			!answer.append(!cx2)
			!answer.append(!cy2)
		endif
	endif
	return !answer
endmethod

--------------------------------------------------------------------------
-- the point of the grid line which is nearest to !intpt, in sheet       --
-- coordination                                                          --
--                                                                       --
-- the intersections of a grid line with the borders of the view are     --
-- worked out on endless lines, so a grid line which stops inside the    --
-- view still gets an intersection out on the border. the dimension is   --
-- then drawn with nothing joining it to the grid. this answers where    --
-- the grid line really ends, so that the projection line can be reached --
-- in to it: the intersection itself when it does lie on the grid line,  --
-- and the nearer of the two ends of the grid line when it does not      --
--------------------------------------------------------------------------
define method .NearEndOfGrid(!gridline is line, !p1sh is string, !p2sh is string, !intpt is position) is position
	!answer = !intpt
	------------------------------------------------------------------
	-- a grid line which comes out as a single point on the sheet    --
	-- cannot be asked whether something lies on it, on() would only --
	-- warn about coincident start and end positions. keep the point --
	-- on the border in that case                                    --
	------------------------------------------------------------------
	if (!p1sh.position().distance(!p2sh.position()) geq 0.001) then
		if (not(!gridline.on(!intpt, true))) then
			if (!p1sh.position().distance(!intpt) lt !p2sh.position().distance(!intpt)) then
				!answer = !p1sh.position()
			else
				!answer = !p2sh.position()
			endif
		endif
	endif
	return !answer
endmethod

--------------------------------------------------------------------------
-- true when nothing already on this dimension line sits at the same     --
-- coordinate ALONG the dimension direction as !val. two points which    --
-- share that coordinate measure 0 between them, so the drawing gets a   --
-- 0 dimension and a second projection line drawn across the view for    --
-- no gain -- which is what a pipe running along a grid line used to do. --
-- the depth of the two points does not matter, only the coordinate the  --
-- dimension is measured in, so this cannot be a 3d distance test        --
--------------------------------------------------------------------------
define method .DimAlongIsNew(!alongs is array, !val is real, !tol is real) is boolean
	!answer = true
	do !a values !alongs
		if (abs(!a - !val) lt !tol) then
			!answer = false
			break
		endif
	enddo
	return !answer
endmethod

--------------------------------------------------------------------------
-- explicit authorisation gate                                          --
--                                                                      --
-- AteSortLineNo used to only enforce office-network access as a side   --
-- effect of whichever function still happened to call it for sorting; --
-- when FlowAnnotation's sort was rewritten by hand (2026-08-10) it     --
-- stopped calling it and nothing noticed until asked. this method      --
-- makes the check explicit and is called once, up front, in .Apply()  --
--                                                                      --
-- first version of this inferred pass/fail from whether the Hashtable --
-- AteSortLineNo.Method() returned came back empty. that turned out    --
-- unreliable across the PML.NET boundary (2026-08-11): off-network,   --
-- the .NET side genuinely returned an empty Hashtable (confirmed by   --
-- its own MessageBox firing), but !checked.size() on the PML side     --
-- still read as non-empty, so this always returned true regardless of --
-- the real network state. AteSortLineNo now has a dedicated           --
-- IsAuthorized() method returning a real bool instead                 --
--------------------------------------------------------------------------
define method .CheckCompanyNetwork() is boolean
	using namespace 'Aveva.Core.Samples'
	!obj = object AteSortLineNo()
	return (!obj.IsAuthorized())
endmethod

------------------------------------------------------------------------
-- check which one is correct when dimension attach point(s) are near --
-- called by !!DrawingPlan1LineNoAnnotation()                         --
------------------------------------------------------------------------
define method .CheckDimensionAttachPoint(!checkxy is string, !maxmin is string, !checkxys is array, !viewdir is string) is string
	using namespace 'Aveva.Core.Samples'
	!obj = object AteSortLineNo()		
	!answers = !obj.method(!checkxy, !checkxys)
$(		
	$p <<<<<<<<<<<<<<<<<<<<<<<<<<<<
	do !answer values !answers
		$p $!answer
	enddo
$)		
	
	!checkok = false
	if (!maxmin.eq('max')) then
		do !i from !answers.size() to 1 by -1
			!answer = !answers[!i]
			!mem = !answer.split('!').getindexed(4)
			var !type type of $!mem
			!viewdir1 = object direction(!viewdir)
			if (!type.eqnocase('BRAN')) then
				var !hdir hdir of $!mem  $( <<<<<<<<<<<<<<<<<<<<<<<<< check tail direction later >>>>>>>>>>>>>>>>>>>>> $)
				!hdir1 = object direction(!hdir)
				if (!hdir1.angle(!viewdir1).abs().leq(40) or !hdir1.opposite().angle(!viewdir1).abs().leq(40)) then
					!checkok = true
					break
				endif
			elseif (!type.eqnocase('EQUI')) then
				!checkok = false
				break
			else
				var !p1dir p1dir of $!mem
				!p1dir1 = object direction(!p1dir)
				if (!p1dir1.angle(!viewdir1).abs().leq(40) or !p1dir1.opposite().angle(!viewdir1).abs().leq(40)) then
					!checkok = true
					break
				endif
				if (not (!checkok)) then
					var !p2dir p2dir of $!mem
					!p2dir1 = object direction(!p2dir)
					if (!p2dir1.angle(!viewdir1).abs().leq(40) or !p2dir1.opposite().angle(!viewdir1).abs().leq(40)) then
						!checkok = true
						break
					endif
				endif
			endif
		enddo
		if (!checkok) then
			!answer = !answer & '!y'
		else
			!answer = !answers.last() & '!n'
		endif
	elseif (!maxmin.eq('min')) then
		do !i from 1 to !answers.size()
			!answer = !answers[!i]
			!mem = !answer.split('!').getindexed(4)
			var !type type of $!mem
			!viewdir1 = object direction(!viewdir)
			if (!type.eqnocase('BRAN')) then
				var !hdir hdir of $!mem  $( <<<<<<<<<<<<<<<<<<<<<<<<< check tail direction later >>>>>>>>>>>>>>>>>>>>> $)
				!hdir1 = object direction(!hdir)
				if (!hdir1.angle(!viewdir1).abs().leq(40) or !hdir1.opposite().angle(!viewdir1).abs().leq(40)) then
					!checkok = true
					break
				endif
			elseif (!type.eqnocase('EQUI')) then
				!checkok = false
				break
			else
				var !p1dir p1dir of $!mem
				!p1dir1 = object direction(!p1dir)
				if (!p1dir1.angle(!viewdir1).abs().leq(40) or !p1dir1.opposite().angle(!viewdir1).abs().leq(40)) then
					!checkok = true
					break
				endif
				if (not (!checkok)) then
					var !p2dir p2dir of $!mem
					!p2dir1 = object direction(!p2dir)
					if (!p2dir1.angle(!viewdir1).abs().leq(40) or !p2dir1.opposite().angle(!viewdir1).abs().leq(40)) then
						!checkok = true
						break
					endif
				endif
			endif
		enddo
		if (!checkok) then
			!answer = !answer & '!y'
		else
			!answer = !answers.first() & '!n'
		endif
	endif
	return !answer
endmethod

-----------------------------------------------------------------------
-- the sum of all angles between a point and all vertices of a shape --
-- is 360 degrees, which means that the point is inside the shape    --
-----------------------------------------------------------------------
define method .CheckInsideView(!pt is string, !viewpt1 is string, !viewpt2 is string, !viewpt3 is string, !viewpt4 is string) is boolean
	!viewpts = object array()
	!viewpts.append(!viewpt1)
	!viewpts.append(!viewpt2)
	!viewpts.append(!viewpt3)
	!viewpts.append(!viewpt4)
	!angle = 0
	do !i from 1 to 4
		!line1 = object line(object position(!pt), object position(!viewpts[!i]))
		if (!i eq 4) then
			!line2 = object line(object position(!pt), object position(!viewpts[1]))
		else
			!line2 = object line(object position(!pt), object position(!viewpts[!i + 1]))
		endif
		!angle = !angle + !line1.direction().angle(!line2.direction())
	enddo
	if (!angle leq 360) then
		return true
	else
		return false
	endif
endmethod

define method .Close()
   kill !!DrawingPlan1
endmethod

---------------------------------------------------
-- to text match line words and draw match lines --
---------------------------------------------------
define method .MachLineCode()
	var !tempp1 enupos of $!!DrawingPlan1.viewULsh                                            $( old = $!!DrawingPlan1.viewURsh $)
	!tempp2 = object position(!tempp1)
	!tempp2.up = !!DrawingPlan1.minU + 50
	!tempp3 = !tempp2.offset(!tempdirr.direction(), 50).offset(!tempdiru.direction(), 50)			$( old = !tempdird.direction() $)
	var !tempp4 enupos of $!!DrawingPlan1.viewURsh                                            $( old = $!!DrawingPlan1.viewLRsh $)
	!tempp5 = object position(!tempp4)
	!tempp6 = !tempp5.offset(!tempdirl.direction(), 50).offset(!tempdiru.direction(), 50)     $( old = !tempdirr.direction() $)
	!tempp6.up = !!DrawingPlan1.maxU - 50
	var !boxes coll all box within $!tempp3 to $!tempp6 for /$!projid_DrawingPlanBox exclude /$!equistr
	handle any
		---------------------------
		-- for unnamed equipment --
		---------------------------
		var !boxes coll all box within $!tempp3 to $!tempp6 for /$!projid_DrawingPlanBox exclude $!equistr
	endhandle						
	!chks = object array()
	do !box values !boxes
		-------------------------------------------------------
		-- get ppoints which direction equal viewdir up/down --
		-------------------------------------------------------
		var !isnamed isnamed of equi of $!box
		if !isnamed.boolean() then
			var !tempe namn of equi of $!box
		else
			!tempe = ''
		endif
		do !j from 1 to 6
			var !boxp$!j (p$!j dir of $!box wrt worl)
			!boxpd$!j = object direction(!boxp$!j)
			
			if !tempdirl.direction().eq(!boxpd$!j) or !tempdirr.direction().eq(!boxpd$!j) then         $( old = !tempdiru !tempdird $)
				var !chk (p$!j pos of $!box wrt worl)
				var !chksh shpos of $!chk
				
				if !chksh.part(2).replace('mm', '').real().geq(!!DrawingPlan1.viewURsh.part(2).real() - 5 ) then
					!chks.append(!box & '!' & !!DrawingPlan1.viewURsh.part(2) & '!' & !chksh.part(4).replace('mm', '') & '!' & !tempe & '!' & !j)
				elseif !chksh.part(2).replace('mm', '').real().leq(!!DrawingPlan1.viewULsh.part(2).real() + 5 ) then
					!chks.append(!box & '!' & !!DrawingPlan1.viewULsh.part(2) & '!' & !chksh.part(4).replace('mm', '') & '!' & !tempe & '!' & !j)
				else
					!chks.append(!box & '!' & !chksh.part(2).replace('mm', '') & '!' & !chksh.part(4).replace('mm', '') & '!' & !tempe & '!' & !j)
				endif
$(						
				if !chksh.part(4).replace('mm', '').real().geq(!!DrawingPlan1.viewURsh.part(4).real() - 5 ) then
					!chks.append(!box & '!' & !chksh.part(2).replace('mm', '') & '!' & !!DrawingPlan1.viewURsh.part(4) & '!' & !tempe & '!' & !j)
				elseif !chksh.part(4).replace('mm', '').real().leq(!!DrawingPlan1.viewLRsh.part(4).real() + 5 ) then
					!chks.append(!box & '!' & !chksh.part(2).replace('mm', '') & '!' & !!DrawingPlan1.viewLRsh.part(4) & '!' & !tempe & '!' & !j)
				else
					!chks.append(!box & '!' & !chksh.part(2).replace('mm', '') & '!' & !chksh.part(4).replace('mm', '') & '!' & !tempe & '!' & !j)
				endif
$)						
				
			endif
		enddo
	enddo
	note 1
	if !chks.size().gt(0) then
		!exists = object array()
		using namespace 'Aveva.Core.Samples'
		!obj = object AteSort()
		---------------------------------------------------------------
		-- AteSort argument2 indicates                               --
		--   true  = sort by field1 + field2 (ref of box + x coord.) --
		--   false = sort by field1 + field3 (ref of box + y coord.) --
		---------------------------------------------------------------
		!sortedtypes = !obj.method1(!chks, true)                         $( old = false $)
		do !i from 1 to !sortedtypes.size()
			if !i.modulo(2).eq(1) then
				!tempt = ''
				if !i.eq(1) then
					---------------------------
					-- the maximun distance  --
					-- write all information --
					---------------------------
					if !viewdir.direction().eq(object direction('E')) or !viewdir.direction().eq(object direction('W')) or !viewdir.direction().eq(object direction('N')) or !viewdir.direction().eq(object direction('S')) then
						if !rcode.eqnocase('up') then
							if !sortedtypes[!i].split('!').getindexed(5).eqnocase('') then
								if !!DrawingPlan1.minN.gt(0) then                                                    $( old = !!DrawingPlan1.minE $)
									!tempt = 'MATCH LINE N' & !!stringRoundUpValue($!!DrawingPlan1.maxN, !format)      $( old = E !!DrawingPlan1.minE $)
								else
									!tempt = 'MATCH LINE S' & !!stringRoundUpValue($!!DrawingPlan1.maxN * -1, !format) $( old = W !!DrawingPlan1.minE $)
								endif
							else
								if !!DrawingPlan1.minN.gt(0) then                                                    $( old = !!DrawingPlan1.minE $)
									!tempt = 'MATCH LINE N' & !!stringRoundUpValue($!!DrawingPlan1.maxN, !format) & ' SEE ' & !sortedtypes[!i].split('!').getindexed(5)      $( old = E !!DrawingPlan1.minE $)
								else
									!tempt = 'MATCH LINE S' & !!stringRoundUpValue($!!DrawingPlan1.maxN * -1, !format) & ' SEE ' & !sortedtypes[!i].split('!').getindexed(5) $( old = W !!DrawingPlan1.minE $)
								endif
							endif
						else
							-------------------
							-- !rcode = left --
							-------------------
							if !sortedtypes[!i].split('!').getindexed(5).eqnocase('') then
								if !!DrawingPlan1.minE.gt(0) then                                                          $( old = !!DrawingPlan1.minN $)
									!tempt = 'MATCH LINE E' & !!stringRoundUpValue($!!DrawingPlan1.minE, !format)            $( old = N !!DrawingPlan1.minN $)
								else
									!tempt = 'MATCH LINE W' & !!stringRoundUpValue($!!DrawingPlan1.minE * -1, !format)       $( old = S !!DrawingPlan1.minN $)
								endif
							else
								if !!DrawingPlan1.minE.gt(0) then                                                          $( old = !!DrawingPlan1.minN $)
									!tempt = 'MATCH LINE E' & !!stringRoundUpValue($!!DrawingPlan1.minE, !format) & ' SEE ' & !sortedtypes[!i].split('!').getindexed(5)       $( old = N !!DrawingPlan1.minN $)
								else
									!tempt = 'MATCH LINE W' & !!stringRoundUpValue($!!DrawingPlan1.minE * -1, !format) & ' SEE ' & !sortedtypes[!i].split('!').getindexed(5)  $( old = S !!DrawingPlan1.minN $)
								endif
							endif
						endif
					elseif not(!sortedtypes[!i].split('!').getindexed(5).eqnocase('')) then
						!tempt = 'MATCH LINE SEE ' & !sortedtypes[!i].split('!').getindexed(5)
					endif
				else
					if not(!sortedtypes[!i].split('!').getindexed(5).eqnocase('')) then
						!tempt = 'SEE ' & !sortedtypes[!i].split('!').getindexed(5)
					endif
				endif
				if not(!tempt.eqnocase('')) then
					!posx = !sortedtypes[!i].split('!').getindexed(3).real() + (!sortedtypes[!i + 1].split('!').getindexed(3).real() - !sortedtypes[!i].split('!').getindexed(3).real()) * 0.5
					!posy = !!DrawingPlan1.viewURsh.part(4).real() + 1
					new texp btext |$!tempt| origin x $!posx y $!posy adegrees 0 cheitx |$!!DrawingPlan1.matchhei.val| alig bbody just center txcolour yellow font 1    $( old = 90  tbody $)
--							!posx = !!DrawingPlan1.viewURsh.part(2).real() + 1
--							!posy = !sortedtypes[!i].split('!').getindexed(4).real() + (!sortedtypes[!i + 1].split('!').getindexed(4).real() - !sortedtypes[!i].split('!').getindexed(4).real()) * 0.5
--							new texp btext |$!tempt| origin x $!posx y $!posy adegrees 90 cheitx |$!!DrawingPlan1.matchhei.val| alig tbody just center txcolour yellow font 1
				endif
			endif
			------------------------------------------------------------------
			-- to draw a match line if position is not on the border corner --
			------------------------------------------------------------------
			!exist = false
			$( old = 4 !!DrawingPlan1.viewURsh.part(4) !!DrawingPlan1.viewLRsh.part(4)  $)
			if not( abs(!sortedtypes[!i].split('!').getindexed(3).real() - !!DrawingPlan1.viewULsh.part(2).real()) leq 5 or abs(!sortedtypes[!i].split('!').getindexed(3).real() - !!DrawingPlan1.viewURsh.part(2).real()) leq 5) then
--					if not( abs(!sortedtypes[!i].split('!').getindexed(4).real() - !!DrawingPlan1.viewURsh.part(4).real()) leq 5 or abs(!sortedtypes[!i].split('!').getindexed(4).real() - !!DrawingPlan1.viewLRsh.part(4).real()) leq 5) then
				-----------------------------------------
				-- check if the match line is existing --
				-----------------------------------------
				do !j from 1 to !exists.size()
					if abs(!exists[!j].real() - !sortedtypes[!i].split('!').getindexed(3).real()) leq 5 then           $( old = 4 $)
						!exist = true
					endif
				enddo
			else
				!exist = true
			endif
			if not(!exist) then
				!exists.append(!sortedtypes[!i].split('!').getindexed(3))           $( old = 4 $)
				!newx = !sortedtypes[!i].split('!').getindexed(3)
				!newy = !!DrawingPlan1.viewURsh.part(4)
				new stra fpt x $!newx y $!newy length 10 adegrees 90 NLStyle 201 NLColour Magenta    $( old = 0 $)
--						!newx = !!DrawingPlan1.viewURsh.part(2)
--						!newy = !sortedtypes[!i].split('!').getindexed(4)
--						new stra fpt x $!newx y $!newy length 10 adegrees 0 NLStyle 201 NLColour Magenta
			endif
--			$p $!sortedtypes[$!i]
		enddo
	else
		!tempt = ''
		if !viewdir.direction().eq(object direction('E')) or !viewdir.direction().eq(object direction('W')) or !viewdir.direction().eq(object direction('N')) or !viewdir.direction().eq(object direction('S')) then
			if !rcode.eqnocase('up') then
				if !!DrawingPlan1.minN.gt(0) then                                                    $( old = !!DrawingPlan1.minE $)
					!tempt = 'MATCH LINE N' & !!stringRoundUpValue($!!DrawingPlan1.maxN, !format)      $( old = E !!DrawingPlan1.minE $)
				else
					!tempt = 'MATCH LINE S' & !!stringRoundUpValue($!!DrawingPlan1.maxN * -1, !format) $( old = W !!DrawingPlan1.minE $)
				endif
			else
				if !!DrawingPlan1.minE.gt(0) then                                                          $( old = !!DrawingPlan1.minN $)
					!tempt = 'MATCH LINE E' & !!stringRoundUpValue($!!DrawingPlan1.minE, !format)            $( old = N !!DrawingPlan1.minN $)
				else
					!tempt = 'MATCH LINE W' & !!stringRoundUpValue($!!DrawingPlan1.minE * -1, !format)       $( old = S !!DrawingPlan1.minN $)
				endif
			endif
		endif
		if not(!tempt.eqnocase('')) then
			!posx = (!!DrawingPlan1.viewURsh.part(2).real() - !!DrawingPlan1.viewULsh.part(2).real()) * 0.5
			!posy = !!DrawingPlan1.viewURsh.part(4).real() + 1
			new texp btext |$!tempt| origin x $!posx y $!posy adegrees 0 cheitx |$!!DrawingPlan1.matchhei.val| alig bbody just center txcolour yellow font 1
--					!posx = !!DrawingPlan1.viewURsh.part(2).real() + 1
--					!posy = !!DrawingPlan1.viewLRsh.part(4).real() + (!!DrawingPlan1.viewURsh.part(4).real() - !!DrawingPlan1.viewLRsh.part(4).real()) * 0.5
--					new texp btext |$!tempt| origin x $!posx y $!posy adegrees 90 cheitx |$!!DrawingPlan1.matchhei.val| alig tbody just center txcolour yellow font 1
		endif
	endif
endmethod

define method .SuptAnnotation(!name is string)
	NEW LAYE $!name/SS/S1/V1/ateSUPT
	Purpose SUPT
	Lvisibility true
	Ucode mm  Distance  mm  Bore Nominal 
	Font 1
	Lterminator Off
	Justification Left
	Alignment Base
	Dterminator Arrows
	Tsize 2mm
	Chosht 6mm
	Asubtended 0
	Pjustification Towards 
	Overshoot 2mm
	Plclearance 0mm
	Doffset 25mm
	Dmspacing 0mm
	!cheicomp = !this.annotext.val & 'mm'
	Cheight $!cheicomp
	Lleader true
	Lframe false
	Lshape Straight
	Gbox 0mm
	Cspacing 0
	Lspacing 0
	Llclearance 0mm
	Xyscale 1 1
	Xyposition 10mm 10mm 
	Bpoffset 0mm 0mm
	Blnk true
	Bmargin 0mm
	Trsf unset
	Fterminator Default
	Pcode mms to 0 dpls  Inches to 1 dpls  Fractions to 32 ths  Angles to 1 dpls 
	NLStyle Solid 
	NLColour Cyan 
	FStyle SolidFilled 
	FColour Cyan 
	Txcolour yellow 
	LLStyle Solid 
	LLColour Cyan 
	LFStyle Solid 
	LFColour Cyan 
	DLStyle Solid 
	DLColour Grey 
	PLStyle Solid 
	PLColour Grey 
	MStyle Off 
	MColour Cyan 
	CHStyle Off 
	CHColour Grey 
	ACDSTY unset
	Posformat ENU
	Grsystem Nulref
	SpPurpose unset
	Function unset
  
  if not(!this.supttog1.val) then
    $!name/SS/LALB
    handle any
      $!name/SS/LIBY
      new lalb $!name/SS/LALB
    endhandle
    new sytm $!name/SS/LALB/NAME_SUPT
    XYPS X 0mm Y 0mm
    JUST Centre
    ALIGN Hbody
    FONT 1
    -- same value as the flat oval branch reads from .annotext --
    -- hard coding it here kept one of the two support styles  --
    -- at 3mm whatever the form said                           --
    !cheisupt = !this.annotext.val & 'mm'
    CHEITX '$!cheisupt'
    CSPATX '0'
    LSPATX '0'
    TXCOLO 1
    NLSTYL Solid
    NLCOLO 1
    LLSTYL Solid
    LLCOLO 1
    FSTYLE Off
    FCOLOUR 1
    MCOLOUR 1
    LZCOLO 1
    LZLSTY Solid
    LZVIS true
    LZPRIN true
    NEW TEXTPRIMITIVE
    Origin Offset X 0mm Y 0mm
    FONT 1
    CHEITX '1.5mm'
    CSPATX '0'
    LSPATX '0'
    JUST Centre
    ALIGN Hbody
    BTEX |#STEX|
    TXCOLO 5
    !this.supttmp = |$!name/SS/LALB/NAME_SUPT|
  endif
	
	------------------------------------------------------------------
	-- first pass: keep the attachments that really land on the      --
	-- sheet and carry a STEXT, and remember where each one sits.    --
	-- nothing is created yet -- two supports hung off the same node --
	-- come out at one sheet position, and they have to be found     --
	-- before any label is made so the block can be sized as a unit  --
	------------------------------------------------------------------
	!this.suptstack = object array()
	!snames = object array()
	!stexts = object array()
	!sposs  = object array()
	!sxs    = object array()
	!sys    = object array()

	var !insts coll all atta with isnamed within E $!this.wminE N $!this.wminN U $!this.minU TO E $!this.wmaxE N $!this.wmaxN U $!this.maxU
	do !inst values !insts
		$!name/SS/S1/V1/ateSUPT
		------------------------------------------------------------------
		-- see the note in .NozzleAnnotation() -- the volume above is    --
		-- the world box containing the drawing box, the sheet position  --
		-- is what says whether this really sits in the view. asked here --
		-- rather than further down, so that nothing is created for an   --
		-- attachment which is going to be dropped                       --
		------------------------------------------------------------------
		var !apos ( pos of $!inst wrt worl )
		var !apos1 shpos of $!apos
		if (not(!this.InViewOnSheet(!apos1))) then
			skip
		endif
		--------------------------------------------------------------
		-- only annotate supports whose STEXT actually has a value  --
		--------------------------------------------------------------
		var !stext stext of $!inst
		if (!stext.eq('') or !stext.matchwild('*unset*')) then
			skip
		endif
		!snames.append(!inst)
		!stexts.append(!stext)
		!sposs.append(!apos1)
		!sxs.append(!apos1.part(2).replace('mm', '').real())
		!sys.append(!apos1.part(4).replace('mm', '').real())
	enddo

	------------------------------------------------------------------
	-- group the ones that share a point. 1mm on the sheet is well   --
	-- under a line of text, so anything closer than that would have --
	-- printed on top of its neighbour anyway                        --
	------------------------------------------------------------------
	!suptol = 1.0
	!nsupt  = !snames.size()
	!taken  = object array()
	do !i from 1 to !nsupt
		!taken.append(FALSE)
	enddo
	!groups = object array()
	do !i from 1 to !nsupt
		if (!taken[!i]) then
			skip
		endif
		!taken[!i] = TRUE
		!grp = object array()
		!grp.append(!i)
		!inext = !i + 1
		do !j from !inext to !nsupt
			if (!taken[!j]) then
				skip
			endif
			!dx  = !sxs[!j] - !sxs[!i]
			!dy  = !sys[!j] - !sys[!i]
			!adx = !dx.abs()
			!ady = !dy.abs()
			if (!adx.lt(!suptol) and !ady.lt(!suptol)) then
				!taken[!j] = TRUE
				!grp.append(!j)
			endif
		enddo
		!groups.append(!grp)
	enddo

	!ff = object file(!this.blankdir & 'WriteLabelToText.txt')
	!ff.open('append')
	!chsupt = !this.annotext.val.real()
	if !this.supttog1.val then
		!lineh = !chsupt * 1.2
	else
		!lineh = !chsupt
	endif

	!ngroup = !groups.size()
	do !g from 1 to !ngroup
		!grp = !groups[!g]
		!gn  = !grp.size()
		----------------------------------------------------------------
		-- longest text first, so the block reads widest line at the   --
		-- top and tapers downwards                                    --
		----------------------------------------------------------------
		!gnm1 = !gn - 1
		do !a from 1 to !gnm1
			do !b from 1 to !gnm1
				!b1   = !b + 1
				!ia   = !grp[!b]
				!ib   = !grp[!b1]
				!lena = !stexts[!ia].length()
				!lenb = !stexts[!ib].length()
				if (!lenb.gt(!lena)) then
					!grp[!b]  = !ib
					!grp[!b1] = !ia
				endif
			enddo
		enddo
		----------------------------------------------------------------
		-- the block is what BlankPos has to find room for: as wide as --
		-- its widest line and as tall as all of them stacked          --
		----------------------------------------------------------------
		!maxw = 0
		do !k from 1 to !gn
			!ik    = !grp[!k]
			!stext = !stexts[!ik]
			if !this.supttog1.val then
				--------------------------------------------------------------
				-- read straight off the flat oval built in .SuptAnnotation() --
				-- below: the two arcs sit at +/- .33 per character and reach --
				-- .5 further out at THPT, so the frame is .66 per character  --
				-- plus one character height of end cap. the 0.6/1.2 this     --
				-- used to declare was 3mm short on a 20 character tag, and   --
				-- BlankPos only keeps 1mm of clearance, so the right hand    --
				-- end of the frame sat on whatever line was next to it       --
				--------------------------------------------------------------
				!w = !stext.length() * !chsupt * 0.66 + !chsupt
			else
				!w = !stext.length() * !chsupt * 0.6
			endif
			if (!w.gt(!maxw)) then
				!maxw = !w
			endif
		enddo
		!stackh = !lineh * !gn

		!anchor    = ''
		!followers = ''
		do !k from 1 to !gn
			!ik    = !grp[!k]
			!inst  = !snames[!ik]
			!stext = !stexts[!ik]
			!apos1 = !sposs[!ik]
			$!name/SS/S1/V1/ateSUPT
			NEW SLAB
			DDNA $!inst
			!ce = ref
			if !this.supttog1.val then
				!this.SuptAnnotation(!name, !stext)
				$!ce
			endif
			tmrf $!this.supttmp
			Font 1
			Blnk true
			Bmargin 0mm
			Xyscale 1 1
			-- same value as the flat oval branch reads from .annotext --
			-- hard coding it here kept one of the two support styles  --
			-- at 3mm whatever the form said                           --
			!cheisupt = !this.annotext.val & 'mm'
			Cheitx '$!cheisupt'
			Lvisibility true
			Txcolour Yellow
			LLColour Cyan
			LFColour Cyan
			Alignment Hbody
			ABSO
			AT $!apos1
			XYPO 15 15
			var !label ref
			if (!k.eq(1)) then
				!anchor = !label
			else
				----------------------------------------------------------
				-- the rows under the top one ride on its leader -- the  --
				-- same reason a stacked grid bubble drops its own       --
				----------------------------------------------------------
				Lleader false
				!followers = !followers & ' ' & !label
			endif
		enddo

		------------------------------------------------------------------
		-- save label info. in WriteLabelToText.txt under .blankdir     --
		-- one record for the whole block, filed under the top label.    --
		-- the rows below it are not offered to BlankPos at all -- they  --
		-- are hung off the top one in .Apply() once BlankPos has said   --
		-- where the block goes, see .suptstack                          --
		------------------------------------------------------------------
		!ianc   = !grp[1]
		!aposa  = !sposs[!ianc]
		!shposx = !aposa.part(2).replace('mm', '')
		!shposy = !aposa.part(4).replace('mm', '')
		!ff.writerecord(!anchor & ' ' & !shposx & ' ' & !shposy & ' ' & !maxw & ' ' & !stackh & ' boxr')
		if (!gn.gt(1)) then
			!this.suptstack.append(!anchor & ' ' & !lineh & !followers)
		endif
	enddo
	!ff.close()
endmethod

---------------------------------------
-- create support template reference --
---------------------------------------
define method .SuptAnnotation(!name is string, !stext is string)
	$!name/SS/LIBY
	$!name/SS/LALB
	handle any
		new lalb $!name/SS/LALB
	endhandle
	!slen = !stext.length()
	$!name/SS/LALB/NAME_SUPT$!slen
	handle any
		new sytm $!name/SS/LALB/NAME_SUPT$!slen
		XYPS X 100mm Y 100mm
		JUST Centre
		ALIGN Hbody
		FONT 1
		CHEITX |$!this.annotext.val|
		CSPATX '0'
		LSPATX '0'
		TXCOLO 1
		NLSTYL Solid
		NLCOLO 1
		LLSTYL Solid
		LLCOLO 1
		FSTYLE Off
		FCOLOUR 1
		MCOLOUR 1
		LZCOLO 1
		LZLSTY Solid
		LZVIS true
		LZPRIN true
		
		!fptx = !slen * !this.annotext.val.real() * -0.33 + 100
		!fpty = !this.annotext.val.real() * 0.6 + 100
		!tpty = !this.annotext.val.real() * -0.6 + 100
		!thptx = !slen * !this.annotext.val.real() * -0.33 - !this.annotext.val.real() * 0.5 + 100
		
		NEW ARC
		FPT X $!fptx Y $!fpty 
		TPT X $!fptx Y $!tpty 
		THPT X $!thptx Y 100
		
		!fptx1 = !slen * !this.annotext.val.real() * 0.33 + 100
		!fpty1 = !this.annotext.val.real() * -0.6 + 100
		!tpty1 = !this.annotext.val.real() * 0.6 + 100
		!thptx1 = !slen * !this.annotext.val.real() * 0.33 + !this.annotext.val.real() * 0.5 + 100
		
		NEW ARC
		FPT X $!fptx1 Y $!fpty1
		TPT X $!fptx1 Y $!tpty1 
		THPT X $!thptx1 Y 100
		
		NEW STRA FPT X $!fptx Y $!fpty TPT X $!fptx1 Y $!tpty1
		NEW STRA FPT X $!fptx Y $!tpty TPT X $!fptx1 Y $!fpty1
		
		NEW TEXTPRIMITIVE
		Origin Offset X 0mm Y 0mm
		FONT 1
		CHEITX '1.5mm'
		CSPATX '0'
		LSPATX '0'
		JUST Centre
		ALIGN Hbody
		BTEX |#STEX|
		TXCOLO 5
	endhandle
	!this.supttmp = |$!name/SS/LALB/NAME_SUPT$!slen|
endmethod
